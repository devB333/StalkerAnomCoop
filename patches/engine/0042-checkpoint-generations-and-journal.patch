+#pragma once
+
+// S07-T02/T03/T04: the campaign server's persistence, docs/persistence-contract.md.
+//
+// The project-owned store (protocol/, coop::store) owns the files; this is
+// the engine side of the contract:
+//   recovery   (§7 steps 1-4) before the services: choose the generation,
+//              verify it, read its journals, allocate the epoch durably;
+//   identities (§7 step 6) the registry continues every saved object's
+//              EntityId and the participants are bound to their saved slots
+//              and actors before the client stages spawn anything;
+//   replay     (§7 step 7) the committed records after the checkpoint's
+//              revision are re-applied through idempotent adapters;
+//   publication (§5) a native save under the temporary name plus the
+//              supplemental record, published as one generation;
+//   the journal (§4, §6) a critical effect is appended and flushed before it
+//              is applied or acknowledged; a storage failure fails closed.
+// Nothing here trusts a client's save.
+
+#include "CampaignIdentity.h"
+#include "coop/store/checkpoint.h"
+#include "coop/store/journal.h"
+
+#include <string>
+#include <vector>
+
+namespace campaign
+{
+class CoopEventLog;
+
+// What the host knows about a participant at a publication (contract §5.1).
+struct PersistParticipant
+{
+	u8 slot;
+	u32 slot_generation;
+	coop::proto::Uuid128 player;
+	u16 actor_id; // 0xffff none
+	u64 actor_entity;
+	bool alive;
+	Fvector position;
+	xr_string name;
+};
+
+// A stored operation outcome (contract §2, §4 phase 1).
+struct StoredOutcome
+{
+	u8 outcome; // coop::proto::ActionOutcome
+	u16 reason;
+	u64 revision;
+};
+
+// The ledger record (contract §6, §10): the resolved effect.
+struct LedgerRecord
+{
+	u8 slot;
+	coop::proto::Uuid128 player;
+	u64 operation;
+	u64 actor_entity;
+	s32 delta;
+	u32 money_after;
+};
+std::vector<u8> encode_ledger(const LedgerRecord& r);
+bool decode_ledger(const std::vector<u8>& payload, LedgerRecord& out);
+
+// The death record (contract §6): a participant's (slot) or an NPC's
+// (slot 0xff) death, resolved: the dead entity, its killer (0 none), where.
+struct DeathRecord
+{
+	u8 slot;
+	u64 entity;
+	u64 killer;
+	float position[3];
+};
+std::vector<u8> encode_death(const DeathRecord& r);
+bool decode_death(const std::vector<u8>& payload, DeathRecord& out);
+
+// The respawn record (contract §9): the slot, the dead actor, the new actor's
+// reserved EntityId (its u16 is assigned at the spawn), where it spawns.
+// It is also the durable definition of the new entity (section "actor").
+struct RespawnRecord
+{
+	u8 slot;
+	coop::proto::Uuid128 player;
+	u64 operation;
+	u64 old_entity;
+	u64 new_entity;
+	float position[3];
+	u32 vertex;
+	u16 graph;
+};
+std::vector<u8> encode_respawn(const RespawnRecord& r);
+bool decode_respawn(const std::vector<u8>& payload, RespawnRecord& out);
+
+// Reason codes of ActionResult for the critical operations (S07-T03).
+const u16 kActionReasonStoreFailed = 5;
+
+class CoopPersistence
+{
+public:
+	CoopPersistence(const std::string& directory, const coop::proto::Uuid128& campaign,
+		const coop::proto::Uuid128& party, CoopEventLog* log);
+
+	// Contract §7 steps 1-4. On success save_name is the generation's save
+	// (coop-gen-<G>) or empty for a fresh campaign (the profile's save is
+	// loaded), the epoch is allocated and the journal is open for appending.
+	// False: refuse to start; reason names why (recovery-no-pointer,
+	// recovery-no-valid-generation, recovery-incompatible, recovery-journal).
+	bool recover(xr_string& save_name, xr_string& reason);
+	bool recovered() const { return m_recovered; }
+	const coop::store::Recovered& recovered_state() const { return m_recovered_state; }
+	u64 epoch() const { return m_epoch; }
+	// The revision the host's commit counter continues from.
+	u64 base_revision() const { return m_base_revision; }
+	u32 current_generation() const { return m_generation; }
+
+	// Step 6: the registry continues the saved u16 -> EntityId map and the
+	// next entity serial. Call before the level loads.
+	void restore_identities(CampaignIdentityRegistry& registry) const;
+
+	// Step 7: the replay list after the checkpoint (revision order).
+	const std::vector<coop::store::JournalRecord>& replay() const { return m_recovered_state.replay; }
+
+	// The operation index (contract §2): a known (player, operation) returns
+	// its stored outcome.
+	bool lookup(const coop::proto::Uuid128& player, u64 operation, StoredOutcome& out) const;
+	void remember(const coop::proto::Uuid128& player, u64 operation, const StoredOutcome& outcome);
+
+	// Phase 4 (contract §4): appends and flushes one record. False: the
+	// store failed (closed from now on) or was already failed.
+	bool commit(u8 kind, u64 tick, u64 revision, const std::vector<u8>& payload);
+	// The store is failed from now on (a test's injected storage failure at
+	// an engine boundary, or a real one): every later commit is refused.
+	void fail_closed(LPCSTR why);
+	bool failed() const { return m_failed; }
+	LPCSTR failure() const { return m_failure.c_str(); }
+	u64 commits() const { return m_commits; }
+	double last_commit_us() const { return m_journal.last_append_us(); }
+	double max_commit_us() const { return m_journal.max_append_us(); }
+
+	// Contract §5: publishes generation G from the native save the host wrote
+	// under temp_save_name(G) (coop-tmp-gen-<G>), with the supplemental
+	// built from the arguments and the ALife object registry. The journal
+	// rotates to coop-journal-<G>.log. False: nothing published (detail says
+	// which step); the previous generation stays current. A failed store
+	// publishes nothing.
+	u32 next_generation() const { return m_generation + 1; }
+	bool publish(u32 generation, u64 revision, u64 tick, u64 game_time, u32 level_id, LPCSTR level,
+		const std::vector<PersistParticipant>& participants, const std::vector<std::pair<u16, u64>>& entities,
+		u64 next_entity, LPCSTR build_id, LPCSTR content_digest, u16 protocol_major, std::string& detail);
+	const coop::store::CheckpointStore::Timing& last_publish_timing() const { return m_store.last_timing; }
+	// The published files of the current generation (for the join stream).
+	std::string generation_path(const char* extension) const;
+
+	coop::store::CheckpointStore& store() { return m_store; }
+
+private:
+	void fail(LPCSTR what, const coop::store::FileError& error);
+
+	coop::store::CheckpointStore m_store;
+	coop::store::JournalWriter m_journal;
+	coop::proto::Uuid128 m_campaign, m_party;
+	CoopEventLog* m_log;
+	bool m_recovered = false;
+	coop::store::Recovered m_recovered_state;
+	u64 m_epoch = 0;
+	u64 m_base_revision = 0;
+	u32 m_generation = 0; // current published generation (0: none)
+	bool m_failed = false;
+	std::string m_failure;
+	u64 m_commits = 0;
+	struct IndexKey
+	{
+		coop::proto::Uuid128 player;
+		u64 operation;
+		bool operator<(const IndexKey& o) const
+		{
+			if (player.hi != o.player.hi)
+				return player.hi < o.player.hi;
+			if (player.lo != o.player.lo)
+				return player.lo < o.player.lo;
+			return operation < o.operation;
+		}
+	};
+	xr_map<IndexKey, StoredOutcome> m_index;
+};
+} // namespace campaign
