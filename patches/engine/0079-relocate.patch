+// ------------------------------------------------------------ S10-T03d
+// Fast travel and the backpack on a co-op client: the installed PDA map scripts
+// skip time (noted here, the server's to apply) and then call ChangeLevel or
+// set_actor_position on the own actor; both become one relocate request
+// (ActionIntent 26) for the party; the proposal is the travel's (USE/DROP).
+void note_skip(u32 minutes)
+{
+	g_link->relocate.skip_minutes = minutes;
+	g_link->relocate.skip_ms = g_link->wall.GetElapsed_ms();
+	++g_link->relocate.skips_noted;
+	g_link->log.line("relocate-skip-noted minutes=%u", minutes);
+}
+
+bool relocate_request(const Fvector& at, u32 lvid, u16 gvid, u8 source)
+{
+	if (!g_link || !g_link->active || g_link->world != WorldLive || !g_actor)
+		return false;
+	Link::Relocate& r = g_link->relocate;
+	const u32 now = g_link->wall.GetElapsed_ms();
+	const u32 minutes = r.skip_ms && now - r.skip_ms < 3000 ? r.skip_minutes : 0;
+	r.skip_minutes = 0;
+	r.skip_ms = 0;
+	xr_vector<u8> params;
+	params.push_back(u8(gvid));
+	params.push_back(u8(gvid >> 8));
+	for (int b = 0; b < 4; ++b)
+		params.push_back(u8(lvid >> (8 * b)));
+	const float xyz[3] = {at.x, at.y, at.z};
+	const u8* raw = reinterpret_cast<const u8*>(xyz);
+	params.insert(params.end(), raw, raw + 12);
+	params.push_back(u8(minutes));
+	params.push_back(u8(minutes >> 8));
+	params.push_back(source);
+	++r.requests;
+	request_ownership(coop::proto::kActionRelocate, coop::proto::EntityRef(), params, 0, 0xffffffff, 0, true, "relocate");
+	travel_hud("Asking your partner to travel there...", 4);
+	g_link->log.line("relocate-request-sent gvid=%u lvid=%u pos=%.2f,%.2f,%.2f minutes=%u source=%u", u32(gvid), lvid,
+		VPUSH(at), minutes, u32(source));
+	return true;
+}
+
+bool relocate_actor(CActor* actor, const Fvector& at)
+{
+	if (!g_link || !g_link->active || actor != g_actor)
+		return false;
+	if (g_link->world != WorldLive || !ai().get_level_graph() || !ai().get_cross_table())
+		return true; // the own actor never jumps on a co-op client
+	const u32 lvid = ai().level_graph().vertex_id(at);
+	if (!ai().level_graph().valid_vertex_id(lvid))
+		return true;
+	const u16 gvid = u16(ai().cross_table().vertex(lvid).game_vertex_id());
+	return relocate_request(at, lvid, gvid, 1);
+}
+
+// S10-T03d driver: what a same-level fast travel does, once
+void relocate_frame()
+{
+	Link::Relocate& r = g_link->relocate;
+	if (!g_link->config.relocate_test || r.test_done || g_link->world != WorldLive || !g_actor ||
+		g_link->wall.GetElapsed_ms() < g_link->live_ms + g_link->config.relocate_test * 1000)
+		return;
+	r.test_done = true;
+	LPCSTR chunk = "local v = level.vertex_in_direction(db.actor:level_vertex_id(), vector():set(1, 0, 0), 150) "
+		"local p = level.vertex_position(v) "
+		"level.change_game_time(0, 1, 0) "
+		"db.actor:set_actor_position(p)";
+	lua_State* L = ai().script_engine().lua();
+	bool ok = false;
+	if (L && luaL_loadbuffer(L, chunk, xr_strlen(chunk), "coop_relocate_test") == 0)
+	{
+		ok = lua_pcall(L, 0, 0, 0) == 0;
+		if (!ok)
+		{
+			g_link->log.line("relocate-test-error %s", lua_tostring(L, -1));
+			lua_pop(L, 1);
+		}
+	}
+	else if (L)
+		lua_pop(L, 1);
+	g_link->log.line("relocate-test ran=%d actor=%.2f,%.2f,%.2f", ok ? 1 : 0, VPUSH(g_actor->Position()));
+}
