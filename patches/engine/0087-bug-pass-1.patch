+// ------------------------------------------------------------ S10-T07 (B12)
+// A companion order (ActionIntent 28) from the hotkeys or the companion wheel: the installed axr_companions function
+// runs on the server in the player's context, on that player's own companions only (each companion follows its
+// recruiter, T02f-1): for "all", companion_squads is narrowed to the player's squads around the call; for one
+// squad, its members must be the player's; move to a point uses the level vertex the client's camera picked.
+u16 take_companion(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	const std::vector<u8>& p = intent.params;
+	if (!link.session || p.size() != 7)
+		return coop::proto::kReasonMalformed;
+	const u8 command = p[0], mode = p[1], scope = p[2];
+	const u32 lvid = u32(p[3]) | (u32(p[4]) << 8) | (u32(p[5]) << 16) | (u32(p[6]) << 24);
+	if (command < 1 || command > 6 || mode > 4 || scope > 1)
+		return coop::proto::kReasonMalformed;
+	CActor* actor = participant_actor(link.ref);
+	if (!actor || !actor->g_Alive())
+		return coop::proto::kReasonNoActor;
+	const u16 npc = scope == 1 ? engine_id_of(intent.target) : 0xffff;
+	if (scope == 1 && npc == kNoEngineId)
+		return coop::proto::kReasonItemGone;
+	if (command == 6 && (lvid == u32(-1) || !ai().level_graph().valid_vertex_id(lvid)))
+		return coop::proto::kReasonMalformed;
+	string4096 chunk;
+	xr_sprintf(chunk,
+		"local sl, cmd, mode, scope, npc, lvid = %u, %u, %u, %u, %d, %u\n"
+		"local AC = axr_companions\n"
+		"if not AC then return -1 end\n"
+		"local keys = { 'combat', 'move', 'stealth', 'loot', 'distance' }\n"
+		"local tok = campaign.enter_slot(sl)\n"
+		"if tok == 0 then return -2 end\n"
+		"local all = rawget(AC, 'companion_squads') or {}\n"
+		"local n = 0\n"
+		"local ok, err = pcall(function()\n"
+		"  local function mine(sq)\n"
+		"    if not (sq and sq.commander_id) then return false end\n"
+		"    for k in sq:squad_members() do if campaign.companion_slot(k.id) == sl then return true end end\n"
+		"    return false\n"
+		"  end\n"
+		"  local own = {}\n"
+		"  for id, sq in pairs(all) do if mine(sq) then own[id] = sq n = n + 1 end end\n"
+		"  if cmd <= 5 then\n"
+		"    local key = keys[cmd]\n"
+		"    if scope == 0 then\n"
+		"      if n > 0 then\n"
+		"        rawset(AC, 'companion_squads', own)\n"
+		"        AC['cycle_companions_' .. key .. '_mode'](mode > 0 and mode or nil, true)\n"
+		"      end\n"
+		"    else\n"
+		"      local o = level.object_by_id(npc)\n"
+		"      local sq = o and get_object_squad(o)\n"
+		"      if sq and mine(sq) then AC['set_companion_squad_' .. key .. '_mode'](mode > 0 and mode or 1, o) n = 1 else n = 0 end\n"
+		"    end\n"
+		"  else\n"
+		"    for id, sq in pairs(own) do\n"
+		"      for k in sq:squad_members() do\n"
+		"        local st = db.storage[k.id]\n"
+		"        local member = st and st.object\n"
+		"        if member and member:alive() then AC.set_companion_to_follow_state(member) save_var(member, 'fight_from_point', lvid) end\n"
+		"        if k.id == sq:commander_id() and st and st.beh then st.beh.rally_lvid = lvid end\n"
+		"      end\n"
+		"    end\n"
+		"  end\n"
+		"end)\n"
+		"rawset(AC, 'companion_squads', all)\n"
+		"campaign.leave(tok)\n"
+		"if not ok then return -4 end\n"
+		"return n\n",
+		u32(link.ref.slot), u32(command), u32(mode), u32(scope), int(npc == 0xffff ? -1 : int(npc)), lvid);
+	double v[1] = {-9};
+	alife_lua(chunk, v, 1, "companion-order");
+	const int n = int(v[0]);
+	++g_host->companion_orders;
+	g_host->log.line("companion-order slot=%u command=%u mode=%u scope=%u npc=%d lvid=%u squads=%d", u32(link.ref.slot),
+		u32(command), u32(mode), u32(scope), npc == 0xffff ? -1 : int(npc), command == 6 ? lvid : 0u, n);
+	result.revision = g_host->commit;
+	return n > 0 ? 0 : (n == 0 ? coop::proto::kReasonNothing : coop::proto::kReasonUseRefused);
+}
