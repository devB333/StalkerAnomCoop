+const char* const kSessionOwnerLoadout =
+	"helm_resp,novice_outfit,wpn_pm,wpn_knife,stalker_patch,bolt,bread,device_pda_1,device_flashlight,itm_backpack,"
+	"box_matches,flask,wpn_bm16,kolbasa,ration_ru";
+const char* const kSessionPartnerLoadout =
+	"helm_resp,novice_outfit,wpn_pm,wpn_knife,stalker_patch,bolt,bread,device_pda_1,device_flashlight,itm_backpack,"
+	"box_matches,flask,detector_geiger,vodka,kolbasa"; // the faction's own bread line overrides the shared one
