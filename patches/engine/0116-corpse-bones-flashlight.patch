+// B54: a saved ragdoll's bones (world positions, saved inside their box) moved by delta, velocities dropped
+void move_saved_bones(SPHBonesData& bones, const Fvector& delta)
+{
+	for (SPHNetState& b : bones.bones)
+	{
+		b.position.add(delta);
+		b.previous_position.add(delta);
+		b.linear_vel.set(0.f, 0.f, 0.f);
+		b.angular_vel.set(0.f, 0.f, 0.f);
+	}
+	bones.set_min_max(Fvector(bones.get_min()).add(delta), Fvector(bones.get_max()).add(delta));
+}
+
+// B54: the bones moved so their box's centre is over at and the lowest 0.3 m above it; returns the move
+Fvector shift_saved_bones(SPHBonesData& bones, const Fvector& at)
+{
+	Fvector lo = {flt_max, flt_max, flt_max}, hi = {-flt_max, -flt_max, -flt_max};
+	for (const SPHNetState& b : bones.bones)
+	{
+		lo.min(b.position);
+		hi.max(b.position);
+	}
+	Fvector delta;
+	delta.set(at.x - (lo.x + hi.x) * 0.5f, at.y + 0.3f - lo.y, at.z - (lo.z + hi.z) * 0.5f);
+	move_saved_bones(bones, delta);
+	return delta;
+}
