+static xr_vector<MapSpotState> s_map_spots; // S08-T09
+static xr_vector<xr_string> s_map_spot_types;
+
+void note_map_spot(Presentation kind, u16 object, LPCSTR spot, LPCSTR detail, u32 flags)
+{
+	for (size_t i = 0; i < s_map_spots.size(); ++i)
+		if (s_map_spots[i].object == object && s_map_spot_types[i] == spot)
+		{
+			if (kind == Presentation::MapSpotRemove)
+			{
+				s_map_spots.erase(s_map_spots.begin() + i);
+				s_map_spot_types.erase(s_map_spot_types.begin() + i);
+			}
+			else
+			{
+				s_map_spots[i].detail = detail;
+				if (kind == Presentation::MapSpotAdd)
+					s_map_spots[i].flags = flags;
+			}
+			return;
+		}
+	if (kind != Presentation::MapSpotAdd)
+		return;
+	MapSpotState m;
+	m.object = object;
+	m.detail = detail;
+	m.flags = flags;
+	s_map_spots.push_back(m);
+	s_map_spot_types.push_back(spot);
+}
+
+void map_spots(xr_vector<MapSpotState>& out) { out = s_map_spots; }
