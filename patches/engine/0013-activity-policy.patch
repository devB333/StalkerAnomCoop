 //-----------------------------------------------------------------------------------------------------------
+// S02-T04c: server activity policy. The client decides which objects update
+// every frame (crows) and how often each is scheduled from the camera
+// position (CObject::UpdateCL, CObject::shedule_Scale). A server has no
+// camera, so while the policy is enabled both decisions use the distance to
+// the nearest activity anchor instead: one anchor per online participant
+// actor, refreshed by the game module every frame. Objects within crow_radius
+// of an anchor update every frame; the rest update on their scheduled updates,
+// as on the client beyond its crow radius. Disabled, nothing changes.
+struct ENGINE_API SActivityPolicy
+{
+	bool enabled;
+	float crow_radius;
+	xr_vector<Fvector> anchors;
+
+	SActivityPolicy();
+	// Distance to the nearest anchor; flt_max when there is none.
+	float distance_to(const Fvector& position) const;
+};
