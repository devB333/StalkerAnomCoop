+// --- S10-T06: session control from the co-op menu ----------------------------------------------------------------
+// The server's answer to a list (its campaigns) or a switch (the campaign it is relaunched on: this client then
+// proves itself to that campaign when it reconnects).
+void on_session(const coop::proto::CampaignEvent& event)
+{
+	PayloadReader r(event.payload);
+	const u8 type = r.get<u8>();
+	if (type == 1)
+	{
+		const u8 owner = r.get<u8>();
+		const u8 n = r.get<u8>();
+		xr_string out;
+		for (u32 i = 0; i < n && r.ok; ++i)
+		{
+			coop::proto::Uuid128 id;
+			id.hi = r.get<u64>();
+			id.lo = r.get<u64>();
+			const u8 current = r.get<u8>();
+			string256 label, level;
+			r.str(label, sizeof(label));
+			r.str(level, sizeof(level));
+			const u32 updated = r.get<u32>();
+			for (char* c = label; *c; ++c)
+				if (*c == '|' || *c == '\n')
+					*c = '/';
+			string512 line;
+			xr_sprintf(line, "%s|%u|%s|%s|%u\n", coop_uuid_hex(id).c_str(), u32(current), label, level, updated);
+			out += line;
+		}
+		if (!r.ok)
+		{
+			g_link->log.line("session-list-malformed bytes=%u", u32(event.payload.size()));
+			return;
+		}
+		g_link->session.entries = out;
+		g_link->session.owner = owner != 0;
+		++g_link->session.version;
+		g_link->log.line("session-list owner=%u campaigns=%u version=%u", u32(owner), u32(n), g_link->session.version);
+		return;
+	}
+	if (type == 2)
+	{
+		coop::proto::Uuid128 id;
+		id.hi = r.get<u64>();
+		id.lo = r.get<u64>();
+		const u8 why = r.get<u8>();
+		string256 label;
+		r.str(label, sizeof(label));
+		if (!r.ok || id.zero())
+		{
+			g_link->log.line("session-switch-malformed");
+			return;
+		}
+		g_link->log.line("session-switch why=%s from=%s to=%s label=\"%s\"", why == 1 ? "create" : "load",
+			coop_uuid_hex(g_link->config.campaign_id).c_str(), coop_uuid_hex(id).c_str(), label);
+		g_link->config.campaign_id = id; // the next connect proves itself to that campaign
+		++g_link->session.switches;
+		string512 text;
+		xr_sprintf(text, why == 1 ? "The owner started a new campaign (%s). Joining it..." :
+			"The owner loaded another campaign (%s). Joining it...", label);
+		travel_hud(text, 15);
+	}
+}
+
+bool session_send(const xr_vector<u8>& params)
+{
+	if (!g_link || !g_link->active || !g_link->client)
+		return false;
+	request_ownership(coop::proto::kActionSession, coop::proto::EntityRef(), params, 0, 0xffffffff, 0, true, "session");
+	return true;
+}
+
+// a create (op 2) or a loadout (op 4) in parts of at most 240 bytes, at most 8
+bool session_send_parts(u8 op, LPCSTR text)
+{
+	const size_t size = text ? xr_strlen(text) : 0;
+	const size_t chunk = 240;
+	const size_t parts = _max(size_t(1), (size + chunk - 1) / chunk);
+	if (parts > 8)
+	{
+		g_link->log.line("session-create-too-long bytes=%u", u32(size));
+		return false;
+	}
+	for (size_t i = 0; i < parts; ++i)
+	{
+		const size_t from = i * chunk, n = _min(chunk, size - _min(size, from));
+		xr_vector<u8> params;
+		params.push_back(op);
+		params.push_back(u8(i));
+		params.push_back(u8(parts));
+		params.push_back(u8(n));
+		params.insert(params.end(), text + from, text + from + n);
+		if (!session_send(params))
+			return false;
+	}
+	g_link->log.line("session-create-sent op=%u bytes=%u parts=%u", u32(op), u32(size), u32(parts));
+	return true;
+}
+
+void session_lua(LPCSTR chunk, LPCSTR name)
+{
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return;
+	if (luaL_loadbuffer(L, chunk, xr_strlen(chunk), name) == 0)
+	{
+		if (lua_pcall(L, 0, 0, 0) != 0)
+		{
+			g_link->log.line("session-lua-error chunk=%s error=%s", name, lua_isstring(L, -1) ? lua_tostring(L, -1) : "?");
+			lua_pop(L, 1);
+		}
+	}
+	else
+	{
+		g_link->log.line("session-lua-load-error chunk=%s error=%s", name, lua_isstring(L, -1) ? lua_tostring(L, -1) : "?");
+		lua_pop(L, 1);
+	}
+}
+
