+// ------------------------------------------------------------ S10-T07 (B18)
+// The combat-music fixture (profile music_party, server-driven): p1 moves about 120 m away (p1 only, L58), a
+// hostile stalker is spawned 20 m in front of p2 and made p2's enemy; p2's health is held at 0.6 or more while
+// they fight for 60 s, then the stalker dies and the music fades. The compat layer's notes (music-start/-stop
+// slot=N) and the clients' music sounds are checked by compare-coop-music.py: p2's music only.
+void music_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.music_party || !ai().get_alife())
+		return;
+	Host::MusicFixture& f = g_host->music_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u8 slots[2] = {0, 0};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				slots[attached] = link.ref.slot;
+				actors[attached++] = actor;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-music both-attached tick=%I64u", g_host->tick);
+	}
+	if (attached < 2 || f.phase >= 99 || g_host->tick < f.both_since + u64(config.music_party) * 50)
+		return;
+	if (slots[0] != 0)
+		std::swap(actors[0], actors[1]);
+	CActor* p2 = actors[1];
+	if (p2->g_Alive() && p2->GetfHealth() < 1.f)
+		p2->SetfHealth(1.f); // the fixture tests the music, not survival (bugfix-2: another NPC killed p2)
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	CEntityAlive* npc = f.npc != 0xffff ? smart_cast<CEntityAlive*>(Level().Objects.net_Find(f.npc)) : nullptr;
+	if (f.phase == 0)
+	{
+		// out of the start village (a no-combat zone: the installed combat_ignore keeps the peace there): p2 to a
+		// level-graph point about 200 m away (a long move of p2 is safe since B6), p1 about 120 m from it
+		const CLevelGraph& graph = ai().level_graph();
+		const u32 count = graph.header().vertex_count();
+		auto pick = [&graph, count](const Fvector& from, float lo, float hi, Fvector& out) {
+			float best = -1.f;
+			const float mid = 0.5f * (lo + hi);
+			for (u32 i = 0; i < count; i += 41)
+			{
+				const Fvector at = graph.vertex_position(i);
+				const float d = at.distance_to(from);
+				if (d >= lo && d <= hi && (best < 0.f || _abs(d - mid) < _abs(best - mid)))
+				{
+					best = d;
+					out = at;
+				}
+			}
+			return best > 0.f;
+		};
+		Fvector p2_at = p2->Position(), p1_at = actors[0]->Position();
+		if (pick(p2->Position(), 180.f, 220.f, p2_at))
+		{
+			p2_at.y += 0.3f;
+			place_beside(p2, p2_at);
+		}
+		if (pick(p2_at, 110.f, 130.f, p1_at))
+		{
+			p1_at.y += 0.3f;
+			place_beside(actors[0], p1_at);
+		}
+		g_host->log.line("fixture-music placed p2=%.2f,%.2f,%.2f p1_distance=%.1f", VPUSH(p2_at), p1_at.distance_to(p2_at));
+		f.phase = 1;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		if (g_host->tick - f.phase_tick < 5 * 50)
+			return; // the moves settle
+		LPCSTR section = nullptr;
+		for (LPCSTR s : {"sim_default_monolith_1", "sim_default_monolith_0", "sim_default_bandit_1", "sim_default_bandit_0"})
+			if (pSettings->section_exist(s))
+			{
+				section = s;
+				break;
+			}
+		Fvector forward;
+		forward.setHP(p2->XFORM().k.getH(), 0.f);
+		f.npc = section ? spawn_at(alife, section, Fvector().mad(p2->Position(), forward, 20.f), u16(p2->ID())) : 0xffff;
+		g_host->log.line("fixture-music spawned section=%s npc=%u", section ? section : "-", u32(f.npc));
+		f.phase = f.npc == 0xffff ? 99 : 2;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 2)
+	{
+		if (!npc || g_host->tick - f.phase_tick < 2 * 50)
+			return;
+		string512 chunk;
+		double v[1] = {0};
+		xr_sprintf(chunk, "local n = level.object_by_id(%u) local a = level.object_by_id(%u)\n"
+			"if n and a then n:set_relation(game_object.enemy, a) n:force_set_goodwill(-5000, a) return 1 end return 0\n",
+			u32(f.npc), u32(p2->ID()));
+		alife_lua(chunk, v, 1, "music-enemy");
+		g_host->log.line("fixture-music enemy-set npc=%u p2=%u ok=%d", u32(f.npc), u32(p2->ID()), int(v[0]));
+		f.phase = 3;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 3)
+	{
+		if (npc && !f.fought)
+		{
+			string256 chunk;
+			double v[1] = {-1};
+			xr_sprintf(chunk, "local n = level.object_by_id(%u) local e = n and n:best_enemy() return e and e:id() or -1\n",
+				u32(f.npc));
+			if (alife_lua(chunk, v, 1, "music-best-enemy") == 1 && int(v[0]) == int(p2->ID()))
+			{
+				f.fought = true;
+				g_host->log.line("fixture-music fighting npc=%u enemy=p2 after_s=%.1f", u32(f.npc),
+					float(g_host->tick - f.phase_tick) / 50.f);
+			}
+		}
+		if (g_host->tick - f.phase_tick < 60 * 50 && npc && npc->g_Alive())
+			return;
+		if (npc && npc->g_Alive())
+			npc->KillEntity(u16(p2->ID()));
+		g_host->log.line("fixture-music npc-dead fought=%d", f.fought ? 1 : 0);
+		f.phase = 4;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 4 && g_host->tick - f.phase_tick >= 40 * 50)
+	{
+		// B6: p2's own actor moved about 500 m in one step (the move that crashed a client, L58)
+		const CLevelGraph& graph = ai().level_graph();
+		const u32 count = graph.header().vertex_count();
+		Fvector to = p2->Position();
+		float best = 0.f;
+		for (u32 i = 0; i < count; i += 37)
+		{
+			const Fvector at = graph.vertex_position(i);
+			const float d = at.distance_to(p2->Position());
+			if (d >= 450.f && d <= 600.f && _abs(d - 525.f) < _abs(best - 525.f))
+			{
+				best = d;
+				to = at;
+			}
+		}
+		if (best > 0.f)
+		{
+			to.y += 0.3f;
+			place_beside(p2, to);
+		}
+		g_host->log.line("fixture-music p2-jump metres=%.1f to=%.2f,%.2f,%.2f", best, VPUSH(to));
+		f.phase = 5;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 5 && g_host->tick - f.phase_tick >= 20 * 50)
+	{
+		u32 in_world = 0;
+		for (PlayerLink& link : g_host->links)
+			if (link.ref.slot == 1 && client_in_world(link))
+				++in_world;
+		g_host->log.line("fixture-music done fought=%d p2_client_in_world=%u", f.fought ? 1 : 0, in_world);
+		f.phase = 99;
+	}
+}
