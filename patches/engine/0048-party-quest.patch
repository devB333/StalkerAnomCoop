+template <typename R, typename... A>
+bool lua_call_ok(LPCSTR name, R& out, A... args)
+{
+	luabind::functor<R> f;
+	if (!ai().script_engine().functor(name, f))
+		return false;
+	out = f(args...);
+	return true;
+}
+
+bool lua_call_void(LPCSTR name)
+{
+	luabind::functor<void> f;
+	if (!ai().script_engine().functor(name, f))
+		return false;
+	f();
+	return true;
+}
+
+bool party_task_supported(LPCSTR id)
+{
+	for (LPCSTR t : kPartyTasks)
+		if (!xr_strcmp(t, id))
+			return true;
+	return false;
+}
+
+Host::PartyTask* party_task(LPCSTR id)
+{
+	for (Host::PartyTask& t : g_host->party_tasks)
+		if (t.id == id)
+			return &t;
+	return nullptr;
+}
+
+// Both party actors' presentation: what this player sees of the party's task.
+void party_news(LPCSTR text)
+{
+	for (u16 id : g_host->party_actor_ids)
+		if (id != 0xffff)
+			if (CObject* actor = Level().Objects.net_Find(id))
+				campaign::present_to_actor(actor, campaign::Presentation::News, 0, text);
+	g_host->log.line("quest-news text=\"%s\"", text);
+}
+
+void sync_party_actors()
+{
+	u16 ids[2] = {0xffff, 0xffff};
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && link.ref.slot < 2)
+			if (CActor* actor = participant_actor(link.ref))
+				ids[link.ref.slot] = u16(actor->ID());
+	if (ids[0] == g_host->party_actor_ids[0] && ids[1] == g_host->party_actor_ids[1])
+		return;
+	g_host->party_actor_ids[0] = ids[0];
+	g_host->party_actor_ids[1] = ids[1];
+	luabind::functor<void> f;
+	if (ai().script_engine().functor("campaign_party_set_actors", f))
+		f(ids[0] == 0xffff ? -1 : int(ids[0]), ids[1] == 0xffff ? -1 : int(ids[1]));
+	g_host->log.line("party-actors p0=%d p1=%d", ids[0] == 0xffff ? -1 : int(ids[0]), ids[1] == 0xffff ? -1 : int(ids[1]));
+}
+
+// The installed accept phrases in `actor`'s context (CampaignQuestCapture's
+// dialog_accept_task for any participant): generate the giver's tasks, skip
+// until `task` is offered, show its job text (the fetch roll), accept.
+bool quest_accept_phrases(CActor* actor, CGameObject* npc, LPCSTR task)
+{
+	CScriptGameObject* actor_go = actor->lua_game_object();
+	CScriptGameObject* npc_go = npc->lua_game_object();
+	luabind::functor<void> generate, skip, give;
+	luabind::functor<bool> has_task;
+	luabind::functor<luabind::object> text;
+	if (!ai().script_engine().functor("dialogs.generate_available_tasks", generate) ||
+		!ai().script_engine().functor("dialogs.npc_has_task", has_task) ||
+		!ai().script_engine().functor("dialogs.npc_skip_task", skip) ||
+		!ai().script_engine().functor("dialogs.text_npc_has_task", text) ||
+		!ai().script_engine().functor("dialogs.npc_give_task", give))
+		return false;
+	generate(actor_go, npc_go);
+	lua_State* L = ai().script_engine().lua();
+	luabind::object available = luabind::get_globals(L)["axr_task_manager"];
+	for (u32 skipped = 0; skipped < 16; ++skipped)
+	{
+		if (!has_task(actor_go, npc_go))
+			break;
+		LPCSTR first = "-";
+		if (available.type() == LUA_TTABLE)
+		{
+			// a default luabind::object has no state and faults on type(): nil is object(L)
+			luabind::object list = available["available_tasks"];
+			luabind::object mine = list.type() == LUA_TTABLE ? luabind::object(list[int(npc->ID())]) : luabind::object(L);
+			luabind::object head = mine.type() == LUA_TTABLE ? luabind::object(mine[1]) : luabind::object(L);
+			if (head.type() == LUA_TSTRING)
+				first = luabind::object_cast<LPCSTR>(head);
+		}
+		if (!xr_strcmp(first, task))
+		{
+			text(actor_go, npc_go);
+			give(actor_go, npc_go);
+			g_host->log.line("quest-offered task=%s skipped=%u", task, skipped);
+			return true;
+		}
+		g_host->log.line("quest-skip offered=%s", first);
+		skip(actor_go, npc_go);
+	}
+	return false;
+}
+
+bool quest_turnin_phrases(CActor* actor, CGameObject* npc)
+{
+	CScriptGameObject* actor_go = actor->lua_game_object();
+	CScriptGameObject* npc_go = npc->lua_game_object();
+	luabind::functor<bool> finished;
+	luabind::functor<luabind::object> text;
+	luabind::functor<void> complete;
+	if (!ai().script_engine().functor("dialogs.actor_has_finished_task", finished) ||
+		!ai().script_engine().functor("dialogs.text_npc_task_finish", text) ||
+		!ai().script_engine().functor("dialogs.npc_set_finished_task_complete", complete))
+		return false;
+	if (!finished(actor_go, npc_go))
+		return false;
+	text(actor_go, npc_go);
+	complete(actor_go, npc_go);
+	return true;
+}
+
+u16 take_quest(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	CoopPersistence* persistence = g_host->persistence;
+	// S08-T05: first, before the stored outcome (remembered before its
+	// publication): a request whose answer is still on its way gets it later
+	for (const Host::PendingTurnIn& t : g_host->turn_ins)
+		for (const Host::QuestWaiter& w : t.waiters)
+			if (w.player == link.player && w.result.operation_id == intent.operation_id)
+				return kQuestPending; // the same request again while it completes: one answer, later
+	for (const Host::QuestAnswer& a : g_host->quest_answers)
+		if (a.w.player == link.player && a.w.result.operation_id == intent.operation_id)
+			return kQuestPending; // its answer waits for the publication
+	StoredOutcome stored;
+	if (persistence && persistence->lookup(link.player, intent.operation_id, stored))
+	{
+		result.outcome = coop::proto::ActionOutcome(stored.outcome);
+		result.reason = stored.reason;
+		result.commit_id = stored.revision;
+		result.revision = stored.revision;
+		g_host->log.line("quest-duplicate player=%s operation=%I64u outcome=%u revision=%I64u",
+			coop_uuid_hex(link.player).c_str(), intent.operation_id, u32(stored.outcome), stored.revision);
+		return stored.reason;
+	}
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (intent.params.size() < 3 || intent.params.size() != size_t(2 + intent.params[1]) || intent.params[1] > 64)
+		return coop::proto::kReasonMalformed;
+	const u8 op = intent.params[0];
+	if (op != 1 && op != 2)
+		return coop::proto::kReasonMalformed;
+	string128 task;
+	memcpy(task, intent.params.data() + 2, intent.params[1]);
+	task[intent.params[1]] = 0;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	if (!actor || !actor->g_Alive())
+		return coop::proto::kReasonNoActor;
+	if (!party_task_supported(task) || !g_host->party_adapter)
+		return coop::proto::kReasonQuestUnsupported;
+	const u16 giver_id = engine_id_of(intent.target);
+	CGameObject* npc = giver_id != kNoEngineId ? smart_cast<CGameObject*>(Level().Objects.net_Find(giver_id)) : nullptr;
+	CEntityAlive* alive = npc ? smart_cast<CEntityAlive*>(npc) : nullptr;
+	CInventoryOwner* owner = npc ? smart_cast<CInventoryOwner*>(npc) : nullptr;
+	if (!npc || !alive || !alive->g_Alive() || !owner || smart_cast<CActor*>(npc))
+		return coop::proto::kReasonQuestUnsupported;
+	const float distance = pickup_distance(actor, npc);
+	if (distance > kGiverReach)
+	{
+		g_host->log.line("quest-out-of-reach slot=%u giver=%u distance=%.2f", u32(link.ref.slot), u32(giver_id), distance);
+		return coop::proto::kReasonOutOfReach;
+	}
+	sync_party_actors();
+	Host::PartyTask* t = party_task(task);
+	// the party's anchor: participant 1's actor
+	CActor* anchor = nullptr;
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot == 0)
+			anchor = participant_actor(l.ref);
+	if (op == 1)
+	{
+		if (t)
+			return coop::proto::kReasonQuestActive;
+		if (!anchor || !anchor->g_Alive())
+			return coop::proto::kReasonNoActor;
+		bool ok = false;
+		const campaign::Refusal opened = campaign::dialogue_open(anchor, owner, false);
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(anchor), "party-quest-accept");
+			ok = opened == campaign::Refusal::None && quest_accept_phrases(anchor, npc, task);
+		}
+		campaign::dialogue_close(anchor, owner);
+		CGameTask* native = Level().GameTaskManager().HasGameTask(shared_str(task), true);
+		g_host->log.line("quest-accept slot=%u task=%s dialogue=%s ok=%d native=%d", u32(link.ref.slot), task,
+			campaign::refusal_name(opened), ok ? 1 : 0, native ? 1 : 0);
+		if (!ok || !native)
+			return coop::proto::kReasonQuestNotOffered;
+		Host::PartyTask nt;
+		nt.id = task;
+		nt.holder_slot = 0;
+		nt.holder = u16(anchor->ID());
+		nt.accepted_by = link.ref.slot;
+		nt.giver = giver_id;
+		nt.instance = ++g_host->quest_instances;
+		nt.accepted_tick = g_host->tick;
+		g_host->party_tasks.push_back(nt);
+		{
+			// S08-T06: the instance lives with the task in the anchor's portable
+			// store (the native save holds it), so a restart rebuilds the party's task
+			luabind::functor<void> save_var;
+			if (ai().script_engine().functor("_G.save_var", save_var))
+				save_var(anchor->lua_game_object(), (xr_string(task) + "_coop_instance").c_str(), int(nt.instance));
+		}
+		luabind::functor<void> set_task;
+		if (ai().script_engine().functor("campaign_party_set_task", set_task))
+			set_task(task, int(anchor->ID()));
+		s32 need = -1;
+		lua_call_ok("campaign_party_need", need, (LPCSTR)task);
+		++g_host->quests_accepted;
+		g_host->log.line("quest-accepted slot=%u task=%s instance=%I64u holder=%u giver=%u need=%d", u32(link.ref.slot),
+			task, nt.instance, u32(nt.holder), u32(giver_id), need);
+		string128 news;
+		xr_sprintf(news, "Party task accepted by Player %u: bring %d bandit patches to Sidorovich", u32(link.ref.slot) + 1,
+			need);
+		party_news(news);
+		const u64 revision = ++g_host->commit;
+		stored.outcome = u8(coop::proto::ActionOutcome::Accepted);
+		stored.reason = 0;
+		stored.revision = revision;
+		if (persistence)
+			persistence->remember(link.player, intent.operation_id, stored);
+		result.outcome = coop::proto::ActionOutcome::Accepted;
+		result.reason = 0;
+		result.commit_id = revision;
+		result.revision = revision;
+		coop::store::failpoint("quest:after-accept");
+		Host::QuestAnswer answer;
+		answer.w = {link.player, link.join_serial, result, link.ref.slot};
+		answer.since_tick = g_host->tick;
+		answer.what = "accept";
+		g_host->quest_answers.push_back(answer);
+		return kQuestPending;
+	}
+	// op 2: turn in
+	if (!t)
+		return coop::proto::kReasonQuestNotActive;
+	for (Host::PendingTurnIn& p : g_host->turn_ins)
+		if (p.task == task)
+		{
+			// S08-T05: two turn-ins of one task: one completion, both answered with it
+			p.waiters.push_back({link.player, link.join_serial, result, link.ref.slot});
+			g_host->log.line("quest-turnin-joined slot=%u task=%s waiters=%u", u32(link.ref.slot), task,
+				u32(p.waiters.size()));
+			return kQuestPending;
+		}
+	CActor* holder = smart_cast<CActor*>(Level().Objects.net_Find(t->holder));
+	if (!holder || !holder->g_Alive())
+		return coop::proto::kReasonQuestNotActive; // the holder's task went with its actor (S08-T05: defined)
+	s32 stage = -1;
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(holder), "party-quest-check");
+		lua_call_ok("campaign_party_check", stage, (LPCSTR)task);
+	}
+	if (stage != 1)
+	{
+		g_host->log.line("quest-not-finished slot=%u task=%s stage=%d count=%d need=%d", u32(link.ref.slot), task, stage,
+			t->count, t->need);
+		return coop::proto::kReasonQuestNotFinished;
+	}
+	luabind::functor<void> begin;
+	if (ai().script_engine().functor("campaign_party_begin_turnin", begin))
+		begin((LPCSTR)task);
+	bool ok = false;
+	const campaign::Refusal opened = campaign::dialogue_open(holder, owner, false);
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(holder), "party-quest-turnin");
+		ok = opened == campaign::Refusal::None && quest_turnin_phrases(holder, npc);
+	}
+	campaign::dialogue_close(holder, owner);
+	g_host->log.line("quest-turnin slot=%u task=%s holder=%u dialogue=%s ok=%d", u32(link.ref.slot), task,
+		u32(t->holder), campaign::refusal_name(opened), ok ? 1 : 0);
+	if (!ok)
+	{
+		lua_call_void("campaign_party_end_turnin");
+		return coop::proto::kReasonQuestNotFinished;
+	}
+	Host::PendingTurnIn pending;
+	pending.waiters.push_back({link.player, link.join_serial, result, link.ref.slot});
+	pending.task = task;
+	pending.since_tick = g_host->tick;
+	pending.slot = link.ref.slot;
+	g_host->turn_ins.push_back(pending);
+	return kQuestPending;
+}
+
+PlayerLink* link_of(const coop::proto::Uuid128& player);
+
+// The resolved effects of a completed party turn-in, applied by the server:
+// the patches leave their owners' inventories, each player is paid for his
+// own (dialogs.relocate_money in that player's context: the money and its
+// news), and every party actor gets the same goodwill changes.
+bool apply_party_effects(const Host::PendingTurnIn& p, u64 revision)
+{
+	lua_State* L = ai().script_engine().lua();
+	luabind::functor<luabind::object> effects_of;
+	if (!ai().script_engine().functor("campaign_party_effects", effects_of))
+		return false;
+	luabind::object e = effects_of();
+	if (e.type() != LUA_TTABLE || luabind::object(e["done"]).type() != LUA_TBOOLEAN ||
+		!luabind::object_cast<bool>(e["done"]))
+		return false;
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	u32 items = 0, payments = 0, goodwill = 0;
+	luabind::object list = e["items"];
+	for (int i = 1; list.type() == LUA_TTABLE; ++i)
+	{
+		luabind::object one = list[i];
+		if (one.type() != LUA_TTABLE)
+			break;
+		const u16 item = u16(luabind::object_cast<int>(one["item"]));
+		const u16 from = u16(luabind::object_cast<int>(one["actor"]));
+		CSE_ALifeDynamicObject* se = ai().alife().objects().object(item, true);
+		g_host->log.line("quest-item-taken revision=%I64u task=%s item=%u item_entity=%I64u from=%u ok=%d", revision,
+			p.task.c_str(), u32(item), entity_of(item), u32(from), se ? 1 : 0);
+		if (se)
+		{
+			alife->release(se, true);
+			++items;
+		}
+	}
+	luabind::object money = e["money"];
+	for (int i = 1; money.type() == LUA_TTABLE; ++i)
+	{
+		luabind::object one = money[i];
+		if (one.type() != LUA_TTABLE)
+			break;
+		const u16 to = u16(luabind::object_cast<int>(one["actor"]));
+		const int amount = luabind::object_cast<int>(one["amount"]);
+		const int count = luabind::object_cast<int>(one["count"]);
+		CActor* a = smart_cast<CActor*>(Level().Objects.net_Find(to));
+		const u32 before = a ? a->get_money() : 0;
+		if (a && amount > 0)
+		{
+			// natively on the paid player's own actor (dialogs.relocate_money pays
+			// db.actor, which outside an entered context is participant 1's)
+			a->set_money(a->get_money() + u32(amount), true);
+			string128 news;
+			xr_sprintf(news, "Party task reward: %d RU for %d bandit patches", amount, count);
+			campaign::present_to_actor(a, campaign::Presentation::News, 0, news);
+			++payments;
+			g_host->quest_money_paid += u64(amount);
+		}
+		g_host->log.line("quest-paid revision=%I64u task=%s actor=%u entity=%I64u patches=%d amount=%d money=%u->%u",
+			revision, p.task.c_str(), u32(to), entity_of(to), count, amount, before, a ? a->get_money() : 0);
+	}
+	luabind::functor<void> change;
+	const bool have_change = ai().script_engine().functor("game_relations.change_factions_community_num", change);
+	luabind::object gw = e["goodwill"];
+	for (int i = 1; gw.type() == LUA_TTABLE; ++i)
+	{
+		luabind::object one = gw[i];
+		if (one.type() != LUA_TTABLE)
+			break;
+		LPCSTR community = luabind::object_cast<LPCSTR>(one["community"]);
+		const int delta = int(luabind::object_cast<float>(one["delta"]));
+		for (u16 id : g_host->party_actor_ids)
+			if (id != 0xffff && have_change)
+			{
+				change(community, int(id), delta);
+				++goodwill;
+				g_host->log.line("quest-goodwill revision=%I64u task=%s actor=%u entity=%I64u community=%s delta=%d",
+					revision, p.task.c_str(), u32(id), entity_of(id), community, delta);
+			}
+	}
+	g_host->quest_items_taken += items;
+	g_host->log.line("quest-effects revision=%I64u task=%s items=%u payments=%u goodwill=%u", revision, p.task.c_str(),
+		items, payments, goodwill);
+	(void)L;
+	return true;
+}
+
+// Every tick: the party's actors to the adapter, the pooled progress to both
+// players, and the pending turn-ins: once the task completed (the native task
+// manager's next update runs its on_complete, which the adapter resolved),
+// apply the effects and answer the turn-in.
+void quest_tick()
+{
+	if (!g_host->party_adapter || !ai().get_alife())
+		return;
+	if (g_host->tick % 25 == 0)
+		sync_party_actors();
+	for (Host::PartyTask& t : g_host->party_tasks)
+		if (g_host->tick % 50 == 0)
+		{
+			s32 count = -1, need = -1;
+			lua_call_ok("campaign_party_count", count, t.id.c_str());
+			lua_call_ok("campaign_party_need", need, t.id.c_str());
+			if (count != t.count || need != t.need)
+			{
+				t.count = count;
+				t.need = need;
+				g_host->log.line("quest-progress task=%s instance=%I64u count=%d need=%d", t.id.c_str(), t.instance, count,
+					need);
+				string128 news;
+				xr_sprintf(news, "Party task: %d of %d bandit patches", _max(count, 0), need);
+				party_news(news);
+			}
+		}
+	for (size_t i = 0; i < g_host->turn_ins.size();)
+	{
+		Host::PendingTurnIn& p = g_host->turn_ins[i];
+		const u64 revision = g_host->commit + 1;
+		const bool done = apply_party_effects(p, revision);
+		if (!done && g_host->tick - p.since_tick < 10 * 50)
+		{
+			++i;
+			continue;
+		}
+		lua_call_void("campaign_party_end_turnin");
+		if (done)
+		{
+			++g_host->commit;
+			++g_host->quests_completed;
+			Host::PartyTask* t = party_task(p.task.c_str());
+			g_host->log.line("quest-completed task=%s instance=%I64u revision=%I64u by_slot=%u holder=%u waiters=%u "
+				"ticks=%I64u", p.task.c_str(), t ? t->instance : 0, revision, u32(p.slot),
+				t ? u32(t->holder) : 0xffffu, u32(p.waiters.size()), g_host->tick - p.since_tick);
+			luabind::functor<void> set_task;
+			if (ai().script_engine().functor("campaign_party_set_task", set_task))
+				set_task(p.task.c_str(), -1);
+			if (t)
+				g_host->party_tasks.erase(g_host->party_tasks.begin() + (t - g_host->party_tasks.data()));
+			party_news("Party task complete: Mobbing the Mob");
+			coop::store::failpoint("quest:after-apply");
+		}
+		else
+			g_host->log.line("quest-turnin-timeout task=%s slot=%u", p.task.c_str(), u32(p.slot));
+		for (Host::QuestWaiter& w : p.waiters)
+		{
+			coop::proto::ActionResult& result = w.result;
+			if (done)
+			{
+				result.outcome = coop::proto::ActionOutcome::Accepted;
+				result.reason = 0;
+				result.commit_id = revision;
+				result.revision = revision;
+				StoredOutcome stored = {u8(coop::proto::ActionOutcome::Accepted), 0, revision};
+				if (g_host->persistence)
+					g_host->persistence->remember(w.player, result.operation_id, stored);
+				Host::QuestAnswer answer;
+				answer.w = w;
+				answer.since_tick = g_host->tick;
+				answer.what = "complete";
+				g_host->quest_answers.push_back(answer);
+			}
+			else
+			{
+				result.outcome = coop::proto::ActionOutcome::Rejected;
+				result.reason = coop::proto::kReasonQuestNotFinished;
+				result.server_tick = g_host->tick;
+				g_host->server->send(w.player, coop::proto::Message(result));
+			}
+		}
+		g_host->turn_ins.erase(g_host->turn_ins.begin() + i);
+	}
