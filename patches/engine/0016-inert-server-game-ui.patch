+// S02-T06a: wall time spent in script binder updates, all objects and the
+// actor (object id 0), for the campaign smoke's tick report.
+static u64 s_binder_update_cycles = 0;
+static u64 s_actor_binder_update_cycles = 0;
+static u32 s_actor_binder_update_calls = 0;
+
+void ScriptBinderUpdateStats(float& total_ms, float& actor_ms, u32& actor_calls)
+{
+	total_ms = float(s_binder_update_cycles) * 1000.f / float(CPU::qpc_freq);
+	actor_ms = float(s_actor_binder_update_cycles) * 1000.f / float(CPU::qpc_freq);
+	actor_calls = s_actor_binder_update_calls;
+}
+
 void CScriptBinder::shedule_Update(u32 time_delta)
 {
 	if (m_object)
 	{
+		const u64 start = CPU::QPC();
 		__try
 		{
 			m_object->shedule_Update(time_delta);
@@ -265,6 +279,14 @@ void CScriptBinder::shedule_Update(u32 time_delta)
 		{
 			clear();
 		}
+		const u64 spent = CPU::QPC() - start;
+		s_binder_update_cycles += spent;
+		CGameObject* object = smart_cast<CGameObject*>(this);
+		if (object && object->ID() == 0)
+		{
+			s_actor_binder_update_cycles += spent;
+			++s_actor_binder_update_calls;
+		}
 	}
 }
 
