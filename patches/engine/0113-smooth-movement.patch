+// B51: a co-op client's correction of its predicted actor: the body, its safe and death positions and both
+// interpolation points move by delta, so what is shown keeps its pace (no restart from the new place) and the
+// body keeps its lead over the shown position
+void CPHSimpleCharacter::ShiftPosition(const Fvector& delta)
+{
+	m_safe_position[0] += delta.x;
+	m_safe_position[1] += delta.y;
+	m_safe_position[2] += delta.z;
+	if (!b_exist)
+		return;
+	m_death_position[0] += delta.x;
+	m_death_position[1] += delta.y;
+	m_death_position[2] += delta.z;
+	const dReal* p = dBodyGetPosition(m_body);
+	dBodySetPosition(m_body, p[0] + delta.x, p[1] + delta.y, p[2] + delta.z);
+	for (u16 i = 0; i < CPHInterpolation::PH_INTERPOLATION_POINTS; ++i)
+	{
+		Fvector q;
+		m_body_interpolation.GetPosition(q, i);
+		q.add(delta);
+		m_body_interpolation.SetPosition(q, i);
+	}
+	CPHDisablingTranslational::Reinit();
+	CPHObject::spatial_move();
+}
