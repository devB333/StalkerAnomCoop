+{
+	if (!psy_coop_server())
+		return Actor();
+	if (m_target_id != 0xffff)
+		if (CActor* held = smart_cast<CActor*>(Level().Objects.net_Find(m_target_id)))
+			return held;
+	return smart_cast<CActor*>(const_cast<CEntityAlive*>(m_object->EnemyMan.get_enemy()));
+}
+
+void CControllerPsyHit::present_phase(u8 phase, const Fvector& position, float value)
+{
+	CActor* target = target_actor();
+	if (!target)
+		return;
+	campaign::ParticipantRef ref;
+	if (campaign::participant_of(target, ref) != campaign::Refusal::None)
+		return;
+	campaign::PresentationArgs args;
+	args.position = position;
+	args.value = value;
+	args.flags = phase;
+	campaign::present(ref, campaign::Presentation::ControllerPsyHit, u16(m_object->ID()), "", args);
+	campaign::coop_server_psy_hit(u16(m_object->ID()), u16(target->ID()), phase, target->GetfHealth());
 }
 
