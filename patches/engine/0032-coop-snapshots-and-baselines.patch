+bool object_state(CPhysicsShellHolder* object, coop::proto::EntityState& out, Fquaternion& rotation)
+{
+	const Fmatrix& m = object->XFORM();
+	if (!encodable(m.c))
+		return false;
+	rotation.set(m);
+	const float n = _sqrt(rotation.x * rotation.x + rotation.y * rotation.y + rotation.z * rotation.z +
+		rotation.w * rotation.w);
+	if (!_valid(n) || n < 0.5f)
+		return false;
+	rotation.x /= n;
+	rotation.y /= n;
+	rotation.z /= n;
+	rotation.w /= n;
+	if (rotation.w < 0.f) // q and -q are one rotation: send one of them
+	{
+		rotation.x = -rotation.x;
+		rotation.y = -rotation.y;
+		rotation.z = -rotation.z;
+		rotation.w = -rotation.w;
+	}
+	out.components = coop::proto::kTransform | coop::proto::kRotation;
+	out.transform.x = m.c.x;
+	out.transform.y = m.c.y;
+	out.transform.z = m.c.z;
+	out.transform.yaw = angle_normalize_signed(yaw_of(m));
+	out.qx = clampr(rotation.x, -1.f, 1.f);
+	out.qy = clampr(rotation.y, -1.f, 1.f);
+	out.qz = clampr(rotation.z, -1.f, 1.f);
+	out.qw = clampr(rotation.w, -1.f, 1.f);
+	return true;
+}
