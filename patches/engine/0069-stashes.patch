+// ------------------------------------------------------------ S10-T04e
+// The stash fixture (profile stash_party, server-driven): once both players
+// are in the world,
+//   created   the treasure manager makes the nearest open inventory box a
+//             stash (two items) in p1's context: the "treasure" map spot
+//             reaches both clients; p1 is placed beside the box when far
+//   opened    p1 uses the box (kind 17): the contents spawn, a checkpoint
+//   taken     p1 takes one item (kind 7): the take callback fires, the spot goes
+//   recovered (the restarted server) the box's remaining items, p1's item, no spot
+static u16 find_stash_box(const Fvector& origin, float& distance)
+{
+	u16 best = 0xffff;
+	distance = flt_max;
+	for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+	{
+		CObject* o = Level().Objects.o_get_by_iterator(i);
+		CInventoryBox* box = o ? smart_cast<CInventoryBox*>(o) : nullptr;
+		if (!box || box->closed() || !box->can_take() || !g_host->published.count(u16(o->ID())))
+			continue;
+		const float d = o->Position().distance_to(origin);
+		if (d < distance)
+		{
+			distance = d;
+			best = u16(o->ID());
+		}
+	}
+	return best;
+}
+
+void stash_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.stash_party || !ai().get_alife())
+		return;
+	Host::StashFixture& f = g_host->stash_fixture;
+	PlayerLink* links[2] = {nullptr, nullptr};
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				links[attached] = &link;
+				actors[attached++] = actor;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		f.recovered = g_host->persistence && g_host->persistence->recovered();
+		g_host->log.line("fixture-stash both-attached tick=%I64u recovered=%d", g_host->tick, f.recovered ? 1 : 0);
+	}
+	if (attached < 2 || f.phase >= 9 || g_host->tick < f.both_since + u64(config.stash_party) * 50)
+		return;
+	if (links[0]->ref.slot != 0)
+	{
+		std::swap(links[0], links[1]);
+		std::swap(actors[0], actors[1]);
+	}
+	PlayerLink& p1 = *links[0];
+	if (f.recovered)
+	{
+		// what the restart kept: the stash box nearest p1 and its contents, p1's items, the spots
+		float distance = 0.f;
+		const u16 box_id = find_stash_box(actors[0]->Position(), distance);
+		CInventoryBox* box = box_id != 0xffff ? smart_cast<CInventoryBox*>(Level().Objects.net_Find(box_id)) : nullptr;
+		xr_vector<campaign::MapSpotState> spots;
+		campaign::map_spots(spots);
+		u32 treasure_spots = 0;
+		for (const campaign::MapSpotState& m : spots)
+			if (m.object == box_id && strstr(m.detail.c_str(), "treasure"))
+				++treasure_spots;
+		u32 medkits = 0, breads = 0;
+		for (PIItem item : actors[0]->inventory().m_all)
+			if (item)
+			{
+				if (!xr_strcmp(*item->object().cNameSect(), "medkit"))
+					++medkits;
+				else if (!xr_strcmp(*item->object().cNameSect(), "bread"))
+					++breads;
+			}
+		g_host->log.line("fixture-stash recovered box=%u box_items=%u treasure_spots=%u p1_medkits=%u p1_breads=%u", u32(box_id),
+			box ? u32(box->m_items.size()) : 0u, treasure_spots, medkits, breads);
+		g_host->log.line("fixture-stash done phase=recovered failures=%u", f.failures);
+		f.phase = 9;
+		return;
+	}
+	coop::proto::ActionIntent intent;
+	coop::proto::ActionResult result;
+	if (f.phase == 0)
+	{
+		float distance = 0.f;
+		f.box = find_stash_box(actors[0]->Position(), distance);
+		CInventoryBox* box = f.box != 0xffff ? smart_cast<CInventoryBox*>(Level().Objects.net_Find(f.box)) : nullptr;
+		if (!box)
+		{
+			g_host->log.line("fixture-stash box-missing");
+			++f.failures;
+			g_host->log.line("fixture-stash done phase=no-box failures=%u", f.failures);
+			f.phase = 9;
+			return;
+		}
+		int created = -1;
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(actors[0]), "fixture-stash");
+			luabind::functor<luabind::object> make;
+			if (ai().script_engine().functor("treasure_manager.set_random_stash", make))
+			{
+				luabind::object items = luabind::newtable(ai().script_engine().lua());
+				items[1] = "medkit";
+				items[2] = "bread";
+				luabind::object made = make(luabind::object(), "coop stash", items, int(f.box)); // no_spot nil: a marked stash
+				created = made.type() == LUA_TNUMBER ? luabind::object_cast<int>(made) : -1;
+			}
+		}
+		if (distance > 2.5f)
+		{
+			Fvector at = box->Position();
+			at.y = actors[0]->Position().y > at.y - 2.f && actors[0]->Position().y < at.y + 2.f ? actors[0]->Position().y : at.y;
+			at.mad(Fvector().sub(actors[0]->Position(), box->Position()).normalize_safe(), 1.2f);
+			place_beside(actors[0], at);
+		}
+		f.items_before = u32(box->m_items.size());
+		g_host->log.line("fixture-stash created box=%u name=%s created=%d distance=%.1f items=%u", u32(f.box), *box->cName(), created,
+			distance, f.items_before);
+		if (created != int(f.box))
+			++f.failures;
+		f.phase = 1;
+		f.phase_tick = g_host->tick + 2 * 50;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		if (g_host->tick < f.phase_tick)
+			return;
+		fixture_intent(intent, coop::proto::kActionUseObject, f.box, kTradeFixtureOpBase + 0x2000 + ++f.ops);
+		const u16 reason = take_use_object(p1, intent, result);
+		g_host->log.line("fixture-stash opened box=%u reason=%u", u32(f.box), u32(reason));
+		if (reason)
+			++f.failures;
+		f.phase = 2;
+		f.phase_tick = g_host->tick + 2 * 50;
+		return;
+	}
+	if (f.phase == 2)
+	{
+		if (g_host->tick < f.phase_tick)
+			return;
+		CInventoryBox* box = smart_cast<CInventoryBox*>(Level().Objects.net_Find(f.box));
+		const u32 items = box ? u32(box->m_items.size()) : 0;
+		u16 reason = 0xffff;
+		if (box && items > f.items_before)
+		{
+			for (u16 id : box->m_items)
+				if (g_host->published.count(id))
+				{
+					f.taken = id;
+					break;
+				}
+		}
+		if (f.taken != 0xffff)
+		{
+			CGameObject* item = smart_cast<CGameObject*>(Level().Objects.net_Find(f.taken));
+			f.taken_section = item ? *item->cNameSect() : "";
+			coop::proto::EntityRef from_ref, to_ref;
+			entity_ref_of(f.box, from_ref);
+			entity_ref_of(u16(actors[0]->ID()), to_ref);
+			fixture_intent(intent, coop::proto::kActionTransfer, f.taken, kTradeFixtureOpBase + 0x2000 + ++f.ops);
+			put_entity_ref(intent.params, from_ref);
+			put_entity_ref(intent.params, to_ref);
+			reason = take_transfer(p1, intent, result);
+		}
+		g_host->log.line("fixture-stash spawned box=%u items=%u->%u taken=%u section=%s reason=%u", u32(f.box), f.items_before, items,
+			u32(f.taken), f.taken_section.c_str(), u32(reason));
+		if (items <= f.items_before || reason)
+			++f.failures;
+		f.phase = 3;
+		f.phase_tick = g_host->tick + 2 * 50;
+		return;
+	}
+	if (f.phase == 3)
+	{
+		if (g_host->tick < f.phase_tick)
+			return;
+		CInventoryBox* box = smart_cast<CInventoryBox*>(Level().Objects.net_Find(f.box));
+		xr_vector<campaign::MapSpotState> spots;
+		campaign::map_spots(spots);
+		u32 treasure_spots = 0;
+		for (const campaign::MapSpotState& m : spots)
+			if (m.object == f.box && strstr(m.detail.c_str(), "treasure"))
+				++treasure_spots;
+		bool p1_has = false;
+		for (PIItem item : actors[0]->inventory().m_all)
+			if (item && u16(item->object().ID()) == f.taken)
+				p1_has = true;
+		g_host->log.line("fixture-stash done phase=stashed failures=%u box=%u box_items=%u treasure_spots=%u p1_has=%d taken=%u "
+			"section=%s", f.failures, u32(f.box), box ? u32(box->m_items.size()) : 0u, treasure_spots, p1_has ? 1 : 0, u32(f.taken),
+			f.taken_section.c_str());
+		f.phase = 9;
+	}
