+		"actors_ok=%d verdict=%s why=%s ticks=%I64u",
+		f.first + f.next, t.id.c_str(), t.kind.c_str(), t.giver.c_str(), u32(f.giver), u32(f.acceptor), f.accept.c_str(),
+		f.goal.c_str(), f.turnin.c_str(), native.c_str(), u32(g_host->quests_completed - f.completed_before),
+		f.money_before[0], a0 ? a0->get_money() : 0, f.money_before[1], a1 ? a1->get_money() : 0,
+		g_host->quest_items_taken - f.taken_before, g_host->quest_items_given - f.given_before,
+		g_host->quest_money_paid - f.paid_before, g_host->refnil_cleared - f.refnil_before, alife_ok ? 1 : 0,
+		pass ? "pass" : !xr_strcmp(verdict, "pass") ? "fail" : verdict, why, g_host->tick - f.task_tick);
+	f.phase = 8;
+	f.phase_tick = g_host->tick;
+}
+
+void quest_sweep_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.quest_sweep || !ai().get_alife() || !g_host->party_adapter)
+		return;
+	Host::QuestSweep& f = g_host->quest_sweep;
+	if (f.finished)
+		return;
+	PlayerLink* links[2] = {nullptr, nullptr};
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.ref.slot < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				links[link.ref.slot] = &link;
+				actors[link.ref.slot] = actor;
+				++attached;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-qsweep both-attached tick=%I64u", g_host->tick);
+	}
+	if (attached < 2 || g_host->tick < f.both_since + u64(config.quest_sweep) * 50)
+		return;
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	if (!f.loaded)
+	{
+		f.loaded = true;
+		f.first = config.quest_sweep_first;
+		FILE* r = config.quest_sweep_list[0] ? fopen(config.quest_sweep_list, "rb") : nullptr;
+		u32 line_no = 0;
+		string1024 line;
+		while (r && fgets(line, sizeof(line), r))
+		{
+			if (!line[0] || line[0] == '#' || line[0] == '\r' || line[0] == '\n')
+				continue;
+			const u32 n = line_no++;
+			if (n < config.quest_sweep_first ||
+				(config.quest_sweep_count && n >= config.quest_sweep_first + config.quest_sweep_count))
+				continue;
+			string256 id, kind, giver;
+			if (sscanf(line, "%255s %255s %255s", id, kind, giver) != 3)
+				continue;
+			f.tasks.push_back({id, kind, giver});
+		}
+		if (r)
+			fclose(r);
+		const bool installed = sleep_lua(nullptr, qsweep_source, "qsweep-install");
+		g_host->log.line("fixture-qsweep loaded list=%s tasks=%u first=%u count=%u installed=%d level=%s",
+			config.quest_sweep_list, u32(f.tasks.size()), config.quest_sweep_first, config.quest_sweep_count,
+			installed ? 1 : 0, *Level().name());
+		if (f.tasks.empty() || !installed)
+		{
+			f.finished = true;
+			g_host->log.line("fixture-qsweep done passed=0 failed=0 skipped=0 tasks=0 why=%s",
+				f.tasks.empty() ? "empty-list" : "not-installed");
+			return;
+		}
+	}
+	for (CActor* a : actors)
+		qsweep_heal(a);
+	if (f.next >= f.tasks.size())
+	{
+		f.finished = true;
+		g_host->log.line("fixture-qsweep done passed=%u failed=%u skipped=%u tasks=%u refnil=%u", f.passed, f.failed,
+			f.skipped, u32(f.tasks.size()), g_host->refnil_cleared);
+		return;
+	}
+	const Host::QuestSweepTask& t = f.tasks[f.next];
+	LPCSTR task = t.id.c_str();
+	CActor* anchor = actors[0];
+	const u8 other = u8(1 - f.acceptor);
+	CGameObject* giver = f.giver != 0xffff ? smart_cast<CGameObject*>(Level().Objects.net_Find(f.giver)) : nullptr;
+	switch (f.phase)
+	{
+	case 0: // begin: the giver
+	{
+		f.task_tick = g_host->tick;
+		f.giver = 0xffff;
+		f.spawned_giver = false;
+		f.acceptor = u8(f.next % 2);
+		f.accept = "-";
+		f.goal = "-";
+		f.turnin = "-";
+		f.target = -1;
+		f.money_before[0] = actors[0]->get_money();
+		f.money_before[1] = actors[1]->get_money();
+		f.completed_before = g_host->quests_completed;
+		f.taken_before = g_host->quest_items_taken;
+		f.given_before = g_host->quest_items_given;
+		f.paid_before = g_host->quest_money_paid;
+		f.refnil_before = g_host->refnil_cleared;
+		if (party_task(task) || Level().GameTaskManager().HasGameTask(shared_str(task), true))
+		{
+			quest_sweep_result(f, "skip", "already-active");
+			return;
+		}
+		if (t.kind == "scripted")
+		{
+			quest_sweep_result(f, "skip", "scripted-event"); // its reward needs the event played out
+			return;
+		}
+		if (t.giver == "none")
+		{
+			f.phase = 3; // given directly
+			return;
+		}
+		if (t.giver.compare(0, 4, "sim:") == 0)
+		{
+			xr_string community = t.giver.substr(4);
+			if (community == "army")
+				community = "military"; // the sim sections' names (sim_default_military_*)
+			else if (community == "dolg")
+				community = "duty";
+			string128 section = "";
+			for (int rank : {1, 0, 2, 3})
+			{
+				string128 s;
+				xr_sprintf(s, "sim_default_%s_%d", community.c_str(), rank);
+				if (pSettings->section_exist(s))
+				{
+					xr_strcpy(section, s);
+					break;
+				}
+			}
+			Fvector at = actors[0]->Position();
+			at.z += 2.f;
+			const CSE_ALifeDynamicObject* anchor_se = ai().alife().objects().object(u16(actors[0]->ID()), true);
+			CSE_Abstract* npc = section[0] && anchor_se ? alife->spawn_item(section, at,
+				actors[0]->ai_location().level_vertex_id(), actors[0]->ai_location().game_vertex_id(), u16(-1)) : nullptr;
+			if (!npc)
+			{
+				quest_sweep_result(f, "fail", "giver-spawn");
+				return;
+			}
+			f.giver = npc->ID;
+			f.spawned_giver = true;
+			g_host->log.line("fixture-qsweep giver-spawned task=%s section=%s id=%u", task, section, u32(f.giver));
+			f.phase = 1;
+			f.phase_tick = g_host->tick;
+			return;
+		}
+		f.giver = qsweep_find_online(t.giver);
+		if (f.giver == 0xffff)
+		{
+			const CSE_ALifeDynamicObject* se = qsweep_find_offline(t.giver);
+			if (!se)
+			{
+				quest_sweep_result(f, "skip", "giver-not-on-level");
+				return;
+			}
+			f.giver = se->ID;
+			Fvector at = se->o_Position;
+			at.x += 3.f;
+			place_beside(actors[0], at);
+			at.x += 1.5f;
+			place_beside(actors[1], at);
+			g_host->log.line("fixture-qsweep giver-offline task=%s id=%u placed=%.1f,%.1f,%.1f", task, u32(f.giver),
+				at.x, at.y, at.z);
+		}
+		f.phase = 1;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	case 1: // the giver online: both players beside it, the roll and the goodwill
+	{
+		CEntityAlive* alive = giver ? smart_cast<CEntityAlive*>(giver) : nullptr;
+		if (!alive || !alive->g_Alive() || !delivered(f.giver))
+		{
+			if (g_host->tick - f.phase_tick > 25 * 50)
+				quest_sweep_result(f, f.spawned_giver ? "fail" : "skip", "giver-offline");
+			return;
+		}
+		const Fvector g = giver->Position();
+		for (u32 k = 0; k < 2; ++k)
+		{
+			Fvector at = g;
+			at.x += k == f.acceptor ? 1.2f : -1.2f;
+			place_beside(actors[k], at);
+		}
+		luabind::functor<int> prepare;
+		if (ai().script_engine().functor("campaign_qsweep_prepare_giver", prepare))
+			prepare(int(f.giver), f.spawned_giver ? task : "");
+		f.phase = 2;
+		f.phase_tick = g_host->tick + 2 * 50;
+		return;
+	}
+	case 2: // accept by talking
+	{
+		if (g_host->tick < f.phase_tick)
+			return;
+		if (!giver)
+		{
+			quest_sweep_result(f, "fail", "giver-gone");
+			return;
+		}
+		PlayerLink& acceptor = *links[f.acceptor];
+		const u16 started = qsweep_talk_start(acceptor, f.giver);
+		xr_string topic, all;
+		const bool has = !started && qsweep_topic(actors[f.acceptor], giver, "ordered_task_dialog", "cancel", topic, all);
+		u32 skips = 0;
+		bool said = false;
+		if (has && !qsweep_say(acceptor, topic.c_str()))
+		{
+			u32 base = 0;
+			for (; skips < 12 && acceptor.talk_npc != 0xffff; ++skips)
+			{
+				const xr_string offered = qsweep_offered(f.giver);
+				if (offered.empty())
+					break;
+				string16 phrase;
+				if (offered == t.id)
+				{
+					xr_sprintf(phrase, "%u", base + 2);
+					said = qsweep_say(acceptor, phrase) == 0;
+					break;
+				}
+				xr_sprintf(phrase, "%u", base + 10);
+				if (qsweep_say(acceptor, phrase))
+					break;
+				base += 10;
+			}
+		}
+		qsweep_talk_end(acceptor);
+		if (party_task(task))
+			f.accept = "talk";
+		else
+		{
+			g_host->log.line("fixture-qsweep talk-accept-failed task=%s start=%u topic=%s said=%d skips=%u topics=[ %s]",
+				task, u32(started), has ? topic.c_str() : "-", said ? 1 : 0, skips, all.c_str());
+			f.accept = has ? (said ? "talk-refused" : "talk-not-offered") : "talk-no-topic";
+		}
+		f.phase = 3;
+		return;
+	}
+	case 3: // a task the talk did not give: given directly to the party
+	{
+		if (!party_task(task))
+		{
+			s32 given = 0;
+			{
+				campaign::ScriptContextScope scope(static_cast<const CObject*>(anchor), "qsweep-give");
+				if (scope.entered())
+					lua_call_ok("campaign_qsweep_give", given, task, int(f.giver == 0xffff ? -1 : f.giver));
+			}
+			CGameTask* native = Level().GameTaskManager().HasGameTask(shared_str(task), true);
+			if (!given || !native)
+			{
+				quest_sweep_result(f, "fail", "not-given");
+				return;
+			}
+			party_task_accepted(*links[f.acceptor], task, f.giver, anchor, 0);
+			f.accept = f.accept == "-" ? xr_string("direct") : f.accept + "+direct";
+		}
+		// the goal
+		xr_string section;
+		qsweep_lua_string(nullptr, "campaign_party_section", task, section);
+		s32 need = -1;
+		lua_call_ok("campaign_party_need", need, task);
+		lua_call_ok("campaign_party_bounty_target", f.target, task);
+		if (t.kind == "fetch" && !section.empty() && need > 0)
+		{
+			u32 made = 0;
+			for (s32 n = 0; n < _min(need, 64); ++n)
+				if (give_to(alife, section.c_str(), u16(actors[n % 2]->ID())) != kNoEngineId)
+					++made;
+			string128 g;
+			xr_sprintf(g, "items:%s:%d/%d", section.c_str(), made, need);
+			f.goal = g;
+		}
+		else if (t.kind == "bounty" && f.target >= 0)
+		{
+			CEntityAlive* online = smart_cast<CEntityAlive*>(Level().Objects.net_Find(u16(f.target)));
+			if (!online)
+			{
+				const CSE_ALifeDynamicObject* anchor_se = ai().alife().objects().object(u16(actors[0]->ID()), true);
+				Fvector at = actors[0]->Position();
+				at.z += 3.f;
+				if (anchor_se && ai().alife().objects().object(u16(f.target), true))
+					alife->teleport_object(u16(f.target), actors[0]->ai_location().game_vertex_id(),
+						actors[0]->ai_location().level_vertex_id(), at);
+				f.goal = "killed-teleported";
+				f.phase = 31;
+				f.phase_tick = g_host->tick;
+				return;
+			}
+			if (online->g_Alive())
+				online->KillEntity(actors[other]->ID(), TRUE);
+			f.goal = "killed";
+		}
+		else
+		{
+			s32 stage = -1;
+			lua_call_ok("campaign_qsweep_stage_complete", stage, task);
+			luabind::functor<void> force;
+			if (ai().script_engine().functor("campaign_qsweep_force", force))
+				force(task, stage >= 0 ? "stage" : "complete");
+			f.goal = stage >= 0 ? "forced-stage" : "forced-complete";
+		}
+		f.phase = 4;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	case 31: // an offline bounty target brought beside the players, then killed
+	{
+		CEntityAlive* online = smart_cast<CEntityAlive*>(Level().Objects.net_Find(u16(f.target)));
+		const bool ready = online && online->g_Alive() && delivered(u16(f.target));
+		if (!ready && g_host->tick - f.phase_tick < 20 * 50)
+			return;
+		if (online && online->g_Alive())
+			online->KillEntity(actors[other]->ID(), TRUE);
+		f.phase = 4;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	case 4: // the goal staged (or the task completed by itself)
+	{
+		if (g_host->tick % 25)
+			return;
+		s32 stage = -1;
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(anchor), "qsweep-check");
+			if (scope.entered())
+				lua_call_ok("campaign_party_check", stage, task);
+		}
+		xr_string native;
+		qsweep_lua_string(nullptr, "campaign_qsweep_status", task, native);
+		// "none": the task left the task manager (completed by itself and cleared)
+		if (native.compare(0, 9, "completed") == 0 || native == "none" || g_host->quests_completed > f.completed_before)
+		{
+			f.turnin = "auto";
+			f.phase = 6;
+			f.phase_tick = g_host->tick;
+			return;
+		}
+		if (native.compare(0, 4, "fail") == 0)
+		{
+			quest_sweep_result(f, "fail", "task-failed");
+			return;
+		}
+		s32 stage_complete = -1;
+		lua_call_ok("campaign_qsweep_stage_complete", stage_complete, task);
+		if (stage_complete >= 0 && stage == stage_complete)
+		{
+			f.phase = 5;
+			return;
+		}
+		if (g_host->tick - f.phase_tick > 30 * 50)
+			quest_sweep_result(f, "fail", "goal-not-staged");
+		return;
+	}
+	case 5: // the other player turns it in by talking
+	{
+		PlayerLink& turner = *links[other];
+		if (giver && smart_cast<CEntityAlive*>(giver) && smart_cast<CEntityAlive*>(giver)->g_Alive())
+		{
+			Fvector at = giver->Position();
+			at.x += 1.2f;
+			place_beside(actors[other], at);
+			const u16 started = qsweep_talk_start(turner, f.giver);
+			xr_string topic, all;
+			const bool has = !started && qsweep_topic(actors[other], giver, "completed", nullptr, topic, all);
+			const u16 said = has ? qsweep_say(turner, topic.c_str()) : u16(0xffff);
+			qsweep_talk_end(turner);
+			if (has && !said)
+				f.turnin = "talk";
+			else
+			{
+				g_host->log.line("fixture-qsweep talk-turnin-failed task=%s start=%u topic=%s said=%u topics=[ %s]", task,
+					u32(started), has ? topic.c_str() : "-", u32(said), all.c_str());
+				const u16 reason = party_turn_in_task(turner, giver, task, "qsweep");
+				string64 tn;
+				xr_sprintf(tn, "fixture:%u", u32(reason));
+				f.turnin = tn;
+			}
+		}
+		else
+			f.turnin = "no-giver";
+		f.phase = 6;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	case 6: // completed?
+	{
+		xr_string native;
+		qsweep_lua_string(nullptr, "campaign_qsweep_status", task, native);
+		const bool party_done = g_host->quests_completed > f.completed_before;
+		const bool native_done = native.compare(0, 9, "completed") == 0 || native == "none";
+		if (!(party_done && native_done) && g_host->tick - f.phase_tick < 15 * 50)
+			return;
+		quest_sweep_result(f, party_done && native_done ? "pass" : "fail",
+			party_done ? (native_done ? "-" : "native-not-completed") :
+			native_done ? (f.turnin == "auto" ? "auto-not-party" : "party-not-completed") : "not-completed");
+		return;
+	}
+	case 8: // clean up, then the next task
+	{
+		luabind::functor<int> drop;
+		int dropped = 0;
+		if (ai().script_engine().functor("campaign_qsweep_drop", drop))
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(anchor), "qsweep-drop");
+			if (scope.entered())
+				dropped = drop(task);
+		}
+		qsweep_forget(task);
+		for (PlayerLink* l : links)
+			qsweep_talk_end(*l);
+		if (f.spawned_giver && f.giver != 0xffff)
+		{
+			// the spawned giver dies by its own hand (no player blamed, no goodwill change): a raw release
+			// left its items' parent dangling and an NPC's later weapon clone faulted on it (bugfix-70), the
+			// installed alife_release_id removes an NPC only through its squad (a lone spawn has none), and
+			// a living one of another faction fought the next giver (bugfix-77)
+			CEntityAlive* alive = smart_cast<CEntityAlive*>(Level().Objects.net_Find(f.giver));
+			if (alive && alive->g_Alive())
+				alive->KillEntity(alive->ID(), TRUE);
+			g_host->log.line("fixture-qsweep giver-dismissed id=%u online=%d", u32(f.giver), alive ? 1 : 0);
+		}
+		if (dropped)
+			g_host->log.line("fixture-qsweep dropped task=%s", task);
+		f.giver = 0xffff;
+		f.spawned_giver = false;
+		++f.next;
+		f.phase = 9;
+		f.phase_tick = g_host->tick + 50;
+		return;
+	}
+	case 9: // a second between tasks
+		if (g_host->tick >= f.phase_tick)
+			f.phase = 0;
+		return;
+	}
+}
+
 void pickup_fixtures()
 {
 	const CoopConfig& config = g_host->config;
@@ -21275,6 +22196,7 @@ extern "C" void __cdecl xrCoopServer_Tick(u64 tick)
 	actor_state_tick(); // S10-T04b: the script state of an actor without the installed binder
 	info_fixtures();
 	task_fixtures(); // S10-T05b
+	quest_sweep_fixtures(); // B57
 	trade_fixtures(); // S10-T04c
 	upgrade_fixtures(); // S10-T04f
 	relations_fixtures(); // S10-T04d
