+// S02-T02 campaign server: server-owned CPU subset of init_game_globals and
+// clean_game_globals. UI geometry, inventory shaders, HUD sound settings,
+// wallmarks and UI window lists stay with the client. The normal client
+// keeps calling the two functions above unchanged.
+extern LPCSTR alife_section;
+
+extern "C" void __cdecl xrCampaignGameGlobals_Initialize()
+{
+	CPhraseDialog::InitInternal();
+	CCharacterInfo::InitInternal();
+	CSpecificCharacter::InitInternal();
+	CHARACTER_COMMUNITY::InitInternal();
+	CHARACTER_RANK::InitInternal();
+	CHARACTER_REPUTATION::InitInternal();
+	MONSTER_COMMUNITY::InitInternal();
+}
+
+// Creates the AI space and its script engine with the installed scripts.
+// Returns false if the ALife start callback cannot be resolved. The callback
+// is only resolved here; ALife construction calls it before loading a save.
+extern "C" bool __cdecl xrCampaignScriptEngine_Initialize()
+{
+	LPCSTR start_game_callback = pSettings->r_string(alife_section, "start_game_callback");
+	::luabind::functor<void> functor;
+	const bool resolved = ai().script_engine().functor(start_game_callback, functor);
+	Msg("S02-T02 script-engine start_game_callback=%s resolved=%d", start_game_callback, resolved ? 1 : 0);
+	return resolved;
+}
+
+// The script engine and the objects it creates. The campaign server stops it
+// after the registries, the reverse of its start order; clean_game_globals
+// deletes it first, which is equivalent because registry teardown is data-only.
+extern "C" void __cdecl xrCampaignScriptEngine_Destroy()
+{
+	destroy_lua_wpn_params();
+	xr_delete(g_ai_space);
+	xr_delete(g_object_factory);
+	xr_delete(g_monster_squad);
+
+	story_ids.clear();
+	spawn_story_ids.clear();
+}
+
+extern "C" void __cdecl xrCampaignGameGlobals_Destroy()
+{
+	CPhraseDialog::DeleteSharedData();
+	CPhraseDialog::DeleteIdToIndexData();
+	CCharacterInfo::DeleteSharedData();
+	CCharacterInfo::DeleteIdToIndexData();
+	CSpecificCharacter::DeleteSharedData();
+	CSpecificCharacter::DeleteIdToIndexData();
+	CHARACTER_COMMUNITY::DeleteIdToIndexData();
+	CHARACTER_RANK::DeleteIdToIndexData();
+	CHARACTER_REPUTATION::DeleteIdToIndexData();
+	MONSTER_COMMUNITY::DeleteIdToIndexData();
+
+	CStringTable::Destroy();
+	CUIXmlInit::DeleteColorDefs();
+	InventoryUtilities::ClearCharacterInfoStrings();
+	xr_delete(g_sound_collection_storage);
+	RELATION_REGISTRY::clear_relation_registry();
+}
