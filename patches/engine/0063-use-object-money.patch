+// S10-T04c: on the campaign server a scripted joint drive (ph_door's open
+// and close: set_max_force_and_velocity on the door's joint) is presented to
+// every player, who applies it to the same joint of its own copy, so a door
+// swings on every client (no gameplay script runs on a client, L05).
+void cphysics_joint_scripted::SetForceAndVelocity(const float force, const float velocity, const int axis_num)
+{
+	physics_impl().SetForceAndVelocity(force, velocity, axis_num);
+	if (campaign::process_role() != campaign::Role::Server)
+		return;
+	CPhysicsElement* element = physics_impl().PFirst_element();
+	if (!element)
+		element = physics_impl().PSecond_element();
+	IPhysicsShellHolder* holder = element ? element->PhysicsRefObject() : nullptr;
+	if (!holder)
+		return;
+	campaign::PresentationArgs args;
+	args.handle = physics_impl().BoneID();
+	args.value = force;
+	args.position.set(velocity, float(axis_num), 0.f);
+	campaign::present_broadcast(campaign::Presentation::JointDrive, holder->ObjectID(), "", args);
+}
