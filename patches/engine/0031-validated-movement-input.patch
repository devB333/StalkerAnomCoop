+// ------------------------------------------------------------ S06-T01
+// The movement validation program (profile script = 2). Legs are short runs
+// in the server's world, each logged with its wall-clock window so
+// tools/compare-coop-movement.py can measure what the server did with them:
+//   A  normal stream, away from and back towards the other player (baseline)
+//   B  every batch sent four times (duplicates; over the input rate limit)
+//   C  the tick counter advancing by seven per sample, plus one jump of 100000
+//   D  standing still while A's batches are sent again (a replay)
+//   F  the same legs crouched
+//   G  forward with a stance the actor has no mode for (Prone)
+//   E  forward normally (room for I)
+//   I  sprint into the other player's actor (the obstacle), then back off
+//   J  an action intent asking to be moved 50 m (a teleport)
+//   K  a Snapshot claiming a position (a server-only message)
+// Player 2 (slot 1) starts its program 60 s after player 1's so one actor
+// moves at a time, except where I is the point. Player 1's K leg waits until
+// player 2's program is over (K closes the connection).
+
+void face_away_from_other()
+{
+	CActor* other = other_actor();
+	if (!other || !g_actor)
+	{
+		g_link->log.line("script-face-away no-other-actor");
+		return;
+	}
+	Fvector to;
+	to.sub(other->Position(), g_actor->Position());
+	to.y = 0;
+	to.normalize_safe();
+	float h, p;
+	to.getHP(h, p);
+	CCameraBase* camera = g_actor->cam_Active();
+	camera->yaw = angle_normalize_signed(-h + PI);
+	camera->pitch = 0.f;
+	g_link->log.line("script-face-away other=%u yaw=%.3f", u32(other->ID()), camera->yaw);
+}
+
+void leg_begin(LPCSTR name, u32 bits, coop::proto::Stance stance, bool force_stance, u32 ms, u8 mode)
+{
+	xr_strcpy(g_link->leg_name, name);
+	g_link->drive_bits = bits;
+	g_link->drive_stance = stance;
+	g_link->drive_force_stance = force_stance;
+	g_link->send_mode = mode;
+	g_link->leg_start_ms = g_link->wall.GetElapsed_ms();
+	g_link->leg_start_utc = utc_now_ms();
+	g_link->drive_until = g_link->leg_start_ms + ms;
+	g_link->log.line("script-leg-start name=%s bits=%x stance=%u force=%d ms=%u mode=%u pos=%.2f,%.2f,%.2f", name, bits,
+		u32(stance), force_stance ? 1 : 0, ms, u32(mode), VPUSH(g_actor->Position()));
+}
+
+void send_teleport_intent()
+{
+	coop::proto::ActionIntent intent;
+	intent.operation_id = g_link->teleport_operation = 0x6001;
+	intent.kind = 9; // no kind is defined; a client asking to be moved
+	const auto ref = g_link->refs.find(g_actor->ID());
+	if (ref != g_link->refs.end())
+		intent.target = ref->second;
+	string128 params;
+	xr_sprintf(params, "teleport %.2f %.2f %.2f", g_actor->Position().x + 50.f, g_actor->Position().y,
+		g_actor->Position().z);
+	intent.params.assign(params, params + xr_strlen(params));
+	const bool sent = g_link->client->send(coop::proto::Message(intent));
+	g_link->log.line("script-teleport-intent sent=%d operation=%I64u target=%I64u/%u", sent ? 1 : 0,
+		intent.operation_id, intent.target.id, intent.target.generation);
+}
+
+void send_forged_snapshot()
+{
+	// A server-only message claiming the player's actor is 50 m away. The
+	// server's decoder refuses the direction and closes the connection.
+	coop::proto::Snapshot forged;
+	forged.server_tick = g_link->last_snapshot_tick + 1;
+	coop::proto::SnapshotEntity e;
+	const auto ref = g_link->refs.find(g_actor->ID());
+	if (ref != g_link->refs.end())
+		e.entity = ref->second;
+	e.components = coop::proto::kTransform;
+	e.transform.x = g_actor->Position().x + 50.f;
+	e.transform.y = g_actor->Position().y;
+	e.transform.z = g_actor->Position().z;
+	forged.entities.push_back(e);
+	g_link->forged_snapshot_sent = true;
+	const bool sent = g_link->client->send(coop::proto::Message(forged));
+	g_link->log.line("script-forged-snapshot sent=%d entity=%I64u/%u x=%.2f", sent ? 1 : 0, e.entity.id,
+		e.entity.generation, e.transform.x);
+}
