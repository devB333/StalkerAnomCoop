+// S08-T06: after a restart, the party's task as the recovered world holds it:
+// a supported task in process on the native task manager is the party's,
+// held by participant 1's actor, with the instance its portable store keeps.
+void rebuild_party_tasks()
+{
+	CActor* anchor = nullptr;
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot == 0)
+			anchor = participant_actor(l.ref);
+	if (!anchor)
+		anchor = smart_cast<CActor*>(Level().Objects.net_Find(0));
+	// The tasks a checkpoint holds come back unowned, and an unowned task's
+	// checks are refused while two actors exist (S03-T02), so none of them
+	// could complete after a restart (qx-2). The native save is participant
+	// 1's actor's: its tasks are participant 1's (participant 2's tasks are
+	// not in it, L32).
+	if (anchor)
+	{
+		u32 owned = 0, loaded = 0;
+		for (SGameTaskKey& key : Level().GameTaskManager().GetGameTasks())
+			if (CGameTask* task = key.game_task)
+			{
+				++loaded;
+				if (!task->m_campaign_owned)
+				{
+					campaign::set_task_owner(task, anchor);
+					owned += task->m_campaign_owned ? 1 : 0;
+				}
+			}
+		g_host->log.line("quest-owners-restored tasks=%u given_to_participant_1=%u actor=%u", loaded, owned,
+			u32(anchor->ID()));
+	}
+	for (LPCSTR id : kPartyTasks)
+	{
+		if (party_task(id) || !Level().GameTaskManager().HasGameTask(shared_str(id), true) || !anchor)
+			continue;
+		int instance = 0;
+		luabind::functor<luabind::object> load_var;
+		if (ai().script_engine().functor("_G.load_var", load_var))
+		{
+			luabind::object v = load_var(anchor->lua_game_object(), (xr_string(id) + "_coop_instance").c_str());
+			if (v.type() == LUA_TNUMBER)
+				instance = luabind::object_cast<int>(v);
+		}
+		Host::PartyTask t;
+		t.id = id;
+		t.holder_slot = 0;
+		t.holder = u16(anchor->ID());
+		t.instance = instance > 0 ? u64(instance) : ++g_host->quest_instances;
+		g_host->quest_instances = _max(g_host->quest_instances, t.instance);
+		t.accepted_tick = g_host->tick;
+		g_host->party_tasks.push_back(t);
+		luabind::functor<void> set_task;
+		if (ai().script_engine().functor("campaign_party_set_task", set_task))
+			set_task(id, int(anchor->ID()));
+		g_host->log.line("quest-rebuilt task=%s instance=%I64u holder=%u", id, t.instance, u32(t.holder));
+	}
+}
