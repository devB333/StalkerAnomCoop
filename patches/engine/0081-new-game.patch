+// S10-T03f: the new-game script's ChangeLevel to the start location (single player: the actor's first update
+// moves it from the spawn's level to the faction's start) is taken as the start move: true when it is
+bool new_game_request(const Fvector& position, u32 level_vertex, u16 game_vertex, LPCSTR path)
+{
+	if (!g_host || !g_host->new_game_started || g_host->new_game_state != 0)
+		return false;
+	if (!ai().get_game_graph() || !ai().game_graph().valid_vertex_id(game_vertex) || !_valid(position))
+	{
+		g_host->log.line("new-game-start-refused path=%s gvid=%u reason=malformed", path, u32(game_vertex));
+		return false;
+	}
+	g_host->new_game_state = 1;
+	g_host->new_game_position = position;
+	g_host->new_game_level_vertex = level_vertex;
+	g_host->new_game_game_vertex = game_vertex;
+	g_host->log.line("new-game-start-asked path=%s from=%s level=%s gvid=%u lvid=%u pos=%.2f,%.2f,%.2f", path,
+		Level().name().c_str(), *ai().game_graph().header().level(ai().game_graph().vertex(game_vertex)->level_id()).name(),
+		u32(game_vertex), level_vertex, VPUSH(position));
+	return true;
