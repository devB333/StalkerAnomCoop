+void CoopPersistence::fail(LPCSTR what, const FileError& error)
+{
+	if (m_failed)
+		return;
+	m_failed = true;
+	m_failure = std::string(what) + ": " + (error.what.empty() ? "unknown" : error.what);
+	m_log->line("store-failed what=%s code=%u", m_failure.c_str(), error.code);
+}
+
+bool CoopPersistence::recover(xr_string& save_name, xr_string& reason)
+{
+	save_name = "";
+	reason = "";
+	Recovered& r = m_recovered_state;
+	const RecoverStatus status = m_store.recover(r);
+	for (const std::string& d : r.detail)
+		m_log->line("recovery-detail %s", d.c_str());
+	std::string detail;
+	switch (status)
+	{
+	case RecoverStatus::Fresh:
+	{
+		// The campaign's first start: the base save. A journal 0 of an earlier
+		// incarnation that never published may hold acknowledged records.
+		m_generation = 0;
+		const std::string path = m_store.path_of(StoreNames::journal_file(0));
+		if (file_exists(path))
+		{
+			JournalContents contents;
+			const JournalStatus js = read_journal(path, contents);
+			if (js != JournalStatus::Ok && js != JournalStatus::TornTail)
+			{
+				reason = "recovery-journal";
+				m_log->line("recovery-refused reason=%s journal=0 status=%s detail=%s", reason.c_str(), to_string(js),
+					contents.detail.c_str());
+				return false;
+			}
+			if (js == JournalStatus::TornTail)
+				++r.torn_tails;
+			for (const JournalRecord& record : contents.records)
+			{
+				r.highest_epoch = _max(r.highest_epoch, record.epoch);
+				r.highest_revision = _max(r.highest_revision, record.revision);
+				if (record.kind != kRecordEpoch)
+					r.replay.push_back(record);
+			}
+		}
+		break;
+	}
+	case RecoverStatus::Recovered:
+		m_recovered = true;
+		m_generation = r.generation;
+		save_name = StoreNames::save_name(r.generation).c_str();
+		break;
+	case RecoverStatus::NoPointer: reason = "recovery-no-pointer"; break;
+	case RecoverStatus::NoValidGeneration: reason = "recovery-no-valid-generation"; break;
+	case RecoverStatus::Incompatible: reason = "recovery-incompatible"; break;
+	}
+	if (!reason.empty())
+	{
+		m_log->line("recovery-refused reason=%s status=%s", reason.c_str(), to_string(status));
+		return false;
+	}
+	m_base_revision = _max(r.highest_revision, r.manifest.revision);
+	m_epoch = r.highest_epoch + 1;
+	// The operation index up to R_G from the supplemental, then from the
+	// replay list (ledger records name their operation).
+	for (const SupplementalOperation& o : r.supplemental.operations)
+	{
+		StoredOutcome s = {o.outcome, o.reason, o.revision};
+		remember(o.player, o.operation, s);
+	}
+	for (const JournalRecord& record : r.replay)
+	{
+		LedgerRecord ledger;
+		if (record.kind == kRecordLedger && decode_ledger(record.payload, ledger))
+		{
+			StoredOutcome s = {1 /* Accepted */, 0, record.revision};
+			remember(ledger.player, ledger.operation, s);
+		}
+	}
+	// Step 4: the epoch, durably, before anything else (the journal of the
+	// chosen generation; a fresh campaign writes journal 0).
+	if (!m_store.open_journal(m_generation, m_recovered ? r.manifest.revision : 0, m_journal, detail))
+	{
+		reason = "recovery-journal";
+		m_log->line("recovery-refused reason=%s detail=%s", reason.c_str(), detail.c_str());
+		return false;
+	}
+	if (!commit(kRecordEpoch, 0, m_base_revision, {}))
+	{
+		reason = "recovery-journal";
+		m_log->line("recovery-refused reason=%s detail=epoch-record %s", reason.c_str(), m_failure.c_str());
+		return false;
+	}
+	m_log->line("recovery status=%s generation=%u fallback=%d revision=%I64u epoch=%I64u replay=%u torn_tails=%u "
+		"index=%u participants=%u entities=%u save=%s",
+		to_string(status), m_generation, r.fallback ? 1 : 0, m_base_revision, m_epoch, u32(r.replay.size()),
+		r.torn_tails, u32(m_index.size()), u32(r.supplemental.participants.size()),
+		u32(r.supplemental.entities.size()), save_name.empty() ? "(base)" : save_name.c_str());
+	return true;
+}
+
+void CoopPersistence::restore_identities(CampaignIdentityRegistry& registry) const
+{
+	if (!m_recovered)
+		return;
+	const Supplemental& s = m_recovered_state.supplemental;
+	registry.restore_entities(s.entities, s.next_entity);
+	m_log->line("recovery-identities entities=%u next_entity=%I64u", u32(s.entities.size()), s.next_entity);
+}
+
+bool CoopPersistence::lookup(const coop::proto::Uuid128& player, u64 operation, StoredOutcome& out) const
+{
+	const IndexKey key = {player, operation};
+	const auto it = m_index.find(key);
+	if (it == m_index.end())
+		return false;
+	out = it->second;
+	return true;
+}
+
+void CoopPersistence::remember(const coop::proto::Uuid128& player, u64 operation, const StoredOutcome& outcome)
+{
+	const IndexKey key = {player, operation};
+	m_index[key] = outcome;
+}
+
+void CoopPersistence::fail_closed(LPCSTR why)
+{
+	FileError error;
+	error.what = why ? why : "injected";
+	fail("fail-closed", error);
+}
+
+bool CoopPersistence::commit(u8 kind, u64 tick, u64 revision, const std::vector<u8>& payload)
+{
+	if (m_failed)
+		return false;
+	FileError error;
+	if (!m_journal.is_open())
+	{
+		error.what = "journal not open";
+		fail("commit", error);
+		return false;
+	}
+	if (!m_journal.append(kind, m_epoch, tick, revision, payload, &error))
+	{
+		fail("commit", error);
+		return false;
+	}
+	++m_commits;
+	return true;
+}
+
+std::string CoopPersistence::generation_path(const char* extension) const
+{
+	return m_store.path_of(StoreNames::generation_file(m_generation, extension));
+}
+
+bool CoopPersistence::publish(u32 generation, u64 revision, u64 tick, u64 game_time, u32 level_id, LPCSTR level,
+	const std::vector<PersistParticipant>& participants, const std::vector<std::pair<u16, u64>>& entities,
+	u64 next_entity, LPCSTR build_id, LPCSTR content_digest, u16 protocol_major, std::string& detail)
+{
+	if (m_failed)
+	{
+		detail = "store failed: " + m_failure;
+		return false;
+	}
+	Supplemental s;
+	s.campaign = m_campaign;
+	s.party = m_party;
+	s.generation = generation;
+	s.revision = revision;
+	s.epoch = m_epoch;
+	s.tick = tick;
+	s.game_time = game_time;
+	s.level_id = level_id;
+	s.level = level ? level : "";
+	s.next_entity = next_entity;
+	for (const PersistParticipant& p : participants)
+	{
+		SupplementalParticipant sp;
+		sp.slot = p.slot;
+		sp.slot_generation = p.slot_generation;
+		sp.player = p.player;
+		sp.actor_id = p.actor_id;
+		sp.actor_entity = p.actor_entity;
+		sp.alive = p.alive;
+		sp.position[0] = p.position.x;
+		sp.position[1] = p.position.y;
+		sp.position[2] = p.position.z;
+		sp.name = p.name.c_str();
+		s.participants.push_back(sp);
+	}
+	s.entities = entities;
+	for (const auto& entry : m_index)
+	{
+		SupplementalOperation o;
+		o.player = entry.first.player;
+		o.operation = entry.first.operation;
+		o.outcome = entry.second.outcome;
+		o.reason = entry.second.reason;
+		o.revision = entry.second.revision;
+		s.operations.push_back(o);
+	}
+	Manifest m;
+	m.campaign = m_campaign;
+	m.generation = generation;
+	m.revision = revision;
+	m.epoch = m_epoch;
+	m.tick = tick;
+	m.game_time = game_time;
+	m.level_id = level_id;
+	m.level = s.level;
+	m.build_id = build_id ? build_id : "";
+	m.content_digest = content_digest ? content_digest : "";
+	m.protocol_major = protocol_major;
+	const bool ok = m_store.publish(generation, m, encode_supplemental(s), ALIFE_VERSION, m_journal, detail);
+	if (ok)
+		m_generation = generation;
+	else if (!m_journal.is_open() || m_journal.failed())
+	{
+		// The generation may be published but the writer could not continue
+		// (contract §5 step 6/7): fail closed.
+		FileError error;
+		error.what = detail;
+		fail("publish", error);
+	}
+	return ok;
+}
