+// S06-T04: the action kinds (coop::proto::ActionKind). The player names no
+// actor: the action acts on the actor its session's context resolves
+// (Scope::Self). Returns 0 when accepted, else the refusal reason:
+//   1 unsupported kind, 2 malformed params, 3 no actor, 4 nothing to act on
+u16 take_action(PlayerLink& link, const coop::proto::ActionIntent& intent)
+{
+	if (intent.kind != coop::proto::kActionActivateSlot && intent.kind != coop::proto::kActionReload)
+		return 1;
+	if (!link.session)
+		return 3;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	if (!actor || !actor->g_Alive())
+		return 3;
+	if (intent.kind == coop::proto::kActionActivateSlot)
+	{
+		if (intent.params.size() != 1)
+			return 2;
+		const u16 slot = intent.params[0];
+		if (slot == NO_ACTIVE_SLOT)
+		{
+			actor->inventory().Activate(NO_ACTIVE_SLOT); // holster
+			return 0;
+		}
+		if (slot < KNIFE_SLOT || slot > BOLT_SLOT)
+			return 2;
+		if (!actor->inventory().ItemFromSlot(slot))
+			return 4;
+		actor->inventory().Activate(slot);
+		return 0;
+	}
+	// reload: the native reload key on the active weapon (its own ammo rules)
+	if (!intent.params.empty())
+		return 2;
+	if (!smart_cast<CWeapon*>(actor->inventory().ActiveItem()))
+		return 4;
+	actor_input_press(context, kWPN_RELOAD);
+	actor_input_release(context, kWPN_RELOAD);
+	return 0;
+}
