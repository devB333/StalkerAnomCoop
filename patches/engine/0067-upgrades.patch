+// S10-T04f: see the upgrade section above.
+bool coop_client_upgrade_open(CInventoryOwner* partner)
+{
+	if (!g_link || !g_link->active)
+		return false;
+	Link::Upgrade& t = g_link->upgrade;
+	if (g_link->world != WorldLive || !g_actor)
+		return true; // nothing upgrades locally on a replica
+	CGameObject* go = smart_cast<CGameObject*>(partner);
+	coop::proto::EntityRef ref;
+	if (!go || !ref_of(u16(go->ID()), ref))
+	{
+		g_link->log.line("upgrade-open-unknown npc=%u", go ? u32(go->ID()) : 0xffffu);
+		return true;
+	}
+	if (t.open || t.pending_open)
+	{
+		g_link->log.line("upgrade-open-ignored npc=%u open=%d pending=%d", u32(go->ID()), t.open ? 1 : 0, t.pending_open ? 1 : 0);
+		return true;
+	}
+	t.pending_open = true;
+	t.npc = u16(go->ID());
+	t.npc_ref = ref;
+	request_ownership(coop::proto::kActionUpgradeOpen, ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, true, "player");
+	g_link->log.line("upgrade-open-sent npc=%u", u32(go->ID()));
+	return true;
+}
+
+bool coop_client_upgrade_active()
+{
+	return g_link && g_link->active && g_link->upgrade.open;
+}
+
+bool coop_client_upgrade_can(const CInventoryItem* item, bool& can)
+{
+	if (!coop_client_upgrade_active() || !item)
+		return false;
+	const Link::Upgrade& t = g_link->upgrade;
+	const auto it = t.table.find(u16(item->object().ID()));
+	can = it != t.table.end() && it->second.can_upgrade != 0;
+	return true;
+}
+
+bool coop_client_upgrade_state(const CInventoryItem* item, LPCSTR upgrade_id, u8& result)
+{
+	if (!coop_client_upgrade_active() || !item || !upgrade_id)
+		return false;
+	const Link::Upgrade& t = g_link->upgrade;
+	result = 1; // result_e_unknown until the table says otherwise
+	const auto it = t.table.find(u16(item->object().ID()));
+	if (it == t.table.end())
+		return true;
+	const auto up = it->second.ups.find(shared_str(upgrade_id));
+	if (up != it->second.ups.end())
+		result = up->second.first;
+	return true;
+}
+
+static bool upgrade_send(const CInventoryItem* item, u8 op, LPCSTR upgrade_id)
+{
+	Link::Upgrade& t = g_link->upgrade;
+	if (t.pending)
+	{
+		g_link->log.line("upgrade-send-ignored why=pending op=%u", u32(op));
+		return true;
+	}
+	coop::proto::EntityRef ref;
+	if (!ref_of(u16(item->object().ID()), ref))
+	{
+		g_link->log.line("upgrade-send-unknown item=%u", u32(item->object().ID()));
+		return true;
+	}
+	xr_vector<u8> params;
+	params.push_back(op);
+	const u32 len = upgrade_id ? _min<u32>(u32(xr_strlen(upgrade_id)), 128u) : 0u;
+	params.push_back(u8(len));
+	params.insert(params.end(), upgrade_id, upgrade_id + len);
+	t.pending = true;
+	++(op == 1 ? t.installs : t.repairs);
+	request_ownership(coop::proto::kActionUpgrade, ref, params, 0, 0xffffffff, 0xffffffff, true, "player");
+	g_link->log.line("upgrade-sent op=%u item=%u section=%s upgrade=%s", u32(op), u32(item->object().ID()),
+		*item->object().cNameSect(), upgrade_id ? upgrade_id : "");
+	return true;
+}
+
+bool coop_client_upgrade_install(const CInventoryItem* item, LPCSTR upgrade_id)
+{
+	if (!coop_client_upgrade_active() || !item || !upgrade_id || !upgrade_id[0])
+		return false;
+	return upgrade_send(item, 1, upgrade_id);
+}
+
+bool coop_client_upgrade_repair(const CInventoryItem* item)
+{
+	if (!coop_client_upgrade_active() || !item)
+		return false;
+	return upgrade_send(item, 2, "");
+}
+
+void coop_client_upgrade_closed()
+{
+	if (!g_link || !g_link->active)
+		return;
+	Link::Upgrade& t = g_link->upgrade;
+	if (!t.open && !t.pending_open)
+		return;
+	const bool was_open = t.open;
+	t.open = false;
+	t.pending_open = false;
+	t.pending = false;
+	t.table.clear();
+	if (was_open)
+		request_ownership(coop::proto::kActionUpgradeClose, t.npc_ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, false, "player");
+	g_link->log.line("upgrade-closed npc=%u", u32(t.npc));
+}
+
+// The installed Lua windows act through script exports; while a session is
+// open on this client those calls are the server's (see the hooks in
+// CScriptGameObject).
+bool coop_client_script_set_condition(CInventoryItem* item, float value)
+{
+	if (!coop_client_upgrade_active() || !item || !g_actor || item->object().H_Parent() != g_actor)
+		return false;
+	if (value <= item->GetCondition() + 0.001f)
+		return false; // wear, not a repair
+	g_link->log.line("upgrade-lua-repair item=%u section=%s condition=%.2f->%.2f", u32(item->object().ID()),
+		*item->object().cNameSect(), item->GetCondition(), value);
+	upgrade_send(item, 2, "");
+	return true;
+}
+
+bool coop_client_script_give_money(CInventoryOwner* owner, int money)
+{
+	if (!g_link || !g_link->active || !g_actor || (!g_link->trade.open && !g_link->upgrade.open))
+		return false;
+	CGameObject* go = smart_cast<CGameObject*>(owner);
+	const u16 id = go ? u16(go->ID()) : 0xffff;
+	const bool party = id == u16(g_actor->ID()) || (g_link->trade.open && id == g_link->trade.npc) ||
+		(g_link->upgrade.open && id == g_link->upgrade.npc);
+	if (!party)
+		return false;
+	g_link->log.line("lua-money-skipped owner=%u money=%d trade=%d upgrade=%d", u32(id), money, g_link->trade.open ? 1 : 0,
+		g_link->upgrade.open ? 1 : 0); // the purse comes from the server
+	return true;
+}
+
+bool coop_client_script_transfer_item(CInventoryItem* item, CGameObject* from, CGameObject* to)
+{
+	if (!g_link || !g_link->active || !g_actor || !item || !from || !to)
+		return false;
+	const u16 me = u16(g_actor->ID());
+	if (g_link->upgrade.open && from->ID() == me)
+	{
+		g_link->log.line("upgrade-lua-lend-skipped item=%u to=%u", u32(item->object().ID()), u32(to->ID()));
+		return true; // the mechanic feature's lending is the server's (T04f-2)
+	}
+	if (g_link->trade.open)
+	{
+		Link::Trade& t = g_link->trade;
+		if (from->ID() == t.npc && to->ID() == me)
+		{
+			t.lua_bought.push_back(u16(item->object().ID()));
+			return true;
+		}
+		if (from->ID() == me && to->ID() == t.npc)
+		{
+			t.lua_sold.push_back(u16(item->object().ID()));
+			return true;
+		}
+	}
+	return false;
+}
