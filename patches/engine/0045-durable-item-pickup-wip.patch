+// ------------------------------------------------------------ S08-T01
+// Item pickup (docs/persistence-contract.md §6 `pickup`, §12): the first
+// real ownership conflict, through the six phases. ActionIntent kind 5 names
+// the item (target) and acts on the player's own participant actor.
+// Validate on canonical state at this tick: an attached session, the own
+// actor alive, the target a current online inventory item with no owner and
+// no pickup applying, one the engine would let an actor take
+// (CInventory::CanTakeItem: an actor has no carry limit), within the
+// engine's reach. Resolve the transfer as absolute post-state (item entity
+// -> owner entity) plus the item's definition (section, native spawn state),
+// commit the record, apply it through the engine's own ownership event (the
+// server's GE_OWNERSHIP_TAKE from the bridge: xrServer::Process_event_ownership
+// sets the parent synchronously, so a second claim later in the same tick
+// sees the owner), acknowledge. The lifecycle stream reports the owner
+// change (Reparent) to both clients like any other parent change.
+
+const float kPickupReach = 2.f; // the engine's: the look-at pick (CActor::UpdateCL, RQ.range < 2) and the COD radius
+                                // (CActor::PickupModeUpdate_COD, 2 m from the actor)
+const float kPickupSlack = 0.5f; // the client saw the item up to a snapshot interval or two earlier
+const float kPickupEyeHeight = 1.8f; // the reach is measured from the actor's vertical axis, feet to eyes
+
+// The host's wall clock starts when serving starts (after the replay).
+u32 host_ms() { return g_host->started ? g_host->wall.GetElapsed_ms() : 0; }
+
+u16 engine_id_of(const coop::proto::EntityRef& ref)
+{
+	if (ref.none())
+		return kNoEngineId;
+	for (const auto& p : g_host->published)
+		if (p.second.ref == ref)
+		{
+			coop::proto::EntityRef now;
+			return entity_ref_of(p.first, now) && now == ref ? p.first : kNoEngineId;
+		}
+	return kNoEngineId;
+}
+
+// Any ALife object (recovery: identities were restored before the load).
+u16 engine_id_of_entity(u64 entity)
+{
+	for (const auto& o : ai().alife().objects().objects())
+	{
+		EngineEntityKey key;
+		EntityId e;
+		if (g_campaign_identity->current_key(o.first, key) && g_campaign_identity->resolve(key, e) == Refusal::None &&
+			e.value == entity)
+			return o.first;
+	}
+	return kNoEngineId;
+}
+
+u64 entity_of(u16 id)
+{
+	coop::proto::EntityRef ref;
+	return id != kNoEngineId && entity_ref_of(id, ref) ? ref.id : 0;
+}
+
+float pickup_distance(CActor* actor, CObject* item)
+{
+	Fvector center;
+	item->Center(center);
+	const Fvector& feet = actor->Position();
+	const Fvector axis = {feet.x, clampr(center.y, feet.y, feet.y + kPickupEyeHeight), feet.z};
+	return axis.distance_to(center);
+}
+
+void pickup_csv(LPCSTR phase, u64 revision, const PickupRecord& r, u16 id, u32 reason)
+{
+	if (g_host->pickups_csv)
+	{
+		fprintf(g_host->pickups_csv, "%I64u,%I64u,%I64u,%u,%I64u,%I64u,%u,%I64u,%s,%s,%u\n", coop::store::utc_now_ms(),
+			g_host->tick, revision, u32(r.slot), r.operation, r.item_entity, u32(id), r.owner_entity, r.section.c_str(),
+			phase, reason);
+		fflush(g_host->pickups_csv);
+	}
+}
+
+void send_ownership_event(u16 type, u16 destination, u16 item)
+{
+	NET_Packet packet;
+	packet.w_begin(M_EVENT);
+	packet.w_u32(Level().timeServer());
+	packet.w_u16(type);
+	packet.w_u16(destination);
+	packet.w_u16(item);
+	Level().Send(packet, net_flags(TRUE, TRUE)); // from the bridge: the server's own path
+}
+
+// Re-creates an item the checkpoint does not hold (or holds only offline)
+// in the owner's inventory from the record's definition, under the record's
+// EntityId: the script's alife():create-with-parent path
+// (CALifeSimulator__spawn_item2) with the recorded spawn state.
+u16 recreate_pickup_item(const PickupRecord& r, u16 owner)
+{
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	CSE_ALifeDynamicObject* owner_se = alife ? ai().alife().objects().object(owner, true) : nullptr;
+	if (!owner_se || !owner_se->m_bOnline || r.state.size() < 16 || r.state.size() > sizeof(NET_Packet().B.data))
+		return kNoEngineId;
+	NET_Packet in;
+	in.B.count = u32(r.state.size());
+	memcpy(in.B.data, r.state.data(), r.state.size());
+	u16 type = 0;
+	in.r_begin(type);
+	string256 section;
+	in.r_stringZ(section);
+	if (type != M_SPAWN || xr_strcmp(section, r.section.c_str()))
+		return kNoEngineId;
+	CSE_Abstract* entity = F_entity_Create(section);
+	CSE_ALifeDynamicObject* dynamic = entity ? smart_cast<CSE_ALifeDynamicObject*>(entity) : nullptr;
+	if (!dynamic)
+	{
+		if (entity)
+			F_entity_Destroy(entity);
+		return kNoEngineId;
+	}
+	entity->Spawn_Read(in);
+	entity->s_name = section;
+	entity->s_RP = 0xff;
+	entity->m_campaign_entity = r.item_entity;
+	entity->ID = alife->server().PerformIDgen(0xffff, entity);
+	entity->ID_Parent = owner;
+	entity->ID_Phantom = 0xffff;
+	entity->o_Position = owner_se->o_Position;
+	dynamic->m_tNodeID = owner_se->m_tNodeID;
+	dynamic->m_tGraphID = owner_se->m_tGraphID;
+	dynamic->m_tSpawnID = u16(-1);
+	NET_Packet out;
+	entity->Spawn_Write(out, FALSE);
+	const u16 id = entity->ID;
+	alife->server().FreeID(id, 0);
+	F_entity_Destroy(entity);
+	g_campaign_identity->expect_entity(id, EntityId{r.item_entity});
+	ClientID client;
+	client.set(0xffff);
+	u16 dummy;
+	out.r_begin(dummy);
+	CSE_Abstract* created = alife->server().Process_spawn(out, client);
+	return created ? created->ID : kNoEngineId;
+}
+
+enum class PickupApply
+{
+	Applied,
+	NoOp,
+	Deferred, // the owner's or the item's level object is not there yet (a respawned owner at recovery)
+	Failed,
+};
+
+LPCSTR pickup_apply_name(PickupApply a)
+{
+	switch (a)
+	{
+	case PickupApply::Applied: return "applied";
+	case PickupApply::NoOp: return "noop";
+	case PickupApply::Deferred: return "deferred";
+	default: return "failed";
+	}
+}
+
+// The adapter (absolute post-state, idempotent): the recorded item ends in
+// the recorded owner's inventory, from wherever it is now (the ground, an
+// NPC's or a corpse's inventory after a rollback); an item the server does
+// not hold online is re-created from the record under its EntityId.
+PickupApply apply_pickup(const PickupRecord& r, LPCSTR phase, u64 revision)
+{
+	const u16 owner = engine_id_of_entity(r.owner_entity);
+	CSE_Abstract* owner_se = owner != kNoEngineId ? Level().Server->ID_to_entity(owner) : nullptr;
+	if (!owner_se)
+	{
+		g_host->log.line("pickup-%s-failed revision=%I64u item_entity=%I64u owner_entity=%I64u reason=no-owner", phase,
+			revision, r.item_entity, r.owner_entity);
+		pickup_csv("apply-failed", revision, r, kNoEngineId, 1);
+		return PickupApply::Failed;
+	}
+	if (!is_object_valid_on_svclient(owner))
+		return PickupApply::Deferred;
+	u16 item = engine_id_of_entity(r.item_entity);
+	CSE_ALifeDynamicObject* item_se = item != kNoEngineId ? ai().alife().objects().object(item, true) : nullptr;
+	if (item_se && item_se->ID_Parent == owner)
+	{
+		g_host->log.line("pickup-%s-noop revision=%I64u item=%u item_entity=%I64u owner=%u reason=already-owned", phase,
+			revision, u32(item), r.item_entity, u32(owner));
+		pickup_csv("noop", revision, r, item, 0);
+		g_host->pickup_expected[r.item_entity] = r.owner_entity;
+		return PickupApply::NoOp;
+	}
+	if (item_se && !item_se->m_bOnline)
+	{
+		// held only offline (far from every participant after the rollback):
+		// the record's definition replaces the stale offline copy
+		CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+		alife->release(item_se, true);
+		item_se = nullptr;
+		item = kNoEngineId;
+		g_host->log.line("pickup-%s-released-offline revision=%I64u item_entity=%I64u", phase, revision, r.item_entity);
+	}
+	if (!item_se)
+	{
+		const u16 created = recreate_pickup_item(r, owner);
+		g_host->log.line("pickup-%s-recreated revision=%I64u item=%u item_entity=%I64u entity_now=%I64u owner=%u "
+			"section=%s ok=%d", phase, revision, u32(created), r.item_entity, entity_of(created), u32(owner),
+			r.section.c_str(), created != kNoEngineId ? 1 : 0);
+		pickup_csv(created != kNoEngineId ? "recreated" : "apply-failed", revision, r, created, 2);
+		if (created == kNoEngineId)
+			return PickupApply::Failed;
+		g_host->pickup_expected[r.item_entity] = r.owner_entity;
+		++g_host->pickups_recreated;
+		g_host->pickup_confirm.push_back({created, owner, r.item_entity, host_ms()});
+		return PickupApply::Applied;
+	}
+	if (!is_object_valid_on_svclient(item))
+		return PickupApply::Deferred;
+	const u16 from = item_se->ID_Parent;
+	if (from != 0xffff)
+		send_ownership_event(GE_OWNERSHIP_REJECT, from, item); // from an NPC, a corpse or a box after a rollback
+	send_ownership_event(GE_OWNERSHIP_TAKE, owner, item);
+	const bool ok = item_se->ID_Parent == owner;
+	g_host->log.line("pickup-%s revision=%I64u slot=%u operation=%I64u item=%u item_entity=%I64u owner=%u "
+		"owner_entity=%I64u from=%u section=%s ok=%d", phase, revision, u32(r.slot), r.operation, u32(item),
+		r.item_entity, u32(owner), r.owner_entity, u32(from), r.section.c_str(), ok ? 1 : 0);
+	pickup_csv(ok ? phase : "apply-failed", revision, r, item, ok ? 0 : 3);
+	if (!ok)
+		return PickupApply::Failed;
+	g_host->pickup_expected[r.item_entity] = r.owner_entity;
+	g_host->pickup_confirm.push_back({item, owner, r.item_entity, host_ms()});
+	return PickupApply::Applied;
+}
+
+// Records whose objects were not in the level yet; retried every tick.
+void retry_pickups()
+{
+	const u32 now = host_ms();
+	for (size_t i = 0; i < g_host->pickups_pending.size();)
+	{
+		Host::PendingPickup& p = g_host->pickups_pending[i];
+		const PickupApply a = apply_pickup(p.record, p.phase, p.revision);
+		if (a == PickupApply::Deferred && now - p.since_ms < 10000)
+		{
+			++i;
+			continue;
+		}
+		if (a == PickupApply::Deferred || a == PickupApply::Failed)
+		{
+			++g_host->pickups_apply_failed;
+			g_host->log.line("pickup-%s-gave-up revision=%I64u item_entity=%I64u result=%s waited_ms=%u", p.phase,
+				p.revision, p.record.item_entity, pickup_apply_name(a), now - p.since_ms);
+		}
+		g_host->pickups_pending.erase(g_host->pickups_pending.begin() + i);
+	}
+	// The level's actor takes the item when it processes the server's
+	// broadcast (CActor::OnEvent GE_OWNERSHIP_TAKE: CanTakeItem, Take); a
+	// refusal there would send it back (GE_OWNERSHIP_REJECT).
+	for (size_t i = 0; i < g_host->pickup_confirm.size();)
+	{
+		const Host::PickupConfirm& c = g_host->pickup_confirm[i];
+		CObject* object = Level().Objects.net_Find(c.item);
+		CSE_Abstract* se = Level().Server->ID_to_entity(c.item);
+		const bool held = object && object->H_Parent() && object->H_Parent()->ID() == c.owner;
+		const bool reverted = !se || se->ID_Parent != c.owner;
+		if (!held && !reverted && now - c.since_ms < 5000)
+		{
+			++i;
+			continue;
+		}
+		if (held)
+			++g_host->pickups_confirmed;
+		else
+			++g_host->pickups_unconfirmed;
+		g_host->log.line("pickup-%s item=%u item_entity=%I64u owner=%u ms=%u", held ? "confirmed" :
+			(reverted ? "reverted" : "unconfirmed"), u32(c.item), c.item_entity, u32(c.owner), now - c.since_ms);
+		g_host->pickup_confirm.erase(g_host->pickup_confirm.begin() + i);
+	}
+}
+
+// False: the adapter failed (at recovery: the start stops).
+bool apply_or_defer(const PickupRecord& r, LPCSTR phase, u64 revision)
+{
+	const PickupApply a = apply_pickup(r, phase, revision);
+	if (a == PickupApply::Deferred)
+	{
+		g_host->log.line("pickup-%s-deferred revision=%I64u item_entity=%I64u", phase, revision, r.item_entity);
+		g_host->pickups_pending.push_back({r, revision, host_ms(), phase});
+	}
+	if (a == PickupApply::Failed)
+		++g_host->pickups_apply_failed;
+	return a != PickupApply::Failed;
+}
+
+u16 take_pickup(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	CoopPersistence* persistence = g_host->persistence;
+	// 1. Receive: a known operation returns its stored outcome.
+	StoredOutcome stored;
+	if (persistence && persistence->lookup(link.player, intent.operation_id, stored))
+	{
+		result.outcome = coop::proto::ActionOutcome(stored.outcome);
+		result.reason = stored.reason;
+		result.commit_id = stored.revision;
+		result.revision = stored.revision;
+		++g_host->pickups_duplicate;
+		g_host->log.line("pickup-duplicate player=%s operation=%I64u outcome=%u revision=%I64u",
+			coop_uuid_hex(link.player).c_str(), intent.operation_id, u32(stored.outcome), stored.revision);
+		return stored.reason;
+	}
+	// 2. Prepare / validate.
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (!intent.params.empty())
+		return coop::proto::kReasonMalformed;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	coop::proto::EntityRef owner_ref;
+	if (!actor || !actor->g_Alive() || !entity_ref_of(actor->ID(), owner_ref))
+		return coop::proto::kReasonNoActor;
+	const u16 id = engine_id_of(intent.target);
+	CSE_Abstract* se = id != kNoEngineId ? Level().Server->ID_to_entity(id) : nullptr;
+	CObject* object = id != kNoEngineId ? Level().Objects.net_Find(id) : nullptr;
+	if (!se || !object || object->getDestroy())
+		return coop::proto::kReasonItemGone;
+	CInventoryItem* item = smart_cast<CInventoryItem*>(object);
+	if (!smart_cast<CSE_ALifeInventoryItem*>(se) || !item)
+		return coop::proto::kReasonNotTakeable;
+	if (se->ID_Parent != 0xffff || object->H_Parent())
+		return coop::proto::kReasonItemTaken;
+	for (const Host::PickupConfirm& c : g_host->pickup_confirm)
+		if (c.item == id)
+			return coop::proto::kReasonItemTaken; // taken this tick or just before, the level not yet caught up
+	const CMissile* missile = smart_cast<const CMissile*>(object);
+	if (!item->CanTake() || smart_cast<CExplosiveRocket*>(object) || (missile && !missile->Useful()) ||
+		!actor->inventory().CanTakeItem(item))
+		return coop::proto::kReasonNotTakeable;
+	const float distance = pickup_distance(actor, object);
+	if (distance > kPickupReach + kPickupSlack)
+	{
+		g_host->log.line("pickup-out-of-reach slot=%u item=%u distance=%.2f", u32(link.ref.slot), u32(id), distance);
+		return coop::proto::kReasonOutOfReach;
+	}
+	if (!persistence || persistence->failed())
+	{
+		++g_host->ledger_store_failed;
+		return kActionReasonStoreFailed;
+	}
+	// 3. Resolve: the absolute post-state and the item's definition.
+	PickupRecord record;
+	record.slot = link.ref.slot;
+	record.player = link.player;
+	record.operation = intent.operation_id;
+	record.owner_entity = owner_ref.id;
+	record.item_entity = intent.target.id;
+	record.item_id = id;
+	record.section = *se->s_name;
+	record.position[0] = object->Position().x;
+	record.position[1] = object->Position().y;
+	record.position[2] = object->Position().z;
+	{
+		NET_Packet packet;
+		se->Spawn_Write(packet, FALSE); // writes its own M_SPAWN header and section
+		record.state.assign(packet.B.data, packet.B.data + packet.B.count);
+	}
+	const u64 revision = ++g_host->commit;
+	// 4. Durable commit, before anything is applied or acknowledged.
+	if (!coop::store::failpoint("pickup:before-append"))
+		persistence->fail_closed("failpoint pickup:before-append");
+	if (!persistence->commit(coop::store::kRecordPickup, g_host->tick, revision, encode_pickup(record)))
+	{
+		++g_host->ledger_store_failed;
+		g_host->log.line("pickup-store-failed revision=%I64u operation=%I64u reason=%s", revision, intent.operation_id,
+			persistence->failure());
+		g_host->stop_requested = true;
+		return kActionReasonStoreFailed;
+	}
+	coop::store::failpoint("pickup:after-flush");
+	++g_host->pickups_committed;
+	g_host->log.line("pickup-committed revision=%I64u slot=%u operation=%I64u item=%u item_entity=%I64u "
+		"owner_entity=%I64u section=%s distance=%.2f state_bytes=%u", revision, u32(record.slot), record.operation,
+		u32(id), record.item_entity, record.owner_entity, record.section.c_str(), distance, u32(record.state.size()));
+	pickup_csv("commit", revision, record, id, 0);
+	// 5. Apply.
+	apply_or_defer(record, "apply", revision);
+	coop::store::failpoint("pickup:after-apply");
+	stored.outcome = u8(coop::proto::ActionOutcome::Accepted);
+	stored.reason = 0;
+	stored.revision = revision;
+	persistence->remember(link.player, intent.operation_id, stored);
+	result.outcome = coop::proto::ActionOutcome::Accepted;
+	result.commit_id = revision;
+	result.revision = revision;
+	return 0;
+}
+
+// Where every item a pickup named is now (the comparison's server view).
+void log_pickup_state(LPCSTR tag)
+{
+	u32 held = 0, wrong = 0, missing = 0;
+	for (const auto& e : g_host->pickup_expected)
+	{
+		const u16 item = engine_id_of_entity(e.first);
+		const CSE_Abstract* se = item != kNoEngineId ? Level().Server->ID_to_entity(item) : nullptr;
+		const u16 parent = se ? se->ID_Parent : 0xffff;
+		const u64 parent_entity = parent != 0xffff ? entity_of(parent) : 0;
+		const bool ok = parent_entity == e.second;
+		if (!se)
+			++missing;
+		else if (ok)
+			++held;
+		else
+			++wrong;
+		g_host->log.line("pickup-state tag=%s item=%u item_entity=%I64u parent=%u parent_entity=%I64u "
+			"expected_owner=%I64u ok=%d", tag, u32(item), e.first, u32(parent), parent_entity, e.second, ok ? 1 : 0);
+	}
+	g_host->log.line("pickup-state-summary tag=%s items=%u held=%u wrong=%u missing=%u committed=%I64u "
+		"duplicates=%I64u refused=%I64u replayed=%I64u recreated=%I64u confirmed=%I64u unconfirmed=%I64u "
+		"apply_failed=%I64u reparents=%I64u", tag, u32(g_host->pickup_expected.size()), held, wrong, missing,
+		g_host->pickups_committed, g_host->pickups_duplicate, g_host->pickups_refused, g_host->pickups_replayed,
+		g_host->pickups_recreated, g_host->pickups_confirmed, g_host->pickups_unconfirmed, g_host->pickups_apply_failed,
+		g_host->reparents);
+}
+
+// The race fixture (profile pickup_race / pickup_rounds): once both players
+// are in the world, every 8 s an item appears on the ground between the two
+// actors and both clients are told (CampaignEvent kind 6) the server tick at
+// which to claim it, so both claims arrive within a tick or two. After the
+// race rounds, three refusal rounds: an item 8 m away (out of reach), the
+// other player's actor as the target (not an item), and a target that names
+// nothing (gone).
+const char* kRaceSections[] = {"medkit", "bandage", "conserva", "wpn_pm", "ammo_9x18_fmj", "vodka", "bread", "wpn_knife"};
+
+void pickup_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.pickup_race || !ai().get_alife())
+		return;
+	Host::PickupFixture& f = g_host->pickup_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+				actors[attached++] = actor;
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-pickup both-attached tick=%I64u", g_host->tick);
+	}
+	const u32 total = config.pickup_rounds + 3;
+	if (f.round >= total || attached < 2 || !actors[0]->g_Alive() || !actors[1]->g_Alive())
+		return;
+	const u64 due = f.both_since + u64(config.pickup_race) * 50 + u64(f.round) * 8 * 50;
+	if (g_host->tick < due)
+		return;
+	const u32 round = f.round++;
+	const u8 kind = round < config.pickup_rounds ? 0 : u8(round - config.pickup_rounds + 1); // 0 race, 1 far, 2 actor, 3 gone
+	coop::proto::EntityRef target;
+	u16 spawned = kNoEngineId;
+	Fvector at;
+	at.add(actors[0]->Position(), actors[1]->Position()).mul(0.5f);
+	if (kind <= 1)
+	{
+		if (kind == 1)
+		{
+			Fvector side;
+			side.sub(actors[1]->Position(), actors[0]->Position());
+			side.y = 0.f;
+			if (side.square_magnitude() < 0.01f)
+				side.set(1.f, 0.f, 0.f);
+			side.normalize();
+			at.mad(Fvector().set(-side.z, 0.f, side.x), 8.f);
+		}
+		const CLevelGraph& graph = ai().level_graph();
+		u32 vertex = graph.valid_vertex_position(at) ? graph.vertex_id(at) : u32(-1);
+		if (!graph.valid_vertex_id(vertex))
+			vertex = actors[0]->ai_location().level_vertex_id();
+		at.y = graph.vertex_position(vertex).y + 0.3f;
+		LPCSTR section = kRaceSections[round % (sizeof(kRaceSections) / sizeof(kRaceSections[0]))];
+		CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+		const CSE_ALifeDynamicObject* anchor = ai().alife().objects().object(u16(actors[0]->ID()), true);
+		CSE_Abstract* item = anchor ? alife->spawn_item(section, at, vertex, anchor->m_tGraphID, u16(-1)) : nullptr;
+		if (!item || !entity_ref_of(item->ID, target))
+		{
+			g_host->log.line("fixture-pickup-round round=%u kind=%u spawn-failed section=%s", round, u32(kind), section);
+			return;
+		}
+		spawned = item->ID;
+	}
+	else if (kind == 2)
+		entity_ref_of(u16(actors[1]->ID()), target);
+	else
+	{
+		target.id = 0x7fffffffffffull;
+		target.generation = 1;
+	}
+	const u64 claim_tick = g_host->tick + 100; // 2 s: the item's Spawn reaches both clients first
+	std::vector<u8> payload;
+	put_u8(payload, u8(round));
+	put_u8(payload, kind);
+	for (int b = 0; b < 8; ++b)
+		payload.push_back(u8(target.id >> (8 * b)));
+	for (int b = 0; b < 4; ++b)
+		payload.push_back(u8(target.generation >> (8 * b)));
+	for (int b = 0; b < 8; ++b)
+		payload.push_back(u8(claim_tick >> (8 * b)));
+	broadcast_event(6, payload);
+	g_host->log.line("fixture-pickup-round round=%u kind=%u id=%u target=%I64u/%u claim_tick=%I64u pos=%.2f,%.2f,%.2f "
+		"d1=%.2f d2=%.2f", round, u32(kind), u32(spawned), target.id, target.generation, claim_tick, VPUSH(at),
+		at.distance_to(actors[0]->Position()), at.distance_to(actors[1]->Position()));
+}
