diff --git a/src/xrGame/CampaignPhysicsCapture.cpp b/src/xrGame/CampaignPhysicsCapture.cpp
new file mode 100644
index 0000000..ff93a16
--- /dev/null
+++ b/src/xrGame/CampaignPhysicsCapture.cpp
@@ -0,0 +1,538 @@
+#include "pch_script.h"
+#include "CampaignPhysicsCapture.h"
+
+// S02-T04b: native physics stepping observed on one falling body (H06). The
+// fixture lifts an existing physics shell and lets the level's physics world
+// (CPHWorld::FrameStep -> Step, driven by the frame loop) drop it: gravity,
+// contact with the level CFORM and the world's own settling (CPHObject
+// deactivation) are read back every step through the world's step-time
+// callback. Nothing else changes: the shell, its materials and the floor are
+// the ones the native spawn and level load created.
+
+#include "Level.h"
+#include "Actor.h"
+#include "PhysicsShellHolder.h"
+#include "../xrphysics/PhysicsShell.h"
+#include "../xrphysics/IPHWorld.h"
+#include "../xrphysics/PhysicsCommon.h"
+#include "../xrEngine/GameMtlLib.h"
+#include "../xrEngine/device.h"
+#include "../xrEngine/xr_ioconsole.h"
+#include "../xrEngine/Bone.h"
+#include "../Include/xrRender/Kinematics.h"
+#include "../Include/xrRender/RenderVisual.h"
+
+namespace
+{
+const u16 default_object_id = 10865; // physic_destroyable_object, dynamics\box\box_wood_01 on k00_marsh
+const float drop_height = 1.f;
+const u32 max_steps = 600; // 6 s at the native 10 ms step
+const u32 settled_steps = 50; // the body must stay deactivated this long
+const float settle_speed = 0.05f;
+const float rest_tolerance = 0.15f;
+const float fall_velocity_tolerance = 0.01f; // relative, over the free-fall steps
+const float fall_position_tolerance = 0.005f; // metres, over the free-fall steps
+// CPHElement::PhDataUpdate divides every body's velocity by m_l_scale after
+// each step (xrPhysics/PHElement.cpp:458-470); the default is
+// default_l_scale = 1.01 (xrPhysics/Physics.cpp:31), not exported, so the
+// native value is repeated here and the measured one is reported beside it.
+const float native_velocity_scale = 1.01f;
+
+struct Sample
+{
+	u32 step;
+	u64 world_step;
+	Fvector position;
+	Fvector linear;
+	Fvector angular;
+	bool enabled;
+	u32 contacts;
+};
+
+struct Fixture
+{
+	FILE* out;
+	bool running;
+	u16 id;
+	CObject* object;
+	CPhysicsShell* shell;
+	u64 world_steps_begin;
+	float rest_y;
+	float lifted_y;
+	float floor_range;
+	int floor_tri;
+	shared_str floor_material;
+	u32 steps;
+	u32 contacts_this_step;
+	u32 contacts_total;
+	int first_contact_step;
+	int settle_step;
+	float fall_y; // y at the first contact
+	float max_velocity_error;
+	float max_position_error;
+	bool destroyed;
+	bool finite;
+	shared_str contact_self;
+	shared_str contact_other;
+	xr_vector<Sample> fall; // free-fall samples, for the end-row evaluation
+};
+
+Fixture g_fixture;
+
+void check(float value)
+{
+	if (!_valid(value))
+		g_fixture.finite = false;
+}
+
+void check(const Fvector& v)
+{
+	check(v.x);
+	check(v.y);
+	check(v.z);
+}
+
+LPCSTR material_name(u16 index)
+{
+	SGameMtl* material = GMLib.GetMaterialByIdx(index);
+	return material ? *material->m_Name : "";
+}
+
+// Static floor under a point, as a bullet trace would find it: the level
+// CFORM only, so the body itself never shadows the query.
+bool floor_under(const Fvector& point, collide::rq_result& R)
+{
+	Fvector start = point;
+	start.y += 0.1f;
+	const Fvector down = {0.f, -1.f, 0.f};
+	return !!Level().ObjectSpace.RayPick(start, down, 10.f, collide::rqtStatic, R, (CObject*)nullptr);
+}
+
+u16 requested_object_id()
+{
+	LPCSTR option = strstr(Core.Params, "-s02-physics-object ");
+	u32 id = default_object_id;
+	if (option && (sscanf_s(option + xr_strlen("-s02-physics-object "), "%u", &id) != 1 || id > 0xffff))
+		id = default_object_id;
+	return u16(id);
+}
+
+// The fixture object must still be the same live object: a destroyed
+// physic object (collision damage, scripts) is reported, not followed.
+bool object_alive()
+{
+	CObject* found = Level().Objects.net_Find(g_fixture.id);
+	return found && found == g_fixture.object && !found->getDestroy();
+}
+
+void FixtureContact(bool& /*do_colide*/, bool bo1, dContact& /*c*/, SGameMtl* material_1, SGameMtl* material_2)
+{
+	Fixture& f = g_fixture;
+	if (!f.running)
+		return;
+	++f.contacts_this_step;
+	++f.contacts_total;
+	if (f.contact_self.size())
+		return;
+	SGameMtl* self = bo1 ? material_1 : material_2;
+	SGameMtl* other = bo1 ? material_2 : material_1;
+	f.contact_self = self ? self->m_Name : "";
+	f.contact_other = other ? other->m_Name : "";
+}
+
+void write_sample(const Sample& s)
+{
+	fprintf(g_fixture.out, "step,%u,%I64u,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%d,%u\n", s.step, s.world_step,
+		VPUSH(s.position), VPUSH(s.linear), VPUSH(s.angular), s.enabled ? 1 : 0, s.contacts);
+}
+
+void sample_body()
+{
+	Fixture& f = g_fixture;
+	if (!object_alive())
+	{
+		f.destroyed = true;
+		f.running = false;
+		return;
+	}
+	Sample s;
+	s.step = f.steps;
+	s.world_step = physics_world()->StepsNum();
+	Fmatrix m;
+	f.shell->GetGlobalTransformDynamic(&m);
+	s.position = m.c;
+	f.shell->get_LinearVel(s.linear);
+	f.shell->get_AngularVel(s.angular);
+	s.enabled = f.shell->isEnabled();
+	s.contacts = f.contacts_this_step;
+	f.contacts_this_step = 0;
+	check(s.position);
+	check(s.linear);
+	check(s.angular);
+	write_sample(s);
+
+	if (f.first_contact_step < 0)
+	{
+		if (s.contacts)
+		{
+			f.first_contact_step = int(s.step);
+			f.fall_y = s.position.y;
+			fprintf(f.out, "contact,%u,%s,%s\n", s.step, *f.contact_self, *f.contact_other);
+		}
+		else
+			f.fall.push_back(s);
+	}
+	else if (f.settle_step < 0 && !s.enabled)
+		f.settle_step = int(s.step);
+	else if (f.settle_step >= 0 && s.enabled)
+		f.settle_step = -1; // woke up again: not settled yet
+}
+
+// Runs inside CPHWorld::Step after the objects' data update, once per native
+// step; the level's own callback keeps running first.
+void FixtureStep(u32 step_start, u32 step_end)
+{
+	CLevel::PhisStepsCallback(step_start, step_end);
+	Fixture& f = g_fixture;
+	if (!f.running)
+		return;
+	++f.steps;
+	sample_body();
+	if (f.settle_step >= 0 && f.steps >= u32(f.settle_step) + settled_steps)
+		f.running = false;
+	else if (f.steps >= max_steps)
+		f.running = false;
+}
+
+float nearest_collidable(CObject* object, u16& nearest_id, LPCSTR& nearest_section)
+{
+	float best = flt_max;
+	nearest_id = 0xffff;
+	nearest_section = "";
+	CLevel& level = Level();
+	for (u32 i = 0; i < level.Objects.o_count(); ++i)
+	{
+		CObject* other = level.Objects.o_get_by_iterator(i);
+		if (other == object || other->getDestroy())
+			continue;
+		CPhysicsShellHolder* holder = smart_cast<CPhysicsShellHolder*>(other);
+		if (!other->collidable.model && !(holder && holder->PPhysicsShell()))
+			continue;
+		const float distance = other->Position().distance_to(object->Position());
+		if (distance < best)
+		{
+			best = distance;
+			nearest_id = other->ID();
+			nearest_section = *other->cNameSect();
+		}
+	}
+	return best;
+}
+
+void log_summary(LPCSTR prefix, const PhysicsFixtureSummary& s, bool ok, LPCSTR out)
+{
+	Msg("%s object=%u steps=%u frames=%u sim_ms=%u wall_ms=%u fixed_step=%.4f gravity=%.3f drop=%.2f fall=%.3f "
+		"first_contact=%d settle=%d rest_error=%.4f final_speed=%.4f fall_v_err=%.4f fall_y_err=%.4f "
+		"velocity_scale=%.4f fell=%d on_floor=%d settled=%d destroyed=%d finite=%d ok=%d out=%s",
+		prefix, u32(s.object_id), s.steps, s.frames, s.sim_ms, s.wall_ms, s.fixed_step, s.gravity, s.drop_height,
+		s.fall_distance, s.first_contact_step, s.settle_step, s.rest_error, s.final_speed, s.max_fall_velocity_error,
+		s.max_fall_position_error, s.velocity_scale, s.fell ? 1 : 0, s.landed_on_floor ? 1 : 0, s.settled ? 1 : 0, s.destroyed ? 1 : 0,
+		s.finite ? 1 : 0, ok ? 1 : 0, out);
+	if (s.missing[0])
+		Msg("! %s missing: %s", prefix, s.missing);
+}
+} // namespace
+
+bool PhysicsFixtureBegin(LPCSTR out_path, PhysicsFixtureSummary& summary)
+{
+	ZeroMemory(&summary, sizeof(summary));
+	summary.first_contact_step = -1;
+	summary.settle_step = -1;
+	summary.finite = true;
+	Fixture& f = g_fixture;
+	f = Fixture();
+	f.first_contact_step = -1;
+	f.settle_step = -1;
+	f.finite = true;
+	f.id = requested_object_id();
+	summary.object_id = f.id;
+
+	if (!g_pGameLevel || !g_pGameLevel->bReady || !physics_world())
+	{
+		xr_strcpy(summary.missing, "no loaded level or physics world");
+		return false;
+	}
+	CObject* object = Level().Objects.net_Find(f.id);
+	if (!object || object->getDestroy())
+	{
+		xr_sprintf(summary.missing, "fixture object %u is not on the level", u32(f.id));
+		return false;
+	}
+	CPhysicsShellHolder* holder = smart_cast<CPhysicsShellHolder*>(object);
+	CPhysicsShell* shell = holder ? holder->PPhysicsShell() : nullptr;
+	if (!shell || !shell->isActive() || !shell->get_ElementsNumber())
+	{
+		xr_sprintf(summary.missing, "fixture object %u (%s) has no active physics shell", u32(f.id), *object->cNameSect());
+		return false;
+	}
+	const float mass = shell->getMass();
+	if (!(mass > 0.f))
+	{
+		xr_sprintf(summary.missing, "fixture object %u (%s) has no mass", u32(f.id), *object->cNameSect());
+		return false;
+	}
+	collide::rq_result floor;
+	if (!floor_under(object->Position(), floor))
+	{
+		xr_sprintf(summary.missing, "no static floor within 10 m under fixture object %u", u32(f.id));
+		return false;
+	}
+	FILE* out = fopen(out_path, "w");
+	if (!out)
+	{
+		xr_sprintf(summary.missing, "cannot write %s", out_path);
+		return false;
+	}
+
+	f.out = out;
+	f.object = object;
+	f.shell = shell;
+	f.world_steps_begin = physics_world()->StepsNum();
+	f.rest_y = object->Position().y;
+	f.floor_range = floor.range;
+	f.floor_tri = floor.element;
+	f.floor_material = material_name(Level().ObjectSpace.GetStaticTris()[floor.element].material);
+	summary.fixed_step = fixed_step;
+	summary.gravity = physics_world()->Gravity();
+	summary.drop_height = drop_height;
+
+	u32 geoms = 0;
+	for (u16 i = 0; i < shell->get_ElementsNumber(); ++i)
+		geoms += shell->get_ElementByStoreOrder(i)->numberOfGeoms();
+	const u16 root_bone = shell->get_ElementByStoreOrder(0)->m_SelfID;
+	IKinematics* k = object->Visual() ? object->Visual()->dcast_PKinematics() : nullptr;
+	LPCSTR bone_name = k && root_bone < k->LL_BoneCount() ? k->LL_BoneName_dbg(root_bone) : "";
+	const u16 bone_material = k && root_bone < k->LL_BoneCount() ? k->LL_GetData(root_bone).game_mtl_idx : u16(-1);
+	Fvector box_size, box_centre;
+	shell->get_Box(box_size, box_centre);
+	u16 nearest_id;
+	LPCSTR nearest_section;
+	const float nearest = nearest_collidable(object, nearest_id, nearest_section);
+	check(mass);
+	check(box_size);
+	fprintf(out, "meta,%u,%u,%s,%.6f,%.6f,%I64u,%u,%s,%s,%.6f,%u,%u,%.6f,%.6f,%.6f,%u,%s,%s,%.6f,%u,%s,%.6f\n",
+		Device.dwFrame, Device.dwTimeGlobal, *Level().name(), fixed_step, summary.gravity, f.world_steps_begin,
+		u32(f.id), *object->cNameSect(), *object->cNameVisual(), mass, u32(shell->get_ElementsNumber()), geoms,
+		VPUSH(box_size), u32(root_bone), bone_name, material_name(bone_material), drop_height, u32(nearest_id),
+		nearest_section, nearest);
+
+	// Lift: the same orientation, one metre up, at rest, awake. SetTransform
+	// moves the ODE body and clears the motion history (mh_clear);
+	// Enable re-activates a body the world had put to sleep.
+	const Fvector rest = object->Position();
+	const bool was_enabled = shell->isEnabled();
+	Fmatrix lifted = object->XFORM();
+	lifted.c.y += drop_height;
+	const Fvector zero = {0.f, 0.f, 0.f};
+	shell->SetTransform(lifted, mh_clear);
+	shell->set_LinearVel(zero);
+	shell->set_AngularVel(zero);
+	shell->Enable();
+	object->XFORM().set(lifted);
+	object->spatial_move();
+	f.lifted_y = lifted.c.y;
+	check(rest);
+	check(f.floor_range);
+	fprintf(out, "start,%.6f,%.6f,%.6f,%d,1,%d,%s,%.6f,%.6f,%.6f,%.6f\n", VPUSH(rest), was_enabled ? 1 : 0, f.floor_tri,
+		*f.floor_material, f.floor_range, VPUSH(lifted.c));
+
+	shell->add_ObjectContactCallback(&FixtureContact);
+	physics_world()->set_step_time_callback(&FixtureStep);
+	f.running = true;
+	sample_body(); // step 0: the lifted state before any physics step
+	return true;
+}
+
+bool PhysicsFixtureDone()
+{
+	return !g_fixture.running;
+}
+
+bool PhysicsFixtureEnd(u32 frames, u32 sim_ms, u32 wall_ms, PhysicsFixtureSummary& summary)
+{
+	Fixture& f = g_fixture;
+	if (!f.out)
+	{
+		xr_strcpy(summary.missing, "fixture was not started");
+		return false;
+	}
+	f.running = false;
+	physics_world()->set_step_time_callback((PhysicsStepTimeCallback*)&CLevel::PhisStepsCallback);
+	const bool alive = object_alive();
+	if (alive)
+		f.shell->remove_ObjectContactCallback(&FixtureContact);
+	else
+		f.destroyed = true;
+
+	summary.steps = f.steps;
+	summary.frames = frames;
+	summary.sim_ms = sim_ms;
+	summary.wall_ms = wall_ms;
+	summary.first_contact_step = f.first_contact_step;
+	summary.settle_step = f.settle_step;
+	summary.destroyed = f.destroyed;
+
+	// Free fall against the world's own integration: each step ODE adds g*h
+	// to the velocity and moves the body by that velocity times h, then
+	// CPHElement::PhDataUpdate divides the velocity by m_l_scale (1.01). The
+	// air resistance of PhDataUpdate (k_l = 0.0002) is negligible here.
+	const float h = summary.fixed_step;
+	const float g = summary.gravity;
+	float v_expected = 0.f;
+	float y_expected = f.lifted_y;
+	u32 next_step = 1;
+	for (const Sample& s : f.fall)
+	{
+		if (!s.step)
+			continue;
+		for (; next_step <= s.step; ++next_step)
+		{
+			v_expected -= g * h;
+			y_expected += v_expected * h;
+			v_expected /= native_velocity_scale;
+		}
+		if (s.step == 1 && !fis_zero(s.linear.y))
+			summary.velocity_scale = -g * h / s.linear.y;
+		const float v_error = _abs(s.linear.y - v_expected) / _abs(v_expected);
+		const float y_error = _abs(s.position.y - y_expected);
+		summary.max_fall_velocity_error = _max(summary.max_fall_velocity_error, v_error);
+		summary.max_fall_position_error = _max(summary.max_fall_position_error, y_error);
+	}
+	summary.fall_distance = f.first_contact_step >= 0 ? f.lifted_y - f.fall_y : 0.f;
+	summary.fell = f.first_contact_step > 0 && summary.fall_distance >= 0.5f * drop_height;
+	summary.landed_on_floor = f.first_contact_step >= 0 && f.contact_other.size() && f.contact_other == f.floor_material;
+
+	Fvector position = {0.f, 0.f, 0.f};
+	Fvector linear = {0.f, 0.f, 0.f};
+	bool enabled = false;
+	bool floor_hit = false;
+	int floor_tri = -1;
+	float floor_range = 0.f;
+	if (alive)
+	{
+		Fmatrix m;
+		f.shell->GetGlobalTransformDynamic(&m);
+		position = m.c;
+		f.shell->get_LinearVel(linear);
+		enabled = f.shell->isEnabled();
+		collide::rq_result floor;
+		floor_hit = floor_under(position, floor);
+		floor_tri = floor_hit ? floor.element : -1;
+		floor_range = floor_hit ? floor.range : 0.f;
+		check(position);
+		check(linear);
+		check(floor_range);
+	}
+	summary.rest_error = _abs(position.y - f.rest_y);
+	summary.final_speed = linear.magnitude();
+	summary.settled = alive && f.settle_step >= 0 && !enabled && summary.final_speed < settle_speed;
+	summary.finite = f.finite;
+
+	if (f.destroyed)
+		xr_sprintf(summary.missing, "fixture object %u was destroyed during the fall", u32(f.id));
+	else if (!summary.fell)
+		xr_sprintf(summary.missing, "fixture object %u did not fall: first_contact=%d fall=%.3f", u32(f.id),
+			f.first_contact_step, summary.fall_distance);
+	else if (!summary.landed_on_floor)
+		xr_sprintf(summary.missing, "first contact material '%s' is not the floor's '%s'", *f.contact_other,
+			*f.floor_material);
+	else if (!summary.settled)
+		xr_sprintf(summary.missing, "fixture object %u did not settle: settle=%d enabled=%d speed=%.4f", u32(f.id),
+			f.settle_step, enabled ? 1 : 0, summary.final_speed);
+	else if (summary.rest_error > rest_tolerance)
+		xr_sprintf(summary.missing, "fixture object %u rests %.3f m from its saved height", u32(f.id),
+			summary.rest_error);
+	else if (summary.max_fall_velocity_error > fall_velocity_tolerance ||
+		summary.max_fall_position_error > fall_position_tolerance)
+		xr_sprintf(summary.missing, "free fall differs from the native integration: velocity %.4f (relative), "
+			"position %.4f m, measured velocity scale %.4f",
+			summary.max_fall_velocity_error, summary.max_fall_position_error, summary.velocity_scale);
+	else if (!summary.finite)
+		xr_strcpy(summary.missing, "a sampled value is not finite");
+	const bool ok = !summary.missing[0];
+	fprintf(f.out, "end,%u,%u,%u,%u,%d,%d,%.6f,%.6f,%.6f,%d,%d,%d,%.6f,%d,%d\n", f.steps, frames, sim_ms, wall_ms,
+		f.first_contact_step, f.settle_step, VPUSH(position), enabled ? 1 : 0, floor_hit ? 1 : 0, floor_tri, floor_range,
+		f.destroyed ? 1 : 0, ok ? 1 : 0);
+	fclose(f.out);
+	f.out = nullptr;
+	return ok;
+}
+
+static PhysicsFixtureSummary g_server_summary;
+static string_path g_server_out;
+
+extern "C" bool __cdecl xrCampaignLevel_PhysicsFixtureBegin(LPCSTR out_path)
+{
+	xr_strcpy(g_server_out, out_path);
+	const bool ok = PhysicsFixtureBegin(out_path, g_server_summary);
+	if (!ok)
+		log_summary("S02-T04b physics", g_server_summary, false, out_path);
+	return ok;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_PhysicsFixtureDone()
+{
+	return PhysicsFixtureDone();
+}
+
+extern "C" bool __cdecl xrCampaignLevel_PhysicsFixtureEnd(u32 frames, u32 sim_ms, u32 wall_ms)
+{
+	const bool ok = PhysicsFixtureEnd(frames, sim_ms, wall_ms, g_server_summary);
+	log_summary("S02-T04b physics", g_server_summary, ok, g_server_out);
+	return ok;
+}
+
+void ClientPhysicsCaptureOnFrame()
+{
+	static const bool requested = strstr(Core.Params, "-s02-physics-capture") != nullptr;
+	static u32 since = 0;
+	static u32 begin_time = 0;
+	static u32 begin_frame = 0;
+	static bool started = false;
+	static bool done = false;
+	static PhysicsFixtureSummary summary;
+	static string_path out;
+	if (!requested || done || !g_pGameLevel || !g_pGameLevel->bReady || !g_actor || Device.dwPrecacheFrame)
+		return;
+	if (!since)
+	{
+		since = Device.dwTimeGlobal;
+		return;
+	}
+	if (!started)
+	{
+		// One second of device time after the actor spawned, like the
+		// collision capture; the server runs the fixture after its 50 ticks.
+		if (Device.dwTimeGlobal - since < 1000)
+			return;
+		started = true;
+		FS.update_path(out, "$logs$", "s02-t04b-physics.csv");
+		begin_time = Device.dwTimeGlobal;
+		begin_frame = Device.dwFrame;
+		if (PhysicsFixtureBegin(out, summary))
+			return;
+		done = true;
+		log_summary("S02-T04b client physics", summary, false, out);
+	}
+	else if (PhysicsFixtureDone())
+	{
+		done = true;
+		const u32 elapsed = Device.dwTimeGlobal - begin_time;
+		const bool ok = PhysicsFixtureEnd(Device.dwFrame - begin_frame, elapsed, elapsed, summary);
+		log_summary("S02-T04b client physics", summary, ok, out);
+	}
+	else
+		return;
+	FlushLog();
+	Console->Execute("quit");
+}
diff --git a/src/xrGame/CampaignPhysicsCapture.h b/src/xrGame/CampaignPhysicsCapture.h
new file mode 100644
index 0000000..86341fd
--- /dev/null
+++ b/src/xrGame/CampaignPhysicsCapture.h
@@ -0,0 +1,64 @@
+#pragma once
+
+// S02-T04b: a falling-body fixture on the loaded level (H06). One existing
+// movable physics shell is lifted straight up and released; the native
+// physics world then drops it under gravity, collides it with the level floor
+// and settles it, while every physics step is sampled. The campaign server (no
+// device) and the normal client run the same fixture on the same saved game
+// and write the same CSV rows:
+//   meta,<frame>,<time_ms>,<level>,<fixed_step>,<gravity>,<world_steps>,<id>,<section>,<visual>,
+//        <mass>,<elements>,<geoms>,<box_x>,<box_y>,<box_z>,<bone>,<bone_name>,<bone_material>,
+//        <drop_height>,<nearest_id>,<nearest_section>,<nearest_distance>
+//   start,<px>,<py>,<pz>,<enabled>,<floor_hit>,<floor_tri>,<floor_material>,<floor_range>,<lx>,<ly>,<lz>
+//        (px..pz: rest position from the save; lx..lz: the lifted position)
+//   step,<n>,<world_step>,<px>,<py>,<pz>,<vx>,<vy>,<vz>,<wx>,<wy>,<wz>,<enabled>,<contacts>
+//        (sampled from the body in the physics step callback; n=0 is the lifted
+//         state before any step)
+//   contact,<n>,<self_material>,<other_material>   (the first contact)
+//   end,<steps>,<frames>,<sim_ms>,<wall_ms>,<first_contact>,<settle>,<px>,<py>,<pz>,<enabled>,
+//       <floor_hit>,<floor_tri>,<floor_range>,<destroyed>,<ok>
+struct PhysicsFixtureSummary
+{
+	u16 object_id;
+	u32 steps; // physics steps sampled after the lift
+	u32 frames; // device frames (server ticks) the fixture ran
+	u32 sim_ms;
+	u32 wall_ms;
+	float fixed_step;
+	float gravity;
+	float drop_height;
+	float fall_distance; // lifted y minus y at the first contact
+	float velocity_scale; // g*h / |v_y| after the first step: the engine's per-step velocity divisor (1.01)
+	float max_fall_velocity_error; // free-fall velocity against the native recurrence, relative
+	float max_fall_position_error; // free-fall position against the native recurrence, metres
+	int first_contact_step; // -1 when the body never touched anything
+	int settle_step; // first step at which the world deactivated the body; -1 when it never settled
+	float rest_error; // |final y - rest y from the save|
+	float final_speed;
+	bool fell;
+	bool landed_on_floor; // the first contact's other material is the floor's material
+	bool settled;
+	bool destroyed;
+	bool finite;
+	string256 missing; // first missing-data finding, empty when none
+};
+
+// Looks the fixture object up (-s02-physics-object <id>, default 10865: a
+// wooden box 20 m from any other collidable object on k00_marsh), records its
+// shell, bone material and the floor under it, lifts it, installs the step and
+// contact callbacks and opens the CSV. Returns false and names the reason when
+// the object, its shell, its mass or the floor is missing.
+bool PhysicsFixtureBegin(LPCSTR out_path, PhysicsFixtureSummary& summary);
+// True once the body settled and stayed settled, or the step budget ran out.
+bool PhysicsFixtureDone();
+// Removes the callbacks, writes the end row, evaluates the fixture.
+bool PhysicsFixtureEnd(u32 frames, u32 sim_ms, u32 wall_ms, PhysicsFixtureSummary& summary);
+
+// Campaign server entries, used by the smoke after the collision capture.
+extern "C" bool __cdecl xrCampaignLevel_PhysicsFixtureBegin(LPCSTR out_path);
+extern "C" bool __cdecl xrCampaignLevel_PhysicsFixtureDone();
+extern "C" bool __cdecl xrCampaignLevel_PhysicsFixtureEnd(u32 frames, u32 sim_ms, u32 wall_ms);
+
+// Normal client, with -s02-physics-capture and a -start command: one second of
+// device time after the actor spawned, run the fixture, log and quit.
+void ClientPhysicsCaptureOnFrame();
