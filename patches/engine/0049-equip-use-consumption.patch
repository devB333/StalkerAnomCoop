+void release_entity(u64 entity, LPCSTR why, u64 revision)
+{
+	const u16 id = engine_id_of_entity(entity);
+	CSE_ALifeDynamicObject* se = id != kNoEngineId ? ai().alife().objects().object(id, true) : nullptr;
+	if (!se)
+		return;
+	if (!se->m_bOnline)
+	{
+		CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+		alife->release(se, true);
+	}
+	else
+	{
+		// the script's alife_release of an online object (CALifeSimulator__release)
+		NET_Packet packet;
+		packet.w_begin(M_EVENT);
+		packet.w_u32(Level().timeServer());
+		packet.w_u16(GE_DESTROY);
+		packet.w_u16(id);
+		Level().Send(packet, net_flags(TRUE, TRUE));
+	}
+	g_host->log.line("use-release revision=%I64u entity=%I64u id=%u why=%s online=%d", revision, entity, u32(id), why,
+		se->m_bOnline ? 1 : 0);
+}
