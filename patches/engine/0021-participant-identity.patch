diff --git a/src/xrGame/CampaignIdentity.cpp b/src/xrGame/CampaignIdentity.cpp
new file mode 100644
index 0000000..eebdc20
--- /dev/null
+++ b/src/xrGame/CampaignIdentity.cpp
@@ -0,0 +1,443 @@
+#include "pch_script.h"
+#include "CampaignIdentity.h"
+#include "CampaignIdentityHooks.h"
+#include "../xrServerEntities/xrServer_Object_Base.h"
+
+// S03-T01: see CampaignIdentity.h. No engine globals are read here; the
+// registry is a plain state machine over the ids the hooks report.
+
+campaign::CampaignIdentityRegistry* g_campaign_identity = nullptr;
+
+void CampaignIdentity_OnServerIncarnation()
+{
+	if (g_campaign_identity)
+		g_campaign_identity->on_server_incarnation();
+}
+
+void CampaignIdentity_OnServerDestroyed()
+{
+	if (g_campaign_identity)
+		g_campaign_identity->on_server_destroyed();
+}
+
+void CampaignIdentity_OnEngineIdsCleared()
+{
+	// xrServer::clear_ids rebuilds the generator (game_sv_Single::restart_simulator):
+	// every id is free again, so every binding is stale.
+	if (g_campaign_identity)
+		g_campaign_identity->on_server_incarnation();
+}
+
+void CampaignIdentity_OnEngineIdAssigned(u16 id, CSE_Abstract* object)
+{
+	if (g_campaign_identity)
+		g_campaign_identity->on_engine_id_assigned(id, object ? &object->m_campaign_entity : nullptr);
+}
+
+void CampaignIdentity_OnEngineIdFreed(u16 id)
+{
+	if (g_campaign_identity)
+		g_campaign_identity->on_engine_id_freed(id);
+}
+
+namespace campaign
+{
+LPCSTR refusal_name(Refusal refusal)
+{
+	switch (refusal)
+	{
+	case Refusal::None: return "none";
+	case Refusal::NotAuthoritative: return "not-authoritative";
+	case Refusal::WrongRole: return "wrong-role";
+	case Refusal::InvalidIdentity: return "invalid-identity";
+	case Refusal::SlotsFull: return "slots-full";
+	case Refusal::AlreadyBound: return "already-bound";
+	case Refusal::UnknownParticipant: return "unknown-participant";
+	case Refusal::StaleReference: return "stale-reference";
+	case Refusal::UnknownSession: return "unknown-session";
+	case Refusal::SessionInUse: return "session-in-use";
+	case Refusal::BridgeNotParticipant: return "bridge-not-participant";
+	case Refusal::NotAttached: return "not-attached";
+	case Refusal::WrongParty: return "wrong-party";
+	}
+	return "unknown-refusal";
+}
+
+LPCSTR participant_state_name(ParticipantState state)
+{
+	switch (state)
+	{
+	case ParticipantState::Free: return "free";
+	case ParticipantState::Bound: return "bound";
+	case ParticipantState::Attached: return "attached";
+	case ParticipantState::Detached: return "detached";
+	}
+	return "unknown-state";
+}
+
+namespace
+{
+const EngineEntityKey no_key = {kNoEngineId, 0};
+const EntityId no_entity = {0};
+
+void clear_identity(Participant& p)
+{
+	p.player = PlayerId();
+	p.party = PartyId();
+	p.session = 0;
+	p.actor = no_entity;
+	p.actor_key = no_key;
+	p.bound_at = 0;
+	p.attached_at = 0;
+	p.detached_at = 0;
+}
+} // namespace
+
+CampaignIdentityRegistry::CampaignIdentityRegistry(Role role, u8 active_slots)
+	: m_role(role), m_active_slots(active_slots), m_authority(this), m_next_entity(1), m_bridge_session(0),
+	  m_bridge_known(false)
+{
+	ZeroMemory(&m_stats, sizeof(m_stats));
+	m_stats.next_entity = m_next_entity;
+	// Slot generations start at 1 so a zero ParticipantRef never resolves.
+	m_slots.resize(active_slots);
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		m_slots[i].state = ParticipantState::Free;
+		m_slots[i].generation = 1;
+		clear_identity(m_slots[i]);
+	}
+	// Engine generations start at 0 (never assigned); the first assignment is 1.
+	EngineBinding none = {0, no_entity, false, false};
+	m_bindings.assign(kEngineIdCount, none);
+}
+
+const ServerAuthority* CampaignIdentityRegistry::authority() const
+{
+	return m_role == Role::Server ? &m_authority : nullptr;
+}
+
+bool CampaignIdentityRegistry::authorized(const ServerAuthority* authority) const
+{
+	return authority && authority->m_owner == this && m_role == Role::Server;
+}
+
+// --- engine id mapping -----------------------------------------------------
+
+void CampaignIdentityRegistry::retire_all_bindings()
+{
+	for (u32 i = 0; i < m_bindings.size(); ++i)
+	{
+		m_bindings[i].live = false;
+		m_bindings[i].freed_this_incarnation = false;
+	}
+	m_stats.live = 0;
+}
+
+void CampaignIdentityRegistry::on_server_incarnation()
+{
+	retire_all_bindings();
+	++m_stats.incarnations;
+}
+
+void CampaignIdentityRegistry::on_server_destroyed()
+{
+	retire_all_bindings();
+}
+
+EngineEntityKey CampaignIdentityRegistry::on_engine_id_assigned(u16 id, u64* continuity)
+{
+	if (id >= kEngineIdCount)
+		return no_key;
+	EngineBinding& binding = m_bindings[id];
+	EntityId entity;
+	if (continuity && *continuity != 0)
+	{
+		// The object already has an identity: the same id re-requested across
+		// an ALife switch, or a new id for an object that moved.
+		entity.value = *continuity;
+		++m_stats.continued;
+	}
+	else
+	{
+		entity.value = m_next_entity++;
+		if (continuity)
+			*continuity = entity.value;
+	}
+	if (binding.freed_this_incarnation && binding.entity != entity)
+		++m_stats.reassigned_after_free;
+	if (!binding.live)
+		++m_stats.live;
+	++binding.generation;
+	binding.entity = entity;
+	binding.live = true;
+	binding.freed_this_incarnation = false;
+	++m_stats.assigned;
+	if (binding.generation > m_stats.max_generation)
+		m_stats.max_generation = binding.generation;
+	m_stats.next_entity = m_next_entity;
+	EngineEntityKey key = {id, binding.generation};
+	return key;
+}
+
+void CampaignIdentityRegistry::on_engine_id_freed(u16 id)
+{
+	if (id >= kEngineIdCount)
+		return;
+	EngineBinding& binding = m_bindings[id];
+	if (!binding.live)
+	{
+		++m_stats.freed_unbound;
+		return;
+	}
+	binding.live = false;
+	binding.freed_this_incarnation = true;
+	++m_stats.freed;
+	--m_stats.live;
+}
+
+bool CampaignIdentityRegistry::current_key(u16 id, EngineEntityKey& out) const
+{
+	if (id >= kEngineIdCount || !m_bindings[id].live)
+		return false;
+	out.id = id;
+	out.generation = m_bindings[id].generation;
+	return true;
+}
+
+Refusal CampaignIdentityRegistry::resolve(const EngineEntityKey& key, EntityId& out) const
+{
+	out = no_entity;
+	if (key.id >= kEngineIdCount || key.generation == 0)
+		return Refusal::InvalidIdentity;
+	const EngineBinding& binding = m_bindings[key.id];
+	if (!binding.live || binding.generation != key.generation)
+		return Refusal::StaleReference;
+	out = binding.entity;
+	return Refusal::None;
+}
+
+// --- participants ----------------------------------------------------------
+
+Refusal CampaignIdentityRegistry::slot_for(const ParticipantRef& ref, Participant*& out)
+{
+	out = nullptr;
+	if (ref.slot >= m_slots.size())
+		return Refusal::UnknownParticipant;
+	Participant& p = m_slots[ref.slot];
+	if (p.state == ParticipantState::Free)
+		return Refusal::UnknownParticipant;
+	if (p.generation != ref.generation)
+		return Refusal::StaleReference;
+	out = &p;
+	return Refusal::None;
+}
+
+Refusal CampaignIdentityRegistry::participant(const ParticipantRef& ref, const Participant*& out) const
+{
+	out = nullptr;
+	if (ref.slot >= m_slots.size())
+		return Refusal::UnknownParticipant;
+	const Participant& p = m_slots[ref.slot];
+	if (p.state == ParticipantState::Free)
+		return Refusal::UnknownParticipant;
+	if (p.generation != ref.generation)
+		return Refusal::StaleReference;
+	out = &p;
+	return Refusal::None;
+}
+
+Refusal CampaignIdentityRegistry::find_player(const PlayerId& player, ParticipantRef& out) const
+{
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		const Participant& p = m_slots[i];
+		if (p.state != ParticipantState::Free && p.player == player)
+		{
+			out.slot = u8(i);
+			out.generation = p.generation;
+			return Refusal::None;
+		}
+	}
+	return Refusal::UnknownParticipant;
+}
+
+u8 CampaignIdentityRegistry::bound_count() const
+{
+	u8 count = 0;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+		if (m_slots[i].state != ParticipantState::Free)
+			++count;
+	return count;
+}
+
+Refusal CampaignIdentityRegistry::bind_participant(const ServerAuthority* authority, const PlayerId& player,
+	const PartyId& party, u64 now, ParticipantRef& out)
+{
+	if (!authorized(authority))
+		return Refusal::NotAuthoritative;
+	if (!player.valid() || !party.valid())
+		return Refusal::InvalidIdentity;
+	ParticipantRef existing;
+	if (find_player(player, existing) == Refusal::None)
+		return Refusal::AlreadyBound;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		Participant& p = m_slots[i];
+		if (p.state != ParticipantState::Free)
+			continue;
+		clear_identity(p);
+		p.state = ParticipantState::Bound;
+		p.player = player;
+		p.party = party;
+		p.bound_at = now;
+		out.slot = u8(i);
+		out.generation = p.generation;
+		return Refusal::None;
+	}
+	return Refusal::SlotsFull;
+}
+
+Refusal CampaignIdentityRegistry::attach_session(const ServerAuthority* authority, const ParticipantRef& ref,
+	u32 session, u64 now)
+{
+	if (!authorized(authority))
+		return Refusal::NotAuthoritative;
+	if (session == 0)
+		return Refusal::InvalidIdentity;
+	if (m_bridge_known && session == m_bridge_session)
+		return Refusal::BridgeNotParticipant;
+	Participant* p = nullptr;
+	const Refusal refusal = slot_for(ref, p);
+	if (refusal != Refusal::None)
+		return refusal;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		const Participant& other = m_slots[i];
+		if (&other != p && other.state == ParticipantState::Attached && other.session == session)
+			return Refusal::SessionInUse;
+	}
+	if (p->state == ParticipantState::Attached)
+		return p->session == session ? Refusal::None : Refusal::SessionInUse;
+	p->state = ParticipantState::Attached;
+	p->session = session;
+	p->attached_at = now;
+	return Refusal::None;
+}
+
+Refusal CampaignIdentityRegistry::detach_session(const ServerAuthority* authority, u32 session, u64 now)
+{
+	if (!authorized(authority))
+		return Refusal::NotAuthoritative;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		Participant& p = m_slots[i];
+		if (p.state != ParticipantState::Attached || p.session != session)
+			continue;
+		// Identity, party and actor stay with the slot.
+		p.state = ParticipantState::Detached;
+		p.session = 0;
+		p.detached_at = now;
+		return Refusal::None;
+	}
+	return Refusal::UnknownSession;
+}
+
+Refusal CampaignIdentityRegistry::bind_actor(const ServerAuthority* authority, const ParticipantRef& ref,
+	const EngineEntityKey& key)
+{
+	if (!authorized(authority))
+		return Refusal::NotAuthoritative;
+	Participant* p = nullptr;
+	Refusal refusal = slot_for(ref, p);
+	if (refusal != Refusal::None)
+		return refusal;
+	EntityId entity;
+	refusal = resolve(key, entity);
+	if (refusal != Refusal::None)
+		return refusal;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		const Participant& other = m_slots[i];
+		if (&other != p && other.state != ParticipantState::Free && other.actor == entity)
+			return Refusal::AlreadyBound;
+	}
+	p->actor = entity;
+	p->actor_key = key;
+	return Refusal::None;
+}
+
+Refusal CampaignIdentityRegistry::release_participant(const ServerAuthority* authority, const ParticipantRef& ref,
+	u64 now)
+{
+	if (!authorized(authority))
+		return Refusal::NotAuthoritative;
+	Participant* p = nullptr;
+	const Refusal refusal = slot_for(ref, p);
+	if (refusal != Refusal::None)
+		return refusal;
+	(void)now;
+	p->state = ParticipantState::Free;
+	++p->generation;
+	clear_identity(*p);
+	return Refusal::None;
+}
+
+Refusal CampaignIdentityRegistry::set_bridge_session(const ServerAuthority* authority, u32 session)
+{
+	if (!authorized(authority))
+		return Refusal::NotAuthoritative;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+		if (m_slots[i].state == ParticipantState::Attached && m_slots[i].session == session)
+			return Refusal::SessionInUse;
+	m_bridge_session = session;
+	m_bridge_known = true;
+	return Refusal::None;
+}
+
+Refusal CampaignIdentityRegistry::resolve_session(u32 session, ParticipantRef& out) const
+{
+	if (session == 0)
+		return Refusal::InvalidIdentity;
+	if (m_bridge_known && session == m_bridge_session)
+		return Refusal::BridgeNotParticipant;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		const Participant& p = m_slots[i];
+		if (p.state == ParticipantState::Attached && p.session == session)
+		{
+			out.slot = u8(i);
+			out.generation = p.generation;
+			return Refusal::None;
+		}
+	}
+	return Refusal::UnknownSession;
+}
+
+Refusal CampaignIdentityRegistry::authorize(const ActionContext& context, Scope scope) const
+{
+	// Authorization is the server's; a client-role registry never grants it.
+	if (m_role != Role::Server)
+		return Refusal::WrongRole;
+	const Participant* p = nullptr;
+	Refusal refusal = participant(context.actor, p);
+	if (refusal != Refusal::None)
+		return refusal;
+	if (context.origin == Origin::ClientIntent)
+	{
+		if (scope == Scope::Identity || scope == Scope::World)
+			return Refusal::NotAuthoritative;
+		// The session decides who is acting; the named participant is a
+		// claim that must agree with it.
+		ParticipantRef bound;
+		refusal = resolve_session(context.session, bound);
+		if (refusal != Refusal::None)
+			return refusal;
+		if (bound != context.actor)
+			return Refusal::NotAuthoritative;
+	}
+	if (scope == Scope::Party && p->party != context.party)
+		return Refusal::WrongParty;
+	return Refusal::None;
+}
+} // namespace campaign
diff --git a/src/xrGame/CampaignIdentity.h b/src/xrGame/CampaignIdentity.h
new file mode 100644
index 0000000..8140798
--- /dev/null
+++ b/src/xrGame/CampaignIdentity.h
@@ -0,0 +1,272 @@
+#pragma once
+
+// S03-T01: stable participants and authoritative contexts.
+//
+// Why this exists. The engine names every server object by a u16 that
+// xrServer's CID_Generator recycles (id_generator.h: freed ids return to
+// 256-entry blocks and the block freed longest ago is reused first;
+// alife_simulator_script.cpp releases objects with free time 0, so their ids
+// come back soonest), a connection by a u32 ClientID (xrCore/client_id.h)
+// and the player by one global, g_actor (Actor_Network.cpp). None of those
+// is an identity: a recycled u16 names a different object to an old packet
+// or a stale script reference, ClientID 1 is the in-process bridge client
+// ("single_player", xrServer::create_direct_client), and the global actor is
+// whichever actor spawned last with the local/as-player flags. Two
+// participants need identities that survive all three.
+//
+// The model, in three layers:
+//  1. Persistent identities. 128-bit ids for the few long-lived things
+//     (campaign, player, party) and 64-bit serials for entities, allocated
+//     monotonically by the server and never reused within the registry's
+//     life. Items are entities in X-Ray (CSE_ALifeInventoryItem derives from
+//     CSE_Abstract and draws its id from the same generator), so ItemId is
+//     EntityId; there is no second namespace to keep consistent. Stage 7
+//     persists these; here they live for the process.
+//  2. Engine mapping. Every u16 the server hands out gets a generation
+//     (incremented at every assignment of that u16, never reset) and an
+//     EntityId. A reference is {u16, generation}; it resolves only while the
+//     binding it was taken from is live, so a recycled u16 cannot alias.
+//  3. Participants. A fixed number of slots (two, as policy, set at
+//     construction) each holding a player, a party, an optional session
+//     (ClientID value) and an optional actor reference. A slot keeps its
+//     identity when its session detaches; it changes hands only when the
+//     server releases it, and each hand-over bumps the slot's generation so a
+//     stale ParticipantRef is refused rather than resolved to the new owner.
+//
+// Authority. Mutating the registry needs a ServerAuthority, a token only a
+// Server-role registry mints, so client code cannot bind identities by
+// construction. A request that arrived on a session (Origin::ClientIntent)
+// is authorized against the participant that session is attached to; the
+// participant it names is a claim that must agree with that binding, and
+// identity and world scopes are refused to it outright. Nothing here reads
+// engine globals; the engine adapter is CampaignIdentityHooks.h.
+
+namespace campaign
+{
+struct Uuid128
+{
+	u64 hi;
+	u64 lo;
+
+	bool valid() const { return (hi | lo) != 0; }
+	bool operator==(const Uuid128& other) const { return hi == other.hi && lo == other.lo; }
+	bool operator!=(const Uuid128& other) const { return !(*this == other); }
+};
+
+// Distinct types: a PlayerId cannot be passed where a PartyId is expected.
+struct CampaignId : Uuid128
+{
+};
+
+struct PlayerId : Uuid128
+{
+};
+
+struct PartyId : Uuid128
+{
+};
+
+// Server-allocated serial, unique for the life of the registry; 0 is none.
+struct EntityId
+{
+	u64 value;
+
+	bool valid() const { return value != 0; }
+	bool operator==(const EntityId& other) const { return value == other.value; }
+	bool operator!=(const EntityId& other) const { return value != other.value; }
+};
+
+typedef EntityId ItemId;
+
+const u16 kNoEngineId = u16(-1);
+// The server generator hands out 0..u16(-2) (xrServer.h id_generator_type).
+const u32 kEngineIdCount = 0xffff;
+
+// A transient reference to a server object: the engine u16 plus the
+// generation of the assignment it was taken from.
+struct EngineEntityKey
+{
+	u16 id;
+	u32 generation;
+
+	bool operator==(const EngineEntityKey& other) const { return id == other.id && generation == other.generation; }
+	bool operator!=(const EngineEntityKey& other) const { return !(*this == other); }
+};
+
+enum class Role : u8
+{
+	Server, // the dedicated process: simulation authority
+	Client, // a rendering client: input and presentation
+};
+
+enum class Origin : u8
+{
+	ServerInternal, // produced inside the authoritative process
+	ClientIntent, // arrived on a session; a request, never an outcome
+};
+
+// What an action touches; decides which origins may perform it.
+enum class Scope : u8
+{
+	Identity, // binding, attaching, releasing participants (server only)
+	World, // shared simulation state (server only)
+	Party, // party-shared state; the context's party must be the actor's
+	Self, // the acting participant's own actor
+};
+
+enum class Refusal : u8
+{
+	None,
+	NotAuthoritative, // no server token, or a client intent beyond its session's participant
+	WrongRole, // a server-internal context on a client-role registry
+	InvalidIdentity, // zero player, party or engine key
+	SlotsFull, // every active slot is bound
+	AlreadyBound, // the player already holds a slot
+	UnknownParticipant, // free slot, or slot index out of range
+	StaleReference, // slot or engine generation no longer current
+	UnknownSession, // no participant is attached to that session
+	SessionInUse, // the session is attached to another participant
+	BridgeNotParticipant, // the in-process bridge client is never a participant
+	NotAttached, // the participant has no session
+	WrongParty, // the context's party is not the participant's party
+};
+
+LPCSTR refusal_name(Refusal refusal);
+
+struct ParticipantRef
+{
+	u8 slot;
+	u32 generation;
+
+	bool operator==(const ParticipantRef& other) const { return slot == other.slot && generation == other.generation; }
+	bool operator!=(const ParticipantRef& other) const { return !(*this == other); }
+};
+
+enum class ParticipantState : u8
+{
+	Free,
+	Bound, // identity held, no session yet
+	Attached, // a session is connected
+	Detached, // the session went away; identity, party and actor retained
+};
+
+LPCSTR participant_state_name(ParticipantState state);
+
+struct Participant
+{
+	ParticipantState state;
+	u32 generation; // bumped when the slot is released
+	PlayerId player;
+	PartyId party;
+	u32 session; // ClientID value while Attached, else 0
+	EntityId actor; // the participant's actor, if bound
+	EngineEntityKey actor_key;
+	u64 bound_at;
+	u64 attached_at;
+	u64 detached_at;
+};
+
+struct ActionContext
+{
+	Origin origin;
+	u32 session; // the session a client intent arrived on; 0 for server-internal
+	ParticipantRef actor; // the participant the action is about
+	PartyId party; // the party the action claims to act within (Scope::Party)
+};
+
+class CampaignIdentityRegistry;
+
+// Capability token. Only a Server-role registry constructs one, and only for
+// itself; there is no public constructor and no copy.
+class ServerAuthority
+{
+	friend class CampaignIdentityRegistry;
+	const CampaignIdentityRegistry* m_owner;
+
+	explicit ServerAuthority(const CampaignIdentityRegistry* owner) : m_owner(owner)
+	{
+	}
+
+	ServerAuthority(const ServerAuthority&);
+	ServerAuthority& operator=(const ServerAuthority&);
+};
+
+class CampaignIdentityRegistry
+{
+public:
+	struct EngineIdStats
+	{
+		u64 assigned; // PerformIDgen results seen
+		u64 freed; // FreeID calls seen for live bindings
+		u64 freed_unbound; // FreeID calls for ids with no live binding (a flow the hooks do not model)
+		u64 reassigned_after_free; // a u16 freed earlier in this incarnation handed to a different object
+		u64 continued; // a u16 re-requested by the object that held it (the ALife switches)
+		u64 live; // bindings currently live
+		u64 incarnations; // server constructions and id resets
+		u32 max_generation;
+		u64 next_entity; // the next EntityId that will be allocated
+	};
+
+	CampaignIdentityRegistry(Role role, u8 active_slots = 2);
+
+	Role role() const { return m_role; }
+	u8 active_slots() const { return m_active_slots; }
+	// The token for this registry, or null on a client.
+	const ServerAuthority* authority() const;
+
+	// Engine id mapping (fed by CampaignIdentityHooks.h on the server).
+	void on_server_incarnation();
+	void on_server_destroyed();
+	// continuity: the object's stored entity id (0 = none); read to continue an
+	// existing identity, written when a new one is allocated. Null for no object.
+	EngineEntityKey on_engine_id_assigned(u16 id, u64* continuity = nullptr);
+	void on_engine_id_freed(u16 id);
+	bool current_key(u16 id, EngineEntityKey& out) const;
+	Refusal resolve(const EngineEntityKey& key, EntityId& out) const;
+	const EngineIdStats& engine_id_stats() const { return m_stats; }
+
+	// Participants. Every mutation needs this registry's token.
+	Refusal bind_participant(const ServerAuthority* authority, const PlayerId& player, const PartyId& party, u64 now,
+		ParticipantRef& out);
+	Refusal attach_session(const ServerAuthority* authority, const ParticipantRef& ref, u32 session, u64 now);
+	Refusal detach_session(const ServerAuthority* authority, u32 session, u64 now);
+	Refusal bind_actor(const ServerAuthority* authority, const ParticipantRef& ref, const EngineEntityKey& key);
+	Refusal release_participant(const ServerAuthority* authority, const ParticipantRef& ref, u64 now);
+	Refusal set_bridge_session(const ServerAuthority* authority, u32 session);
+
+	// Lookups.
+	Refusal resolve_session(u32 session, ParticipantRef& out) const;
+	Refusal participant(const ParticipantRef& ref, const Participant*& out) const;
+	Refusal find_player(const PlayerId& player, ParticipantRef& out) const;
+	u8 bound_count() const;
+	// Whether the context may perform an action of the given scope.
+	Refusal authorize(const ActionContext& context, Scope scope) const;
+
+private:
+	struct EngineBinding
+	{
+		u32 generation;
+		EntityId entity;
+		bool live;
+		bool freed_this_incarnation;
+	};
+
+	bool authorized(const ServerAuthority* authority) const;
+	Refusal slot_for(const ParticipantRef& ref, Participant*& out);
+	void retire_all_bindings();
+
+	Role m_role;
+	u8 m_active_slots;
+	ServerAuthority m_authority;
+	xr_vector<Participant> m_slots;
+	xr_vector<EngineBinding> m_bindings;
+	EngineIdStats m_stats;
+	u64 m_next_entity;
+	u32 m_bridge_session;
+	bool m_bridge_known;
+};
