+bool fixture_actor_access()
+{
+	Check f("actor-access-fixture");
+	CampaignIdentityRegistry registry(Role::Server);
+	registry.on_server_incarnation();
+	const ServerAuthority* authority = registry.authority();
+
+	const EngineEntityKey k1 = registry.on_engine_id_assigned(10);
+	const EngineEntityKey k2 = registry.on_engine_id_assigned(11);
+	const EngineEntityKey k3 = registry.on_engine_id_assigned(12);
+	ParticipantRef p1, p2, who;
+	f.expect(registry.bind_participant(authority, player_id(1), party_id(1), 1, p1), Refusal::None, "bind player 1");
+	f.expect(registry.bind_participant(authority, player_id(2), party_id(1), 2, p2), Refusal::None, "bind player 2");
+
+	EngineEntityKey key;
+	f.check(registry.live_actor_count() == 0, "no participant holds an actor yet");
+	f.expect(registry.sole_actor_key(key), Refusal::NoActor, "no sole actor without actors");
+	f.expect(registry.participant_actor_key(p1, key), Refusal::NoActor, "participant 1 has no actor yet");
+
+	// One actor: the sole actor is participant 1's and nobody else's.
+	f.expect(registry.bind_actor(authority, p1, k1), Refusal::None, "bind actor 10 to participant 1");
+	f.check(registry.live_actor_count() == 1, "one live actor");
+	f.expect(registry.sole_actor_key(key, &who), Refusal::None, "one actor is the sole actor");
+	f.check(key == k1 && who == p1, "the sole actor is participant 1's");
+	f.expect(registry.participant_actor_key(p2, key), Refusal::NoActor, "participant 2 still has no actor");
+	f.expect(registry.participant_of_engine_id(10, who), Refusal::None, "id 10 is held");
+	f.check(who == p1, "id 10 is held by participant 1");
+	f.expect(registry.participant_of_engine_id(12, who), Refusal::UnknownParticipant, "id 12 is held by nobody");
+	f.expect(registry.participant_of_engine_id(500, who), Refusal::StaleReference, "an unassigned id is not current");
+
+	// Two actors: a single-actor lookup refuses rather than picks.
+	f.expect(registry.bind_actor(authority, p2, k2), Refusal::None, "bind actor 11 to participant 2");
+	f.check(registry.live_actor_count() == 2, "two live actors");
+	f.expect(registry.sole_actor_key(key), Refusal::Ambiguous, "two actors: no sole actor");
+	f.expect(registry.participant_actor_key(p1, key), Refusal::None, "participant 1 resolves");
+	f.check(key == k1, "participant 1 resolves to actor 10");
+	f.expect(registry.participant_actor_key(p2, key), Refusal::None, "participant 2 resolves");
+	f.check(key == k2, "participant 2 resolves to actor 11");
+	f.expect(registry.participant_of_engine_id(11, who), Refusal::None, "id 11 is held");
+	f.check(who == p2, "id 11 is held by participant 2");
+
+	// The actor object goes away: its participant keeps the slot with no actor.
+	registry.on_engine_id_freed(11);
+	f.expect(registry.participant_actor_key(p2, key), Refusal::NoActor, "a freed actor is no actor");
+	f.check(registry.live_actor_count() == 1, "one live actor after the free");
+	f.expect(registry.sole_actor_key(key, &who), Refusal::None, "the sole actor is back");
+	f.check(key == k1 && who == p1, "the sole actor is participant 1's again, not participant 2's");
+	f.expect(registry.participant_of_engine_id(11, who), Refusal::StaleReference, "the freed id is not current");
+
+	// Adoption at spawn: the first participant without a live actor.
+	f.expect(registry.adopt_spawned_actor(authority, 12, who), Refusal::None, "actor 12 adopts a participant");
+	f.check(who == p2, "actor 12 is adopted by participant 2, the one without an actor");
+	f.expect(registry.participant_actor_key(p2, key), Refusal::None, "participant 2 holds actor 12");
+	f.check(key == k3, "participant 2's actor is 12");
+	f.expect(registry.adopt_spawned_actor(authority, 12, who), Refusal::None, "adopting again is idempotent");
+	f.check(who == p2, "the same participant still holds actor 12");
+	registry.on_engine_id_assigned(13);
+	f.expect(registry.adopt_spawned_actor(authority, 13, who), Refusal::UnknownParticipant,
+		"a third actor finds no participant to hold it");
+	f.expect(registry.adopt_spawned_actor(nullptr, 13, who), Refusal::NotAuthoritative, "adoption needs the token");
+	f.expect(registry.adopt_spawned_actor(authority, 700, who), Refusal::StaleReference, "an unassigned id cannot adopt");
+
+	// Contexts resolve their own participant's actor only.
+	f.expect(registry.attach_session(authority, p2, 7, 3), Refusal::None, "session 7 attaches to participant 2");
+	f.expect(registry.context_actor_key(context(Origin::ClientIntent, 7, p2, party_id(1)), Scope::Self, key),
+		Refusal::None, "a client intent on session 7 acts as participant 2");
+	f.check(key == k3, "...and resolves participant 2's actor");
+	f.expect(registry.context_actor_key(context(Origin::ClientIntent, 7, p1, party_id(1)), Scope::Self, key),
+		Refusal::NotAuthoritative, "session 7 cannot act as participant 1");
+	f.expect(registry.context_actor_key(context(Origin::ClientIntent, 7, p2, party_id(1)), Scope::World, key),
+		Refusal::NotAuthoritative, "a client intent cannot act in world scope");
+	f.expect(registry.context_actor_key(context(Origin::ServerInternal, 0, p1, party_id(1)), Scope::World, key),
+		Refusal::None, "the server acts for participant 1 in world scope");
+	f.check(key == k1, "...and resolves participant 1's actor");
+	f.expect(registry.context_actor_key(context(Origin::ServerInternal, 0, p1, party_id(2)), Scope::Party, key),
+		Refusal::WrongParty, "a party action names the actor's party");
+
+	// Release: the slot's old reference is stale, and the sole actor is participant 1's.
+	f.expect(registry.release_participant(authority, p2, 4), Refusal::None, "release participant 2");
+	f.expect(registry.participant_actor_key(p2, key), Refusal::UnknownParticipant, "a released participant has no actor");
+	f.check(registry.live_actor_count() == 1, "one live actor after the release");
+	f.expect(registry.sole_actor_key(key, &who), Refusal::None, "the sole actor after the release");
+	f.check(key == k1 && who == p1, "...is participant 1's");
+
+	// A client-role registry answers no participant lookup.
+	CampaignIdentityRegistry client(Role::Client);
+	client.on_server_incarnation();
+	client.on_engine_id_assigned(10);
+	f.expect(client.sole_actor_key(key), Refusal::NoActor, "a client registry holds no actors");
+	f.expect(client.adopt_spawned_actor(client.authority(), 10, who), Refusal::NotAuthoritative,
+		"a client registry cannot adopt");
+	f.expect(client.context_actor_key(context(Origin::ServerInternal, 0, p1, party_id(1)), Scope::Self, key),
+		Refusal::WrongRole, "a client registry authorizes nothing");
+	return f.done();
+}
