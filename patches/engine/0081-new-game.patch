+// The start move: an agreed party travel (creating the game is the consent), carried out by the S09 executor
+void new_game_tick()
+{
+	if (g_host->new_game_state != 1)
+		return;
+	Host::Travel& tv = g_host->travel;
+	CoopPersistence* persistence = g_host->persistence;
+	if (!tv.coordinator || tv.exec || tv.hold_id || tv.coordinator->live() || !persistence || persistence->failed() ||
+		persistence->in_flight())
+		return;
+	const u16 gvid = g_host->new_game_game_vertex;
+	tv.changer = kNoEngineId;
+	tv.relocation = false;
+	tv.level = *ai().game_graph().header().level(ai().game_graph().vertex(gvid)->level_id()).name();
+	tv.position = g_host->new_game_position;
+	tv.graph_vertex = GameGraph::_GRAPH_ID(gvid);
+	tv.level_vertex = g_host->new_game_level_vertex;
+	tv.angles.set(0.f, 0.f, 0.f);
+	const u64 now = g_host->wall.GetElapsed_ms();
+	coop::proto::Transition proposed, agreed;
+	if (tv.coordinator->propose(0, 1, gvid, now, proposed) != coop::proto::TravelVerdict::Ok ||
+		tv.coordinator->answer(1, proposed.id, coop::proto::TravelAnswer::Accept, now, agreed) !=
+			coop::proto::TravelVerdict::Ok || agreed.state != coop::proto::TravelState::Agreed)
+	{
+		g_host->new_game_state = 3;
+		g_host->log.line("new-game-start-failed reason=coordinator level=%s", tv.level.c_str());
+		return;
+	}
+	g_host->new_game_state = 2;
+	++tv.proposals;
+	g_host->log.line("new-game-start-move id=%I64x level=%s gvid=%u lvid=%u pos=%.2f,%.2f,%.2f", agreed.id,
+		tv.level.c_str(), u32(gvid), tv.level_vertex, VPUSH(tv.position));
+	end_travel(agreed);
+}
