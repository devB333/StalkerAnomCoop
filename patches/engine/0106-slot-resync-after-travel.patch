+// B45: a player's weapon state as the server's inventory holds it (the
+// active, next and previous slots, which slots are blocked, what each weapon
+// slot holds, whether it can be activated)
+void log_actor_weapons(LPCSTR tag, u8 slot_of_player, CActor* actor)
+{
+	if (!actor)
+		return;
+	CInventory& inv = actor->inventory();
+	string256 slots = "";
+	for (u16 s = KNIFE_SLOT; s <= INV_SLOT_3; ++s)
+	{
+		PIItem item = inv.ItemFromSlot(s);
+		string64 one;
+		xr_sprintf(one, " %u:%s:%s%s", u32(s), item ? *item->object().cNameSect() : "-", item && inv.IsSlotBlocked(item) ? "b" : "",
+			"");
+		xr_strcat(slots, one);
+	}
+	g_host->log.line("actor-weapons tag=%s slot=%u actor=%u alive=%d active=%u next=%u prev=%u enabled=%d ready=%d%s", tag,
+		u32(slot_of_player), u32(actor->ID()), actor->g_Alive() ? 1 : 0, u32(inv.GetActiveSlot()),
+		u32(inv.GetNextActiveSlot()), u32(inv.GetPrevActiveSlot()), actor->getEnabled() ? 1 : 0, actor->Ready() ? 1 : 0, slots);
+}
