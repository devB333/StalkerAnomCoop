+// ------------------------------------------------------------ S10-T03c
+// Party sleep as a client sees it (decision T01-8): the installed sleep window's
+// button sends a request (kind 24) instead of skipping this client's time; the
+// partner is asked (USE sleeps too, DROP refuses; the requester's DROP cancels);
+// an agreed sleep fades both screens and names the hours (the world's time is
+// the server's, CampaignEvent 1); a blackout (passing out) fades this screen
+// for its seconds while the server holds the input.
+bool sleep_request(int hours)
+{
+	if (!g_link || !g_link->active || g_link->world != WorldLive || !g_actor)
+		return false;
+	xr_vector<u8> params;
+	params.push_back(u8(hours));
+	++g_link->sleep.requests;
+	request_ownership(coop::proto::kActionSleepRequest, coop::proto::EntityRef(), params, 0, 0xffffffff, 0, true,
+		"sleep-window");
+	string128 text;
+	xr_sprintf(text, "Asking your partner to sleep %d hours...", hours);
+	travel_hud(text, 4);
+	g_link->log.line("sleep-request-sent hours=%d", hours);
+	return true;
+}
+
+u64 answer_sleep(u64 id, u8 answer, LPCSTR why)
+{
+	xr_vector<u8> params;
+	for (int b = 0; b < 8; ++b)
+		params.push_back(u8(id >> (8 * b)));
+	params.push_back(answer);
+	++g_link->sleep.answers;
+	g_link->log.line("sleep-answer-sent id=%I64x answer=%u why=%s", id, u32(answer), why);
+	return request_ownership(coop::proto::kActionSleepAnswer, coop::proto::EntityRef(), params, 0, 0xffffffff, 0, true,
+		why);
+}
+
+void sleep_present(LPCSTR anim, LPCSTR text, int seconds)
+{
+	string512 chunk;
+	xr_sprintf(chunk, "level.add_pp_effector('surge_fade.ppe', 11, false) "
+		"level.add_cam_effector('camera_effects\\\\%s', 10, false, '') "
+		"if actor_menu then actor_menu.set_msg(1, \"%s\", %d) end", anim, text, seconds);
+	lua_State* L = ai().script_engine().lua();
+	if (L && luaL_loadbuffer(L, chunk, xr_strlen(chunk), "coop_sleep_present") == 0)
+	{
+		if (lua_pcall(L, 0, 0, 0) != 0)
+		{
+			g_link->log.line("sleep-present-error %s", lua_tostring(L, -1));
+			lua_pop(L, 1);
+		}
+	}
+	else if (L)
+		lua_pop(L, 1);
+}
+
+void on_sleep(const coop::proto::CampaignEvent& event)
+{
+	const std::vector<u8>& b = event.payload;
+	if (b.size() != 17)
+		return;
+	u64 id = 0;
+	for (int i = 0; i < 8; ++i)
+		id |= u64(b[i]) << (8 * i);
+	const u8 state = b[8], requester = b[9], partner = b[10], abort = b[11], hours = b[12];
+	u32 remaining = 0;
+	memcpy(&remaining, b.data() + 13, 4);
+	Link::Sleep& sl = g_link->sleep;
+	++sl.events;
+	g_link->log.line("sleep-event id=%I64x state=%u requester=%u partner=%u abort=%u hours=%u remaining_ms=%u me=%u",
+		id, u32(state), u32(requester), u32(partner), u32(abort), u32(hours), remaining, u32(g_link->local_slot));
+	string256 text;
+	if (state == 1)
+	{
+		sl.live_id = id;
+		sl.requester = requester;
+		sl.partner = partner;
+		sl.hours = hours;
+		sl.deadline_ms = g_link->wall.GetElapsed_ms() + remaining;
+		sl.hud_ms = g_link->wall.GetElapsed_ms();
+		if (g_link->local_slot == requester)
+			xr_sprintf(text, "Waiting for Player %u to agree to sleep %u hours (%u s). DROP cancels.", u32(partner) + 1,
+				u32(hours), remaining / 1000);
+		else
+			xr_sprintf(text, "Player %u wants to sleep %u hours. USE to sleep too, DROP to refuse.", u32(requester) + 1,
+				u32(hours));
+		travel_hud(text, int(remaining / 1000) + 1);
+		return;
+	}
+	if (state == 11)
+	{
+		++sl.blackouts;
+		sleep_present("surge_02.anm", "You passed out.", int(remaining / 1000));
+		g_link->log.line("sleep-blackout hours=%u seconds=%u", u32(hours), remaining / 1000);
+		return;
+	}
+	if (id == sl.live_id)
+	{
+		sl.prev_id = sl.live_id;
+		sl.live_id = 0;
+	}
+	if (state == 2)
+	{
+		++sl.slept;
+		xr_sprintf(text, "You slept %u hours.", u32(hours));
+		sleep_present("sleep.anm", text, 5);
+		g_link->log.line("sleep-slept id=%I64x hours=%u", id, u32(hours));
+		return;
+	}
+	LPCSTR what = state == 3 ? "refused" : state == 4 ? "expired" : state == 5 ? "cancelled" : "aborted";
+	LPCSTR why = abort == 1 || abort == 2 ? " (a player left)" : abort == 3 || abort == 4 ? " (a player died)" :
+		abort == 5 ? " (combat)" : "";
+	xr_sprintf(text, "Sleep %s%s.", what, why);
+	travel_hud(text, 5);
+}
+
+bool sleep_key_press(int key)
+{
+	if (!g_link || !g_link->active || g_link->world != WorldLive || !g_actor)
+		return false;
+	Link::Sleep& sl = g_link->sleep;
+	if (!sl.live_id)
+		return false;
+	const EGameActions action = get_binded_action(key);
+	if (action != kUSE && action != kDROP)
+		return false;
+	if (g_link->local_slot == sl.partner)
+	{
+		answer_sleep(sl.live_id, action == kUSE ? 1 : 2, action == kUSE ? "use-key" : "drop-key");
+		return true;
+	}
+	if (g_link->local_slot == sl.requester && action == kDROP)
+	{
+		answer_sleep(sl.live_id, 3, "drop-key");
+		return true;
+	}
+	return false;
+}
+
+void sleep_frame()
+{
+	Link::Sleep& sl = g_link->sleep;
+	if (!sl.live_id)
+		return;
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (g_link->local_slot == sl.requester && now - sl.hud_ms >= 5000 && now < sl.deadline_ms)
+	{
+		sl.hud_ms = now;
+		string256 text;
+		xr_sprintf(text, "Waiting for Player %u to agree to sleep %u hours (%u s). DROP cancels.", u32(sl.partner) + 1,
+			u32(sl.hours), (sl.deadline_ms - now) / 1000);
+		travel_hud(text, 6);
+	}
+	if (now > sl.deadline_ms + 10000)
+	{
+		g_link->log.line("sleep-stale-proposal id=%I64x", sl.live_id);
+		sl.prev_id = sl.live_id;
+		sl.live_id = 0;
+	}
+}
