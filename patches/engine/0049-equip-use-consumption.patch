+// ------------------------------------------------------------ S08-T07
+// Equip and use. The client's own inventory paths end in the engine's
+// GEG_PLAYER_ITEM2SLOT / 2BELT / 2RUCK and GEG_PLAYER_ITEM_EAT events
+// (db.actor:move_to_slot/belt/ruck, the engine UI, the quick-use key) or in
+// CInventory::Eat (db.actor:eat, the installed inventory UI's Use): on a
+// replica they become intents (kinds 9 and 10) and nothing changes locally.
+// The server's answer is the actors' inventory layouts (CampaignEvent 9),
+// which the replica applies; an accepted use plays its first-person
+// presentation (actor_effects.play_item_fx) here, where single player plays it.
+
+void inventory_intent(u16 action, u16 item, const coop::proto::EntityRef& item_ref, const xr_vector<u8>& params)
+{
+	Link::TransferStepRun* st = awaiting_step(action, item);
+	const u64 operation = request_ownership(action, item_ref, params, 0, st ? st->round : 0xffffffff, 0, !st,
+		st ? "driver" : "player");
+	if (action == coop::proto::kActionUse)
+	{
+		++g_link->uses_requested;
+		if (CObject* object = Level().Objects.net_Find(item))
+			g_link->pickup_pending.back().fx = object->cNameSect().c_str();
+	}
+	else
+		++g_link->equips_requested;
+	if (st)
+	{
+		st->linked = true;
+		st->operation = operation;
+		Link::PickupPending& p = g_link->pickup_pending.back();
+		p.step = st->step;
+		pickup_csv_line("linked", st->round, 0, operation, item_ref, 0, 0, 0, action, st->step);
+	}
+}
+
+// The layouts: per actor entity, the newest complete one; applied until the
+// replica matches it (an item's Reparent may still be on its way).
+void layout_csv(LPCSTR event, u64 actor, u32 serial, u32 items, u32 moves, u32 unresolved)
+{
+	if (!g_link->layout_csv)
+	{
+		string_path path;
+		FS.update_path(path, "$logs$", "coop-layout-client.csv");
+		g_link->layout_csv = fopen(path, "w");
+		if (!g_link->layout_csv)
+			return;
+		fprintf(g_link->layout_csv, "utc_ms,event,actor_entity,serial,items,moves,unresolved\n");
+	}
+	fprintf(g_link->layout_csv, "%I64u,%s,%I64u,%u,%u,%u,%u\n", utc_now_ms(), event, actor, serial, items, moves,
+		unresolved);
+	fflush(g_link->layout_csv);
+}
+
+void on_layout(const coop::proto::CampaignEvent& event)
+{
+	const std::vector<u8>& b = event.payload;
+	if (b.size() < 15)
+		return;
+	u64 actor = 0;
+	u32 serial = 0;
+	for (int i = 0; i < 8; ++i)
+		actor |= u64(b[i]) << (8 * i);
+	for (int i = 0; i < 4; ++i)
+		serial |= u32(b[8 + i]) << (8 * i);
+	const u8 part = b[12], parts = b[13], count = b[14];
+	if (!parts || part >= parts || parts > 16 || b.size() != 15 + size_t(count) * 11)
+		return;
+	Link::ActorLayout& l = g_link->layouts[actor];
+	if (l.building_serial != serial || part == 0)
+	{
+		l.building_serial = serial;
+		l.building.clear();
+		l.parts_seen = 0;
+	}
+	for (u32 k = 0; k < count; ++k)
+	{
+		const u8* e = b.data() + 15 + k * 11;
+		Link::LayoutItem item;
+		item.entity = 0;
+		for (int i = 0; i < 8; ++i)
+			item.entity |= u64(e[i]) << (8 * i);
+		item.place = e[8];
+		item.slot = e[9];
+		item.uses = e[10];
+		l.building.push_back(item);
+	}
+	l.parts_seen |= 1u << part;
+	if (l.parts_seen != (1u << parts) - 1)
+		return;
+	l.target = l.building;
+	l.serial = serial;
+	l.settled = false;
+	l.since_ms = g_link->wall.GetElapsed_ms();
+	++g_link->layouts_received;
+	layout_csv("received", actor, serial, u32(l.target.size()), 0, 0);
+}
