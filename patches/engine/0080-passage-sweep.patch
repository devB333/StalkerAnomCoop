+// The passage sweep (profile sweep_party, server-driven; matrix F11, L50).
+// The graph is every CSE_ALifeLevelChanger in the ALife registry (its level
+// from its game vertex, its destination from m_tNextGraphID). On each level,
+// once both players are in the world and nothing is executing for 5 s, the
+// fixture asks (player 1) and agrees (player 2) to travel through a changer
+// of an untravelled passage of this level; with none left here, through the
+// first hop of the shortest way to a level that has one. The request skips
+// the "inside the changer" check (S09 proved it; walking player 2's actor
+// hundreds of metres server-side crashed a client, L58): what the sweep checks
+// is that every passage carries the party to its level and both clients rejoin
+// there. Each trip logs fixture-sweep passage; a changer refused here (24: a
+// story-disabled one) is not tried again. compare-coop-sweep.py.
+u16 sweep_request(PlayerLink& p1, PlayerLink& p2, u16 changer)
+{
+	Host::SweepFixture& f = g_host->sweep_fixture;
+	coop::proto::ActionIntent intent;
+	intent.operation_id = ++f.operation;
+	intent.kind = coop::proto::kActionTravelRequest;
+	coop::proto::EntityRef ref;
+	if (!entity_ref_of(changer, ref))
+		return coop::proto::kReasonNoChanger;
+	intent.target = ref;
+	coop::proto::ActionResult result;
+	g_host->sweep_bypass = true;
+	const u16 reason = take_travel_request(p1, intent, result);
+	g_host->sweep_bypass = false;
+	if (reason)
+		return reason;
+	coop::proto::ActionIntent answer;
+	answer.operation_id = ++f.operation;
+	answer.kind = coop::proto::kActionTravelAnswer;
+	for (int b = 0; b < 8; ++b)
+		answer.params.push_back(u8(result.revision >> (8 * b)));
+	answer.params.push_back(1);
+	coop::proto::ActionResult r2;
+	g_host->sweep_bypass = true;
+	const u16 r = take_travel_answer(p2, answer, r2);
+	g_host->sweep_bypass = false;
+	return r;
+}
+
+// The first hop of the shortest way from `from` to a level with an untravelled
+// passage (over changers not refused): its changer's name, else empty.
+xr_string sweep_next_hop(const xr_string& from, xr_string& target)
+{
+	Host::SweepFixture& f = g_host->sweep_fixture;
+	xr_map<xr_string, xr_string> first; // level -> the first hop's changer name from `from`
+	xr_vector<xr_string> queue;
+	queue.push_back(from);
+	first[from] = "";
+	for (u32 i = 0; i < queue.size(); ++i)
+	{
+		const xr_string level = queue[i];
+		for (const Host::SweepFixture::Edge& e : f.edges)
+		{
+			if (e.from != level || f.bad_changers.count(e.id))
+				continue;
+			if (level != from && !f.result.count(e.from + ">" + e.to))
+			{
+				target = level;
+				return first[level];
+			}
+			if (!first.count(e.to))
+			{
+				first[e.to] = level == from ? e.changer : first[level];
+				queue.push_back(e.to);
+			}
+		}
+	}
+	return "";
+}
+
+void sweep_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.sweep_party || !ai().get_alife())
+		return;
+	Host::SweepFixture& f = g_host->sweep_fixture;
+	Host::Travel& tv = g_host->travel;
+	if (f.phase >= 999)
+		return;
+	// the party stands idle at every arrival point: god mode for the sweep (as
+	// the S03-T04 activation fixture), so an arrival among monsters is not a death
+	if (!psActorFlags.test(AF_GODMODE))
+	{
+		psActorFlags.set(AF_GODMODE, TRUE);
+		psActorFlags.set(AF_GODMODE_RT, TRUE);
+		g_host->log.line("fixture-sweep godmode on");
+	}
+	PlayerLink* links[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.ref.slot < 2)
+			if (CActor* a = participant_actor(link.ref))
+				if (a->g_Alive())
+				{
+					links[link.ref.slot] = &link;
+					++attached;
+				}
+	const xr_string here = Level().name().c_str();
+	const bool quiet = attached == 2 && !travel_executing() && !(tv.coordinator && tv.coordinator->live());
+	if (!quiet || here != f.level)
+	{
+		f.since = quiet ? g_host->tick : 0;
+		f.level = here;
+	}
+	if (!quiet)
+	{
+		// a trip that ends with no reload (the executor failed and rolled back)
+		if (f.phase == 2 && g_host->tick - f.phase_tick > 300 * 50)
+		{
+			f.result[f.via] = "timeout";
+			++f.failed;
+			g_host->log.line("fixture-sweep passage n=%u key=%s changer=%s result=timeout", f.travels, f.via.c_str(),
+				f.changer_name.c_str());
+			f.phase = 1;
+		}
+		return;
+	}
+	if (f.phase == 0)
+	{
+		const CALifeObjectRegistry::OBJECT_REGISTRY& objects = ai().alife().objects().objects();
+		for (CALifeObjectRegistry::OBJECT_REGISTRY::const_iterator it = objects.begin(); it != objects.end(); ++it)
+		{
+			const CSE_ALifeLevelChanger* lc = smart_cast<const CSE_ALifeLevelChanger*>(it->second);
+			if (!lc || !ai().game_graph().valid_vertex_id(lc->m_tGraphID) || !ai().game_graph().valid_vertex_id(lc->m_tNextGraphID))
+				continue;
+			Host::SweepFixture::Edge e;
+			e.from = *ai().game_graph().header().level(ai().game_graph().vertex(lc->m_tGraphID)->level_id()).name();
+			e.to = *ai().game_graph().header().level(ai().game_graph().vertex(lc->m_tNextGraphID)->level_id()).name();
+			e.changer = lc->name_replace();
+			e.id = lc->ID;
+			if (e.from != e.to && e.from != "fake_start") // the marsh's start changer is not a passage
+				f.edges.push_back(e);
+		}
+		xr_set<xr_string> pairs, levels;
+		for (const Host::SweepFixture::Edge& e : f.edges)
+		{
+			pairs.insert(e.from + ">" + e.to);
+			levels.insert(e.from);
+			g_host->log.line("fixture-sweep edge from=%s to=%s changer=%s id=%u", e.from.c_str(), e.to.c_str(), e.changer.c_str(),
+				u32(e.id));
+		}
+		g_host->log.line("fixture-sweep graph levels=%u changers=%u passages=%u start=%s", u32(levels.size()), u32(f.edges.size()),
+			u32(pairs.size()), here.c_str());
+		f.phase = 1;
+		return;
+	}
+	if (f.phase == 2)
+	{
+		// back in the world after the trip, or still here (refused, failed)
+		const bool reloaded = tv.reloads != f.reloads0;
+		const bool arrived = reloaded && here == f.going_to;
+		LPCSTR result = arrived ? "ok" : reloaded ? "wrong-level" : tv.exec_failed != f.failed0 ? "failed" : "no-travel";
+		if (f.sweeping || !arrived)
+			f.result[f.via] = result;
+		if (arrived)
+			++f.ok;
+		else
+			++f.failed;
+		g_host->log.line("fixture-sweep passage n=%u key=%s changer=%s result=%s sweeping=%d level=%s seconds=%.1f", f.travels,
+			f.via.c_str(), f.changer_name.c_str(), result, f.sweeping ? 1 : 0, here.c_str(),
+			float(g_host->tick - f.phase_tick) / 50.f);
+		f.phase = 1;
+		f.since = g_host->tick;
+		return;
+	}
+	if (g_host->tick - f.since < 5 * 50)
+		return;
+	// choose: an untravelled passage from here; else the first hop toward one
+	const Host::SweepFixture::Edge* pick = nullptr;
+	for (const Host::SweepFixture::Edge& e : f.edges)
+		if (e.from == here && !f.bad_changers.count(e.id) && !f.result.count(e.from + ">" + e.to))
+		{
+			pick = &e;
+			break;
+		}
+	bool sweeping = pick != nullptr;
+	if (!pick)
+	{
+		xr_string target;
+		const xr_string hop = sweep_next_hop(here, target);
+		for (const Host::SweepFixture::Edge& e : f.edges)
+			if (e.from == here && e.changer == hop)
+				pick = &e;
+		if (!pick)
+		{
+			u32 remaining = 0;
+			xr_set<xr_string> pairs;
+			for (const Host::SweepFixture::Edge& e : f.edges)
+				pairs.insert(e.from + ">" + e.to);
+			for (const xr_string& k : pairs)
+				if (!f.result.count(k))
+				{
+					++remaining;
+					g_host->log.line("fixture-sweep unreached key=%s", k.c_str());
+				}
+			g_host->log.line("fixture-sweep done travels=%u ok=%u refused=%u failed=%u passages=%u covered=%u remaining=%u level=%s",
+				f.travels, f.ok, f.refused, f.failed, u32(pairs.size()), u32(f.result.size()), remaining, here.c_str());
+			f.phase = 999;
+			return;
+		}
+		g_host->log.line("fixture-sweep hop from=%s toward=%s changer=%s", here.c_str(), target.c_str(), hop.c_str());
+	}
+	f.via = pick->from + ">" + pick->to;
+	f.going_to = pick->to;
+	f.changer = pick->id;
+	f.changer_name = pick->changer;
+	f.sweeping = sweeping || !f.result.count(f.via);
+	f.reloads0 = tv.reloads;
+	f.failed0 = tv.exec_failed;
+	++f.travels;
+	const u16 reason = sweep_request(*links[0], *links[1], pick->id);
+	if (reason && reason != coop::proto::kReasonNoChanger && ++f.retries[pick->id] < 3)
+	{
+		// a passing refusal (busy, a travel being carried out): again in 10 s
+		g_host->log.line("fixture-sweep retry n=%u key=%s changer=%s reason=%u", f.travels, f.via.c_str(), pick->changer.c_str(),
+			u32(reason));
+		--f.travels;
+		f.since = g_host->tick; // the 5 s wait again
+		return;
+	}
+	if (reason)
+	{
+		// refused here (24: disabled; or three times): this changer is not tried
+		// again; the passage counts as refused unless another changer of it works
+		f.bad_changers.insert(pick->id);
+		++f.refused;
+		string32 r;
+		xr_sprintf(r, "refused-%u", u32(reason));
+		bool other = false;
+		for (const Host::SweepFixture::Edge& e : f.edges)
+			if (e.from == pick->from && e.to == pick->to && !f.bad_changers.count(e.id))
+				other = true;
+		if (!other)
+			f.result[f.via] = r;
+		g_host->log.line("fixture-sweep passage n=%u key=%s changer=%s result=%s other_changer=%d", f.travels, f.via.c_str(),
+			pick->changer.c_str(), r, other ? 1 : 0);
+		f.since = g_host->tick;
+		return;
+	}
+	g_host->log.line("fixture-sweep travel n=%u key=%s changer=%s sweeping=%d", f.travels, f.via.c_str(), pick->changer.c_str(),
+		f.sweeping ? 1 : 0);
+	f.phase = 2;
+	f.phase_tick = g_host->tick;
+}
