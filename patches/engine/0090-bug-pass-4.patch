+LPCSTR motion_name(IKinematicsAnimated* ka, const MotionID& id)
+{
+	if (!ka || !id.valid() || id.slot >= ka->LL_MotionsSlotCount())
+		return "?";
+	accel_map* names = const_cast<shared_motions&>(ka->LL_MotionsSlot(id.slot)).motion_map();
