+	if (f.phase == 6)
+	{
+		CEntityAlive* online = smart_cast<CEntityAlive*>(Level().Objects.net_Find(u16(target)));
+		const bool ready = online && online->g_Alive() && delivered(u16(target));
+		if (!ready && g_host->tick - f.phase_tick < 20 * 50)
+			return;
+		if (online && online->g_Alive())
+			online->KillEntity(actors[1]->ID(), TRUE);
+		g_host->log.line("fixture-task target-killed id=%d online=%d teleported=1 killer=%u waited_ticks=%I64u", target,
+			online ? 1 : 0, u32(actors[1]->ID()), g_host->tick - f.phase_tick);
