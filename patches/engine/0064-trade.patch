+u16 take_trade_open(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (!intent.params.empty())
+		return coop::proto::kReasonMalformed;
+	CActor* actor = nullptr;
+	if (!trade_context_actor(link, actor))
+		return coop::proto::kReasonNoActor;
+	const u16 npc_id = engine_id_of(intent.target);
+	if (npc_id == kNoEngineId || link.talk_npc != npc_id)
+	{
+		++g_host->trades_refused;
+		g_host->log.line("trade-refused slot=%u npc=%u why=not-talking talk=%u", u32(link.ref.slot), u32(npc_id),
+			u32(link.talk_npc));
+		return coop::proto::kReasonNotTalking;
+	}
+	CGameObject* npc = smart_cast<CGameObject*>(Level().Objects.net_Find(npc_id));
+	CInventoryOwner* trader = npc ? smart_cast<CInventoryOwner*>(npc) : nullptr;
+	CEntityAlive* alive = npc ? smart_cast<CEntityAlive*>(npc) : nullptr;
+	if (!trader || !alive || !alive->g_Alive() || !trader->IsTradeEnabled() || !trader->GetTrade())
+	{
+		++g_host->trades_refused;
+		g_host->log.line("trade-refused slot=%u npc=%u why=not-trading", u32(link.ref.slot), u32(npc_id));
+		return coop::proto::kReasonNotTrading;
+	}
+	if (link.trade_npc != npc_id)
+	{
+		trade_close(link, "reopened");
+		link.trade_npc = npc_id;
+		++g_host->trades_opened;
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "trade-start");
+			trader->StartTrading(); // as CUIActorMenu::InitTradeMode: the trader's own start (its AI, its callbacks)
+		}
+		trade_script_hooks(actor, npc, true);
+		g_host->log.line("trade-open slot=%u actor=%u npc=%u name=%s", u32(link.ref.slot), u32(actor->ID()), u32(npc_id),
+			trader->Name());
+	}
+	trade_send_prices(link, "open");
+	result.revision = g_host->commit;
+	return 0;
+}
