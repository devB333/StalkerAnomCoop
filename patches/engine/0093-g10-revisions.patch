+// --- S10-T07 (G10, T05b-4): the clicking player's purse -------------------------
+namespace
+{
+struct PartyPurse
+{
+	u16 anchor = 0xffff;
+	u16 payer = 0xffff;
+	bool share = false;
+};
+PartyPurse s_purse; // the innermost PartyPurseScope
+u32 s_purse_depth = 0;
+PartyPurse s_pending; // a pending turn-in's completion
+shared_str s_pending_task;
+u32 s_pending_depth = 0; // task scopes of that task entered now
+
+const PartyPurse* active_purse()
+{
+	if (!server_role())
+		return nullptr;
+	if (s_purse_depth)
+		return &s_purse;
+	if (s_pending_depth && s_pending.anchor != 0xffff)
+		return &s_pending;
+	return nullptr;
+}
+
+CInventoryOwner* owner_by_id(u16 id)
+{
+	CObject* o = g_pGameLevel && id != 0xffff ? Level().Objects.net_Find(id) : nullptr;
+	return o ? smart_cast<CInventoryOwner*>(o) : nullptr;
+}
+
+void add_money(CInventoryOwner* owner, int money)
+{
+	const u32 have = owner->get_money();
+	if (money >= 0)
+		owner->set_money(have + u32(money) < have ? u32(-1) : have + u32(money), true);
+	else
+		owner->set_money(u32(-money) > have ? 0 : have - u32(-money), true);
+}
+} // namespace
+
+PartyPurseScope::PartyPurseScope(u16 anchor, u16 payer, bool share_income)
+	: m_anchor(s_purse.anchor), m_payer(s_purse.payer), m_share(s_purse.share), m_depth(s_purse_depth)
+{
+	s_purse.anchor = anchor;
+	s_purse.payer = payer;
+	s_purse.share = share_income;
+	++s_purse_depth;
+}
+
+PartyPurseScope::~PartyPurseScope()
+{
+	s_purse.anchor = m_anchor;
+	s_purse.payer = m_payer;
+	s_purse.share = m_share;
+	s_purse_depth = m_depth;
+}
+
+void set_pending_party_purse(LPCSTR task, u16 anchor, u16 payer)
+{
+	if (!task || !task[0])
+	{
+		s_pending_task = nullptr;
+		s_pending = PartyPurse();
+		return;
+	}
+	s_pending_task = task;
+	s_pending.anchor = anchor;
+	s_pending.payer = payer;
+	s_pending.share = true;
+}
+
+LPCSTR pending_party_purse_task()
+{
+	return s_pending_task.size() ? s_pending_task.c_str() : "";
+}
+
+CInventoryOwner* party_purse_owner(CInventoryOwner* owner)
+{
+	const PartyPurse* p = active_purse();
+	if (!p || !owner || p->anchor == p->payer || owner->object_id() != p->anchor)
+		return owner;
+	CInventoryOwner* payer = owner_by_id(p->payer);
+	return payer ? payer : owner;
+}
+
+bool party_purse_money(CInventoryOwner* owner, u32& out)
+{
+	if (!owner || !server_role())
+		return false;
+	if (active_purse())
+	{
+		CInventoryOwner* purse = party_purse_owner(owner);
+		if (purse == owner)
+			return false;
+		out = purse->get_money();
+		return true;
+	}
+	if (!party_inventory_view() || !is_participant_actor(g_pGameLevel ? Level().Objects.net_Find(owner->object_id()) : nullptr))
+		return false;
+	xr_vector<CActor*> actors;
+	participant_actors(actors);
+	out = owner->get_money();
+	for (CActor* a : actors)
+		if (a)
+			out = _max(out, a->get_money());
+	return true;
+}
+
+bool party_purse_give(CInventoryOwner* owner, int money)
+{
+	const PartyPurse* p = active_purse();
+	if (!p || !owner || money == 0 || owner->object_id() != p->anchor)
+		return false;
+	if (money > 0 && p->share)
+	{
+		// T05b-2: money a turn-in gives is the same sum to every participant actor
+		xr_vector<CActor*> actors;
+		participant_actors(actors);
+		u32 paid = 0;
+		for (CActor* a : actors)
+			if (a)
+			{
+				add_money(a, money);
+				++paid;
+			}
+		Msg("coop party-purse shared %d RU to %u participant actors (anchor %u)", money, paid, u32(p->anchor));
+		return paid > 0;
+	}
+	CInventoryOwner* payer = party_purse_owner(owner);
+	if (payer == owner)
+		return false;
+	add_money(payer, money);
+	Msg("coop party-purse %d RU on %u instead of the anchor %u", money, u32(payer->object_id()), u32(p->anchor));
+	return true;
+}
