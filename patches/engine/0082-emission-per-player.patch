+// S10-T05a: an emission with the players in different places (decision
+// T01-11). Variant 0: player 1 is placed in the nearest emission cover
+// (misc\surge_manager.ltx [list]), player 2 stays out of it, the installed
+// surge starts; player 1 must live and player 2 die. Variant 1: player 1 is
+// placed 350+ m from player 2 and a psi-storm starts; each vortex must hit
+// only the player it came down near. compare-coop-emission.py.
+void emission_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.emission_party || !ai().get_alife())
+		return;
+	Host::EmissionFixture& f = g_host->emission_fixture;
+	if (f.phase >= 999)
+		return;
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && link.ref.slot < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				actors[link.ref.slot] = actor;
+				if (client_in_world(link))
+					++attached;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-emission both-attached tick=%I64u variant=%u", g_host->tick, config.emission_variant);
+	}
+	if (g_host->tick < f.both_since + u64(config.emission_party) * 50 || !actors[0] || !actors[1])
+		return;
+	CActor* p1 = actors[0];
+	CActor* p2 = actors[1];
+	double v[4] = {-9, -9, -9, -9};
+	string2048 chunk;
+	if (f.phase == 0)
+	{
+		const Fvector& a = p1->Position();
+		const Fvector& b = p2->Position();
+		if (config.emission_variant == 0)
+			xr_sprintf(chunk,
+				"local p1, p2 = vector():set(%f, %f, %f), vector():set(%f, %f, %f)\n"
+				"local ini = ini_file('misc\\\\surge_manager.ltx')\n"
+				"local bd, bp = 1e9, nil\n"
+				"for i = 0, ini:line_count('list') - 1 do local _, name = ini:r_line('list', i, '', '')\n"
+				"  local z = db.zone_by_name[name]\n"
+				"  if z then local vid = level.vertex_id(z:position())\n"
+				"    if vid and vid < 4294967295 then local vp = level.vertex_position(vid)\n"
+				"      if (z:inside(vp) or z:inside(vector():set(vp.x, vp.y + 0.5, vp.z))) and vp:distance_to(p2) > 40 then\n"
+				"        local d = vp:distance_to(p1) if d < bd then bd, bp = d, vp end end end end\n"
+				"end\n"
+				"if not bp then return -1, 0, 0, 0 end\n"
+				"return bd, bp.x, bp.y, bp.z\n",
+				a.x, a.y, a.z, b.x, b.y, b.z);
+		else
+			xr_sprintf(chunk,
+				"local p2 = vector():set(%f, %f, %f)\n"
+				"local a = level.object_by_id(0)\n"
+				// no hostile stalker or monster online within 80 m of the spot
+				"local function safe(vp)\n"
+				"  for id in pairs(db.storage) do local o = id ~= 0 and level.object_by_id(id)\n"
+				"    if o and (IsStalker(o) or IsMonster(o)) and o:alive() and o:position():distance_to(vp) < 80\n"
+				"      and a and o:relation(a) == game_object.enemy then return false end end\n"
+				"  return true\n"
+				"end\n"
+				"for r = 400, 800, 100 do for k = 0, 23 do local an = k * math.pi / 12\n"
+				"  local vid = level.vertex_id(vector():set(p2.x + r * math.cos(an), p2.y, p2.z + r * math.sin(an)))\n"
+				"  if vid and vid < 4294967295 then local vp = level.vertex_position(vid)\n"
+				"    if vp:distance_to(p2) >= 350 and safe(vp) then return vp:distance_to(p2), vp.x, vp.y, vp.z end end\n"
+				"end end\n"
+				"return -1, 0, 0, 0\n",
+				b.x, b.y, b.z);
+		if (alife_lua(chunk, v, 4, "emission-place") != 4 || v[0] < 0)
+		{
+			++f.failures;
+			g_host->log.line("fixture-emission done phase=no-place failures=%u", f.failures);
+			f.phase = 999;
+			return;
+		}
+		const Fvector at = {float(v[1]), float(v[2]) + 0.3f, float(v[3])};
+		place_beside(p1, at);
+		g_host->log.line("fixture-emission place variant=%u d=%.1f at=%.2f,%.2f,%.2f", config.emission_variant, v[0], VPUSH(at));
+		f.phase = 1;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		if (g_host->tick - f.phase_tick < 10 * 50)
+			return;
+		const int got = alife_lua("local S = rawget(_G, '__campaign_ctx')\n"
+			"if not (S and S.cover_of) then return -2, -2 end\n"
+			"return S.cover_of(0), S.cover_of(1)\n", v, 2, "emission-cover");
+		const int c1 = got == 2 ? int(v[0]) : -9, c2 = got == 2 ? int(v[1]) : -9;
+		const float d = p1->Position().distance_to(p2->Position());
+		const bool ok = config.emission_variant == 0 ? (c1 == 1 && c2 == 0) : d >= 350.f;
+		if (!ok)
+			++f.failures;
+		g_host->log.line("fixture-emission placed cover1=%d cover2=%d d_p1_p2=%.1f pass=%d", c1, c2, d, ok ? 1 : 0);
+		const bool started = call_lua(config.emission_variant == 0 ? "surge_manager.start_surge" : "psi_storm_manager.start_psi_storm");
+		g_host->log.line("fixture-emission started kind=%s called=%d", config.emission_variant == 0 ? "surge" : "psi", started ? 1 : 0);
+		f.phase = 2;
+		f.phase_tick = g_host->tick;
+		f.last_log = 0;
+		return;
+	}
+	if (f.phase == 2)
+	{
+		const u64 sec = (g_host->tick - f.phase_tick) / 50;
+		const bool finished = sec > 20 && alife_lua(config.emission_variant == 0 ?
+			"return surge_manager.is_finished() and 1 or 0\n" : "return psi_storm_manager.is_finished() and 1 or 0\n",
+			v, 1, "emission-finished") == 1 && v[0] == 1;
+		if (sec >= f.last_log + 5 || finished || sec > 330)
+		{
+			f.last_log = sec;
+			g_host->log.line("fixture-emission status sec=%I64u p1_alive=%d p1_health=%.3f p2_alive=%d p2_health=%.3f d_p1_p2=%.1f",
+				sec, p1->g_Alive() ? 1 : 0, p1->GetfHealth(), p2->g_Alive() ? 1 : 0, p2->GetfHealth(),
+				p1->Position().distance_to(p2->Position()));
+		}
+		if (!finished && sec <= 330)
+			return;
+		g_host->log.line("fixture-emission done variant=%u finished=%d p1_alive=%d p2_alive=%d failures=%u",
+			config.emission_variant, finished ? 1 : 0, p1->g_Alive() ? 1 : 0, p2->g_Alive() ? 1 : 0, f.failures);
+		f.phase = 999;
+	}
+}
