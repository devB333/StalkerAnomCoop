+		"total=%u inprogress=%u completed=%u active=%d tm_updates=%u state_updates=%u",
+		s.label, s.task_id, u32(s.giver_id), s.giver_se ? 1 : 0, s.giver_alive ? 1 : 0, s.giver_online ? 1 : 0,
+		s.giver_live ? 1 : 0, s.native_task ? 1 : 0, s.native_state, s.receive_time, s.native_total,
+		s.native_inprogress, s.native_completed, s.active_is_task ? 1 : 0, s.tm_updates, s.state_updates);
+	Msg("S02-T06e %s lua=%d status=%s stage=%d loaded=%d has_t=%d checked=%d giver=%d fetch=%s x%d in_inventory=%u | "
+		"money=%u goodwill_csky=%d info_tier1=%d talking actor=%d npc=%d used_npc=%d available=%u spawned=%u "
+		"actor_schedule_updates=%u",
+		s.label, s.lua_task ? 1 : 0, s.lua_status, s.lua_stage, s.lua_loaded ? 1 : 0, s.lua_has_t ? 1 : 0,
+		s.lua_checked ? 1 : 0, s.lua_giver_id, s.fetch_section, s.fetch_count, s.items_in_inventory, s.money,
+		s.goodwill_csky, s.info_tier1 ? 1 : 0, s.actor_talking ? 1 : 0, s.npc_talking ? 1 : 0,
+		s.used_npc_event ? 1 : 0, s.available_count, s.spawned_items, CActor::s_schedule_updates);
+}
