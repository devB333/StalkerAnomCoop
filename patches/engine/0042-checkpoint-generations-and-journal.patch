+CoopPersistence::CoopPersistence(const std::string& directory, const coop::proto::Uuid128& campaign,
+	const coop::proto::Uuid128& party, CoopEventLog* log)
+	: m_store(directory, campaign), m_campaign(campaign), m_party(party), m_log(log)
+{
+	m_worker = std::thread([this] { worker_main(); });
+}
