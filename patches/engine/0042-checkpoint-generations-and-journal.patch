+CoopPersistence::~CoopPersistence()
+{
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_stop_worker = true;
+	}
+	m_wake.notify_all();
+	if (m_worker.joinable())
+		m_worker.join();
+	m_journal.close();
+}
