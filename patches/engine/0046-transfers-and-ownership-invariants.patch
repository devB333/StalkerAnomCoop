+			continue;
+		++parented;
+		const CSE_Abstract* parent = ai().alife().objects().object(e->ID_Parent, true);
+		if (!parent)
+			parent = Level().Server->ID_to_entity(e->ID_Parent);
+		if (!parent)
+		{
+			++missing_parent;
+			g_host->log.line("ownership-bad tag=%s what=missing-parent id=%u parent=%u", tag, u32(o.first),
+				u32(e->ID_Parent));
