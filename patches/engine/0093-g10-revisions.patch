+// S10-T07 (G10, T03a-2): the parked participant actors (at most one per slot)
+static xr_vector<u16> s_parked;
+
+void set_participant_parked(u16 actor_id, bool parked)
+{
+	xr_vector<u16>::iterator it = std::find(s_parked.begin(), s_parked.end(), actor_id);
+	if (parked && it == s_parked.end())
+		s_parked.push_back(actor_id);
+	else if (!parked && it != s_parked.end())
+		s_parked.erase(it);
+}
+
+bool participant_parked_id(u16 actor_id)
+{
+	return !s_parked.empty() && std::find(s_parked.begin(), s_parked.end(), actor_id) != s_parked.end();
+}
+
+u32 active_participant_actors(xr_vector<CActor*>& out)
+{
+	participant_actors(out);
+	if (!s_parked.empty())
+		out.erase(std::remove_if(out.begin(), out.end(),
+			[](CActor* a) { return !a || participant_parked_id(u16(a->ID())); }), out.end());
+	return u32(out.size());
+}
