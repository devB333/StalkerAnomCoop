+u16 take_trade(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	CoopPersistence* persistence = g_host->persistence;
+	// 1. Receive: a known operation returns its stored outcome.
+	StoredOutcome stored;
+	if (persistence && persistence->lookup(link.player, intent.operation_id, stored))
+	{
+		result.outcome = coop::proto::ActionOutcome(stored.outcome);
+		result.reason = stored.reason;
+		result.commit_id = stored.revision;
+		result.revision = stored.revision;
+		g_host->log.line("trade-duplicate player=%s operation=%I64u outcome=%u revision=%I64u",
+			coop_uuid_hex(link.player).c_str(), intent.operation_id, u32(stored.outcome), stored.revision);
+		return stored.reason;
+	}
+	// 2. Prepare / validate.
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	CActor* actor = nullptr;
+	if (!trade_context_actor(link, actor))
+		return coop::proto::kReasonNoActor;
+	const u16 npc_id = engine_id_of(intent.target);
+	CGameObject* npc = nullptr;
+	CInventoryOwner* trader = trade_partner(link, &npc);
+	CInventoryOwner* me = smart_cast<CInventoryOwner*>(actor);
+	if (npc_id == kNoEngineId || link.trade_npc != npc_id || !trader || !me || !trader->GetTrade())
+	{
+		++g_host->trades_refused;
+		g_host->log.line("trade-refused slot=%u npc=%u why=no-open-trade trade=%u", u32(link.ref.slot), u32(npc_id),
+			u32(link.trade_npc));
+		return coop::proto::kReasonNotTrading;
+	}
+	if (intent.params.size() < 2)
+		return coop::proto::kReasonMalformed;
+	const u32 nbuy = intent.params[0], nsell = intent.params[1];
+	if (nbuy + nsell == 0 || nbuy + nsell > 32 || intent.params.size() != 2 + 12 * (nbuy + nsell) + 4)
+		return coop::proto::kReasonMalformed;
+	struct Line
+	{
+		bool bought;
+		coop::proto::EntityRef ref;
+		u16 id;
+		CInventoryItem* item;
+		CSE_Abstract* se;
+		u32 price;
+	};
+	xr_vector<Line> lines;
+	for (u32 i = 0; i < nbuy + nsell; ++i)
+	{
+		Line l;
+		l.bought = i < nbuy;
+		if (!read_ref(intent.params, 2 + 12 * i, l.ref))
+			return coop::proto::kReasonMalformed;
+		l.id = engine_id_of(l.ref);
+		CObject* object = l.id != kNoEngineId ? Level().Objects.net_Find(l.id) : nullptr;
+		l.se = l.id != kNoEngineId ? Level().Server->ID_to_entity(l.id) : nullptr;
+		l.item = object ? smart_cast<CInventoryItem*>(object) : nullptr;
+		if (!l.item || !l.se || object->getDestroy())
+			return coop::proto::kReasonItemGone;
+		const u16 expected_parent = l.bought ? npc_id : actor->ID();
+		if (l.se->ID_Parent != expected_parent || object->H_Parent() != (l.bought ? npc : static_cast<CGameObject*>(actor)))
+		{
+			++g_host->trades_refused;
+			g_host->log.line("trade-refused slot=%u npc=%u why=item-moved item=%u parent=%u expected=%u", u32(link.ref.slot),
+				u32(npc_id), u32(l.id), u32(l.se->ID_Parent), u32(expected_parent));
+			return coop::proto::kReasonTradeRefused;
+		}
+		if (!l.bought && (l.item->IsQuestItem() || !l.item->CanTrade()))
+		{
+			++g_host->trades_refused;
+			g_host->log.line("trade-refused slot=%u npc=%u why=not-tradeable item=%u section=%s", u32(link.ref.slot),
+				u32(npc_id), u32(l.id), *object->cNameSect());
+			return coop::proto::kReasonTradeRefused;
+		}
+		l.price = 0;
+		lines.push_back(l);
+	}
+	u32 pay = 0, get = 0;
+	CTrade* trade = trader->GetTrade();
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "trade-price");
+		trade->StartTradeEx(me);
+		for (Line& l : lines)
+		{
+			l.price = trade->GetItemPrice(l.item, !l.bought, false);
+			if (!l.price)
+			{
+				++g_host->trades_refused;
+				g_host->log.line("trade-refused slot=%u npc=%u why=unpriced item=%u section=%s bought=%d", u32(link.ref.slot),
+					u32(npc_id), u32(l.id), *l.item->object().cNameSect(), l.bought ? 1 : 0);
+				return coop::proto::kReasonTradeRefused;
+			}
+			(l.bought ? pay : get) += l.price;
+		}
+	}
+	const u32 money = actor->get_money();
+	if (money + get < pay)
