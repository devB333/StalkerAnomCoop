+// B64: the party's tasks go out in as many events as their entries need
+// (u8 count, then whole entries), each inside kMaxEventPayload: one list
+// over it was refused by the encoder and blocked the lifecycle outbox. An
+// entry too long alone loses its description (a client keeps the one it has).
+struct PartyTaskChunks
+{
+	std::vector<std::vector<u8>> events;
+	u32 entries = 0, trimmed = 0, skipped = 0;
+	void add(LPCSTR id, u8 state, s32 count, s32 need)
+	{
+		const u32 limit = u32(coop::proto::kMaxEventPayload) - 1; // the count byte
+		std::vector<u8> entry;
+		put_party_task(entry, id, state, count, need);
+		if (entry.size() > limit)
+		{
+			entry.clear();
+			put_party_task(entry, id, state, count, need, 0);
+			++trimmed;
+		}
+		if (entry.size() > limit)
+		{
+			++skipped;
+			g_host->log.line("party-task-oversize id=%s bytes=%u", id, u32(entry.size()));
+			return;
+		}
+		if (events.empty() || events.back().size() + entry.size() > limit + 1 || events.back()[0] == 255)
+			events.push_back(std::vector<u8>(1, u8(0)));
+		std::vector<u8>& e = events.back();
+		e.insert(e.end(), entry.begin(), entry.end());
+		++e[0];
+		++entries;
+	}
+};
