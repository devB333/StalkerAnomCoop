+// ------------------------------------------------------------ S10-T02e
+// The fauna fixture (profile fauna_party, server-driven): p1 moved about 120 m
+// away (p1 only, L58); each generic mutant class spawned in turn 4 m in front
+// of p2, for up to 40 s: the stage passes once the monster's enemy is p2 and p2
+// has taken a hit (p2's health is held at 1 every tick, so a drop below 1 seen
+// before the reset is that monster's hit); p1 must never be its enemy. The
+// monster is killed when its stage ends. compare-coop-fauna.py checks the lines.
+void fauna_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.fauna_party || !ai().get_alife())
+		return;
+	Host::FaunaFixture& f = g_host->fauna_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u8 slots[2] = {0, 0};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				slots[attached] = link.ref.slot;
+				actors[attached++] = actor;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-fauna both-attached tick=%I64u", g_host->tick);
+	}
+	if (attached < 2 || f.phase >= 999 || g_host->tick < f.both_since + u64(config.fauna_party) * 50)
+		return;
+	if (slots[0] != 0)
+		std::swap(actors[0], actors[1]);
+	CActor* p2 = actors[1];
+	static LPCSTR const sections[] = {"boar_normal", "dog_normal", "flesh_normal", "pseudodog_normal", "psy_dog", "cat_normal_a",
+		"chimera_normal", "fracture_normal", "gigant_normal", "zombie_normal", "snork_normal", "tushkano_normal", "rat_normal"};
+	const u32 count = u32(sizeof(sections) / sizeof(sections[0]));
+	if (p2->g_Alive() && p2->GetfHealth() < 1.f)
+	{
+		// the stage's monster hit p2 only when p2's last hitter is that monster
+		if (f.monster != 0xffff && p2->coop_last_hitter() == f.monster)
+			f.hit_p2 = true;
+		else if (f.monster != 0xffff)
+		{
+			++f.other_hits;
+			f.other_hitter = p2->coop_last_hitter();
+		}
+		p2->SetfHealth(1.f);
+		p2->conditions().ClearWounds(); // no bleeding between hits: each drop is a fresh hit
+	}
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	if (f.phase == 0)
+	{
+		const campaign::ServerLightingStats& light0 = campaign::server_lighting_stats();
+		f.light_frames = light0.frames;
+		f.light_tracks = light0.actor_tracks;
+		f.light_picks = light0.view_picks;
+		Fvector away;
+		away.sub(actors[0]->Position(), p2->Position());
+		away.y = 0.f;
+		if (away.square_magnitude() < 0.01f)
+			away.set(1.f, 0.f, 0.f);
+		away.normalize();
+		place_beside(actors[0], Fvector().mad(p2->Position(), away, 120.f));
+		g_host->log.line("fixture-fauna p1-away distance=%.1f", actors[0]->Position().distance_to(p2->Position()));
+		f.phase = 1;
+		return;
+	}
+	const u32 stage = (f.phase - 1) / 2, step = (f.phase - 1) % 2;
+	if (stage >= count)
+	{
+		const campaign::ServerLightingStats& light = campaign::server_lighting_stats();
+		g_host->log.line("fixture-fauna done phase=classes failures=%u passed=%u of=%u", f.failures, f.passed, count);
+		// S03-T06's per-participant lighting while the fixture ran (L13): both slots' views picked every frame
+		g_host->log.line("fixture-fauna lighting frames=%I64u actor_tracks=%I64u view_picks=%I64u view_tracks=%I64u "
+			"view_count0=%u view_count1=%u view_object0=%u view_object1=%u", light.frames - f.light_frames,
+			light.actor_tracks - f.light_tracks, light.view_picks - f.light_picks, light.view_tracks,light.last_view_count[0], light.last_view_count[1], u32(light.last_view_object[0]),
+			u32(light.last_view_object[1]));
+		f.phase = 999;
+		return;
+	}
+	if (step == 0)
+	{
+		Fvector forward;
+		forward.setHP(p2->XFORM().k.getH(), 0.f);
+		f.monster = spawn_at(alife, sections[stage], Fvector().mad(p2->Position(), forward, 4.f), u16(p2->ID()));
+		f.enemy_p1 = f.enemy_p2 = f.hit_p2 = false;
+		f.other_hits = 0;
+		f.other_hitter = 0xffff;
+		f.phantoms = 0;
+		f.phantom_tick = 0;
+		f.phase_tick = g_host->tick;
+		g_host->log.line("fixture-fauna spawned stage=%u section=%s monster=%u", stage, sections[stage], u32(f.monster));
+		++f.phase;
+		return;
+	}
+	CBaseMonster* monster = f.monster != 0xffff ? smart_cast<CBaseMonster*>(Level().Objects.net_Find(f.monster)) : nullptr;
+	if (monster && monster->g_Alive())
+	{
+		const CEntityAlive* enemy = monster->EnemyMan.get_enemy();
+		if (enemy == p2)
+			f.enemy_p2 = true;
+		else if (enemy == actors[0])
+			f.enemy_p1 = true;
+	}
+	// the psy dog's stage also waits for its phantoms (they reach the clients), then 8 s, up to the stage's time
+	bool phantoms_shown = true;
+	if (CPsyDog* dog = smart_cast<CPsyDog*>(monster))
+	{
+		if (dog->g_Alive() && dog->get_phantoms_count() > f.phantoms)
+		{
+			f.phantoms = dog->get_phantoms_count();
+			if (!f.phantom_tick)
+				f.phantom_tick = g_host->tick;
+		}
+		phantoms_shown = f.phantom_tick && g_host->tick - f.phantom_tick >= 8 * 50;
+	}
+	// the pseudogigant's stage also waits for its threaten (the stomp), up to the stage's time
+	const bool gigant = !xr_strcmp(sections[stage], "gigant_normal");
+	const bool threatened = g_host->monster_abilities.count("threaten") && g_host->monster_abilities["threaten"].second;
+	const bool done = f.enemy_p2 && f.hit_p2 && (!gigant || threatened) && phantoms_shown;
+	if (!done && g_host->tick - f.phase_tick < 40 * 50)
+		return;
+	const float distance = monster ? monster->Position().distance_to(p2->Position()) : -1.f;
+	if (monster && monster->g_Alive())
+		monster->KillEntity(u16(p2->ID()));
+	const bool pass= f.enemy_p2 && f.hit_p2 && !f.enemy_p1;
+	g_host->log.line("fixture-fauna stage-done stage=%u section=%s monster=%u online=%d enemy_p2=%d hit_p2=%d enemy_p1=%d pass=%d "
+		"seconds=%.1f other_hits=%u other_hitter=%u distance=%.1f phantoms=%u", stage,sections[stage], u32(f.monster), monster ? 1 : 0,
+		f.enemy_p2 ? 1 : 0, f.hit_p2 ? 1 : 0, f.enemy_p1 ? 1 : 0, pass ? 1 : 0, float(g_host->tick - f.phase_tick) / 50.f,
+		f.other_hits, u32(f.other_hitter), distance, f.phantoms);
+	if (pass)
+		++f.passed;
+	else
+		++f.failures;
+	f.monster = 0xffff;
+	++f.phase;
+}
+
 // ------------------------------------------------------------ S10-T05b
 // The general party-task fixture (profile task_party; a server kill and
 // restart between its two halves, -ServerKill / -ServerRestartAfter):
@@ -15554,6 +15711,8 @@ extern "C" void __cdecl xrCoopServer_Tick(u64 tick)
 	loot_fixtures(); // S10-T02b
 	psy_fixtures(); // S10-T02c
 	mutant_fixtures(); // S10-T02d
+	fauna_fixtures(); // S10-T02e
+
 
 	demo_place_tick(); // the hands-on aid
 	travel_tick(); // S09-T01: the proposal's deadline and the world's conditions
