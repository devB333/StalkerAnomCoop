+	Link::Talk& t = g_link->talk;
+	if (!t.open)
+		return; // the server's close, or the driver's end: already told
+	t.open = false;
+	t.path = 0;
+	++t.ends;
+	request_ownership(coop::proto::kActionTalkEnd, t.npc_ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, true, "player");
+	g_link->log.line("talk-end-sent npc=%u after_ms=%u", u32(t.npc), g_link->wall.GetElapsed_ms() - t.opened_ms);
+}
