+// Every online, unparented, replicated entity that moves, with its state now.
+void collect_candidates(xr_vector<Candidate>& out)
+{
+	out.clear();
+	xr_map<u16, Motion> motion;
+	xr_map<u16, Gait> gait;
+	for (const auto& p : g_host->published)
+	{
+		CObject* object = Level().Objects.net_Find(p.first);
+		if (!object || object->getDestroy() || object->H_Parent())
+			continue;
+		Candidate c;
+		c.id = p.first;
+		c.commit = p.second.commit;
+		c.state.entity = p.second.ref;
+		c.moving = true;
+		c.position = object->Position();
+		if (CActor* actor = smart_cast<CActor*>(object))
+		{
+			coop::proto::EntityRef ref = c.state.entity;
+			if (!actor_state(actor, c.state) || !(c.state.entity == ref))
+				continue;
+			c.kind = KindParticipant;
+		}
+		else if (CEntity* creature = smart_cast<CEntity*>(object))
+		{
+			if (!creature_state(creature, c.state))
+				continue;
+			c.kind = KindCreature;
+			const Fvector& now = creature->Position();
+			const auto known = g_host->gait.find(p.first);
+			Gait g;
+			if (known == g_host->gait.end())
+			{
+				g.position = now;
+				g.velocity.set(0, 0, 0);
+				g.changed_tick = g_host->tick;
+				g.interval = 0;
+			}
+			else
+			{
+				g = known->second;
+				const u64 since = g_host->tick - g.changed_tick;
+				if (now.distance_to(g.position) > 0.001f && since > 0)
+				{
+					g.velocity.sub(now, g.position);
+					g.velocity.mul(1.f / (float(since) * 0.02f));
+					if (g.velocity.magnitude() > 30.f) // a jump, not a walk
+						g.velocity.set(0, 0, 0);
+					g.position = now;
+					g.interval = since;
+					g.changed_tick = g_host->tick;
+				}
+				else if (since > _max<u64>(g.interval * 3 / 2, 25))
+					g.velocity.set(0, 0, 0);
+			}
+			gait[p.first] = g;
+			c.state.components |= coop::proto::kVelocity;
+			c.state.vx = g.velocity.x;
+			c.state.vy = g.velocity.y;
+			c.state.vz = g.velocity.z;
+		}
+		else if (CPhysicsShellHolder* holder = smart_cast<CPhysicsShellHolder*>(object))
+		{
+			if (!holder->PPhysicsShell())
+				continue;
+			Fquaternion q;
+			if (!object_state(holder, c.state, q))
+				continue;
+			c.kind = KindObject;
+			Motion m;
+			m.position = object->Position();
+			m.rotation = q;
+			m.moved_tick = g_host->tick;
+			const auto known = g_host->motion.find(p.first);
+			if (known != g_host->motion.end())
+			{
+				const Motion& was = known->second;
+				const bool moved = was.position.distance_to(m.position) > 0.001f || _abs(was.rotation.x - q.x) > 0.0002f ||
+					_abs(was.rotation.y - q.y) > 0.0002f || _abs(was.rotation.z - q.z) > 0.0002f ||
+					_abs(was.rotation.w - q.w) > 0.0002f;
+				if (!moved)
+					m = was;
+			}
+			motion[p.first] = m;
+			c.moving = g_host->tick - m.moved_tick < kRestTicks;
+		}
+		else
+			continue;
+		out.push_back(c);
+	}
+	g_host->motion.swap(motion);
+	g_host->gait.swap(gait);
+}
