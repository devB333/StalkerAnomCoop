+// ------------------------------------------------------------ S11-T00
+// The host and join menu (Stage 11 by the user's direction, 2026-11-02). A client started without -coop-config is single
+// player as installed, unless the app data holds coop-menu.ltx (written by
+// the co-op setup): then New game asks Single player / Host / Join.
+//   [coop_menu]
+//   name = <display name>          key = <the player's key file: made on first use>
+//   client_log, client_stop        (this client's co-op log and stop file)
+//   server_exe, server_launcher, server_runtime   (optional: Host is offered with them)
+// Join writes this client's profile (campaign_id = any, the host's address
+// and join code) and starts the link as -coop-config would. Host makes sure
+// the player's key is in the server's roster, writes a fresh join code and
+// the host's choice (a new campaign's creation choices, or "continue the
+// last campaign") into the server's app data, starts the server's launcher
+// (tools/Start-CoopServer.ps1, which also relaunches it on a campaign switch)
+// and joins it at 127.0.0.1 as its owner. Quitting the host's client stops the
+// server (its stop file).
+struct MenuSettings
+{
+	bool loaded = false;
+	string64 name = "";
+	string_path key = "", client_log = "", client_stop = "", client_profile = "";
+	string_path server_exe = "", server_launcher = "", server_runtime = "";
+	string_path server_profile = "", server_fsgame = "", server_appdata = "", server_roster = "", server_stop = "";
+	u32 port = 27515;
+	// the test driver: test = host_new | host_continue | join, test_delay (s after the menu is installed),
+	// test_info (join: the host client's coop-host-info.txt)
+	string32 test = "";
+	u32 test_delay = 5;
+	string_path test_info = "";
+};
+static MenuSettings s_menu;
+static bool s_menu_hosting = false;
+static xr_string s_menu_reply; // the last menu call's answer to Lua ("ok|..." or "error|why")
+static xr_string s_menu_address, s_menu_code; // what the host gives its friend
+
+static bool menu_read_file(LPCSTR path, xr_string& out)
+{
+	out.clear();
+	FILE* f = fopen(path, "rb");
+	if (!f)
+		return false;
+	char buf[4096];
+	size_t n;
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+		out.append(buf, n);
+	fclose(f);
+	return true;
+}
+
+static bool menu_write_file(LPCSTR path, const xr_string& text)
+{
+	FILE* f = fopen(path, "wb");
+	if (!f)
+		return false;
+	const bool ok = fwrite(text.data(), 1, text.size(), f) == text.size();
+	return fclose(f) == 0 && ok;
+}
+
+// "key = value" in [section] of a small text file (the menu's settings, the server's profile, the host's info)
+static bool menu_ini_value(LPCSTR path, LPCSTR section, LPCSTR key, LPSTR out, u32 size)
+{
+	out[0] = 0;
+	xr_string text;
+	if (!menu_read_file(path, text))
+		return false;
+	auto trim = [](xr_string v) {
+		while (!v.empty() && (v.back() == ' ' || v.back() == '\t' || v.back() == '\r'))
+			v.pop_back();
+		size_t a = 0;
+		while (a < v.size() && (v[a] == ' ' || v[a] == '\t'))
+			++a;
+		return v.substr(a);
+	};
+	bool in = false;
+	size_t at = 0;
+	while (at < text.size())
+	{
+		size_t end = text.find('\n', at);
+		if (end == xr_string::npos)
+			end = text.size();
+		const xr_string line = trim(text.substr(at, end - at));
+		at = end + 1;
+		if (line.empty() || line[0] == ';' || line[0] == '#')
+			continue;
+		if (line[0] == '[')
+		{
+			in = line == xr_string("[") + section + "]";
+			continue;
+		}
+		const size_t eq = line.find('=');
+		if (in && eq != xr_string::npos && trim(line.substr(0, eq)) == key)
+		{
+			xr_strcpy(out, size, trim(line.substr(eq + 1)).c_str());
+			return out[0] != 0;
+		}
+	}
+	return false;
+}
+
+static bool menu_settings_load()
+{
+	string_path path;
+	FS.update_path(path, "$app_data_root$", "coop-menu.ltx");
+	if (GetFileAttributesA(path) == INVALID_FILE_ATTRIBUTES)
+		return s_menu.loaded = false;
+	MenuSettings m;
+	bool ok = menu_ini_value(path, "coop_menu", "name", m.name, sizeof(m.name)) &&
+		menu_ini_value(path, "coop_menu", "key", m.key, sizeof(m.key)) &&
+		menu_ini_value(path, "coop_menu", "client_log", m.client_log, sizeof(m.client_log)) &&
+		menu_ini_value(path, "coop_menu", "client_stop", m.client_stop, sizeof(m.client_stop));
+	FS.update_path(m.client_profile, "$app_data_root$", "coop-menu-client.ltx");
+	menu_ini_value(path, "coop_menu", "test", m.test, sizeof(m.test));
+	menu_ini_value(path, "coop_menu", "test_info", m.test_info, sizeof(m.test_info));
+	string16 delay;
+	if (menu_ini_value(path, "coop_menu", "test_delay", delay, sizeof(delay)))
+		m.test_delay = u32(_max(0, atoi(delay)));
+	if (menu_ini_value(path, "coop_menu", "server_runtime", m.server_runtime, sizeof(m.server_runtime)) &&
+		menu_ini_value(path, "coop_menu", "server_exe", m.server_exe, sizeof(m.server_exe)) &&
+		menu_ini_value(path, "coop_menu", "server_launcher", m.server_launcher, sizeof(m.server_launcher)))
+	{
+		xr_sprintf(m.server_profile, "%s\\coop.ltx", m.server_runtime);
+		xr_sprintf(m.server_fsgame, "%s\\fsgame.ltx", m.server_runtime);
+		xr_sprintf(m.server_appdata, "%s\\appdata", m.server_runtime);
+		string64 listen;
+		if (!menu_ini_value(m.server_profile, "coop", "roster", m.server_roster, sizeof(m.server_roster)) ||
+			!menu_ini_value(m.server_profile, "coop", "stop_file", m.server_stop, sizeof(m.server_stop)) ||
+			!menu_ini_value(m.server_profile, "coop", "listen", listen, sizeof(listen)))
+		{
+			Msg("! S11-T00 co-op menu: the server's profile %s has no roster, stop_file or listen: no hosting",
+				m.server_profile);
+			m.server_runtime[0] = 0; // no hosting: the server's profile is not readable
+		}
+		else if (LPCSTR colon = strrchr(listen, ':'))
+			m.port = u32(_max(1, _min(65535, atoi(colon + 1))));
+	}
+	else
+	{
+		if (m.server_runtime[0])
+			Msg("! S11-T00 co-op menu: server_runtime without server_exe or server_launcher: no hosting");
+		m.server_runtime[0] = 0;
+	}
+	m.loaded = ok;
+	s_menu = m;
+	Msg("S11-T00 co-op menu settings %s: %s (host %s)", path, ok ? "ok" : "incomplete", m.server_runtime[0] ? "yes" : "no");
+	FlushLog();
+	return ok;
+}
+
+// The player's key, made (DPAPI, this Windows user) on first use.
+static bool menu_key(coop::proto::Uuid128& player, coop::session::PublicKey& pub, xr_string& why)
+{
+	coop::session::PrivateKey key;
+	std::string error;
+	if (GetFileAttributesA(s_menu.key) == INVALID_FILE_ATTRIBUTES)
+	{
+		player = coop::session::random_uuid();
+		if (!coop::session::generate_key(key, pub) || !coop::session::save_key_file(s_menu.key, player, key, &error))
+		{
+			why = "your player key could not be made: " + xr_string(error.c_str());
+			return false;
+		}
+		Msg("S11-T00 co-op menu: a new player key %s", s_menu.key);
+		return true;
+	}
+	if (!coop::session::load_key_file(s_menu.key, player, key, pub, &error))
+	{
+		why = "your player key could not be read: " + xr_string(error.c_str());
+		return false;
+	}
+	return true;
+}
+
+// The address a friend reaches this PC at: the Tailscale one (100.64.0.0/10) if
+// any, else the first other IPv4 address of an adapter that is up.
+#pragma comment(lib, "iphlpapi.lib")
+static xr_string menu_local_address()
+{
+	ULONG size = 0;
+	GetAdaptersInfo(nullptr, &size);
+	xr_vector<u8> buf(size ? size : sizeof(IP_ADAPTER_INFO));
+	PIP_ADAPTER_INFO info = reinterpret_cast<PIP_ADAPTER_INFO>(buf.data());
+	if (GetAdaptersInfo(info, &size) != NO_ERROR)
+		return xr_string();
+	xr_string tailscale, other;
+	for (PIP_ADAPTER_INFO a = info; a; a = a->Next)
+		for (PIP_ADDR_STRING ip = &a->IpAddressList; ip; ip = ip->Next)
+		{
+			const char* s = ip->IpAddress.String;
+			unsigned b0 = 0, b1 = 0;
+			if (sscanf(s, "%u.%u", &b0, &b1) != 2 || b0 == 0 || b0 == 127 || (b0 == 169 && b1 == 254))
+				continue;
+			if (b0 == 100 && b1 >= 64 && b1 <= 127 && tailscale.empty())
+				tailscale = s;
+			else if (other.empty())
+				other = s;
+		}
+	return tailscale.empty() ? other : tailscale;
+}
+
+void coop_client_start_from(LPCSTR path); // below: the link from a client profile
+
+static bool menu_write_client_profile(LPCSTR server, LPCSTR code)
+{
+	// values quoted: CInifile drops spaces outside quotes (a kit under a folder with spaces, a name with spaces)
+	xr_string text = "[coop]\nrole = client\ncampaign_id = any\n";
+	text += xr_string("server = ") + server + "\n";
+	text += xr_string("key = \"") + s_menu.key + "\"\n";
+	text += xr_string("name = \"") + s_menu.name + "\"\n";
+	text += xr_string("log = \"") + s_menu.client_log + "\"\n";
+	text += xr_string("stop_file = \"") + s_menu.client_stop + "\"\n";
+	if (code && code[0])
+		text += xr_string("join_code = ") + code + "\n";
+	return menu_write_file(s_menu.client_profile, text);
+}
+
+bool coop_menu_available()
+{
+	return (!g_link || !g_link->active) && (s_menu.loaded || menu_settings_load()) && !g_pGameLevel;
+}
+
+bool coop_menu_can_host()
+{
+	return coop_menu_available() && s_menu.server_runtime[0] != 0;
+}
+
+LPCSTR coop_menu_join(LPCSTR address, LPCSTR code)
+{
+	s_menu_reply = "error|";
+	if (!coop_menu_available())
+		return (s_menu_reply += "co-op is not available now").c_str();
+	xr_string addr = address ? address : "";
+	while (!addr.empty() && (addr.back() == ' ' || addr.back() == '\t'))
+		addr.pop_back();
+	while (!addr.empty() && (addr.front() == ' ' || addr.front() == '\t'))
+		addr.erase(addr.begin());
+	if (addr.empty() || addr.size() > 60)
+		return (s_menu_reply += "type the host's address (for example 100.101.102.103)").c_str();
+	if (addr.find(':') == xr_string::npos)
+	{
+		string16 port;
+		xr_sprintf(port, ":%u", s_menu.port);
+		addr += port;
+	}
+	std::string norm;
+	if (!coop::session::normalize_join_code(code ? code : "", norm))
+		return (s_menu_reply += "the join code is 10 letters and digits, like ABCDE-23456").c_str();
+	coop::proto::Uuid128 player;
+	coop::session::PublicKey pub;
+	xr_string why;
+	if (!menu_key(player, pub, why))
+		return (s_menu_reply += why).c_str();
+	if (!menu_write_client_profile(addr.c_str(), norm.c_str()))
+		return (s_menu_reply += "the co-op profile could not be written").c_str();
+	Msg("S11-T00 co-op menu: join %s", addr.c_str());
+	coop_client_start_from(s_menu.client_profile);
+	if (!g_link || !g_link->active)
+		return (s_menu_reply += "the co-op link could not start (see the log)").c_str();
+	s_menu_reply = "ok|" + addr;
+	return s_menu_reply.c_str();
+}
+
+// mode 1: a new campaign with the creation screen's choices ("key=value" lines); 2: continue the last campaign
+LPCSTR coop_menu_host(int mode, LPCSTR choices)
+{
+	s_menu_reply = "error|";
+	if (!coop_menu_can_host())
+		return (s_menu_reply += "hosting is not set up on this PC").c_str();
+	if (mode != 1 && mode != 2)
+		return (s_menu_reply += "unknown host mode").c_str();
+	coop::proto::Uuid128 player;
+	coop::session::PublicKey pub;
+	xr_string why;
+	if (!menu_key(player, pub, why))
+		return (s_menu_reply += why).c_str();
+	// the host's own key in the server's roster (the friends the join code let in stay)
+	xr_string roster;
+	menu_read_file(s_menu.server_roster, roster);
+	const xr_string id = coop::session::uuid_hex(player).c_str();
+	if (roster.find(id) == xr_string::npos)
+	{
+		coop::session::RosterEntry e;
+		e.player_id = player;
+		e.key = pub;
+		e.display_name = s_menu.name;
+		if (!roster.empty() && roster.back() != '\n')
+			roster += "\n";
+		roster += coop::session::Roster::line(e).c_str();
+		roster += "\n";
+		if (!menu_write_file(s_menu.server_roster, roster))
+			return (s_menu_reply += "the server's roster could not be written").c_str();
+	}
+	const std::string code = coop::session::make_join_code();
+	string_path file;
+	xr_sprintf(file, "%s\\coop-join-code.txt", s_menu.server_appdata);
+	if (code.empty() || !menu_write_file(file, code.c_str()))
+		return (s_menu_reply += "the join code could not be written").c_str();
+	xr_sprintf(file, "%s\\%s", s_menu.server_appdata, mode == 1 ? "coop-create.ltx" : "coop-continue.txt");
+	if (!menu_write_file(file, mode == 1 ? xr_string(choices ? choices : "") : xr_string("1")))
+		return (s_menu_reply += "the host's choice could not be written").c_str();
+	DeleteFileA(s_menu.server_stop); // a stop left from the last session
+	string4096 command;
+	xr_sprintf(command, "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden "
+		"-File \"%s\" -Runtime \"%s\" -Fsgame \"%s\" -Profile \"%s\" -Exe \"%s\"", s_menu.server_launcher,
+		s_menu.server_runtime, s_menu.server_fsgame, s_menu.server_profile, s_menu.server_exe);
+	STARTUPINFOA si = {};
+	si.cb = sizeof(si);
+	PROCESS_INFORMATION pi = {};
+	if (!CreateProcessA(nullptr, command, nullptr, nullptr, FALSE, CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP, nullptr,
+			s_menu.server_runtime, &si, &pi))
+	{
+		Msg("! S11-T00 co-op menu: the server's launcher did not start (error %u)", u32(GetLastError()));
+		return (s_menu_reply += "the server could not be started").c_str();
+	}
+	Msg("S11-T00 co-op menu: the server's launcher started (pid %u)", u32(pi.dwProcessId));
+	CloseHandle(pi.hThread);
+	CloseHandle(pi.hProcess);
+	s_menu_hosting = true;
+	string32 local;
+	xr_sprintf(local, "127.0.0.1:%u", s_menu.port);
+	if (!menu_write_client_profile(local, nullptr))
+		return (s_menu_reply += "the co-op profile could not be written").c_str();
+	coop_client_start_from(s_menu.client_profile);
+	const xr_string here = menu_local_address();
+	string64 at;
+	xr_sprintf(at, "%s:%u", here.empty() ? "(your Tailscale address)" : here.c_str(), s_menu.port);
+	s_menu_address = at;
+	s_menu_code = code.c_str();
+	string_path info;
+	FS.update_path(info, "$app_data_root$", "coop-host-info.txt");
+	menu_write_file(info, "[host]\naddress = " + s_menu_address + "\njoin_code = " + s_menu_code + "\n");
+	if (g_link)
+		g_link->log.line("menu-host mode=%s address=%s port=%u", mode == 1 ? "new" : "continue", s_menu_address.c_str(),
+			s_menu.port);
+	Msg("S11-T00 co-op menu: hosting at %s (mode %d)", s_menu_address.c_str(), mode);
+	s_menu_reply = "ok|" + s_menu_address + "|" + s_menu_code;
+	return s_menu_reply.c_str();
+}
+
+LPCSTR coop_menu_host_info()
+{
+	s_menu_reply = s_menu_hosting ? "ok|" + s_menu_address + "|" + s_menu_code : xr_string("error|not hosting");
+	return s_menu_reply.c_str();
+}
+
+// The menu's test driver: what a player's clicks do, through the same Lua (the overridden StartGame with the
+// creation screen's choices; campaign.menu_join with the host's address and code).
+static u32 s_menu_test_at = 0;
+static bool s_menu_test_done = false;
+static void coop_menu_test()
+{
