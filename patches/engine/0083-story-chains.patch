+// S10-T05c: a party story change is published as a checkpoint once nothing
+// else is (the drx_sl_* variables live in the save only)
+void story_tick()
+{
+	if (!g_host->story_dirty || !g_host->persistence || g_host->persistence->failed() ||
+		g_host->persistence->in_flight() || g_host->travel.exec)
+		return;
+	g_host->story_dirty = false;
+	const bool published = request_publication("story");
+	++g_host->story_checkpoints;
+	g_host->log.line("story-checkpoint changes=%u published=%d", g_host->story_changes, published ? 1 : 0);
+}
+
+// S10-T05c: the two story chains (matrix F20, decision T01-16). DoctorX: a
+// step in player 2's context (drx_sl_meet_random_honcho: the next honcho and
+// its meet task), then player 1 meets the honcho (the meet info taken, the
+// task completes) and takes the next step. Living Legend: player 2 gets
+// lttz_ll_find_doctor, player 1 finds the doctor (living_legend_doctor), the
+// chain moves to lttz_ll_visit_agro_ug (a completed task leaves the task
+// manager: its state reads 65535, not 2). Both players must read the same
+// chain state; the party then travels Cordon -> Garbage, and after the travel
+// and after a server restart the state is the same. compare-coop-story.py.
+static LPCSTR const kStoryVerify =
+	"local tag = '%s'\n"
+	"local function drx(slot)\n"
+	"  local tok = 0\n"
+	"  if slot >= 0 then tok = campaign.enter_slot(slot) if tok == 0 then return 'none', -9, -9, -9, -9 end end\n"
+	"  local a = db.actor\n"
+	"  local t = load_var(a, 'drx_sl_current_task', '')\n"
+	"  local h = load_var(a, 'drx_sl_current_honcho', '')\n"
+	"  local s = string.format('%%s/%%s/%%s', tostring(h), tostring(load_var(a, 'drx_sl_current_task_number', 1)), tostring(t))\n"
+	"  local ts = t ~= '' and a:get_task_state(t) or -1\n"
+	"  local meet = a:has_info('drx_sl_meet_honcho_' .. tostring(h)) and 1 or 0\n"
+	"  local ll = a:has_info('lttz_ll_visit_agro_ug_task') and 1 or 0\n"
+	"  local lla = a:get_task_state('lttz_ll_visit_agro_ug')\n"
+	"  if tok ~= 0 then campaign.leave(tok) end\n"
+	"  return s, ts, meet, ll, lla\n"
+	"end\n"
+	"local s0, t0, m0, l0, a0 = drx(0)\n"
+	"local s1, t1, m1, l1, a1 = drx(1)\n"
+	"local sh = drx(-1)\n"
+	"local doc = db.actor:get_task_state('lttz_ll_find_doctor')\n"
+	"local pass = s0 == s1 and s0 == sh and s0:sub(1, 1) ~= '/' and t0 == 1 and t1 == 1 and m0 == 1 and m1 == 1\n"
+	"  and l0 == 1 and l1 == 1 and a0 == 1 and a1 == 1 and (doc == 2 or doc == 65535)\n" // a completed task leaves the list
+	"campaign.note(string.format('story-verify tag=%%s level=%%s drx0=%%s drx1=%%s drx_host=%%s task0=%%s task1=%%s meet0=%%d meet1=%%d ll_info0=%%d ll_info1=%%d ll_agro0=%%s ll_agro1=%%s ll_doctor=%%s pass=%%d',\n"
+	"  tag, level.name(), s0, s1, sh, tostring(t0), tostring(t1), m0, m1, l0, l1, tostring(a0), tostring(a1), tostring(doc), pass and 1 or 0))\n"
+	"return pass and 1 or 0\n";
+
+void story_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.story_party || !ai().get_alife())
+		return;
+	Host::StoryFixture& f = g_host->story_fixture;
+	if (f.phase >= 999)
+		return;
+	PlayerLink* links[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.ref.slot < 2 && participant_actor(link.ref))
+		{
+			links[link.ref.slot] = &link;
+			++attached;
+		}
+	const xr_string here = Level().name().c_str();
+	if (f.both_since && here != f.level)
+		f.both_since = 0; // a travel: count again on the new level
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		f.level = here;
+		if (f.phase == 0 && !g_host->recovered_save.empty())
+			f.restart = true;
+		g_host->log.line("fixture-story both-attached tick=%I64u level=%s restart=%d phase=%u", g_host->tick, here.c_str(),
+			f.restart ? 1 : 0, f.phase);
+	}
+	if (attached < 2 || g_host->tick < f.both_since + u64(config.story_party) * 50 || g_host->travel.exec)
+		return;
+	double v[1] = {-9};
+	string4096 chunk;
+	auto verify = [&](LPCSTR tag) {
+		xr_sprintf(chunk, kStoryVerify, tag);
+		const bool ok = alife_lua(chunk, v, 1, "story-verify") == 1 && v[0] == 1;
+		if (!ok)
+			++f.failures;
+		g_host->log.line("fixture-story verified tag=%s pass=%d", tag, ok ? 1 : 0);
+	};
+	auto step = [&](LPCSTR label, int slot, LPCSTR body) {
+		xr_sprintf(chunk,
+			"local tok = campaign.enter_slot(%d)\n"
+			"if tok == 0 then return -1 end\n"
+			"local ok, err = pcall(function()\n%s\nend)\n"
+			"local a = db.actor\n"
+			"local t = load_var(a, 'drx_sl_current_task', '')\n"
+			"local s = string.format('honcho=%%s number=%%s task=%%s task_state=%%s', tostring(load_var(a, 'drx_sl_current_honcho', '')),\n"
+			"  tostring(load_var(a, 'drx_sl_current_task_number', 1)), tostring(t), tostring(t ~= '' and a:get_task_state(t) or -1))\n"
+			"campaign.leave(tok)\n"
+			"campaign.note(string.format('story-step label=%s slot=%d %%s ok=%%s%%s', s, tostring(ok), ok and '' or (' error=' .. tostring(err))))\n"
+			"return ok and 1 or 0\n",
+			slot, body, label, slot);
+		const bool ok = alife_lua(chunk, v, 1, label) == 1 && v[0] == 1;
+		if (!ok)
+			++f.failures;
+		f.phase_tick = g_host->tick;
+		++f.phase;
+	};
+	const u64 since = (g_host->tick - f.phase_tick) / 50;
+	if (f.restart)
+	{
+		verify("restart");
+		g_host->log.line("fixture-story done tag=restart failures=%u", f.failures);
+		f.phase = 999;
+		return;
+	}
+	switch (f.phase)
+	{
+	case 0: // DoctorX, player 2: the next honcho and its meet task
+		step("drx-p2", 1, "xr_effects.drx_sl_meet_random_honcho(db.actor, nil, {})");
+		break;
+	case 1: // player 1 meets that honcho (the dialogue takes the meet info)
+		if (since >= 3)
+			step("drx-p1-meet", 0, "disable_info('drx_sl_meet_honcho_' .. load_var(db.actor, 'drx_sl_current_honcho', ''))");
+		break;
+	case 2: // the meet task completed; player 1 takes the next step
+		if (since >= 8)
+			step("drx-p1", 0,
+				"local t = load_var(db.actor, 'drx_sl_current_task', '')\n"
+				"campaign.note(string.format('story-meet-done task=%s state=%s', t, tostring(db.actor:get_task_state(t))))\n"
+				"xr_effects.drx_sl_meet_random_honcho(db.actor, nil, {})");
+		break;
+	case 3: // Living Legend, player 2: the first task
+		if (since >= 3)
+			step("ll-p2", 1, "task_manager.get_task_manager():give_task('lttz_ll_find_doctor')");
+		break;
+	case 4: // player 1 finds the doctor
+		if (since >= 3)
+			step("ll-p1", 0, "give_info('living_legend_doctor')");
+		break;
+	case 5:
+		if (since >= 10)
+		{
+			verify("steps");
+			f.phase = 6;
+			f.phase_tick = g_host->tick;
+		}
+		break;
+	case 6: // the party travels to Garbage
+	{
+		CObject* changer = Level().Objects.FindObjectByName("esc_level_changer_to_garbage_1");
+		const u16 reason = changer && links[0] && links[1] ? sweep_request(*links[0], *links[1], u16(changer->ID())) : u16(9999);
+		g_host->log.line("fixture-story travel changer=%d reason=%u", changer ? int(changer->ID()) : -1, u32(reason));
+		if (reason)
+		{
+			++f.failures;
+			g_host->log.line("fixture-story done tag=travel-refused failures=%u", f.failures);
+			f.phase = 999;
+			return;
+		}
+		f.phase = 7;
+		break;
+	}
+	case 7: // on the new level (both_since counted again there)
+		if (here != "l01_escape")
+		{
+			verify("travel");
+			g_host->log.line("fixture-story done tag=travel failures=%u", f.failures);
+			f.phase = 999;
+		}
+		break;
+	}
+}
+
 // S10-T05a: an emission with the players in different places (decision
 // T01-11). Variant 0: player 1 is placed in the nearest emission cover
 // (misc\surge_manager.ltx [list]), player 2 stays out of it, the installed
@@ -17565,6 +17752,16 @@ void coop_server_note(LPCSTR text)
 		g_host->log.line("emission %s", text);
 }
 
+// S10-T05c: kept in the save only (the host actor's pstor): published by story_tick
+void coop_server_story_changed(LPCSTR name, LPCSTR value)
+{
+	if (!g_host || !g_host->started)
+		return;
+	++g_host->story_changes;
+	g_host->story_dirty = true;
+	g_host->log.line("story-var name=%s value=%s", name, value);
+}
+
