-// A sound on no object or on an actor is the players' to hear; one on an NPC
-// or an item stays where it is (not replicated, L05).
+// A sound on no object or on an actor is the players' to hear; so is one on
+// a living NPC or monster, at its position (demo-5: Sidorovich's greeting
+// and goodbye lines are his logic's xr_sound, not dialogue phrases; the
+// rest of the presentation split is S10-T05d); one on an item stays where
+// it is (not replicated, L05).
 static bool coop_sound_for_players(CScriptGameObject* object)
 {
-	return !object || smart_cast<CActor*>(&object->object()) != nullptr;
+	return !object || smart_cast<CActor*>(&object->object()) != nullptr ||
+		smart_cast<CEntityAlive*>(&object->object()) != nullptr;
+}
+
+// A sound on an NPC has no position of its own: the NPC's, as a sound at a position.
+static bool coop_sound_on_npc(CScriptGameObject* object)
+{
+	return object && !smart_cast<CActor*>(&object->object()) && smart_cast<CEntityAlive*>(&object->object());
 }
 
