+void coop_server_relation_changed(u8 kind, u16 character, s32 a, s32 b, s32 value)
+{
+	if (!g_host || !g_host->started)
+		return;
+	if (kind == 2)
+	{
+		if (a < 0 || a > 255 || b < 0 || b > 255)
+			return;
+		const std::pair<u8, u8> changed = std::make_pair(u8(a), u8(b)); // not changed(u8(a), u8(b)): a function declaration to the compiler
+		if (std::find(g_host->relation_changes.begin(), g_host->relation_changes.end(), changed) == g_host->relation_changes.end())
+			g_host->relation_changes.push_back(changed);
+		if (g_pGameLevel && ai().get_alife())
+			relations_store(u8(a), u8(b), value);
+		return;
+	}
+	for (PlayerLink& link : g_host->links)
+	{
+		CActor* actor = link.bound ? participant_actor(link.ref) : nullptr;
+		if (!actor || u16(actor->ID()) != character)
+			continue;
+		if (kind == 1)
+			link.relations_dirty = true;
+		else if (kind == 3)
+			link.reputation_dirty = true;
+	}
+}
