+// The level registry's savable top-level objects at the save (id, section,
+// parent), to name any object the reloaded registry does not hold.
+struct SavedLevelObject
+{
+	u16 id;
+	u16 parent;
+	string64 section;
+};
+xr_vector<SavedLevelObject> g_saved_level_objects;
+
+void remember_level_objects()
+{
+	g_saved_level_objects.clear();
+	const CALifeSimulator* alife = ai().get_alife();
+	if (!alife)
+		return;
+	for (const auto& entry : alife->graph().level().objects())
+	{
+		SavedLevelObject o;
+		o.id = entry.second->ID;
+		o.parent = entry.second->ID_Parent;
+		xr_strcpy(o.section, entry.second->name());
+		g_saved_level_objects.push_back(o);
+	}
+}
+
+// Names every saved level-registry object the reloaded registry lacks and
+// returns how many of them are unexplained: not in ALife any more, or
+// registered under another level. A squad member that is still in ALife on
+// this level is explained: online-offline group members are registered
+// individually only while under direct control
+// (CALifeGraphRegistry::update, alife_graph_registry.cpp:49-52), so a member
+// that was online at the save can sit under its group after the load.
+u32 report_missing_level_objects()
+{
+	const CALifeSimulator* alife = ai().get_alife();
+	if (!alife)
+		return 0;
+	u32 unexplained = 0;
+	for (const SavedLevelObject& o : g_saved_level_objects)
+	{
+		if (alife->graph().level().objects().find(o.id) != alife->graph().level().objects().end())
+			continue;
+		const CSE_ALifeDynamicObject* now = alife->objects().object(o.id, true);
+		const u32 now_level = now ? u32(ai().game_graph().vertex(now->m_tGraphID)->level_id()) : u32(-1);
+		const bool explained = now && now_level == alife->graph().level().level_id();
+		Msg("S02-T06d level registry after the reload lacks %u (%s, parent %u at the save): %s", u32(o.id), o.section,
+			u32(o.parent), !now ? "not in ALife" : explained ? "still in ALife on this level" : "on another level");
+		if (now)
+			Msg("S02-T06d   now: parent %u graph %u (level %u) online %d", u32(now->ID_Parent), u32(now->m_tGraphID),
+				now_level, now->m_bOnline ? 1 : 0);
+		if (!explained)
+			++unexplained;
+	}
+	return unexplained;
+}
 
