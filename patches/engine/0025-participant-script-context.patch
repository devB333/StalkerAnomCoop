+void quest_row(const QuestRun& q, LPCSTR label)
+{
+	CGameTask* t = inprogress_task(q);
+	if (!t)
+		t = completed_task_of(q);
+	luabind::object lua = call("s03_t05.task", q.task_id);
+	string128 status;
+	field_str(lua, "status", status);
+	row("quest,%s,%s,%s,%d,%d,%d,%s,%d,%s,%u,%u,%u,%u,%d,%d,%d,%d,%u,%u", label, q.label, q.task_id,
+		t ? int(t->GetTaskState()) : -1, t && t->m_campaign_owned ? 1 : 0, t && t->m_campaign_owned ? int(t->m_campaign_owner.slot) : -1,
+		lua.type() == LUA_TTABLE ? status : "-", field_int(lua, "stage"), q.fetch, items_of(q.actor_id, q.fetch),
+		items_of(q.other_id, q.fetch), money_of(q.actor_id), money_of(q.other_id), goodwill_of(q.actor_id, "csky"),
+		goodwill_of(q.other_id, "csky"), info_of(q.actor_id, q.info) ? 1 : 0, info_of(q.other_id, q.info) ? 1 : 0,
+		outbox_size(q.slot), outbox_size(q.slot == 0 ? 1 : 0));
+}
+
+// The "any work for me?" phrases, in the participant's phrase context.
+bool accept_task(QuestRun& q, CGameObject* npc)
+{
+	CActor* actor = actor_by_id(q.actor_id);
+	if (!actor)
+		return false;
+	CScriptGameObject* a = actor->lua_game_object();
+	CScriptGameObject* n = npc->lua_game_object();
+	luabind::functor<void> generate, skip, give;
+	luabind::functor<bool> has_task;
+	luabind::functor<luabind::object> text;
+	if (!ai().script_engine().functor("dialogs.generate_available_tasks", generate) ||
+		!ai().script_engine().functor("dialogs.npc_has_task", has_task) ||
+		!ai().script_engine().functor("dialogs.npc_skip_task", skip) ||
+		!ai().script_engine().functor("dialogs.text_npc_has_task", text) ||
+		!ai().script_engine().functor("dialogs.npc_give_task", give))
+		return false;
+	generate(a, n);
+	for (u32 skipped = 0; skipped < 16; ++skipped)
+	{
+		if (!has_task(a, n))
+			break;
+		luabind::object list = lua_available(npc->ID());
+		luabind::object first = list.type() == LUA_TTABLE ? luabind::object(list[1]) : lua_nil();
+		LPCSTR offered = first.type() == LUA_TSTRING ? luabind::object_cast<LPCSTR>(first) : "-";
+		row("offer,%s,%s,%u", q.label, offered, skipped);
+		if (!xr_strcmp(offered, q.task_id))
+		{
+			luabind::object job = text(a, n);
+			Msg("S03-T05 %s offered %s: \"%s\"", q.label, q.task_id,
+				job.type() == LUA_TSTRING ? luabind::object_cast<LPCSTR>(job) : "-");
+			give(a, n);
+			return true;
+		}
+		skip(a, n);
+	}
+	Msg("! S03-T05 %s: the giver never offered %s", q.label, q.task_id);
+	return false;
+}
+
+bool turn_in(QuestRun& q, CGameObject* npc)
+{
+	CActor* actor = actor_by_id(q.actor_id);
+	if (!actor)
+		return false;
+	CScriptGameObject* a = actor->lua_game_object();
+	CScriptGameObject* n = npc->lua_game_object();
+	luabind::functor<bool> finished;
+	luabind::functor<luabind::object> text;
+	luabind::functor<void> complete;
+	if (!ai().script_engine().functor("dialogs.actor_has_finished_task", finished) ||
+		!ai().script_engine().functor("dialogs.text_npc_task_finish", text) ||
+		!ai().script_engine().functor("dialogs.npc_set_finished_task_complete", complete))
+		return false;
+	if (!finished(a, n))
+	{
+		Msg("! S03-T05 %s: actor_has_finished_task is false", q.label);
+		return false;
+	}
+	luabind::object t = text(a, n);
+	Msg("S03-T05 %s turn-in: \"%s\"", q.label, t.type() == LUA_TSTRING ? luabind::object_cast<LPCSTR>(t) : "-");
+	complete(a, n);
+	return true;
+}
