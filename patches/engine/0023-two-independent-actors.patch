+// A level vertex about `distance` m from the actor: the position's own
+// vertex when the AI map has an accessible one there, else the actor's own.
+bool choose_position(CActor* actor, float distance, u32& vertex, Fvector& position)
+{
+	const CLevelGraph& graph = ai().level_graph();
+	const float yaw = -actor->Orientation().yaw;
+	Fvector side;
+	side.set(_cos(yaw), 0.f, -_sin(yaw)); // to the actor's right
+	for (u32 attempt = 0; attempt < 4; ++attempt)
+	{
+		Fvector target;
+		target.mad(actor->Position(), side, distance);
+		if (graph.valid_vertex_position(target))
+		{
+			const u32 at = graph.vertex_id(target);
+			if (graph.valid_vertex_id(at) && graph.is_accessible(at))
+			{
+				vertex = at;
+				position = graph.vertex_position(at);
+				return true;
+			}
+		}
+		// turn the side vector 90 degrees and try again
+		side.set(-side.z, 0.f, side.x);
+	}
+	vertex = actor->ai_location().level_vertex_id();
+	if (!graph.valid_vertex_id(vertex))
+		return false;
+	position = graph.vertex_position(vertex);
+	position.x += 1.5f;
+	return true;
+}
+
+// Spawns an actor entity beside actor 1 and assigns it to participant 2.
+bool spawn_second_actor(LPCSTR purpose)
+{
+	Fixture& f = g_fixture;
+	CActor* actor1 = actor_by_id(f.actor1_id);
+	const CSE_ALifeCreatureActor* se_actor = ai().alife().graph().actor();
+	if (!actor1 || !se_actor)
+		return check(false, "actor 1 and the ALife actor exist for the spawn");
+	u32 vertex = u32(-1);
+	Fvector position;
+	if (!choose_position(actor1, f.distance, vertex, position))
+		return check(false, "a level vertex beside actor 1");
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	CSE_Abstract* entity = alife->spawn_item(f.actor_section, position, vertex, se_actor->m_tGraphID, no_id);
+	CSE_ALifeCreatureActor* se_second = entity ? smart_cast<CSE_ALifeCreatureActor*>(entity) : nullptr;
+	if (!check(se_second != nullptr, "the actor section spawned a CSE_ALifeCreatureActor"))
+		return false;
+	check(!se_second->s_flags.is(M_SPAWN_OBJECT_ASPLAYER), "the second actor is not flagged as the player entity");
+	check(ai().alife().graph().actor() == se_actor, "the ALife actor is still the saved actor after the spawn");
+	f.actor2_id = entity->ID;
+	// Explicit: participant 2 owns this entity from now on; the adoption at
+	// its net_Spawn finds it already held.
+	expect(assign_participant_actor(f.p2, f.actor2_id), Refusal::None, "the entity is assigned to participant 2");
+	ParticipantRef stale = f.p2;
+	stale.generation += 1;
+	expect(assign_participant_actor(stale, f.actor2_id), Refusal::StaleReference,
+		"a stale participant reference cannot take the entity");
+	expect(assign_participant_actor(f.p1, f.actor2_id), Refusal::AlreadyBound,
+		"participant 1 cannot take participant 2's entity");
+	expect(assign_participant_actor(f.p2, 0x7eef), Refusal::StaleReference, "an unassigned engine id cannot be assigned");
+	EngineEntityKey key;
+	if (g_campaign_identity->current_key(f.actor2_id, key))
+	{
+		f.actor2_key = key;
+		g_campaign_identity->resolve(key, f.actor2_entity);
+	}
+	Msg("S03-T03 %s: spawned %s id=%u entity=%I64u at [%.2f,%.2f,%.2f] vertex %u, %.2f m from actor %u", purpose,
+		f.actor_section, u32(f.actor2_id), f.actor2_entity.value, VPUSH(position), vertex,
+		actor1->Position().distance_to(position), u32(f.actor1_id));
+	f.phase_tick = f.ticks;
+	return true;
+}
+
+// The hit's source: an anomaly zone on the level, the engine's own
+// non-creature hitter. The installed CActor__BeforeHitCallback (_g.script)
+// ignores hits whose source is a stalker or actor friendly to db.actor, so a
+// hit "from" the other actor or from the victim itself never lands (S03-T05).
+CGameObject* find_zone_hitter()
+{
+	CLevel& level = Level();
+	for (u32 i = 0; i < level.Objects.o_count(); ++i)
+	{
+		CObject* object = level.Objects.o_get_by_iterator(i);
+		if (object->getDestroy())
+			continue;
+		if (CCustomZone* zone = smart_cast<CCustomZone*>(object))
+			return zone;
+	}
+	return nullptr;
+}
+
+// A hit on `victim` through the host's event loop, as the bullet manager and
+// the zones send theirs: GE_HIT from the bridge, queued by the server as
+// GAME_EVENT_ON_HIT, broadcast and applied by CGameObject::OnEvent.
+void send_hit(CActor* victim, float power)
+{
+	CGameObject* hitter = find_zone_hitter();
+	if (!check(hitter != nullptr, "an anomaly zone on the level is the hit source"))
+		return;
+	Fvector dir;
+	dir.set(0.f, 0.f, 1.f);
+	SHit HDS(power, dir, hitter, 0, Fvector().set(0.f, 0.f, 0.f), 0.f, ALife::eHitTypeWound, 0.f, false);
+	HDS.whoID = hitter->ID();
+	HDS.weaponID = hitter->ID();
+	HDS.BulletID = 0;
+	HDS.SenderID = 0;
+	HDS.GenHeader(GE_HIT, victim->ID());
+	NET_Packet P;
+	HDS.Write_Packet(P);
+	Fixture& f = g_fixture;
+	f.trace = SCombatTrace();
+	g_combat_trace = &f.trace;
+	f.counters0 = g_combat_counters;
+	f.bridge_events0 = message_policy_stats().bridge_events;
+	Msg("S03-T03 hit: power %.1f to actor %u from zone %u (%s) godmode=%d health=%.4f", power, u32(victim->ID()),
+		u32(hitter->ID()), hitter->cName().c_str(), GodMode() ? 1 : 0, victim->GetfHealth());
+	Level().Send(P, net_flags(TRUE, TRUE));
+}
+
+// What a hit in flight did: the policy's bridge events, every CEntityAlive::Hit recorded, the counters.
+void report_hit(LPCSTR tag)
+{
+	Fixture& f = g_fixture;
+	g_combat_trace = nullptr;
+	Msg("S03-T03 hit %s: bridge_events=%I64u entity_hits=%u deaths=%u records=%u godmode=%d", tag,
+		message_policy_stats().bridge_events - f.bridge_events0, g_combat_counters.hits - f.counters0.hits,
+		g_combat_counters.deaths - f.counters0.deaths, u32(f.trace.hits.size()), GodMode() ? 1 : 0);
+	for (u32 i = 0; i < f.trace.hits.size() && i < 8; ++i)
+	{
+		const CombatHitRecord& r = f.trace.hits[i];
+		Msg("S03-T03 hit %s record victim=%u who=%u power=%.4f type=%d bone=%u health_after=%.4f", tag, u32(r.victim),
+			u32(r.who), r.power, r.hit_type, u32(r.bone), r.health_after);
+	}
+}
