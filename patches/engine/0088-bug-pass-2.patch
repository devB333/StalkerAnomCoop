+
+// ------------------------------------------------------------ S10-T07 (B4)
+// The stalker's animation state on the wire (kStateBits, protocol messages.h):
+// bit 0 alive, bits 1-2 movement type, bit 3 body state, bits 4-5 mental
+// state, bits 6-9 the weapon animation (EReplicaWeaponAnim), bit 10 set.
+u16 CAI_Stalker::replica_animation_bits(CAI_Stalker* stalker)
+{
+	u16 bits = stalker->g_Alive() ? 1 : 0;
+	const stalker_movement_manager_smart_cover& m = stalker->movement();
+	bits |= u16(u32(m.movement_type()) & 3) << 1;
+	bits |= u16(u32(m.body_state()) & 1) << 3;
+	bits |= u16(u32(m.mental_state()) & 3) << 4;
+	u32 weapon = rwaNone;
+	if (CWeapon* w = smart_cast<CWeapon*>(stalker->inventory().ActiveItem()))
+	{
+		switch (w->GetState())
+		{
+		case CWeapon::eIdle: weapon = rwaIdle; break;
+		case CWeapon::eShowing: weapon = rwaShowing; break;
+		case CWeapon::eHiding: weapon = rwaHiding; break;
+		case CWeapon::eHidden: weapon = rwaNone; break;
+		case CWeapon::eFire:
+		case CWeapon::eFire2: weapon = rwaFire; break;
+		case CWeapon::eReload:
+			weapon = w->GetReloadState() == CWeapon::eSubstateReloadInProcess ? rwaReloadInProcess :
+				w->GetReloadState() == CWeapon::eSubstateReloadEnd ? rwaReloadEnd : rwaReloadBegin;
+			break;
+		default: weapon = rwaIdle; break;
+		}
+	}
+	bits |= u16(weapon & 15) << 6;
+	bits |= 1 << 10;
+	return bits;
+}
+
+void CAI_Stalker::replica_present_animation(u16 bits, bool has_aim, float head_yaw, float head_pitch)
+{
+	if (!(bits & (1 << 10)) || !g_Alive())
+		return;
+	const u32 movement_type = (bits >> 1) & 3;
+	const u32 body_state = (bits >> 3) & 1;
+	const u32 mental_state = (bits >> 4) & 3;
+	if (movement_type > u32(eMovementTypeStand) || mental_state > u32(eMentalStatePanic))
+		return;
+	movement().replica_set_current(EMovementType(movement_type), EBodyState(body_state), EMentalState(mental_state));
+	m_replica_weapon_anim = (bits >> 6) & 15;
+	if (has_aim && _valid(head_yaw) && _valid(head_pitch))
+	{
+		// the server's head_orientation().current (its convention, see
+		// CSightAction::execute_direction); Exec_Look lerps current to target
+		movement().m_head.target.yaw = head_yaw;
+		movement().m_head.target.pitch = head_pitch;
+	}
+}
+
+bool CAI_Stalker::replica_weapon_anim(u32& state, u32& reload_state) const
+{
+	if (m_replica_weapon_anim == u32(-1))
+		return false;
+	switch (m_replica_weapon_anim)
+	{
+	case rwaIdle: state = CWeapon::eIdle; break;
+	case rwaShowing: state = CWeapon::eShowing; break;
+	case rwaHiding: state = CWeapon::eHiding; break;
+	case rwaReloadBegin: state = CWeapon::eReload; reload_state = CWeapon::eSubstateReloadBegin; break;
+	case rwaReloadInProcess: state = CWeapon::eReload; reload_state = CWeapon::eSubstateReloadInProcess; break;
+	case rwaReloadEnd: state = CWeapon::eReload; reload_state = CWeapon::eSubstateReloadEnd; break;
+	case rwaFire: state = CWeapon::eFire; break;
+	default: state = CWeapon::eHidden; break;
+	}
+	return true;
+}
