diff --git a/src/xrGame/CampaignTwoActorFixture.cpp b/src/xrGame/CampaignTwoActorFixture.cpp
new file mode 100644
index 0000000..ab378ca
--- /dev/null
+++ b/src/xrGame/CampaignTwoActorFixture.cpp
@@ -0,0 +1,980 @@
+#include "pch_script.h"
+#include "CampaignIdentityFixture.h"
+#include "CampaignIdentity.h"
+#include "CampaignActorAccess.h"
+#include "CampaignActorControl.h"
+
+// S03-T03: two independent native actors on the loaded level, headless.
+//
+// The fixture creates a second genuine actor the way a script would
+// (CALifeSimulatorBase::spawn_item of the `actor` section beside the saved
+// actor, registered with ALife; the switch manager brings it online through
+// xrServer::Process_spawn and CActor::net_Spawn), names its participant
+// explicitly before the object exists (assign_participant_actor), and then
+// exercises both actors through the engine's own paths, in phases driven by
+// the server ticks:
+//
+//  0 spawn:     participant 2 bound and attached; the entity spawned and
+//               assigned; wait for the client object.
+//  1 identity:  both actors are participants, distinct and independently
+//               addressable; the single-actor accessors refuse; the engine
+//               globals (g_actor, the ALife actor, the view entity) did not
+//               move; the save-ready mapping (slot, player, entity, engine key,
+//               the entity id stored on the server entity) is logged.
+//  2 condition: a wound hit through the host's event loop (GE_HIT from the
+//               bridge, the server's GAME_EVENT_ON_HIT, the object's Hit)
+//               lowers actor 2's health; actor 1's is untouched.
+//  3 inventory: items spawned into actor 2 the way alife():create with a
+//               parent does land in actor 2's inventory (a weapon in a slot or
+//               the ruck, a consumable); actor 1's inventory is unchanged.
+//  4 control:   participant 2's input context holds forward for a second:
+//               actor 2 walks, actor 1 stands; then participant 1's: actor 1
+//               walks, actor 2 stands; a session context naming the other
+//               participant is refused and moves nobody.
+//  5 death:     a lethal hit kills actor 2 through the same event path; actor
+//               1 and the global services (ALife clock, scheduler, script
+//               engine) go on; participant 2 still holds its dead actor.
+//  6 lifecycle: actor 2 is released the way alife():release does (GE_DESTROY
+//               through the bridge); participant 2 holds no actor, the
+//               single-actor accessors name actor 1 again, the identity audit
+//               still balances; a third actor is spawned for participant 2.
+//  7 reuse:     participant 2 (same slot and generation) holds the new actor
+//               under a new entity id; it walks under participant 2's input.
+//
+// CSV rows (s03-t03-two-actors.csv):
+//   state,<phase>,<tick>,<frame>,<a1>,<a1_alive>,<a1_health>,<a1x>,<a1y>,<a1z>,<a1_items>,<a2>,<a2_alive>,
