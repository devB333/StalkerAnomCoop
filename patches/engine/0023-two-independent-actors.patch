+// --- phase 1: identity -------------------------------------------------------
+
+void phase_identity(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	const ActorAccessStats& s = actor_access_stats();
+	ParticipantRef who;
+	Refusal why = Refusal::None;
+	check(a1 != a2 && a1->ID() != a2->ID(), "two distinct actor objects");
+	check(a2->Local() && a2->getEnabled() && a2->g_Alive(), "actor 2 is local, enabled and alive");
+	check(is_participant_actor(a1) && is_participant_actor(a2), "both actors are participant actors");
+	expect(participant_of(a1, who), Refusal::None, "actor 1 is held");
+	check(who == f.p1, "actor 1 is held by participant 1");
+	expect(participant_of(a2, who), Refusal::None, "actor 2 is held");
+	check(who == f.p2, "actor 2 is held by participant 2");
+	check(participant_actor(f.p1, &why) == a1, "participant 1 resolves actor 1");
+	check(participant_actor(f.p2, &why) == a2, "participant 2 resolves actor 2");
+	xr_vector<CActor*> actors;
+	check(participant_actors(actors) == 2 && actors[0] != actors[1] &&
+			((actors[0] == a1 && actors[1] == a2) || (actors[0] == a2 && actors[1] == a1)),
+		"participant_actors lists exactly the two");
+	check(registry.live_actor_count() == 2, "the registry counts two live actors");
+	const u64 ambiguous0 = s.compat_ambiguous;
+	const u64 sole0 = s.sole_refused;
+	check(Actor() == nullptr, "Actor() refuses with two participant actors");
+	check(s.compat_ambiguous == ambiguous0 + 1, "...and counts the ambiguity");
+	check(sole_participant_actor("two-actors") == nullptr, "sole_participant_actor refuses with two");
+	check(s.sole_refused == sole0 + 1, "...and counts the refusal");
+	check(g_actor == a1, "g_actor is still the saved actor (nothing reads it for gameplay)");
+	check(ai().alife().graph().actor() && ai().alife().graph().actor()->ID == a1->ID(),
+		"the ALife actor is still the saved actor");
+	check(!Level().CurrentEntity() && !Level().CurrentViewEntity() && !Level().CurrentControlEntity(),
+		"the server still has no view or control entity");
+	check(controls_actor(a1) && controls_actor(a2), "the server controls both participant actors");
+	Fvector near2 = a2->Position();
+	near2.y += 0.5f;
+	check(nearest_participant_actor(near2, &who) == a2 && who == f.p2, "the nearest participant actor to actor 2 is actor 2");
+	Fvector near1 = a1->Position();
+	near1.y += 0.5f;
+	check(nearest_participant_actor(near1, &who) == a1 && who == f.p1, "the nearest participant actor to actor 1 is actor 1");
+
+	// Distinct identities, save-ready.
+	const Participant* v1 = nullptr;
+	const Participant* v2 = nullptr;
+	registry.participant(f.p1, v1);
+	registry.participant(f.p2, v2);
+	check(v1 && v2 && v1->player != v2->player, "the two participants hold different players");
+	check(v1 && v2 && v1->actor.valid() && v2->actor.valid() && v1->actor != v2->actor,
+		"the two actors have different entity ids");
+	CSE_Abstract* se1 = Level().Server->ID_to_entity(a1->ID());
+	CSE_Abstract* se2 = Level().Server->ID_to_entity(a2->ID());
+	check(se1 && v1 && se1->m_campaign_entity == v1->actor.value, "actor 1's server entity stores its entity id");
+	check(se2 && v2 && se2->m_campaign_entity == v2->actor.value, "actor 2's server entity stores its entity id");
+	write_map(f.p1);
+	write_map(f.p2);
+
+	// Contexts resolve their own participant's actor only.
+	check(context_actor(context(Origin::ClientIntent, f.session2, f.p2, party_id(1)), Scope::Self, &why) == a2,
+		"a client intent on participant 2's session acts on actor 2");
+	check(context_actor(context(Origin::ClientIntent, f.session2, f.p1, party_id(1)), Scope::Self, &why) == nullptr &&
+			why == Refusal::NotAuthoritative,
+		"participant 2's session cannot act on actor 1");
+	check(context_actor(context(Origin::ServerInternal, 0, f.p1, party_id(1)), Scope::World, &why) == a1,
+		"a server-internal context for participant 1 resolves actor 1");
+	check(context_actor(context(Origin::ServerInternal, 0, f.p2, party_id(1)), Scope::World, &why) == a2,
+		"a server-internal context for participant 2 resolves actor 2");
+
+	// Condition baselines, then the first hit.
+	f.health1_begin = a1->GetfHealth();
+	f.health2_begin = a2->GetfHealth();
+	f.items1_begin = u32(a1->inventory().m_all.size());
+	f.items2_begin = u32(a2->inventory().m_all.size());
+	f.money1_begin = a1->get_money();
+	check(a2->GetfHealth() > 0.9f, "actor 2 spawned healthy");
+	check(!GodMode(), "god mode is off for the hits");
+	Msg("S03-T03 identity: actor1 health=%.4f items=%u money=%u; actor2 health=%.4f items=%u", f.health1_begin,
+		f.items1_begin, f.money1_begin, f.health2_begin, f.items2_begin);
+	f.hit_sent = false;
+	begin_phase(2);
+}
+
+// --- phase 2: condition --------------------------------------------------------
+
+void phase_condition_tick(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	if (!f.hit_sent)
+	{
+		if (f.ticks < hit_ready_ticks)
+			return;
+		f.health1_begin = a1->GetfHealth();
+		f.health2_begin = a2->GetfHealth();
+		send_hit(a2, 0.5f);
+		f.hit_sent = true;
+		f.phase_tick = f.ticks;
+		Msg("S03-T03 condition: wound hit sent to actor %u at tick %u (health %.4f)", u32(a2->ID()), f.ticks, f.health2_begin);
+		return;
+	}
+	const bool landed = a2->GetfHealth() < f.health2_begin - 0.01f;
+	if (!landed && ticks_in_phase() < event_budget_ticks)
+		return;
+	report_hit("wound");
+	check(landed, "the wound hit lowered actor 2's health");
+	check(fsimilar(a1->GetfHealth(), f.health1_begin), "actor 1's health is untouched by actor 2's hit");
+	check(a2->g_Alive() && a1->g_Alive(), "both actors are alive after the wound");
+	Msg("S03-T03 condition after %u ticks: actor1 health=%.4f actor2 health=%.4f", ticks_in_phase(), a1->GetfHealth(),
+		a2->GetfHealth());
+	// Items for actor 2, the way alife():create with a parent does.
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	const CSE_ALifeCreatureActor* se_actor = ai().alife().graph().actor();
+	f.weapon_id = f.consumable_id = no_id;
+	if (pSettings->section_exist(f.weapon_section))
+	{
+		CSE_Abstract* w = CALifeSimulator__spawn_item2(alife, f.weapon_section, a2->Position(),
+			a2->ai_location().level_vertex_id(), se_actor->m_tGraphID, a2->ID());
+		if (check(w != nullptr, "the weapon spawned for actor 2"))
+			f.weapon_id = w->ID;
+	}
+	else
+		check(false, "the weapon section exists");
+	if (pSettings->section_exist(f.consumable_section))
+	{
+		CSE_Abstract* c = CALifeSimulator__spawn_item2(alife, f.consumable_section, a2->Position(),
+			a2->ai_location().level_vertex_id(), se_actor->m_tGraphID, a2->ID());
+		if (check(c != nullptr, "the consumable spawned for actor 2"))
+			f.consumable_id = c->ID;
+	}
+	else
+		check(false, "the consumable section exists");
+	Msg("S03-T03 inventory: spawned %s id=%u and %s id=%u into actor %u", f.weapon_section, u32(f.weapon_id),
+		f.consumable_section, u32(f.consumable_id), u32(a2->ID()));
+	begin_phase(3);
+}
+
+// --- phase 3: inventory --------------------------------------------------------
+
+void phase_inventory_tick(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	CInventoryItem* weapon = item_by_id(f.weapon_id);
+	CInventoryItem* consumable = item_by_id(f.consumable_id);
+	const bool both = weapon && consumable && weapon->object().H_Parent() == a2 && consumable->object().H_Parent() == a2;
+	if (!both && ticks_in_phase() < online_budget_ticks)
+		return;
+	check(weapon != nullptr && consumable != nullptr, "both items came online");
+	check(both, "both items are actor 2's children");
+	check(u32(a2->inventory().m_all.size()) == f.items2_begin + 2, "actor 2's inventory grew by the two items");
+	check(u32(a1->inventory().m_all.size()) == f.items1_begin, "actor 1's inventory is unchanged");
+	check(weapon && (a2->inventory().InSlot(weapon) || a2->inventory().InRuck(weapon)),
+		"the weapon is in actor 2's slot or ruck");
+	check(consumable && (a2->inventory().InRuck(consumable) || a2->inventory().InBelt(consumable) ||
+							a2->inventory().InSlot(consumable)),
+		"the consumable is in one of actor 2's containers");
+	// CInventory::InSlot/InRuck test the item's place, not the owner; the owner is the item's inventory.
+	check(weapon && weapon->m_pInventory == &a2->inventory() && weapon->m_pInventory != &a1->inventory(),
+		"the weapon's inventory is actor 2's, not actor 1's");
+	check(consumable && consumable->m_pInventory == &a2->inventory(), "the consumable's inventory is actor 2's");
+	check(a1->get_money() == f.money1_begin, "actor 1's money is unchanged");
+	Msg("S03-T03 inventory after %u ticks: actor1 items=%u actor2 items=%u weapon_slot=%d weapon_ruck=%d active2=%u",
+		ticks_in_phase(), u32(a1->inventory().m_all.size()), u32(a2->inventory().m_all.size()),
+		weapon && a2->inventory().InSlot(weapon) ? 1 : 0, weapon && a2->inventory().InRuck(weapon) ? 1 : 0,
+		a2->inventory().ActiveItem() ? u32(a2->inventory().ActiveItem()->object().ID()) : u32(no_id));
+	f.walk_phase = 0;
+	f.walk_started = false;
+	begin_phase(4);
+}
+
+// --- phase 4: control ----------------------------------------------------------
+
+// Holds one command under a context for walk_ticks ticks, then measures how
+// far each actor moved. Returns true once the walk is over.
+bool hold_and_measure(const ActionContext& ctx, Refusal expected, LPCSTR reach, float& moved1, float& moved2)
+{
+	Fixture& f = g_fixture;
+	CActor* a1 = actor_by_id(f.actor1_id);
+	CActor* a2 = actor_by_id(f.actor2_id);
+	if (!f.walk_started)
+	{
+		f.walk_started = true;
+		f.walk_tick = f.ticks;
+		return false;
+	}
+	const u32 elapsed = f.ticks - f.walk_tick;
+	if (elapsed < settle_ticks)
+		return false; // settling, no input
+	if (elapsed == settle_ticks)
+	{
+		f.pos1_begin = a1->Position();
+		f.pos2_begin = a2->Position();
+		const ActorControlStats& cs = actor_control_stats();
+		const u64 refused0 = cs.input_refused;
+		expect(actor_input_hold(ctx, kFWD), expected, reach);
+		if (expected != Refusal::None)
+			check(cs.input_refused == refused0 + 1, "...and the refusal is counted");
+		return false;
+	}
+	if (elapsed < settle_ticks + walk_ticks)
+	{
+		actor_input_hold(ctx, kFWD);
+		return false;
+	}
+	moved1 = a1->Position().distance_to(f.pos1_begin);
+	moved2 = a2->Position().distance_to(f.pos2_begin);
+	f.walk_started = false;
+	return true;
+}
+
+void phase_control_tick(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	const ActionContext ctx1 = context(Origin::ServerInternal, 0, f.p1, party_id(1));
+	const ActionContext ctx2 = context(Origin::ClientIntent, f.session2, f.p2, party_id(1));
+	const ActionContext forged = context(Origin::ClientIntent, f.session2, f.p1, party_id(1));
+	float moved1 = 0.f, moved2 = 0.f;
+	if (f.walk_phase == 0)
+	{
+		if (!hold_and_measure(ctx2, Refusal::None, "participant 2's input reaches actor 2", moved1, moved2))
+			return;
+		Msg("S03-T03 control: participant 2 held forward %u ticks: actor2 moved %.3f m, actor1 moved %.3f m", walk_ticks,
+			moved2, moved1);
+		check(moved2 >= walk_min_m, "actor 2 walked under participant 2's input");
+		check(moved1 <= stand_max_m, "actor 1 stood while participant 2 walked");
+		f.walk_phase = 1;
+		return;
+	}
+	if (f.walk_phase == 1)
+	{
+		if (!hold_and_measure(ctx1, Refusal::None, "participant 1's input reaches actor 1", moved1, moved2))
+			return;
+		Msg("S03-T03 control: participant 1 held forward %u ticks: actor1 moved %.3f m, actor2 moved %.3f m", walk_ticks,
+			moved1, moved2);
+		check(moved1 >= walk_min_m, "actor 1 walked under participant 1's input");
+		check(moved2 <= stand_max_m, "actor 2 stood while participant 1 walked");
+		f.walk_phase = 2;
+		return;
+	}
+	// A forged context: participant 2's session naming participant 1 moves nobody.
+	if (!hold_and_measure(forged, Refusal::NotAuthoritative, "participant 2's session cannot drive actor 1", moved1, moved2))
+		return;
+	Msg("S03-T03 control: forged context held forward %u ticks: actor1 moved %.3f m, actor2 moved %.3f m", walk_ticks,
+		moved1, moved2);
+	check(moved1 <= stand_max_m && moved2 <= stand_max_m, "nobody moved under the forged context");
+	// The lethal hit.
+	f.health1_begin = a1->GetfHealth();
+	send_hit(a2, 100.f);
+	begin_phase(5);
+}
+
+// --- phase 5: death ------------------------------------------------------------
+
+void phase_death_tick(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	const bool dead = !a2->g_Alive();
+	if (!dead && ticks_in_phase() < event_budget_ticks)
+		return;
+	report_hit("lethal");
+	check(dead, "the lethal hit killed actor 2");
+	check(a1->g_Alive(), "actor 1 is alive after actor 2's death");
+	check(fsimilar(a1->GetfHealth(), f.health1_begin), "actor 1's health is untouched by actor 2's death");
+	check(participant_actor(f.p2) == a2, "participant 2 still holds its dead actor");
+	check(participant_actor(f.p1) == a1, "participant 1 still holds actor 1");
+	check(g_campaign_identity->live_actor_count() == 2, "the registry still counts two actors");
+	check(Actor() == nullptr, "Actor() still refuses (a dead participant actor is still held)");
+	check(g_actor == a1, "g_actor is unchanged by actor 2's death");
+	check(ai().alife().graph().actor() && ai().alife().graph().actor()->ID == a1->ID(),
+		"the ALife actor is unchanged by actor 2's death");
+	check(!Level().CurrentEntity() && !Level().CurrentViewEntity(), "no view entity appeared");
+	check(ai().alife().time_manager().game_time() > f.game_time0, "the ALife clock advanced");
+	check(Device.dwFrame > f.frame0, "the frame driver advanced");
+	check(a1->shedule_Needed() && a1->processing_enabled(), "actor 1 is still scheduled and processed");
+	check(ai().get_alife() != nullptr && Level().Server != nullptr, "ALife and the server exist");
+	check(ai().script_engine().script_process(ScriptEngine::eScriptProcessorLevel) != nullptr,
+		"the level script process exists");
+	Msg("S03-T03 death after %u ticks: actor2 alive=%d health=%.4f; actor1 alive=%d health=%.4f", ticks_in_phase(),
+		a2->g_Alive() ? 1 : 0, a2->GetfHealth(), a1->g_Alive() ? 1 : 0, a1->GetfHealth());
+	f.frame0 = Device.dwFrame;
+	f.game_time0 = ai().alife().time_manager().game_time();
+	// Release, as alife():release does.
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	CSE_Abstract* se2 = Level().Server->ID_to_entity(a2->ID());
+	if (check(se2 != nullptr, "actor 2's server entity exists for the release"))
+		CALifeSimulator__release(alife, se2, true);
+	f.first_actor2_id = f.actor2_id;
+	begin_phase(6);
+}
+
+// --- phase 6: lifecycle --------------------------------------------------------
+
+void phase_lifecycle_tick(CActor* a1)
+{
+	Fixture& f = g_fixture;
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	CActor* a2 = actor_by_id(f.actor2_id);
+	const bool gone = a2 == nullptr && Level().Server->ID_to_entity(f.actor2_id) == nullptr;
+	if (!gone && ticks_in_phase() < event_budget_ticks)
+		return;
+	check(gone, "actor 2's object and server entity are gone");
+	check(ai().alife().objects().object(f.actor2_id, true) == nullptr, "actor 2's ALife object is gone");
+	EntityId stale_entity;
+	check(registry.resolve(f.actor2_key, stale_entity) == Refusal::StaleReference,
+		"actor 2's engine key is stale (the u16 may be recycled; the entity id is not)");
+	Refusal why = Refusal::None;
+	check(participant_actor(f.p2, &why) == nullptr && why == Refusal::NoActor, "participant 2 holds no actor");
+	const Participant* v2 = nullptr;
+	registry.participant(f.p2, v2);
+	check(v2 && v2->state == ParticipantState::Attached && v2->player == player_id(2),
+		"participant 2 keeps its slot, player and session");
+	check(participant_actor(f.p1) == a1, "participant 1 still holds actor 1");
+	xr_vector<CActor*> actors;
+	check(participant_actors(actors) == 1 && actors[0] == a1, "actor 1 is the only participant actor");
+	check(registry.live_actor_count() == 1, "the registry counts one live actor");
+	check(sole_participant_actor("two-actors") == a1, "the sole participant actor is actor 1 again");
+	const ActorAccessStats& s = actor_access_stats();
+	const u64 none0 = s.compat_none;
+	check(Actor() == a1, "Actor() returns actor 1 again");
+	check(s.compat_none == none0, "...without a refusal");
+	check(a1->g_Alive() && fsimilar(a1->GetfHealth(), f.health1_begin), "actor 1 is alive with its health");
+	check(ai().alife().time_manager().game_time() > f.game_time0 && Device.dwFrame > f.frame0,
+		"the clock and the frame driver advanced through the release");
+	check(xrCampaignLevel_IdentityCheck(), "the identity audit balances after the release");
+	write_map(f.p1);
+	write_map(f.p2);
+	Msg("S03-T03 lifecycle after %u ticks: actor %u released; participant 2 state=%s", ticks_in_phase(),
+		u32(f.actor2_id), v2 ? participant_state_name(v2->state) : "-");
+	// The slot is reused: a third actor for participant 2.
+	const EntityId previous = f.actor2_entity;
+	if (!spawn_second_actor("reuse"))
+	{
+		finish(false);
+		return;
+	}
+	check(f.actor2_entity.valid() && f.actor2_entity.value > previous.value,
+		"the third actor has a new, larger entity id");
+	begin_phase(7);
+}
+
+// --- phase 7: reuse ------------------------------------------------------------
+
+void phase_reuse_tick(CActor* a1)
+{
+	Fixture& f = g_fixture;
+	CActor* a3 = actor_by_id(f.actor2_id);
+	if (f.walk_phase != 3)
+	{
+		if (!a3 && ticks_in_phase() < online_budget_ticks)
+			return;
+		if (!check(a3 != nullptr, "the third actor came online"))
+		{
+			finish(false);
+			return;
+		}
+		ParticipantRef who;
+		expect(participant_of(a3, who), Refusal::None, "the third actor is held");
+		check(who == f.p2, "...by participant 2, the same slot and generation");
+		check(participant_actor(f.p2) == a3, "participant 2 resolves the third actor");
+		check(participant_actor(f.p1) == a1, "participant 1 still resolves actor 1");
+		check(g_campaign_identity->live_actor_count() == 2, "two live actors again");
+		check(Actor() == nullptr, "Actor() refuses again with two");
+		const Participant* v2 = nullptr;
+		g_campaign_identity->participant(f.p2, v2);
+		CSE_Abstract* se3 = Level().Server->ID_to_entity(a3->ID());
+		check(v2 && se3 && v2->actor == f.actor2_entity && se3->m_campaign_entity == v2->actor.value,
+			"the third actor's entity id is stored on its server entity");
+		write_map(f.p2);
+		f.walk_phase = 3;
+		f.walk_started = false;
+		return;
+	}
+	const ActionContext ctx2 = context(Origin::ClientIntent, f.session2, f.p2, party_id(1));
+	float moved1 = 0.f, moved3 = 0.f;
+	if (!hold_and_measure(ctx2, Refusal::None, "participant 2's input reaches the third actor", moved1, moved3))
+		return;
+	Msg("S03-T03 reuse: participant 2 held forward %u ticks: actor3 moved %.3f m, actor1 moved %.3f m", walk_ticks,
+		moved3, moved1);
+	check(moved3 >= walk_min_m, "the third actor walked under participant 2's input");
+	check(moved1 <= stand_max_m, "actor 1 stood");
+	write_state();
+	finish(true);
+}
+} // namespace
+
+extern "C" bool __cdecl xrCampaignLevel_TwoActorsBegin(LPCSTR out_path)
+{
+	Fixture& f = g_fixture;
+	f = Fixture();
+	f.ok = true;
+	f.actor1_id = f.actor2_id = f.first_actor2_id = f.weapon_id = f.consumable_id = no_id;
+	option_string("-s03-actor-section ", default_actor_section, f.actor_section);
+	option_string("-s03-weapon-section ", default_weapon_section, f.weapon_section);
+	option_string("-s03-consumable-section ", default_consumable_section, f.consumable_section);
+	f.distance = option_float("-s03-actor-distance ", default_distance);
+	if (!g_campaign_identity || g_campaign_identity->role() != Role::Server || !g_pGameLevel || !Level().Server ||
+		!ai().get_alife() || !ai().get_level_graph())
+	{
+		Msg("! S03-T03 two-actors: no server registry, level, ALife or level graph");
+		return false;
+	}
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	const ServerAuthority* authority = registry.authority();
+	CActor* actor1 = g_actor;
+	if (!actor1 || !actor1->g_Alive())
+	{
+		Msg("! S03-T03 two-actors: no alive saved actor");
+		return false;
+	}
+	f.out = fopen(out_path, "w");
+	if (!f.out)
+	{
+		Msg("! S03-T03 two-actors: cannot write %s", out_path);
+		return false;
+	}
+	f.actor1_id = actor1->ID();
+	f.running = true;
+	f.phase = 0;
+	f.frame0 = Device.dwFrame;
+	f.game_time0 = ai().alife().time_manager().game_time();
+	f.compat_ambiguous0 = actor_access_stats().compat_ambiguous;
+	f.resyncs0 = g_spawn_state_resyncs;
+	f.sole_refused0 = actor_access_stats().sole_refused;
+	// The single-player god-mode flags are global (every actor); off for the hits.
+	f.godmode_was = !!psActorFlags.test(AF_GODMODE);
+	f.godmode_rt_was = !!psActorFlags.test(AF_GODMODE_RT);
+	psActorFlags.set(AF_GODMODE, FALSE);
+	psActorFlags.set(AF_GODMODE_RT, FALSE);
+
+	expect(participant_of(actor1, f.p1), Refusal::None, "the saved actor is held by a participant");
+	ParticipantRef existing;
+	if (registry.find_player(player_id(2), existing) == Refusal::None)
+		expect(registry.release_participant(authority, existing, Device.dwFrame), Refusal::None,
+			"a leftover participant 2 is released first");
+	expect(registry.bind_participant(authority, player_id(2), party_id(1), Device.dwFrame, f.p2), Refusal::None,
+		"participant 2 is bound for player 2");
+	f.session2 = 0x53030002;
+	expect(registry.attach_session(authority, f.p2, f.session2, Device.dwFrame), Refusal::None,
+		"participant 2's session is attached");
+	Refusal why = Refusal::None;
+	check(participant_actor(f.p2, &why) == nullptr && why == Refusal::NoActor, "participant 2 holds no actor yet");
+	fprintf(f.out, "meta,%u,%u,%s,%u,%s,%s,%s,%.2f,%d,%d\n", Device.dwFrame, Device.dwTimeGlobal, *Level().name(),
+		u32(f.actor1_id), f.actor_section, f.weapon_section, f.consumable_section, f.distance, f.godmode_was ? 1 : 0,
+		f.godmode_rt_was ? 1 : 0);
+	if (!spawn_second_actor("spawn"))
+	{
+		finish(false);
+		return false;
+	}
+	begin_phase(0);
+	return f.ok;
+}
+
+extern "C" void __cdecl xrCampaignLevel_TwoActorsTick()
+{
+	Fixture& f = g_fixture;
+	if (!f.running)
+		return;
+	++f.ticks;
+	CActor* a1 = actor_by_id(f.actor1_id);
+	if (!a1)
+	{
+		check(false, "actor 1 disappeared");
+		finish(false);
+		return;
+	}
+	CActor* a2 = actor_by_id(f.actor2_id);
+	switch (f.phase)
+	{
+	case 0:
+		if (a2)
+		{
+			Msg("S03-T03 actor %u online at tick %u", u32(f.actor2_id), f.ticks);
+			begin_phase(1);
+			phase_identity(a1, a2);
+		}
+		else if (ticks_in_phase() >= online_budget_ticks)
+		{
+			check(false, "the second actor came online");
+			finish(false);
+		}
+		break;
+	case 2:
+		if (a2)
+			phase_condition_tick(a1, a2);
+		break;
+	case 3:
+		if (a2)
+			phase_inventory_tick(a1, a2);
+		break;
+	case 4:
+		if (a2)
+			phase_control_tick(a1, a2);
+		break;
+	case 5:
+		if (a2)
+			phase_death_tick(a1, a2);
+		break;
+	case 6:
+		phase_lifecycle_tick(a1);
+		break;
+	case 7:
+		phase_reuse_tick(a1);
+		break;
+	default:
+		break;
+	}
+	if (f.running && f.phase >= 2 && f.phase <= 5 && !a2)
+	{
+		check(false, "actor 2 exists during the phase");
+		finish(false);
+	}
+}
+
+extern "C" bool __cdecl xrCampaignLevel_TwoActorsDone()
+{
+	return !g_fixture.running;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_TwoActorsEnd(u32 ticks, u32 sim_ms, u32 wall_ms)
+{
+	Fixture& f = g_fixture;
+	if (f.running)
+	{
+		check(false, "the fixture finished within its tick budget");
+		f.running = false;
+	}
+	psActorFlags.set(AF_GODMODE, f.godmode_was ? TRUE : FALSE);
+	psActorFlags.set(AF_GODMODE_RT, f.godmode_rt_was ? TRUE : FALSE);
+	const ActorAccessStats& s = actor_access_stats();
+	Msg("S03-T03 two-actors end ticks=%u sim_ms=%u wall_ms=%u checks=%u failures=%u phase=%u actor1=%u actor2=%u "
+		"compat_ambiguous=%I64u sole_refused=%I64u spawn_state_resyncs=%u (total %u) ok=%d",
+		ticks, sim_ms, wall_ms, f.checks, f.failures, f.phase, u32(f.actor1_id), u32(f.actor2_id),
+		s.compat_ambiguous - f.compat_ambiguous0, s.sole_refused - f.sole_refused0, g_spawn_state_resyncs - f.resyncs0,
+		g_spawn_state_resyncs, f.ok ? 1 : 0);
+	if (f.out)
+	{
+		fprintf(f.out, "end,%u,%u,%u,%u,%u,%u,%d\n", ticks, sim_ms, wall_ms, f.checks, f.failures, f.phase, f.ok ? 1 : 0);
+		fclose(f.out);
+		f.out = nullptr;
+	}
+	report_actor_access("two-actors");
+	report_actor_control("two-actors");
+	return f.ok && f.failures == 0;
+}
