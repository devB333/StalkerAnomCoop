+// ------------------------------------------------------------ S10-T03a
+// The ALife identity fixture (profile alife_party, server-driven; with
+// -ServerKill / -ServerRestartAfter and a client 2 -Restart in the run).
+// Fresh: a baseline identity scan (squads, members, alive/dead creatures, a
+// member in two squads, a member whose group is not its squad, two alive
+// creatures with one name, two objects with one story id) and the server's CPU
+// with the players together; the respawn smart terrain nearest p2 (within its
+// respawn radius) is "near", p1 moves to a smart terrain 300+ m from p2 and
+// clear of near's radius ("dest", p1 only, L58), the respawn point nearest p2
+// clear of both players' radius is "far"; CPU apart. Guard: near's respawn is
+// forced (its timer and counts cleared, try_respawn called): no squad may be
+// created, the installed rule measured actor 0 (p1, now far away) and only the
+// nearest-participant distance (the compat layer) holds it. Respawn: far's is
+// forced: one new squad. Then a non-story stalker near p2 is killed, the scan
+// repeats (no resurrection of the baseline's dead), the subjects are written
+// into the scripts' saved state (alife_storage_manager coop_alife_fixture) and a
+// checkpoint is asked for. While p2's client is away its actor keeps its area
+// online. Restored (the marker found after the restart): the victim is still
+// dead under its name, the respawned squad exists once with its members, no
+// other squad from that point appeared, the scan is clean, and the guard holds
+// again. compare-coop-alife.py checks the lines.
+static int alife_lua(LPCSTR chunk, double* out, int count, LPCSTR label)
+{
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return -1;
+	const int top = lua_gettop(L);
+	int read = -1;
+	if (luaL_loadstring(L, chunk) == 0)
+	{
+		if (lua_pcall(L, 0, count, 0) == 0)
+		{
+			for (int i = 0; i < count; ++i)
+				out[i] = lua_isnumber(L, top + 1 + i) ? lua_tonumber(L, top + 1 + i) : -9.0;
+			read = count;
+		}
+		else
+			g_host->log.line("fixture-alife lua-error label=%s error=%s", label, lua_tostring(L, -1) ? lua_tostring(L, -1) : "?");
+	}
+	else
+		g_host->log.line("fixture-alife lua-load-error label=%s error=%s", label, lua_tostring(L, -1) ? lua_tostring(L, -1) : "?");
+	lua_settop(L, top);
+	return read;
+}
+
+struct AlifeScan
+{
+	u32 squads = 0, members = 0, alive = 0, dead = 0, online = 0;
+	u32 bad_group = 0, dup_member = 0, dup_name = 0, dup_story = 0, resurrected = 0;
+	bool clean() const { return !bad_group && !dup_member && !dup_name && !dup_story && !resurrected; }
+};
+
+static AlifeScan alife_scan(xr_map<u16, shared_str>* dead_out, const xr_map<u16, shared_str>* dead_before)
+{
+	AlifeScan s;
+	xr_map<u16, u16> owner;
+	xr_set<shared_str> names;
+	xr_set<u32> stories;
+	const CALifeObjectRegistry::OBJECT_REGISTRY& objects = ai().alife().objects().objects();
+	for (CALifeObjectRegistry::OBJECT_REGISTRY::const_iterator it = objects.begin(); it != objects.end(); ++it)
+	{
+		CSE_ALifeDynamicObject* o = it->second;
+		if (!o)
+			continue;
+		if (CSE_ALifeOnlineOfflineGroup* g = smart_cast<CSE_ALifeOnlineOfflineGroup*>(o))
+		{
+			++s.squads;
+			const CSE_ALifeOnlineOfflineGroup::MEMBERS& members = g->squad_members();
+			for (CSE_ALifeOnlineOfflineGroup::MEMBERS::const_iterator m = members.begin(); m != members.end(); ++m)
+			{
+				++s.members;
+				if (!owner.insert(std::make_pair(m->first, g->ID)).second)
+					++s.dup_member;
+				if (m->second && m->second->m_group_id != g->ID)
+					++s.bad_group;
+			}
+			continue;
+		}
+		CSE_ALifeCreatureAbstract* c = smart_cast<CSE_ALifeCreatureAbstract*>(o);
+		if (!c || smart_cast<CSE_ALifeCreatureActor*>(o))
+			continue;
+		if (o->m_story_id != INVALID_STORY_ID && !stories.insert(u32(o->m_story_id)).second)
+			++s.dup_story;
+		const shared_str name = o->name_replace();
+		if (c->g_Alive())
+		{
+			++s.alive;
+			if (o->m_bOnline)
+				++s.online;
+			if (!names.insert(name).second)
+				++s.dup_name;
+			if (dead_before)
+			{
+				xr_map<u16, shared_str>::const_iterator d = dead_before->find(o->ID);
+				if (d != dead_before->end() && d->second == name)
+					++s.resurrected;
+			}
+		}
+		else
+		{
+			++s.dead;
+			if (dead_out)
+				(*dead_out)[o->ID] = name;
+		}
+	}
+	return s;
+}
+
+static void alife_scan_log(LPCSTR phase, const AlifeScan& s)
+{
+	g_host->log.line("fixture-alife scan phase=%s squads=%u members=%u alive=%u dead=%u online=%u bad_group=%u dup_member=%u "
+		"dup_name=%u dup_story=%u resurrected=%u clean=%d", phase, s.squads, s.members, s.alive, s.dead, s.online, s.bad_group,
+		s.dup_member, s.dup_name, s.dup_story, s.resurrected, s.clean() ? 1 : 0);
+}
+
+static u64 alife_process_cpu()
+{
+	FILETIME created, exited, kernel, user;
+	if (!GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user))
+		return 0;
+	ULARGE_INTEGER k, u;
+	k.LowPart = kernel.dwLowDateTime;
+	k.HighPart = kernel.dwHighDateTime;
+	u.LowPart = user.dwLowDateTime;
+	u.HighPart = user.dwHighDateTime;
+	return k.QuadPart + u.QuadPart; // 100 ns units
+}
+
+static void alife_cost_begin(Host::AlifeFixture& f)
+{
+	f.cpu0 = alife_process_cpu();
+	f.wall0 = GetTickCount64();
+}
+
+static void alife_cost_log(Host::AlifeFixture& f, LPCSTR phase, const Fvector& p1, const Fvector& p2)
+{
+	const u64 cpu = alife_process_cpu() - f.cpu0;
+	const u64 wall = GetTickCount64() - f.wall0;
+	const AlifeScan s = alife_scan(nullptr, nullptr);
+	g_host->log.line("fixture-alife cost phase=%s cpu_pct=%.1f wall_ms=%I64u online_creatures=%u d_p1_p2=%.1f", phase,
+		wall ? float(cpu) / 100.f / float(wall) : 0.f, wall, s.online, p1.distance_to(p2));
+}
+
+// the online alive creatures within 100 m of a point
+static u32 alife_online_near(const Fvector& at)
+{
+	u32 n = 0;
+	const CALifeObjectRegistry::OBJECT_REGISTRY& objects = ai().alife().objects().objects();
+	for (CALifeObjectRegistry::OBJECT_REGISTRY::const_iterator it = objects.begin(); it != objects.end(); ++it)
+	{
+		CSE_ALifeCreatureAbstract* c = smart_cast<CSE_ALifeCreatureAbstract*>(it->second);
+		if (c && !smart_cast<CSE_ALifeCreatureActor*>(it->second) && c->g_Alive() && c->m_bOnline &&
+			c->o_Position.distance_to(at) < 100.f)
+			++n;
+	}
+	return n;
+}
+
+// forces a smart terrain's respawn: n0/n1 squads from it before/after, the new
+// squad and its members, the guard counter's change, the distance to actor 0,
+// the distance try_respawn used and the radius
+static int alife_force_respawn(int smart, double* v)
+{
+	string2048 chunk;
+	xr_sprintf(chunk,
+		"local e = SIMBOARD.smarts[%d] local s = e and e.smrt\n"
+		"if not s then return -1, -1, -1, 0, 0, -1, -1, -1 end\n"
+		"local before, n0 = {}, 0\n"
+		"for id in pairs(SIMBOARD.squads) do local sq = alife_object(id) if sq then if sq.respawn_point_id == s.id then before[id] = true n0 = n0 + 1 end end end\n"
+		"local saved = {}\n"
+		"for k, c in pairs(s.already_spawned) do saved[k] = c.num c.num = 0 end\n"
+		"s.last_respawn_update = nil\n"
+		"local d0 = s.position:distance_to(alife():actor().position)\n"
+		"s:try_respawn()\n"
+		"local new_id, members, n1 = -1, 0, 0\n"
+		"for id in pairs(SIMBOARD.squads) do local sq = alife_object(id) if sq then if sq.respawn_point_id == s.id then n1 = n1 + 1\n"
+		"  if not before[id] then new_id = id members = 0 for m in sq:squad_members() do members = members + 1 end end end end end\n"
+		"for k, c in pairs(s.already_spawned) do if saved[k] then c.num = saved[k] + c.num end end\n"
+		"return n0, n1, new_id, members, __campaign_ctx.respawn_guarded or 0, d0, s.dist_to_actor or -1, s.respawn_radius or 150\n",
+		smart);
+	return alife_lua(chunk, v, 8, "force-respawn");
+}
+
+static bool alife_guard(Host::AlifeFixture& f)
+{
+	double v[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+	if (f.near_id < 0 || alife_force_respawn(f.near_id, v) != 8 || v[0] < 0)
+	{
+		g_host->log.line("fixture-alife guard smart=%d skipped=1 pass=0 restored=%d", f.near_id, f.restored ? 1 : 0);
+		return false;
+	}
+	// held (no new squad) by the distance try_respawn used, the nearest
+	// participant's, inside the radius, while the installed distance to actor 0
+	// was beyond it; guarded_total counts the wrapper's corrections so far (the
+	// smart terrain's own updates make them, before the fixture's call)
+	const bool pass = v[1] == v[0] && v[2] < 0 && v[5] >= v[7] && v[6] >= 0.f && v[6] < v[7];
+	g_host->log.line("fixture-alife guard smart=%d before=%d after=%d new_squad=%d guarded_total=%d d_actor0=%.1f d_used=%.1f "
+		"radius=%.1f pass=%d restored=%d", f.near_id, int(v[0]), int(v[1]), int(v[2]), int(v[4]), v[5], v[6], v[7], pass ? 1 : 0,
+		f.restored ? 1 : 0);
+	return pass;
+}
+
+// the marked subjects (the scripts' saved state): the victim exists, is alive,
+// keeps its name; the squad is found, its members; the squads from its respawn
+// point
+static bool alife_subject_check(double* v)
+{
+	return alife_lua("local m = alife_storage_manager.get_state().coop_alife_fixture\n"
+		"local o = alife_object(m.victim)\n"
+		"local found, members, src = 0, 0, 0\n"
+		"for id in pairs(SIMBOARD.squads) do local sq = alife_object(id) if sq then\n"
+		"  if sq.respawn_point_id == m.smart then src = src + 1 end\n"
+		"  if id == m.squad then found = found + 1 for _ in sq:squad_members() do members = members + 1 end end\n"
+		"end end\n"
+		"return o and 1 or 0, (o and o.alive and o:alive()) and 1 or 0, (o and o:name() == m.victim_name) and 1 or 0, found, members, src\n",
+		v, 6, "subject-check") == 6;
+}
+
+void alife_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.alife_party || !ai().get_alife())
+		return;
+	Host::AlifeFixture& f = g_host->alife_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.ref.slot < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				actors[link.ref.slot] = actor;
+				++attached;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-alife both-attached tick=%I64u", g_host->tick);
+	}
+	if (f.phase >= 999 || g_host->tick < f.both_since + u64(config.alife_party) * 50)
+		return;
+	// while p2's client is away (after the subjects are marked): its actor stays
+	// an anchor and keeps its area online (S03-T04, decision T03a-2)
+	// a travel since the subjects were marked: the same checks on the new level
+	if (f.phase == 20 && f.level[0] && xr_strcmp(f.level, *Level().name()))
+	{
+		if (attached < 2)
+		{
+			f.travel_since = 0;
+			return;
+		}
+		if (!f.travel_since)
+			f.travel_since = g_host->tick;
+		if (g_host->tick - f.travel_since < 20 * 50)
+			return;
+		const AlifeScan s = alife_scan(nullptr, &f.dead);
+		alife_scan_log("travelled", s);
+		double c[6] = {-9, -9, -9, -9, -9, -9};
+		const bool read = alife_subject_check(c);
+		const bool pass = read && c[1] == 0 && (c[0] == 0 || c[2] == 1) && c[3] == 1 && int(c[4]) == f.members &&
+			int(c[5]) == f.src && s.clean();
+		if (!pass)
+			++f.failures;
+		g_host->log.line("fixture-alife travelled from=%s to=%s victim=%u victim_exists=%d victim_alive=%d victim_same=%d squad=%d "
+			"squad_found=%d members=%d/%d src_squads=%d/%d pass=%d", f.level, *Level().name(), u32(f.victim), int(c[0]), int(c[1]),
+			int(c[2]), f.squad, int(c[3]), int(c[4]), f.members, int(c[5]), f.src, pass ? 1 : 0);
+		g_host->log.line("fixture-alife done phase=travelled restored=0 failures=%u", f.failures);
+		f.phase = 999;
+		return;
+	}
+	if (f.phase == 20)
+	{
+		for (PlayerLink& link : g_host->links)
+		{
