+		g_host->log.line("fixture-upgrade mechanic id=%u section=%s name=%s profile=%s money_p1=%u", u32(f.mechanic),
+			*mech->cNameSect(), owner->Name(), owner->CharacterInfo().Profile().c_str(), actors[0]->get_money());
