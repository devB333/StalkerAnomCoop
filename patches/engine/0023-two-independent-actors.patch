+	const u64 stored = entity && view->actor.valid() ? entity->m_campaign_entity : 0;
+	Msg("S03-T03 map participant {%u,%u} state=%s player=%016I64x%016I64x entity=%I64u engine={%u,%u} stored=%I64u",
+		u32(ref.slot), ref.generation, participant_state_name(view->state), view->player.hi, view->player.lo,
+		view->actor.value, u32(view->actor_key.id), view->actor_key.generation, stored);
+	if (f.out)
