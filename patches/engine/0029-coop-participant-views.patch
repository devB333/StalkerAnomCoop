+// The world clock (CampaignEvent kind 1), every second and when the weather
+// changes: game time, time factor and the current weather, so every client
+// shows the server's time of day and sky. Payload: u64 game_ms, f32 factor,
+// u8 length, weather section.
+const u16 kEventWorldClock = 1;
+
+void send_world_clock()
+{
+	if (!ai().get_alife() || !g_pGamePersistent)
+		return;
+	const u32 now = g_host->wall.GetElapsed_ms();
+	const shared_str weather = g_pGamePersistent->Environment().CurrentWeatherName;
+	if (now - g_host->last_clock_ms < 1000 && weather == g_host->last_weather)
+		return;
+	g_host->last_clock_ms = now;
+	if (weather != g_host->last_weather)
+		g_host->log.line("weather %s", weather.size() ? *weather : "-");
+	g_host->last_weather = weather;
+	coop::proto::CampaignEvent event;
+	event.kind = kEventWorldClock;
+	event.revision = g_host->commit ? g_host->commit : 1;
+	const u64 game_ms = ai().alife().time_manager().game_time();
+	const float factor = ai().alife().time_manager().time_factor();
+	const u8* p = reinterpret_cast<const u8*>(&game_ms);
+	event.payload.assign(p, p + sizeof(game_ms));
+	p = reinterpret_cast<const u8*>(&factor);
+	event.payload.insert(event.payload.end(), p, p + sizeof(factor));
+	const u32 length = weather.size() ? _min(u32(weather.size()), 255u) : 0u;
+	event.payload.push_back(u8(length));
+	if (length)
+		event.payload.insert(event.payload.end(), *weather, *weather + length);
+	for (PlayerLink& link : g_host->links)
+		if (link.world == WorldLive && link.session)
+		{
+			event.event_id = ++g_host->event_seq;
+			link.outbox.push_back(coop::proto::Message(event));
+		}
+}
