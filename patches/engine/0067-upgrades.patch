+// ------------------------------------------------------------ S10-T04f
+// Upgrades and repairs at a mechanic (T04c-3, T01-7: on the server in the
+// buyer's context). The talk window's upgrade button opens an upgrade session
+// (kind 21) inside the talk; the server sends the upgrade table (CampaignEvent
+// 16): for every item of the player's inventory that has an upgrade scheme,
+// whether this mechanic upgrades it (the installed `can_upgrade_item`) and
+// each upgrade's install state (`Upgrade::can_install`: the installed
+// precondition functor reads the player's purse and the mechanic's tiers) and
+// price. The client's native upgrade window reads that table. An install or a
+// repair (kind 22) is checked again here, journaled as one `upgrade` record,
+// then applied through the engine's own path (`Manager::upgrade_install`,
+// whose effect functor charges the purse; the repair effect functor and
+// SetCondition(1)); CampaignEvent 17 tells every client to install the same
+// upgrade on its copy (loading mode, no charge). The installed scripts read
+// the mechanic through `get_speaker()`, i.e. the `used_npc_id` event a USE
+// sets in single player: it is set around every scripted step here.
+struct UpgradeSpeaker
+{
+	luabind::object saved;
+	bool set = false;
+	UpgradeSpeaker(CGameObject* npc)
+	{
+		luabind::functor<luabind::object> get;
+		luabind::functor<void> put;
+		if (npc && ai().script_engine().functor("_G.GetEvent", get) && ai().script_engine().functor("_G.SetEvent", put))
+		{
+			// initialised from the call: an assignment into a default object (no
+			// Lua state) pushed the call proxy itself and crashed (upgrade-4)
+			luabind::object previous = get("used_npc_id");
+			saved = previous;
+			put("used_npc_id", u32(npc->ID()));
+			set = true;
+		}
+	}
+	~UpgradeSpeaker()
+	{
+		luabind::functor<void> put;
+		if (set && ai().script_engine().functor("_G.SetEvent", put))
+			put("used_npc_id", saved);
+	}
+};
+
+static CInventoryOwner* upgrade_partner(const PlayerLink& link, CGameObject** object = nullptr)
+{
+	CGameObject* npc = link.upgrade_npc != 0xffff ? smart_cast<CGameObject*>(Level().Objects.net_Find(link.upgrade_npc)) :
+		nullptr;
+	if (object)
+		*object = npc;
+	return npc ? smart_cast<CInventoryOwner*>(npc) : nullptr;
+}
+
+void upgrade_close(PlayerLink& link, LPCSTR why)
+{
+	if (link.upgrade_npc == 0xffff)
+		return;
+	g_host->log.line("upgrade-close slot=%u npc=%u why=%s", u32(link.ref.slot), u32(link.upgrade_npc), why);
+	link.upgrade_npc = 0xffff;
+}
+
+// inventory_upgrades.get_upgrade_cost returns a text; the price it shows is
+// char_ini cost x cur_price_percent (mech_discount, set while can_upgrade_item
+// evaluates the mechanic's discount condlist; get_price_percent reads it)
+static u32 upgrade_install_price(const inventory::upgrade::Upgrade* up)
+{
+	float percent = 1.f;
+	luabind::functor<float> get_percent;
+	if (ai().script_engine().functor("inventory_upgrades.get_price_percent", get_percent))
+		percent = float(get_percent());
+	const u32 cost = READ_IF_EXISTS(pSettings, r_u32, up->section(), "cost", 0);
+	return u32(_max(0.f, floorf(float(cost) * percent)));
+}
+
+static u32 upgrade_repair_price(const CInventoryItem* item)
+{
+	// inventory_upgrades.how_much_repair (local there): cost x (1 - condition) x the repair eco factor
+	float eco = 1.67f;
+	luabind::functor<float> factor;
+	if (ai().script_engine().functor("game_difficulties.get_eco_factor", factor))
+		eco = factor("repair");
+	const u32 cost = READ_IF_EXISTS(pSettings, r_u32, item->m_section_id, "cost", 0);
+	return u32(_max(0.f, floorf(float(cost) * (1.f - clampr(item->GetCondition(), 0.f, 1.f)) * eco)));
+}
+
+// the upgrade table to the player (in his context, the mechanic as the speaker)
+static void upgrade_send_table(PlayerLink& link, LPCSTR why)
+{
+	CGameObject* npc = nullptr;
+	CInventoryOwner* mech = upgrade_partner(link, &npc);
+	CActor* actor = participant_actor(link.ref);
+	CInventoryOwner* me = actor ? smart_cast<CInventoryOwner*>(actor) : nullptr;
+	if (!mech || !me)
+		return;
+	struct Up
+	{
+		xr_string id;
+		u8 result;
+		u32 cost;
+	};
+	struct Entry
+	{
+		coop::proto::EntityRef ref;
+		u8 can_upgrade;
+		xr_vector<Up> ups;
+	};
+	xr_vector<Entry> entries;
+	u32 installable = 0;
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "upgrade-table");
+		UpgradeSpeaker speaker(npc);
+		luabind::functor<bool> can_up;
+		const bool have_can = ai().script_engine().functor("inventory_upgrades.can_upgrade_item", can_up);
+		inventory::upgrade::Manager& manager = ai().alife().inventory_upgrade_manager();
+		LPCSTR profile = mech->CharacterInfo().Profile().c_str();
+		for (PIItem item : me->inventory().m_all)
+		{
+			if (!item)
+				continue;
+			Entry e;
+			if (!entity_ref_of(item->object().ID(), e.ref))
+				continue;
+			inventory::upgrade::Root* root = manager.get_root(item->m_section_id);
+			if (!root)
+				continue; // no upgrade scheme: not listed
+			e.can_upgrade = have_can && can_up(item->m_section_id.c_str(), profile) ? 1 : 0;
+			for (inventory::upgrade::Upgrade* up : root->contained_upgrades())
+			{
+				Up u;
+				u.id = up->id_str();
+				u.result = u8(up->can_install(*item, false));
+				u.cost = upgrade_install_price(up);
+				if (u.result == u8(inventory::upgrade::result_ok))
+					++installable;
+				e.ups.push_back(u);
+			}
+			entries.push_back(e);
+		}
+	}
+	// per item: ref (12), u8 can_upgrade, u8 count, count x (u8 len, id, u8 result, u32 cost); parts of <= 900 bytes
+	xr_vector<std::vector<u8>> blobs;
+	for (const Entry& e : entries)
+	{
+		std::vector<u8> b;
+		put_entity_ref(b, e.ref);
+		put_u8(b, e.can_upgrade);
+		const u32 n = _min<u32>(u32(e.ups.size()), 64u);
+		put_u8(b, u8(n));
+		for (u32 i = 0; i < n; ++i)
+		{
+			const Up& u = e.ups[i];
+			const u32 len = _min<u32>(u32(u.id.size()), 128u);
+			put_u8(b, u8(len));
+			b.insert(b.end(), u.id.begin(), u.id.begin() + len);
+			put_u8(b, u.result);
+			put_u32(b, u.cost);
+		}
+		blobs.push_back(b);
+	}
+	xr_vector<std::pair<u32, u32>> parts; // [first, last) blobs per part
+	for (u32 i = 0; i < blobs.size();)
+	{
+		u32 bytes = 0, j = i;
+		while (j < blobs.size() && (j == i || bytes + blobs[j].size() <= 900))
+			bytes += u32(blobs[j++].size());
+		parts.push_back(std::make_pair(i, j));
+		i = j;
+	}
+	if (parts.empty())
+		parts.push_back(std::make_pair(0u, 0u));
+	const u32 count = _min<u32>(u32(parts.size()), 255u);
+	for (u32 part = 0; part < count; ++part)
+	{
+		std::vector<u8> p;
+		put_ref(p, link.upgrade_npc);
+		put_u8(p, u8(part));
+		put_u8(p, u8(count));
+		put_u32(p, actor->get_money());
+		put_u8(p, u8(parts[part].second - parts[part].first));
+		for (u32 i = parts[part].first; i < parts[part].second; ++i)
+			p.insert(p.end(), blobs[i].begin(), blobs[i].end());
+		queue_event(link, 16, p);
+	}
+	++g_host->upgrade_tables_sent;
+	g_host->log.line("upgrade-table slot=%u npc=%u items=%u installable=%u parts=%u money=%u why=%s", u32(link.ref.slot),
+		u32(link.upgrade_npc), u32(entries.size()), installable, count, actor->get_money(), why);
+}
+
+// CampaignEvent 17: an upgrade installed on an item (op 1) or its repair (op 2), to every client
+static void upgrade_event(u16 item_id, u8 op, LPCSTR upgrade_id)
+{
+	std::vector<u8> p;
+	put_ref(p, item_id);
+	put_u8(p, op);
+	const u32 len = _min<u32>(u32(xr_strlen(upgrade_id)), 128u);
+	put_u8(p, u8(len));
+	p.insert(p.end(), upgrade_id, upgrade_id + len);
+	broadcast_event(17, p);
+}
+
+// Anomaly's mechanics: the engine's character flag (mechanic_mode, which the
+// installed character descriptions comment out) or a section of the installed
+// misc\stalkers_upgrade_info.ltx (the script's param_ini: tiers, discounts)
+static bool is_mechanic_section(LPCSTR section)
+{
+	static CInifile* mechanics = nullptr;
+	if (!mechanics)
+	{
+		string_path path;
+		FS.update_path(path, "$game_config$", "misc\\stalkers_upgrade_info.ltx");
+		mechanics = xr_new<CInifile>(path, TRUE, TRUE, FALSE);
+	}
+	return section && mechanics->section_exist(section);
+}
+
+static bool is_mechanic(CInventoryOwner* owner, CGameObject* npc)
+{
+	return owner && npc && (owner->SpecificCharacter().upgrade_mechanic() || is_mechanic_section(*npc->cNameSect()));
+}
+
+// the upgrade session for a player and the mechanic he talks to (kind 21, or
+// the dialogue phrase dialogs.npc_is_tech, whose npc:start_upgrade would open
+// a window in the server process)
+u16 upgrade_open_for(PlayerLink& link, u16 npc_id, CActor* actor)
+{
+	if (npc_id == kNoEngineId || link.talk_npc != npc_id)
+	{
+		++g_host->upgrades_refused;
+		g_host->log.line("upgrade-refused slot=%u npc=%u why=not-talking talk=%u", u32(link.ref.slot), u32(npc_id),
+			u32(link.talk_npc));
+		return coop::proto::kReasonNotTalking;
+	}
+	CGameObject* npc = smart_cast<CGameObject*>(Level().Objects.net_Find(npc_id));
+	CInventoryOwner* mech = npc ? smart_cast<CInventoryOwner*>(npc) : nullptr;
+	CEntityAlive* alive = npc ? smart_cast<CEntityAlive*>(npc) : nullptr;
+	if (!mech || !alive || !alive->g_Alive() || !is_mechanic(mech, npc))
+	{
+		++g_host->upgrades_refused;
+		g_host->log.line("upgrade-refused slot=%u npc=%u why=not-a-mechanic", u32(link.ref.slot), u32(npc_id));
+		return coop::proto::kReasonNoMechanic;
+	}
+	if (link.upgrade_npc != npc_id)
+	{
+		upgrade_close(link, "reopened");
+		link.upgrade_npc = npc_id;
+		++g_host->upgrades_opened;
+		g_host->log.line("upgrade-open slot=%u actor=%u npc=%u name=%s", u32(link.ref.slot), u32(actor->ID()), u32(npc_id),
+			mech->Name());
+	}
+	upgrade_send_table(link, "open");
+	return 0;
+}
+
+u16 take_upgrade_open(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (!intent.params.empty())
+		return coop::proto::kReasonMalformed;
+	CActor* actor = nullptr;
+	if (!trade_context_actor(link, actor))
+		return coop::proto::kReasonNoActor;
+	const u16 reason = upgrade_open_for(link, engine_id_of(intent.target), actor);
+	result.revision = g_host->commit;
+	return reason;
+}
+
+u16 take_upgrade_close(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	upgrade_close(link, "client");
+	result.revision = g_host->commit;
+	return 0;
+}
+
+// the server entity keeps the item's upgrades for the checkpoint and for a
+// joining client's spawn (GE_INSTALL_UPGRADE does it on the live path; a
+// replay installs in loading mode, which sends no event)
+static void upgrade_sync_entity(u16 item_id, LPCSTR upgrade_id)
+{
+	CSE_ALifeInventoryItem* se = smart_cast<CSE_ALifeInventoryItem*>(ai().alife().objects().object(item_id, true));
+	if (se && !se->has_upgrade(upgrade_id))
+		se->add_upgrade(upgrade_id);
+}
+
+u16 take_upgrade(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	CoopPersistence* persistence = g_host->persistence;
+	// 1. Receive: a known operation returns its stored outcome.
+	StoredOutcome stored;
+	if (persistence && persistence->lookup(link.player, intent.operation_id, stored))
+	{
+		result.outcome = coop::proto::ActionOutcome(stored.outcome);
+		result.reason = stored.reason;
+		result.commit_id = stored.revision;
+		result.revision = stored.revision;
+		g_host->log.line("upgrade-duplicate player=%s operation=%I64u outcome=%u revision=%I64u",
+			coop_uuid_hex(link.player).c_str(), intent.operation_id, u32(stored.outcome), stored.revision);
+		return stored.reason;
+	}
+	// 2. Prepare / validate.
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (intent.params.size() < 2)
+		return coop::proto::kReasonMalformed;
+	const u8 op = intent.params[0], len = intent.params[1];
+	if ((op != 1 && op != 2) || intent.params.size() != 2u + len || (op == 1 && len == 0) || (op == 2 && len != 0))
+		return coop::proto::kReasonMalformed;
+	xr_string upgrade_id(reinterpret_cast<const char*>(intent.params.data() + 2), len);
+	CActor* actor = nullptr;
+	coop::proto::EntityRef actor_ref;
+	u16 id = kNoEngineId;
+	CInventoryItem* item = nullptr;
+	if (const u16 reason = own_inventory_item(link, intent, actor, actor_ref, id, item))
+		return reason;
+	CGameObject* npc = nullptr;
+	CInventoryOwner* mech = upgrade_partner(link, &npc);
+	if (!mech || link.talk_npc != link.upgrade_npc)
+	{
+		++g_host->upgrades_refused;
+		g_host->log.line("upgrade-refused slot=%u item=%u why=no-open-session upgrade_npc=%u talk=%u", u32(link.ref.slot),
+			u32(id), u32(link.upgrade_npc), u32(link.talk_npc));
+		return coop::proto::kReasonNoMechanic;
+	}
+	const u32 money = actor->get_money();
+	u32 price = 0;
+	LPCSTR refused = nullptr;
+	u16 refusal = coop::proto::kReasonUpgradeRefused;
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "upgrade-check");
+		UpgradeSpeaker speaker(npc);
+		LPCSTR profile = mech->CharacterInfo().Profile().c_str();
+		if (op == 1)
+		{
+			inventory::upgrade::Manager& manager = ai().alife().inventory_upgrade_manager();
+			inventory::upgrade::Root* root = manager.get_root(item->m_section_id);
+			inventory::upgrade::Upgrade* up = manager.get_upgrade(shared_str(upgrade_id.c_str()));
+			if (root && (!up || !root->contain_upgrade(shared_str(upgrade_id.c_str()))))
+			{
+				// the id may be the upgrade's effect section (the installed Lua window
+				// passes the element id; a script may pass the section)
+				up = nullptr;
+				for (inventory::upgrade::Upgrade* candidate : root->contained_upgrades())
+					if (!xr_strcmp(candidate->section(), upgrade_id.c_str()) || !xr_strcmp(candidate->id_str(), upgrade_id.c_str()))
+					{
+						up = candidate;
+						upgrade_id = candidate->id_str();
+						break;
+					}
+			}
+			luabind::functor<bool> can_up;
+			if (!up || !root)
+				refused = "unknown-upgrade";
+			else if (!ai().script_engine().functor("inventory_upgrades.can_upgrade_item", can_up) ||
+				!can_up(item->m_section_id.c_str(), profile))
+				refused = "mechanic-declines";
+			else
+			{
+				const inventory::upgrade::UpgradeStateResult res = up->can_install(*item, false);
+				if (res == inventory::upgrade::result_e_precondition_money)
+				{
+					refused = "no-money";
+					refusal = coop::proto::kReasonNoMoney;
+				}
+				else if (res != inventory::upgrade::result_ok)
+					refused = res == inventory::upgrade::result_e_installed ? "installed" :
+						res == inventory::upgrade::result_e_unknown ? "unknown" :
+						res == inventory::upgrade::result_e_parents ? "parents" :
+						res == inventory::upgrade::result_e_group ? "group" : "precondition";
+				else
+					price = upgrade_install_price(up);
+			}
+		}
+		else
+		{
+			luabind::functor<bool> can_rep;
+			if (item->GetCondition() > 0.99f)
+				refused = "not-worn";
+			else if (!ai().script_engine().functor("inventory_upgrades.can_repair_item", can_rep) ||
+				!can_rep(item->m_section_id.c_str(), item->GetCondition(), profile))
+				refused = "not-repairable";
+			else
+			{
+				price = upgrade_repair_price(item);
+				if (money < price)
+				{
+					refused = "no-money";
+					refusal = coop::proto::kReasonNoMoney;
+				}
+			}
+		}
+	}
+	if (refused)
+	{
+		++g_host->upgrades_refused;
+		g_host->log.line("upgrade-refused slot=%u op=%u item=%u section=%s upgrade=%s why=%s price=%u money=%u",
+			u32(link.ref.slot), u32(op), u32(id), *item->object().cNameSect(), upgrade_id.c_str(), refused, price, money);
+		return refusal;
+	}
+	if (!persistence || persistence->failed())
+	{
+		++g_host->ledger_store_failed;
+		return kActionReasonStoreFailed;
+	}
+	// 3. Resolve: the absolute post-state.
+	UpgradeRecord record;
+	record.slot = link.ref.slot;
+	record.player = link.player;
+	record.operation = intent.operation_id;
+	record.npc_entity = entity_of(link.upgrade_npc);
+	record.actor_entity = actor_ref.id;
+	record.item_entity = intent.target.id;
+	record.op = op;
+	record.upgrade_id = upgrade_id;
+	record.price = price;
+	record.actor_money_after = money >= price ? money - price : 0;
+	const u64 revision = ++g_host->commit;
+	// 4. Durable commit, before anything is applied or acknowledged.
+	if (!coop::store::failpoint("upgrade:before-append"))
+		persistence->fail_closed("failpoint upgrade:before-append");
+	if (!persistence->commit(coop::store::kRecordUpgrade, g_host->tick, revision, encode_upgrade(record)))
+	{
+		++g_host->ledger_store_failed;
+		g_host->log.line("upgrade-store-failed revision=%I64u operation=%I64u reason=%s", revision, intent.operation_id,
+			persistence->failure());
+		g_host->stop_requested = true;
+		return kActionReasonStoreFailed;
+	}
+	coop::store::failpoint("upgrade:after-flush");
+	++g_host->upgrades_committed;
+	g_host->log.line("upgrade-committed revision=%I64u slot=%u operation=%I64u op=%u item=%u item_entity=%I64u section=%s "
+		"upgrade=%s price=%u money=%u->%u", revision, u32(link.ref.slot), intent.operation_id, u32(op), u32(id),
+		record.item_entity, *item->object().cNameSect(), upgrade_id.c_str(), price, money, record.actor_money_after);
+	// 5. Apply: the engine's own path in the buyer's context.
+	bool applied = false;
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "upgrade-apply");
+		UpgradeSpeaker speaker(npc);
+		if (op == 1)
+		{
+			applied = ai().alife().inventory_upgrade_manager().upgrade_install(*item, shared_str(upgrade_id.c_str()), false);
+			if (applied)
+			{
+				upgrade_sync_entity(id, upgrade_id.c_str());
+				luabind::functor<void> after; // as CUIInventoryUpgradeWnd::OnMesBoxYes: the mechanic feature (lending)
+				if (ai().script_engine().functor("inventory_upgrades.effect_upgrade_item", after))
+					after(item->object().lua_game_object(), upgrade_id.c_str());
+			}
+		}
+		else
+		{
+			luabind::functor<void> effect; // as CUIActorMenu::RepairEffect_CurItem: the charge and the mechanic feature
+			if (ai().script_engine().functor("inventory_upgrades.effect_repair_item", effect))
+				effect(item->m_section_id.c_str(), item->GetCondition());
+			item->SetCondition(1.f);
+			applied = true;
+		}
+		actor->set_money(record.actor_money_after, false);
+	}
+	coop::store::failpoint("upgrade:after-apply");
+	g_host->log.line("upgrade-applied revision=%I64u op=%u item=%u applied=%d has_upgrade=%d condition=%.2f money=%u "
+		"owner=%u", revision, u32(op), u32(id), applied ? 1 : 0,
+		op == 1 ? (item->has_upgrade(shared_str(upgrade_id.c_str())) ? 1 : 0) : -1, item->GetCondition(),
+		actor->get_money(), item->object().H_Parent() ? u32(item->object().H_Parent()->ID()) : 0xffffu);
+	StoredOutcome outcome = {u8(coop::proto::ActionOutcome::Accepted), 0, revision};
+	persistence->remember(link.player, intent.operation_id, outcome);
+	result.outcome = coop::proto::ActionOutcome::Accepted;
+	result.reason = 0;
+	result.commit_id = revision;
+	result.revision = revision;
+	upgrade_event(id, op, upgrade_id.c_str());
+	upgrade_send_table(link, "applied");
+	return 0;
+}
