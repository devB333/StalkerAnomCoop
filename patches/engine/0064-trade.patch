+// ------------------------------------------------------------ S10-T04c: trade
+// The trade window on the server's trade. The remote talk window's trade
+// button sends the open intent; the server answers with the price table
+// (CampaignEvent 15, in parts); on the last part the native window opens
+// (CUIGameSP::StartTrade against the replica trader) and CTrade::GetItemPrice
+// reads the table. A buy or sell button sends the items as one trade intent;
+// nothing moves locally: the server's Reparent events move the items and the
+// needs event brings the purse, and the window's lists are rebuilt from them.
+static void trade_refresh_menu()
+{
+	CUIGameSP* ui = smart_cast<CUIGameSP*>(CurrentGameUI());
+	if (!ui || ui->GetActorMenu().GetMenuMode() != mmTrade)
+		return;
+	ui->GetActorMenu().CoopTradeRefresh();
+	++g_link->trade.refreshes;
+}
+
+void on_trade_prices(const coop::proto::CampaignEvent& event)
+{
+	const std::vector<u8>& b = event.payload;
+	if (b.size() < 12 + 2 + 8 + 1)
+		return;
+	coop::proto::EntityRef ref;
+	for (int i = 0; i < 8; ++i)
+		ref.id |= u64(b[i]) << (8 * i);
+	for (int i = 0; i < 4; ++i)
+		ref.generation |= u32(b[8 + i]) << (8 * i);
+	PayloadReader r(b);
+	r.at = 12;
+	const u8 part = r.get<u8>();
+	const u8 parts = r.get<u8>();
+	const u32 actor_money = r.get<u32>();
+	const u32 trader_money = r.get<u32>();
+	const u8 count = r.get<u8>();
+	Link::Trade& t = g_link->trade;
+	const u16 npc_id = id_of(ref);
+	if (!r.ok || npc_id == 0xffff || !parts || part >= parts)
+		return;
+	++t.price_events;
+	if (part == 0 || t.npc != npc_id)
+	{
+		t.buy.clear();
+		t.sell.clear();
+		t.parts_seen = 0;
+	}
+	u32 unknown = 0;
+	for (u8 i = 0; i < count && r.ok; ++i)
+	{
+		const u8 side = r.get<u8>();
+		coop::proto::EntityRef item_ref;
+		item_ref.id = r.get<u64>();
+		item_ref.generation = r.get<u32>();
+		const u32 price = r.get<u32>();
+		if (!r.ok)
+			break;
+		const u16 item = id_of(item_ref);
+		if (item == 0xffff)
+		{
+			++unknown;
+			continue;
+		}
+		(side ? t.sell : t.buy)[item] = price;
+	}
+	t.npc = npc_id;
+	t.npc_ref = ref;
+	t.actor_money = actor_money;
+	t.trader_money = trader_money;
+	++t.parts_seen;
+	if (part + 1 < parts)
+		return;
+	t.pending_open = false;
+	if (g_actor && g_actor->get_money() != actor_money)
+		g_actor->set_money(actor_money, false);
+	CInventoryOwner* partner = smart_cast<CInventoryOwner*>(Level().Objects.net_Find(npc_id));
+	if (partner && g_actor && partner->get_money() != trader_money)
+		partner->set_money(trader_money, false);
+	g_link->log.line("trade-prices npc=%u parts=%u buy=%u sell=%u unknown=%u money=%u trader_money=%u open=%d", u32(npc_id),
+		u32(parts), u32(t.buy.size()), u32(t.sell.size()), unknown, actor_money, trader_money, t.open ? 1 : 0);
+	if (t.open)
+	{
+		t.refresh_at_ms = g_link->wall.GetElapsed_ms() + 1;
+		return;
+	}
+	CUIGameSP* ui = smart_cast<CUIGameSP*>(CurrentGameUI());
+	if (!partner || !ui || !g_actor)
+	{
+		g_link->log.line("trade-open-failed npc=%u partner=%d ui=%d", u32(npc_id), partner ? 1 : 0, ui ? 1 : 0);
+		request_ownership(coop::proto::kActionTradeClose, ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, false, "unshowable");
+		return;
+	}
+	t.open = true;
+	++t.opens;
+	ui->StartTrade(smart_cast<CInventoryOwner*>(g_actor), partner);
+	g_link->log.line("trade-open npc=%u name=%s mode=%d", u32(npc_id), partner->Name(), int(ui->GetActorMenu().GetMenuMode()));
+}
+
+static void trade_result(const Link::PickupPending& p, const coop::proto::ActionResult& result)
+{
+	Link::Trade& t = g_link->trade;
+	const bool accepted = result.outcome == coop::proto::ActionOutcome::Accepted;
+	if (p.action == coop::proto::kActionTradeOpen)
+	{
+		if (!accepted)
+		{
+			t.pending_open = false;
+			_give_news(result.reason == coop::proto::kReasonNotTrading ? "Co-op: this character does not trade" :
+				"Co-op: the trade could not be opened", "", "ui_inGame2_Mesta_evakuatsii", 0, 6000, 0);
+		}
+		g_link->log.line("trade-open-result outcome=%u reason=%u", u32(result.outcome), u32(result.reason));
+		return;
+	}
+	if (p.action == coop::proto::kActionTrade)
+	{
+		t.pending_perform = false;
+		++(accepted ? t.accepted : t.refused);
+		CUIGameSP* ui = smart_cast<CUIGameSP*>(CurrentGameUI());
+		if (!accepted && ui && ui->GetActorMenu().GetMenuMode() == mmTrade)
+			ui->GetActorMenu().CoopTradeRefused(result.reason == coop::proto::kReasonNoMoney);
+		if (accepted)
+			t.refresh_at_ms = g_link->wall.GetElapsed_ms() + 50;
+		g_link->log.line("trade-result outcome=%u reason=%u commit=%I64u", u32(result.outcome), u32(result.reason),
+			result.commit_id);
+	}
+}
+
 } // namespace
 
