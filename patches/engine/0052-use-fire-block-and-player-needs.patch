+	"      for m, t in pairs(mods) do\n"
+	"        out[slot][m] = {}\n"
+	"        for k, v in pairs(t) do if not transient[k] then out[slot][m][k] = out_value(v) end end\n"
+	"      end\n"
+	"    end\n"
+	"  end\n"
+	"  m_data.coop_needs = out\n"
+	"end\n"
+	"local st = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state()\n"
+	"P.restored = 0\n"
+	"if st and type(st.coop_needs) == 'table' then\n"
+	"  for slot, mods in pairs(st.coop_needs) do\n"
+	"    if slot ~= 0 then\n"
+	"      P.slots[slot] = {}\n"
+	"      for m, t in pairs(mods) do\n"
+	"        P.slots[slot][m] = {}\n"
+	"        for k, v in pairs(t) do P.slots[slot][m][k] = in_value(v) end\n"
+	"      end\n"
+	"      P.restored = P.restored + 1\n"
+	"    end\n"
+	"  end\n"
+	"end\n"
+	"if RegisterScriptCallback then RegisterScriptCallback('save_state', P.save) end\n"
+	"P.unregistered = 0\n"
+	"for _, m in ipairs({ 'actor_status_thirst', 'actor_status_sleep', 'arszi_psy' }) do\n"
+	"  local mod = rawget(_G, m) or _G[m]\n"
+	"  if mod and mod.actor_on_update and axr_main and axr_main.callback_unset then\n"
+	"    axr_main.callback_unset('actor_on_update', mod.actor_on_update)\n"
+	"    P.unregistered = P.unregistered + 1\n"
+	"  end\n"
+	"end\n";
+
+// Pushes __campaign_needs.module_table(slot, module) (nil when missing).
+bool push_needs_table(lua_State* L, u8 slot, LPCSTR module)
+{
+	lua_getglobal(L, "__campaign_needs");
+	if (!lua_istable(L, -1))
+	{
+		lua_pop(L, 1);
+		return false;
+	}
+	lua_getfield(L, -1, "module_table");
+	lua_remove(L, -2);
+	lua_pushnumber(L, slot);
+	lua_pushstring(L, module);
+	if (lua_pcall(L, 2, 1, 0) != 0 || !lua_istable(L, -1))
+	{
+		lua_pop(L, 1);
+		return false;
+	}
+	return true;
+}
+
+// The scripts' variables: participant `from`'s values out, `to`'s in.
+void needs_swap(u8 from, u8 to)
+{
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return;
+	const int top = lua_gettop(L);
+	for (const NeedsSpec& spec : kNeeds)
+		for (LPCSTR name : spec.names)
+		{
+			const int at = campaign::script_module_upvalue(L, spec.module, name); // the function on top
+			if (!at)
+				continue;
+			const int fn = lua_gettop(L);
+			if (push_needs_table(L, from, spec.module))
+			{
+				lua_getupvalue(L, fn, at);
+				lua_setfield(L, -2, name);
+				lua_pop(L, 1);
+			}
+			if (push_needs_table(L, to, spec.module))
+			{
+				lua_getfield(L, -1, name);
+				lua_remove(L, -2);
+				lua_setupvalue(L, fn, at);
+			}
+			lua_settop(L, fn - 1);
+		}
+	lua_settop(L, top);
+	lua_getglobal(L, "__campaign_needs");
+	if (lua_istable(L, -1))
+	{
+		lua_pushnumber(L, to);
+		lua_setfield(L, -2, "current");
+	}
+	lua_pop(L, 1);
+}
+
+void needs_switch(u8 slot)
+{
+	if (!g_host || !g_host->needs_adapter)
+		return;
+	const u8 to = slot == 0xff ? 0 : slot;
+	if (to == g_host->needs_current)
+		return;
+	needs_swap(g_host->needs_current, to);
+	g_host->needs_current = to;
+	++g_host->needs_swaps;
+}
+
+// A number the scripts hold in an upvalue (or a field of a table upvalue).
+float needs_number(lua_State* L, LPCSTR module, LPCSTR name, LPCSTR field)
+{
+	float value = -1.f;
+	const int top = lua_gettop(L);
+	const int at = campaign::script_module_upvalue(L, module, name);
+	if (at)
+	{
+		lua_getupvalue(L, -1, at);
+		if (field && lua_istable(L, -1))
+			lua_getfield(L, -1, field);
+		if (lua_isnumber(L, -1))
+			value = float(lua_tonumber(L, -1));
+	}
+	lua_settop(L, top);
+	return value;
+}
+
+bool needs_feature_on(lua_State* L, LPCSTR module)
+{
+	const int top = lua_gettop(L);
+	const int at = campaign::script_module_upvalue(L, module, "feature_state");
+	bool on = true; // a module without the switch (arszi_psy) is always on
+	if (at)
+	{
+		lua_getupvalue(L, -1, at);
+		on = lua_toboolean(L, -1) != 0;
+	}
+	lua_settop(L, top);
+	return on;
+}
+
+// One participant's values (thirst, sleep, psy health): its copy swapped in, read, swapped back.
+void needs_values(u8 slot, float out[3])
+{
+	out[0] = out[1] = out[2] = -1.f;
+	lua_State* L = ai().script_engine().lua();
+	if (!L || !g_host->needs_adapter)
+		return;
+	const u8 was = g_host->needs_current;
+	needs_switch(slot);
+	out[0] = needs_number(L, "actor_status_thirst", "last_drink", nullptr);
+	out[1] = needs_number(L, "actor_status_sleep", "last_sleep", nullptr);
+	out[2] = needs_number(L, "arszi_psy", "psy_table", "actor_psy_health");
+	needs_switch(was);
+}
+
+void install_needs_adapter()
+{
+	if (g_host->needs_adapter)
+		return;
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return;
+	if (luaL_loadbuffer(L, needs_source, xr_strlen(needs_source), "campaign_needs") != 0 || lua_pcall(L, 0, 0, 0) != 0)
+	{
+		g_host->log.line("needs-adapter-failed error=%s", lua_tostring(L, -1));
+		lua_pop(L, 1);
+		return;
+	}
+	g_host->needs_adapter = true;
+	g_host->needs_current = 0;
+	campaign::set_context_switch_hook(needs_switch);
+	luabind::object P = luabind::get_globals(L)["__campaign_needs"];
+	auto num = [&](LPCSTR k) {
+		return P.type() == LUA_TTABLE && luabind::object(P[k]).type() == LUA_TNUMBER ?
+			luabind::object_cast<int>(P[k]) : -1;
+	};
+	u32 found = 0;
+	for (const NeedsSpec& spec : kNeeds)
+		for (LPCSTR name : spec.names)
+		{
+			const int top = lua_gettop(L);
+			found += campaign::script_module_upvalue(L, spec.module, name) ? 1 : 0;
+			lua_settop(L, top);
+		}
+	g_host->log.line("needs-adapter installed variables=%u unregistered=%d restored_slots=%d thirst_on=%d sleep_on=%d",
+		found, num("unregistered"), num("restored"), needs_feature_on(L, "actor_status_thirst") ? 1 : 0,
+		needs_feature_on(L, "actor_status_sleep") ? 1 : 0);
+	for (u8 slot = 0; slot < 2; ++slot)
+	{
+		float v[3];
+		needs_values(slot, v);
+		g_host->log.line("needs-restored slot=%u thirst=%.1f sleep=%.1f psy=%.4f", u32(slot), v[0], v[1], v[2]);
+	}
+}
+
+// Every tick: each live participant's survival update, in its context; its
+// values to its client (CampaignEvent 12: f32 thirst, sleep, psy health;
+// -1 when that module is off), when they change or every 10 s, and at once
+// to a client entering the world.
+void drive_needs()
+{
+	if (!g_host->needs_adapter)
+		return;
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return;
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		if (!actor || !actor->g_Alive())
+			continue;
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "needs-update");
+		if (!scope.entered())
+			continue;
+		for (const NeedsSpec& spec : kNeeds)
+		{
+			if (!needs_feature_on(L, spec.module))
+				continue;
+			const int top = lua_gettop(L);
+			lua_getglobal(L, spec.module);
+			if (lua_istable(L, -1))
+			{
+				lua_getfield(L, -1, "actor_on_update");
+				if (lua_isfunction(L, -1) && lua_pcall(L, 0, 0, 0) != 0)
+				{
+					if (!g_host->needs_errors++)
+						g_host->log.line("needs-update-failed module=%s error=%s", spec.module, lua_tostring(L, -1));
+				}
+			}
+			lua_settop(L, top);
+		}
+	}
+	if (g_host->tick % 50)
+		return;
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!client_in_world(link))
+		{
+			link.needs_sent_ms = 0;
+			continue;
+		}
+		float v[3];
+		needs_values(link.ref.slot, v);
+		const u32 now = host_ms();
+		bool changed = !link.needs_sent_ms || now - link.needs_sent_ms >= 10000;
+		for (int i = 0; i < 3; ++i)
+			changed = changed || _abs(v[i] - link.needs_last[i]) > (i == 2 ? 0.005f : 1.f);
+		if (!changed)
+			continue;
+		std::vector<u8> payload;
+		for (int i = 0; i < 3; ++i)
+		{
+			put_f32(payload, v[i]);
+			link.needs_last[i] = v[i];
+		}
+		queue_event(link, 12, payload);
+		link.needs_sent_ms = now ? now : 1;
+		g_host->log.line("needs slot=%u thirst=%.1f sleep=%.1f psy=%.4f", u32(link.ref.slot), v[0], v[1], v[2]);
+	}
+}
