+// ------------------------------------------------------------ S10-T03d
+// Guides, fast travel and the backpack as party travel (matrix F10, decision
+// T01-9). The installed scripts end with ChangeLevel(position, level vertex,
+// game vertex) after skipping the trip's time (level.change_game_time) and, for
+// a guide, taking its fee. On a co-op client (fast travel, the backpack: the
+// PDA map) the skip is only noted and ChangeLevel or the own actor's
+// set_actor_position becomes a relocate request (ActionIntent 26); on the
+// server a guide's ChangeLevel in the player's context (the dialogue) becomes
+// the same request, its held skip and noted fee attached. Either way it is a
+// travel proposal like a level changer's (CampaignEvent 13, the partner's kind
+// 12), to a point instead of a changer, executed by the S09 executor (a
+// same-level one too: the level is reloaded with both actors at the point). The
+// trip's time skips once, when it is agreed; a fee is refunded when it is not.
+void apply_game_time_minutes(u32 minutes, bool forwarded)
+{
+	if (!minutes)
+		return;
+	campaign::GameTimeChangeDirect direct;
+	string1024 chunk;
+	xr_sprintf(chunk, "level.change_game_time(0, 0, %u)\n%s", minutes, forwarded ?
+		"pcall(function() surge_manager.get_surge_manager().time_forwarded = true end)\n"
+		"pcall(function() psi_storm_manager.get_psi_storm_manager().time_forwarded = true end)\n"
+		"pcall(function() level_weathers.get_weather_manager():forced_weather_change() end)" : "");
+	sleep_lua(nullptr, chunk, "relocate-skip");
+}
+
+void relocation_end(const coop::proto::Transition& t)
+{
+	Host::Travel& tv = g_host->travel;
+	if (t.state == coop::proto::TravelState::Agreed)
+	{
+		const double before = sleep_game_hours();
+		apply_game_time_minutes(tv.skip_minutes, true);
+		++tv.skips;
+		g_host->log.line("relocate-agreed id=%I64x minutes=%u game_hours=%.3f->%.3f fee=%d source=%u", t.id, tv.skip_minutes,
+			before, sleep_game_hours(), tv.fee, u32(tv.relocation_source));
+	}
+	else if (tv.fee > 0)
+	{
+		// the trip did not happen: the requester gets its fee back
+		bool refunded = false;
+		for (PlayerLink& l : g_host->links)
+			if (l.bound && l.ref.slot == tv.fee_slot)
+				if (CActor* a = participant_actor(l.ref))
+				{
+					string128 chunk;
+					xr_sprintf(chunk, "if db.actor then db.actor:give_money(%d) end", tv.fee);
+					refunded = sleep_lua(a, chunk, "relocate-refund");
+				}
+		++tv.refunds;
+		g_host->log.line("relocate-refund id=%I64x state=%s fee=%d slot=%u refunded=%d", t.id, coop::proto::to_string(t.state),
+			tv.fee, u32(tv.fee_slot), refunded ? 1 : 0);
+	}
+	if (t.state != coop::proto::TravelState::Agreed)
+		tv.relocation = false;
+	tv.fee = 0;
+	tv.skip_minutes = 0;
+}
+
+// The proposal to a point. 0 or a refusal reason.
+u16 relocate_propose(PlayerLink& link, const Fvector& position, u32 lvid, u16 gvid, u32 minutes, s32 fee, u8 source,
+	u64 operation, u64& id)
+{
+	Host::Travel& tv = g_host->travel;
+	if (!tv.coordinator)
+		return coop::proto::kReasonNoActor;
+	if (tv.exec)
+		return coop::proto::kReasonTravelInProgress;
+	if (g_host->sleep.coordinator && g_host->sleep.coordinator->live())
+		return coop::proto::kReasonTravelBusy;
+	CActor* actor = participant_actor(link.ref);
+	if (!actor || !actor->g_Alive())
+		return coop::proto::kReasonNoActor;
+	if (!ai().get_game_graph() || !ai().game_graph().valid_vertex_id(gvid) || !_valid(position))
+		return coop::proto::kReasonMalformed;
+	const xr_string level = *ai().game_graph().header().level(ai().game_graph().vertex(gvid)->level_id()).name();
+	const bool same_level = level == Level().name().c_str();
+	if (same_level && !ai().level_graph().valid_vertex_id(lvid))
+		return coop::proto::kReasonMalformed;
+	PlayerLink* partner = travel_partner(link.ref.slot);
+	CActor* partner_actor = partner ? participant_actor(partner->ref) : nullptr;
+	if (!partner || !client_in_world(*partner) || !partner_actor || !partner_actor->g_Alive())
+		return coop::proto::kReasonPartnerUnavailable;
+	string256 who;
+	if (party_in_combat(who))
+	{
+		g_host->log.line("relocate-in-combat slot=%u enemy=%s", u32(link.ref.slot), who);
+		return coop::proto::kReasonInCombat;
+	}
+	coop::proto::Transition t;
+	const coop::proto::TravelVerdict verdict = tv.coordinator->propose(link.ref.slot, partner->ref.slot, gvid,
+		g_host->wall.GetElapsed_ms(), t);
+	if (verdict == coop::proto::TravelVerdict::Busy)
+		return coop::proto::kReasonTravelBusy;
+	if (verdict != coop::proto::TravelVerdict::Ok)
+		return coop::proto::kReasonWrongParty;
+	tv.changer = kNoEngineId;
+	tv.relocation = true;
+	tv.relocation_source = source;
+	tv.level = level;
+	tv.position = position;
+	tv.graph_vertex = GameGraph::_GRAPH_ID(gvid);
+	tv.level_vertex = lvid;
+	tv.angles.set(0.f, 0.f, 0.f);
+	tv.skip_minutes = minutes;
+	tv.fee = fee;
+	tv.fee_slot = link.ref.slot;
+	++tv.proposals;
+	++tv.relocations;
+	id = t.id;
+	g_host->log.line("relocate-proposed id=%I64x requester=%u partner=%u source=%u level=%s same_level=%d pos=%.2f,%.2f,%.2f "
+		"gvid=%u lvid=%u minutes=%u fee=%d distance=%.1f operation=%I64x", t.id, u32(t.requester), u32(t.partner), u32(source),
+		level.c_str(), same_level ? 1 : 0, VPUSH(position), u32(gvid), lvid, minutes, fee,
+		same_level ? actor->Position().distance_to(position) : -1.f, operation);
+	travel_csv("proposed", link.ref.slot, operation, t.id, 0, "relocate", level.c_str());
+	travel_event(t, u32(t.deadline_ms - t.proposed_ms));
+	return 0;
+}
+
+u16 take_relocate(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	u16 reason = 0;
+	if (travel_known(link, intent, result, reason))
+		return reason;
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	const std::vector<u8>& p = intent.params;
+	if (p.size() != 2 + 4 + 12 + 2 + 1)
+		return coop::proto::kReasonMalformed;
+	u16 gvid = u16(p[0] | (p[1] << 8));
+	u32 lvid = 0;
+	memcpy(&lvid, p.data() + 2, 4);
+	Fvector at;
+	memcpy(&at.x, p.data() + 6, 4);
+	memcpy(&at.y, p.data() + 10, 4);
+	memcpy(&at.z, p.data() + 14, 4);
+	const u16 minutes = u16(p[18] | (p[19] << 8));
+	const u8 source = p[20];
+	if (minutes > 24 * 60 || source < 1 || source > 3)
+		return coop::proto::kReasonMalformed;
+	u64 id = 0;
+	reason = relocate_propose(link, at, lvid, gvid, minutes, 0, source, intent.operation_id, id);
+	if (reason)
+	{
+		g_host->log.line("relocate-refused slot=%u reason=%u gvid=%u lvid=%u source=%u", u32(link.ref.slot), u32(reason),
+			u32(gvid), lvid, u32(source));
+		return reason;
+	}
+	travel_remember(link, intent.operation_id, 0, id);
+	result.commit_id = 0;
+	result.revision = id;
+	return 0;
+}
+
+void relocate_tick()
+{
+	for (PlayerLink& l : g_host->links)
+		if (l.pending_skip_minutes && g_host->tick > l.pending_skip_tick)
+		{
+			// asked in a player's script but no travel took it (an anabiotic, a
+			// script's own skip): applied as the script asked, one tick late
+			const u32 m = l.pending_skip_minutes;
+			l.pending_skip_minutes = 0;
+			apply_game_time_minutes(m, false);
+			g_host->log.line("time-skip-applied slot=%u minutes=%u", u32(l.ref.slot), m);
+		}
+}
+
+// The relocation fixture (profile relocate_party, server-driven).
+// Variant 0 (a guide, as ka_travel's dialogue action runs on the server): in
+// p2's context the fee (dialogs.relocate_money_from_actor 1000 to an NPC), the
+// trip's skip (2 h 30 min) and ChangeLevel to a Darkscape smart terrain; p1
+// refuses: the fee comes back, no time passes. Again, p1 accepts: the party
+// arrives on Darkscape, the time skipped once (2.5 h), the fee paid once.
+// Variant 1 (client 2's relocate_test does what a same-level fast travel does:
+// a 1 h skip, set_actor_position 150 m away): p2's actor does not move by
+// itself; the request arrives (source 1, 60 min); p1 accepts: both arrive at
+// the point (a same-level reload), the time skipped once. compare-coop-relocate.py.
+u16 relocate_fixture_answer(PlayerLink& link, u8 answer)
+{
+	Host::RelocateFixture& f = g_host->relocate_fixture;
+	const coop::proto::Transition* live = g_host->travel.coordinator ? g_host->travel.coordinator->live() : nullptr;
+	coop::proto::ActionIntent intent;
+	intent.operation_id = ++f.operation;
+	intent.kind = coop::proto::kActionTravelAnswer;
+	const u64 id = live ? live->id : 0;
+	for (int b = 0; b < 8; ++b)
+		intent.params.push_back(u8(id >> (8 * b)));
+	intent.params.push_back(answer);
+	coop::proto::ActionResult result;
+	return take_travel_answer(link, intent, result);
+}
+
+bool relocate_fixture_guide(CActor* p2)
+{
+	Host::RelocateFixture& f = g_host->relocate_fixture;
+	string1024 chunk;
+	xr_sprintf(chunk, "local npc = level.object_by_id(%u)\n"
+		"dialogs.relocate_money_from_actor(db.actor, npc, 1000)\n"
+		"level.change_game_time(0, 2, 30)\n"
+		"ChangeLevel(vector():set(%f, %f, %f), %u, %u, VEC_ZERO)\n",
+		u32(f.npc), VPUSH(f.dest), f.dest_lvid, u32(f.dest_gvid));
+	return sleep_lua(p2, chunk, "fixture-guide");
+}
