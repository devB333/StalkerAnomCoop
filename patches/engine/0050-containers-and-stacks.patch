+// S08-T08
+std::vector<u8> encode_container(const ContainerRecord& r)
+{
+	std::vector<u8> out;
+	put<u64>(out, r.entity);
+	put<u8>(out, r.kind);
+	put_text(out, r.section);
+	for (float f : r.position)
+		put<float>(out, f);
+	const size_t n = _min(r.state.size(), size_t(0xffff));
+	put<u16>(out, u16(n));
+	out.insert(out.end(), r.state.begin(), r.state.begin() + n);
+	return out;
+}
+
+bool decode_container(const std::vector<u8>& payload, ContainerRecord& out)
+{
+	size_t at = 0;
+	u16 n = 0;
+	if (!(get(payload, at, out.entity) && get(payload, at, out.kind) && get_text(payload, at, out.section) &&
+			get(payload, at, out.position[0]) && get(payload, at, out.position[1]) &&
+			get(payload, at, out.position[2]) && get(payload, at, n)) ||
+		at + n != payload.size() || !out.entity || (out.kind != 1 && out.kind != 2) || out.section.empty())
+		return false;
+	out.state.assign(payload.begin() + at, payload.end());
+	return true;
+}
+
+std::vector<u8> encode_tombstone(const TombstoneRecord& r)
+{
+	std::vector<u8> out;
+	put<u64>(out, r.entity);
+	put<u64>(out, r.owner_entity);
+	put_text(out, r.section);
+	return out;
+}
+
+bool decode_tombstone(const std::vector<u8>& payload, TombstoneRecord& out)
+{
+	size_t at = 0;
+	return get(payload, at, out.entity) && get(payload, at, out.owner_entity) && get_text(payload, at, out.section) &&
+		at == payload.size() && out.entity;
+}
+
+std::vector<u8> encode_stack(const StackRecord& r)
+{
+	std::vector<u8> out;
+	put<u8>(out, r.slot);
+	put<u64>(out, r.player.hi);
+	put<u64>(out, r.player.lo);
+	put<u64>(out, r.operation);
+	put<u64>(out, r.container_entity);
+	put_text(out, r.section);
+	put<u8>(out, u8(_min(r.counts.size(), size_t(255))));
+	for (size_t i = 0; i < r.counts.size() && i < 255; ++i)
+	{
+		put<u64>(out, r.counts[i].first);
+		put<u16>(out, r.counts[i].second);
+	}
+	put<u8>(out, u8(_min(r.released.size(), size_t(255))));
+	for (size_t i = 0; i < r.released.size() && i < 255; ++i)
+		put<u64>(out, r.released[i]);
+	return out;
+}
+
+bool decode_stack(const std::vector<u8>& payload, StackRecord& out)
+{
+	size_t at = 0;
+	u8 counts = 0, released = 0;
+	if (!(get(payload, at, out.slot) && get(payload, at, out.player.hi) && get(payload, at, out.player.lo) &&
+			get(payload, at, out.operation) && get(payload, at, out.container_entity) &&
+			get_text(payload, at, out.section) && get(payload, at, counts)))
+		return false;
+	out.counts.clear();
+	out.released.clear();
+	for (u8 i = 0; i < counts; ++i)
+	{
+		u64 e = 0;
+		u16 c = 0;
+		if (!get(payload, at, e) || !get(payload, at, c))
+			return false;
+		out.counts.push_back({e, c});
+	}
+	if (!get(payload, at, released))
+		return false;
+	for (u8 i = 0; i < released; ++i)
+	{
+		u64 e = 0;
+		if (!get(payload, at, e))
+			return false;
+		out.released.push_back(e);
+	}
+	return at == payload.size() && out.container_entity;
+}
