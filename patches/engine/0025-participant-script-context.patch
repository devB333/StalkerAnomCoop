+void deferred_end()
+{
+	Fixture& f = g_fixture;
+	LPCSTR tags[] = {"p1", "p2", "none"};
+	const int expect_slot[] = {int(f.p1.slot), int(f.p2.slot), -1};
+	const int expect_actor[] = {int(f.actor1), int(f.actor2), -1};
+	const int expect_db[] = {int(f.actor1), int(f.actor2), int(f.actor1)};
+	for (u32 i = 0; i < 3; ++i)
+	{
+		luabind::object r = call("s03_t05.fired_info", tags[i]);
+		string128 entry;
+		field_str(r, "entry", entry);
+		const int slot = field_int(r, "slot"), actor = field_int(r, "actor"), db = field_int(r, "db_actor");
+		row("deferred,%s,%d,%d,%d,%d,%s", tags[i], r.type() == LUA_TTABLE ? 1 : 0, slot, actor, db, entry[0] ? entry : "-");
+		string128 what;
+		xr_sprintf(what, "the %s time event fired in the context it was created in (slot %d actor %d db.actor %d)",
+			tags[i], expect_slot[i], expect_actor[i], expect_db[i]);
+		check(r.type() == LUA_TTABLE && slot == expect_slot[i] && actor == expect_actor[i] && db == expect_db[i], what);
+	}
+	luabind::object compat = call("s03_t05.compat", "");
+	check(field_int(compat, "deferred_captured", 0) >= 2, "the two in-context events were captured");
+	check(field_int(compat, "deferred_refused", 0) == 0, "no captured event was refused");
+}
