+// S10-T05a: a participant's context by roster slot (each player's pass of the emission)
+double lua_enter_slot(int slot)
+{
+	if (!s_stack || !server_role() || !g_pGameLevel || slot < 0 || slot > 0xff)
+		return 0;
+	CActor* actor = slot_actor(u8(slot));
+	ActionContext context;
+	if (!actor || !actor_context(actor, context))
+		return 0;
+	u32 token = 0;
+	if (s_stack->enter(context, Scope::Self, "emission", token) != Refusal::None)
+		return 0;
+	sync_lua(true);
+	return double(token);
