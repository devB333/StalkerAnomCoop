+		if (v[0] >= 0 && Level().Objects.net_Find(u16(v[0])))
+		{
+			f.npc = u16(v[0]);
+			f.restored = true;
+			g_host->log.line("fixture-companion restored npc=%u saved_slot=%d", u32(f.npc), int(v[1]));
+			f.phase = 2;
+			f.phase_tick = g_host->tick;
+			return;
+		}
+		// the nearest candidates to p2
+		xr_vector<std::pair<float, u16>> candidates;
+		for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+		{
+			CObject* o = Level().Objects.o_get_by_iterator(i);
+			CEntityAlive* alive = o ? smart_cast<CEntityAlive*>(o) : nullptr;
+			if (!alive || !alive->g_Alive() || smart_cast<CActor*>(o) || !smart_cast<CAI_Stalker*>(o))
+				continue;
+			candidates.push_back(std::make_pair(o->Position().distance_to(p2->Position()), u16(o->ID())));
+		}
+		std::sort(candidates.begin(), candidates.end());
+		for (u32 i = 0; i < candidates.size() && i < 20 && f.npc == 0xffff; ++i)
+		{
+			string512 chunk;
+			xr_sprintf(chunk, "local n = level.object_by_id(%u)\n"
+				"if not n or not n:alive() or not get_object_squad(n) then return 0 end\n"
+				"if get_object_story_id and get_object_story_id(n:id()) then return 0 end\n"
+				"if n:has_info('npcx_is_companion') then return 0 end\n"
+				"if n:relation(db.actor) == game_object.enemy then return 0 end\n"
+				"return 1", u32(candidates[i].second));
+			if (companion_lua(chunk, v, 1, p2, nullptr, "candidate") == 1 && v[0] == 1)
+				f.npc = candidates[i].second;
+		}
+		CGameObject* npc = f.npc != 0xffff ? smart_cast<CGameObject*>(Level().Objects.net_Find(f.npc)) : nullptr;
+		if (!npc)
