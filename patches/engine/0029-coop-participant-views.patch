+	g_host->snapshot_slot = slot;
+	coop::proto::Snapshot snapshot;
+	snapshot.server_tick = g_host->tick;
+	snapshot.part = 0;
+	snapshot.part_count = 1;
+	for (const PlayerLink& link : g_host->links)
