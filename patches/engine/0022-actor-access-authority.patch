@@ -0,0 +1,315 @@
+#include "pch_script.h"
+#include "CampaignMessagePolicy.h"
+#include "xrMessages.h"
+
+// S03-T02: see CampaignMessagePolicy.h.
+
+using namespace campaign;
+
+namespace
+{
+MessagePolicyStats s_stats = {};
+} // namespace
+
+namespace campaign
+{
+MessageClass classify_message(u16 type)
+{
+	switch (type)
+	{
+	case M_UPDATE:
+	case M_SPAWN:
+	case M_SAVE_PACKET:
+		return MessageClass::StateImport;
+	case M_CHANGE_LEVEL:
+	case M_LOAD_GAME:
+	case M_RELOAD_GAME:
+	case M_SAVE_GAME:
+	case M_SWITCH_DISTANCE:
+	case M_CHANGE_LEVEL_GAME:
+		return MessageClass::WorldControl;
+	case M_EVENT:
+	case M_EVENT_PACK:
+	case M_GAMEMESSAGE:
+	case M_PLAYER_FIRE:
+	case M_STATISTIC_UPDATE:
+	case M_STATISTIC_UPDATE_RESPOND:
+	case M_CHANGE_SELF_NAME:
+		return MessageClass::Outcome;
+	case M_CL_INPUT:
+	case M_CL_UPDATE:
+	case M_MOVE_PLAYERS_RESPOND:
+		return MessageClass::Intent;
+	case M_CLIENTREADY:
+	case M_CLIENT_REQUEST_CONNECTION_DATA:
+	case M_CHAT_MESSAGE:
+	case M_CHAT:
+	case M_SV_MAP_NAME:
+	case M_SV_DIGEST:
+	case M_CL_AUTH:
+	case M_CREATE_PLAYER_STATE:
+	case M_CL_PING_CHALLENGE:
+	case M_CL_PING_CHALLENGE_RESPOND:
+	case M_AUTH_CHALLENGE:
+	case M_GAMESPY_CDKEY_VALIDATION_CHALLENGE:
+	case M_GAMESPY_CDKEY_VALIDATION_CHALLENGE_RESPOND:
+	case M_REMOTE_CONTROL_AUTH:
+	case M_REMOTE_CONTROL_CMD:
+	case M_BATTLEYE:
+	case M_FILE_TRANSFER:
+	case M_SECURE_KEY_SYNC:
+	case M_SECURE_MESSAGE:
+	case M_BULLET_CHECK_RESPOND:
+		return MessageClass::Connection;
+	case M_SV_CONFIG_NEW_CLIENT:
+	case M_SV_CONFIG_GAME:
+	case M_SV_CONFIG_FINISHED:
+	case M_MIGRATE_DEACTIVATE:
+	case M_MIGRATE_ACTIVATE:
+	case M_UPDATE_OBJECTS:
+	case M_COMPRESSED_UPDATE_OBJECTS:
+	case M_CLIENT_CONNECT_RESULT:
+	case M_CLIENT_WARN:
+	case M_MOVE_PLAYERS:
+	case M_MOVE_ARTEFACTS:
+	case M_MAKE_SCREENSHOT:
+		return MessageClass::ServerToClient;
+	default:
+		return MessageClass::Unknown;
+	}
+}
+
+MessageClass classify_game_event(u16 type)
+{
+	// Every game event a client sends either mutates server entities, is
+	// applied by the game state, or is forwarded to clients as an outcome.
+	// None is an intent in the Stage 4 sense, so the class is Outcome for all
+	// of them; the names below are what the server does with each.
+	switch (type)
+	{
+	case GE_RESPAWN: // queues a respawn
+	case GE_OWNERSHIP_TAKE: // moves an item into an inventory
+	case GE_OWNERSHIP_TAKE_MP_FORCED:
+	case GE_OWNERSHIP_REJECT: // drops an item
+	case GE_TRANSFER_AMMO: // destroys an entity
+	case GE_HIT: // damage, queued as GAME_EVENT_ON_HIT
+	case GE_HIT_STATISTIC:
+	case GE_DIE: // death, killer assignment, broadcast
+	case GE_ASSIGN_KILLER:
+	case GE_DESTROY: // destroys an entity and its children
+	case GE_DESTROY_REJECT:
+	case GE_TELEPORT_OBJECT:
+	case GE_ADD_RESTRICTION:
+	case GE_REMOVE_RESTRICTION:
+	case GE_REMOVE_ALL_RESTRICTIONS:
+	case GE_BUY:
+	case GE_INFO_TRANSFER: // quest/info state, broadcast to every client
+	case GE_TRADE_SELL:
+	case GE_TRADE_BUY:
+	case GE_WPN_AMMO_ADD:
+	case GE_WPN_STATE_CHANGE:
+	case GE_ADDON_ATTACH:
+	case GE_ADDON_DETACH:
+	case GE_ADDON_CHANGE:
+	case GE_INSTALL_UPGRADE: // mutates the server item
+	case GE_GRENADE_EXPLODE:
+	case GE_INV_ACTION:
+	case GE_INV_BOX_STATUS: // mutates the server box
+	case GE_INV_OWNER_STATUS:
+	case GE_ZONE_STATE_CHANGE:
+	case GE_MOVE_ACTOR:
+	case GE_ACTOR_JUMPING:
+	case GE_ACTOR_MAX_POWER:
+	case GE_ACTOR_MAX_HEALTH:
+	case GE_CHANGE_POS:
+	case GE_GAME_EVENT: // game_sv delayed events (connect, hit, kill...)
+	case GE_CHANGE_VISUAL: // mutates the server visual
+	case GE_MONEY:
+	case GEG_PLAYER_ACTIVATE_SLOT:
+	case GEG_PLAYER_ITEM2SLOT:
+	case GEG_PLAYER_ITEM2BELT:
+	case GEG_PLAYER_ITEM2RUCK:
+	case GEG_PLAYER_ITEM_EAT:
+	case GEG_PLAYER_ITEM_SELL:
+	case GEG_PLAYER_ACTIVATEARTEFACT:
+	case GEG_PLAYER_WEAPON_HIDE_STATE:
+	case GEG_PLAYER_DISABLE_SPRINT:
+	case GEG_PLAYER_ATTACH_HOLDER:
+	case GEG_PLAYER_DETACH_HOLDER:
+	case GEG_PLAYER_PLAY_HEADSHOT_PARTICLE:
+	case GE_KILL_SOMEONE:
+	case GE_FREEZE_OBJECT:
+	case GE_LAUNCH_ROCKET:
+	case GEG_PLAYER_USE_BOOSTER:
+	case GE_REQUEST_PLAYERS_INFO:
+	case GE_TRADER_FLAGS:
+		return MessageClass::Outcome;
+	default:
+		return MessageClass::Unknown;
+	}
+}
+
+LPCSTR message_class_name(MessageClass c)
+{
+	switch (c)
+	{
+	case MessageClass::StateImport: return "state-import";
+	case MessageClass::WorldControl: return "world-control";
+	case MessageClass::Outcome: return "outcome";
+	case MessageClass::Intent: return "intent";
+	case MessageClass::Connection: return "connection";
+	case MessageClass::ServerToClient: return "server-to-client";
+	default: return "unknown";
+	}
+}
+
+LPCSTR message_name(u16 type)
+{
+	switch (type)
+	{
+	case M_UPDATE: return "M_UPDATE";
+	case M_SPAWN: return "M_SPAWN";
+	case M_EVENT: return "M_EVENT";
+	case M_EVENT_PACK: return "M_EVENT_PACK";
+	case M_CL_INPUT: return "M_CL_INPUT";
+	case M_CL_UPDATE: return "M_CL_UPDATE";
+	case M_CLIENTREADY: return "M_CLIENTREADY";
+	case M_CHANGE_LEVEL: return "M_CHANGE_LEVEL";
+	case M_LOAD_GAME: return "M_LOAD_GAME";
+	case M_RELOAD_GAME: return "M_RELOAD_GAME";
+	case M_SAVE_GAME: return "M_SAVE_GAME";
+	case M_SAVE_PACKET: return "M_SAVE_PACKET";
+	case M_SWITCH_DISTANCE: return "M_SWITCH_DISTANCE";
+	case M_GAMEMESSAGE: return "M_GAMEMESSAGE";
+	case M_CLIENT_REQUEST_CONNECTION_DATA: return "M_CLIENT_REQUEST_CONNECTION_DATA";
+	case M_CHAT_MESSAGE: return "M_CHAT_MESSAGE";
+	case M_CHANGE_LEVEL_GAME: return "M_CHANGE_LEVEL_GAME";
+	case M_CL_AUTH: return "M_CL_AUTH";
+	case M_STATISTIC_UPDATE: return "M_STATISTIC_UPDATE";
+	case M_STATISTIC_UPDATE_RESPOND: return "M_STATISTIC_UPDATE_RESPOND";
+	case M_PLAYER_FIRE: return "M_PLAYER_FIRE";
+	case M_MOVE_PLAYERS_RESPOND: return "M_MOVE_PLAYERS_RESPOND";
+	case M_REMOTE_CONTROL_AUTH: return "M_REMOTE_CONTROL_AUTH";
+	case M_REMOTE_CONTROL_CMD: return "M_REMOTE_CONTROL_CMD";
+	case M_SV_MAP_NAME: return "M_SV_MAP_NAME";
+	case M_SV_DIGEST: return "M_SV_DIGEST";
+	case M_FILE_TRANSFER: return "M_FILE_TRANSFER";
+	case M_SECURE_KEY_SYNC: return "M_SECURE_KEY_SYNC";
+	case M_SECURE_MESSAGE: return "M_SECURE_MESSAGE";
+	case M_CREATE_PLAYER_STATE: return "M_CREATE_PLAYER_STATE";
+	default: return "M_?";
+	}
+}
+
+LPCSTR game_event_name(u16 type)
+{
+	switch (type)
+	{
+	case GE_RESPAWN: return "GE_RESPAWN";
+	case GE_OWNERSHIP_TAKE: return "GE_OWNERSHIP_TAKE";
+	case GE_OWNERSHIP_REJECT: return "GE_OWNERSHIP_REJECT";
+	case GE_TRANSFER_AMMO: return "GE_TRANSFER_AMMO";
+	case GE_HIT: return "GE_HIT";
+	case GE_DIE: return "GE_DIE";
+	case GE_DESTROY: return "GE_DESTROY";
+	case GE_INFO_TRANSFER: return "GE_INFO_TRANSFER";
+	case GE_TRADE_SELL: return "GE_TRADE_SELL";
+	case GE_TRADE_BUY: return "GE_TRADE_BUY";
+	case GE_WPN_STATE_CHANGE: return "GE_WPN_STATE_CHANGE";
+	case GE_INSTALL_UPGRADE: return "GE_INSTALL_UPGRADE";
+	case GE_INV_BOX_STATUS: return "GE_INV_BOX_STATUS";
+	case GE_ZONE_STATE_CHANGE: return "GE_ZONE_STATE_CHANGE";
+	case GE_CHANGE_POS: return "GE_CHANGE_POS";
+	case GE_GAME_EVENT: return "GE_GAME_EVENT";
+	case GE_CHANGE_VISUAL: return "GE_CHANGE_VISUAL";
+	case GEG_PLAYER_ITEM2SLOT: return "GEG_PLAYER_ITEM2SLOT";
+	case GEG_PLAYER_ACTIVATEARTEFACT: return "GEG_PLAYER_ACTIVATEARTEFACT";
+	case GE_LAUNCH_ROCKET: return "GE_LAUNCH_ROCKET";
+	default: return "GE_?";
+	}
+}
+
+MessageVerdict server_message_policy(u16 type, bool bridge)
+{
+	if (bridge)
+		return MessageVerdict::Accept;
+	switch (classify_message(type))
+	{
+	case MessageClass::Intent:
+	case MessageClass::Connection:
+		return MessageVerdict::Accept;
+	case MessageClass::Outcome:
+		// Game events are policed per event type in Process_event; the pack
+		// is unwrapped and each inner message goes through this policy.
+		return (type == M_EVENT || type == M_EVENT_PACK) ? MessageVerdict::Accept : MessageVerdict::Refuse;
+	default:
+		return MessageVerdict::Refuse;
+	}
+}
+
+MessageVerdict server_event_policy(u16 type, bool bridge)
+{
+	if (bridge)
+		return MessageVerdict::Accept;
+	(void)type;
+	return MessageVerdict::Refuse;
+}
+
+const MessagePolicyStats& message_policy_stats()
+{
+	return s_stats;
+}
+
+void note_message(u16 type, bool bridge, bool known_sender, MessageVerdict verdict, u32 sender)
+{
+	if (!known_sender)
+		++s_stats.unknown_sender;
+	if (bridge)
+	{
+		++s_stats.bridge_messages;
+		return;
+	}
+	if (verdict == MessageVerdict::Accept)
+	{
+		if (type == M_EVENT || type == M_EVENT_PACK)
+			++s_stats.remote_delegated;
+		else
+			++s_stats.remote_accepted;
+		return;
+	}
+	++s_stats.remote_refused;
+	if (type < 128)
+		++s_stats.refused_by_message[type];
+	if (s_stats.remote_refused <= 32)
+		Msg("! S03-T02 refused %s (%s) from %s client 0x%08x", message_name(type),
+			message_class_name(classify_message(type)), known_sender ? "remote" : "unknown", sender);
+}
+
+void note_event(u16 type, bool bridge, MessageVerdict verdict, u32 sender)
+{
+	if (bridge)
+	{
+		++s_stats.bridge_events;
+		return;
+	}
+	if (verdict == MessageVerdict::Accept)
+	{
+		++s_stats.remote_accepted;
+		return;
+	}
+	++s_stats.remote_events_refused;
+	if (type < 128)
+		++s_stats.refused_by_event[type];
+	if (s_stats.remote_events_refused <= 32)
+		Msg("! S03-T02 refused event %s (%s) from remote client 0x%08x", game_event_name(type),
+			message_class_name(classify_game_event(type)), sender);
+}
+
+void report_message_policy(LPCSTR tag)
+{
+	Msg("S03-T02 message-policy %s bridge_messages=%I64u bridge_events=%I64u remote_accepted=%I64u "
+		"remote_delegated=%I64u remote_refused=%I64u remote_events_refused=%I64u unknown_sender=%I64u",
+		tag, s_stats.bridge_messages, s_stats.bridge_events, s_stats.remote_accepted, s_stats.remote_delegated,
+		s_stats.remote_refused, s_stats.remote_events_refused, s_stats.unknown_sender);
+}
+} // namespace campaign
diff --git a/src/xrGame/CampaignMessagePolicy.h b/src/xrGame/CampaignMessagePolicy.h
new file mode 100644
index 0000000..12832d2
--- /dev/null
+++ b/src/xrGame/CampaignMessagePolicy.h
@@ -0,0 +1,71 @@
+#pragma once
+
+// S03-T02: the server's message policy for the private state-import bridge.
+//
+// The engine's server trusts one client with its private state: the direct,
+// in-process client (ClientID 1, "single_player"), marked bLocal and held as
+// SV_Client (xrServer::Server_Client_Check, AttachNewClient). That client
+// exports the simulation's state back into the server entities (M_UPDATE →
+// Process_update → UPDATE_Read; M_SAVE_PACKET → Process_save → load), spawns
+// (M_SPAWN), and drives the world (M_SAVE_GAME, M_LOAD_GAME, M_CHANGE_LEVEL,
+// M_SWITCH_DISTANCE). Its game events (M_EVENT: GE_HIT, GE_DESTROY,
+// GE_OWNERSHIP_TAKE, GE_INFO_TRANSFER, GE_DIE...) are outcomes the server
+// applies or forwards. Before S03-T02, Process_update and Process_save
+// asserted bLocal (a fatal, not a refusal) and the rest of the dispatch had
+// no sender check at all (xrServer::OnMessage).
+//
+// Policy. The bridge is the server's own process (Origin::ServerInternal);
+// everything it sends is accepted. Any other sender is a remote client whose
+// messages are at most intents: the dispatch is an allowlist of connection,
+// liveness, chat and input messages; every state import, world control and
+// game-event outcome from a remote is refused before it is parsed, counted
+// by type, and the first refusals are logged. Stage 4 defines the intent
+// protocol; until then a remote client can change nothing.
+
+namespace campaign
+{
+enum class MessageClass : u8
+{
+	StateImport, // M_UPDATE, M_SPAWN, M_SAVE_PACKET: private state written into server entities
+	WorldControl, // save, load, reload, change level, switch distance
+	Outcome, // game events and MP outcome messages the server applies or forwards
+	Intent, // client input and client-reported presentation state
+	Connection, // handshake, auth, liveness, chat, admin, files
+	ServerToClient, // messages the server sends; never valid from a client
+	Unknown,
+};
+
+enum class MessageVerdict : u8
+{
+	Accept,
+	Refuse,
+};
+
+MessageClass classify_message(u16 type); // M_*
+MessageClass classify_game_event(u16 type); // GE_* (carried by M_EVENT)
+LPCSTR message_class_name(MessageClass c);
+LPCSTR message_name(u16 type);
+LPCSTR game_event_name(u16 type);
+
+// bridge: the sender is the server's direct client.
+MessageVerdict server_message_policy(u16 type, bool bridge);
+MessageVerdict server_event_policy(u16 type, bool bridge);
+
+struct MessagePolicyStats
+{
+	u64 bridge_messages;
+	u64 bridge_events;
+	u64 remote_accepted;
+	u64 remote_delegated; // M_EVENT / M_EVENT_PACK wrappers passed to the per-event policy
+	u64 remote_refused;
+	u64 remote_events_refused;
+	u64 unknown_sender; // messages whose sender the server does not know
+	u64 refused_by_message[128];
+	u64 refused_by_event[128];
+};
+
+const MessagePolicyStats& message_policy_stats();
+void note_message(u16 type, bool bridge, bool known_sender, MessageVerdict verdict, u32 sender);
+void note_event(u16 type, bool bridge, MessageVerdict verdict, u32 sender);
+void report_message_policy(LPCSTR tag);
+} // namespace campaign
