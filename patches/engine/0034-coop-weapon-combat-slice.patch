+// ------------------------------------------------------------ S06-T04
+// The combat program (profile script = 3; prepare-coop-session.py --combat).
+// Each player, its program starting 45 s after the other's for slot 1:
+//   holster       ActionIntent: activate slot 0 (nothing in the hands)
+//   equip         ActionIntent: activate slot 2 (the PM from the arm fixture)
+//   W-aim-fire    three presses at the other player's actor (hits, health)
+//   reloads       ActionIntent: reload (server ammo restored)
+//   W-hold        the key held 1 s at the sky (a semi-automatic: one shot)
+//   W-rapid       a press every 80 ms for 1 s at the sky (the weapon's cadence)
+//   W-dup         the same with every input batch sent four times
+//   W-empty       a press every 100 ms for 3 s: the magazine runs dry, then nothing
+//   W-move-fire   strafing while pressing every 300 ms at the other actor
+//   W-forged      an ActionIntent claiming a hit on the other actor (refused)
+// Then both players, at the same server time (215 s), fire at each other
+// for 1.2 s (W-simultaneous).
+void send_action(u16 kind, const xr_vector<u8>& params, LPCSTR what)
+{
+	coop::proto::ActionIntent intent;
+	intent.operation_id = ++g_link->combat_operation;
+	intent.kind = kind;
+	intent.params.assign(params.begin(), params.end());
+	if (kind == 7)
+	{
+		const auto other = other_actor();
+		const auto ref = other ? g_link->refs.find(u16(other->ID())) : g_link->refs.end();
+		if (ref != g_link->refs.end())
+			intent.target = ref->second;
+	}
+	const bool sent = g_link->client && g_link->client->send(coop::proto::Message(intent));
+	g_link->log.line("script-action %s operation=%I64u kind=%u sent=%d", what, intent.operation_id, u32(kind),
+		sent ? 1 : 0);
+}
+
+void combat_leg(LPCSTR name, u32 bits, u32 ms, u8 mode, u32 period)
+{
+	leg_begin(name, bits, coop::proto::Stance::Stand, false, ms, mode);
+	g_link->drive_fire = true;
+	g_link->drive_fire_period = period;
+	g_link->drive_fire_count = 0;
+}
+
+// The camera at the other actor's chest (1.2 m above its feet) from this
+// actor's eye, every frame of an aimed leg: the weapon's recoil lifts the
+// camera after each shot, and a player brings it back down.
+void aim_at_other_chest()
+{
+	CActor* other = other_actor();
+	if (!other || !g_actor)
+		return;
+	const Fvector eye = g_actor->Cameras().Position();
+	Fvector to = Fvector().set(other->Position()).add(Fvector().set(0.f, 1.2f, 0.f)).sub(eye);
+	if (to.magnitude() < EPS_L)
+		return;
+	to.normalize();
+	float h, p;
+	to.getHP(h, p);
+	g_actor->cam_Active()->yaw = -h;
+	g_actor->cam_Active()->pitch = -p;
+}
+
+void face_sky()
+{
+	face_away_from_other();
+	if (g_actor)
+		g_actor->cam_Active()->pitch = -0.7f;
+}
+
+void run_script3(u32 t)
+{
+	if (!g_link->program_t0)
+	{
+		if (!other_actor())
+		{
+			g_link->other_since = 0;
+			return;
+		}
+		if (!g_link->other_since)
+			g_link->other_since = t;
+		if (t < g_link->other_since + 3000 + u32(g_link->local_slot) * 45000)
+			return;
+		g_link->program_t0 = t;
+		g_link->log.line("script3-program-start slot=%u t=%u", u32(g_link->local_slot), t);
+	}
+	if (g_link->aim_track)
+		aim_at_other_chest();
+	const u32 p = t - g_link->program_t0;
+	struct Step
+	{
+		u32 at;
+		LPCSTR name;
+	};
+	static const Step steps[] = {
+		{0, "holster"},
+		{1500, "equip"},
+		{3000, "face-other"},
+		{3200, "W-aim-fire"},
+		{5000, "reload"},
+		{8000, "face-sky"},
+		{8500, "W-hold"},
+		{10000, "W-rapid"},
+		{11500, "reload"},
+		{14500, "W-dup"},
+		{16000, "reload"},
+		{19000, "W-empty"},
+		{22500, "reload"},
+		{25500, "face-other"},
+		{26000, "W-move-fire"},
+		{28500, "W-forged"},
+		{30500, "program-end"},
+	};
+	const u32 count = u32(sizeof(steps) / sizeof(steps[0]));
+	if (g_link->script_phase < count)
+	{
+		if (p < steps[g_link->script_phase].at)
+			return;
+		const Step& step = steps[g_link->script_phase++];
+		const LPCSTR n = step.name;
+		if (!xr_strcmp(n, "holster"))
+		{
+			xr_vector<u8> slot;
+			slot.push_back(u8(NO_ACTIVE_SLOT));
+			send_action(coop::proto::kActionActivateSlot, slot, "holster");
+		}
+		else if (!xr_strcmp(n, "equip"))
+		{
+			xr_vector<u8> slot;
+			slot.push_back(u8(INV_SLOT_2));
+			send_action(coop::proto::kActionActivateSlot, slot, "equip-slot-2");
+		}
+		else if (!xr_strcmp(n, "reload"))
+			send_action(coop::proto::kActionReload, xr_vector<u8>(), "reload");
+		else if (!xr_strcmp(n, "face-other"))
+			face_other_actor(false);
+		else if (!xr_strcmp(n, "face-sky"))
+			face_sky();
+		else if (!xr_strcmp(n, "W-aim-fire"))
+		{
+			combat_leg(n, 0, 1500, Link::SendNormal, 15);
+			g_link->aim_track = true;
+		}
+		else if (!xr_strcmp(n, "W-hold"))
+			combat_leg(n, 0, 1000, Link::SendNormal, 0);
+		else if (!xr_strcmp(n, "W-rapid"))
+			combat_leg(n, 0, 1000, Link::SendNormal, 4);
+		else if (!xr_strcmp(n, "W-dup"))
+			combat_leg(n, 0, 1000, Link::SendDuplicate4, 4);
+		else if (!xr_strcmp(n, "W-empty"))
+			combat_leg(n, 0, 3000, Link::SendNormal, 5);
+		else if (!xr_strcmp(n, "W-move-fire"))
+		{
+			combat_leg(n, mcLStrafe, 1500, Link::SendNormal, 15);
+			g_link->aim_track = true;
+		}
+		else if (!xr_strcmp(n, "W-forged"))
+		{
+			const char forged[] = "hit 1.0 health=0";
+			xr_vector<u8> params;
+			params.assign(forged, forged + sizeof(forged) - 1);
+			send_action(7, params, "forged-hit");
+			leg_begin(n, 0, coop::proto::Stance::Stand, false, 1500, Link::SendNormal);
+		}
+		else if (!xr_strcmp(n, "program-end"))
+			g_link->log.line("script3-program-end");
+		return;
+	}
+	// Both players at the same server time. First each takes its pistol
+	// out again and reloads: the world may have changed its hands since its
+	// program ended (combat-10: Fanat struck actor 0 and its slot went to 0).
+	const double server_ms = double(g_link->last_snapshot_tick) * double(kServerTickMs);
+	if (g_link->script_phase == count && server_ms >= 205000.0)
+	{
+		++g_link->script_phase;
+		xr_vector<u8> slot;
+		slot.push_back(u8(INV_SLOT_2));
+		send_action(coop::proto::kActionActivateSlot, slot, "equip-slot-2-again");
+		return;
+	}
+	if (g_link->script_phase == count + 1 && server_ms >= 207000.0)
+	{
+		++g_link->script_phase;
+		send_action(coop::proto::kActionReload, xr_vector<u8>(), "reload-again");
+		return;
+	}
+	if (g_link->script_phase == count + 2 && server_ms >= 215000.0)
+	{
+		++g_link->script_phase;
+		face_other_actor(false);
+		combat_leg("W-simultaneous", 0, 1200, Link::SendNormal, 15);
+		g_link->aim_track = true;
+		g_link->log.line("script-simultaneous server_ms=%.0f", server_ms);
+	}
+}
+
+// What this client shows of each actor's combat state, 10 times a second.
+void log_combat()
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (now - g_link->last_combat_log_ms < 100)
+		return;
+	g_link->last_combat_log_ms = now;
+	if (!g_link->combat_csv)
+	{
+		string_path path;
+		FS.update_path(path, "$logs$", "coop-combat-client.csv");
+		g_link->combat_csv = fopen(path, "w");
+		if (!g_link->combat_csv)
+			return;
+		fprintf(g_link->combat_csv, "utc_ms,id,entity,local,health,slot,ammo,server_slot,server_ammo,server_shots,fire\n");
+	}
+	const u64 utc_ms = utc_now_ms();
+	for (const auto& entry : g_link->tracks)
+	{
+		CActor* actor = smart_cast<CActor*>(Level().Objects.net_Find(entry.first));
+		const auto ref = g_link->refs.find(entry.first);
+		if (!actor || ref == g_link->refs.end())
+			continue;
+		const CWeapon* weapon = smart_cast<CWeapon*>(actor->inventory().ActiveItem());
+		const auto o = g_link->outcomes.find(entry.first);
+		fprintf(g_link->combat_csv, "%I64u,%u,%I64u,%d,%u,%u,%d,%u,%u,%u,%d\n", utc_ms, u32(entry.first), ref->second.id,
+			actor == g_actor ? 1 : 0, u32(iFloor(actor->GetfHealth() * 10000.f + 0.5f)),
+			u32(actor->inventory().GetActiveSlot()), weapon ? weapon->GetAmmoElapsed() : -1,
+			o != g_link->outcomes.end() ? u32(o->second.slot) : 255u,
+			o != g_link->outcomes.end() ? u32(o->second.ammo) : 65535u,
+			o != g_link->outcomes.end() ? u32(o->second.shots) : 65535u, actor == g_actor && g_link->fire_sent ? 1 : 0);
+	}
+}
+
 // The server's world clock (CampaignEvent kind 1): the client's ALife clock
