+extern "C" bool __cdecl xrCampaignLevel_AuthorityCheck()
+{
+	if (!g_campaign_identity || !g_pGameLevel || !Level().Server || !ai().get_alife())
+		return false;
+	Check f("authority-check");
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	const ServerAuthority* authority = registry.authority();
+	CLevel& level = Level();
+	xrServer& server = *level.Server;
+
+	// The server presents nothing.
+	f.check(process_role() == Role::Server, "the process role is server");
+	f.check(!level.CurrentEntity() && !level.CurrentViewEntity() && !level.CurrentControlEntity(),
+		"the server has no current, view or control entity");
+	f.check(local_view_actor() == nullptr, "local_view_actor is null on the server");
+
+	// The participant lookups name the saved actor and nothing else.
+	CActor* actor = g_actor;
+	if (!f.check(actor != nullptr, "the saved actor exists"))
+		return f.done();
+	ParticipantRef p1;
+	Refusal why = Refusal::None;
+	f.expect(participant_of(actor, p1), Refusal::None, "the saved actor is held by a participant");
+	f.check(is_participant_actor(actor), "the saved actor is a participant actor");
+	f.check(participant_actor(p1, &why) == actor, "participant 1's actor is the saved actor");
+	xr_vector<CActor*> actors;
+	f.check(participant_actors(actors) == 1 && actors[0] == actor, "there is exactly one participant actor");
+	Fvector away = actor->Position();
+	away.x += 10.f;
+	away.z += 10.f;
+	ParticipantRef nearest_ref;
+	float distance = 0.f;
+	f.check(nearest_participant_actor(away, &nearest_ref, &distance) == actor && nearest_ref == p1 &&
+			fsimilar(distance, 10.f * _sqrt(2.f), 0.01f),
+		"the nearest participant actor to a point near the saved actor is the saved actor");
+	f.check(sole_participant_actor("authority-check") == actor, "the sole participant actor is the saved actor");
+	f.check(Actor() == actor, "the compatibility accessor returns the sole actor");
+	f.check(dialog_actor(actor, nullptr) == actor && dialog_actor(nullptr, actor) == actor &&
+			dialog_actor(nullptr, nullptr) == nullptr,
+		"dialog_actor finds the actor among the speakers");
+
+	// A second participant context, with no actor, never resolves to the saved actor.
+	ParticipantRef p2;
+	f.expect(registry.bind_participant(authority, player_id(2), party_id(1), Device.dwFrame, p2), Refusal::None,
+		"bind participant 2");
+	f.expect(registry.attach_session(authority, p2, 7, Device.dwFrame), Refusal::None, "attach session 7 to participant 2");
+	f.check(participant_actor(p2, &why) == nullptr && why == Refusal::NoActor, "participant 2 has no actor");
+	f.check(participant_actors(actors) == 1, "still one participant actor");
+	f.check(sole_participant_actor("authority-check") == actor, "the sole actor is unchanged by a second participant");
+	f.check(context_actor(context(Origin::ClientIntent, 7, p2, party_id(1)), Scope::Self, &why) == nullptr &&
+			why == Refusal::NoActor,
+		"a client intent for participant 2 resolves no actor, not participant 1's");
+	f.check(context_actor(context(Origin::ClientIntent, 7, p1, party_id(1)), Scope::Self, &why) == nullptr &&
+			why == Refusal::NotAuthoritative,
+		"session 7 cannot act as participant 1");
+	f.check(context_actor(context(Origin::ClientIntent, 1, p1, party_id(1)), Scope::Self, &why) == nullptr &&
+			why == Refusal::BridgeNotParticipant,
+		"the bridge session cannot act as a participant");
+	f.check(context_actor(context(Origin::ServerInternal, 0, p1, party_id(1)), Scope::World, &why) == actor,
+		"a server-internal context for participant 1 resolves the saved actor");
+	f.check(context_actor(context(Origin::ServerInternal, 0, p2, party_id(1)), Scope::World, &why) == nullptr &&
+			why == Refusal::NoActor,
+		"a server-internal context for participant 2 resolves no actor");
+
+	// A remote client on the running server.
+	ClientID remote_id;
+	remote_id.set(0x53020002);
+	IClient* remote = server.client_Find_Get(remote_id);
+	remote->flags.bConnected = TRUE;
+	remote->flags.bLocal = 0;
+	remote->process_id = 0;
+	remote->name = "s03-t02-remote";
+	IClient* bridge = server.GetServerClient();
+	f.check(bridge != nullptr && bridge != remote, "the bridge client exists and is not the remote client");
+	f.check(server.ID_to_client(remote_id) == remote, "the server knows the remote client");
+	const ClientID bridge_id = bridge ? bridge->ID : ClientID();
+	ClientID unknown_id;
+	unknown_id.set(0x5302dead);
+	const MessagePolicyStats& stats = message_policy_stats();
+	const u64 refused0 = stats.remote_refused;
+	const u64 events0 = stats.remote_events_refused;
+	const u64 bridge0 = stats.bridge_messages;
+	const u64 bridge_events0 = stats.bridge_events;
+	const u64 unknown0 = stats.unknown_sender;
+	const u64 accepted0 = stats.remote_accepted;
+
+	CSE_ALifeCreatureActor* se_actor = smart_cast<CSE_ALifeCreatureActor*>(server.ID_to_entity(actor->ID()));
+	if (!f.check(se_actor != nullptr, "the saved actor has a server entity"))
+		return f.done();
+	const float health = se_actor->get_health();
+	const float live_health = actor->GetfHealth();
+	const float forged = 0.0123f;
+	NET_Packet P;
+
+	// State import: a forged health.
+	write_actor_update(P, se_actor, forged);
+	server.OnMessage(P, remote_id);
+	f.check(fsimilar(se_actor->get_health(), health), "a remote M_UPDATE does not set the actor's health");
+	f.check(fsimilar(actor->GetfHealth(), live_health), "...nor the live actor's");
+	f.check(stats.remote_refused == refused0 + 1, "the remote M_UPDATE was refused");
+	server.OnMessage(P, unknown_id);
+	f.check(fsimilar(se_actor->get_health(), health), "an unknown sender's M_UPDATE does not set the actor's health");
+	f.check(stats.remote_refused == refused0 + 2 && stats.unknown_sender == unknown0 + 1,
+		"the unknown sender's M_UPDATE was refused");
+	// The same packet from the bridge is the live import path.
+	server.OnMessage(P, bridge_id);
+	f.check(fsimilar(se_actor->get_health(), forged), "the bridge's M_UPDATE sets the server entity's health");
+	f.check(stats.bridge_messages == bridge0 + 1, "the bridge's M_UPDATE was accepted");
+	write_actor_update(P, se_actor, health);
+	server.OnMessage(P, bridge_id);
+	f.check(fsimilar(se_actor->get_health(), health), "the bridge restored the server entity's health");
+
+	// The other state imports and the world controls, header only: refused before parsing.
+	static const u16 controls[] = {M_SAVE_PACKET, M_SPAWN, M_SAVE_GAME, M_LOAD_GAME, M_RELOAD_GAME, M_CHANGE_LEVEL,
+		M_CHANGE_LEVEL_GAME, M_PLAYER_FIRE, M_GAMEMESSAGE};
+	u64 expected_refused = stats.remote_refused;
+	for (u32 i = 0; i < sizeof(controls) / sizeof(controls[0]); ++i)
+	{
+		P.w_begin(controls[i]);
+		server.OnMessage(P, remote_id);
+		++expected_refused;
+		string128 what;
+		xr_sprintf(what, "a remote %s is refused", message_name(controls[i]));
+		f.check(stats.remote_refused == expected_refused, what);
+	}
+	const float switch_distance = ai().alife().switch_distance();
+	P.w_begin(M_SWITCH_DISTANCE);
+	P.w_float(1.f);
+	server.OnMessage(P, remote_id);
+	++expected_refused;
+	f.check(stats.remote_refused == expected_refused, "a remote M_SWITCH_DISTANCE is refused");
+	f.check(fsimilar(ai().alife().switch_distance(), switch_distance), "...and the switch distance is unchanged");
+	P.w_begin(M_SWITCH_DISTANCE);
+	P.w_float(switch_distance);
+	server.OnMessage(P, bridge_id);
+	f.check(stats.bridge_messages == bridge0 + 3, "the bridge's M_SWITCH_DISTANCE is accepted");
+	f.check(fsimilar(ai().alife().switch_distance(), switch_distance), "...and set the same distance");
+
+	// Game events from the remote: hit, destroy, ownership, info, visual.
+	write_event_header(P, GE_HIT, actor->ID());
+	P.w_u16(actor->ID());
+	server.OnMessage(P, remote_id);
+	f.check(stats.remote_events_refused == events0 + 1, "a remote GE_HIT on the actor is refused");
+	const u16 child = se_actor->children.empty() ? u16(-1) : se_actor->children.front();
+	if (child != u16(-1))
+	{
+		write_event_header(P, GE_DESTROY, child);
+		server.OnMessage(P, remote_id);
+		f.check(stats.remote_events_refused == events0 + 2, "a remote GE_DESTROY of an inventory item is refused");
+		f.check(server.ID_to_entity(child) != nullptr, "...and the item still exists");
+		CSE_Abstract* item = server.ID_to_entity(child);
+		f.check(item && item->ID_Parent == actor->ID(), "...in the actor's inventory");
+	}
+	else
+	{
+		write_event_header(P, GE_DESTROY, actor->ID());
+		server.OnMessage(P, remote_id);
+		f.check(stats.remote_events_refused == events0 + 2, "a remote GE_DESTROY of the actor is refused");
+		f.check(server.ID_to_entity(actor->ID()) == se_actor, "...and the actor still exists");
+	}
+	write_event_header(P, GE_OWNERSHIP_TAKE, actor->ID());
+	P.w_u16(child);
+	server.OnMessage(P, remote_id);
+	f.check(stats.remote_events_refused == events0 + 3, "a remote GE_OWNERSHIP_TAKE is refused");
+	write_event_header(P, GE_INFO_TRANSFER, actor->ID());
+	P.w_stringZ("s03_t02_remote_info");
+	P.w_u8(1);
+	server.OnMessage(P, remote_id);
+	f.check(stats.remote_events_refused == events0 + 4, "a remote GE_INFO_TRANSFER is refused");
+	f.check(!actor->HasInfo("s03_t02_remote_info"), "...and the actor did not receive the info");
+	shared_str visual = se_actor->get_visual();
+	write_event_header(P, GE_CHANGE_VISUAL, actor->ID());
+	P.w_stringZ("actors\\s03_t02_forged");
+	server.OnMessage(P, remote_id);
+	f.check(stats.remote_events_refused == events0 + 5, "a remote GE_CHANGE_VISUAL is refused");
+	f.check(xr_strcmp(se_actor->get_visual(), visual.c_str()) == 0, "...and the actor's visual is unchanged");
+	// Packed events are unwrapped and refused one by one.
+	{
+		NET_Packet inner;
+		write_event_header(inner, GE_HIT, actor->ID());
+		inner.w_u16(actor->ID());
+		P.w_begin(M_EVENT_PACK);
+		P.w_u8(u8(inner.B.count));
+		P.w(inner.B.data, inner.B.count);
+		server.OnMessage(P, remote_id);
+		f.check(stats.remote_events_refused == events0 + 6, "a remote M_EVENT_PACK's GE_HIT is refused");
+	}
+	// The bridge's events still reach the server: the same visual, set again.
+	write_event_header(P, GE_CHANGE_VISUAL, actor->ID());
+	P.w_stringZ(visual.c_str());
+	server.OnMessage(P, bridge_id);
+	f.check(stats.bridge_events == bridge_events0 + 1, "the bridge's GE_CHANGE_VISUAL is accepted");
+	f.check(xr_strcmp(se_actor->get_visual(), visual.c_str()) == 0, "...and keeps the actor's visual");
+	// A remote's input message passes the policy (an intent, not an outcome).
+	P.w_begin(M_CL_INPUT);
+	server.OnMessage(P, remote_id);
+	f.check(stats.remote_accepted == accepted0 + 1, "a remote M_CL_INPUT is accepted");
+	f.check(fsimilar(se_actor->get_health(), health) && fsimilar(actor->GetfHealth(), live_health),
+		"the actor's health is unchanged after every remote message");
+
+	Msg("S03-T02 authority-check remote_refused=%I64u remote_events_refused=%I64u remote_accepted=%I64u "
+		"remote_delegated=%I64u unknown_sender=%I64u bridge_messages=%I64u bridge_events=%I64u health=%.4f "
+		"live_health=%.4f child=%u",
+		stats.remote_refused - refused0, stats.remote_events_refused - events0, stats.remote_accepted - accepted0,
+		stats.remote_delegated, stats.unknown_sender - unknown0, stats.bridge_messages - bridge0, stats.bridge_events - bridge_events0,
+		se_actor->get_health(), actor->GetfHealth(), u32(child));
+
+	// Leave the server as found: the remote client goes, participant 2 is released.
+	server.client_Destroy(remote);
+	f.check(server.ID_to_client(remote_id) == nullptr, "the remote client is gone");
+	f.expect(registry.release_participant(authority, p2, Device.dwFrame), Refusal::None, "release participant 2");
+	f.check(participant_actor(p1) == actor, "participant 1 still holds the saved actor");
+	report_actor_access("authority-check");
+	report_message_policy("authority-check");
+	return f.done();
+}
