+	"        pending[#pending + 1] = { index = index, slot = slot, d = d, cover = tostring(c), hp0 = hp0,\n"
+	"          err = ok and '' or (' error=' .. tostring(err)) }\n"
+	"      end\n"
+	"    end\n"
+	"  end\n"
+	"  S.emission_wrap = S.emission_wrap .. '+psi'\n"
+	"  S.wrapped = S.wrapped + 1\n"
+	"end\n"
