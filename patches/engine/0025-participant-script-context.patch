+void set_task_owner(CGameTask* task, const CObject* receiver)
+{
+	if (!task || !server_role())
+		return;
+	ParticipantRef ref;
+	if (participant_of(receiver, ref) != Refusal::None)
+	{
+		Msg("S03-T05 task [%s] given to object %u, which no participant holds: no owner", task->m_ID.c_str(),
+			receiver ? u32(receiver->ID()) : u32(-1));
+		return;
+	}
+	task->m_campaign_owned = true;
+	task->m_campaign_owner = ref;
+	Msg("S03-T05 task [%s] owner participant {%u,%u} (actor %u)", task->m_ID.c_str(), u32(ref.slot), ref.generation,
+		u32(receiver->ID()));
+}
