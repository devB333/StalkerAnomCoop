+static u16 talk_story_action(PlayerLink& link, LPCSTR action, const CGameObject* speaker, CGameObject* npc,
+	LPCSTR dialog_id, LPCSTR phrase_id)
+{
+	CActor* anchor = party_anchor();
+	if (!anchor || !anchor->g_Alive())
+		return coop::proto::kReasonNoActor;
+	luabind::functor<void> f;
+	if (!ai().script_engine().functor(action, f))
+		return coop::proto::kReasonQuestNotOffered;
+	sync_party_actors();
+	bool cf = false;
+	if (story_finish_action(action, cf))
+		adopt_story_finished(link, npc, anchor, cf);
+	xr_vector<shared_str> before;
+	active_task_ids(before);
+	bool ran = false;
+	{
+		CActor* clicker = participant_actor(link.ref);
+		campaign::PartyPurseScope purse(u16(anchor->ID()), clicker ? u16(clicker->ID()) : u16(anchor->ID()), false); // G10
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(anchor), "party-story-action");
+		if (scope.entered())
+		{
+			CScriptGameObject* a = anchor->lua_game_object();
+			CScriptGameObject* n = npc->lua_game_object();
+			if (smart_cast<const CActor*>(speaker))
+				f(a, n, dialog_id, phrase_id);
+			else
+				f(n, a, dialog_id, phrase_id);
+			ran = true;
+		}
+	}
+	const u32 adopted = ran ? adopt_story_tasks(link, before, u16(npc->ID()), anchor, action) : 0;
+	g_host->log.line("quest-story-action slot=%u action=%s ran=%d adopted=%u", u32(link.ref.slot), action, ran ? 1 : 0,
+		adopted);
+	return ran ? 0 : u16(coop::proto::kReasonNoActor);
+}
