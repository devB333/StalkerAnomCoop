+			return false;
+		}
+		const u32 before = actor->get_money();
+		actor->set_money(r.money_after, true); // the GE_MONEY event keeps the server entity's money in step
+		ledger_csv(phase, revision, r);
+		g_host->log.line("ledger-%s revision=%I64u slot=%u actor=%u operation=%I64u delta=%d money=%u->%u", phase,
+			revision, u32(r.slot), u32(actor->ID()), r.operation, r.delta, before, actor->get_money());
+		return true;
+	}
+	g_host->log.line("ledger-apply-failed phase=%s revision=%I64u slot=%u reason=no-participant", phase, revision,
+		u32(r.slot));
+	return false;
+}
