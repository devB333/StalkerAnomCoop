+// ------------------------------------------------------------ S10-T03c
+// Party sleep (matrix F9, decision T01-8). The installed sleep window
+// (ui_sleep_dialog) runs on the client; its button sends a request (ActionIntent
+// kind 24, the hours) and the partner agrees or refuses (kind 25) under the
+// travel consent's rules: no partner, no sleep; 30 s to answer; combat, a
+// death or a disconnect aborts. Agreed: the world's time skips once
+// (level.change_game_time, as dream_callback does), the scripts' actor_on_sleep
+// runs once in the requester's context (the world's listeners and its own
+// survival values) and the per-player survival modules' handler in the
+// partner's, both actors' stamina is restored, a checkpoint is asked for, and
+// both clients present the sleep (CampaignEvent 19). Passing out
+// (ui_sleep_dialog.sleep_forced, from the per-player survival updates) skips
+// no time: it is that player's blackout (input held, its client fades out,
+// its sleep recovered when it wakes); the installed 5 % death chance after it
+// stays the script's.
+const u32 kBlackoutSeconds = 8;
+
+void sleep_event_to(PlayerLink& link, const coop::proto::Transition& t, u8 state, u8 hours, u32 remaining_ms)
+{
+	std::vector<u8> payload;
+	for (int b = 0; b < 8; ++b)
+		payload.push_back(u8(t.id >> (8 * b)));
+	put_u8(payload, state);
+	put_u8(payload, t.requester);
+	put_u8(payload, t.partner);
+	put_u8(payload, u8(t.abort));
+	put_u8(payload, hours);
+	put_u32(payload, remaining_ms);
+	queue_event(link, 19, payload);
+	link.sleep_sent_id = state == u8(coop::proto::TravelState::Proposed) ? t.id : 0;
+}
+
+void sleep_event(const coop::proto::Transition& t, u32 remaining_ms)
+{
+	for (PlayerLink& link : g_host->links)
+		if (client_in_world(link))
+			sleep_event_to(link, t, u8(t.state), u8(t.destination), remaining_ms);
+}
+
+// Runs a chunk in a player's script context (or none: slot 0xff).
+bool sleep_lua(CActor* actor, LPCSTR chunk, LPCSTR label)
+{
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return false;
+	const int top = lua_gettop(L);
+	bool ok = false;
+	if (luaL_loadstring(L, chunk) == 0)
+	{
+		if (actor)
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), label);
+			ok = lua_pcall(L, 0, 0, 0) == 0;
+		}
+		else
+			ok = lua_pcall(L, 0, 0, 0) == 0;
+		if (!ok)
+			g_host->log.line("sleep-lua-error label=%s error=%s", label, lua_tostring(L, -1) ? lua_tostring(L, -1) : "?");
+	}
+	lua_settop(L, top);
+	return ok;
+}
+
+double sleep_game_hours()
+{
+	return double(ai().get_alife() ? ai().alife().time_manager().game_time() : 0) / 3600000.0;
+}
+
+// The agreed sleep: one skip of the world's time, both players rested.
+void sleep_apply(const coop::proto::Transition& t)
+{
+	const u8 hours = u8(t.destination);
+	const double before = sleep_game_hours();
+	CActor* requester = nullptr;
+	CActor* partner = nullptr;
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot < 2)
+			if (CActor* a = participant_actor(l.ref))
+			{
+				if (l.ref.slot == t.requester)
+					requester = a;
+				else if (l.ref.slot == t.partner)
+					partner = a;
+			}
+	string256 chunk;
+	xr_sprintf(chunk, "level.change_game_time(0, %u, 0)", u32(hours));
+	const bool skipped = sleep_lua(nullptr, chunk, "sleep-skip");
+	xr_sprintf(chunk, "if db.actor then db.actor.power = 1 end SendScriptCallback('actor_on_sleep', %u)", u32(hours));
+	const bool req_ok = requester && sleep_lua(requester, chunk, "sleep-requester");
+	xr_sprintf(chunk, "if db.actor then db.actor.power = 1 end\n"
+		"for _, m in ipairs({'actor_status_sleep', 'actor_status_thirst', 'arszi_psy'}) do\n"
+		"  local mod = _G[m] if mod and mod.actor_on_sleep then mod.actor_on_sleep(%u) end\n"
+		"end", u32(hours));
+	const bool part_ok = partner && sleep_lua(partner, chunk, "sleep-partner");
+	++g_host->sleep.slept;
+	const bool published = request_publication("sleep");
+	g_host->log.line("sleep-slept id=%I64x hours=%u game_hours=%.3f->%.3f skipped=%d requester=%d partner=%d published=%d",
+		t.id, u32(hours), before, sleep_game_hours(), skipped ? 1 : 0, req_ok ? 1 : 0, part_ok ? 1 : 0, published ? 1 : 0);
+}
+
+void end_sleep(const coop::proto::Transition& t)
+{
+	const u64 now = g_host->wall.GetElapsed_ms();
+	g_host->log.line("sleep-end id=%I64x state=%s abort=%s requester=%u partner=%u hours=%u after_ms=%I64u", t.id,
+		coop::proto::to_string(t.state), coop::proto::to_string(t.abort), u32(t.requester), u32(t.partner),
+		u32(t.destination), now - t.proposed_ms);
+	if (t.state == coop::proto::TravelState::Agreed)
+		sleep_apply(t);
+	sleep_event(t, 0);
+}
+
+bool sleep_abort(coop::proto::TravelAbort why)
+{
+	coop::proto::Transition out;
+	if (!g_host->sleep.coordinator || !g_host->sleep.coordinator->abort(why, g_host->wall.GetElapsed_ms(), out))
+		return false;
+	end_sleep(out);
+	return true;
+}
+
+u16 take_sleep_request(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	u16 reason = 0;
+	if (travel_known(link, intent, result, reason))
+		return reason;
+	++g_host->sleep.requests;
+	if (!link.session || !g_host->sleep.coordinator)
+		return coop::proto::kReasonNoActor;
+	if (g_host->travel.exec)
+		return coop::proto::kReasonTravelInProgress;
+	if (intent.params.size() != 1 || intent.params[0] < 1 || intent.params[0] > 24)
+		return coop::proto::kReasonMalformed;
+	const u8 hours = intent.params[0];
+	CActor* actor = participant_actor(link.ref);
+	if (!actor || !actor->g_Alive())
+		return coop::proto::kReasonNoActor;
+	// the installed window's rule (TestAndShow): no sleep while bleeding or irradiated; nor while passed out
+	const float bleeding = actor->conditions().BleedingSpeed();
+	const float radiation = actor->conditions().GetRadiation();
+	if (bleeding > 0.f || radiation > 0.f || g_host->tick < link.blackout_until_tick)
+	{
+		g_host->log.line("sleep-cannot slot=%u bleeding=%.4f radiation=%.4f blackout=%d", u32(link.ref.slot), bleeding,
+			radiation, g_host->tick < link.blackout_until_tick ? 1 : 0);
+		return coop::proto::kReasonCannotSleep;
+	}
+	if (g_host->travel.coordinator && g_host->travel.coordinator->live())
+		return coop::proto::kReasonTravelBusy;
+	PlayerLink* partner = travel_partner(link.ref.slot);
+	CActor* partner_actor = partner ? participant_actor(partner->ref) : nullptr;
+	if (!partner || !client_in_world(*partner) || !partner_actor || !partner_actor->g_Alive())
+	{
+		g_host->log.line("sleep-partner-unavailable slot=%u", u32(link.ref.slot));
+		return coop::proto::kReasonPartnerUnavailable;
+	}
+	string256 who;
+	if (party_in_combat(who))
+	{
+		g_host->log.line("sleep-in-combat slot=%u enemy=%s", u32(link.ref.slot), who);
+		return coop::proto::kReasonInCombat;
+	}
+	coop::proto::Transition t;
+	const coop::proto::TravelVerdict verdict = g_host->sleep.coordinator->propose(link.ref.slot, partner->ref.slot, hours,
+		g_host->wall.GetElapsed_ms(), t);
+	if (verdict == coop::proto::TravelVerdict::Busy)
+		return coop::proto::kReasonTravelBusy;
+	if (verdict != coop::proto::TravelVerdict::Ok)
+		return coop::proto::kReasonWrongParty;
+	++g_host->sleep.proposals;
+	g_host->log.line("sleep-proposed id=%I64x requester=%u partner=%u hours=%u deadline_ms=%I64u operation=%I64x", t.id,
+		u32(t.requester), u32(t.partner), u32(hours), t.deadline_ms - t.proposed_ms, intent.operation_id);
+	sleep_event(t, u32(t.deadline_ms - t.proposed_ms));
+	travel_remember(link, intent.operation_id, 0, t.id);
+	result.commit_id = 0;
+	result.revision = t.id;
+	return 0;
+}
+
+u16 take_sleep_answer(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	u16 reason = 0;
+	if (travel_known(link, intent, result, reason))
+		return reason;
+	++g_host->sleep.answers;
+	if (!link.session || !g_host->sleep.coordinator)
+		return coop::proto::kReasonNoActor;
+	if (intent.params.size() != 9)
+		return coop::proto::kReasonMalformed;
+	u64 id = 0;
+	for (int b = 0; b < 8; ++b)
+		id |= u64(intent.params[b]) << (8 * b);
+	const u8 answer = intent.params[8];
+	if (answer < 1 || answer > 3)
+		return coop::proto::kReasonMalformed;
+	coop::proto::TransitionCoordinator& c = *g_host->sleep.coordinator;
+	const coop::proto::Transition* live = c.live();
+	if (!live || live->id != id)
+	{
+		g_host->log.line("sleep-no-proposal slot=%u id=%I64x answer=%u live=%I64x", u32(link.ref.slot), id, u32(answer),
+			live ? live->id : 0ull);
+		return coop::proto::kReasonNoTransition;
+	}
+	if (answer == 1 && live->partner == link.ref.slot)
+	{
+		CActor* actor = participant_actor(link.ref);
+		if (!actor || !actor->g_Alive())
+			return coop::proto::kReasonNoActor;
+		string256 who;
+		if (party_in_combat(who))
+			return coop::proto::kReasonInCombat;
+	}
+	coop::proto::Transition out;
+	const coop::proto::TravelVerdict v =
+		c.answer(link.ref.slot, id, coop::proto::TravelAnswer(answer), g_host->wall.GetElapsed_ms(), out);
+	if (v == coop::proto::TravelVerdict::WrongParty)
+	{
+		g_host->log.line("sleep-wrong-party slot=%u id=%I64x answer=%u", u32(link.ref.slot), id, u32(answer));
+		return coop::proto::kReasonWrongParty;
+	}
+	if (v != coop::proto::TravelVerdict::Ok)
+		return coop::proto::kReasonNoTransition;
+	g_host->log.line("sleep-answer slot=%u id=%I64x answer=%s -> %s", u32(link.ref.slot), id,
+		answer == 1 ? "accept" : answer == 2 ? "refuse" : "cancel", coop::proto::to_string(out.state));
+	travel_remember(link, intent.operation_id, 0, id);
+	end_sleep(out);
+	result.commit_id = 0;
+	result.revision = id;
+	return 0;
+}
+
+// A player passed out (ui_sleep_dialog.sleep_forced in its context): its
+// blackout; no time skip
+void sleep_blackout(u8 slot, u8 hours)
+{
+	if (!g_host)
+		return;
+	for (PlayerLink& l : g_host->links)
+	{
+		if (!l.bound || l.ref.slot != slot)
+			continue;
+		if (g_host->tick < l.blackout_until_tick)
+			return;
+		l.blackout_until_tick = g_host->tick + kBlackoutSeconds * 50;
+		l.blackout_hours = hours;
+		++g_host->sleep.blackouts;
+		g_host->log.line("sleep-blackout slot=%u hours=%u seconds=%u game_hours=%.3f", u32(slot), u32(hours),
+			kBlackoutSeconds, sleep_game_hours());
+		if (client_in_world(l))
+		{
+			coop::proto::Transition t;
+			t.requester = t.partner = slot;
+			sleep_event_to(l, t, 11, hours, kBlackoutSeconds * 1000);
+		}
+		return;
+	}
+}
+
+void sleep_tick()
+{
+	// the blackouts that end: the player wakes, rested as the script's sleep would leave it
+	for (PlayerLink& l : g_host->links)
+		if (l.blackout_until_tick && g_host->tick >= l.blackout_until_tick)
+		{
+			l.blackout_until_tick = 0;
+			CActor* a = participant_actor(l.ref);
+			string256 chunk;
+			xr_sprintf(chunk, "if db.actor then db.actor.power = 1 end\n"
+				"for _, m in ipairs({'actor_status_sleep', 'actor_status_thirst', 'arszi_psy'}) do\n"
+				"  local mod = _G[m] if mod and mod.actor_on_sleep then mod.actor_on_sleep(%u) end\n"
+				"end", u32(l.blackout_hours));
+			const bool ok = a && a->g_Alive() && sleep_lua(a, chunk, "blackout-wake");
+			g_host->log.line("sleep-woke slot=%u hours=%u alive=%d rested=%d held=%I64u game_hours=%.3f", u32(l.ref.slot),
+				u32(l.blackout_hours), a && a->g_Alive() ? 1 : 0, ok ? 1 : 0, l.blackout_inputs_held, sleep_game_hours());
+		}
+	if (!g_host->sleep.coordinator)
+		return;
+	coop::proto::TransitionCoordinator& c = *g_host->sleep.coordinator;
+	const u64 now = g_host->wall.GetElapsed_ms();
+	coop::proto::Transition out;
+	if (c.expire(now, out))
+	{
+		end_sleep(out);
+		return;
+	}
+	const coop::proto::Transition* live = c.live();
+	if (!live)
+		return;
+	if (g_host->tick - g_host->sleep.last_check_tick >= 25)
+	{
+		g_host->sleep.last_check_tick = g_host->tick;
+		for (PlayerLink& l : g_host->links)
+		{
+			if (!l.bound || (l.ref.slot != live->requester && l.ref.slot != live->partner))
+				continue;
+			const bool requester = l.ref.slot == live->requester;
+			CActor* a = participant_actor(l.ref);
+			if (!client_in_world(l))
+			{
+				sleep_abort(requester ? coop::proto::TravelAbort::RequesterLeft : coop::proto::TravelAbort::PartnerLeft);
+				return;
+			}
+			if (!a || !a->g_Alive())
+			{
+				sleep_abort(requester ? coop::proto::TravelAbort::RequesterDead : coop::proto::TravelAbort::PartnerDead);
+				return;
+			}
+		}
+		string256 who;
+		if (party_in_combat(who))
+		{
+			g_host->log.line("sleep-combat-abort id=%I64x enemy=%s", live->id, who);
+			sleep_abort(coop::proto::TravelAbort::Combat);
+			return;
+		}
+	}
+	for (PlayerLink& l : g_host->links)
+		if (client_in_world(l) && l.sleep_sent_id != live->id)
+			sleep_event_to(l, *live, u8(live->state), u8(live->destination),
+				u32(live->deadline_ms > now ? live->deadline_ms - now : 0));
+}
+
+void sleep_on_left(const PlayerLink& link)
+{
+	if (!g_host->sleep.coordinator)
+		return;
+	const coop::proto::Transition* live = g_host->sleep.coordinator->live();
+	if (!live || !link.bound)
+		return;
+	if (link.ref.slot == live->requester)
+		sleep_abort(coop::proto::TravelAbort::RequesterLeft);
+	else if (link.ref.slot == live->partner)
+		sleep_abort(coop::proto::TravelAbort::PartnerLeft);
+}
+
+// The sleep fixture (profile sleep_party, server-driven; the intents are the
+// ones the clients' keys and window send, made on the server). Both players'
+// sleep need is set to 5000, p2's radiation cleared (the window's rule). Then:
+// a stale answer (28); p2 asks for 3 h; p2's own accept (29); a travel request
+// while it is up (23); p1 refuses: no time passes. p2 asks again, p1 accepts:
+// the world's time skips 3 h once, both players' need drops. Then p2 passes out
+// (ui_sleep_dialog.sleep_forced(4) in p2's context, as the survival update
+// calls it): no time skip, p2's input held, p1's not; when p2 wakes its need
+// drops, p1's does not. compare-coop-sleep.py checks the lines.
+void needs_set(u8 slot, LPCSTR module, LPCSTR name, float value)
+{
+	lua_State* L = ai().script_engine().lua();
+	if (!L || !g_host->needs_adapter)
+		return;
+	const u8 was = g_host->needs_current;
+	needs_switch(slot);
+	const int top = lua_gettop(L);
+	const int at = campaign::script_module_upvalue(L, module, name);
+	if (at)
+	{
+		lua_pushnumber(L, value);
+		lua_setupvalue(L, -2, at);
+	}
+	lua_settop(L, top);
+	needs_switch(was);
+}
+
+u16 sleep_fixture_intent(PlayerLink& link, u16 kind, const std::vector<u8>& params, u64& revision)
+{
+	Host::Sleep::Fixture& f = g_host->sleep.fixture;
+	coop::proto::ActionIntent intent;
+	intent.operation_id = ++f.operation;
+	intent.kind = kind;
+	intent.params = params;
+	coop::proto::ActionResult result;
+	u16 reason = 0;
+	if (kind == coop::proto::kActionSleepRequest)
+		reason = take_sleep_request(link, intent, result);
+	else if (kind == coop::proto::kActionSleepAnswer)
+		reason = take_sleep_answer(link, intent, result);
+	else
+		reason = take_travel_request(link, intent, result);
+	revision = result.revision;
+	return reason;
+}
+
+std::vector<u8> sleep_answer_params(u64 id, u8 answer)
+{
+	std::vector<u8> p;
+	for (int b = 0; b < 8; ++b)
+		p.push_back(u8(id >> (8 * b)));
+	p.push_back(answer);
+	return p;
+}
+
+void sleep_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.sleep_party || !ai().get_alife())
+		return;
+	Host::Sleep::Fixture& f = g_host->sleep.fixture;
+	PlayerLink* links[2] = {nullptr, nullptr};
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.ref.slot < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				links[link.ref.slot] = &link;
+				actors[link.ref.slot] = actor;
+				++attached;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-sleep both-attached tick=%I64u", g_host->tick);
+	}
+	if (attached < 2 || f.phase >= 999 || g_host->tick < f.both_since + u64(config.sleep_party) * 50)
+		return;
+	PlayerLink& l1 = *links[0];
+	PlayerLink& l2 = *links[1];
+	float n1[3], n2[3];
+	u64 rev = 0;
+	if (f.phase == 0)
+	{
+		actors[1]->conditions().ChangeRadiation(-actors[1]->conditions().GetRadiation());
+		needs_set(0, "actor_status_sleep", "last_sleep", 5000.f);
+		needs_set(1, "actor_status_sleep", "last_sleep", 5000.f);
+		needs_values(0, n1);
+		needs_values(1, n2);
+		f.game_hours0 = sleep_game_hours();
+		const u16 stale = sleep_fixture_intent(l1, coop::proto::kActionSleepAnswer, sleep_answer_params(0x1234, 1), rev);
+		u64 id = 0;
+		const u16 req = sleep_fixture_intent(l2, coop::proto::kActionSleepRequest, std::vector<u8>(1, 3), id);
+		const u16 own = sleep_fixture_intent(l2, coop::proto::kActionSleepAnswer, sleep_answer_params(id, 1), rev);
+		const u16 travel = sleep_fixture_intent(l1, coop::proto::kActionTravelRequest, std::vector<u8>(), rev);
+		const u16 refuse = sleep_fixture_intent(l1, coop::proto::kActionSleepAnswer, sleep_answer_params(id, 2), rev);
+		const bool pass = stale == coop::proto::kReasonNoTransition && req == 0 && id != 0 &&
+			own == coop::proto::kReasonWrongParty && travel == coop::proto::kReasonTravelBusy && refuse == 0;
+		if (!pass)
+			++f.failures;
+		g_host->log.line("fixture-sleep refused-round stale=%u request=%u id=%I64x own_accept=%u travel=%u refuse=%u "
+			"sleep_p1=%.1f sleep_p2=%.1f pass=%d", u32(stale), u32(req), id, u32(own), u32(travel), u32(refuse), n1[1], n2[1],
+			pass ? 1 : 0);
+		f.phase = 1;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		if (g_host->tick - f.phase_tick < 2 * 50)
+			return;
+		const double now = sleep_game_hours();
+		const bool pass = now - f.game_hours0 < 0.1;
+		if (!pass)
+			++f.failures;
+		g_host->log.line("fixture-sleep refused-time game_hours=%.3f->%.3f pass=%d", f.game_hours0, now, pass ? 1 : 0);
+		needs_values(0, n1);
+		needs_values(1, n2);
+		f.sleep0[0] = n1[1];
+		f.sleep0[1] = n2[1];
+		f.game_hours0 = now;
+		u64 id = 0;
