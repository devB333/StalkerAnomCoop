+		g_host->log.line("fixture-task probe-spawned id=%u", u32(f.probe_npc));
+		f.phase = f.probe_npc < 0xfffe ? 4 : 9;
+		f.phase_tick = g_host->tick;
+		if (f.phase == 9)
