+// --- message-policy --------------------------------------------------------
+
+bool fixture_message_policy()
+{
+	Check f("message-policy-fixture");
+	static const u16 refused[] = {M_UPDATE, M_SPAWN, M_SAVE_PACKET, M_SAVE_GAME, M_LOAD_GAME, M_RELOAD_GAME,
+		M_CHANGE_LEVEL, M_SWITCH_DISTANCE, M_CHANGE_LEVEL_GAME, M_GAMEMESSAGE, M_PLAYER_FIRE, M_STATISTIC_UPDATE,
+		M_STATISTIC_UPDATE_RESPOND, M_CHANGE_SELF_NAME, M_SV_CONFIG_NEW_CLIENT, M_SV_CONFIG_GAME,
+		M_SV_CONFIG_FINISHED, M_MIGRATE_DEACTIVATE, M_MIGRATE_ACTIVATE, M_UPDATE_OBJECTS,
+		M_COMPRESSED_UPDATE_OBJECTS, M_MOVE_PLAYERS, M_MOVE_ARTEFACTS, M_MAKE_SCREENSHOT, 0x7eef};
+	static const u16 accepted[] = {M_CL_INPUT, M_CL_UPDATE, M_MOVE_PLAYERS_RESPOND, M_CLIENTREADY,
+		M_CLIENT_REQUEST_CONNECTION_DATA, M_CHAT_MESSAGE, M_SV_MAP_NAME, M_SV_DIGEST, M_CL_AUTH,
+		M_CREATE_PLAYER_STATE, M_REMOTE_CONTROL_AUTH, M_REMOTE_CONTROL_CMD, M_FILE_TRANSFER, M_SECURE_KEY_SYNC,
+		M_SECURE_MESSAGE, M_BATTLEYE, M_EVENT, M_EVENT_PACK};
+	for (u32 i = 0; i < sizeof(refused) / sizeof(refused[0]); ++i)
+	{
+		string128 what;
+		xr_sprintf(what, "%s (%u) from a remote is refused", message_name(refused[i]), u32(refused[i]));
+		f.check(server_message_policy(refused[i], false) == MessageVerdict::Refuse, what);
+		xr_sprintf(what, "%s (%u) from the bridge is accepted", message_name(refused[i]), u32(refused[i]));
+		f.check(server_message_policy(refused[i], true) == MessageVerdict::Accept, what);
+	}
+	for (u32 i = 0; i < sizeof(accepted) / sizeof(accepted[0]); ++i)
+	{
+		string128 what;
+		xr_sprintf(what, "%s (%u) from a remote is accepted", message_name(accepted[i]), u32(accepted[i]));
+		f.check(server_message_policy(accepted[i], false) == MessageVerdict::Accept, what);
+		f.check(classify_message(accepted[i]) == MessageClass::Intent ||
+				classify_message(accepted[i]) == MessageClass::Connection ||
+				accepted[i] == M_EVENT || accepted[i] == M_EVENT_PACK,
+			"an accepted remote message is an intent, a connection message or an event wrapper");
+	}
+	f.check(classify_message(M_UPDATE) == MessageClass::StateImport && classify_message(M_SPAWN) == MessageClass::StateImport &&
+			classify_message(M_SAVE_PACKET) == MessageClass::StateImport,
+		"the three state imports are classified as such");
+	f.check(classify_message(M_SAVE_GAME) == MessageClass::WorldControl &&
+			classify_message(M_LOAD_GAME) == MessageClass::WorldControl &&
+			classify_message(M_CHANGE_LEVEL) == MessageClass::WorldControl &&
+			classify_message(M_SWITCH_DISTANCE) == MessageClass::WorldControl,
+		"world control messages are classified as such");
+	f.check(classify_message(0x7eef) == MessageClass::Unknown, "an unknown message type is unknown");
+
+	u32 events = 0;
+	for (u16 type = GE_RESPAWN; type <= GE_TRADER_FLAGS; ++type)
+	{
+		++events;
+		if (!f.check(server_event_policy(type, false) == MessageVerdict::Refuse, "every game event from a remote is refused"))
+			Msg("! S03-T02 event %u (%s) accepted from a remote", u32(type), game_event_name(type));
+		f.check(server_event_policy(type, true) == MessageVerdict::Accept, "every game event from the bridge is accepted");
+		if (!f.check(classify_game_event(type) == MessageClass::Outcome, "every defined game event is an outcome"))
+			Msg("! S03-T02 event %u (%s) unclassified", u32(type), game_event_name(type));
+	}
+	f.check(classify_game_event(0x7eef) == MessageClass::Unknown, "an unknown game event is unknown");
+	f.check(server_event_policy(0x7eef, false) == MessageVerdict::Refuse, "an unknown game event from a remote is refused");
+	Msg("S03-T02 message-policy refused_types=%u accepted_types=%u game_events=%u",
+		u32(sizeof(refused) / sizeof(refused[0])), u32(sizeof(accepted) / sizeof(accepted[0])), events);
+	return f.done();
+}
