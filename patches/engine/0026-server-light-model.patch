+// S03-T06: a level vertex 100-250 m from the actor with no alive stalker or
+// monster online within 80 m.
+bool quiet_vertex(CActor* actor, u32& vertex, Fvector& position)
+{
+	const float distances[] = {120.f, 160.f, 200.f, 250.f, 100.f};
+	for (float d : distances)
+		for (int k = 0; k < 16; ++k)
+		{
+			const float a = float(k) * PI_MUL_2 / 16.f;
+			Fvector target = actor->Position();
+			target.x += d * _cos(a);
+			target.z += d * _sin(a);
+			if (!vertex_at(target, vertex, position))
+				continue;
+			bool quiet = true;
+			for (u32 i = 0; quiet && i < Level().Objects.o_count(); ++i)
+			{
+				CCustomMonster* m = smart_cast<CCustomMonster*>(Level().Objects.o_get_by_iterator(i));
+				if (m && !m->getDestroy() && m->g_Alive() && m->Position().distance_to(position) < 80.f)
+					quiet = false;
+			}
+			if (quiet)
+				return true;
+		}
+	return false;
+}
