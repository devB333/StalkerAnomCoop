+void refresh_inventory_ui()
+{
+	LPCSTR chunk = "if ui_inventory and ui_inventory.GUI and ui_inventory.GUI:IsShown() then "
+		"pcall(function() ui_inventory.GUI:UpdateItems() end) end";
+	lua_State* L = ai().script_engine().lua();
+	if (L && luaL_loadbuffer(L, chunk, xr_strlen(chunk), "coop_inventory_refresh") == 0)
+	{
+		if (lua_pcall(L, 0, 0, 0) != 0)
+			lua_pop(L, 1);
+	}
+	else if (L)
+		lua_pop(L, 1);
+}
+
+// Applies one actor's target layout to the replica; the number of items not
+// resolvable yet (not in this actor's inventory here).
+u32 apply_layout(u64 actor_entity, Link::ActorLayout& l, u32& moves)
+{
+	const auto a = g_link->by_entity.find(actor_entity);
+	CActor* actor = a != g_link->by_entity.end() ? smart_cast<CActor*>(Level().Objects.net_Find(a->second)) : nullptr;
+	if (!actor)
+		return u32(l.target.size());
+	CInventory& inventory = actor->inventory();
+	u32 unresolved = 0;
+	// out of the slots and the belt first, so a slot is free when its item arrives
+	for (u8 pass = 0; pass < 3; ++pass)
+	{
+		const u8 place = pass == 0 ? 3 : (pass == 1 ? 2 : 1);
+		for (const Link::LayoutItem& e : l.target)
+		{
+			if (e.place != place)
+				continue;
+			const auto it = g_link->by_entity.find(e.entity);
+			CObject* object = it != g_link->by_entity.end() ? Level().Objects.net_Find(it->second) : nullptr;
+			CInventoryItem* item = object ? smart_cast<CInventoryItem*>(object) : nullptr;
+			if (!item || object->H_Parent() != actor || item->m_pInventory != &inventory)
+			{
+				++unresolved;
+				continue;
+			}
+			if (CEatableItem* eatable = e.uses != 0xff ? smart_cast<CEatableItem*>(item) : nullptr)
+				if (eatable->GetRemainingUses() != e.uses)
+				{
+					eatable->SetRemainingUses(e.uses);
+					++moves;
+				}
+			if (item->CurrPlace() == e.place && (e.place != 1 || item->CurrSlot() == e.slot))
+				continue;
+			bool ok;
+			if (e.place == 3)
+				ok = inventory.Ruck(item, true);
+			else if (e.place == 2)
+				ok = inventory.Belt(item, true);
+			else
+			{
+				if (PIItem occupant = inventory.ItemFromSlot(e.slot))
+					if (occupant != item)
+						inventory.Ruck(occupant, true);
+				ok = inventory.Slot(e.slot, item, true, true);
+			}
+			++moves;
+			if (!ok)
+				++unresolved;
+		}
+	}
+	return unresolved;
+}
+
+void layout_point_frame();
+
+void layout_frame()
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	bool changed = false;
+	for (auto& x : g_link->layouts)
+	{
+		Link::ActorLayout& l = x.second;
+		if (l.settled)
+			continue;
+		u32 moves = 0;
+		const u32 unresolved = apply_layout(x.first, l, moves);
+		g_link->layout_moves += moves;
+		changed = changed || moves;
+		if (!unresolved || now - l.since_ms > 5000)
+		{
+			l.settled = true;
+			if (unresolved)
+				++g_link->layout_unresolved;
+			else
+				++g_link->layouts_applied;
+			layout_csv(unresolved ? "unresolved" : "applied", x.first, l.serial, u32(l.target.size()), moves,
+				unresolved);
+		}
+	}
+	if (changed)
+		refresh_inventory_ui();
+	layout_point_frame();
+}
+
+// The replica's layouts hashed as the server hashes them at an item-graph
+// point (CoopServerHost.cpp participants_layout_hash): per participant slot,
+// the actor's entity, then its items sorted by entity (place, slot, uses).
+u64 replica_layout_hash(u32& items)
+{
+	u64 h = 14695981039346656037ull;
+	items = 0;
+	CActor* by_slot[2] = {nullptr, nullptr};
+	if (g_actor && g_link->local_slot < 2)
+		by_slot[g_link->local_slot] = g_actor;
+	if (g_link->local_slot < 2)
+		by_slot[1 - g_link->local_slot] = other_actor();
+	for (CActor* actor : by_slot)
+	{
+		if (!actor)
+			continue;
+		coop::proto::EntityRef actor_ref;
+		if (!ref_of(u16(actor->ID()), actor_ref))
+			continue;
+		xr_vector<std::pair<u64, u64>> entries;
+		for (PIItem item : actor->inventory().m_all)
+		{
+			coop::proto::EntityRef r;
+			if (!item || item->GetDropManual() || !ref_of(u16(item->object().ID()), r))
+				continue;
+			const u64 place = item->CurrPlace(), slot = place == 1 ? item->CurrSlot() : 0;
+			const CEatableItem* eatable = smart_cast<const CEatableItem*>(item);
+			const u64 uses = eatable ? eatable->GetRemainingUses() : 0xff;
+			entries.push_back({r.id, (place << 16) | (slot << 8) | uses});
+		}
+		std::sort(entries.begin(), entries.end());
+		items += u32(entries.size());
+		h = graph_fnv(h, actor_ref.id);
+		for (const auto& e : entries)
+			h = graph_fnv(graph_fnv(h, e.first), e.second);
+	}
+	return h;
+}
+
+// An item-graph point's layout check: the replica must reach the server's
+// layout hash within 2 s (its last layout applied a frame or two later).
+void layout_point_frame()
+{
+	if (!g_link->layout_point_open)
+		return;
+	u32 items = 0;
+	const u64 hash = replica_layout_hash(items);
+	const u32 waited = g_link->wall.GetElapsed_ms() - g_link->layout_point_ms;
+	const bool match = hash == g_link->layout_point_hash && items == g_link->layout_point_items;
+	if (!match && waited < 2000)
+		return;
+	g_link->layout_point_open = false;
+	++(match ? g_link->layout_matches : g_link->layout_mismatches);
+	g_link->log.line("layout-point seq=%I64u match=%d items=%u server_items=%u hash=%016I64x server_hash=%016I64x "
+		"waited_ms=%u", g_link->layout_point_seq, match ? 1 : 0, items, g_link->layout_point_items, hash,
+		g_link->layout_point_hash, waited);
+	if (!match && g_actor)
+		for (PIItem item : g_actor->inventory().m_all)
+		{
+			coop::proto::EntityRef r;
+			if (!item || !ref_of(u16(item->object().ID()), r))
+				continue;
+			const CEatableItem* eatable = smart_cast<const CEatableItem*>(item);
+			g_link->log.line("layout-own item=%u entity=%I64u section=%s place=%u slot=%u uses=%d drop=%d",
+				u32(item->object().ID()), r.id, item->object().cNameSect().c_str(), u32(item->CurrPlace()),
+				u32(item->CurrSlot()), eatable ? int(eatable->GetRemainingUses()) : -1, item->GetDropManual() ? 1 : 0);
+		}
+}
