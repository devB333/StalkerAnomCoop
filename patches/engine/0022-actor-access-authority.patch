+// --- level check -------------------------------------------------------------
+
+void write_event_header(NET_Packet& P, u16 type, u16 destination)
+{
+	P.w_begin(M_EVENT);
+	P.w_u32(Level().timeServer());
+	P.w_u16(type);
+	P.w_u16(destination);
+}
+
+// A forged M_UPDATE for one entity with its current state, except health.
+void write_actor_update(NET_Packet& P, CSE_ALifeCreatureActor* se_actor, float health)
+{
+	const float saved = se_actor->get_health();
+	P.w_begin(M_UPDATE);
+	P.w_u16(se_actor->ID);
+	const u32 size_pos = P.w_tell();
+	u8 size = 0;
+	P.w_u8(size);
+	const u32 begin = P.w_tell();
+	se_actor->set_health(health);
+	se_actor->UPDATE_Write(P);
+	se_actor->set_health(saved);
+	size = u8(P.w_tell() - begin);
+	P.w_seek(size_pos, &size, sizeof(size));
+}
