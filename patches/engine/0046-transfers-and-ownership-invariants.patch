+// ------------------------------------------------------------ S08-T02
+// Drops and transfers (docs/persistence-contract.md §6 `transfer`): the
+// bounded slice of ownership changes beyond a pickup. A drop (kind 6) puts
+// an item of the player's own actor on the ground at the actor; a transfer
+// (kind 7) moves an item between the player's own actor and a container: an
+// inventory box or a dead body (an NPC's or a participant's corpse). Both go
+// through the six phases like a pickup, as one `transfer` record (absolute
+// post-state: the item ends in `owner_entity`, 0 the ground). Preconditions
+// on the server's state at that tick: the item is where the client said
+// (`from`), and it has not changed owner since the client's lifecycle cursor
+// (the expected revision): an item taken and put back in between is refused
+// Stale, not silently taken. Unsupported variants (a living actor or NPC as
+// the other side, box to box, a trader) are refused NotContainer.
+
+const float kContainerReach = 2.5f; // the use pick reaches 2 m; a body or a box is larger than an item
+const float kContainerSlack = 0.5f;
+
+// A container this slice moves items into or out of.
+bool transfer_container(u16 id, CObject*& object)
+{
+	object = Level().Objects.net_Find(id);
+	CSE_Abstract* se = Level().Server->ID_to_entity(id);
+	if (!object || !se || object->getDestroy())
+		return false;
+	if (smart_cast<CSE_ALifeInventoryBox*>(se) && smart_cast<CInventoryBox*>(object))
+		return true;
+	CEntityAlive* body = smart_cast<CEntityAlive*>(object);
+	return body && !body->g_Alive() && smart_cast<CInventoryOwner*>(object);
+}
+
+bool read_ref(const std::vector<u8>& params, size_t at, coop::proto::EntityRef& out)
+{
+	if (params.size() < at + 12)
+		return false;
+	out.id = 0;
+	out.generation = 0;
+	for (int b = 0; b < 8; ++b)
+		out.id |= u64(params[at + b]) << (8 * b);
+	for (int b = 0; b < 4; ++b)
+		out.generation |= u32(params[at + 8 + b]) << (8 * b);
+	return true;
+}
+
+u16 take_transfer(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	CoopPersistence* persistence = g_host->persistence;
+	const bool drop = intent.kind == coop::proto::kActionDrop;
+	// 1. Receive: a known operation returns its stored outcome.
+	StoredOutcome stored;
+	if (persistence && persistence->lookup(link.player, intent.operation_id, stored))
+	{
+		result.outcome = coop::proto::ActionOutcome(stored.outcome);
+		result.reason = stored.reason;
+		result.commit_id = stored.revision;
+		result.revision = stored.revision;
+		++g_host->transfers_duplicate;
+		g_host->log.line("transfer-duplicate player=%s operation=%I64u outcome=%u revision=%I64u",
+			coop_uuid_hex(link.player).c_str(), intent.operation_id, u32(stored.outcome), stored.revision);
+		return stored.reason;
+	}
+	// 2. Prepare / validate.
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (drop ? !intent.params.empty() : intent.params.size() != 24)
+		return coop::proto::kReasonMalformed;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	coop::proto::EntityRef actor_ref;
+	if (!actor || !actor->g_Alive() || !entity_ref_of(actor->ID(), actor_ref))
+		return coop::proto::kReasonNoActor;
+	const u16 id = engine_id_of(intent.target);
+	CSE_Abstract* se = id != kNoEngineId ? Level().Server->ID_to_entity(id) : nullptr;
+	CObject* object = id != kNoEngineId ? Level().Objects.net_Find(id) : nullptr;
+	if (!se || !object || object->getDestroy())
+		return coop::proto::kReasonItemGone;
+	CInventoryItem* item = smart_cast<CInventoryItem*>(object);
+	if (!smart_cast<CSE_ALifeInventoryItem*>(se) || !item)
+		return coop::proto::kReasonNotTakeable;
+	for (const Host::PickupConfirm& c : g_host->pickup_confirm)
+		if (c.item == id)
+			return coop::proto::kReasonItemTaken; // moved this tick or just before, the level not yet caught up
+	u16 from = actor->ID(), to = 0xffff;
+	coop::proto::EntityRef from_ref = actor_ref, to_ref;
+	float distance = 0.f;
+	if (drop)
+	{
+		if (se->ID_Parent != actor->ID() || object->H_Parent() != actor)
+			return coop::proto::kReasonNotDroppable; // not in the player's own inventory
+		if (item->IsQuestItem())
+			return coop::proto::kReasonNotDroppable;
+	}
+	else
+	{
+		if (!read_ref(intent.params, 0, from_ref) || !read_ref(intent.params, 12, to_ref) || from_ref.none() ||
+			to_ref.none() || from_ref == to_ref)
+			return coop::proto::kReasonMalformed;
+		from = engine_id_of(from_ref);
+		to = engine_id_of(to_ref);
+		if (from == kNoEngineId || to == kNoEngineId)
+			return coop::proto::kReasonItemGone;
+		if (se->ID_Parent != from)
+			return coop::proto::kReasonItemTaken; // not where the client saw it
+		const bool out_of_actor = from == actor->ID();
+		if (out_of_actor == (to == actor->ID()))
+			return coop::proto::kReasonNotContainer; // one side must be the player's own actor
+		CObject* container = nullptr;
+		if (!transfer_container(out_of_actor ? to : from, container))
+			return coop::proto::kReasonNotContainer;
+		distance = pickup_distance(actor, container);
+		if (distance > kContainerReach + kContainerSlack)
+		{
+			g_host->log.line("transfer-out-of-reach slot=%u container=%u distance=%.2f", u32(link.ref.slot),
+				u32(container->ID()), distance);
+			return coop::proto::kReasonOutOfReach;
+		}
+		if (!out_of_actor && !actor->inventory().CanTakeItem(item))
+			return coop::proto::kReasonNotTakeable;
+		if (out_of_actor && item->IsQuestItem())
+			return coop::proto::kReasonNotDroppable;
+	}
+	const auto published = g_host->published.find(id);
+	const u64 owner_commit = published != g_host->published.end() ? published->second.owner_commit : 0;
+	if (intent.expected_revision && owner_commit > intent.expected_revision)
+	{
+		g_host->log.line("transfer-stale slot=%u item=%u owner_commit=%I64u expected=%I64u", u32(link.ref.slot),
+			u32(id), owner_commit, intent.expected_revision);
