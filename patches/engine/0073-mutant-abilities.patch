+// S10-T02d: see the mutant abilities (decision T02d-1)
+void coop_server_monster_ability(u16 monster, u16 target, LPCSTR ability, float value)
+{
+	if (!g_host || !g_host->started || !ability)
+		return;
+	ParticipantRef who;
+	const bool participant = g_campaign_identity && g_campaign_identity->participant_of_engine_id(target, who) == Refusal::None;
+	std::pair<u64, u64>& count = g_host->monster_abilities[ability];
+	if (participant && who.slot == 0)
+		++count.first;
+	else if (participant && who.slot == 1)
+		++count.second;
+	g_host->log.line("monster-ability monster=%u target=%u slot=%d ability=%s value=%.3f", u32(monster), u32(target),
+		participant ? int(who.slot) : -1, ability, value);
+}
