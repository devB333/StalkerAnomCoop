 // After every push and pop: the layer reads the depth to decide what db.actor
 // is, and gives a participant actor without a Lua binder its db.storage entry.
+static ContextSwitchHook s_switch_hook = nullptr; // S08-T09
+} // namespace
+
+void set_context_switch_hook(ContextSwitchHook hook) { s_switch_hook = hook; }
+
+int script_module_upvalue(lua_State* L, LPCSTR module, LPCSTR name)
+{
+	lua_getglobal(L, module);
+	if (!lua_istable(L, -1))
+	{
+		lua_pop(L, 1);
+		return 0;
+	}
+	lua_pushnil(L);
+	while (lua_next(L, -2))
+	{
+		if (lua_isfunction(L, -1) && !lua_iscfunction(L, -1))
+			for (int n = 1; n < 64; ++n)
+			{
+				const char* upvalue = lua_getupvalue(L, -1, n);
+				if (!upvalue)
+					break;
+				lua_pop(L, 1);
+				if (!xr_strcmp(upvalue, name))
+				{
+					lua_remove(L, -2); // the key
+					lua_remove(L, -2); // the module
+					return n;
+				}
+			}
+		lua_pop(L, 1);
+	}
+	lua_pop(L, 1);
+	return 0;
+}
+
+namespace
+{
+static void notify_switch()
+{
+	if (!s_switch_hook || !s_stack)
+		return;
+	ScriptContext context;
+	s_switch_hook(s_stack->current(context) == Refusal::None ? context.action.actor.slot : u8(0xff));
+}
