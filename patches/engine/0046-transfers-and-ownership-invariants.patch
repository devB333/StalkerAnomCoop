+	PickupRecord record;
+	record.action = u8(intent.kind);
+	record.slot = link.ref.slot;
+	record.player = link.player;
+	record.operation = intent.operation_id;
+	record.from_entity = from_ref.id;
+	record.owner_entity = drop ? 0 : to_ref.id;
+	record.item_entity = intent.target.id;
+	record.item_id = id;
+	record.section = *se->s_name;
+	const Fvector at = drop ? actor->Position() : object->Position();
+	record.position[0] = at.x;
+	record.position[1] = at.y;
+	record.position[2] = at.z;
+	{
+		NET_Packet packet;
+		se->Spawn_Write(packet, FALSE);
