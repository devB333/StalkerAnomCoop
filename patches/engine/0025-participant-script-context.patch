+// A dialogue as the server runs it: the use, the dialogue entry (the
+// participant's own context, the window as its presentation), the phrases in
+// the context the choices arrive in, the close.
+template <typename Phrases>
+bool dialogue(QuestRun& q, Phrases phrases)
+{
+	CGameObject* npc = giver_object();
+	CActor* actor = actor_by_id(q.actor_id);
+	CInventoryOwner* owner = smart_cast<CInventoryOwner*>(npc);
+	if (!npc || !actor || !owner)
+		return false;
+	// The giver's own logic (xr_meet.process_npc_usability, run outside any
+	// context) may have disabled his talk at this hour; the fixture enables it
+	// for the dialogue, as the installed force_all_talk option would, and
+	// records that it did.
+	const bool talk_enabled = owner->IsTalkEnabled();
+	if (!talk_enabled)
+		owner->EnableTalk();
+	const bool used = npc->use(actor);
+	const Refusal opened = dialogue_open(actor, owner, false);
+	const bool talking = owner->IsTalking() && actor->IsTalking();
+	Msg("S03-T05 %s dialogue open: talk_enabled=%d used=%d open=%s npc_talking=%d actor_talking=%d distance=%.2f",
+		q.label, talk_enabled ? 1 : 0, used ? 1 : 0, refusal_name(opened), owner->IsTalking() ? 1 : 0,
+		actor->IsTalking() ? 1 : 0, actor->Position().distance_to(npc->Position()));
+	row("dialogue,%s,%d,%d,%s,%d,%.2f", q.label, talk_enabled ? 1 : 0, used ? 1 : 0, refusal_name(opened),
+		talking ? 1 : 0, actor->Position().distance_to(npc->Position()));
+	bool ok = false;
+	if (talking) // the installed phrases assume a talking partner (get_speaker)
+	{
+		ScriptContextScope scope(q.phrase_context, Scope::Self, "s03-t05-phrases");
+		ok = scope.entered() && phrases(q, npc);
+	}
+	const Refusal closed = dialogue_close(actor, owner);
+	Msg("S03-T05 %s dialogue: used=%d open=%s phrases=%d close=%s", q.label, used ? 1 : 0, refusal_name(opened),
+		ok ? 1 : 0, refusal_name(closed));
+	return used && opened == Refusal::None && closed == Refusal::None && ok;
+}
+
+void give_quest(QuestRun& q)
+{
+	Fixture& f = g_fixture;
+	string64 other_fetch_before;
+	u32 other_count = 0;
+	read_fetch(q, q.other_id, other_fetch_before, other_count);
+	const u32 dialog_open_before = outbox_count(q.slot, Presentation::DialogOpen);
+	const u32 other_open_before = outbox_count(q.slot == 0 ? 1 : 0, Presentation::DialogOpen);
+	q.given = dialogue(q, accept_task);
+	string128 what;
+	xr_sprintf(what, "%s accepted %s through the installed dialogue functions", q.label, q.task_id);
+	check(q.given, what);
+	CGameTask* t = inprogress_task(q);
+	check(t && t->GetTaskState() == eTaskStateInProgress, "the native task is in progress");
+	check(t && t->m_campaign_owned && t->m_campaign_owner.slot == q.slot &&
+			t->m_campaign_owner.generation == (q.slot == 0 ? f.p1.generation : f.p2.generation),
+		"...and owned by the participant whose context gave it");
+	luabind::object lua = call("s03_t05.task", q.task_id);
+	check(lua.type() == LUA_TTABLE && field_int(lua, "stage") == 0, "the Lua task exists at stage 0");
+	read_fetch(q, q.actor_id, q.fetch, q.fetch_count);
+	string64 other_fetch_after;
+	read_fetch(q, q.other_id, other_fetch_after, other_count);
+	check(xr_strcmp(q.fetch, "-") != 0, "the fetch item was stored in the participant's own actor's portable store");
+	check(!xr_strcmp(other_fetch_before, other_fetch_after), "...and not in the other actor's");
+	check(outbox_count(q.slot, Presentation::DialogOpen) == dialog_open_before + 1 &&
+			outbox_count(q.slot == 0 ? 1 : 0, Presentation::DialogOpen) == other_open_before,
+		"the talk window went to this participant only");
+	quest_row(q, "given");
+}
+
+bool spawn_item(u16 actor_id, LPCSTR section)
+{
+	CActor* actor = actor_by_id(actor_id);
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	CSE_ALifeDynamicObject* se = alife ? ai().get_alife()->objects().object(actor_id, true) : nullptr;
+	if (!actor || !se || !section || section[0] == '-')
+		return false;
+	CSE_Abstract* entity = CALifeSimulator__spawn_item2(alife, section, actor->Position(),
+		actor->ai_location().level_vertex_id(), se->m_tGraphID, actor_id);
+	Msg("S03-T05 spawned %s id=%u into actor %u's inventory", section, entity ? u32(entity->ID) : u32(-1), u32(actor_id));
+	return entity != nullptr;
+}
+
+void begin_item(QuestRun& q)
+{
+	q.items_other_before = items_of(q.other_id, q.fetch);
+	string128 what;
+	xr_sprintf(what, "%s's fetch item %s spawned into its own actor", q.label, q.fetch);
+	bool ok = true;
+	for (u32 i = 0; i < q.fetch_count; ++i)
+		ok = spawn_item(q.actor_id, q.fetch) && ok;
+	check(ok, what);
+	quest_row(q, "item");
+}
+
+int lua_stage(const QuestRun& q)
+{
+	return field_int(call("s03_t05.task", q.task_id), "stage");
+}
+
+void begin_turn_in(QuestRun& q)
+{
+	q.money_before = money_of(q.actor_id);
+	q.other_money_before = money_of(q.other_id);
+	q.goodwill_before = goodwill_of(q.actor_id, "csky");
+	q.other_goodwill_before = goodwill_of(q.other_id, "csky");
+	q.info_before = info_of(q.actor_id, q.info);
+	q.other_info_before = info_of(q.other_id, q.info);
+	q.outbox_before = outbox_size(q.slot);
+	q.other_outbox_before = outbox_count(q.slot == 0 ? 1 : 0, Presentation::DialogOpen);
+	q.turned_in = dialogue(q, turn_in);
+	string128 what;
+	xr_sprintf(what, "%s turned %s in through the installed dialogue functions", q.label, q.task_id);
+	check(q.turned_in, what);
+	quest_row(q, "turned-in");
+}
+
+bool completion_landed(const QuestRun& q)
+{
+	return !inprogress_task(q) && call("s03_t05.task", q.task_id).type() != LUA_TTABLE &&
+		items_of(q.actor_id, q.fetch) == 0 && money_of(q.actor_id) > q.money_before;
+}
+
+void end_completion(QuestRun& q, bool landed, const ScriptContextStats& before)
+{
+	const u8 other_slot = q.slot == 0 ? 1 : 0;
+	quest_row(q, "completed");
+	string128 what;
+	xr_sprintf(what, "%s's completion landed within the budget", q.label);
+	check(landed, what);
+	check(completed_task_of(q) != nullptr, "the native task is Completed and still owned by its participant");
+	check(call("s03_t05.task", q.task_id).type() != LUA_TTABLE, "the Lua task entry retired");
+	check(script_context_stats().task_callbacks_hosted > before.task_callbacks_hosted,
+		"the completion's state callback reached the script host in the owner's context");
+	check(money_of(q.actor_id) > q.money_before, "the reward was paid to the participant's own actor");
+	check(money_of(q.other_id) == q.other_money_before, "the other actor's money did not change");
+	check(goodwill_of(q.actor_id, "csky") > q.goodwill_before, "Clear Sky goodwill rose for the participant's actor");
+	check(goodwill_of(q.other_id, "csky") == q.other_goodwill_before, "...and not for the other actor");
+	check(info_of(q.actor_id, q.info) && !q.info_before, "the completion info portion went to the participant's actor");
+	check(info_of(q.other_id, q.info) == q.other_info_before, "...and not to the other actor");
+	check(items_of(q.actor_id, q.fetch) == 0, "the fetch item was taken from the participant's actor");
+	check(items_of(q.other_id, q.fetch) == q.items_other_before, "...and nothing from the other actor");
+	check(outbox_size(q.slot) > q.outbox_before, "the participant got the turn-in presentations");
+	check(outbox_count(other_slot, Presentation::DialogOpen) == q.other_outbox_before,
+		"the other participant got no talk window");
+	Msg("S03-T05 %s completed: money %u -> %u (other %u), goodwill %d -> %d, info %d", q.label, q.money_before,
+		money_of(q.actor_id), money_of(q.other_id), q.goodwill_before, goodwill_of(q.actor_id, "csky"),
+		info_of(q.actor_id, q.info) ? 1 : 0);
+}
+
+ScriptContextStats g_stats_before;
+
+// As the script API's SetActorPosition does (S02-T06b/e): the actor's transform
+// and its physics character.
+void place_beside_giver(u16 actor_id, float dx)
+{
+	CActor* actor = actor_by_id(actor_id);
+	CGameObject* npc = giver_object();
+	if (!actor || !npc)
+		return;
+	const Fvector from = actor->Position();
+	Fmatrix F = actor->XFORM();
+	F.c = npc->Position();
+	F.c.x += dx;
+	actor->XFORM().set(F);
+	if (actor->character_physics_support()->movement()->CharacterExist())
+	{
+		actor->character_physics_support()->movement()->SetPosition(F.c);
+		actor->character_physics_support()->movement()->SetVelocity(0.f, 0.f, 0.f);
+	}
+	row("place,%u,%.2f,%.2f,%.2f,%.2f", u32(actor_id), from.distance_to(npc->Position()), F.c.x, F.c.y, F.c.z);
+	Msg("S03-T05 actor %u placed beside the giver (was %.1f m away)", u32(actor_id), from.distance_to(npc->Position()));
+}
+
+void set_phase(int phase)
+{
+	Fixture& f = g_fixture;
+	f.phase = phase;
+	f.phase_tick = f.tick;
+	Msg("S03-T05 script-context phase %s at tick %u", phase_name(phase), f.tick);
+}
+
+void finish_audit()
+{
+	Fixture& f = g_fixture;
+	xr_vector<PresentationRecord> records;
+	for (u8 slot = 0; slot < 2; ++slot)
+	{
+		presentation_outbox(slot, records);
+		for (const PresentationRecord& r : records)
+			row("outbox,%u,%u,%s,%u,%s", u32(slot), r.serial, presentation_name(r.kind), u32(r.object), r.detail);
+	}
+	xr_vector<std::pair<shared_str, u32>> reads;
+	u32 total = 0;
+	script_host_reads(reads, &total);
+	for (const auto& read : reads)
+		row("host-read,%s,%u", read.first.c_str(), read.second);
+	row("stats,host_read_total,%u", total);
+	row("stats,host_read_sites,%u", u32(reads.size()));
+	const ScriptContextStats& s = script_context_stats();
+	const ScriptContextStack::Stats& st = script_contexts()->stats();
+	row("stats,entered,%I64u", st.entered);
+	row("stats,refused,%I64u", st.refused);
+	row("stats,captured,%I64u", st.captured);
+	row("stats,captured_entered,%I64u", st.captured_entered);
+	row("stats,task_scopes,%I64u", s.task_scopes);
+	row("stats,task_unowned,%I64u", s.task_unowned);
+	row("stats,task_callbacks_hosted,%I64u", s.task_callbacks_hosted);
+	row("stats,presented,%I64u", s.presented);
+	row("stats,present_no_context,%I64u", s.present_no_context);
+	row("stats,lua_no_context,%I64u", s.lua_no_context);
+	row("stats,gameplay_context,%I64u", s.gameplay_context);
+	row("stats,gameplay_compat,%I64u", s.gameplay_compat);
+	check(st.entered == st.left, "every context entered during the run left");
+	check(script_contexts()->depth() == 0, "no context is left entered");
+	report_script_context("script-context-fixture");
+	f.running = false;
+	set_phase(PhaseDone);
+}
+} // namespace
+
+extern "C" bool __cdecl xrCampaignScriptContext_Fixture()
+{
+	return unit_fixture();
+}
+
+extern "C" bool __cdecl xrCampaignLevel_ScriptContextBegin(LPCSTR out_path)
+{
+	Fixture& f = g_fixture;
+	f = Fixture();
+	f.out = fopen(out_path, "w");
+	f.running = true;
+	if (!g_campaign_identity || !g_pGameLevel || !ai().get_alife())
+	{
+		check(false, "a campaign server level is running");
+		f.running = false;
+		return false;
+	}
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	check(registry.current_participant(0, f.p1) == Refusal::None, "participant 1 is current");
+	check(registry.current_participant(1, f.p2) == Refusal::None, "participant 2 is current");
+	const Participant* p = nullptr;
+	if (registry.participant(f.p1, p) == Refusal::None)
+		f.party1 = p->party;
+	if (registry.participant(f.p2, p) == Refusal::None)
+		f.party2 = p->party;
+	CActor* a1 = participant_actor(f.p1);
+	CActor* a2 = participant_actor(f.p2);
+	f.actor1 = a1 ? a1->ID() : no_id;
+	f.actor2 = a2 ? a2->ID() : no_id;
+	check(a1 && a2 && a1 != a2 && a1->g_Alive() && a2->g_Alive(), "both participant actors are alive");
+	ParticipantRef by_session;
+	check(registry.resolve_session(session2, by_session) == Refusal::None && by_session == f.p2,
+		"participant 2 is attached on its session");
+	f.ctx1 = make_context(Origin::ServerInternal, 0, f.p1, f.party1);
+	f.ctx2 = make_context(Origin::ClientIntent, session2, f.p2, f.party2);
+	for (const auto& entry : ai().get_alife()->objects().objects())
+	{
+		CSE_ALifeHumanStalker* stalker = smart_cast<CSE_ALifeHumanStalker*>(entry.second);
+		if (stalker && !xr_strcmp(stalker->character_profile().c_str(), giver_profile))
+			f.giver = stalker->ID;
+	}
+	row("meta,{%u;%u},{%u;%u},%u,%u,%I64x,%I64x,%u", u32(f.p1.slot), f.p1.generation, u32(f.p2.slot), f.p2.generation,
+		u32(f.actor1), u32(f.actor2), f.party1.lo, f.party2.lo, u32(f.giver));
+	if (!f.ok || !ensure_lua())
+	{
+		check(false, "the fixture's Lua helpers loaded");
+		f.running = false;
+		return false;
+	}
+	// The quest runs: participant 2 the first mechanic task (its actor has no
+	// tier-1 upgrade), participant 1 the second (S02-T06e gave actor 1 tier 1).
+	QuestRun& q2 = f.quest[0];
+	ZeroMemory(&q2, sizeof(q2));
+	q2.label = "participant-2";
+	q2.slot = f.p2.slot;
+	q2.phrase_context = f.ctx2;
+	q2.actor_id = f.actor2;
+	q2.other_id = f.actor1;
+	xr_strcpy(q2.task_id, "mar_base_stalker_tech_task_1");
+	xr_strcpy(q2.info, "mar_base_stalker_tech_upgrade_tier_1");
+	xr_strcpy(q2.fetch, "-");
+	QuestRun& q1 = f.quest[1];
+	ZeroMemory(&q1, sizeof(q1));
+	q1.label = "participant-1";
+	q1.slot = f.p1.slot;
+	q1.phrase_context = f.ctx1;
+	q1.actor_id = f.actor1;
+	q1.other_id = f.actor2;
+	xr_strcpy(q1.task_id, "mar_base_stalker_tech_task_2");
+	xr_strcpy(q1.info, "mar_base_stalker_tech_upgrade_tier_2");
+	xr_strcpy(q1.fetch, "-");
+
+	phase_contract();
+	set_phase(PhaseDeferred);
+	return true;
+}
+
+extern "C" void __cdecl xrCampaignLevel_ScriptContextTick()
+{
+	Fixture& f = g_fixture;
+	if (!f.running)
+		return;
+	++f.tick;
+	const u32 in_phase = f.tick - f.phase_tick;
+	switch (f.phase)
+	{
+	case PhaseDeferred:
+		if ((deferred_fired("p1") && deferred_fired("p2") && deferred_fired("none")) || in_phase >= deferred_budget)
+		{
+			deferred_end();
+			check(giver_object() != nullptr, "the mechanic is online");
+			if (!giver_object())
+			{
+				finish_audit();
+				return;
+			}
+			// Both actors stand beside the giver: his meet logic decides whether
+			// he talks against the single-player script actor only (outside any
+			// context), so actor 1 is placed there too.
+			place_beside_giver(f.actor1, 2.f);
+			place_beside_giver(f.actor2, -2.f);
+			set_phase(PhaseApproach);
+		}
+		break;
+	case PhaseApproach:
+		if (in_phase >= approach_ticks)
+		{
+			give_quest(f.quest[0]);
+			give_quest(f.quest[1]);
+			g_stats_before = script_context_stats();
+			set_phase(PhaseObserve);
+		}
+		break;
+	case PhaseObserve:
+		if (in_phase >= observe_ticks)
+		{
+			quest_row(f.quest[0], "observed");
+			quest_row(f.quest[1], "observed");
+			check(script_context_stats().task_scopes > g_stats_before.task_scopes,
+				"both open tasks were updated and checked in their owners' contexts");
+			check(lua_stage(f.quest[0]) == 0 && lua_stage(f.quest[1]) == 0, "neither task reached its complete stage");
+			begin_item(f.quest[0]);
+			set_phase(PhaseStage2);
+		}
+		break;
+	case PhaseStage2:
+	case PhaseStage1:
+	{
+		QuestRun& q = f.quest[f.phase == PhaseStage2 ? 0 : 1];
+		QuestRun& other = f.quest[f.phase == PhaseStage2 ? 1 : 0];
+		if (lua_stage(q) == 1 || in_phase >= stage_budget)
+		{
+			quest_row(q, "stage");
+			string128 what;
+			xr_sprintf(what, "%s's task reached its complete stage from its own actor's inventory", q.label);
+			check(lua_stage(q) == 1, what);
+			if (f.phase == PhaseStage2)
+				check(lua_stage(other) == 0, "participant 1's open task stayed at stage 0 meanwhile");
+			g_stats_before = script_context_stats();
+			begin_turn_in(q);
+			set_phase(f.phase == PhaseStage2 ? PhaseComplete2 : PhaseComplete1);
+		}
+		break;
+	}
+	case PhaseComplete2:
+	case PhaseComplete1:
+	{
+		QuestRun& q = f.quest[f.phase == PhaseComplete2 ? 0 : 1];
+		const bool landed = completion_landed(q);
+		if (landed || in_phase >= complete_budget)
+		{
+			end_completion(q, landed, g_stats_before);
+			if (f.phase == PhaseComplete2)
+			{
+				begin_item(f.quest[1]);
+				set_phase(PhaseStage1);
+			}
+			else
+				finish_audit();
+		}
+		break;
+	}
+	default: break;
+	}
+}
+
+extern "C" bool __cdecl xrCampaignLevel_ScriptContextDone()
+{
+	return !g_fixture.running;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_ScriptContextEnd(u32 ticks, u32 sim_ms, u32 wall_ms)
+{
+	Fixture& f = g_fixture;
+	if (f.running)
+	{
+		check(false, "the fixture finished within its tick budget");
+		finish_audit();
+	}
+	row("end,%u,%u,%u,%u,%u,%s,%d", ticks, sim_ms, wall_ms, f.checks, f.failures, phase_name(f.phase), f.ok ? 1 : 0);
+	Msg("S03-T05 script-context ticks=%u sim_ms=%u wall_ms=%u checks=%u failures=%u", ticks, sim_ms, wall_ms, f.checks,
+		f.failures);
+	if (f.out)
+	{
+		fclose(f.out);
+		f.out = nullptr;
+	}
+	return f.ok;
+}
