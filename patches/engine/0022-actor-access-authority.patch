diff --git a/src/xrGame/CampaignActorAccess.cpp b/src/xrGame/CampaignActorAccess.cpp
new file mode 100644
index 0000000..e99d094
--- /dev/null
+++ b/src/xrGame/CampaignActorAccess.cpp
@@ -0,0 +1,368 @@
+#include "pch_script.h"
+#include "CampaignActorAccess.h"
+
+// S03-T02: see CampaignActorAccess.h.
+
+#include "Actor.h"
+#include "Level.h"
+#include "xrServer.h"
+#include "../xrEngine/xr_object.h"
+#include <intrin.h>
+#include <dbghelp.h>
+
+using namespace campaign;
+
+namespace
+{
+ActorAccessStats s_stats = {};
+bool s_owns_client_registry = false;
+// The actor whose net_Spawn is adopting, and the id it will carry once
+// CGameObject::net_Spawn sets it (actor_from_key answers for it meanwhile).
+CActor* s_spawning_actor = nullptr;
+u16 s_spawning_id = u16(-1);
+
+// Distinct Actor() callers on the server, by return address.
+const u32 kMaxCallers = 256;
+struct Caller
+{
+	void* address;
+	u64 count;
+};
+Caller s_callers[kMaxCallers];
+u32 s_caller_count = 0;
+u64 s_callers_overflow = 0;
+
+void record_caller(void* address)
+{
+	for (u32 i = 0; i < s_caller_count; ++i)
+	{
+		if (s_callers[i].address == address)
+		{
+			++s_callers[i].count;
+			return;
+		}
+	}
+	if (s_caller_count == kMaxCallers)
+	{
+		++s_callers_overflow;
+		return;
+	}
+	s_callers[s_caller_count].address = address;
+	s_callers[s_caller_count].count = 1;
+	++s_caller_count;
+	s_stats.distinct_callers = s_caller_count;
+}
+
+bool server_role()
+{
+	return g_campaign_identity && g_campaign_identity->role() == Role::Server;
+}
+
+// The live object for a current engine key. g_actor answers for its own id
+// without a lookup, which also covers the actor's own net_Spawn, where the
+// object is not registered yet.
+CActor* actor_from_key(const EngineEntityKey& key)
+{
+	if (g_actor && (g_actor->ID() == key.id || (g_actor == s_spawning_actor && s_spawning_id == key.id)))
+		return g_actor;
+	if (!g_pGameLevel)
+		return nullptr;
+	return smart_cast<CActor*>(Level().Objects.net_Find(key.id));
+}
+
+// dbghelp, loaded on demand for the report only.
+typedef BOOL(WINAPI* SymInitializeFn)(HANDLE, PCSTR, BOOL);
+typedef BOOL(WINAPI* SymFromAddrFn)(HANDLE, DWORD64, PDWORD64, PSYMBOL_INFO);
+typedef DWORD(WINAPI* SymSetOptionsFn)(DWORD);
+
+struct Symbolizer
+{
+	HMODULE dll;
+	SymFromAddrFn from_addr;
+	bool ready;
+
+	Symbolizer() : dll(nullptr), from_addr(nullptr), ready(false)
+	{
+		dll = ::LoadLibraryA("dbghelp.dll");
+		if (!dll)
+			return;
+		SymInitializeFn initialize = (SymInitializeFn)::GetProcAddress(dll, "SymInitialize");
+		SymSetOptionsFn set_options = (SymSetOptionsFn)::GetProcAddress(dll, "SymSetOptions");
+		from_addr = (SymFromAddrFn)::GetProcAddress(dll, "SymFromAddr");
+		if (!initialize || !from_addr)
+			return;
+		if (set_options)
+			set_options(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS);
+		ready = initialize(::GetCurrentProcess(), nullptr, TRUE) == TRUE;
+	}
+
+	bool resolve(void* address, string512& out)
+	{
+		if (!ready)
+			return false;
+		char buffer[sizeof(SYMBOL_INFO) + 512];
+		ZeroMemory(buffer, sizeof(buffer));
+		SYMBOL_INFO* symbol = (SYMBOL_INFO*)buffer;
+		symbol->SizeOfStruct = sizeof(SYMBOL_INFO);
+		symbol->MaxNameLen = 511;
+		DWORD64 displacement = 0;
+		if (!from_addr(::GetCurrentProcess(), (DWORD64)address, &displacement, symbol))
+			return false;
+		xr_sprintf(out, "%s+0x%I64x", symbol->Name, displacement);
+		return true;
+	}
+};
+
+void module_offset(void* address, string256& out)
+{
+	HMODULE module = nullptr;
+	if (::GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+			(LPCSTR)address, &module) &&
+		module)
+	{
+		string_path path;
+		::GetModuleFileNameA(module, path, sizeof(path));
+		LPCSTR name = strrchr(path, '\\');
+		xr_sprintf(out, "%s+0x%I64x", name ? name + 1 : path, u64((char*)address - (char*)module));
+	}
+	else
+		xr_sprintf(out, "0x%p", address);
+}
+} // namespace
+
+namespace campaign
+{
+Role process_role()
+{
+	return g_campaign_identity ? g_campaign_identity->role() : Role::Client;
+}
+
+CActor* local_view_actor()
+{
+	++s_stats.view_calls;
+	if (server_role())
+	{
+		++s_stats.view_calls_server;
+		return nullptr;
+	}
+	return g_actor;
+}
+
+CActor* participant_actor(const ParticipantRef& ref, Refusal* why)
+{
+	Refusal refusal = Refusal::WrongRole;
+	CActor* result = nullptr;
+	if (server_role())
+	{
+		EngineEntityKey key;
+		refusal = g_campaign_identity->participant_actor_key(ref, key);
+		if (refusal == Refusal::None)
+		{
+			result = actor_from_key(key);
+			if (!result)
+				refusal = Refusal::NoActor;
+		}
+	}
+	if (why)
+		*why = refusal;
+	return result;
+}
+
+Refusal participant_of(const CObject* object, ParticipantRef& out)
+{
+	if (!object)
+		return Refusal::InvalidIdentity;
+	if (!server_role())
+	{
+		// The client knows one participant actor: its own.
+		if (g_actor && object == g_actor)
+		{
+			out.slot = 0;
+			out.generation = 1;
+			return Refusal::None;
+		}
+		return Refusal::UnknownParticipant;
+	}
+	return g_campaign_identity->participant_of_engine_id(object->ID(), out);
+}
+
+bool is_participant_actor(const CObject* object)
+{
+	ParticipantRef ref;
+	return participant_of(object, ref) == Refusal::None;
+}
+
+u32 participant_actors(xr_vector<CActor*>& out)
+{
+	out.clear();
+	if (!server_role())
+	{
+		if (g_actor)
+			out.push_back(g_actor);
+		return u32(out.size());
+	}
+	const CampaignIdentityRegistry& registry = *g_campaign_identity;
+	for (u8 slot = 0; slot < registry.active_slots(); ++slot)
+	{
+		ParticipantRef ref;
+		EngineEntityKey key;
+		if (registry.current_participant(slot, ref) != Refusal::None ||
+			registry.participant_actor_key(ref, key) != Refusal::None)
+			continue;
+		if (CActor* actor = actor_from_key(key))
+			out.push_back(actor);
+	}
+	return u32(out.size());
+}
+
+CActor* nearest_participant_actor(const Fvector& from, ParticipantRef* who, float* distance)
+{
+	xr_vector<CActor*> actors;
+	participant_actors(actors);
+	CActor* best = nullptr;
+	float best_distance = flt_max;
+	for (u32 i = 0; i < actors.size(); ++i)
+	{
+		const float d = actors[i]->Position().distance_to(from);
+		if (d < best_distance)
+		{
+			best_distance = d;
+			best = actors[i];
+		}
+	}
+	if (best && who)
+		participant_of(best, *who);
+	if (distance)
+		*distance = best ? best_distance : flt_max;
+	return best;
+}
+
+CActor* context_actor(const ActionContext& context, Scope scope, Refusal* why)
+{
+	Refusal refusal = Refusal::WrongRole;
+	CActor* result = nullptr;
+	if (server_role())
+	{
+		EngineEntityKey key;
+		refusal = g_campaign_identity->context_actor_key(context, scope, key);
+		if (refusal == Refusal::None)
+		{
+			result = actor_from_key(key);
+			if (!result)
+				refusal = Refusal::NoActor;
+		}
+	}
+	if (why)
+		*why = refusal;
+	return result;
+}
+
+CActor* dialog_actor(const CGameObject* speaker1, const CGameObject* speaker2)
+{
+	if (CActor* actor = const_cast<CActor*>(smart_cast<const CActor*>(speaker1)))
+		return actor;
+	if (CActor* actor = const_cast<CActor*>(smart_cast<const CActor*>(speaker2)))
+		return actor;
+	return nullptr;
+}
+
+CActor* sole_participant_actor(LPCSTR purpose)
+{
+	++s_stats.sole_calls;
+	if (!server_role())
+		return g_actor;
+	EngineEntityKey key;
+	const Refusal refusal = g_campaign_identity->sole_actor_key(key);
+	if (refusal == Refusal::None)
+		return actor_from_key(key);
+	++s_stats.sole_refused;
+	if (s_stats.sole_refused <= 16)
+		Msg("! S03-T02 sole_participant_actor(%s): %s", purpose ? purpose : "?", refusal_name(refusal));
+	return nullptr;
+}
+
+CActor* compat_actor(void* caller)
+{
+	++s_stats.compat_calls;
+	if (!server_role())
+		return g_actor;
+	++s_stats.compat_calls_server;
+	record_caller(caller);
+	EngineEntityKey key;
+	const Refusal refusal = g_campaign_identity->sole_actor_key(key);
+	if (refusal == Refusal::None)
+		return actor_from_key(key);
+	if (refusal == Refusal::Ambiguous)
+		++s_stats.compat_ambiguous;
+	else
+		++s_stats.compat_none;
+	return nullptr;
+}
+
+const ActorAccessStats& actor_access_stats()
+{
+	return s_stats;
+}
+
+void report_actor_access(LPCSTR tag)
+{
+	Msg("S03-T02 actor-access %s role=%s view_calls=%I64u view_calls_server=%I64u compat_calls=%I64u "
+		"compat_calls_server=%I64u compat_none=%I64u compat_ambiguous=%I64u sole_calls=%I64u sole_refused=%I64u "
+		"adopted=%I64u unadopted=%I64u distinct_callers=%u overflow=%I64u",
+		tag, process_role() == Role::Server ? "server" : "client", s_stats.view_calls, s_stats.view_calls_server,
+		s_stats.compat_calls, s_stats.compat_calls_server, s_stats.compat_none, s_stats.compat_ambiguous,
+		s_stats.sole_calls, s_stats.sole_refused, s_stats.adopted, s_stats.unadopted, s_stats.distinct_callers,
+		s_callers_overflow);
+	if (!s_caller_count)
+		return;
+	static Symbolizer* symbolizer = nullptr;
+	if (!symbolizer)
+		symbolizer = xr_new<Symbolizer>();
+	for (u32 i = 0; i < s_caller_count; ++i)
+	{
+		string256 offset;
+		module_offset(s_callers[i].address, offset);
+		string512 symbol;
+		if (!symbolizer->resolve(s_callers[i].address, symbol))
+			xr_strcpy(symbol, "?");
+		Msg("S03-T02 actor-access caller %s %s count=%I64u", offset, symbol, s_callers[i].count);
+	}
+}
+
+void ensure_client_registry()
+{
+	if (g_campaign_identity)
+		return;
+	g_campaign_identity = xr_new<CampaignIdentityRegistry>(Role::Client, 2);
+	s_owns_client_registry = true;
+	Msg("S03-T02 identity registry role=client (level-scoped)");
+}
+
+void release_client_registry()
+{
+	if (!s_owns_client_registry)
+		return;
+	xr_delete(g_campaign_identity);
+	s_owns_client_registry = false;
+}
+
+void on_actor_spawned(CActor* actor, u16 id)
+{
+	if (!server_role() || !actor)
+		return;
+	s_spawning_actor = actor;
+	s_spawning_id = id;
+	ParticipantRef ref;
+	const Refusal refusal = g_campaign_identity->adopt_spawned_actor(g_campaign_identity->authority(), id, ref);
+	if (refusal == Refusal::None)
+	{
+		++s_stats.adopted;
+		Msg("S03-T02 actor %u adopted by participant {%u,%u}", u32(id), u32(ref.slot), ref.generation);
+	}
+	else
+	{
+		++s_stats.unadopted;
+		Msg("! S03-T02 actor %u spawned with no participant to hold it: %s", u32(id), refusal_name(refusal));
+	}
+}
+} // namespace campaign
diff --git a/src/xrGame/CampaignActorAccess.h b/src/xrGame/CampaignActorAccess.h
new file mode 100644
index 0000000..78c6064
--- /dev/null
+++ b/src/xrGame/CampaignActorAccess.h
@@ -0,0 +1,90 @@
+#pragma once
+
+// S03-T02: explicit actor access, split from the engine's one global player.
+//
+// The engine reaches the player two ways: Actor() returns g_actor, the last
+// actor spawned with the local/as-player flags (Actor_Network.cpp), and
+// Level().CurrentEntity() is the object the local input and camera control
+// (IGame_Level.h). Both are views of one process's one player. The co-op
+// server presents nothing and will simulate two actors, so gameplay code
+// must say which participant's actor it means, and presentation code must
+// only ever get the local view.
+//
+// Three kinds of access, by purpose:
+//  - local_view_actor(): presentation. The client's own actor; none on the
+//    server. Cameras, HUD, post-process effectors, pick-ups to draw.
+//  - participant lookups: gameplay. Through the registry (S03-T01): a
+//    participant's actor, the participant holding an actor, every
+//    participant actor, the nearest one to a point, the actor a dialogue is
+//    with, the actor an authorized action context names.
+//  - sole_participant_actor(purpose) and the Actor() compatibility
+//    accessor: the one participant actor while exactly one exists. With
+//    none or more than one they return null and count the refusal; they
+//    never pick a player. Every server-side Actor() call is recorded by
+//    caller so the remaining single-actor assumptions are listed, not
+//    hidden (report_actor_access).
+//
+// Roles. A registry with Role::Server (the campaign server's identity
+// service) answers the participant lookups from its slots. A Role::Client
+// registry (created with CLevel on the normal client) knows one participant
+// actor, g_actor, until Stage 4 delivers the roster; the view accessor is
+// the same object there. Without any registry the process is a client.
+
+#include "CampaignIdentity.h"
+
+class CActor;
+class CObject;
+class CGameObject;
+
+namespace campaign
+{
+Role process_role();
+
+// --- presentation ---------------------------------------------------------
+CActor* local_view_actor();
+
+// --- gameplay --------------------------------------------------------------
+CActor* participant_actor(const ParticipantRef& ref, Refusal* why = nullptr);
+Refusal participant_of(const CObject* object, ParticipantRef& out);
+bool is_participant_actor(const CObject* object);
+u32 participant_actors(xr_vector<CActor*>& out);
+CActor* nearest_participant_actor(const Fvector& from, ParticipantRef* who = nullptr, float* distance = nullptr);
+CActor* context_actor(const ActionContext& context, Scope scope, Refusal* why = nullptr);
+// The participant actor among two dialogue speakers (either order), else null.
+CActor* dialog_actor(const CGameObject* speaker1, const CGameObject* speaker2);
+// The one participant actor while exactly one exists. Null and counted
+// otherwise. `purpose` names the system that still assumes one player.
+CActor* sole_participant_actor(LPCSTR purpose);
+
+// --- compatibility (behind Actor()) ----------------------------------------
+// caller: _ReturnAddress() of Actor(), recorded on the server.
+CActor* compat_actor(void* caller);
+
+struct ActorAccessStats
+{
+	u64 view_calls; // local_view_actor() calls
+	u64 view_calls_server; // ...of which on the server (always null)
+	u64 compat_calls; // Actor() calls
+	u64 compat_calls_server; // ...of which on the server
+	u64 compat_none; // server Actor() with no participant actor
+	u64 compat_ambiguous; // server Actor() with more than one participant actor
+	u64 sole_calls; // sole_participant_actor() calls
+	u64 sole_refused; // ...refused (none or ambiguous)
+	u64 adopted; // actors adopted by a participant at spawn
+	u64 unadopted; // actors spawned with no participant to hold them
+	u32 distinct_callers; // distinct Actor() callers recorded on the server
+};
+
+const ActorAccessStats& actor_access_stats();
+// Logs the stats and the recorded Actor() callers (module offset, and the
+// symbol when dbghelp finds the module's PDB).
+void report_actor_access(LPCSTR tag);
+
+// --- lifecycle ---------------------------------------------------------------
+// CLevel: a client without a registry gets a Role::Client one for the level.
+void ensure_client_registry();
+void release_client_registry();
+// CActor::net_Spawn on the server: the actor adopts a participant. id is the
+// spawn packet's, since the object's own is set later in CGameObject::net_Spawn.
+void on_actor_spawned(CActor* actor, u16 id);
