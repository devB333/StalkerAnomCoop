+// The common front of both actions: the player's own live actor and an item
+// of its own inventory the server holds online. 0 or a refusal reason.
+u16 own_inventory_item(PlayerLink& link, const coop::proto::ActionIntent& intent, CActor*& actor,
+	coop::proto::EntityRef& actor_ref, u16& id, CInventoryItem*& item)
+{
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	actor = context_actor(context, Scope::Self, &why);
+	if (!actor || !actor->g_Alive() || !entity_ref_of(actor->ID(), actor_ref))
+		return coop::proto::kReasonNoActor;
+	id = engine_id_of(intent.target);
+	CSE_Abstract* se = id != kNoEngineId ? Level().Server->ID_to_entity(id) : nullptr;
+	CObject* object = id != kNoEngineId ? Level().Objects.net_Find(id) : nullptr;
+	if (!se || !object || object->getDestroy() || g_host->use_consumed.count(id))
+		return coop::proto::kReasonItemGone; // a used-up item is gone already (its release follows)
+	item = smart_cast<CInventoryItem*>(object);
+	if (!item || !smart_cast<CSE_ALifeInventoryItem*>(se))
+		return coop::proto::kReasonNotUsable;
+	for (const Host::PickupConfirm& c : g_host->pickup_confirm)
+		if (c.item == id)
+			return coop::proto::kReasonItemTaken; // moving this tick, the level not yet caught up
+	if (se->ID_Parent != actor->ID() || object->H_Parent() != actor || item->m_pInventory != &actor->inventory())
+		return coop::proto::kReasonNotDroppable; // not in the player's own inventory
+	return 0;
+}
