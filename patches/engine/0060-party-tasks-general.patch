+				actors[link.ref.slot] = actor;
+				++attached;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		f.recovered = g_host->persistence && g_host->persistence->recovered();
+		g_host->log.line("fixture-task both-attached tick=%I64u recovered=%d", g_host->tick, f.recovered ? 1 : 0);
+	}
+	if (attached < 2 || f.phase >= 9 || g_host->tick < f.both_since + u64(config.task_party) * 50)
+		return;
+	PlayerLink& p1 = *links[0];
+	PlayerLink& p2 = *links[1];
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	if (f.giver == 0xffff)
+	{
+		f.giver = find_giver();
+		if (f.giver == 0xffff)
+		{
+			if (g_host->tick - f.both_since > u64(config.task_party) * 50 + 30 * 50)
+			{
+				g_host->log.line("fixture-task giver-missing");
+				++f.failures;
+				f.phase = 9;
+			}
+			return;
+		}
+	}
+	CGameObject* giver = smart_cast<CGameObject*>(Level().Objects.net_Find(f.giver));
+	if (!giver)
+		return;
+	s32 target = -1;
+	lua_call_ok("campaign_party_bounty_target", target, kTaskFixtureId);
+	if (!f.recovered)
+	{
+		if (f.phase == 0)
+		{
+			const Fvector g = giver->Position();
+			for (u32 k = 0; k < 2; ++k)
+			{
+				Fvector at = g;
+				at.x += k ? -1.2f : 1.2f;
+				place_beside(actors[k], at);
+			}
+			g_host->log.line("fixture-task placed giver=%u p1=%u p2=%u", u32(f.giver), u32(actors[0]->ID()),
+				u32(actors[1]->ID()));
+			f.phase = 1;
+			f.phase_tick = g_host->tick + 3 * 50;
+			return;
+		}
+		if (f.phase == 1 && g_host->tick >= f.phase_tick)
+		{
+			const u16 reason = party_accept_task(p2, giver, kTaskFixtureId, "fixture");
+			lua_call_ok("campaign_party_bounty_target", target, kTaskFixtureId);
+			const Host::PartyTask* t = party_task(kTaskFixtureId);
+			f.target = target;
+			g_host->log.line("fixture-task accepted slot=1 task=%s reason=%u party=%d holder=%u target=%d", kTaskFixtureId,
+				u32(reason), t ? 1 : 0, t ? u32(t->holder) : 0xffffu, target);
+			if (reason || !t || target < 0)
+				++f.failures;
+			const bool requested = request_publication("task");
+			g_host->log.line("fixture-task done phase=accepted failures=%u publication=%d", f.failures, requested ? 1 : 0);
+			f.phase = 9;
+		}
+		return;
+	}
+	// the restarted server
+	if (f.phase == 0)
+	{
+		const Host::PartyTask* t = party_task(kTaskFixtureId);
+		f.target = target;
+		g_host->log.line("fixture-task rebuilt=%d task=%s holder=%u target=%d", t ? 1 : 0, kTaskFixtureId,
+			t ? u32(t->holder) : 0xffffu, target);
+		if (!t || target < 0)
+		{
+			++f.failures;
+			g_host->log.line("fixture-task done phase=recovered failures=%u", f.failures);
+			f.phase = 9;
+			return;
+		}
+		CEntityAlive* online = smart_cast<CEntityAlive*>(Level().Objects.net_Find(u16(target)));
+		if (online && online->g_Alive())
+		{
+			online->KillEntity(actors[1]->ID(), TRUE); // by p2's actor: the death callback in p2's context
+			g_host->log.line("fixture-task target-killed id=%d online=1 teleported=0 killer=%u", target, u32(actors[1]->ID()));
+			f.phase = 1;
+			f.phase_tick = g_host->tick;
+			return;
+		}
+		// an offline target is brought beside p1 (the ALife teleport; the switch
