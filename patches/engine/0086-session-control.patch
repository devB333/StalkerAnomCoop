+// The creation screen's Start as the test driver does it: the choices written where the screen writes them
+// (axr_main.config [character_creation]), then the installed menu's StartGame (the co-op override above).
+void session_driver_create(LPCSTR faction, LPCSTR map, LPCSTR name, LPCSTR loadout)
+{
