+	f.expect(registry.resolve_session(7, found), Refusal::UnknownSession, "session 7 resolves to nobody");
+	const Participant* view = nullptr;
+	f.expect(registry.participant(p1, view), Refusal::None, "player 1's reference still resolves");
+	if (view)
+	{
+		Msg("S03-T01 disconnect-retention p1 state=%s session=%u actor=%I64u actor_key={%u,%u} detached_at=%I64u",
+			participant_state_name(view->state), view->session, view->actor.value, u32(view->actor_key.id),
+			view->actor_key.generation, view->detached_at);
+		f.check(view->state == ParticipantState::Detached, "player 1 is detached");
+		f.check(view->session == 0, "the detached participant has no session");
+		f.check(view->player == player_id(1) && view->party == party, "identity and party retained");
+		f.check(view->actor.value == 1 && view->actor_key == actor_key, "the actor binding is retained");
+	}
+	f.check(registry.bound_count() == 2, "the detached participant keeps its slot");
+	ParticipantRef p3;
+	f.expect(registry.bind_participant(authority, player_id(3), party, 22, p3), Refusal::SlotsFull,
+		"a third player cannot take a detached participant's slot");
+
+	// Reconnect on a new session.
+	f.expect(registry.attach_session(authority, p1, 11, 30), Refusal::None, "session 11 re-attaches player 1");
+	f.expect(registry.resolve_session(11, found), Refusal::None, "session 11 resolves");
+	f.check(found == p1, "session 11 is player 1's original slot and generation");
+	f.expect(registry.participant(p1, view), Refusal::None, "player 1 resolves after the reconnect");
+	f.check(view && view->state == ParticipantState::Attached && view->actor_key == actor_key,
+		"the reconnected participant is attached with its actor");
+	f.expect(registry.resolve_session(bridge, found), Refusal::BridgeNotParticipant, "the bridge never resolves");
+	f.expect(registry.resolve_session(0, found), Refusal::InvalidIdentity, "session 0 never resolves");
+
+	// Release makes the slot free; a reconnect with the old reference is stale.
+	f.expect(registry.release_participant(authority, p1, 40), Refusal::None, "player 1 released by the server");
+	f.expect(registry.resolve_session(11, found), Refusal::UnknownSession, "the released participant's session is gone");
+	f.expect(registry.attach_session(authority, p1, 11, 41), Refusal::UnknownParticipant,
+		"the released reference cannot re-attach");
+	f.expect(registry.bind_participant(authority, player_id(3), party, 42, p3), Refusal::None, "player 3 takes the slot");
+	f.expect(registry.attach_session(authority, p1, 11, 43), Refusal::StaleReference,
+		"player 1's old reference is stale once the slot has a new owner");
+	return f.done();
+}
+
+// --- role-context ----------------------------------------------------------
+
+bool fixture_role_context()
+{
+	Fixture f("role-context-fixture");
+	CampaignIdentityRegistry registry(Role::Server, 2);
+	const ServerAuthority* authority = registry.authority();
+	registry.on_server_incarnation();
+	const PartyId party = party_id(1);
+	const PartyId other_party = party_id(2);
+	registry.set_bridge_session(authority, 1);
+	ParticipantRef p1, p2;
+	registry.bind_participant(authority, player_id(1), party, 10, p1);
+	registry.bind_participant(authority, player_id(2), party, 11, p2);
+	registry.attach_session(authority, p1, 7, 12);
+	registry.attach_session(authority, p2, 9, 13);
+
+	ActionContext client = {Origin::ClientIntent, 7, p1, party};
+	f.expect(registry.authorize(client, Scope::Self), Refusal::None, "a client acts on its own actor");
+	f.expect(registry.authorize(client, Scope::Party), Refusal::None, "a client acts within its party");
+	f.expect(registry.authorize(client, Scope::World), Refusal::NotAuthoritative, "a client never mutates the world");
+	f.expect(registry.authorize(client, Scope::Identity), Refusal::NotAuthoritative, "a client never binds identities");
+	ActionContext wrong_party = {Origin::ClientIntent, 7, p1, other_party};
+	f.expect(registry.authorize(wrong_party, Scope::Party), Refusal::WrongParty, "a client cannot claim another party");
+	f.expect(registry.authorize(wrong_party, Scope::Self), Refusal::None, "the party claim does not matter for Self");
+	ActionContext impersonation = {Origin::ClientIntent, 7, p2, party};
+	f.expect(registry.authorize(impersonation, Scope::Self), Refusal::NotAuthoritative,
+		"a client intent naming another participant is refused");
+	ActionContext from_bridge = {Origin::ClientIntent, 1, p1, party};
+	f.expect(registry.authorize(from_bridge, Scope::Self), Refusal::BridgeNotParticipant,
+		"an intent on the bridge session is refused");
+	ActionContext unknown_session = {Origin::ClientIntent, 42, p1, party};
+	f.expect(registry.authorize(unknown_session, Scope::Self), Refusal::UnknownSession,
+		"an intent on an unknown session is refused");
+	ParticipantRef stale = {p1.slot, p1.generation + 1};
+	ActionContext stale_actor = {Origin::ClientIntent, 7, stale, party};
+	f.expect(registry.authorize(stale_actor, Scope::Self), Refusal::StaleReference, "a stale participant is refused");
+	ParticipantRef out_of_range = {5, 1};
+	ActionContext bad_slot = {Origin::ClientIntent, 7, out_of_range, party};
+	f.expect(registry.authorize(bad_slot, Scope::Self), Refusal::UnknownParticipant, "an out-of-range slot is refused");
+
+	ActionContext internal = {Origin::ServerInternal, 0, p1, party};
+	f.expect(registry.authorize(internal, Scope::World), Refusal::None, "the server mutates the world");
+	f.expect(registry.authorize(internal, Scope::Identity), Refusal::None, "the server binds identities");
+	f.expect(registry.authorize(internal, Scope::Party), Refusal::None, "the server acts within the actor's party");
+	f.expect(registry.authorize(internal, Scope::Self), Refusal::None, "the server acts on the actor");
+	ActionContext internal_wrong_party = {Origin::ServerInternal, 0, p1, other_party};
+	f.expect(registry.authorize(internal_wrong_party, Scope::Party), Refusal::WrongParty,
+		"the server is held to the actor's party too");
+
+	// After a disconnect the client's intents are refused; the server can
+	// still act for the retained participant.
+	registry.detach_session(authority, 7, 20);
+	f.expect(registry.authorize(client, Scope::Self), Refusal::UnknownSession, "a detached session's intents are refused");
+	f.expect(registry.authorize(internal, Scope::Self), Refusal::None, "the server still acts for a detached participant");
+	// Once released, nothing acts for the old reference.
+	registry.release_participant(authority, p1, 30);
+	f.expect(registry.authorize(internal, Scope::Self), Refusal::UnknownParticipant, "a released participant has no context");
+
+	CampaignIdentityRegistry client_registry(Role::Client, 2);
+	f.expect(client_registry.authorize(internal, Scope::Self), Refusal::WrongRole, "a client registry authorizes nothing");
+	f.expect(client_registry.authorize(client, Scope::Self), Refusal::WrongRole, "a client registry authorizes no intents");
+	return f.done();
+}
