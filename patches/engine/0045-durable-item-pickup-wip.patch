+	const double server_ms = g_link->clock.server_now(double(g_link->wall.GetElapsed_ms()));
+	for (Link::PickupRace& race : g_link->pickup_races)
+		if (!race.operation && server_ms >= double(race.claim_tick) * double(kServerTickMs))
+			race.operation = request_pickup(race.target, race.round, race.kind, false, "race");
+}
