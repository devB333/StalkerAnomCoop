+// --- S10-T05d2: each player's custom statics on the campaign server ----------------------
+// The installed scripts keep a HUD indicator's state in a Lua variable and remove only what
+// GetCustomStatic finds (surge_manager displayIndicators). With one HUD for two players, one
+// player's remove took the other's indicator. Inside a player's context the three calls work on
+// that player's own set of names and are presented to it; the HUD keeps one real static per name
+// (for the scripts' wnd() calls) while any player holds it. Outside a context nothing changes:
+// those statics (actor 0's binder: actor_effects) are the server's own and are not presented.
+namespace
+{
+struct CoopHudStatic
+{
+	shared_str name;
+	u32 generation;
+	xr_string text; // as last presented
+	float end_time; // a static with a ttl expires by itself, on the server as on the client
+};
+const u32 kCoopHudSlots = 8;
+xr_vector<CoopHudStatic> s_coop_statics[kCoopHudSlots];
+u32 s_coop_static_adds = 0, s_coop_static_removes = 0, s_coop_static_texts = 0, s_coop_static_replayed = 0;
+
+bool coop_static_player(campaign::ParticipantRef& player)
+{
+	return campaign::script_audience(&player) == campaign::ScriptAudience::Player && player.slot < kCoopHudSlots;
+}
+
+xr_vector<CoopHudStatic>::iterator coop_static_find(u8 slot, const char* id)
+{
+	xr_vector<CoopHudStatic>& set = s_coop_statics[slot];
+	return std::find_if(set.begin(), set.end(), [id](const CoopHudStatic& s) { return s.name == id; });
+}
+
+bool coop_static_held(const char* id)
+{
+	for (u8 slot = 0; slot < kCoopHudSlots; ++slot)
+		if (coop_static_find(slot, id) != s_coop_statics[slot].end())
+			return true;
+	return false;
+}
+
+bool coop_static_expired(const CoopHudStatic& s)
+{
+	return s.end_time > 0.f && Device.fTimeGlobal > s.end_time;
+}
+
+void coop_static_present(const campaign::ParticipantRef& to, campaign::Presentation kind, const char* id, u32 flags)
+{
+	campaign::PresentationArgs args;
+	args.flags = flags;
+	campaign::present(to, kind, 0, id, args);
+}
+}
+
+StaticDrawableWrapper* CUIGameCustom::AddCustomStatic(const char* id, bool singleInstance)
+{
+	campaign::ParticipantRef player;
+	if (!coop_static_player(player))
+		return add_custom_static(id, singleInstance);
+	StaticDrawableWrapper* s = add_custom_static(id, singleInstance);
+	auto it = coop_static_find(player.slot, id);
+	const bool had = it != s_coop_statics[player.slot].end() && !coop_static_expired(*it);
+	if (it == s_coop_statics[player.slot].end())
+	{
+		s_coop_statics[player.slot].push_back(CoopHudStatic());
+		it = s_coop_statics[player.slot].end() - 1;
+		it->name = id;
+	}
+	it->generation = player.generation;
+	it->end_time = s && s->m_endTime > 0.f ? s->m_endTime : 0.f;
+	if (!had || !singleInstance)
+	{
+		it->text.clear();
+		coop_static_present(player, campaign::Presentation::HudStaticAdd, id, singleInstance ? 1u : 0u);
+		++s_coop_static_adds;
+	}
+	return s;
+}
+
+StaticDrawableWrapper* CUIGameCustom::GetCustomStatic(const char* id)
+{
+	campaign::ParticipantRef player;
+	if (!coop_static_player(player))
+		return get_custom_static(id);
+	auto it = coop_static_find(player.slot, id);
+	if (it == s_coop_statics[player.slot].end())
+		return nullptr;
+	if (coop_static_expired(*it))
+	{
+		s_coop_statics[player.slot].erase(it);
+		return nullptr;
+	}
+	StaticDrawableWrapper* s = get_custom_static(id);
+	return s ? s : add_custom_static(id, true); // another context's remove took the HUD's copy
+}
+
+void CUIGameCustom::RemoveCustomStatic(const char* id)
+{
+	campaign::ParticipantRef player;
+	if (!coop_static_player(player))
+	{
+		remove_custom_static(id);
+		return;
+	}
+	auto it = coop_static_find(player.slot, id);
+	if (it == s_coop_statics[player.slot].end())
+		return; // not this player's
+	s_coop_statics[player.slot].erase(it);
+	coop_static_present(player, campaign::Presentation::HudStaticRemove, id, 0);
+	++s_coop_static_removes;
+	if (!coop_static_held(id))
+		remove_custom_static(id);
+}
+
+void coop_hud_statics_tick()
+{
+	static shared_str level; // a new level starts with no statics
+	const shared_str here = g_pGameLevel ? Level().name() : shared_str();
+	if (here != level)
+	{
+		coop_hud_statics_clear();
+		level = here;
+	}
+	CUIGameCustom* ui = CurrentGameUI();
+	for (u8 slot = 0; slot < kCoopHudSlots; ++slot)
+	{
+		xr_vector<CoopHudStatic>& set = s_coop_statics[slot];
+		for (u32 i = 0; i < set.size();)
+		{
+			if (coop_static_expired(set[i]))
+			{
+				set.erase(set.begin() + i);
+				continue;
+			}
+			StaticDrawableWrapper* s = ui ? ui->get_custom_static(*set[i].name) : nullptr;
+			LPCSTR text = s && s->wnd() ? s->wnd()->TextItemControl()->GetText() : nullptr;
+			if (text && set[i].text != text)
+			{
+				set[i].text = text;
+				// detail: "<name>|<text>", cut to the record's 127 characters
+				string128 detail;
+				_snprintf_s(detail, sizeof(detail), _TRUNCATE, "%s|%s", *set[i].name, text);
+				campaign::ParticipantRef to = {slot, set[i].generation};
+				coop_static_present(to, campaign::Presentation::HudStaticText, detail, 0);
+				++s_coop_static_texts;
+			}
+			++i;
+		}
+	}
+}
+
+u32 coop_hud_statics_replay(const campaign::ParticipantRef& to)
+{
+	if (to.slot >= kCoopHudSlots)
+		return 0;
+	u32 n = 0;
+	for (CoopHudStatic& s : s_coop_statics[to.slot])
+	{
+		if (coop_static_expired(s))
+			continue;
+		s.generation = to.generation;
+		coop_static_present(to, campaign::Presentation::HudStaticAdd, *s.name, 1);
+		s.text.clear(); // the next tick sends it again
+		++n;
+	}
+	s_coop_static_replayed += n;
+	return n;
+}
+
+void coop_hud_statics_clear()
+{
+	for (xr_vector<CoopHudStatic>& set : s_coop_statics)
+		set.clear();
+}
+
+void coop_hud_statics_report(string256& out)
+{
+	u32 held = 0;
+	for (const xr_vector<CoopHudStatic>& set : s_coop_statics)
+		held += u32(set.size());
+	xr_sprintf(out, "statics_held=%u static_adds=%u static_removes=%u static_texts=%u statics_replayed=%u", held,
+		s_coop_static_adds, s_coop_static_removes, s_coop_static_texts, s_coop_static_replayed);
+}
