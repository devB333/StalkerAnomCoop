+// S07 play test (K1): on a co-op client, an item held by the other player's
+// actor. Its parent is an actor, but not the one this client views; the
+// client's in-process server owns the object, so object().Local() is true
+// and the engine's own event path would run the full first-person state
+// change on the shared hands (demo-6/7: the other player's knife bent this
+// player's pistol; the other pistol re-drew when this one was drawn).
+static bool other_players_item(CGameObject& object)
+{
+	if (!campaign::replica_active())
+		return false;
+	CActor* parent = smart_cast<CActor*>(object.H_Parent());
+	return parent && parent != campaign::local_view_actor();
+}
