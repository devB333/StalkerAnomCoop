+		Fvector dir;
+		dir.set(0.f, 0.f, 1.f);
+		SHit hit(100.f, dir, source, 0, Fvector().set(0.f, 0.f, 0.f), 0.f, ALife::eHitTypeWound, 0.f, false);
+		hit.whoID = source->ID();
+		hit.weaponID = source->ID();
+		hit.BulletID = 0;
+		hit.SenderID = 0;
+		hit.GenHeader(GE_HIT, second->ID());
