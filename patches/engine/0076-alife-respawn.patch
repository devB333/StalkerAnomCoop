+// S10-T03a: the distance from a point to the nearest alive participant actor's
+// server entity, the same anchors the ALife switch uses (S03-T04); -1 when none
+// (a client, single player), so the installed rule stands
+float lua_nearest_participant_distance(float x, float y, float z)
+{
+	if (!server_role())
+		return -1.f;
+	xr_vector<CSE_ALifeCreatureActor*> actors;
+	participant_actor_entities(actors);
+	const Fvector at = {x, y, z};
+	float best = -1.f;
+	for (CSE_ALifeCreatureActor* actor : actors)
+	{
+		if (!actor->g_Alive())
+			continue;
+		const float d = actor->o_Position.distance_to(at);
+		if (best < 0.f || d < best)
+			best = d;
+	}
+	return best;
+}
