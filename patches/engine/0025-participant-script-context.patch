+double lua_enter_task(LPCSTR task_id)
+{
+	if (!s_stack || !server_role() || !g_pGameLevel || !task_id)
+		return 0;
+	CGameTask* task = Level().GameTaskManager().HasGameTask(task_id, true);
+	if (!task)
+		return 0;
+	if (!task->m_campaign_owned)
+	{
+		++s_stats.task_unowned;
+		return 0;
+	}
+	ActionContext context;
+	if (!participant_context(task->m_campaign_owner, context))
+		return 0;
+	u32 token = 0;
+	if (s_stack->enter(context, Scope::Self, "task-check", token) != Refusal::None)
+		return 0;
+	++s_stats.task_scopes;
+	sync_lua(true);
+	return double(token);
+}
