+// ------------------------------------------------------------ S08-T02
+// Drops and moves. Every inventory path on the client (the engine's
+// inventory and loot windows, Anomaly's script UI, script calls) ends in the
+// engine's events to the level's in-process server: a drop is
+// GE_OWNERSHIP_REJECT from the item's owner (CUIActorMenu::SendEvent_Item_Drop,
+// CScriptGameObject::DropItem, CInventory::UpdateDropItem); a move between
+// two owners is GE_TRADE_SELL from the source followed by GE_TRADE_BUY to the
+// destination (move_item_from_to, CScriptGameObject::TransferItem). Here
+// they become the drop and transfer intents; the events themselves are
+// refused as before, so nothing moves until the server's Reparent says so.
+// A reject whose owner is an item (a grenade throw, a launcher's rocket) is
+// not a drop and stays refused.
+bool ref_of(u16 id, coop::proto::EntityRef& out)
+{
+	const auto it = g_link->refs.find(id);
+	if (it == g_link->refs.end())
+		return false;
+	out = it->second;
+	return true;
+}
+
+void push_ref(xr_vector<u8>& out, const coop::proto::EntityRef& r)
+{
+	for (int b = 0; b < 8; ++b)
+		out.push_back(u8(r.id >> (8 * b)));
+	for (int b = 0; b < 4; ++b)
+		out.push_back(u8(r.generation >> (8 * b)));
+}
+
+u16 id_of(const coop::proto::EntityRef& r)
+{
+	const auto it = g_link->by_entity.find(r.id);
+	return it != g_link->by_entity.end() && g_link->refs[it->second] == r ? it->second : u16(0xffff);
+}
+
+// The driver's step this request is (the step that started the engine path).
+Link::TransferStepRun* awaiting_step(u16 action, u16 item)
+{
+	for (Link::TransferStepRun& st : g_link->transfer_steps)
+		if (st.started && !st.linked && st.action == action && st.item_id == item)
+			return &st;
+	return nullptr;
+}
+
+void ownership_intent(u16 action, u16 item, const coop::proto::EntityRef& item_ref, const xr_vector<u8>& params)
+{
+	Link::TransferStepRun* st = awaiting_step(action, item);
+	const u64 expected = st && (st->flags & 1) ? st->cursor : g_link->applied;
+	const u64 operation = request_ownership(action, item_ref, params, expected, st ? st->round : 0xffffffff, 0,
+		!st, st ? "driver" : "player");
+	if (action == coop::proto::kActionDrop)
+		++g_link->drops_requested;
+	else
+		++g_link->transfers_requested;
+	if (st)
+	{
+		st->linked = true;
+		st->operation = operation;
+		Link::PickupPending& p = g_link->pickup_pending.back();
+		p.step = st->step;
+		pickup_csv_line("linked", st->round, 0, operation, item_ref, 0, 0, expected, action, st->step);
+	}
+}
+
+void on_transfer_round(const coop::proto::CampaignEvent& event)
+{
+	if (g_link->config.script != 8 || event.payload.size() < 11)
+		return;
+	const u8* b = event.payload.data();
+	const u32 round = b[0];
+	u64 claim_tick = 0;
+	for (int i = 0; i < 8; ++i)
+		claim_tick |= u64(b[2 + i]) << (8 * i);
+	const u32 count = b[10];
+	if (event.payload.size() != 11 + size_t(count) * 42)
+		return;
+	++g_link->transfer_rounds;
+	auto ref = [](const u8* p) {
+		coop::proto::EntityRef r;
+		r.id = 0;
+		r.generation = 0;
+		for (int i = 0; i < 8; ++i)
+			r.id |= u64(p[i]) << (8 * i);
+		for (int i = 0; i < 4; ++i)
+			r.generation |= u32(p[8 + i]) << (8 * i);
+		return r;
+	};
+	for (u32 k = 0; k < count; ++k)
+	{
+		const u8* st = b + 11 + k * 42;
+		if (st[0] != g_link->local_slot)
+			continue;
+		Link::TransferStepRun run;
+		run.round = round;
+		run.step = k;
+		run.action = st[1];
+		run.tick = claim_tick + u64(st[2] | (st[3] << 8));
+		run.item = ref(st + 4);
+		run.from = ref(st + 16);
+		run.to = ref(st + 28);
+		run.flags = st[40];
+		run.extra = st[41];
+		run.cursor = g_link->applied;
+		g_link->transfer_steps.push_back(run);
+		pickup_csv_line("step", round, run.flags, 0, run.item, 0, 0, run.tick, run.action, k);
+	}
+	g_link->log.line("transfer-round round=%u claim_tick=%I64u steps=%u cursor=%I64u", round, claim_tick, count,
+		g_link->applied);
+}
+
+// One driver step: the engine's own event path, as the inventory UI does it.
+void start_transfer_step(Link::TransferStepRun& st, u32 now)
+{
+	st.started = true;
+	st.started_ms = now;
+	u16 item = id_of(st.item);
+	if (st.flags & 2)
+	{
+		PIItem slotted = g_actor->inventory().ItemFromSlot(st.extra);
+		item = slotted ? u16(slotted->object().ID()) : u16(0xffff);
+		if (slotted)
+			ref_of(item, st.item);
+	}
+	st.item_id = item;
+	CObject* object = item != 0xffff ? Level().Objects.net_Find(item) : nullptr;
+	g_link->log.line("transfer-step round=%u step=%u action=%u item=%u from=%u to=%u flags=%u present=%d", st.round,
+		st.step, u32(st.action), u32(item), u32(id_of(st.from)), u32(id_of(st.to)), u32(st.flags), object ? 1 : 0);
+	switch (st.action)
+	{
+	case coop::proto::kActionTransfer:
+		if (object)
+			move_item_from_to(id_of(st.from), id_of(st.to), item);
+		break;
+	case coop::proto::kActionDrop:
+		if (object)
+		{
+			const u16 owner = object->H_Parent() ? u16(object->H_Parent()->ID()) : id_of(st.from);
+			NET_Packet packet;
