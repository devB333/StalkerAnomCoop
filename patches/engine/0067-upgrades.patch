+bool decode_upgrade(const std::vector<u8>& payload, UpgradeRecord& out)
+{
+	size_t at = 0;
+	u16 length = 0;
+	if (!(get(payload, at, out.slot) && get(payload, at, out.player.hi) && get(payload, at, out.player.lo) &&
+			get(payload, at, out.operation) && get(payload, at, out.npc_entity) && get(payload, at, out.actor_entity) &&
+			get(payload, at, out.item_entity) && get(payload, at, out.op) && get(payload, at, length)) ||
+		!out.actor_entity || !out.item_entity || (out.op != 1 && out.op != 2) || length > 128 || at + length > payload.size())
+		return false;
+	out.upgrade_id.assign(reinterpret_cast<const char*>(payload.data() + at), length);
+	at += length;
+	if (!(get(payload, at, out.price) && get(payload, at, out.actor_money_after)))
