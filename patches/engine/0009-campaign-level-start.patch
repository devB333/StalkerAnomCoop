diff --git a/src/xrGame/CampaignServerStart.cpp b/src/xrGame/CampaignServerStart.cpp
new file mode 100644
index 0000000..4825296
--- /dev/null
+++ b/src/xrGame/CampaignServerStart.cpp
@@ -0,0 +1,114 @@
+#include "pch_script.h"
+
+// S02-T05b: campaign server level start. These mirror CApplication::OnEvent
+// (KERNEL:start / KERNEL:disconnect) without the main-menu console commands,
+// and run the queued loading stages explicitly instead of from the render idle
+// loop. Only the server stages run here (xrServer, game_sv_Single, ALife from
+// the saved game); the client stages that load the level are S02-T05d.
+
+#include "Level.h"
+#include "xrServer.h"
+#include "ai_space.h"
+#include "alife_simulator.h"
+#include "alife_object_registry.h"
+#include "alife_graph_registry.h"
+#include "alife_level_registry.h"
+#include "alife_time_manager.h"
+#include "game_graph.h"
+#include "level_graph.h"
+#include "xrServer_Objects_ALife_Monsters.h"
+#include "../xrEngine/x_ray.h"
+#include "../xrEngine/IGame_Persistent.h"
+#include "../xrEngine/device.h"
+#include "../xrEngine/std_classes.h"
+#include "../xrServerEntities/clsid_game.h"
+
+extern "C" bool __cdecl xrCampaignLevel_Start(LPCSTR op_server, LPCSTR op_client)
+{
+	R_ASSERT2(!g_pGameLevel, "A level already exists");
+	R_ASSERT2(g_pGamePersistent && pApp, "Campaign level start needs the persistent object and the application");
+
+	g_pGamePersistent->PreStart(op_server);
+	g_pGameLevel = (IGame_Level*)NEW_INSTANCE(CLSID_GAME_LEVEL);
+	if (!g_pGameLevel)
+		return false;
+	pApp->LoadBegin();
+	g_pGamePersistent->Start(op_server);
+	const bool queued = g_pGameLevel->net_Start(op_server, op_client);
+	pApp->LoadEnd();
+	Msg("S02-T05b level created; %u loading stages queued", u32(g_loading_events.size()));
+	return queued;
+}
+
+// Runs the queued server stages (net_start1..3). net_start4 replaces itself
+// with the client stages, so pumping stops when three stages remain.
+// Returns 0 when the server and ALife exist, 1 on deadline, 2 when a stage failed.
+extern "C" int __cdecl xrCampaignLevel_PumpServerStages(u32 deadline_ms)
+{
+	CTimer timer;
+	timer.Start();
+	while (g_loading_events.size() > 3)
+	{
+		if (timer.GetElapsed_ms() > deadline_ms)
+			return 1;
+		if (g_loading_events.front()())
+			g_loading_events.pop_front();
+	}
+	Msg("S02-T05b server stages finished in %u ms", timer.GetElapsed_ms());
+	return (Level().Server && ai().get_alife()) ? 0 : 2;
+}
+
+// Logs what the saved game produced and checks it is a real campaign context:
+// a server with entities, ALife with its actor on the loaded level, and the
+// level's AI graph.
+extern "C" bool __cdecl xrCampaignLevel_Report()
+{
+	CLevel& level = Level();
+	if (!level.Server || !ai().get_alife())
+	{
+		Msg("! S02-T05b server=%d alife=%d", level.Server ? 1 : 0, ai().get_alife() ? 1 : 0);
+		return false;
+	}
+	// The const accessors are the public ones.
+	const CALifeSimulator& alife = *ai().get_alife();
+	const CSE_ALifeCreatureActor* actor = alife.graph().actor();
+	const GameGraph::_LEVEL_ID level_id = alife.graph().level().level_id();
+	LPCSTR graph_level = ai().game_graph().header().level(level_id).name().c_str();
+	string_path level_path;
+	FS.update_path(level_path, "$level$", "");
+	const bool level_graph = ai().get_level_graph() != nullptr;
+	const u32 level_vertices = level_graph ? ai().level_graph().header().vertex_count() : 0;
+	const u32 game_vertices = ai().game_graph().header().vertex_count();
+	const u32 objects = u32(alife.objects().objects().size());
+	const u32 level_objects = u32(alife.graph().level().objects().size());
+	const u32 entities = level.Server->GetEntitiesNum();
+	const bool actor_on_level =
+		actor && ai().game_graph().vertex(actor->m_tGraphID)->level_id() == level_id;
+
+	Msg("S02-T05b campaign level=%s graph_level=%s level_id=%u level_path=%s", level.name().c_str(), graph_level,
+		u32(level_id), level_path);
+	if (actor)
+		Msg("S02-T05b actor id=%u name=%s pos=[%.2f,%.2f,%.2f] graph_vertex=%u level_vertex=%u on_level=%d",
+			u32(actor->ID), actor->name_replace(), VPUSH(actor->o_Position), u32(actor->m_tGraphID),
+			actor->m_tNodeID, actor_on_level ? 1 : 0);
+	else
+		Msg("! S02-T05b ALife has no actor");
+	Msg("S02-T05b alife_objects=%u level_objects=%u server_entities=%u level_graph_vertices=%u "
+		"game_graph_vertices=%u game_time_ms=%I64u",
+		objects, level_objects, entities, level_vertices, game_vertices, alife.time_manager().game_time());
+
+	return actor_on_level && level.name().size() && level_graph && level_vertices != 0 && entities != 0 &&
+		objects != 0;
+}
+
+// Mirrors KERNEL:disconnect: native level stop, level deletion, persistent disconnect.
+extern "C" void __cdecl xrCampaignLevel_Stop()
+{
+	g_loading_events.clear();
+	if (g_pGameLevel)
+	{
+		g_pGameLevel->net_Stop();
+		DEL_INSTANCE(g_pGameLevel);
+	}
+	g_pGamePersistent->Disconnect();
+}
