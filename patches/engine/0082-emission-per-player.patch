+	"local lvl = level\n"
+	"local orig_swfx = lvl and lvl.set_weather_fx\n"
+	"local function noop() end\n"
+	"local sm_ok, SMM = pcall(function() return surge_manager end)\n"
+	"local SMC = sm_ok and type(SMM) == 'table' and (rawget(SMM, 'CSurgeManager') or rawget(_G, 'CSurgeManager'))\n"
+	"local getup, setup = debug and debug.getupvalue, debug and debug.setupvalue\n"
+	"if SMC and SMC.update and SMC.start and getup and setup and orig_swfx then\n"
+	"  local orig_update, orig_start, orig_start_wave = SMC.update, SMC.start, SMC.start_wave\n"
+	"  local up = {}\n"
