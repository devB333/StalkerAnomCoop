+// B61: the in-progress tasks, to find the ones a storyline action gives
+static void active_task_ids(xr_vector<shared_str>& out)
+{
+	out.clear();
+	for (const SGameTaskKey& k : Level().GameTaskManager().GetGameTasks())
+		if (k.game_task && k.game_task->GetTaskState() == eTaskStateInProgress)
+			out.push_back(k.task_id);
+}
+
+// B61: the tasks a storyline action just gave in the anchor's context become
+// the party's (the honcho's task, the next meet task, "Get Next Task")
+static u32 adopt_story_tasks(PlayerLink& link, const xr_vector<shared_str>& before, u16 giver, CActor* anchor,
+	LPCSTR source)
+{
+	xr_vector<shared_str> now;
+	active_task_ids(now);
+	u32 adopted = 0;
+	for (const shared_str& id : now)
+	{
+		if (std::find(before.begin(), before.end(), id) != before.end())
+			continue;
+		if (party_task(id.c_str()))
+			continue;
+		if (!party_task_supported(id.c_str()))
+		{
+			g_host->log.line("quest-story-not-adopted slot=%u task=%s why=unknown-task source=%s", u32(link.ref.slot),
+				id.c_str(), source);
+			continue;
+		}
+		party_task_accepted(link, id.c_str(), giver, anchor, 0);
+		g_host->log.line("quest-story-adopted slot=%u task=%s source=%s", u32(link.ref.slot), id.c_str(), source);
+		++adopted;
+	}
+	return adopted;
+}
