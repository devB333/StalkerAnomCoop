+// ------------------------------------------------------------ S10-T04b
+// Party info portions and the script state of an actor without the
+// installed Lua binder (decisions T01-4, T04b-1..3; L11, L32, L44).
+//
+// Info portions: each actor's known portions live in the ALife registry
+// (CInfoPortionRegistry, keyed by the actor's id, in every checkpoint). A
+// portion given to or taken from one participant actor (any path:
+// dialogue, scripts in or outside a context) is mirrored to the other
+// participant actors (CActor::OnReceiveInfo / OnDisableInfo ->
+// coop_server_info_changed), so story knowledge is the party's. The
+// personal portions (the UI states the engine sends, tutorials, the sleep
+// and forced-sleep flags, the starting-equipment flag) stay per actor. The
+// installed has_alife_info reads actor 0 by id: inside a participant context
+// that read goes to the context's player (campaign::info_actor_id).
+//
+// Script state: the installed scripts keep per-object state in
+// db.storage[id].pstor (save_var / load_var) and persist it through
+// alife_storage_manager (m_data.game_object[id].pstor_all, encoded into the
+// .scoc on save, restored by the object's binder on load). An actor with no
+// binder (participant 2's, a respawned body: S03-T03 attaches the installed
+// actor binder to the script actor only) had no m_data entry and no load,
+// so its pstor was lost on a restart (L32, L44). The server now attaches an
+// actor-state entry for every participant actor without a binder once it is
+// online: m_data.game_object[id] exists (the save copies the pstor) and a
+// saved pstor_all is restored into db.storage[id].pstor.
+
+LPCSTR const actor_state_source =
+	"local A = rawget(_G, '__campaign_actor_state')\n"
+	"if type(A) == 'table' and A.installed then return end\n"
+	"A = { installed = false, attached = 0, restored = 0 }\n"
+	"rawset(_G, '__campaign_actor_state', A)\n"
+	"function campaign_actor_state_attach(id)\n"
+	"  local S = alife_storage_manager.get_state()\n"
+	"  if type(S) ~= 'table' or type(S.game_object) ~= 'table' then return -1 end\n"
+	"  if not db.storage[id] then db.storage[id] = {} end\n"
+	"  if not S.game_object[id] then S.game_object[id] = {} end\n"
+	"  local st = S.game_object[id]\n"
+	"  local restored = 0\n"
+	"  if type(st.pstor_all) == 'table' then\n"
+	"    db.storage[id].pstor = st.pstor_all\n"
+	"    st.pstor_all = nil\n"
+	"    for _ in pairs(db.storage[id].pstor) do restored = restored + 1 end\n"
+	"  end\n"
+	"  if type(st.pstor_ctime) == 'table' then db.storage[id].pstor_ctime = st.pstor_ctime st.pstor_ctime = nil end\n"
+	"  A.attached = A.attached + 1\n"
+	"  A.restored = A.restored + restored\n"
+	"  return restored\n"
+	"end\n"
+	"function campaign_actor_state_count(id)\n"
+	"  local n = 0\n"
+	"  if db.storage[id] and type(db.storage[id].pstor) == 'table' then for _ in pairs(db.storage[id].pstor) do n = n + 1 end end\n"
+	"  return n\n"
+	"end\n"
+	// the fixture's probes, in the context's player (db.actor)
+	"function campaign_info_give(info) db.actor:give_info_portion(info) end\n"
+	"function campaign_info_has(info) return db.actor:has_info(info) and 1 or 0 end\n"
+	"function campaign_info_alife_has(info) return has_alife_info(info) and 1 or 0 end\n"
+	"function campaign_probe_save(name, v) save_var(db.actor, name, v) end\n"
+	"function campaign_probe_load(name) return load_var(db.actor, name, -1) end\n"
+	"A.installed = true\n";
+
+void install_actor_state_adapter()
+{
+	if (g_host->actor_state_installed)
+		return;
+	lua_State* L = ai().script_engine().lua();
+	luabind::functor<luabind::object> probe;
+	if (!L || !ai().script_engine().functor("alife_storage_manager.get_state", probe))
+		return;
+	if (luaL_loadbuffer(L, actor_state_source, xr_strlen(actor_state_source), "campaign_actor_state") != 0 ||
+		lua_pcall(L, 0, 0, 0) != 0)
+	{
+		g_host->log.line("actor-state-adapter-failed error=%s", lua_tostring(L, -1));
+		lua_pop(L, 1);
+		g_host->actor_state_installed = true; // once
+		return;
+	}
+	g_host->actor_state_installed = true;
+	g_host->log.line("actor-state-adapter installed");
+}
+
+// Every half second: every participant actor that is online without the
+// installed binder gets its actor-state entry (once per actor id).
+void actor_state_tick()
+{
+	if (!ai().get_alife() || g_host->tick % 25 != 0)
+		return;
+	install_actor_state_adapter();
+	if (!g_host->actor_state_installed)
+		return;
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		if (!actor || actor->object())
+			continue; // no actor yet, or the installed binder keeps its state
+		const u16 id = u16(actor->ID());
+		if (g_host->actor_state_attached.count(id))
+			continue;
+		g_host->actor_state_attached.insert(id);
+		s32 restored = -2;
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "actor-state-attach");
+			if (scope.entered())
+				lua_call_ok("campaign_actor_state_attach", restored, int(id));
+		}
+		++g_host->actor_states_attached;
+		if (restored > 0)
+			g_host->actor_states_restored += u64(restored);
+		g_host->log.line("actor-state-attached slot=%u actor=%u binder=0 restored=%d alive=%d", u32(link.ref.slot), u32(id),
+			restored, actor->g_Alive() ? 1 : 0);
+	}
+}
+
+// Decision T04b-1: the personal portions.
+static bool personal_info(LPCSTR info)
+{
+	static LPCSTR const exact[] = {"actor_is_sleeping", "sleep_active", "force_slp", "force_slp2", "start_equippment_handled"};
+	for (LPCSTR e : exact)
+		if (!xr_strcmp(e, info))
+			return true;
+	if (!strncmp(info, "ui_", 3))
+		return true;
+	return strstr(info, "tutorial") != nullptr;
+}
+
+static bool s_info_mirroring = false;
+
+void info_changed(const CActor* actor, LPCSTR info, bool add)
+{
+	if (s_info_mirroring || !actor || !info || !info[0])
+		return;
+	u8 slot = 0xff;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && participant_actor(link.ref) == actor)
+			slot = link.ref.slot;
+	if (slot == 0xff)
+		return; // not a participant actor's (a former body, an NPC with info)
+	if (personal_info(info))
+	{
+		++g_host->infos_personal;
+		g_host->log.line("info-personal slot=%u info=%s add=%d", u32(slot), info, add ? 1 : 0);
+		return;
+	}
+	s_info_mirroring = true;
+	u32 mirrored = 0;
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound || link.ref.slot == slot)
+			continue;
+		CActor* other = participant_actor(link.ref);
+		if (!other || other->HasInfo(info) == add)
+			continue;
+		other->TransferInfo(info, add);
+		++mirrored;
+		g_host->log.line("info-mirror from=%u to=%u actor=%u info=%s add=%d", u32(slot), u32(link.ref.slot), u32(other->ID()),
+			info, add ? 1 : 0);
+	}
+	s_info_mirroring = false;
+	g_host->infos_mirrored += mirrored;
+	++g_host->infos_story;
+}
+
+// The info fixture (profile info_party): once both players are in the world
+// (and info_party seconds later):
+//   give      p1 is given a story portion (STORY1); p2 a personal one
+//             (PERSONAL) and a pstor probe; the reads in each player's
+//             context are logged as info-check lines (expect / got)
+//   dead      p1's actor is killed; its client respawns it (auto_respawn)
+//   respawned p2 is given STORY2; p1's new body must hold STORY1 (the
+//             respawn copy) and STORY2 (the mirror); p1 saves a probe on the
+//             new body; a checkpoint is requested
+//   recovered (the restarted server, the same profile): every read again:
+//             both have STORY1 and STORY2, only p2 has PERSONAL, p2's probe
+//             and p1's new-body probe survived the restart
+const char* const kInfoStory1 = "zat_a9_actor_has_jup_a9_way_info";
+const char* const kInfoStory2 = "zat_a9_actor_has_jup_a9_meeting_info";
+const char* const kInfoPersonal = "tutorial_sleep";
+
+static void info_check(LPCSTR phase, PlayerLink& link, LPCSTR what, LPCSTR info, s32 expect)
+{
+	CActor* actor = participant_actor(link.ref);
+	s32 got = -2;
+	if (actor)
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "fixture-info");
+		if (scope.entered())
+		{
+			if (!xr_strcmp(what, "has_info"))
+				lua_call_ok("campaign_info_has", got, info);
+			else if (!xr_strcmp(what, "has_alife_info"))
+				lua_call_ok("campaign_info_alife_has", got, info);
+			else if (!xr_strcmp(what, "probe"))
+				lua_call_ok("campaign_probe_load", got, info);
+		}
+	}
+	if (got != expect)
+		++g_host->info_fixture.failures;
+	g_host->log.line("info-check phase=%s slot=%u actor=%u via=%s info=%s expect=%d got=%d ok=%d", phase, u32(link.ref.slot),
+		actor ? u32(actor->ID()) : 0xffffu, what, info, expect, got, got == expect ? 1 : 0);
+}
+
+static void info_do(PlayerLink& link, LPCSTR what, LPCSTR info, s32 value = 0)
+{
+	CActor* actor = participant_actor(link.ref);
+	if (!actor)
+		return;
+	campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "fixture-info");
+	if (!scope.entered())
+		return;
+	luabind::functor<void> f;
+	if (!xr_strcmp(what, "give") && ai().script_engine().functor("campaign_info_give", f))
+		f(info);
+	else if (!xr_strcmp(what, "probe") && ai().script_engine().functor("campaign_probe_save", f))
+		f(info, int(value));
+	g_host->log.line("info-do slot=%u actor=%u what=%s info=%s value=%d", u32(link.ref.slot), u32(actor->ID()), what, info,
+		value);
+}
+
+static void info_reads(LPCSTR phase, PlayerLink& p1, PlayerLink& p2, bool story2, bool probes)
+{
+	info_check(phase, p1, "has_info", kInfoStory1, 1);
+	info_check(phase, p2, "has_info", kInfoStory1, 1);
+	info_check(phase, p2, "has_alife_info", kInfoStory1, 1);
+	info_check(phase, p1, "has_info", kInfoPersonal, 0);
+	info_check(phase, p2, "has_info", kInfoPersonal, 1);
+	info_check(phase, p1, "has_alife_info", kInfoPersonal, 0); // the redirect: actor 0 means p1 here
+	info_check(phase, p2, "has_alife_info", kInfoPersonal, 1); // ...and p2 here
+	if (story2)
+	{
+		info_check(phase, p1, "has_info", kInfoStory2, 1);
+		info_check(phase, p2, "has_info", kInfoStory2, 1);
+	}
+	if (probes)
+	{
+		info_check(phase, p2, "probe", "coop_probe", 4242);
+		info_check(phase, p1, "probe", "coop_probe_body2", 7);
+	}
+}
+
+void info_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.info_party || !ai().get_alife() || !g_host->actor_state_installed)
+		return;
+	Host::InfoFixture& f = g_host->info_fixture;
+	PlayerLink* links[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.ref.slot < 2 && participant_actor(link.ref))
+		{
+			links[link.ref.slot] = &link;
+			++attached;
+		}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		f.recovered = g_host->persistence && g_host->persistence->recovered();
+		g_host->log.line("fixture-info both-attached tick=%I64u recovered=%d", g_host->tick, f.recovered ? 1 : 0);
+	}
+	if (attached < 2 || f.phase >= 9 || g_host->tick < f.both_since + u64(config.info_party) * 50)
+		return;
+	PlayerLink& p1 = *links[0];
+	PlayerLink& p2 = *links[1];
+	if (f.recovered)
+	{
+		// the restarted server: every read again
+		info_reads("recovered", p1, p2, true, true);
+		g_host->log.line("fixture-info done phase=recovered failures=%u", f.failures);
+		f.phase = 9;
+		return;
+	}
+	if (f.phase == 0)
+	{
+		info_do(p1, "give", kInfoStory1);
+		info_do(p2, "give", kInfoPersonal);
+		info_do(p2, "probe", "coop_probe", 4242);
+		info_reads("give", p1, p2, false, false);
+		info_check("give", p2, "probe", "coop_probe", 4242);
+		f.phase = 1;
+		f.phase_tick = g_host->tick + 5 * 50;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		if (g_host->tick < f.phase_tick)
+			return;
+		// p1 dies; its client respawns it (profile auto_respawn)
+		CActor* a = participant_actor(p1.ref);
+		f.p1_old = u16(a->ID());
+		if (a->g_Alive())
+			a->KillEntity(a->ID(), TRUE);
+		f.phase = 2;
+		f.phase_tick = g_host->tick;
+		g_host->log.line("fixture-info p1-killed actor=%u", u32(f.p1_old));
+		return;
+	}
+	if (f.phase == 2)
+	{
+		CActor* a = participant_actor(p1.ref);
+		const bool respawned = a && a->g_Alive() && u16(a->ID()) != f.p1_old;
+		if (!respawned && g_host->tick - f.phase_tick < 90 * 50)
+			return;
+		g_host->log.line("fixture-info p1-respawned=%d actor=%u waited_ticks=%I64u", respawned ? 1 : 0,
+			a ? u32(a->ID()) : 0xffffu, g_host->tick - f.phase_tick);
+		f.phase = 3;
+		f.phase_tick = g_host->tick + 5 * 50; // the new body online, its actor-state attached
+		return;
+	}
+	if (f.phase == 3)
+	{
+		if (g_host->tick < f.phase_tick)
+			return;
+		info_do(p2, "give", kInfoStory2);
+		info_do(p1, "probe", "coop_probe_body2", 7);
+		info_reads("respawned", p1, p2, true, true);
+		const bool requested = request_publication("info");
+		g_host->log.line("fixture-info done phase=respawned failures=%u publication=%d", f.failures, requested ? 1 : 0);
+		f.phase = 9;
+	}
+}
