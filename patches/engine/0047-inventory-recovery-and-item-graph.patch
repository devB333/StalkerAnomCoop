+// S08-T03: the server's item-graph point (CampaignEvent 8, in the lifecycle
+// order): this replica's owner of every item it holds online, hashed as the
+// server hashes its own (CoopServerHost.cpp item_graph_point), and this
+// client's own actor's inventory against the replica's children of it.
+u64 graph_fnv(u64 h, u64 v)
+{
+	for (int b = 0; b < 8; ++b)
+	{
+		h ^= (v >> (8 * b)) & 0xff;
+		h *= 1099511628211ull;
+	}
+	return h;
+}
+
+void on_item_graph(const coop::proto::CampaignEvent& event)
+{
+	if (event.payload.size() != 20 || !ai().get_alife())
+		return;
+	u64 seq = 0, server_hash = 0;
+	u32 server_items = 0;
+	for (int b = 0; b < 8; ++b)
+		seq |= u64(event.payload[b]) << (8 * b);
+	for (int b = 0; b < 8; ++b)
+		server_hash |= u64(event.payload[8 + b]) << (8 * b);
+	for (int b = 0; b < 4; ++b)
+		server_items |= u32(event.payload[16 + b]) << (8 * b);
+	auto entity_at = [](u16 id) -> u64 {
+		const auto e = id != 0xffff ? g_link->refs.find(id) : g_link->refs.end();
+		return e != g_link->refs.end() ? e->second.id : 0;
+	};
+	xr_vector<std::pair<u64, u64>> items;
+	xr_set<u16> own_children;
+	const u16 own = g_actor ? u16(g_actor->ID()) : u16(0xffff);
+	for (const auto& r : g_link->refs)
+	{
+		if (!campaign::replica_wants_online(r.first))
+			continue;
+		CSE_ALifeDynamicObject* object = ai().alife().objects().object(r.first, true);
+		if (!object || !smart_cast<CSE_ALifeInventoryItem*>(object))
+			continue;
+		items.push_back({r.second.id, entity_at(object->ID_Parent)});
+		if (object->ID_Parent == own)
+			own_children.insert(r.first);
+	}
+	std::sort(items.begin(), items.end());
+	u64 hash = 14695981039346656037ull;
+	for (const auto& i : items)
+		hash = graph_fnv(graph_fnv(hash, i.first), i.second);
+	const bool match = hash == server_hash && u32(items.size()) == server_items;
+	++(match ? g_link->item_graph_matches : g_link->item_graph_mismatches);
+	u32 missing = 0, extra = 0, inventory = 0;
+	if (g_actor)
+	{
+		xr_set<u16> held;
+		for (PIItem item : g_actor->inventory().m_all)
+			if (item)
+				held.insert(u16(item->object().ID()));
+		inventory = u32(held.size());
+		for (u16 id : own_children)
+			missing += held.count(id) ? 0 : 1;
+		for (u16 id : held)
+			extra += own_children.count(id) ? 0 : 1;
+		if (missing || extra)
+			++g_link->own_inventory_mismatches;
+	}
+	g_link->log.line("item-graph seq=%I64u items=%u server_items=%u hash=%016I64x server_hash=%016I64x match=%d "
+		"applied=%I64u own_inventory=%u own_children=%u missing=%u extra=%u", seq, u32(items.size()), server_items, hash,
+		server_hash, match ? 1 : 0, g_link->applied, inventory, u32(own_children.size()), missing, extra);
+	if (!match)
+	{
+		string_path path;
+		FS.update_path(path, "$logs$", "coop-item-graph-client.csv");
+		const bool fresh = !g_link->item_graph_csv_written;
+		if (FILE* file = fopen(path, fresh ? "w" : "a"))
+		{
+			if (fresh)
+				fprintf(file, "seq,item_entity,owner_entity\n");
+			for (const auto& i : items)
+				fprintf(file, "%I64u,%I64u,%I64u\n", seq, i.first, i.second);
+			fclose(file);
+			g_link->item_graph_csv_written = true;
+		}
+	}
+}
