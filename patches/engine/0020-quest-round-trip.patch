+#pragma once
+
+// S02-T06e: a quest (task) given, carried across a checkpoint, completed and
+// carried across a second checkpoint, on the campaign server and on the
+// normal client.
+//
+// The installed task system has two halves. Native: CGameTaskManager owns
+// the CGameTask objects (GametaskManager.cpp), updates them every level
+// frame (CLevel::OnFrame -> UpdateTasks -> CGameTask::UpdateState, whose
+// complete/fail functors call back into Lua) and persists them in the ALife
+// registry container (CGameTaskWrapper, saved into the .scop by
+// CALifeStorageManager::save). Lua: task_manager.script's CRandomTask keeps
+// a CGeneralTask per task (task_objects.script), updated from the actor's
+// binder (bind_stalker.script), with its state marshalled into the .scoc
+// (task_manager.save_state/load_state) and the fetch item in the actor's
+// portable store (save_var/load_var, _g.script).
+//
+// A fetch task is given in dialogue and completed in dialogue: the player
+// uses the NPC (engine use path -> the stalker binder's use_callback, which
+// records the talked-to id), the talk state starts (CInventoryOwner::
+// OfferTalk/StartTalk, what CActor::RunTalkDialog does before it shows the
+// window), the dialog phrases call dialogs.generate_available_tasks,
+// text_npc_has_task (runs the task's fetch_func) and npc_give_task; later
+// actor_has_finished_task and npc_set_finished_task_complete; closing the
+// dialog runs pda.actor_menu_mode(11). The fixture calls exactly those
+// functions in that order, with the real actor and the real NPC, and shows
+// no window; everything the task does (CGameTask creation, status functor,
+// completion through UpdateTasks, task_callback, on_complete effects:
+// money, goodwill, info portion, item removal) is the installed code's.
+//
+// Default quest: mar_base_stalker_tech_task_1 from Novikov, the Clear Sky
+// mechanic (character profile mar_base_stalker_tech), a fetch task for one
+// itm_basickit (tm_marsh.ltx). Its on_complete grants goodwill, pays for the
+// kit, removes it and sets the info portion mar_base_stalker_tech_upgrade_tier_1.
+// Options: -s02-quest-task <id>, -s02-quest-giver <profile>.
+
+struct QuestSnapshot
+{
+	string64 label;
+	string128 task_id;
+	// the task giver
+	u16 giver_id;
+	bool giver_se;
+	bool giver_alive;
+	bool giver_online;
+	bool giver_live;
+	// native task manager
+	bool native_task; // HasGameTask(id, false)
+	int native_state; // ETaskState or -1
+	u64 receive_time;
+	u32 native_total;
+	u32 native_inprogress;
+	u32 native_completed;
+	bool active_is_task;
+	u32 tm_updates; // CGameTaskManager::UpdateTasks calls so far (this process)
+	u32 state_updates; // CGameTask::UpdateState calls so far (this process)
+	// Lua task manager
+	bool lua_task; // task_info[id] exists
+	string32 lua_status;
+	int lua_stage;
+	bool lua_loaded;
+	bool lua_has_t;
+	bool lua_checked; // check_time set: check_task ran
+	int lua_giver_id;
+	string64 fetch_section; // load_var(actor, id.."_fetch")
+	int fetch_count;
+	// the world
+	u32 items_in_inventory; // actor items of fetch_section
+	u32 money;
+	int goodwill_csky;
+	bool info_tier1; // actor has mar_base_stalker_tech_upgrade_tier_1
+	bool actor_talking;
+	bool npc_talking;
+	bool used_npc_event; // GetEvent("used_npc_id") == giver
+	u32 available_count; // axr_task_manager.available_tasks[giver] size when offered
+	u32 spawned_items;
+};
+
+// Server smoke. Give: use the giver, start the talk, offer and accept the
+// task through the dialog functions, close the dialog; writes rows
+// before-give and given. Observed: after the first ticks (row ticked).
+// Restored: after the first checkpoint round-trip (row restored).
+// Complete: spawn the fetch item into the actor's inventory, wait for the
+// status functor, turn the task in through the dialog functions, wait for
+// the completion to land (row completed). Persisted: after the second
+// checkpoint round-trip (row persisted).
+// Approach: the player walks to the giver. When the giver is offline (not
+// within the ALife switch distance of the actor), the actor is moved next
+// to the giver's ALife position the way the script API's SetActorPosition
+// does (as in S02-T06b) and the switch manager brings the giver online on
+// its own; Tick returns true once the giver is a live object.
+extern "C" bool __cdecl xrCampaignLevel_QuestApproachBegin();
+extern "C" bool __cdecl xrCampaignLevel_QuestApproachTick();
+extern "C" bool __cdecl xrCampaignLevel_QuestGive(LPCSTR out_path);
+extern "C" bool __cdecl xrCampaignLevel_QuestObserved(u32 ticks);
+extern "C" bool __cdecl xrCampaignLevel_QuestRestored();
+extern "C" bool __cdecl xrCampaignLevel_QuestCompleteBegin();
+extern "C" bool __cdecl xrCampaignLevel_QuestCompleteTick(); // true when finished (either way)
+extern "C" bool __cdecl xrCampaignLevel_QuestCompleteEnd(u32 ticks);
+extern "C" bool __cdecl xrCampaignLevel_QuestPersisted();
+
+// Normal client. -s02-quest-capture: started from the server's first
+// checkpoint (task given), snapshot client-restored one second after the
+// actor spawned, then complete the task the same way and snapshot
+// client-completed, then quit. -s02-quest-persisted: started from the
+// server's second checkpoint, snapshot client-persisted and quit. Rows go
+// to $logs$/s02-t06e-quest.csv.
+void ClientQuestCaptureOnFrame();
+
+// Observation counters (GametaskManager.cpp, GameTask.cpp).
+extern u32 g_s02_task_manager_updates;
+extern u32 g_s02_task_state_updates;
