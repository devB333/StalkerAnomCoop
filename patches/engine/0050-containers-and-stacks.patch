+// ------------------------------------------------------------ S08-T08
+// Durable containers, server-made inventory changes and ammunition stacks
+// (docs/persistence-contract.md §6 `entity`, `tombstone`, `stack`).
+//
+// Containers: before the first committed transfer that touches an inventory
+// box or a body after each publication, the container's definition is
+// journaled (`entity`); recovery re-creates a container the recovered world
+// does not hold (created after the checkpoint: a stash a script spawned, a
+// body of an NPC spawned since), so the transfers that name it put their
+// items back into it, not on the ground.
+//
+// Server-made changes: whatever the server's own gameplay does to a
+// participant actor's inventory between two of the host's ticks (the
+// installed scripts' deferred work, such as the backpack stash moving the
+// ruck into a new box; an NPC taking from a player; a script creating or
+// releasing an item) is observed by comparing the actor's children with the
+// previous tick and journaled as a server-origin record: `pickup` (the item
+// ends in the actor), `transfer` (it went to a container or the ground) or
+// `tombstone` (released). The host's own work in its tick (client actions,
+// their adapters, the quest's effects, the kit, the fixtures) is journaled by
+// itself; the observation is taken again at the end of every tick so it is
+// not seen twice. Combat consumables (ammunition boxes, grenades, bolts) are
+// not observed: they roll back with the weapons and the fight (D7).
+//
+// Stacks: an ammunition box moved into an inventory box is merged with the
+// box's stacks of the same section the way the installed scripts do it
+// (item_weapon.ammo_aggregation, which the client's inventory UI runs after
+// a move into a box), on the server once the level holds the item in the box;
+// the counts and the released stacks are journaled (`stack`) and sent to the
+// clients (CampaignEvent 10). No installed path splits a stack.
+
+u8 container_kind(u16 id)
+{
+	CSE_Abstract* se = id != kNoEngineId && id != 0xffff ? Level().Server->ID_to_entity(id) : nullptr;
+	if (!se)
+		return 0;
+	if (smart_cast<CSE_ALifeInventoryBox*>(se))
+		return 1;
+	if (CSE_ALifeCreatureAbstract* creature = smart_cast<CSE_ALifeCreatureAbstract*>(se))
+		return creature->g_Alive() ? 0 : 2; // a body: an NPC's or a participant's corpse
+	return 0;
+}
+
+void sync_ammo_state(CSE_Abstract* se)
+{
+	// the level object holds the current count; the server entity's copy may lag
+	if (CSE_ALifeItemAmmo* ammo = smart_cast<CSE_ALifeItemAmmo*>(se))
+		if (CWeaponAmmo* object = smart_cast<CWeaponAmmo*>(Level().Objects.net_Find(se->ID)))
+			ammo->a_elapsed = object->m_boxCurr;
+}
+
+// False: the store failed (closed from now on).
+bool ensure_container_record(u16 id, LPCSTR why)
+{
+	const u8 kind = container_kind(id);
+	if (!kind)
+		return true;
+	const u64 entity = entity_of(id);
+	if (!entity || g_host->containers_recorded.count(entity))
+		return true;
+	CSE_Abstract* se = Level().Server->ID_to_entity(id);
+	ContainerRecord record;
+	record.entity = entity;
+	record.kind = kind;
+	record.section = se->s_name.c_str();
+	record.position[0] = se->o_Position.x;
+	record.position[1] = se->o_Position.y;
+	record.position[2] = se->o_Position.z;
+	{
+		NET_Packet packet;
+		se->Spawn_Write(packet, FALSE);
+		record.state.assign(packet.B.data, packet.B.data + packet.B.count);
+	}
+	CoopPersistence* persistence = g_host->persistence;
+	if (!persistence || persistence->failed())
+		return false;
+	const u64 revision = ++g_host->commit;
+	if (!persistence->commit(coop::store::kRecordEntity, g_host->tick, revision, encode_container(record)))
+	{
+		++g_host->ledger_store_failed;
+		g_host->log.line("container-store-failed revision=%I64u entity=%I64u reason=%s", revision, entity,
+			persistence->failure());
+		g_host->stop_requested = true;
+		return false;
+	}
+	g_host->containers_recorded.insert(entity);
+	++g_host->containers_committed;
+	g_host->container_expected[entity]; // tracked from here on
+	g_host->log.line("container-committed revision=%I64u entity=%I64u id=%u kind=%s section=%s why=%s "
+		"pos=%.2f,%.2f,%.2f state_bytes=%u", revision, entity, u32(id), kind == 1 ? "box" : "body",
+		record.section.c_str(), why, record.position[0], record.position[1], record.position[2],
+		u32(record.state.size()));
+	return true;
+}
+
+// Re-creates a container the recovered world does not hold, on the ground at
+// its recorded position under its EntityId (a body from its definition, dead).
+u16 recreate_container(const ContainerRecord& r)
+{
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	if (!alife || r.state.size() < 16 || r.state.size() > sizeof(NET_Packet().B.data))
+		return kNoEngineId;
+	Fvector at;
+	at.set(r.position[0], r.position[1], r.position[2]);
+	const CLevelGraph& level_graph = ai().level_graph();
+	if (!_valid(at) || !level_graph.valid_vertex_position(at))
+		return kNoEngineId;
+	const u32 vertex = level_graph.vertex_id(at);
+	if (!level_graph.valid_vertex_id(vertex))
+		return kNoEngineId;
+	NET_Packet in;
+	in.B.count = u32(r.state.size());
+	memcpy(in.B.data, r.state.data(), r.state.size());
+	u16 type = 0;
+	in.r_begin(type);
+	string256 section;
+	in.r_stringZ(section);
+	if (type != M_SPAWN || xr_strcmp(section, r.section.c_str()))
+		return kNoEngineId;
+	CSE_Abstract* entity = F_entity_Create(section);
+	CSE_ALifeDynamicObject* dynamic = entity ? smart_cast<CSE_ALifeDynamicObject*>(entity) : nullptr;
+	if (!dynamic)
+	{
+		if (entity)
+			F_entity_Destroy(entity);
+		return kNoEngineId;
+	}
+	entity->Spawn_Read(in);
+	entity->s_name = section;
+	entity->s_RP = 0xff;
+	entity->m_campaign_entity = r.entity;
+	entity->ID = alife->server().PerformIDgen(0xffff, entity);
+	entity->ID_Parent = 0xffff;
+	entity->ID_Phantom = 0xffff;
+	entity->o_Position = at;
+	dynamic->m_tNodeID = vertex;
+	dynamic->m_tGraphID = ai().cross_table().vertex(vertex).game_vertex_id();
+	dynamic->m_tSpawnID = u16(-1);
+	if (CSE_ALifeCreatureAbstract* creature = smart_cast<CSE_ALifeCreatureAbstract*>(entity))
+		creature->set_health(0.f); // a body
+	NET_Packet out;
+	entity->Spawn_Write(out, FALSE);
+	const u16 id = entity->ID;
+	alife->server().FreeID(id, 0);
+	F_entity_Destroy(entity);
+	g_campaign_identity->expect_entity(id, EntityId{r.entity});
+	ClientID client;
+	client.set(0xffff);
+	u16 dummy;
+	out.r_begin(dummy);
+	CSE_Abstract* created = alife->server().Process_spawn(out, client);
+	return created ? created->ID : kNoEngineId;
+}
+
+void apply_container(const ContainerRecord& r, u64 revision)
+{
+	g_host->containers_recorded.insert(r.entity);
+	g_host->container_expected[r.entity];
+	const u16 id = engine_id_of_entity(r.entity);
+	if (id != kNoEngineId)
+	{
+		g_host->log.line("container-replay-noop revision=%I64u entity=%I64u id=%u reason=present", revision, r.entity,
+			u32(id));
+		return;
+	}
+	const u16 created = recreate_container(r);
+	++g_host->containers_recreated;
+	g_host->log.line("container-replay-recreated revision=%I64u entity=%I64u id=%u section=%s kind=%s ok=%d", revision,
+		r.entity, u32(created), r.section.c_str(), r.kind == 1 ? "box" : "body", created != kNoEngineId ? 1 : 0);
+}
+
+// A tracked container's contents as the records say (item entity set).
+void expect_container_item(u64 container, u64 item, bool in)
+{
+	for (auto& c : g_host->container_expected)
+		if (c.first != container)
+			c.second.erase(item);
+	if (!container || !g_host->container_expected.count(container))
+		return;
+	if (in)
+		g_host->container_expected[container].insert(item);
+	else
+		g_host->container_expected[container].erase(item);
+}
+
+void apply_tombstone(const TombstoneRecord& r, u64 revision)
+{
+	g_host->consumed_entities.insert(r.entity);
+	g_host->pickup_expected.erase(r.entity);
+	g_host->inventory_expected.erase(r.entity);
+	expect_container_item(0, r.entity, false);
+	release_entity(r.entity, "tombstone", revision);
+}
+
+bool observed_kind(CSE_Abstract* se)
+{
+	// combat consumables roll back with the fight: not observed
+	return se && smart_cast<CSE_ALifeInventoryItem*>(se) && !smart_cast<CSE_ALifeItemAmmo*>(se) &&
+		!smart_cast<CSE_ALifeItemGrenade*>(se) && !smart_cast<CSE_ALifeItemBolt*>(se);
+}
+
+void observer_resync()
+{
+	g_host->observed_children.clear();
+	for (PlayerLink& link : g_host->links)
+		if (link.bound)
+			if (CActor* actor = participant_actor(link.ref))
+				if (CSE_Abstract* se = Level().Server->ID_to_entity(u16(actor->ID())))
+				{
+					xr_set<u16>& children = g_host->observed_children[u16(actor->ID())];
+					for (u16 child : se->children)
+						children.insert(child);
+				}
+	// what the next comparison needs to name an item released meanwhile
+	g_host->observed_entities.clear();
+	g_host->observed_sections.clear();
+	for (const auto& a : g_host->observed_children)
+		for (u16 item : a.second)
+		{
+			CSE_Abstract* se = Level().Server->ID_to_entity(item);
+			g_host->observed_entities[item] = {entity_of(item), observed_kind(se)};
+			if (se)
+				g_host->observed_sections[item] = se->s_name.c_str();
+		}
+}
+
+bool server_commit(u8 kind, const std::vector<u8>& payload, u64& revision, LPCSTR what)
+{
+	CoopPersistence* persistence = g_host->persistence;
+	if (!persistence || persistence->failed())
+	{
+		++g_host->observed_unrecorded;
+		return false;
+	}
+	revision = ++g_host->commit;
+	if (!persistence->commit(kind, g_host->tick, revision, payload))
+	{
+		++g_host->ledger_store_failed;
+		g_host->log.line("observed-store-failed revision=%I64u what=%s reason=%s", revision, what,
+			persistence->failure());
+		g_host->stop_requested = true;
+		return false;
+	}
+	return true;
+}
+
+// The server's own changes to the participant actors' inventories since the
+// previous tick (the engine frame between them), journaled as server-origin
+// records (slot as the actor's, operation 0).
+void observe_inventories()
+{
+	if (!g_host->observer_ready)
+	{
+		observer_resync();
+		g_host->observer_ready = true;
+		return;
+	}
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		CSE_Abstract* actor_se = actor ? Level().Server->ID_to_entity(u16(actor->ID())) : nullptr;
+		if (!actor_se)
+			continue;
+		const u16 actor_id = u16(actor->ID());
+		const auto prev_it = g_host->observed_children.find(actor_id);
+		if (prev_it == g_host->observed_children.end())
+			continue; // a new actor: from the next tick
+		const xr_set<u16>& prev = prev_it->second;
+		const u64 actor_entity = entity_of(actor_id);
+		xr_set<u16> now;
+		for (u16 child : actor_se->children)
+			now.insert(child);
+		for (u16 item : now)
+		{
+			if (prev.count(item))
+				continue;
+			CSE_Abstract* se = Level().Server->ID_to_entity(item);
+			if (!observed_kind(se))
+				continue;
+			sync_ammo_state(se);
+			PickupRecord r;
+			r.action = coop::proto::kActionPickup;
+			r.slot = link.ref.slot;
+			r.player = link.player;
+			r.operation = 0;
+			r.owner_entity = actor_entity;
+			r.item_entity = entity_of(item);
+			r.item_id = item;
+			r.section = se->s_name.c_str();
+			r.position[0] = se->o_Position.x;
+			r.position[1] = se->o_Position.y;
+			r.position[2] = se->o_Position.z;
+			NET_Packet packet;
+			se->Spawn_Write(packet, FALSE);
+			r.state.assign(packet.B.data, packet.B.data + packet.B.count);
+			u64 revision = 0;
+			if (!r.item_entity || !server_commit(coop::store::kRecordPickup, encode_pickup(r), revision, "take"))
+				continue;
+			++g_host->observed_taken;
+			expect_container_item(0, r.item_entity, false);
+			g_host->log.line("observed-take revision=%I64u slot=%u item=%u item_entity=%I64u section=%s",
+				revision, u32(link.ref.slot), u32(item), r.item_entity, r.section.c_str());
+		}
+		for (u16 item : prev)
+		{
+			if (now.count(item) || g_host->use_consumed.count(item))
+				continue; // a used-up item's release is its use record's
+			const u64 item_entity = entity_of(item); // still known while the id is current
+			CSE_Abstract* se = Level().Server->ID_to_entity(item);
+			if (se && !observed_kind(se))
+				continue;
+			if (!se)
+			{
+				// released: the identity map may already have dropped it
+				const auto known = g_host->observed_entities.find(item);
+				const u64 gone = known != g_host->observed_entities.end() ? known->second.first : 0;
+				if (!gone || !known->second.second)
+					continue; // not an observed kind, or never seen
+				TombstoneRecord t;
+				t.entity = gone;
+				t.owner_entity = actor_entity;
+				t.section = g_host->observed_sections[item].c_str();
+				u64 revision = 0;
+				if (!server_commit(coop::store::kRecordTombstone, encode_tombstone(t), revision, "release"))
+					continue;
+				++g_host->observed_released;
+				g_host->pickup_expected.erase(gone);
+				g_host->inventory_expected.erase(gone);
+				g_host->log.line("observed-release revision=%I64u slot=%u item_entity=%I64u section=%s", revision,
+					u32(link.ref.slot), gone, t.section.c_str());
+				continue;
+			}
+			const u16 to = se->ID_Parent;
+			if (to != 0xffff && !ensure_container_record(to, "observed"))
+				continue;
+			sync_ammo_state(se);
+			PickupRecord r;
+			r.action = to == 0xffff ? coop::proto::kActionDrop : coop::proto::kActionTransfer;
+			r.slot = link.ref.slot;
+			r.player = link.player;
+			r.operation = 0;
+			r.from_entity = actor_entity;
+			r.owner_entity = to == 0xffff ? 0 : entity_of(to);
+			r.item_entity = item_entity;
+			r.item_id = item;
+			r.section = se->s_name.c_str();
+			r.position[0] = se->o_Position.x;
+			r.position[1] = se->o_Position.y;
+			r.position[2] = se->o_Position.z;
+			NET_Packet packet;
+			se->Spawn_Write(packet, FALSE);
+			r.state.assign(packet.B.data, packet.B.data + packet.B.count);
+			u64 revision = 0;
+			if (!item_entity || (to != 0xffff && !r.owner_entity) ||
+				!server_commit(coop::store::kRecordTransfer, encode_transfer(r), revision, "move"))
+				continue;
+			++g_host->observed_moved;
+			g_host->pickup_expected[item_entity] = r.owner_entity;
+			g_host->inventory_expected.erase(item_entity);
+			expect_container_item(r.owner_entity, item_entity, true);
+			g_host->log.line("observed-move revision=%I64u slot=%u item=%u item_entity=%I64u to=%u to_entity=%I64u "
+				"section=%s", revision, u32(link.ref.slot), u32(item), item_entity, u32(to), r.owner_entity,
+				r.section.c_str());
+		}
+	}
+}
