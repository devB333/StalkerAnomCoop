+		Level().Send(P, net_flags(TRUE, TRUE));
+		g_host->log.line("encounter lethal hit power=100 type=wound victim=%u source=%u health=%.3f", u32(second->ID()),
+			u32(source->ID()), second->GetfHealth());
+	}
+}
