+		"    campaign.client_session_list() "
+		"    self.load_dlg:FillList() "
+		"    self.load_dlg:ShowDialog(true) "
+		"    self:HideDialog() "
+		"    self:Show(false) "
+		"  end "
+		"end "
+		"local ld_ok, LD = pcall(function() return ui_load_dialog end) "
+		"if ld_ok and type(LD) == 'table' and LD.UILoadDialog then "
+		"  local D = LD.UILoadDialog "
+		"  local function entries() "
