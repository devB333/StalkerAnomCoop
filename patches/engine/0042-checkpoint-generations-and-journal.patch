+// Phases 1-5; the caller sends the result (phase 6). Returns the reason (0:
+// accepted) and fills the result's outcome, commit and revision.
+u16 take_ledger(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	CoopPersistence* persistence = g_host->persistence;
+	// 1. Receive: a known operation returns its stored outcome.
+	StoredOutcome stored;
+	if (persistence && persistence->lookup(link.player, intent.operation_id, stored))
+	{
+		result.outcome = coop::proto::ActionOutcome(stored.outcome);
+		result.reason = stored.reason;
+		result.commit_id = stored.revision;
+		result.revision = stored.revision;
+		++g_host->ledger_duplicates;
+		g_host->log.line("ledger-duplicate player=%s operation=%I64u outcome=%u revision=%I64u",
+			coop_uuid_hex(link.player).c_str(), intent.operation_id, u32(stored.outcome), stored.revision);
+		return stored.reason;
+	}
+	// 2. Prepare / validate.
+	if (!link.session)
+		return 3;
+	if (intent.params.size() != 4)
+		return 2;
+	s32 delta = 0;
+	memcpy(&delta, intent.params.data(), 4);
+	if (delta < -1000 || delta > 1000)
+		return 2;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	if (!actor)
+		return 3; // dead or alive: the ledger acts on the participant's actor while it exists
+	coop::proto::EntityRef ref;
+	if (!entity_ref_of(actor->ID(), ref))
+		return 3;
+	if (!persistence || persistence->failed())
+	{
+		++g_host->ledger_store_failed;
+		return kActionReasonStoreFailed;
+	}
+	// 3. Resolve: the absolute post-state and a revision.
+	LedgerRecord record;
+	record.slot = link.ref.slot;
+	record.player = link.player;
+	record.operation = intent.operation_id;
+	record.actor_entity = ref.id;
+	record.delta = delta;
+	const s64 after = s64(actor->get_money()) + delta;
+	record.money_after = u32(clampr<s64>(after, 0, s64(1) << 31));
+	const u64 revision = ++g_host->commit;
+	// 4. Durable commit, before anything is applied or acknowledged. A
+	// failpoint in fail mode here stands for a storage failure of the append.
+	if (!coop::store::failpoint("commit:before-append"))
+		persistence->fail_closed("failpoint commit:before-append");
+	if (!persistence->commit(coop::store::kRecordLedger, g_host->tick, revision, encode_ledger(record)))
+	{
+		// Fail closed: not applied, not acknowledged as accepted; the store
+		// refuses every later critical intent; a clean stop is requested and
+		// the world keeps running for the transient play already admitted.
+		++g_host->ledger_store_failed;
+		g_host->log.line("ledger-store-failed revision=%I64u operation=%I64u reason=%s", revision, intent.operation_id,
+			persistence->failure());
+		g_host->stop_requested = true;
+		return kActionReasonStoreFailed;
+	}
+	coop::store::failpoint("commit:after-flush");
+	++g_host->ledger_commits;
+	ledger_csv("commit", revision, record);
+	// 5. Apply (idempotent). A failure here is a defect, not a storage
+	// condition: the record is committed and will be re-applied at recovery.
+	apply_ledger(record, "apply", revision);
+	coop::store::failpoint("commit:after-apply");
+	stored.outcome = u8(coop::proto::ActionOutcome::Accepted);
+	stored.reason = 0;
+	stored.revision = revision;
+	persistence->remember(link.player, intent.operation_id, stored);
+	result.outcome = coop::proto::ActionOutcome::Accepted;
+	result.commit_id = revision;
+	result.revision = revision;
+	return 0;
+}
+
+// ------------------------------------------------------------ S07-T06
+// Deaths (contract §6 `death`): every CEntityAlive::Die of an ALife object
+// on the serving server is resolved (entity, killer, position) and
+// committed in the tick it happens; at recovery a record whose entity is
+// still alive in the checkpoint is re-applied by killing it natively.
+
+void death_csv(LPCSTR phase, u64 revision, const DeathRecord& r, u16 id)
+{
+	if (g_host->deaths_csv)
+	{
+		fprintf(g_host->deaths_csv, "%I64u,%I64u,%I64u,%u,%u,%I64u,%I64u,%.2f,%.2f,%.2f,%s\n", coop::store::utc_now_ms(),
+			g_host->tick, revision, u32(r.slot), u32(id), r.entity, r.killer, r.position[0], r.position[1], r.position[2],
+			phase);
+		fflush(g_host->deaths_csv);
+	}
+}
+
+// The adapter. The entity's u16 is looked up through the ALife registry
+// (the identities were restored before the load).
+bool apply_death(const DeathRecord& r, u64 revision)
+{
+	u16 id = kNoEngineId, killer_id = kNoEngineId;
+	for (const auto& o : ai().alife().objects().objects())
+	{
+		EngineEntityKey key;
+		EntityId entity;
+		if (!g_campaign_identity->current_key(o.first, key) || g_campaign_identity->resolve(key, entity) != Refusal::None)
+			continue;
+		if (entity.value == r.entity)
+			id = o.first;
+		else if (r.killer && entity.value == r.killer)
+			killer_id = o.first;
+	}
+	if (id == kNoEngineId)
+	{
+		// released after its death (a tombstone would say so): nothing to do
+		g_host->log.line("death-replay-skipped revision=%I64u entity=%I64u reason=not-in-checkpoint", revision, r.entity);
+		return true;
+	}
+	CEntityAlive* alive = smart_cast<CEntityAlive*>(Level().Objects.net_Find(id));
+	if (alive)
+	{
+		if (!alive->g_Alive())
+		{
+			g_host->log.line("death-replay-noop revision=%I64u id=%u entity=%I64u reason=already-dead", revision, u32(id),
+				r.entity);
+			return true;
+		}
+		alive->KillEntity(killer_id != kNoEngineId ? killer_id : id, TRUE);
+		death_csv("replay", revision, r, id);
+		g_host->log.line("death-replay revision=%I64u slot=%u id=%u entity=%I64u killer=%u alive_after=%d", revision,
+			u32(r.slot), u32(id), r.entity, u32(killer_id), alive->g_Alive() ? 1 : 0);
+		return true;
+	}
+	// offline: the server entity's health, so it spawns dead when it comes online
+	CSE_ALifeCreatureAbstract* creature = smart_cast<CSE_ALifeCreatureAbstract*>(ai().alife().objects().object(id, true));
+	if (!creature)
+	{
+		g_host->log.line("death-replay-failed revision=%I64u id=%u entity=%I64u reason=not-a-creature", revision, u32(id),
+			r.entity);
+		return false;
+	}
+	creature->set_health(0.f);
+	death_csv("replay-offline", revision, r, id);
+	g_host->log.line("death-replay-offline revision=%I64u slot=%u id=%u entity=%I64u", revision, u32(r.slot), u32(id),
+		r.entity);
+	return true;
+}
+
+// ------------------------------------------------------------ S07-T07
+// Respawn (contract §9): a dead player's confirmed respawn is an operation.
+// Validate (attached, the slot's actor dead, bounded), resolve (the point:
+// the slot's position in the latest published generation when it holds this
+// actor, else the last position the server saw it alive; a reserved
+// EntityId), commit the record, apply (spawn a genuine actor from the actor
+// section at the point, with the section's supplies, bound to the slot: the
+// old actor stays as a corpse with its inventory), acknowledge, and tell the
+// client to rejoin (CampaignEvent kind 5) so its player entity is the new
+// actor by construction.
+
+bool respawn_point(PlayerLink& link, u16 dead_id, Fvector& position, u32& vertex, u16& graph, LPCSTR& source)
+{
+	// G07 decision 2: the level entry point; the older rules only when none
+	position = link.last_alive_position;
+	source = "last-alive";
+	if (link.have_entry)
+	{
+		position = link.entry;
+		source = "entry";
+	}
+	else
+		for (const PersistParticipant& p : g_host->last_published)
+			if (p.slot == link.ref.slot && p.actor_id == dead_id)
+			{
+				position = p.position;
+				source = "checkpoint";
+				break;
+			}
+	if (source[0] == 'l' && !link.have_alive_position)
+		return false;
+	const CLevelGraph& level_graph = ai().level_graph();
+	vertex = level_graph.valid_vertex_position(position) ? level_graph.vertex_id(position) : u32(-1);
+	if (!level_graph.valid_vertex_id(vertex) || !level_graph.is_accessible(vertex))
+	{
+		// beside the corpse
+		CActor* dead = smart_cast<CActor*>(Level().Objects.net_Find(dead_id));
+		if (!dead || !spawn_position(dead, vertex, position))
+			return false;
+		source = "beside-corpse";
+	}
+	else
+		position = level_graph.vertex_position(vertex);
+	const CSE_ALifeCreatureActor* se_actor = ai().alife().graph().actor();
+	graph = se_actor ? se_actor->m_tGraphID : 0;
+	return se_actor != nullptr;
+}
+
+// The adapter: spawn the recorded new actor and bind it to the slot, unless
+// the slot already holds it (idempotent).
+bool apply_respawn(const RespawnRecord& r, LPCSTR phase, u64 revision)
+{
+	PlayerLink* link = nullptr;
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot == r.slot)
+			link = &l;
+	if (!link)
+	{
+		g_host->log.line("respawn-apply-failed phase=%s revision=%I64u slot=%u reason=no-participant", phase, revision,
+			u32(r.slot));
+		return false;
+	}
+	EngineEntityKey held;
+	EntityId held_entity;
+	if (g_campaign_identity->participant_actor_key(link->ref, held) == Refusal::None &&
+		g_campaign_identity->resolve(held, held_entity) == Refusal::None && held_entity.value == r.new_entity)
+	{
+		g_host->log.line("respawn-%s-noop revision=%I64u slot=%u reason=already-holds entity=%I64u", phase, revision,
+			u32(r.slot), r.new_entity);
+		return true;
+	}
+	// Does the recorded entity exist already (the checkpoint holds it)?
+	u16 existing = kNoEngineId;
+	for (const auto& o : ai().alife().objects().objects())
+	{
+		EngineEntityKey key;
+		EntityId entity;
+		if (g_campaign_identity->current_key(o.first, key) && g_campaign_identity->resolve(key, entity) == Refusal::None &&
+			entity.value == r.new_entity)
+			existing = o.first;
+	}
+	u16 id = existing;
+	if (existing == kNoEngineId)
+	{
+		Fvector position;
+		position.set(r.position[0], r.position[1], r.position[2]);
+		bool marked = false;
+		// the dead actor's server entity: the character the new actor continues
+		const CSE_ALifeTraderAbstract* like = nullptr;
+		for (const auto& o : ai().alife().objects().objects())
+		{
+			EngineEntityKey key;
+			EntityId entity;
+			if (g_campaign_identity->current_key(o.first, key) &&
+				g_campaign_identity->resolve(key, entity) == Refusal::None && entity.value == r.old_entity)
+				like = smart_cast<const CSE_ALifeTraderAbstract*>(o.second);
+		}
+		CSE_Abstract* entity = create_participant_actor(position, r.vertex, GameGraph::_GRAPH_ID(r.graph), marked,
+			r.new_entity, like);
+		if (!entity || !smart_cast<CSE_ALifeCreatureActor*>(entity))
+		{
+			g_host->log.line("respawn-apply-failed phase=%s revision=%I64u slot=%u reason=spawn", phase, revision, u32(r.slot));
+			return false;
+		}
+		id = entity->ID;
+		++g_host->actors_spawned;
+	}
+	EngineEntityKey key;
+	EntityId entity;
+	if (!g_campaign_identity->current_key(id, key) || g_campaign_identity->resolve(key, entity) != Refusal::None ||
+		entity.value != r.new_entity)
+	{
+		g_host->log.line("respawn-apply-failed phase=%s revision=%I64u slot=%u reason=entity-mismatch id=%u got=%I64u "
+			"expected=%I64u", phase, revision, u32(r.slot), u32(id), entity.value, r.new_entity);
+		return false;
+	}
+	// the slot's actor binding moves from the corpse to the new actor
+	const Refusal bound = g_campaign_identity->bind_actor(g_campaign_identity->authority(), link->ref, key);
+	link->pending_actor = id;
+	link->have_alive_position = false;
+	link->kit_pending = existing == kNoEngineId; // G07 decision 3: the faction kit once it is online
+	g_host->log.line("respawn-%s revision=%I64u slot=%u old_entity=%I64u new_entity=%I64u id=%u existing=%d "
+		"pos=%.2f,%.2f,%.2f vertex=%u bind=%s",
+		phase, revision, u32(r.slot), r.old_entity, r.new_entity, u32(id), existing != kNoEngineId ? 1 : 0,
+		r.position[0], r.position[1], r.position[2], r.vertex, refusal_name(bound));
+	return bound == Refusal::None;
+}
