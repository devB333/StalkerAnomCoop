+void give_faction_kit(PlayerLink& link, CActor* actor)
+{
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	const CSE_ALifeDynamicObject* se = alife ? ai().alife().objects().object(u16(actor->ID()), true) : nullptr;
+	const CSE_ALifeTraderAbstract* trader = smart_cast<const CSE_ALifeTraderAbstract*>(se);
+	if (!alife || !se || !trader)
+	{
+		g_host->log.line("respawn-kit-failed slot=%u reason=no-server-entity", u32(link.ref.slot));
+		return;
+	}
+	CHARACTER_COMMUNITY community;
+	community.set(trader->m_community_index);
+	string_path path;
+	FS.update_path(path, "$game_config$", "items\\settings\\new_game_loadouts.ltx");
+	CInifile loadouts(path, TRUE, TRUE, FALSE);
+	// the player's community ids carry an "actor_" prefix (actor_stalker,
+	// actor_bandit, ...); the loadout sections are keyed by the faction
+	LPCSTR faction = community.id().c_str();
+	if (!strncmp(faction, "actor_", 6))
+		faction += 6;
+	string128 section;
+	xr_sprintf(section, "%s_loadout", faction);
+	if (!loadouts.section_exist(section))
+	{
+		g_host->log.line("respawn-kit-failed slot=%u reason=no-loadout community=%s", u32(link.ref.slot),
+			community.id().c_str());
+		return;
+	}
+	u32 items = 0, ammo_boxes = 0;
+	string512 given = "";
+	const u32 lines = loadouts.line_count(section);
+	for (u32 i = 0; i < lines; ++i)
+	{
+		LPCSTR name = nullptr;
+		LPCSTR value = nullptr;
+		if (!loadouts.r_line(section, int(i), &name, &value) || !name || !value)
+			continue;
+		if (!pSettings->section_exist(name))
+			continue;
+		string256 tokens;
+		xr_strcpy(tokens, value);
+		LPCSTR first = strtok(tokens, ", \t");
+		LPCSTR second = first ? strtok(nullptr, ", \t") : nullptr;
+		if (!first || xr_strcmp(first, "false"))
+			continue; // "true": a pickable extra, not the kit
+		const u32 amount = second ? u32(_max(1, atoi(second))) : 1u;
+		for (u32 n = 0; n < amount; ++n)
+			give_item(alife, name, actor, se);
+		items += amount;
+		if (xr_strlen(given) + xr_strlen(name) + 2 < sizeof(given))
+		{
+			xr_strcat(given, name);
+			xr_strcat(given, " ");
+		}
+		// a weapon: ammo for it
+		if (pSettings->line_exist(name, "ammo_class"))
+		{
+			const u32 slot = pSettings->line_exist(name, "slot") ? pSettings->r_u32(name, "slot") : 0xff;
+			const u32 anim = pSettings->line_exist(name, "animation_slot") ? pSettings->r_u32(name, "animation_slot") : 0;
+			if ((slot == 0 && anim == 1) || slot == 1 || slot == 2)
+			{
+				string256 classes;
+				xr_strcpy(classes, pSettings->r_string(name, "ammo_class"));
+				LPCSTR ammo = strtok(classes, ", \t");
+				if (ammo && pSettings->section_exist(ammo))
+				{
+					const u32 box = pSettings->line_exist(ammo, "box_size") ? pSettings->r_u32(ammo, "box_size") : 50;
+					u32 count = loadouts.line_exist("ammo_count", ammo) ? loadouts.r_u32("ammo_count", ammo) : 0;
+					if (!count)
+						count = box < 30 ? 2 * box : box;
+					const u32 boxes = (count + box - 1) / _max(1u, box);
+					for (u32 n = 0; n < boxes; ++n)
+						give_item(alife, ammo, actor, se);
+					ammo_boxes += boxes;
+				}
+			}
+		}
+	}
+	g_host->log.line("respawn-kit slot=%u actor=%u community=%s section=%s items=%u ammo_boxes=%u money=%u given=[%s]",
+		u32(link.ref.slot), u32(actor->ID()), community.id().c_str(), section, items, ammo_boxes, trader->m_dwMoney, given);
+}
