+// CampaignEvent 17: an upgrade installed on an item (op 1: the same install
+// here, loading mode) or its repair (op 2: the condition comes with the layout)
+void on_upgrade_installed(const coop::proto::CampaignEvent& event)
+{
+	PayloadReader r(event.payload);
+	coop::proto::EntityRef ref;
+	ref.id = r.get<u64>();
+	ref.generation = r.get<u32>();
+	const u8 op = r.get<u8>();
+	string256 id;
+	r.str(id, sizeof(id));
+	if (!r.ok)
+		return;
+	Link::Upgrade& t = g_link->upgrade;
+	++t.installed_events;
+	const u16 item_id = id_of(ref);
+	CObject* object = item_id != 0xffff ? Level().Objects.net_Find(item_id) : nullptr;
+	CInventoryItem* item = object ? smart_cast<CInventoryItem*>(object) : nullptr;
+	bool installed = false;
+	if (item && op == 1 && id[0])
+	{
+		const shared_str uid(id);
+		installed = item->has_upgrade(uid) || ai().alife().inventory_upgrade_manager().upgrade_install(*item, uid, true);
+	}
+	g_link->log.line("upgrade-installed item=%u item_entity=%I64u section=%s op=%u upgrade=%s present=%d installed=%d", u32(item_id),
+		ref.id, item ? *item->object().cNameSect() : "-", u32(op), id, item ? 1 : 0, installed ? 1 : 0);
+	CUIGameSP* ui = smart_cast<CUIGameSP*>(CurrentGameUI());
+	if (t.open && ui)
+	{
+		ui->GetActorMenu().CoopUpgradeRefresh();
+		lua_ui_refresh();
+	}
+}
+
+// S10-T04f: Anomaly's inventory, trade and repair windows are the installed
+// Lua UI (ui_inventory.script, opened through the engine's StartTrade /
+// StartUpgrade script hooks), not the engine's CUIActorMenu. Its item lists are
+// nudged after a server-made change, and its presence tells when a session's
+// window is gone (it never reaches the engine menu's deinit).
+static luabind::object lua_ui_object()
+{
+	luabind::object globals = luabind::get_globals(ai().script_engine().lua());
+	luabind::object module = globals["ui_inventory"];
+	if (module.type() != LUA_TTABLE)
+		return luabind::object();
+	return module["GUI"];
+}
+
+static void lua_ui_refresh()
+{
+	luabind::object gui = lua_ui_object();
+	if (gui.type() == LUA_TNIL)
+		return;
+	luabind::object update = gui["On_Item_Update"];
+	if (update.type() == LUA_TFUNCTION)
+		luabind::call_function<void>(update, gui);
+}
+
+static bool lua_ui_shown()
+{
+	luabind::object gui = lua_ui_object();
+	if (gui.type() == LUA_TNIL)
+		return false;
+	luabind::object shown = gui["IsShown"];
+	return shown.type() == LUA_TFUNCTION && luabind::call_function<bool>(shown, gui);
+}
+
+static void upgrade_result(const Link::PickupPending& p, const coop::proto::ActionResult& result)
+{
+	Link::Upgrade& t = g_link->upgrade;
+	const bool accepted = result.outcome == coop::proto::ActionOutcome::Accepted;
+	if (p.action == coop::proto::kActionUpgradeOpen)
+	{
+		if (!accepted)
+		{
+			t.pending_open = false;
+			_give_news(result.reason == coop::proto::kReasonNoMechanic ? "Co-op: this character is not a mechanic" :
+				"Co-op: the upgrade window could not be opened", "", "ui_inGame2_Mesta_evakuatsii", 0, 6000, 0);
+		}
+		g_link->log.line("upgrade-open-result outcome=%u reason=%u", u32(result.outcome), u32(result.reason));
+		return;
+	}
+	if (p.action == coop::proto::kActionUpgrade)
+	{
+		t.pending = false;
+		++(accepted ? t.accepted : t.refused);
+		if (!accepted)
+			_give_news(result.reason == coop::proto::kReasonNoMoney ? "Co-op: not enough money" :
+				"Co-op: the mechanic refused", "", "ui_inGame2_Mesta_evakuatsii", 0, 6000, 0);
+		g_link->log.line("upgrade-result outcome=%u reason=%u commit=%I64u", u32(result.outcome), u32(result.reason),
+			result.commit_id);
+	}
+}
