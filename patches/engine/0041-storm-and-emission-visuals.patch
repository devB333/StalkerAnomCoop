+static bool chatty_presentation(campaign::Presentation kind)
+{
+	return kind == campaign::Presentation::PostProcessFactor || kind == campaign::Presentation::SoundVolume ||
+		kind == campaign::Presentation::SoundPosition || kind == campaign::Presentation::ParticlesMove;
+}
+
+// Each live player's new presentation records (its own outbox, then the
+// broadcast one), oldest first, each once.
+void send_presentation()
+{
+	xr_vector<campaign::PresentationRecord> records;
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!client_in_world(link) || !link.bound || link.ref.slot >= campaign::kBroadcastSlot)
+			continue;
+		if (!link.presentation_started)
+		{
+			link.presentation_started = true;
+			link.presentation_cursor = link.presentation_cursor_all = campaign::presentation_serial();
+			g_host->log.line("present-start slot=%u serial=%u", u32(link.ref.slot), campaign::presentation_serial());
+		}
+		for (int source = 0; source < 2; ++source)
+		{
+			const u8 slot = source ? campaign::kBroadcastSlot : link.ref.slot;
+			u32& cursor = source ? link.presentation_cursor_all : link.presentation_cursor;
+			campaign::presentation_outbox(slot, records);
+			for (const campaign::PresentationRecord& r : records)
+			{
+				if (r.serial <= cursor)
+					continue;
+				cursor = r.serial;
+				std::vector<u8> p;
+				put_u8(p, u8(r.kind));
+				put_u16(p, r.object);
+				put_u32(p, r.handle);
+				put_f32(p, r.position.x);
+				put_f32(p, r.position.y);
+				put_f32(p, r.position.z);
+				put_f32(p, r.value);
+				put_u32(p, r.flags);
+				put_u32(p, r.serial);
+				put_str(p, r.detail);
+				queue_event(link, kEventPresentation, p);
+				++g_host->presentations_sent;
+				if (!chatty_presentation(r.kind))
+					g_host->log.line("present slot=%u serial=%u kind=%s object=%u handle=%u detail=%s flags=%u value=%.3f pos=%.1f,%.1f,%.1f",
+						u32(link.ref.slot), r.serial, campaign::presentation_name(r.kind), u32(r.object), r.handle, r.detail,
+						r.flags, r.value, VPUSH(r.position));
+			}
+			// sent records leave the outbox (its capacity then bounds the unsent only)
+			if (!source)
+				campaign::presentation_trim(slot, cursor);
+		}
+	}
+	u32 everyone = u32(-1);
+	bool anyone = false;
+	for (PlayerLink& link : g_host->links)
+		if (client_in_world(link) && link.bound && link.presentation_started)
+		{
+			anyone = true;
+			everyone = _min(everyone, link.presentation_cursor_all);
+		}
+	if (anyone)
+		campaign::presentation_trim(campaign::kBroadcastSlot, everyone);
+}
