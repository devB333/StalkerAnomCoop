+		a2 ? a2->Position().z : 0.f, a2 ? u32(a2->inventory().m_all.size()) : 0,
+		g_campaign_identity ? u32(g_campaign_identity->live_actor_count()) : 0, s.compat_ambiguous, s.sole_refused,
+		g_actor ? u32(g_actor->ID()) : u32(no_id), se_actor ? u32(se_actor->ID) : u32(no_id),
