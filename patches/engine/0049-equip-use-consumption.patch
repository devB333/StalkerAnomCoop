+// The installed inventory UI's slot table (ui_inventory.script,
+// UIInventory.slot_cell): a pistol fits slot 2, 1 or 3, a rifle 3 or 2,
+// every other item only its own base slot. CInventory::CanPutInSlot checks
+// only that the slot is free; the UI decides which slots an item fits.
+bool slot_fits(u16 base, u16 slot)
+{
+	if (base == slot)
+		return true;
+	if (base == INV_SLOT_2)
+		return slot == KNIFE_SLOT || slot == INV_SLOT_3;
+	if (base == INV_SLOT_3)
+		return slot == INV_SLOT_2;
+	return false;
+}
