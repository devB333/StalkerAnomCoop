+// S06-T02 fixture (profile drop = N): every N seconds a medkit is spawned
+// 1.5 m above the ground beside participant 1's actor and, once its physics
+// shell is active, tossed up and sideways (an item comes online resting on
+// the ground, snap-1), so a moving, falling and settling object can be
+// compared on the clients; each is released 0.8 N seconds after its spawn.
+void drop_objects()
+{
+	if (!g_host->config.drop || !ai().get_alife())
+		return;
+	const u32 now = g_host->wall.GetElapsed_ms();
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	for (size_t i = 0; i < g_host->dropped.size(); ++i)
+	{
+		if (g_host->dropped_tossed[i])
+			continue;
+		CPhysicsShellHolder* holder = smart_cast<CPhysicsShellHolder*>(Level().Objects.net_Find(g_host->dropped[i]));
+		CPhysicsShell* shell = holder ? holder->PPhysicsShell() : nullptr;
+		if (!shell || !shell->isActive())
+			continue;
+		Fvector dir;
+		dir.set(0.35f, 1.f, 0.25f);
+		dir.normalize();
+		shell->Enable();
+		shell->applyImpulse(dir, shell->getMass() * 5.f); // about 5 m/s
+		g_host->dropped_tossed[i] = true;
+		++g_host->tosses;
+		g_host->log.line("drop-toss id=%u mass=%.3f pos=%.2f,%.2f,%.2f", u32(g_host->dropped[i]), shell->getMass(),
+			VPUSH(holder->Position()));
+	}
+	for (size_t i = 0; i < g_host->dropped.size();)
+	{
+		if (now < g_host->dropped_release_ms[i])
+		{
+			++i;
+			continue;
+		}
+		const u16 id = g_host->dropped[i];
+		CSE_ALifeDynamicObject* object = ai().alife().objects().object(id, true);
+		if (object)
+		{
+			if (object->m_bOnline)
+			{
+				NET_Packet packet;
+				packet.w_begin(M_EVENT);
+				packet.w_u32(Level().timeServer());
+				packet.w_u16(GE_DESTROY);
+				packet.w_u16(object->ID);
+				Level().Send(packet, net_flags(TRUE, TRUE));
+			}
+			else
+				alife->release(object, true);
+		}
+		g_host->log.line("drop-release id=%u found=%d", u32(id), object ? 1 : 0);
+		g_host->dropped.erase(g_host->dropped.begin() + i);
+		g_host->dropped_release_ms.erase(g_host->dropped_release_ms.begin() + i);
+		g_host->dropped_tossed.erase(g_host->dropped_tossed.begin() + i);
 	}
+	if (now < g_host->drop_next_ms)
+		return;
+	g_host->drop_next_ms = now + g_host->config.drop * 1000;
+	xr_vector<CActor*> actors;
+	participant_actors(actors);
+	const CSE_ALifeCreatureActor* se_actor = ai().alife().graph().actor();
+	u32 vertex = u32(-1);
+	Fvector position;
+	if (actors.empty() || !se_actor || !spawn_position(actors.front(), vertex, position))
+		return;
+	position.y += 1.5f;
+	CSE_Abstract* item = alife->spawn_item("medkit", position, vertex, se_actor->m_tGraphID, u16(-1));
+	if (!item)
+		return;
+	++g_host->drops;
+	g_host->dropped.push_back(item->ID);
+	g_host->dropped_release_ms.push_back(now + g_host->config.drop * 800);
+	g_host->dropped_tossed.push_back(false);
+	g_host->log.line("drop-spawn id=%u section=medkit pos=%.2f,%.2f,%.2f", u32(item->ID), VPUSH(position));
 }
 
