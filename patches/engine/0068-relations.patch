+// ------------------------------------------------------------ S10-T04d
+// The relations fixture (profile relations_party, server-driven): once both
+// players are in the world,
+//   goodwill    in p2's context the installed Lua export changes the stalker
+//               goodwill of character 0 by -1000: p2's goodwill falls, p1's stays
+//   relation    the stalker/bandit relation set to 2000 (world: both clients)
+//   reputation  p1's reputation +100 (p1's client)
+//   published   a checkpoint, so the restart recovers the registry
+//   recovered   (the restarted server) the three values as the checkpoint kept them
+void relations_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.relations_party || !ai().get_alife())
+		return;
+	Host::RelationsFixture& f = g_host->relations_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u8 slots[2] = {0, 0};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				slots[attached] = link.ref.slot;
+				actors[attached++] = actor;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		f.recovered = g_host->persistence && g_host->persistence->recovered();
+		g_host->log.line("fixture-relations both-attached tick=%I64u recovered=%d", g_host->tick, f.recovered ? 1 : 0);
+	}
+	if (attached < 2 || f.phase >= 9 || g_host->tick < f.both_since + u64(config.relations_party) * 50)
+		return;
+	if (slots[0] != 0)
+		std::swap(actors[0], actors[1]);
+	CHARACTER_COMMUNITY stalker, bandit;
+	stalker.set("stalker");
+	bandit.set("bandit");
+	const s32 gw1 = RELATION_REGISTRY().GetCommunityGoodwill(stalker.index(), u16(actors[0]->ID()));
+	const s32 gw2 = RELATION_REGISTRY().GetCommunityGoodwill(stalker.index(), u16(actors[1]->ID()));
+	const s32 relation = RELATION_REGISTRY().GetCommunityRelation(stalker.index(), bandit.index());
+	const s32 rep1 = smart_cast<CInventoryOwner*>(actors[0])->Reputation();
+	if (f.recovered)
+	{
+		g_host->log.line("fixture-relations recovered goodwill_p1=%d goodwill_p2=%d relation=%d reputation_p1=%d", gw1, gw2,
+			relation, rep1);
+		g_host->log.line("fixture-relations done phase=recovered failures=%u", f.failures);
+		f.phase = 9;
+		return;
+	}
+	if (f.phase == 0)
+	{
+		luabind::functor<void> change;
+		if (ai().script_engine().functor("relation_registry.change_community_goodwill", change))
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(actors[1]), "fixture-relations");
+			change("stalker", 0, -1000); // character 0: the context's player
+		}
+		else
+			++f.failures;
+		const s32 after1 = RELATION_REGISTRY().GetCommunityGoodwill(stalker.index(), u16(actors[0]->ID()));
+		const s32 after2 = RELATION_REGISTRY().GetCommunityGoodwill(stalker.index(), u16(actors[1]->ID()));
+		g_host->log.line("fixture-relations goodwill p1=%d->%d p2=%d->%d", gw1, after1, gw2, after2);
+		if (after1 != gw1 || after2 != gw2 - 1000)
+			++f.failures;
+		f.phase = 1;
+		f.phase_tick = g_host->tick + 1 * 50;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		if (g_host->tick < f.phase_tick)
+			return;
+		luabind::functor<void> set;
+		if (ai().script_engine().functor("relation_registry.set_community_relation", set))
+			set("stalker", "bandit", 2000);
+		else
+			++f.failures;
+		const s32 after = RELATION_REGISTRY().GetCommunityRelation(stalker.index(), bandit.index());
+		g_host->log.line("fixture-relations relation stalker/bandit=%d->%d", relation, after);
+		if (after != 2000)
+			++f.failures;
+		f.phase = 2;
+		f.phase_tick = g_host->tick + 1 * 50;
+		return;
