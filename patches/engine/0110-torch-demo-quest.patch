+// (Presentation TorchState). Scripts no longer switch a player's torch
+// (torch_script_gate), except off when its battery is at its critical level.
+void torch_present(CTorch* torch, bool on)
+{
+	campaign::PresentationArgs args;
+	args.flags = on ? 1 : 0;
+	campaign::present_broadcast(campaign::Presentation::TorchState, u16(torch->ID()), "", args);
