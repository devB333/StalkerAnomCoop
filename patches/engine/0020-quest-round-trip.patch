+#include "../xrEngine/device.h"
+#include "../xrEngine/xr_ioconsole.h"
+
+// alife_simulator_script.cpp: the alife():create(section, position, lvid, gvid,
+// parent) binding. With an online parent it spawns the child through the
+// server (M_SPAWN -> xrServer::Process_spawn) so that the object exists in
+// the parent's inventory; the offline registration alone would leave a child
+// registered in ALife with no server object.
+CSE_Abstract* CALifeSimulator__spawn_item2(CALifeSimulator* self, LPCSTR section, const Fvector& position,
+	u32 level_vertex_id, GameGraph::_GRAPH_ID game_vertex_id, ALife::_OBJECT_ID id_parent);
+
+namespace
+{
+const u16 no_id = u16(-1);
+LPCSTR default_task = "mar_base_stalker_tech_task_1";
+LPCSTR default_giver = "mar_base_stalker_tech";
+LPCSTR info_tier1 = "mar_base_stalker_tech_upgrade_tier_1";
+
+string_path g_out_path;
+string128 g_task_id;
+string128 g_giver_profile;
+u16 g_giver_id = no_id;
+QuestSnapshot g_given;
+bool g_have_given = false;
+QuestSnapshot g_completed;
+bool g_have_completed = false;
+u32 g_available_count = 0;
+u32 g_spawned_items = 0;
+// completion phases: 0 waiting for the item and the status functor, 1 turned
+// in, waiting for the completion to land, 2 done
+u32 g_complete_phase = 0;
+u32 g_complete_ticks = 0;
+u32 g_turnin_tick = 0;
+u32 g_completed_tick = 0;
+bool g_turnin_ok = false;
+
+void read_options()
+{
+	xr_strcpy(g_task_id, default_task);
+	xr_strcpy(g_giver_profile, default_giver);
+	if (LPCSTR option = strstr(Core.Params, "-s02-quest-task "))
+		sscanf_s(option + 16, "%127s", g_task_id, static_cast<unsigned>(_countof(g_task_id)));
+	if (LPCSTR option = strstr(Core.Params, "-s02-quest-giver "))
+		sscanf_s(option + 17, "%127s", g_giver_profile, static_cast<unsigned>(_countof(g_giver_profile)));
+}
+
+// The ALife stalker whose character profile is the giver's.
+CSE_ALifeHumanStalker* find_giver()
+{
+	const CALifeSimulator* alife = ai().get_alife();
+	if (!alife)
+		return nullptr;
+	for (const auto& entry : alife->objects().objects())
+	{
+		CSE_ALifeHumanStalker* stalker = smart_cast<CSE_ALifeHumanStalker*>(entry.second);
+		if (stalker && xr_strcmp(stalker->character_profile().c_str(), g_giver_profile) == 0)
+			return stalker;
+	}
+	return nullptr;
+}
+
+CGameObject* giver_object()
+{
+	if (g_giver_id == no_id || !g_pGameLevel)
+		return nullptr;
+	CObject* object = Level().Objects.net_Find(g_giver_id);
+	return object && !object->getDestroy() ? smart_cast<CGameObject*>(object) : nullptr;
+}
+
+u32 count_items(LPCSTR section)
+{
+	if (!g_actor || !section || !section[0])
+		return 0;
+	u32 count = 0;
+	for (PIItem item : g_actor->inventory().m_all)
+		if (item && xr_strcmp(item->object().cNameSect_str(), section) == 0)
+			++count;
+	return count;
+}
+
+int community_goodwill(LPCSTR community)
+{
+	if (!g_actor)
+		return 0;
+	CHARACTER_COMMUNITY c;
+	c.set(community);
+	return int(RELATION_REGISTRY().GetCommunityGoodwill(c.index(), g_actor->ID()));
+}
+
+luabind::object lua_globals() { return luabind::get_globals(ai().script_engine().lua()); }
+
+// A nil bound to the current Lua state: a default-constructed luabind::object
+// has no state and faults on type().
+luabind::object lua_nil() { return luabind::object(ai().script_engine().lua()); }
+
+luabind::object lua_db_actor()
+{
+	luabind::object db = lua_globals()["db"];
+	if (db.type() != LUA_TTABLE)
+		return lua_nil();
+	return db["actor"];
+}
+
+// A read-only Lua helper that copies the fields of
+// task_manager.get_task_manager().task_info[id] into a plain table (the
+// task manager is a Lua class instance, which luabind proxies do not index
+// reliably from C++). Defined once in _G; it changes no task state.
+bool ensure_lua_helper()
+{
+	static lua_State* defined_for = nullptr;
+	lua_State* L = ai().script_engine().lua();
+	if (defined_for == L)
+	{
+		luabind::object existing = lua_globals()["s02_quest_info"];
+		if (existing.type() == LUA_TFUNCTION)
+			return true;
+	}
+	LPCSTR source =
+		"function s02_quest_info(id)\n"
+		"  local tm = task_manager.get_task_manager()\n"
+		"  local t = tm and tm.task_info and tm.task_info[id]\n"
+		"  if not t then return nil end\n"
+		"  return { status = t.status, stage = t.stage, loaded = (t.loaded == true), has_t = (t.t ~= nil),\n"
+		"           checked = (t.check_time ~= nil), giver = t.task_giver_id }\n"
+		"end\n";
+	if (luaL_loadbuffer(L, source, xr_strlen(source), "s02_quest_info") != 0 || lua_pcall(L, 0, 0, 0) != 0)
+	{
+		Msg("! S02-T06e Lua helper failed: %s", lua_tostring(L, -1));
+		lua_pop(L, 1);
+		return false;
+	}
+	defined_for = L;
+	return true;
+}
+
+// A plain-table copy of task_manager.get_task_manager().task_info[id], or nil.
+luabind::object lua_task_info()
+{
+	luabind::functor<luabind::object> info;
+	if (!ensure_lua_helper() || !ai().script_engine().functor("_G.s02_quest_info", info))
+		return lua_nil();
+	return info(static_cast<LPCSTR>(g_task_id));
+}
+
+// load_var(db.actor, name): the actor's portable store (_g.script).
+luabind::object lua_load_var(LPCSTR name)
+{
+	luabind::object actor = lua_db_actor();
+	luabind::functor<luabind::object> load_var;
+	if (actor.type() == LUA_TNIL || !ai().script_engine().functor("_G.load_var", load_var))
+		return lua_nil();
+	return load_var(actor, name);
+}
+
+// axr_task_manager.available_tasks[npc_id], the list the dialog offers from.
+luabind::object lua_available_tasks(u16 npc_id)
+{
+	luabind::object manager = lua_globals()["axr_task_manager"];
+	if (manager.type() != LUA_TTABLE)
+		return lua_nil();
+	luabind::object available = manager["available_tasks"];
+	if (available.type() != LUA_TTABLE)
+		return lua_nil();
+	return available[int(npc_id)];
+}
+
+int lua_int(const luabind::object& value, int fallback)
+{
+	if (value.type() != LUA_TNUMBER)
+		return fallback;
+	return int(luabind::object_cast<float>(value));
+}
+
+void take(QuestSnapshot& s, LPCSTR label)
+{
+	ZeroMemory(&s, sizeof(s));
+	xr_strcpy(s.label, label);
+	xr_strcpy(s.task_id, g_task_id);
+	s.giver_id = g_giver_id;
+	s.native_state = -1;
+	xr_strcpy(s.lua_status, "-");
+	s.lua_stage = -1;
+	s.lua_giver_id = -1;
+	xr_strcpy(s.fetch_section, "-");
+	s.available_count = g_available_count;
+	s.spawned_items = g_spawned_items;
+	s.tm_updates = g_s02_task_manager_updates;
+	s.state_updates = g_s02_task_state_updates;
+
+	if (CSE_ALifeHumanStalker* giver = find_giver())
+	{
+		s.giver_se = true;
+		s.giver_alive = giver->g_Alive();
+		s.giver_online = giver->m_bOnline;
+	}
+	CGameObject* npc = giver_object();
+	s.giver_live = npc != nullptr;
+	if (npc)
+		if (CInventoryOwner* owner = smart_cast<CInventoryOwner*>(npc))
+			s.npc_talking = owner->IsTalking();
+
+	if (g_pGameLevel && g_actor)
+	{
+		CGameTaskManager& tm = Level().GameTaskManager();
+		CGameTask* task = tm.HasGameTask(g_task_id, false);
+		s.native_task = task != nullptr;
+		if (task)
+		{
+			s.native_state = int(task->GetTaskState());
+			s.receive_time = task->m_ReceiveTime;
+		}
+		s.native_total = u32(tm.GetGameTasks().size());
+		s.native_inprogress = tm.GetTaskCount(eTaskStateInProgress);
+		s.native_completed = tm.GetTaskCount(eTaskStateCompleted);
+		s.active_is_task = tm.ActiveTask() == task && task != nullptr;
+		s.money = g_actor->get_money();
+		s.goodwill_csky = community_goodwill("csky");
+		s.info_tier1 = g_actor->HasInfo(info_tier1);
+		s.actor_talking = g_actor->IsTalking();
+	}
+
+	// Lua side
+	luabind::object info = lua_task_info();
+	if (info.type() == LUA_TTABLE)
+	{
+		s.lua_task = true;
+		luabind::object status = info["status"];
+		if (status.type() == LUA_TSTRING)
+			xr_strcpy(s.lua_status, luabind::object_cast<LPCSTR>(status));
+		s.lua_stage = lua_int(info["stage"], -1);
+		luabind::object loaded = info["loaded"];
+		s.lua_loaded = loaded.type() == LUA_TBOOLEAN && luabind::object_cast<bool>(loaded);
+		luabind::object has_t = info["has_t"];
+		s.lua_has_t = has_t.type() == LUA_TBOOLEAN && luabind::object_cast<bool>(has_t);
+		luabind::object checked = info["checked"];
+		s.lua_checked = checked.type() == LUA_TBOOLEAN && luabind::object_cast<bool>(checked);
+		s.lua_giver_id = lua_int(info["giver"], -1);
+	}
+	string256 var;
+	strconcat(sizeof(var), var, g_task_id, "_fetch");
+	luabind::object fetch = lua_load_var(var);
+	if (fetch.type() == LUA_TSTRING)
+		xr_strcpy(s.fetch_section, luabind::object_cast<LPCSTR>(fetch));
+	strconcat(sizeof(var), var, g_task_id, "_fetch_count");
+	s.fetch_count = lua_int(lua_load_var(var), s.fetch_section[0] != '-' ? 1 : 0);
+	s.items_in_inventory = s.fetch_section[0] != '-' ? count_items(s.fetch_section) : 0;
+	luabind::functor<luabind::object> get_event;
+	if (ai().script_engine().functor("_G.GetEvent", get_event))
+	{
+		luabind::object used = get_event("used_npc_id");
+		s.used_npc_event = used.type() == LUA_TNUMBER && lua_int(used, -1) == int(g_giver_id);
+	}
+}
