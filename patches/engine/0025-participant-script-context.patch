+
+bool lua_present(LPCSTR kind, LPCSTR detail)
+{
+	Presentation presentation = Presentation::Count;
+	for (u32 i = 0; i < u32(Presentation::Count); ++i)
+		if (!xr_strcmp(kind, presentation_name(Presentation(i))))
+			presentation = Presentation(i);
+	if (presentation == Presentation::Count)
+		return false;
+	return present_to_context(presentation, 0, detail) == Refusal::None;
+}
+
+lua_State* s_compat_state = nullptr;
+
+// The server's compatibility layer for the installed single-player scripts.
+// Loaded once per Lua state on the campaign server only. It never names a
+// participant: it reads the context native code entered.
+LPCSTR const compat_source =
+	"local S = rawget(_G, '__campaign_ctx')\n"
+	"if type(S) == 'table' and S.installed then return end\n"
+	"S = { depth = 0, audit = false, installed = false, host_reads = {}, host_read_total = 0,\n"
+	"      storage_created = 0, deferred_captured = 0, deferred_refused = 0, wrapped = 0 }\n"
+	"rawset(_G, '__campaign_ctx', S)\n"
+	"local campaign = campaign\n"
+	"local getinfo = debug and debug.getinfo\n"
+	"local pcall, error, unpack, select, type, rawget, rawset, tostring =\n"
+	"      pcall, error, unpack, select, type, rawget, rawset, tostring\n"
+	"local function pack(...) return { n = select('#', ...), ... } end\n"
+	"local function finish(tok, r)\n"
+	"  campaign.leave(tok)\n"
+	"  if not r[1] then error(r[2], 0) end\n"
+	"  return unpack(r, 2, r.n)\n"
+	"end\n"
+	// db.actor: the context's actor inside a context, the binder's actor outside.
+	"local db_ns = db\n"
+	"local mt = getmetatable(db_ns)\n"
+	"if not mt then mt = {} setmetatable(db_ns, mt) end\n"
+	"local base_index, base_newindex = mt.__index, mt.__newindex\n"
+	"local host = rawget(db_ns, 'actor')\n"
+	"rawset(db_ns, 'actor', nil)\n"
+	"mt.__index = function(t, k)\n"
+	"  if k == 'actor' then\n"
+	"    if S.depth > 0 then return campaign.actor() end\n"
+	"    if S.audit then\n"
+	"      local site = '?'\n"
+	"      if getinfo then\n"
+	"        local i = getinfo(2, 'Sl')\n"
+	"        if i then site = tostring(i.short_src) .. ':' .. tostring(i.currentline) end\n"
+	"      end\n"
+	"      S.host_reads[site] = (S.host_reads[site] or 0) + 1\n"
+	"      S.host_read_total = S.host_read_total + 1\n"
+	"    end\n"
+	"    return host\n"
+	"  end\n"
+	"  if type(base_index) == 'function' then return base_index(t, k) end\n"
+	"  if base_index ~= nil then return base_index[k] end\n"
+	"  return nil\n"
+	"end\n"
+	"mt.__newindex = function(t, k, v)\n"
+	"  if k == 'actor' then host = v return end\n"
+	"  if type(base_newindex) == 'function' then return base_newindex(t, k, v) end\n"
+	"  rawset(t, k, v)\n"
+	"end\n"
+	"S.host_actor = function() return host end\n"
+	// AC_ID (the player's engine id, a Lua global): the context's actor's id
+	// inside a context, the single-player value outside one.
+	"local gmt = getmetatable(_G)\n"
+	"if gmt and rawget(_G, 'AC_ID') ~= nil then\n"
+	"  local ac_id = rawget(_G, 'AC_ID')\n"
+	"  local g_index, g_newindex = gmt.__index, gmt.__newindex\n"
+	"  rawset(_G, 'AC_ID', nil)\n"
+	"  gmt.__index = function(t, k)\n"
+	"    if k == 'AC_ID' then\n"
+	"      if S.depth > 0 then\n"
+	"        local id = campaign.actor_id()\n"
+	"        if id >= 0 then return id end\n"
+	"      end\n"
+	"      return ac_id\n"
+	"    end\n"
+	"    if type(g_index) == 'function' then return g_index(t, k) end\n"
+	"    if g_index ~= nil then return g_index[k] end\n"
+	"    return nil\n"
+	"  end\n"
+	"  gmt.__newindex = function(t, k, v)\n"
+	"    if k == 'AC_ID' then ac_id = v return end\n"
+	"    if type(g_newindex) == 'function' then return g_newindex(t, k, v) end\n"
+	"    rawset(t, k, v)\n"
+	"  end\n"
+	"  S.wrapped = S.wrapped + 1\n"
+	"end\n"
+	"S.on_enter = function(id)\n"
+	"  local storage = rawget(db_ns, 'storage')\n"
+	"  if storage and id and storage[id] == nil then\n"
+	"    storage[id] = {}\n"
+	"    S.storage_created = S.storage_created + 1\n"
+	"  end\n"
+	"end\n"
+	// Deferred work created inside a context runs in that context again.
+	"local orig_cte = _G.CreateTimeEvent\n"
+	"if type(orig_cte) == 'function' then\n"
+	"  _G.CreateTimeEvent = function(ev_id, act_id, timer, f, ...)\n"
+	"    if S.depth > 0 and type(f) == 'function' then\n"
+	"      local h = campaign.capture()\n"
+	"      if h ~= 0 then\n"
+	"        local inner = f\n"
+	"        f = function(...)\n"
+	"          local tok = campaign.enter_captured(h)\n"
+	"          if tok == 0 then S.deferred_refused = S.deferred_refused + 1 return true end\n"
+	"          return finish(tok, pack(pcall(inner, ...)))\n"
+	"        end\n"
+	"        S.deferred_captured = S.deferred_captured + 1\n"
+	"      end\n"
+	"    end\n"
+	"    return orig_cte(ev_id, act_id, timer, f, ...)\n"
+	"  end\n"
+	"  S.wrapped = S.wrapped + 1\n"
+	"end\n"
+	// An owned task's periodic Lua check runs in its owner's context.
+	"S.check_wrap = 'no-class'\n"
+	"local tobj = task_objects\n"
+	"local CGT = rawget(_G, 'CGeneralTask') or (type(tobj) == 'table' and rawget(tobj, 'CGeneralTask'))\n"
+	"if CGT and not CGT.check_task then S.check_wrap = 'no-method' end\n"
+	"if CGT and CGT.check_task then\n"
+	"  S.check_wrap = 'ok'\n"
+	"  local orig_check = CGT.check_task\n"
+	"  CGT.check_task = function(self, ...)\n"
+	"    local tok = campaign.enter_task(self.id)\n"
+	"    if tok == 0 then return orig_check(self, ...) end\n"
+	"    return finish(tok, pack(pcall(orig_check, self, ...)))\n"
+	"  end\n"
+	"  S.wrapped = S.wrapped + 1\n"
+	"end\n"
+	"S.installed = true\n";
+
+bool install_compat(lua_State* L)
+{
+	if (luaL_loadbuffer(L, compat_source, xr_strlen(compat_source), "campaign_compat") != 0 ||
+		lua_pcall(L, 0, 0, 0) != 0)
+	{
+		Msg("! S03-T05 compatibility layer failed: %s", lua_tostring(L, -1));
+		lua_pop(L, 1);
+		++s_stats.compat_failures;
+		return false;
+	}
+	if (!push_compat_table(L))
+	{
+		++s_stats.compat_failures;
+		return false;
+	}
+	lua_pushstring(L, "wrapped");
+	lua_rawget(L, -2);
+	const int wrapped = int(lua_tonumber(L, -1));
+	lua_pop(L, 1);
+	lua_pushstring(L, "check_wrap");
+	lua_rawget(L, -2);
+	const char* check_wrap = lua_isstring(L, -1) ? lua_tostring(L, -1) : "?";
+	Msg("S03-T05 compatibility layer CGeneralTask.check_task wrap: %s", check_wrap);
+	lua_pop(L, 2);
+	++s_stats.compat_installs;
+	s_compat_state = L;
+	Msg("S03-T05 compatibility layer installed (db.actor; wrapped=%d: AC_ID, CreateTimeEvent, CGeneralTask.check_task)",
+		wrapped);
+	return true;
+}
+
+double compat_number(lua_State* L, LPCSTR field)
+{
+	lua_pushstring(L, field);
+	lua_rawget(L, -2);
+	const double value = lua_tonumber(L, -1);
+	lua_pop(L, 1);
+	return value;
+}
+} // namespace
+
+void script_register_context(lua_State* L)
+{
+	module(L, "campaign")
+	[
+		def("actor", &lua_actor),
+		def("actor_id", &lua_actor_id),
+		def("slot", &lua_slot),
+		def("generation", &lua_generation),
+		def("party", &lua_party),
+		def("player", &lua_player),
+		def("origin", &lua_origin),
+		def("entry", &lua_entry),
+		def("in_context", &lua_in_context),
+		def("depth", &lua_depth),
+		def("capture", &lua_capture),
+		def("enter_captured", &lua_enter_captured),
+		def("enter_task", &lua_enter_task),
+		def("leave", &lua_leave),
+		def("is_participant_actor", &lua_is_participant_actor),
+		def("participant_slot_of", &lua_participant_slot_of),
+		def("present", &lua_present)
+	];
+}
+
+void script_context_frame()
+{
+	if (!server_role())
+		return;
+	script_contexts();
+	lua_State* L = script_state();
+	if (!L)
+		return;
+	if (!push_compat_table(L))
+	{
+		if (!install_compat(L) || !push_compat_table(L))
+			return;
+	}
+	lua_pushstring(L, "audit");
+	lua_pushboolean(L, g_campaign_identity->live_actor_count() >= 2);
+	lua_rawset(L, -3);
+	lua_pop(L, 1);
+}
+
+bool script_compat_installed()
+{
+	lua_State* L = script_state();
+	if (!L || !push_compat_table(L))
+		return false;
+	lua_pop(L, 1);
+	return true;
+}
+
+u32 script_host_reads(xr_vector<std::pair<shared_str, u32>>& out, u32* total)
+{
+	out.clear();
+	if (total)
+		*total = 0;
+	lua_State* L = script_state();
+	if (!L || !push_compat_table(L))
+		return 0;
+	if (total)
+		*total = u32(compat_number(L, "host_read_total"));
+	lua_pushstring(L, "host_reads");
+	lua_rawget(L, -2);
+	if (lua_istable(L, -1))
+	{
+		lua_pushnil(L);
+		while (lua_next(L, -2) != 0)
+		{
+			if (lua_type(L, -2) == LUA_TSTRING)
+				out.push_back(std::make_pair(shared_str(lua_tostring(L, -2)), u32(lua_tonumber(L, -1))));
+			lua_pop(L, 1);
+		}
+	}
+	lua_pop(L, 2);
+	std::sort(out.begin(), out.end(),
+		[](const std::pair<shared_str, u32>& a, const std::pair<shared_str, u32>& b) { return a.second > b.second; });
+	return u32(out.size());
+}
+
+const ScriptContextStats& script_context_stats()
+{
+	return s_stats;
+}
+
+void report_script_context(LPCSTR tag)
+{
+	const ScriptContextStack::Stats empty = {};
+	const ScriptContextStack::Stats& st = s_stack ? s_stack->stats() : empty;
+	Msg("S03-T05 script-context %s entered=%I64u refused=%I64u left=%I64u leave_mismatch=%I64u depth=%u max_depth=%u "
+		"captured=%I64u captured_entered=%I64u captured_refused=%I64u captured_evicted=%I64u",
+		tag, st.entered, st.refused, st.left, st.leave_mismatch, s_stack ? s_stack->depth() : 0u, st.max_depth_seen,
+		st.captured, st.captured_entered, st.captured_refused, st.captured_evicted);
+	Msg("S03-T05 script-context %s lua_calls=%I64u lua_no_context=%I64u task_scopes=%I64u task_unowned=%I64u "
+		"task_callbacks_hosted=%I64u presented=%I64u present_no_context=%I64u dropped=%u gameplay_context=%I64u "
+		"gameplay_compat=%I64u compat_installs=%I64u compat_failures=%I64u",
+		tag, s_stats.lua_actor_calls, s_stats.lua_no_context, s_stats.task_scopes, s_stats.task_unowned,
+		s_stats.task_callbacks_hosted, s_stats.presented, s_stats.present_no_context, s_present_dropped,
+		s_stats.gameplay_context, s_stats.gameplay_compat, s_stats.compat_installs, s_stats.compat_failures);
+	for (u32 slot = 0; slot < kOutboxSlots; ++slot)
+		if (!s_outbox[slot].empty())
+			Msg("S03-T05 script-context %s outbox slot=%u records=%u", tag, slot, u32(s_outbox[slot].size()));
+	xr_vector<std::pair<shared_str, u32>> reads;
+	u32 total = 0;
+	if (script_host_reads(reads, &total))
+	{
+		Msg("S03-T05 script-context %s host db.actor reads outside a context with two actors: total=%u sites=%u", tag,
+			total, u32(reads.size()));
+		for (const auto& read : reads)
+			Msg("S03-T05 host-read %s %u", read.first.c_str(), read.second);
+	}
+}
+} // namespace campaign
diff --git a/src/xrGame/CampaignScriptContext.h b/src/xrGame/CampaignScriptContext.h
new file mode 100644
index 0000000..5d136e8
--- /dev/null
+++ b/src/xrGame/CampaignScriptContext.h
@@ -0,0 +1,269 @@
+#pragma once
+
+// S03-T05: the native and Lua participant context contract.
+//
+// The installed single-player scripts reach "the player" four ways: the Lua
+// global db.actor (set by the actor binder), the actor's engine id 0 (AC_ID,
+// has_alife_info, alife():has_info(0, ...)), the ALife actor (alife():actor())
+// and the story object "actor". The engine reaches it through Actor() and
+// Level().CurrentEntity(). On the campaign server two participant actors live
+// and no choice among them may be implicit (D4, docs/state-ownership.md).
+//
+// The contract:
+//  - A participant script context is entered only by native code, for one
+//    ActionContext authorized against the identity registry (S03-T01) for a
+//    scope: Scope::Self needs the participant's live actor; Scope::Party the
+//    participant's own party. Contexts nest (a stack); each entry has a token
+//    and only the innermost may leave. Nothing in Lua can name a participant
+//    and enter its context: Lua can only re-enter a context native code
+//    captured for it (deferred work), and that re-entry is authorized again
+//    as server-internal, so a released participant's deferred work is
+//    refused, never redirected.
+//  - The native entry points: the dialogue (dialogue_open/close and the
+//    phrase script calls, for the actor speaker's participant), a task's
+//    update and state callback (for the participant the task was given to:
+//    CGameTask::m_campaign_owner), the Lua task check of an owned task, and
+//    deferred Lua work created inside a context.
+//  - Lookups are strict: script_context_actor() and the Lua campaign.*
+//    functions return nothing outside a context; they never fall back to a
+//    player. gameplay_script_actor(purpose) is the native bindings' rule: the
+//    context's actor, else the single-actor compatibility accessor
+//    (sole_participant_actor, refused and counted with two actors).
+//  - Installed-script compatibility, campaign server only: inside a context
+//    the installed scripts' two Lua-global handles for the player, db.actor
+//    and AC_ID, are the context's actor and its id; outside one they are the
+//    single-player script actor the installed binder registered (the ALife
+//    actor, S03-T03) and 0, and every out-of-context db.actor read while two
+//    participant actors live is counted by script and line
+//    (report_script_context). The native forms (alife():has_info(0, ...)
+//    behind has_alife_info, alife():actor(), the story object "actor") are not
+//    remapped: they stay the single-player script actor's, recorded as
+//    party/personal state decisions for S08.
+//  - Presentation callbacks: what the server would show a player (the talk
+//    window, news, talk messages, camera and post-process effectors, the
+//    game-over sequence) goes to that participant's presentation outbox; a
+//    client presents locally as before. Stage 4 delivers the outbox.
+//
+// On a client none of this changes behaviour: no context is ever entered,
+// the compatibility layer is not loaded, presentation stays local.
+
+#include "CampaignIdentity.h"
+
+class CActor;
+class CObject;
+class CGameObject;
+class CGameTask;
+class CInventoryOwner;
+class CScriptGameObject;
+struct lua_State;
+
+namespace campaign
+{
+// One entered context.
+struct ScriptContext
+{
+	ActionContext action; // as authorized
+	Scope scope;
+	PartyId party; // the participant's party, from the registry
+	EngineEntityKey actor_key; // the participant's live actor at entry (none allowed for Scope::Party)
+	u32 token;
+	LPCSTR entry; // the native entry point (a static string)
+};
+
+// The context stack over one registry. The process uses one over
+// g_campaign_identity (script_contexts()); the unit fixture builds its own.
+class ScriptContextStack
+{
+public:
+	enum
+	{
+		max_depth = 16,
+		max_captured = 4096,
+	};
+
+	struct Stats
+	{
+		u64 entered;
+		u64 refused;
+		u64 left;
+		u64 leave_mismatch;
+		u64 captured;
+		u64 captured_evicted;
+		u64 captured_entered;
+		u64 captured_refused;
+		u32 max_depth_seen;
+	};
+
+	explicit ScriptContextStack(const CampaignIdentityRegistry* registry);
+
+	// Authorizes the context for the scope and pushes it. Scope::Self needs a
+	// live actor (NoActor); Scope::Identity and Scope::World are not script
+	// contexts (NotAuthoritative).
+	Refusal enter(const ActionContext& context, Scope scope, LPCSTR entry, u32& token);
+	// Pops the innermost context; ContextMismatch for any other token.
+	Refusal leave(u32 token);
+	// The innermost context; NoContext when none.
+	Refusal current(ScriptContext& out) const;
+	u32 depth() const { return u32(m_stack.size()); }
+
+	// Deferred work: the innermost context, recorded under a handle (never 0).
+	Refusal capture(u32& handle);
+	// Re-enters a captured context as server-internal: authorized again, so a
+	// released or rebound participant is refused. NoContext for an unknown or
+	// evicted handle.
+	Refusal enter_captured(u32 handle, LPCSTR entry, u32& token);
+
+	const Stats& stats() const { return m_stats; }
+
+private:
+	struct Captured
+	{
+		u32 handle;
+		ParticipantRef participant;
+		PartyId party;
+		Scope scope;
+	};
+
+	const CampaignIdentityRegistry* m_registry;
+	xr_vector<ScriptContext> m_stack;
+	xr_vector<Captured> m_captured; // oldest first
+	u32 m_next_token;
+	u32 m_next_handle;
+	Stats m_stats;
+};
+
+// The process stack (campaign server only; null elsewhere).
+ScriptContextStack* script_contexts();
+
+// Enters a context on the process stack for the lifetime of the scope and
+// binds the installed scripts' db.actor to its actor (through the server's
+// compatibility layer). On a client, or refused, it enters nothing.
+class ScriptContextScope
+{
+public:
+	ScriptContextScope(const ActionContext& context, Scope scope, LPCSTR entry);
+	// A captured context (deferred work).
+	ScriptContextScope(u32 captured_handle, LPCSTR entry);
+	// The participant the task was given to (NoContext for a task with no
+	// owner: it runs outside any context, counted).
+	ScriptContextScope(const CGameTask* task, LPCSTR entry);
+	// The participant holding this actor (server-internal, Self).
+	ScriptContextScope(const CObject* actor, LPCSTR entry);
+	~ScriptContextScope();
+	Refusal refusal() const { return m_refusal; }
+	bool entered() const { return m_refusal == Refusal::None; }
+
+private:
+	ScriptContextScope(const ScriptContextScope&);
+	ScriptContextScope& operator=(const ScriptContextScope&);
+	Refusal m_refusal;
+	u32 m_token;
+};
+
+// The server's own context for a participant (server-internal, Self, the
+// participant's party). False when the reference is not current.
+bool participant_context(const ParticipantRef& ref, ActionContext& out);
+// ...for the participant holding this actor.
+bool actor_context(const CObject* actor, ActionContext& out);
+
+// Strict lookups: nothing outside a context.
+Refusal current_script_context(ScriptContext& out);
+CActor* script_context_actor(Refusal* why = nullptr);
+// The native bindings' rule: the context's actor; outside a context the
+// single-actor compatibility accessor (null and counted with two actors).
+CActor* gameplay_script_actor(LPCSTR purpose);
+
+// --- tasks ------------------------------------------------------------------
+// The participant a task was given to (CGameTask::m_campaign_owner), set by
+// the script binding give_task on the receiving actor, on the server only.
+void set_task_owner(CGameTask* task, const CObject* receiver);
+// The owner's actor (null when the task has no owner or the owner holds no actor).
+CActor* task_owner_actor(const CGameTask* task);
+// The actor whose Lua binder hosts the installed scripts' callbacks (the
+// single-player script actor); its registered handlers receive owned tasks'
+// state callbacks inside the owner's context.
+CActor* script_host_actor();
+// Counts an owned task's state callback delivered to the script host.
+void note_task_callback_hosted();
+// --- dialogue -----------------------------------------------------------------
+// The server's dialogue entry for a participant actor: OfferTalk/StartTalk,
+// the talk window's script hook (pda.actor_menu_mode(10), which a client's
+// window runs when it shows) inside the participant's context, and a
+// DialogOpen presentation to that participant. Close: actor_menu_mode(11) in
+// the context, StopTalk on both, DialogClose.
+Refusal dialogue_open(CActor* actor, CInventoryOwner* partner, bool disable_break);
+Refusal dialogue_close(CActor* actor, CInventoryOwner* partner);
+
+// --- presentation callbacks -----------------------------------------------------
+enum class Presentation : u8
+{
+	DialogOpen,
+	DialogClose,
+	News,
+	TalkMessage,
+	CameraEffector,
+	CameraEffectorRemove,
+	PostProcess,
+	PostProcessRemove,
+	GameOver,
+	Count,
+};
+
+LPCSTR presentation_name(Presentation kind);
+
+struct PresentationRecord
+{
+	u32 serial;
+	ParticipantRef participant;
+	Presentation kind;
+	u16 object; // the partner, effector id or 0
+	u32 frame;
+	string128 detail;
+};
+
+// To a participant: recorded in its outbox (bounded; the oldest is dropped
+// and counted). StaleReference/UnknownParticipant for a reference that is not
+// current, WrongRole on a client.
+Refusal present(const ParticipantRef& to, Presentation kind, u16 object, LPCSTR detail);
+// To the innermost context's participant; NoContext (dropped, counted) when none.
+Refusal present_to_context(Presentation kind, u16 object, LPCSTR detail);
+// To the participant holding this actor.
+Refusal present_to_actor(const CObject* actor, Presentation kind, u16 object, LPCSTR detail);
+// A copy of the slot's outbox, oldest first.
+u32 presentation_outbox(u8 slot, xr_vector<PresentationRecord>& out);
+u32 presentation_dropped();
+
+// --- Lua ------------------------------------------------------------------------
+// The campaign.* module (both products; inert on a client).
+void script_register_context(lua_State* L);
+// Campaign server, every level frame: installs the compatibility layer in the
+// current Lua state when it is missing and refreshes the db.actor audit flag.
+void script_context_frame();
+// Whether the compatibility layer is installed in the current Lua state.
+bool script_compat_installed();
+// The out-of-context db.actor reads the layer counted (site "script:line",
+// count), most frequent first; the total in `total`.
+u32 script_host_reads(xr_vector<std::pair<shared_str, u32>>& out, u32* total = nullptr);
+// The process stack's lifetime follows the identity service.
+void release_script_contexts();
+
+struct ScriptContextStats
+{
+	u64 lua_actor_calls; // campaign.actor() and friends
+	u64 lua_no_context; // ...outside a context (returned nothing)
+	u64 task_scopes; // task scopes entered (owned tasks)
+	u64 task_unowned; // ...for a task with no owner (ran outside a context)
+	u64 task_callbacks_hosted; // owned tasks' state callbacks delivered to the script host
+	u64 presented;
+	u64 present_no_context;
+	u64 compat_installs;
+	u64 compat_failures;
+	u64 gameplay_context; // gameplay_script_actor answered from a context
+	u64 gameplay_compat; // ...from the compatibility accessor
+};
+
+const ScriptContextStats& script_context_stats();
+// Logs the stack and Lua stats, the outboxes' counts and the out-of-context
+// db.actor reads by site.
+void report_script_context(LPCSTR tag);
+} // namespace campaign
