+double lua_enter_captured(double handle)
+{
+	if (!s_stack || !server_role())
+		return 0;
+	u32 token = 0;
+	const Refusal refusal = s_stack->enter_captured(u32(handle), "deferred", token);
+	if (refusal != Refusal::None)
+	{
+		Msg("S03-T05 deferred script work refused: %s (handle %u)", refusal_name(refusal), u32(handle));
+		return 0;
