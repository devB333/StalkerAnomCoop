+// B55: an actor's handheld flashlight (detector slot) as this client has it
+void flashlight_line(LPCSTR who, CActor* actor, u32 press)
+{
+	PIItem item = actor ? actor->inventory().ItemFromSlot(DETECTOR_SLOT) : nullptr;
+	CFlashlight* light = item ? smart_cast<CFlashlight*>(item) : nullptr;
+	LPCSTR motion = "-";
+	u32 end_tm = 0;
+	bool running = false;
