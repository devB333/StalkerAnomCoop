+// ------------------------------------------------------------ S08-T01
+// Pickup (docs/persistence-contract.md §6 `pickup`). Every pickup path of
+// the engine (the use key on a looked-at item, the COD pickup, a script's
+// make_item_pickup) ends in game_cl_GameState::SendPickUpEvent; on a co-op
+// client it becomes the pickup intent naming the item, and the local event
+// is never sent (the replica's own server would refuse it). What the player
+// then sees is the server's owner change in the lifecycle stream
+// (Reparent). An unanswered request is re-sent every 3 s with the same id,
+// across reconnects. Profile script 7 is the race driver: it claims the
+// fixture's items at the server tick the server names (CampaignEvent 6),
+// then repeats each claim with the same id (the stored outcome comes back)
+// and, after losing, once with a new id (refused again).
+const u64 kPickupTag = 0x91c5ull;
+
+bool pickup_operation(u64 operation) { return (operation >> 48) == kPickupTag; }
+
+void pickup_csv_line(LPCSTR event, u32 round, u32 kind, u64 operation, const coop::proto::EntityRef& target,
+	u32 outcome, u32 reason, u64 commit)
+{
+	if (!g_link->pickup_csv)
+	{
+		string_path path;
+		FS.update_path(path, "$logs$", "coop-pickup-client.csv");
+		g_link->pickup_csv = fopen(path, "w");
+		if (!g_link->pickup_csv)
+			return;
+		fprintf(g_link->pickup_csv,
+			"utc_ms,event,round,kind,operation,target,generation,outcome,reason,commit,server_ms,slot\n");
+	}
+	const double server_ms =
+		g_link->clock.ready() ? g_link->clock.server_now(double(g_link->wall.GetElapsed_ms())) : 0.0;
+	fprintf(g_link->pickup_csv, "%I64u,%s,%d,%d,%I64u,%I64u,%u,%u,%u,%I64u,%.0f,%u\n", utc_now_ms(), event, int(round),
+		int(kind), operation, target.id, target.generation, outcome, reason, commit, server_ms, u32(g_link->local_slot));
+	fflush(g_link->pickup_csv);
+}
+
+bool pickup_send(Link::PickupPending& p, LPCSTR event)
+{
+	coop::proto::ActionIntent intent;
+	intent.operation_id = p.operation;
+	intent.kind = coop::proto::kActionPickup;
+	intent.target = p.target;
+	const bool sent = g_link->client && g_link->client->send(coop::proto::Message(intent));
+	p.sent_ms = g_link->wall.GetElapsed_ms();
+	pickup_csv_line(sent ? event : "unsent", p.round, p.kind, p.operation, p.target, 0, 0, 0);
+	return sent;
+}
+
+u64 request_pickup(const coop::proto::EntityRef& target, u32 round, u32 kind, bool player, LPCSTR why)
+{
+	Link::PickupPending p;
+	p.operation = (kPickupTag << 48) | ((utc_now_ms() & 0xffffffffffull) << 8) | (++g_link->pickup_counter & 0xff);
+	p.target = target;
+	p.round = round;
+	p.kind = kind;
+	p.player = player;
+	p.retries = 0;
+	++g_link->pickup_requests;
+	g_link->pickup_pending.push_back(p);
+	pickup_send(g_link->pickup_pending.back(), "sent");
+	g_link->log.line("pickup-request why=%s operation=%I64x target=%I64u/%u round=%d kind=%d", why, p.operation,
+		target.id, target.generation, int(round), int(kind));
+	return p.operation;
+}
+
+void pickup_message(LPCSTR text)
+{
+	luabind::functor<void> set_msg;
+	if (ai().script_engine().functor("actor_menu.set_msg", set_msg))
+		set_msg(1, text, 3);
+}
+
+void pickup_result(const coop::proto::ActionResult& result)
+{
+	const bool accepted = result.outcome == coop::proto::ActionOutcome::Accepted;
+	Link::PickupRace* race = nullptr;
+	for (Link::PickupRace& r : g_link->pickup_races)
+		if (r.operation == result.operation_id || r.retry_operation == result.operation_id)
+			race = &r;
+	for (auto it = g_link->pickup_pending.begin(); it != g_link->pickup_pending.end(); ++it)
+		if (it->operation == result.operation_id)
+		{
+			const Link::PickupPending p = *it;
+			g_link->pickup_pending.erase(it);
+			if (accepted)
+				++g_link->pickup_accepted;
+			else
+				++g_link->pickup_refused;
+			const bool retry = race && race->retry_operation == result.operation_id;
+			pickup_csv_line(retry ? "retry-new-result" : "result", p.round, p.kind, p.operation, p.target,
+				u32(result.outcome), result.reason, result.commit_id);
+			g_link->log.line("pickup-result operation=%I64x outcome=%u reason=%u commit=%I64u round=%d", p.operation,
+				u32(result.outcome), u32(result.reason), result.commit_id, int(p.round));
+			if (p.player && !accepted)
+				pickup_message(result.reason == coop::proto::kReasonItemTaken ? "Someone else took it." :
+					(result.reason == coop::proto::kReasonOutOfReach ? "Too far to pick up." : "You can't pick that up."));
+			if (race && !retry)
+			{
+				// the same id again: the stored outcome, nothing applied twice
+				Link::PickupPending dup = p;
+				pickup_send(dup, "dup-sent");
+				race->dup_sent = true;
+				if (!accepted && result.reason == coop::proto::kReasonItemTaken && !race->retry_operation)
+					race->retry_operation = request_pickup(p.target, p.round, p.kind, false, "retry-new");
+			}
+			return;
+		}
+	if (race)
+	{
+		pickup_csv_line("dup-result", race->round, race->kind, result.operation_id, race->target, u32(result.outcome),
+			result.reason, result.commit_id);
+		return;
+	}
+	++g_link->pickup_late;
+	pickup_csv_line("late", 0xffffffff, 0xffffffff, result.operation_id, coop::proto::EntityRef(), u32(result.outcome),
+		result.reason, result.commit_id);
+}
+
+void pickup_frame()
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (!g_link->client || g_link->client->state() != coop::session::ClientState::Active || g_link->world != WorldLive)
+		return;
+	for (Link::PickupPending& p : g_link->pickup_pending)
+		if (now - p.sent_ms >= 3000)
+		{
+			++p.retries;
+			++g_link->pickup_retries;
+			pickup_send(p, "retry");
+		}
+}
+
+void on_pickup_round(const coop::proto::CampaignEvent& event)
+{
+	if (g_link->config.script != 7 || event.payload.size() != 22)
+		return;
+	const u8* b = event.payload.data();
+	Link::PickupRace race;
+	race.round = b[0];
+	race.kind = b[1];
+	race.target.id = 0;
+	for (int i = 0; i < 8; ++i)
+		race.target.id |= u64(b[2 + i]) << (8 * i);
+	race.target.generation = 0;
+	for (int i = 0; i < 4; ++i)
+		race.target.generation |= u32(b[10 + i]) << (8 * i);
+	race.claim_tick = 0;
+	for (int i = 0; i < 8; ++i)
+		race.claim_tick |= u64(b[14 + i]) << (8 * i);
+	race.operation = 0;
+	race.retry_operation = 0;
+	race.dup_sent = false;
+	g_link->pickup_races.push_back(race);
+	pickup_csv_line("round", race.round, race.kind, 0, race.target, 0, 0, race.claim_tick);
+	g_link->log.line("pickup-round round=%u kind=%u target=%I64u/%u claim_tick=%I64u", race.round, race.kind,
+		race.target.id, race.target.generation, race.claim_tick);
+}
+
+void run_script7(u32 t)
+{
+	if (!g_link->clock.ready())
