+extern "C" bool __cdecl xrCampaignAuthority_Fixture(LPCSTR name)
+{
+	if (!xr_strcmp(name, "actor-access"))
+		return fixture_actor_access();
+	if (!xr_strcmp(name, "message-policy"))
