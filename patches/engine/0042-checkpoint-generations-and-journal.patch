+		// refuses every later critical intent; a clean stop is requested and
+		// the world keeps running for the transient play already admitted.
+		++g_host->ledger_store_failed;
+		g_host->log.line("ledger-store-failed revision=%I64u operation=%I64u reason=%s", revision, intent.operation_id,
+			persistence->failure());
+		g_host->stop_requested = true;
+		return kActionReasonStoreFailed;
+	}
