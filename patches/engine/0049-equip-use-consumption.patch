+// the actor's condition after it. Absolute post-state throughout, so a
+// replay is idempotent.
+struct UseEffect
+{
+	u8 op; // 1 removed (released), 2 remaining uses, 3 created (definition: section + state), 4 moved out of the actor
+	u64 item_entity;
+	u8 uses; // op 2
+	xr_string section; // op 3
+	std::vector<u8> state; // op 3: CSE_Abstract::Spawn_Write(.., FALSE)
+	u64 owner_entity = 0; // op 4: where it went (0: the ground)
+	float position[3] = {0.f, 0.f, 0.f}; // op 4: where it lay
+};
+struct UseRecord
+{
+	u8 slot;
+	coop::proto::Uuid128 player;
+	u64 operation;
+	u64 actor_entity;
+	u64 item_entity;
+	xr_string section;
+	u8 uses_after; // the item's remaining uses after the use
+	u8 consumed; // 1: used up and released by the engine
+	u64 game_time; // the game time of the use (ms)
+	float health, power, radiation, psy_health, satiety; // the actor after the use
+	std::vector<UseEffect> effects;
+};
+std::vector<u8> encode_use(const UseRecord& r);
+bool decode_use(const std::vector<u8>& payload, UseRecord& out);
