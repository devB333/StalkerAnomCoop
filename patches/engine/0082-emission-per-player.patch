+	"        setup(orig_update, up[n], p['u_' .. n])\n"
+	"      end\n"
+	"      rawset(SMM, 'currentIndik', p.indik)\n"
+	"      lvl.set_weather_fx = noop\n"
+	"      return saved\n"
+	"    end\n"
+	"    local function swap_out(p, saved)\n"
+	"      for _, n in ipairs({ 'prev_sec', 'prev_game_sec', 'currentPPEfactor' }) do\n"
+	"        local _, v = getup(orig_update, up[n])\n"
+	"        p['u_' .. n] = v\n"
+	"        setup(orig_update, up[n], saved[n])\n"
+	"      end\n"
+	"      p.indik = rawget(SMM, 'currentIndik')\n"
+	"      rawset(SMM, 'currentIndik', saved.indik)\n"
+	"      lvl.set_weather_fx = orig_swfx\n"
+	"    end\n"
+	// the end of the surge for one player: what end_surge stops (its sounds,
+	// waves, effectors, indicators), and the kill at the end when it is the fate
+	"    local function pass_end(p, mgr)\n"
+	"      local fate = ui_options.get('alife/event/emission_fate') or 'kill_at_wave'\n"
+	"      if fate == 'kill_at_end' then SMC.kill_all_unhided(p) end\n"
+	"      if p.blowout_sound then xr_sound.stop_sound_looped(AC_ID, 'blowout_rumble') end\n"
+	"      if p.wave_sound then xr_sound.stop_sound_looped(AC_ID, 'blowout_particle_wave_looped') end\n"
+	"      if p.second_message_given then xr_sound.stop_sound_looped(AC_ID, 'surge_earthquake_sound_looped') end\n"
+	"      for k, w in pairs(p.blowout_waves) do if w.effect and w.effect:playing() then w.effect:stop_deffered() end end\n"
+	"      p.blowout_waves = {}\n"
+	"      level.remove_pp_effector(1)\n"
+	"      level.remove_cam_effector(2)\n"
+	"      SMC.displayIndicators(p, 0)\n"
+	"    end\n"
+	"    local function run_pass(mgr, slot, p, ended)\n"
+	"      local tok = campaign.enter_slot(slot)\n"
+	"      if tok == 0 then return end\n"
+	"      local c = context_cover()\n"
+	"      cover_override = c\n"
+	"      local saved = swap_in(p)\n"
+	"      local hp0 = db.actor and db.actor.health or -1\n"
+	"      local ok, err\n"
+	"      if ended then ok, err = pcall(pass_end, p, mgr) else ok, err = pcall(orig_update, p) end\n"
+	"      local hp1 = db.actor and db.actor.health or -1\n"
+	"      local alive = db.actor and db.actor:alive()\n"
+	"      swap_out(p, saved)\n"
+	"      cover_override = nil\n"
+	"      campaign.leave(tok)\n"
+	"      S.emission_passes = S.emission_passes + 1\n"
+	"      if not ok then\n"
+	"        S.emission_errors = S.emission_errors + 1\n"
+	"        if S.emission_errors <= 5 then note('surge-pass-error slot=%d error=%s', slot, tostring(err)) end\n"
+	"      end\n"
+	"      local d = ended and -1 or diff_sec_of(mgr)\n"
+	"      if ended or hp1 < hp0 - 0.0001 or (d % 10 == 0 and d ~= p.noted) or (alive ~= p.alive) then\n"
+	"        p.noted = d\n"
+	"        p.alive = alive\n"
+	"        note('surge-pass slot=%d sec=%d cover=%s health=%.3f hit=%.4f alive=%d hitfactor=%.3f ended=%d',\n"
+	"          slot, d, tostring(c), hp1, math.max(0, hp0 - hp1), alive and 1 or 0, p.hitFactor or 0, ended and 1 or 0)\n"
+	"      end\n"
+	"    end\n"
+	"    SMC.update = function(self, ...)\n"
+	"      if campaign.slot_actor_id(0) < 0 then return orig_update(self, ...) end -- not a serving campaign server\n"
+	"      local here = level.name()\n"
+	"      if here ~= level_name then passes = {} level_name = here end\n"
+	// the world: the schedule, the weather, the NPCs; nobody hurt, nothing shown
+	"      campaign.mute(true)\n"
+	"      cover_override = true\n"
+	"      local r = pack(pcall(orig_update, self, ...))\n"
+	"      cover_override = nil\n"
+	"      campaign.mute(false)\n"
+	"      for _, slot in ipairs(slots_with_actor()) do\n"
+	"        local p = passes[slot]\n"
+	"        local in_world = campaign.slot_in_world(slot)\n"
+	"        if self.started then\n"
+	"          local fresh = not p or p.serial ~= S.surge_serial or not p.active\n"
+	// a player who (re)joins during the surge gets its effects from now on
+	"          if p and in_world and not p.in_world and not fresh then fresh = true S.emission_rejoins = S.emission_rejoins + 1 end\n"
+	"          if fresh then\n"
+	"            p = new_pass(self, slot)\n"
+	"            p.active = true\n"
+	"            passes[slot] = p\n"
+	"            note('surge-pass-start slot=%d sec=%d serial=%d in_world=%d', slot, diff_sec_of(self), S.surge_serial, in_world and 1 or 0)\n"
+	"          end\n"
+	"          p.in_world = in_world\n"
+	"          run_pass(self, slot, p, false)\n"
+	"        elseif p and p.active then\n"
+	"          p.active = false\n"
+	"          run_pass(self, slot, p, true)\n"
+	"        end\n"
+	"      end\n"
+	"      if not r[1] then error(r[2], 0) end\n"
+	"      return unpack(r, 2, r.n)\n"
+	"    end\n"
+	"    S.emission_wrap = 'surge'\n"
+	"    S.wrapped = S.wrapped + 1\n"
+	"  else\n"
+	"    S.emission_wrap = 'surge-no-upvalues'\n"
+	"  end\n"
+	"end\n"
+	// the psi-storm: its vortices come down around each player in turn; a
+	// vortex hits every player near it who is not in cover, in that player's
+	// context (its hit, its post-process)
+	"local ps_ok, PSM = pcall(function() return psi_storm_manager end)\n"
+	"local PSC = ps_ok and type(PSM) == 'table' and (rawget(PSM, 'CPsiStormManager') or rawget(_G, 'CPsiStormManager'))\n"
+	"if PSC and PSC.update and PSC.vortex and PSC.vortex_actor_hit then\n"
+	"  local orig_pupdate, orig_vortex, orig_vhit = PSC.update, PSC.vortex, PSC.vortex_actor_hit\n"
+	"  local turn = 0\n"
+	"  local pending = {}\n"
+	"  PSC.update = function(self, ...)\n"
+	"    if campaign.slot_actor_id(0) < 0 then return orig_pupdate(self, ...) end\n"
+	// the hits of the last second, measured now that they have landed
+	"    for _, h in ipairs(pending) do\n"
+	"      local id = campaign.slot_actor_id(h.slot)\n"
+	"      local o = id >= 0 and level.object_by_id(id)\n"
+	"      local hp1 = o and o.health or -1\n"
+	"      local hit = (o and o:alive()) and math.max(0, h.hp0 - hp1) or (h.hp0 > 0 and h.hp0 or 0)\n"
+	"      if hit > 0.0001 then S.vortex_hits = S.vortex_hits + 1 end\n"
+	"      note('psi-vortex-hit index=%d slot=%d distance=%.1f cover=%s health=%.3f hit=%.4f alive=%d%s', h.index, h.slot,\n"
+	"        h.d, h.cover, hp1, hit, (o and o:alive()) and 1 or 0, h.err)\n"
+	"    end\n"
+	"    pending = {}\n"
+	"    cover_override = false -- every vortex reaches vortex_actor_hit, which asks each player\n"
+	"    local r = pack(pcall(orig_pupdate, self, ...))\n"
+	"    cover_override = nil\n"
+	"    if not r[1] then error(r[2], 0) end\n"
+	"    return unpack(r, 2, r.n)\n"
+	"  end\n"
+	"  PSC.vortex = function(self, ...)\n"
+	"    local slots = slots_with_actor()\n"
+	"    if #slots == 0 then return orig_vortex(self, ...) end\n"
+	"    turn = turn % #slots + 1\n"
+	"    local id = campaign.slot_actor_id(slots[turn])\n"
+	"    S.actor_override = id >= 0 and level.object_by_id(id) or nil\n"
+	"    local r = pack(pcall(orig_vortex, self, ...))\n"
+	"    S.actor_override = nil\n"
+	"    local v = self.vortexes and self.vortexes[self.vortex_index]\n"
+	"    if v and v.particle_pos then\n"
+	"      note('psi-vortex index=%d around=%d pos=%.1f,%.1f,%.1f', self.vortex_index, slots[turn], v.particle_pos.x,\n"
+	"        v.particle_pos.y, v.particle_pos.z)\n"
+	"    end\n"
+	"    if not r[1] then error(r[2], 0) end\n"
+	"    return unpack(r, 2, r.n)\n"
+	"  end\n"
+	"  PSC.vortex_actor_hit = function(self, vortex, ...)\n"
+	"    local index = -1\n"
+	"    for k, v in pairs(self.vortexes or {}) do if v == vortex then index = k end end\n"
+	"    for _, slot in ipairs(slots_with_actor()) do\n"
+	"      local tok = campaign.enter_slot(slot)\n"
+	"      if tok ~= 0 then\n"
+	"        local c = context_cover()\n"
+	"        local hp0 = db.actor and db.actor.health or -1\n"
+	"        local d = db.actor and vortex.particle_pos and distance_2d(db.actor:position(), vortex.particle_pos) or -1\n"
+	"        local ok, err = true, nil\n"
+	"        if not c then ok, err = pcall(orig_vhit, self, vortex, ...) end\n"
