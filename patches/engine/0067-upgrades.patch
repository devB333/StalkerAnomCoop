+// ------------------------------------------------------------ S10-T04f
+// The upgrade window on the server's upgrade session (T04c-3). The remote
+// talk window's upgrade button asks the server to open the session (kind 21);
+// the native upgrade window opens when the table (CampaignEvent 16) arrives
+// and reads it: which items the mechanic upgrades (CUIActorMenu::CanUpgradeItem)
+// and each upgrade's install state (Upgrade::can_install). A click's install
+// (Manager::upgrade_install) and the repair button send the intent (kind 22)
+// instead of running here; CampaignEvent 17 installs the upgrade on this
+// client's copy in loading mode (no charge), the purse comes with the
+// per-player survival event and the condition with the layout.
+void on_upgrade_table(const coop::proto::CampaignEvent& event)
+{
+	const std::vector<u8>& b = event.payload;
+	if (b.size() < 12 + 2 + 4 + 1)
+		return;
+	coop::proto::EntityRef ref;
+	for (int i = 0; i < 8; ++i)
+		ref.id |= u64(b[i]) << (8 * i);
+	for (int i = 0; i < 4; ++i)
+		ref.generation |= u32(b[8 + i]) << (8 * i);
+	PayloadReader r(b);
+	r.at = 12;
+	const u8 part = r.get<u8>();
+	const u8 parts = r.get<u8>();
+	const u32 actor_money = r.get<u32>();
+	const u8 count = r.get<u8>();
+	Link::Upgrade& t = g_link->upgrade;
+	const u16 npc_id = id_of(ref);
+	if (!r.ok || npc_id == 0xffff || !parts || part >= parts)
+		return;
+	++t.table_events;
+	if (part == 0 || t.npc != npc_id)
+	{
+		t.table.clear();
+		t.parts_seen = 0;
+	}
+	u32 unknown = 0, installable = 0;
+	for (u8 i = 0; i < count && r.ok; ++i)
+	{
+		coop::proto::EntityRef item_ref;
+		item_ref.id = r.get<u64>();
+		item_ref.generation = r.get<u32>();
+		Link::Upgrade::Item entry;
+		entry.can_upgrade = r.get<u8>();
+		const u8 n = r.get<u8>();
+		for (u8 k = 0; k < n && r.ok; ++k)
+		{
+			string256 id;
+			r.str(id, sizeof(id));
+			const u8 result = r.get<u8>();
+			const u32 cost = r.get<u32>();
+			if (!r.ok)
+				break;
+			entry.ups[shared_str(id)] = std::make_pair(result, cost);
+			if (result == 0)
+				++installable;
+		}
+		if (!r.ok)
+			break;
+		const u16 item = id_of(item_ref);
+		if (item == 0xffff)
+		{
+			++unknown;
+			continue;
+		}
+		t.table[item] = entry;
+	}
+	t.npc = npc_id;
+	t.npc_ref = ref;
+	t.actor_money = actor_money;
+	++t.parts_seen;
+	if (part + 1 < parts)
+		return;
+	t.pending_open = false;
+	t.pending = false;
+	if (g_actor && g_actor->get_money() != actor_money)
+		g_actor->set_money(actor_money, false);
+	CInventoryOwner* partner = smart_cast<CInventoryOwner*>(Level().Objects.net_Find(npc_id));
+	g_link->log.line("upgrade-table npc=%u parts=%u items=%u installable=%u unknown=%u money=%u open=%d", u32(npc_id),
+		u32(parts), u32(t.table.size()), installable, unknown, actor_money, t.open ? 1 : 0);
+	CUIGameSP* ui = smart_cast<CUIGameSP*>(CurrentGameUI());
+	if (t.open)
+	{
+		if (ui)
+			ui->GetActorMenu().CoopUpgradeRefresh();
+		return;
+	}
+	if (!partner || !ui || !g_actor)
+	{
+		g_link->log.line("upgrade-open-failed npc=%u partner=%d ui=%d", u32(npc_id), partner ? 1 : 0, ui ? 1 : 0);
+		request_ownership(coop::proto::kActionUpgradeClose, ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, false, "unshowable");
+		return;
+	}
+	t.open = true;
+	t.opened_ms = g_link->wall.GetElapsed_ms();
+	++t.opens;
+	{
+		// the installed Lua window (ui_inventory.script, repair mode) evaluates the
+		// upgrades with get_speaker(), i.e. the used_npc_id event a USE sets
+		luabind::functor<void> put;
+		if (ai().script_engine().functor("_G.SetEvent", put))
+			put("used_npc_id", u32(npc_id));
+	}
+	ui->StartUpgrade(smart_cast<CInventoryOwner*>(g_actor), partner);
+	g_link->log.line("upgrade-open npc=%u name=%s mode=%d", u32(npc_id), partner->Name(), int(ui->GetActorMenu().GetMenuMode()));
+}
