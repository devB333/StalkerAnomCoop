+void install_party_adapter()
+{
+	if (g_host->party_adapter)
+		return;
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return;
+	if (luaL_loadbuffer(L, party_source, xr_strlen(party_source), "campaign_party") != 0 || lua_pcall(L, 0, 0, 0) != 0)
+	{
+		g_host->log.line("party-adapter-failed error=%s", lua_tostring(L, -1));
+		lua_pop(L, 1);
+		return;
+	}
+	g_host->party_adapter = true;
+	luabind::object P = luabind::get_globals(L)["__campaign_party"];
+	const int wrapped = P.type() == LUA_TTABLE && luabind::object(P["wrapped"]).type() == LUA_TNUMBER ?
+		luabind::object_cast<int>(P["wrapped"]) : -1;
+	g_host->log.line("party-adapter installed wrapped=%d", wrapped);
+}
