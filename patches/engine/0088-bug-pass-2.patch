+bool object_map_place(u16 object, Fvector& position, xr_string& level, u16& graph)
+{
+	position.set(0.f, 0.f, 0.f);
+	level = "";
+	graph = u16(-1);
+	if (object == u16(-1) || !g_pGameLevel)
+		return false;
+	if (CGameObject* o = smart_cast<CGameObject*>(Level().Objects.net_Find(object)))
+	{
+		position = o->Position();
+		level = *Level().name();
+		graph = o->ai_location().game_vertex_id();
+		return true;
+	}
+	if (!ai().get_alife())
+		return false;
+	CSE_ALifeDynamicObject* se = ai().alife().objects().object(object, true);
+	if (!se)
+		return false;
+	position = se->draw_level_position();
+	graph = se->m_tGraphID;
+	if (ai().get_game_graph() && ai().game_graph().valid_vertex_id(graph))
+		level = *ai().game_graph().header().level(ai().game_graph().vertex(graph)->level_id()).name();
+	else
+		level = *Level().name();
+	return true;
+}
