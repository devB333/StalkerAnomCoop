+// --- unit fixture ---------------------------------------------------------------
+
+struct UnitCheck
+{
+	u32 checks = 0;
+	u32 failures = 0;
+
+	bool check(bool condition, LPCSTR what)
+	{
+		++checks;
+		if (!condition)
+		{
+			++failures;
+			Msg("! S03-T05 script-context-fixture failed: %s", what);
+		}
+		return condition;
+	}
+
+	bool expect(Refusal observed, Refusal expected, LPCSTR what)
+	{
+		++checks;
+		if (observed != expected)
+		{
+			++failures;
+			Msg("! S03-T05 script-context-fixture failed: %s: expected %s, observed %s", what, refusal_name(expected),
+				refusal_name(observed));
+		}
+		return observed == expected;
+	}
+};
+
+bool unit_fixture()
+{
+	UnitCheck f;
+	CampaignIdentityRegistry registry(Role::Server);
+	registry.on_server_incarnation();
+	const ServerAuthority* authority = registry.authority();
+	const EngineEntityKey k1 = registry.on_engine_id_assigned(10);
+	const EngineEntityKey k2 = registry.on_engine_id_assigned(11);
+	ParticipantRef p1, p2;
+	f.expect(registry.bind_participant(authority, player_id(1), party_id(1), 1, p1), Refusal::None, "bind player 1");
+	f.expect(registry.bind_participant(authority, player_id(2), party_id(1), 2, p2), Refusal::None, "bind player 2");
+	f.expect(registry.bind_actor(authority, p1, k1), Refusal::None, "actor 10 is participant 1's");
+	f.expect(registry.bind_actor(authority, p2, k2), Refusal::None, "actor 11 is participant 2's");
+	f.expect(registry.attach_session(authority, p2, 7, 3), Refusal::None, "session 7 attaches to participant 2");
+	f.expect(registry.set_bridge_session(authority, 5), Refusal::None, "session 5 is the bridge");
+
+	ScriptContextStack stack(&registry);
+	ScriptContext c;
+	u32 t1 = 0, t2 = 0, t3 = 0, h1 = 0, h2 = 0;
+	const ActionContext ctx1 = make_context(Origin::ServerInternal, 0, p1, party_id(1));
+	const ActionContext ctx2 = make_context(Origin::ClientIntent, 7, p2, party_id(1));
+
+	f.expect(stack.current(c), Refusal::NoContext, "an empty stack has no context");
+	f.expect(stack.capture(h1), Refusal::NoContext, "nothing to capture outside a context");
+	f.check(h1 == 0, "no handle outside a context");
+
+	// Nesting: the innermost context is current; only it may leave.
+	f.expect(stack.enter(ctx1, Scope::Self, "unit-1", t1), Refusal::None, "the server enters participant 1's context");
+	f.expect(stack.current(c), Refusal::None, "a context is current");
+	f.check(c.action.actor == p1 && c.actor_key == k1 && c.party == party_id(1), "...participant 1, actor 10, party 1");
+	f.expect(stack.enter(ctx2, Scope::Self, "unit-2", t2), Refusal::None,
+		"participant 2's session enters participant 2's context inside it");
+	f.expect(stack.current(c), Refusal::None, "the nested context is current");
+	f.check(c.action.actor == p2 && c.actor_key == k2 && c.action.origin == Origin::ClientIntent,
+		"...participant 2, actor 11, a client intent");
+	f.check(stack.depth() == 2, "depth 2");
+	f.expect(stack.leave(t1), Refusal::ContextMismatch, "the outer context cannot leave first");
+	f.check(stack.depth() == 2, "a refused leave pops nothing");
+	f.expect(stack.leave(t2), Refusal::None, "the inner context leaves");
+	f.expect(stack.current(c), Refusal::None, "the outer context is current again");
+	f.check(c.action.actor == p1 && c.actor_key == k1, "...participant 1's again");
+	f.expect(stack.capture(h1), Refusal::None, "participant 1's context is captured");
+	f.check(h1 != 0, "...under a handle");
+	f.expect(stack.leave(t1), Refusal::None, "the outer context leaves");
+	f.expect(stack.current(c), Refusal::NoContext, "no context after both left");
+	f.expect(stack.leave(t1), Refusal::NoContext, "leaving an empty stack is refused");
+
+	// Refusals: nothing is entered.
+	f.expect(stack.enter(make_context(Origin::ClientIntent, 7, p1, party_id(1)), Scope::Self, "forged", t3),
+		Refusal::NotAuthoritative, "participant 2's session cannot name participant 1");
+	f.expect(stack.enter(make_context(Origin::ClientIntent, 99, p2, party_id(1)), Scope::Self, "unknown", t3),
+		Refusal::UnknownSession, "an unknown session enters nothing");
+	f.expect(stack.enter(make_context(Origin::ClientIntent, 5, p2, party_id(1)), Scope::Self, "bridge", t3),
+		Refusal::BridgeNotParticipant, "the bridge is not a participant");
+	f.expect(stack.enter(ctx1, Scope::World, "world", t3), Refusal::NotAuthoritative,
+		"world scope is not a participant script context");
+	f.expect(stack.enter(ctx1, Scope::Identity, "identity", t3), Refusal::NotAuthoritative,
+		"identity scope is not a participant script context");
+	f.expect(stack.enter(make_context(Origin::ServerInternal, 0, p1, party_id(2)), Scope::Party, "party", t3),
+		Refusal::WrongParty, "a party context names the participant's party");
+	ParticipantRef stale = p2;
+	++stale.generation;
+	f.expect(stack.enter(make_context(Origin::ServerInternal, 0, stale, party_id(1)), Scope::Self, "stale", t3),
+		Refusal::StaleReference, "a stale reference enters nothing");
+	f.check(stack.depth() == 0 && t3 == 0, "no refused entry pushed a context or returned a token");
+
+	// Party scope needs no actor; Self does.
+	f.expect(stack.enter(make_context(Origin::ServerInternal, 0, p1, party_id(1)), Scope::Party, "party", t3),
+		Refusal::None, "the right party enters");
+	f.expect(stack.leave(t3), Refusal::None, "...and leaves");
+	registry.on_engine_id_freed(11);
+	f.expect(stack.enter(ctx2, Scope::Self, "no-actor", t3), Refusal::NoActor,
+		"a participant without a live actor has no Self context");
+	f.expect(stack.enter(make_context(Origin::ServerInternal, 0, p2, party_id(1)), Scope::Party, "party", t3),
+		Refusal::None, "...but a Party one");
+	f.expect(stack.current(c), Refusal::None, "the party context is current");
+	f.check(c.actor_key.id == kNoEngineId, "...with no actor");
+	f.expect(stack.leave(t3), Refusal::None, "...and leaves");
+
+	// Capture and re-entry: authorized again, as the server.
+	const EngineEntityKey k3 = registry.on_engine_id_assigned(12);
+	f.expect(registry.bind_actor(authority, p2, k3), Refusal::None, "actor 12 is participant 2's");
+	f.expect(stack.enter(ctx2, Scope::Self, "unit-2b", t2), Refusal::None, "participant 2's context again");
+	f.expect(stack.capture(h2), Refusal::None, "captured");
+	f.expect(stack.leave(t2), Refusal::None, "left");
+	f.check(h2 != 0 && h2 != h1, "a new handle");
+	f.expect(stack.enter_captured(h2, "deferred", t3), Refusal::None, "the captured context re-enters");
+	f.expect(stack.current(c), Refusal::None, "it is current");
+	f.check(c.action.actor == p2 && c.actor_key == k3 && c.action.origin == Origin::ServerInternal && c.action.session == 0,
+		"...participant 2, actor 12, re-entered as server-internal");
+	f.expect(stack.leave(t3), Refusal::None, "and leaves");
+	f.expect(registry.release_participant(authority, p2, 9), Refusal::None, "participant 2 is released");
+	const Refusal released = stack.enter_captured(h2, "deferred", t3);
+	f.check(released != Refusal::None && t3 == 0, "a released participant's captured context is refused");
+	Msg("S03-T05 script-context-fixture released participant's capture: %s", refusal_name(released));
+	f.expect(stack.enter_captured(h1, "deferred", t3), Refusal::None, "participant 1's capture still re-enters");
+	f.expect(stack.leave(t3), Refusal::None, "and leaves");
+	f.expect(stack.enter_captured(12345, "deferred", t3), Refusal::NoContext, "an unknown handle is no context");
+
+	// Depth bound.
+	u32 tokens[ScriptContextStack::max_depth];
+	bool all = true;
+	for (u32 i = 0; i < ScriptContextStack::max_depth; ++i)
+		all = stack.enter(ctx1, Scope::Self, "depth", tokens[i]) == Refusal::None && all;
+	f.check(all, "sixteen nested contexts enter");
+	f.expect(stack.enter(ctx1, Scope::Self, "depth", t3), Refusal::NotAuthoritative, "a seventeenth is refused");
+	for (u32 i = ScriptContextStack::max_depth; i > 0; --i)
+		all = stack.leave(tokens[i - 1]) == Refusal::None && all;
+	f.check(all && stack.depth() == 0, "and all leave in order");
+
+	// A client registry authorizes nothing.
+	CampaignIdentityRegistry client(Role::Client);
+	client.on_server_incarnation();
+	ScriptContextStack client_stack(&client);
+	f.expect(client_stack.enter(ctx1, Scope::Self, "client", t3), Refusal::WrongRole, "a client stack enters nothing");
+
+	const ScriptContextStack::Stats& st = stack.stats();
+	f.check(st.entered == st.left, "every entered context left");
+	f.check(st.leave_mismatch == 2, "two refused leaves counted");
+	f.check(st.captured == 2 && st.captured_entered == 2 && st.captured_refused == 2,
+		"captures: 2 taken, 2 re-entered, 2 refused");
+	Msg("S03-T05 script-context-fixture checks=%u failures=%u entered=%I64u refused=%I64u max_depth=%u", f.checks,
+		f.failures, st.entered, st.refused, st.max_depth_seen);
+	return f.failures == 0;
+}
