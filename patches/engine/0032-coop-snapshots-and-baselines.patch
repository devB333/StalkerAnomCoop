+// S06-T02: how many animation blends the object's skeleton is playing
+// (summed over its bone parts); 0 is the bind pose (the "T-pose").
+u32 animation_blends(CObject* object)
+{
+	IKinematicsAnimated* ka = object && object->Visual() ? smart_cast<IKinematicsAnimated*>(object->Visual()) : nullptr;
+	if (!ka)
+		return 0;
+	u32 n = 0;
+	for (u32 part = 0; part < 4; ++part)
+		n += ka->LL_PartBlendsCount(part);
+	return n;
+}
+
+CAI_Stalker* nearest_npc_stalker(float range)
+{
+	if (!g_actor)
+		return nullptr;
+	CAI_Stalker* best = nullptr;
+	float best_d = range;
+	CObjectList& objects = Level().Objects;
+	for (u32 i = 0, n = objects.o_count(); i < n; ++i)
+	{
+		CAI_Stalker* s = smart_cast<CAI_Stalker*>(objects.o_get_by_iterator(i));
+		if (!s || !s->g_Alive())
+			continue;
+		const float d = s->Position().distance_to(g_actor->Position());
+		if (d < best_d)
+		{
+			best_d = d;
+			best = s;
+		}
+	}
+	return best;
+}
