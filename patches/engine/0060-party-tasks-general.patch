+static s32 task_fixture_stage(CActor* holder)
+{
+	s32 stage = -1;
+	campaign::ScriptContextScope scope(static_cast<const CObject*>(holder), "fixture-task");
+	if (scope.entered())
+		lua_call_ok("campaign_party_check", stage, kTaskFixtureId);
+	return stage;
