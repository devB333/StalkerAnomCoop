+// S10-T02c: see CControllerPsyHit (decision T02c-1)
+void coop_server_psy_hit(u16 controller, u16 target, u8 phase, float health)
+{
+	if (!g_host || !g_host->started)
+		return;
+	if (phase < 8)
+		++g_host->psy_events[phase];
+	ParticipantRef who;
+	const bool participant = g_campaign_identity && g_campaign_identity->participant_of_engine_id(target, who) == Refusal::None;
+	if ((phase == 3 || phase == 7) && participant && who.slot < 2)
+		++g_host->psy_hits_on[who.slot];
+	g_host->log.line("psy-hit controller=%u target=%u slot=%d phase=%u health=%.3f", u32(controller), u32(target),
+		participant ? int(who.slot) : -1, u32(phase), health);
+}
