+// S10-T04a: see the talk section above.
+bool coop_client_talk_start(CInventoryOwner* partner)
+{
+	if (!g_link || !g_link->active)
+		return false;
+	Link::Talk& t = g_link->talk;
+	++t.starts;
+	if (g_link->world != WorldLive || !g_actor)
+		return true; // nothing talks locally on a replica
+	CGameObject* go = smart_cast<CGameObject*>(partner);
+	coop::proto::EntityRef ref;
+	if (!go || !ref_of(u16(go->ID()), ref))
+	{
+		g_link->log.line("talk-start-unknown npc=%u", go ? u32(go->ID()) : 0xffffu);
+		return true;
+	}
+	if (t.open || t.pending)
+	{
+		g_link->log.line("talk-start-ignored npc=%u open=%d pending=%d", u32(go->ID()), t.open ? 1 : 0, t.pending ? 1 : 0);
+		return true;
+	}
+	t.pending = true;
+	t.npc = u16(go->ID());
+	t.npc_ref = ref;
+	request_ownership(coop::proto::kActionTalkStart, ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, true, "player");
+	return true;
+}
+
+void coop_client_talk_say(LPCSTR id)
+{
+	if (!g_link || !g_link->active || !g_link->talk.open || !id || !id[0])
