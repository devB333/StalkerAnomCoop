+// How long a use's animation keeps the weapon down: the installed timeline
+// (configs/plugins/actor_effects.ltx, actor_effects.play_item_fx), keys in
+// ms: the key that raises the weapon again (actor_effects.use_weapon(1)),
+// else the timeline's last key; 0 when the item has no timeline or the
+// timeline does not lower the weapon.
+u32 use_fx_window_ms(LPCSTR section)
+{
+	static CInifile* timelines = nullptr;
+	if (!timelines)
+	{
+		string_path path;
+		FS.update_path(path, "$game_config$", "plugins\\actor_effects.ltx");
+		timelines = xr_new<CInifile>(path, TRUE, TRUE, FALSE);
+	}
+	if (!section || !timelines->section_exist(section))
+	{
+		g_host->log.line("use-fx-window section=%s file_sections=%u found=0", section ? section : "-",
+			u32(timelines->sections().size()));
+		return 0;
+	}
+	u32 last = 0, raise = 0;
+	bool lowers = false;
+	const u32 n = timelines->line_count(section);
+	for (u32 i = 0; i < n; ++i)
+	{
+		LPCSTR key = nullptr, value = nullptr;
+		if (!timelines->r_line(section, int(i), &key, &value) || !key || !value)
+			continue;
+		char* end = nullptr;
+		const unsigned long ms = strtoul(key, &end, 10);
+		if (end == key)
+			continue;
+		last = _max(last, u32(ms));
+		if (strstr(value, "use_weapon(0)"))
+			lowers = true;
+		if (strstr(value, "use_weapon(1)"))
+			raise = _max(raise, u32(ms));
+	}
+	return lowers ? (raise ? raise : last) : 0;
+}
