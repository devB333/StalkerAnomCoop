+void park_set(PlayerLink& link, CActor* actor, bool park, LPCSTR why)
+{
+	const u16 id = park ? u16(actor->ID()) : link.parked_actor;
+	CActor* a = park ? actor : smart_cast<CActor*>(Level().Objects.net_Find(id));
+	if (a)
+	{
+		if (park)
+			a->spatial.type &= ~STYPE_VISIBLEFORAI;
+		else
+			a->spatial.type |= STYPE_VISIBLEFORAI;
+	}
+	campaign::set_participant_parked(id, park);
+	link.parked = park;
+	link.parked_actor = park ? id : 0xffff;
+	if (park)
+		++link.parks;
+	g_host->log.line("%s slot=%u actor=%u why=%s away_ms=%u health=%.3f", park ? "parked" : "unparked", u32(link.ref.slot),
+		u32(id), why, link.absent_since_ms ? g_host->wall.GetElapsed_ms() - link.absent_since_ms : 0,
+		a ? a->conditions().GetHealth() : -1.f);
+}
+
+void park_tick()
+{
+	const u32 now = g_host->wall.GetElapsed_ms();
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound)
+			continue;
+		if (link.session)
+		{
+			link.absent_since_ms = 0;
+			if (link.parked && client_in_world(link))
+				park_set(link, nullptr, false, "back-in-world");
+			continue;
+		}
+		if (!link.absent_since_ms)
+			link.absent_since_ms = now ? now : 1;
+		if (link.parked || now - link.absent_since_ms < kParkAfterMs)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		if (actor && actor->g_Alive())
+			park_set(link, actor, true, "away-5-minutes");
+	}
+}
