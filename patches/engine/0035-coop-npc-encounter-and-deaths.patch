+// A death the server reported, shown with the native death (the body falls,
+// the death sound; the own actor's death camera). The server ran its
+// consequences; on a replica CEntityAlive::Die skips the scripts' death
+// callbacks, relations and the killer record, and CActor::Die the
+// single-player game over. The killer is not replicated: the body names
+// itself.
+bool present_death(CEntityAlive* body)
+{
+	if (!body->g_Alive())
+		return false;
+	body->Die(body);
+	++g_link->deaths_presented;
+	g_link->log.line("death-presented id=%u section=%s own=%d pos=%.2f,%.2f,%.2f", u32(body->ID()),
+		body->cNameSect().c_str(), body == g_actor ? 1 : 0, VPUSH(body->Position()));
+	return true;
+}
