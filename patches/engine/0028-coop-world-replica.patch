+bool make_spawn(u16 id, CSE_Abstract* entity, const coop::proto::EntityRef& ref, coop::proto::Spawn& out)
+{
+	NET_Packet packet;
+	entity->Spawn_Write(packet, TRUE);
+	if (packet.B.count > coop::proto::kMaxSpawnState)
+	{
+		if (++g_host->spawn_oversize <= 16)
+			g_host->log.line("spawn-oversize id=%u section=%s bytes=%u", u32(id), *entity->s_name, packet.B.count);
+		return false;
+	}
+	const Fvector& p = entity->o_Position;
+	if (!_valid(p) || _abs(p.x) > coop::proto::kMaxCoord || _abs(p.y) > coop::proto::kMaxCoord ||
+		_abs(p.z) > coop::proto::kMaxCoord)
+	{
+		++g_host->spawn_unencodable;
+		return false;
+	}
+	out = coop::proto::Spawn{};
+	out.entity = ref;
+	out.archetype = archetype_of(*entity->s_name);
+	out.level = u16(ai().level_graph().level_id());
+	out.transform.x = p.x;
+	out.transform.y = p.y;
+	out.transform.z = p.z;
+	out.transform.yaw = angle_normalize_signed(entity->o_Angle.y);
+	if (entity->ID_Parent != 0xffff)
+		entity_ref_of(entity->ID_Parent, out.parent);
+	out.state.assign(packet.B.data, packet.B.data + packet.B.count);
+	return true;
+}
+
+void track_lifecycle()
+{
+	if (!g_pGameLevel || !ai().get_alife() || !Level().Server)
+		return;
+	xr_map<u16, coop::proto::EntityRef> now;
+	CObjectList& objects = Level().Objects;
+	for (u32 i = 0, n = objects.o_count(); i < n; ++i)
+	{
+		CObject* object = objects.o_get_by_iterator(i);
+		if (!object || object->getDestroy())
+			continue;
+		const u16 id = u16(object->ID());
+		if (!ai().alife().objects().object(id, true))
+			continue; // transient non-ALife objects (bolts, projectiles): Stage 6
+		coop::proto::EntityRef ref;
+		if (entity_ref_of(id, ref))
+			now[id] = ref;
+	}
+	// Despawns first, children before their parents.
+	xr_vector<std::pair<u32, u16>> gone;
+	for (const auto& p : g_host->published)
+	{
+		const auto it = now.find(p.first);
+		if (it == now.end() || !(it->second == p.second.ref))
+			gone.push_back({depth_of(p.first), p.first});
+	}
+	std::sort(gone.begin(), gone.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+	for (const auto& g : gone)
+	{
+		const Published& old = g_host->published[g.second];
+		coop::proto::EntityRef current;
+		const bool same_entity = entity_ref_of(g.second, current) && current.id == old.ref.id &&
+			ai().alife().objects().object(g.second, true);
+		coop::proto::Despawn d;
+		d.entity = old.ref;
+		d.reason = same_entity ? coop::proto::DespawnReason::OutOfRange : coop::proto::DespawnReason::Destroyed;
+		d.commit_id = ++g_host->commit;
+		queue_event(coop::proto::Message(d));
+		if (same_entity)
+			++g_host->despawns_range;
+		else
+			++g_host->despawns_destroyed;
+		lifecycle_csv("despawn", g.second, old.ref, u32(d.reason), *old.section, Fvector().set(0, 0, 0));
+		g_host->published.erase(g.second);
+	}
+	// Spawns, parents before their children.
+	xr_vector<std::pair<u32, u16>> fresh;
+	for (const auto& n : now)
+		if (!g_host->published.count(n.first))
+			fresh.push_back({depth_of(n.first), n.first});
+	std::sort(fresh.begin(), fresh.end());
+	for (const auto& f : fresh)
+	{
+		CSE_Abstract* entity = Level().Server->ID_to_entity(f.second);
+		if (!entity)
+			continue;
+		coop::proto::Spawn spawn;
+		Published published;
+		published.ref = now[f.second];
+		published.section = entity->s_name;
+		if (!make_spawn(f.second, entity, published.ref, spawn))
+		{
+			// not representable: published anyway so it is not retried every
+			// tick; the clients keep their checkpoint copy (if any) offline
+			g_host->published[f.second] = published;
+			continue;
+		}
+		spawn.commit_id = ++g_host->commit;
+		queue_event(coop::proto::Message(spawn));
+		++g_host->spawns;
+		lifecycle_csv("spawn", f.second, published.ref, 0, *entity->s_name, entity->o_Position);
+		g_host->published[f.second] = published;
+	}
+}
+
+void flush_outbox(PlayerLink& link)
+{
+	while (!link.outbox.empty())
+	{
+		coop::net::ChannelBacklog backlog;
+		if (!g_host->server->backlog(link.player, coop::proto::kLifecycle, backlog))
+			return;
+		if (backlog.queued_bytes + backlog.unacked_bytes > kLifecycleBacklogLimit)
+			return;
+		if (!g_host->server->send(link.player, link.outbox.front()))
+			return;
+		link.outbox.pop_front();
+		++link.events_sent;
+	}
+}
