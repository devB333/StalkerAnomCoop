index 7c729f9..1e222c6 100644
--- a/src/xrGame/CampaignServerStart.cpp
+++ b/src/xrGame/CampaignServerStart.cpp
@@ -8,6 +8,7 @@
 // client game state, spawn queue) and the first server ticks.
 
 #include "Level.h"
+#include "CampaignActivityPolicy.h"
 #include "xrServer.h"
 #include "ai_space.h"
 #include "alife_simulator.h"
@@ -44,6 +45,8 @@ extern "C" bool __cdecl xrCampaignLevel_Start(LPCSTR op_server, LPCSTR op_client
 	if (!g_pGameLevel)
 		return false;
 	pApp->LoadBegin();
+	// S02-T04c: anchors replace the camera for the whole life of the level.
+	CampaignActivityPolicyEnable();
 	g_pGamePersistent->Start(op_server);
 	const bool queued = g_pGameLevel->net_Start(op_server, op_client);
 	pApp->LoadEnd();
@@ -122,6 +125,38 @@ extern "C" void __cdecl xrCampaignLevel_Stop()
 		DEL_INSTANCE(g_pGameLevel);
 	}
 	g_pGamePersistent->Disconnect();
+	CampaignActivityPolicyDisable();
+}
+
+// S02-T04c: one anchor per alive actor on the level. With the saved actor
+// that is one anchor; a second participant (Stage 3) adds its own.
+void CampaignActivityPolicyEnable()
+{
+	g_activity_policy.anchors.clear();
+	g_activity_policy.enabled = true;
+}
+
+void CampaignActivityPolicyDisable()
+{
+	g_activity_policy.enabled = false;
+	g_activity_policy.anchors.clear();
+}
+
+void CampaignActivityRefreshAnchors()
+{
+	g_activity_policy.anchors.clear();
+	if (!g_pGameLevel)
+		return;
+	CLevel& level = Level();
+	for (u32 i = 0; i < level.Objects.o_count(); ++i)
+	{
+		CObject* object = level.Objects.o_get_by_iterator(i);
+		if (object->getDestroy())
+			continue;
+		CActor* actor = smart_cast<CActor*>(object);
+		if (actor && actor->g_Alive())
+			g_activity_policy.anchors.push_back(actor->Position());
+	}
 }
 
