+void install_item_adapter()
+{
+	if (g_host->item_adapter)
+		return;
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return;
+	if (luaL_loadbuffer(L, item_source, xr_strlen(item_source), "campaign_items") != 0 || lua_pcall(L, 0, 0, 0) != 0)
+	{
+		g_host->log.line("item-adapter-failed error=%s", lua_tostring(L, -1));
+		lua_pop(L, 1);
+		return;
+	}
+	g_host->item_adapter = true;
+	luabind::object P = luabind::get_globals(L)["__campaign_items"];
+	auto num = [&](LPCSTR k) {
+		return P.type() == LUA_TTABLE && luabind::object(P[k]).type() == LUA_TNUMBER ?
+			luabind::object_cast<int>(P[k]) : -1;
+	};
+	const int booster = booster_upvalue(L);
+	g_host->log.line("item-adapter installed fx_wrapped=%d booster_wrapped=%d", num("fx_wrapped"), booster > 0 ? 1 : 0);
+	if (!booster)
+		booster_diag("install");
+}
