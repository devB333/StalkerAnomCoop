+// ------------------------------------------------------------ S10-T04c: trade
+// The trade window on the server's trade (decision T01-7: each player's
+// money is theirs, one stock, one buyer at a time inside the one-speaker
+// talk). Opened by ActionIntent 18 inside the player's open talk with the
+// trader: the server starts the engine's trade session for this buyer in
+// his context (CTrade::StartTradeEx on the trader: the installed
+// trade_manager sets the trader's buy and sell conditions for him), prices
+// every item of the trader's stock and of the buyer's inventory with
+// CTrade::GetItemPrice as the window would, and sends the table as
+// CampaignEvent 15 (the trader's ref, u8 part, u8 parts, u32 the buyer's
+// money, u32 the trader's, u8 count, count x (u8 side: 0 the trader's item,
+// 1 the buyer's; ref; u32 price)); the client opens the native window and
+// its prices read that table. A trade (19: the bought and the sold item
+// refs) is re-priced here, checked (the owners, the purse), journaled as one
+// `trade` record (the item moves as transfer records plus both purses)
+// before CTrade::TransferItem applies it (the engine's own path: the
+// trader's callbacks, GE_TRADE_SELL/BUY on the server's level; the parent
+// changes reach the clients as Reparent), then answered; the table is sent
+// again (the stock changed). 20 closes the trade; the talk's end closes it.
+const u32 kTradePerEvent = 56; // 12 + 2 + 8 + 1 + 56 x 17 = 975 bytes
+
+static void put_entity_ref(std::vector<u8>& p, const coop::proto::EntityRef& ref)
+{
+	for (int b = 0; b < 8; ++b)
+		p.push_back(u8(ref.id >> (8 * b)));
+	put_u32(p, ref.generation);
+}
+
+static CInventoryOwner* trade_partner(const PlayerLink& link, CGameObject** object = nullptr)
+{
+	CGameObject* npc = link.trade_npc != 0xffff ? smart_cast<CGameObject*>(Level().Objects.net_Find(link.trade_npc)) :
+		nullptr;
+	if (object)
+		*object = npc;
+	return npc ? smart_cast<CInventoryOwner*>(npc) : nullptr;
+}
+
+// the price table to the player (in his context: the trader's conditions for him)
+static void trade_send_prices(PlayerLink& link, LPCSTR why)
+{
+	CGameObject* npc = nullptr;
+	CInventoryOwner* trader = trade_partner(link, &npc);
+	CActor* actor = participant_actor(link.ref);
+	CInventoryOwner* me = actor ? smart_cast<CInventoryOwner*>(actor) : nullptr;
+	if (!trader || !me)
+		return;
+	struct Entry
+	{
+		u8 side;
+		coop::proto::EntityRef ref;
+		u32 price;
+	};
+	xr_vector<Entry> entries;
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "trade-prices");
+		CTrade* trade = trader->GetTrade();
+		if (!trade)
+			return;
+		trade->StartTradeEx(me);
+		TIItemContainer stock, mine;
+		trader->inventory().AddAvailableItems(stock, true);
+		me->inventory().AddAvailableItems(mine, true);
+		for (CInventoryItem* item : stock)
+		{
+			Entry e;
+			e.side = 0;
+			if (!entity_ref_of(item->object().ID(), e.ref))
+				continue;
+			e.price = trade->GetItemPrice(item, false, false); // the trader sells it
+			entries.push_back(e);
+		}
+		for (CInventoryItem* item : mine)
+		{
+			Entry e;
+			e.side = 1;
+			if (!entity_ref_of(item->object().ID(), e.ref))
+				continue;
+			e.price = trade->GetItemPrice(item, true, false); // the trader buys it
+			entries.push_back(e);
+		}
+	}
+	const u32 parts = _max(1u, u32((entries.size() + kTradePerEvent - 1) / kTradePerEvent));
+	for (u32 part = 0; part < parts; ++part)
+	{
+		std::vector<u8> p;
+		put_ref(p, link.trade_npc);
+		put_u8(p, u8(part));
+		put_u8(p, u8(parts));
+		put_u32(p, actor->get_money());
+		put_u32(p, trader->get_money());
+		const u32 first = part * kTradePerEvent, last = _min(u32(entries.size()), first + kTradePerEvent);
+		put_u8(p, u8(last - first));
+		for (u32 i = first; i < last; ++i)
+		{
+			put_u8(p, entries[i].side);
+			put_entity_ref(p, entries[i].ref);
+			put_u32(p, entries[i].price);
+		}
+		queue_event(link, 15, p);
+	}
+	++g_host->trade_prices_sent;
+	g_host->log.line("trade-prices slot=%u npc=%u entries=%u parts=%u money=%u trader_money=%u why=%s", u32(link.ref.slot),
+		u32(link.trade_npc), u32(entries.size()), parts, actor->get_money(), trader->get_money(), why);
+}
+
+// The installed scripts' trade-window hooks (actor_menu.script fires them from
+// the client-side UI in single player): ActorMenu_on_trade_started sets the
+// trader's mob_trade state (all_money, trading) that its trade_perform
+// callback adds to (trade-1: nil arithmetic without it), and
+// trade_manager.update refreshes the trader's buy and sell conditions. On
+// the server they run in the buyer's context while his talk with the trader
+// is open (GetTalkingNpc finds it).
+static void trade_script_hooks(CActor* actor, CGameObject* npc, bool started)
+{
+	campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), started ? "trade-started" : "trade-closed");
+	if (!scope.entered())
+		return;
+	luabind::functor<void> update;
+	if (started && npc && ai().script_engine().functor("trade_manager.update", update))
+		update(npc->lua_game_object());
+	luabind::functor<void> send;
+	if (ai().script_engine().functor("_G.SendScriptCallback", send))
+		send(started ? "ActorMenu_on_trade_started" : "ActorMenu_on_trade_closed");
+}
+
+void trade_close(PlayerLink& link, LPCSTR why)
+{
+	if (link.trade_npc == 0xffff)
+		return;
+	CGameObject* npc = nullptr;
+	CInventoryOwner* trader = trade_partner(link, &npc);
+	CActor* actor = participant_actor(link.ref);
+	if (actor)
+		trade_script_hooks(actor, npc, false);
+	if (trader && trader->GetTrade())
+	{
+		campaign::ScriptContextScope scope(actor ? static_cast<const CObject*>(actor) : nullptr, "trade-close");
+		trader->GetTrade()->StopTrade();
+		trader->StopTrading();
+	}
+	g_host->log.line("trade-close slot=%u npc=%u why=%s", u32(link.ref.slot), u32(link.trade_npc), why);
+	link.trade_npc = 0xffff;
+}
+
+static bool trade_context_actor(PlayerLink& link, CActor*& actor)
+{
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	actor = context_actor(context, Scope::Self, &why);
+	return actor && actor->g_Alive();
+}
