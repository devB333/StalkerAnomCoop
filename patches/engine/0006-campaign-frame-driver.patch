index 0000000..1aa073c
--- /dev/null
+++ b/src/xrEngine/CampaignServerClock.cpp
@@ -0,0 +1,145 @@
+#include "stdafx.h"
+#include "CampaignServerClock.h"
+
+#include "IGame_Persistent.h"
+#include "Stats.h"
+
+CCampaignServerClock::CCampaignServerClock(u32 tick_ms_, u32 max_catchup_ticks_)
+	: tick_ms(tick_ms_), max_catchup_ticks(max_catchup_ticks_), running(false), paused(false),
+	  owns_statistic(false), owns_scheduler_slot(false), wall_base(0), ticks_since_base(0),
+	  pause_started(0)
+{
+	R_ASSERT2(tick_ms != 0, "Campaign clock needs a nonzero tick");
+	ZeroMemory(&counters, sizeof(counters));
+	scheduler_slot.owner = this;
+}
+
+CCampaignServerClock::~CCampaignServerClock()
+{
+	if (running)
+		Stop();
+}
+
+void CCampaignServerClock::Start(u32 wall_ms)
+{
+	R_ASSERT2(!running, "Campaign clock already running");
+	Device.dwFrame = 0;
+	Core.dwFrame = 0;
+	Device.dwTimeGlobal = 0;
+	Device.dwTimeDelta = 0;
+	Device.dwTimeContinual = 0;
+	Device.fTimeGlobal = 0.f;
+	Device.fTimeDelta = 0.f;
+
+	// The scheduler reports its timing through Device.Statistic, which the
+	// native client creates in Device.Create. CStats holds only counters here;
+	// its render registration is never processed by the server.
+	if (!Device.Statistic)
+	{
+		Device.Statistic = xr_new<CStats>();
+		owns_statistic = true;
+	}
+
+	// Natively CGamePersistent::OnFrame (priority HIGH+1) runs the scheduler.
+	// Without that object the driver takes the same slot, so it still runs
+	// exactly once per tick in the same order.
+	if (!g_pGamePersistent)
+	{
+		Device.seqFrame.Add(&scheduler_slot, REG_PRIORITY_HIGH + 1);
+		owns_scheduler_slot = true;
+	}
+
+	wall_base = wall_ms;
+	ticks_since_base = 0;
+	paused = false;
+	running = true;
+}
+
+void CCampaignServerClock::Stop()
+{
+	R_ASSERT2(running, "Campaign clock is not running");
+	if (owns_scheduler_slot)
+		Device.seqFrame.Remove(&scheduler_slot);
+	owns_scheduler_slot = false;
+	if (owns_statistic)
+		xr_delete(Device.Statistic);
+	owns_statistic = false;
+	running = false;
+	paused = false;
+}
+
+u32 CCampaignServerClock::Advance(u32 wall_ms)
+{
+	if (!running || paused)
+		return 0;
+
+	const u64 due_total = u64(wall_ms - wall_base) / tick_ms;
+	if (due_total <= ticks_since_base)
+		return 0;
+	const u64 due = due_total - ticks_since_base;
+	const u32 debt_ms = u32((due - 1) * tick_ms);
+	if (debt_ms > counters.max_debt_ms)
+		counters.max_debt_ms = debt_ms;
+
+	const u64 run = _min(due, u64(max_catchup_ticks) + 1);
+	for (u64 i = 0; i < run; ++i)
+		Tick();
+	counters.catchup_ticks += run - 1;
+	ticks_since_base += run;
+
+	if (due > run)
+	{
+		// Beyond the catch-up bound: simulation time does not advance for the
+		// rest, and the dropped wall time is reported.
+		const u64 dropped = (due - run) * tick_ms;
+		counters.dropped_ms += dropped;
+		ticks_since_base += due - run;
+		Msg("! campaign clock: %u ms behind; ran %u ticks, dropped %u ms of simulation time",
+			debt_ms, u32(run), u32(dropped));
+	}
+	return u32(run);
+}
+
+void CCampaignServerClock::Pause(u32 wall_ms)
+{
+	R_ASSERT2(running && !paused, "Campaign clock cannot pause");
+	paused = true;
+	pause_started = wall_ms;
+}
+
+void CCampaignServerClock::Resume(u32 wall_ms)
+{
+	R_ASSERT2(running && paused, "Campaign clock cannot resume");
+	const u32 paused_for = wall_ms - pause_started;
+	counters.paused_ms += paused_for;
+	// Paused wall time is not owed to the simulation.
+	wall_base += paused_for;
+	paused = false;
+}
+
+void CCampaignServerClock::Tick()
+{
+	Device.dwFrame++;
+	Core.dwFrame = Device.dwFrame;
+	Device.dwTimeDelta = tick_ms;
+	Device.dwTimeGlobal += tick_ms;
+	Device.dwTimeContinual = Device.dwTimeGlobal;
+	Device.fTimeDelta = float(tick_ms) / 1000.f;
+	Device.fTimeGlobal = float(Device.dwTimeGlobal) / 1000.f;
+
+	Device.seqFrame.Process(rp_Frame);
+
+	for (u32 i = 0; i < Device.seqParallel.size(); ++i)
+		Device.seqParallel[i]();
+	counters.parallel_jobs += Device.seqParallel.size();
+	Device.seqParallel.clear_not_free();
+
+	Device.seqFrameMT.Process(rp_Frame);
+	++counters.ticks;
+}
+
+void CCampaignServerClock::SchedulerSlot::OnFrame()
+{
+	Engine.Sheduler.Update();
+	++owner->counters.scheduler_updates;
+}
diff --git a/src/xrEngine/CampaignServerClock.h b/src/xrEngine/CampaignServerClock.h
new file mode 100644
index 0000000..5d2f957
--- /dev/null
+++ b/src/xrEngine/CampaignServerClock.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include "pure.h"
+
+// Server simulation clock and serial frame driver for the campaign server
+// (S02-T04). Simulation time advances only in whole ticks, so Device's integer,
+// float and frame clocks always agree. Wall time decides how many ticks are
+// due: a late frame is caught up with at most max_catchup_ticks extra ticks,
+// and any remaining debt is dropped and counted, never silently absorbed.
+// Pause is an explicit server state; paused wall time never becomes debt.
+//
+// One tick, in order:
+//   1. advance Device frame and clocks by exactly one tick
+//   2. Device.seqFrame in priority order; with no game persistent object the
+//      driver runs Engine.Sheduler.Update in the persistent slot (HIGH+1)
+//   3. queued Device.seqParallel jobs, each exactly once
+//   4. Device.seqFrameMT, run serially on this thread
+class ENGINE_API CCampaignServerClock
+{
+public:
+	struct Counters
+	{
+		u64 ticks;
+		u64 catchup_ticks; // ticks beyond the first in one Advance call
+		u64 dropped_ms; // debt dropped beyond the catch-up bound
+		u64 paused_ms; // wall time spent paused
+		u64 parallel_jobs; // seqParallel jobs run
+		u32 max_debt_ms; // largest debt seen by one Advance call
+		u32 scheduler_updates;
+	};
+
+	CCampaignServerClock(u32 tick_ms, u32 max_catchup_ticks);
+	~CCampaignServerClock();
+
+	// Takes over Device's clocks at tick 0 and installs the scheduler slot.
+	void Start(u32 wall_ms);
+	void Stop();
+	// Runs the ticks due by wall_ms and returns how many ran.
+	u32 Advance(u32 wall_ms);
+	void Pause(u32 wall_ms);
+	void Resume(u32 wall_ms);
+
+	bool Running() const { return running; }
+	bool Paused() const { return paused; }
+	u32 TickMs() const { return tick_ms; }
+	// Wall time at which the next tick is due.
+	u32 NextTickWallMs() const { return wall_base + u32(ticks_since_base + 1) * tick_ms; }
+	const Counters& Stats() const { return counters; }
+
+private:
+	void Tick();
+
+	struct SchedulerSlot : public pureFrame
+	{
+		CCampaignServerClock* owner;
+		virtual void _BCL OnFrame();
+	};
+
+	u32 tick_ms;
+	u32 max_catchup_ticks;
+	bool running;
+	bool paused;
+	bool owns_statistic;
+	bool owns_scheduler_slot;
+	u32 wall_base; // wall time of the last rebase
+	u64 ticks_since_base;
+	u32 pause_started;
+	Counters counters;
+	SchedulerSlot scheduler_slot;
+};
