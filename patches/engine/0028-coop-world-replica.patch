diff --git a/src/xrGame/CoopReplica.cpp b/src/xrGame/CoopReplica.cpp
new file mode 100644
index 0000000..974758c
--- /dev/null
+++ b/src/xrGame/CoopReplica.cpp
@@ -0,0 +1,271 @@
+#include "pch_script.h"
+#include "CoopReplica.h"
+
+// S05-T02: see CoopReplica.h.
+
+#include "CampaignMessagePolicy.h"
+#include "alife_switch_manager.h"
+#include "xrServer.h"
+#include "GameObject.h"
+#include "../xrServerEntities/xrServer_Objects_ALife_Monsters.h"
+#include "xrMessages.h"
+#include "ai_space.h"
+#include "alife_simulator.h"
+#include "alife_object_registry.h"
+
+#include <unordered_set>
+
+namespace campaign
+{
+namespace
+{
+bool g_active = false;
+u16 g_local_actor = u16(-1);
+int g_permits = 0;
+// Created by replica_begin, deleted by replica_end: a static container would
+// allocate through the engine's allocator before main and free after it is
+// torn down (an access violation at a single-player client's exit, capture-26).
+std::unordered_set<u16>* g_online = nullptr;
+ReplicaStats g_stats = {};
+u32 g_logged = 0;
+
+void note(LPCSTR what, LPCSTR detail, u32 value)
+{
+	if (g_logged >= 32)
+		return;
+	++g_logged;
+	Msg("S05-T02 replica refused %s %s %u", what, detail ? detail : "", value);
+}
+} // namespace
+
+bool replica_active() { return g_active; }
+
+void replica_begin(u16 local_actor, const xr_vector<u16>& online)
+{
+	g_active = true;
+	g_local_actor = local_actor;
+	if (!g_online)
+		g_online = xr_new<std::unordered_set<u16>>();
+	g_online->clear();
+	g_online->insert(online.begin(), online.end());
+	g_stats = ReplicaStats{};
+	g_logged = 0;
+	Msg("S05-T02 replica begin local_actor=%u online=%u", u32(local_actor), replica_online_count());
+}
+
+void replica_end()
+{
+	if (!g_active)
+		return;
+	report_replica("end");
+	g_active = false;
+	g_local_actor = u16(-1);
+	xr_delete(g_online);
+}
+
+u16 replica_local_actor() { return g_local_actor; }
+
+bool replica_permitted() { return g_permits > 0; }
+ReplicaPermit::ReplicaPermit() { ++g_permits; }
+ReplicaPermit::~ReplicaPermit() { --g_permits; }
+
+bool replica_wants_online(u16 id) { return g_online && g_online->count(id) != 0; }
+
+void replica_set_online(u16 id, bool online)
+{
+	if (!g_online)
+		return;
+	if (online)
+		g_online->insert(id);
+	else
+		g_online->erase(id);
+}
+
+u32 replica_online_count() { return g_online ? u32(g_online->size()) : 0; }
+
+void replica_note_alife(int what)
+{
+	if (!g_active)
+		return;
+	if (what == 0)
+		++g_stats.alife_shedule_calls;
+	else
+		++g_stats.alife_updates;
+}
+
+void replica_apply_switch(u16 id)
+{
+	if (!g_active || !ai().get_alife())
+		return;
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	CSE_ALifeDynamicObject* object = ai().alife().objects().object(id, true);
+	if (!object)
+		return;
+	if (CSE_ALifeMonsterAbstract* monster = smart_cast<CSE_ALifeMonsterAbstract*>(object))
+		if (monster->m_group_id != 0xffff)
+			if (CSE_ALifeDynamicObject* group = ai().alife().objects().object(monster->m_group_id, true))
+				object = group;
+	CALifeSwitchManager& switches = *alife;
+	replica_switch_object(switches, object);
+}
+
+bool replica_alife_scheduled_allowed()
+{
+	if (!g_active)
+		return true;
+	++g_stats.scheduled_skipped;
+	return false;
+}
+
+bool replica_switch_object(CALifeSwitchManager& switches, CSE_ALifeDynamicObject* object)
+{
+	if (!g_active)
+		return false;
+	++g_stats.switch_calls;
+	// Items in an inventory go online and offline with their owner.
+	if (object->ID_Parent != 0xffff)
+		return true;
+	bool want = replica_wants_online(object->ID);
+	if (CSE_ALifeOnlineOfflineGroup* group = smart_cast<CSE_ALifeOnlineOfflineGroup*>(object))
+	{
+		// A squad is online on the server when its members are.
+		for (const auto& member : group->squad_members())
+			if (replica_wants_online(member.first))
+			{
+				want = true;
+				break;
+			}
+	}
+	ReplicaPermit permit;
+	if (want && !object->m_bOnline)
+	{
+		switches.switch_online(object);
+		++g_stats.switched_online;
+	}
+	else if (!want && object->m_bOnline)
+	{
+		switches.switch_offline(object);
+		++g_stats.switched_offline;
+	}
+	return true;
+}
+
+void replica_on_register(CSE_ALifeDynamicObject* object)
+{
+	if (!g_active || !smart_cast<CSE_ALifeCreatureActor*>(object))
+		return;
+	// This client's own participant actor is its player entity, whichever
+	// slot it holds on the server; every other actor is a remote one.
+	if (object->ID == g_local_actor)
+	{
+		if (!object->s_flags.is(M_SPAWN_OBJECT_ASPLAYER))
+			++g_stats.player_flag_set;
+		object->s_flags.or(M_SPAWN_OBJECT_ASPLAYER);
+	}
+	else if (object->s_flags.is(M_SPAWN_OBJECT_ASPLAYER))
+	{
+		object->s_flags.and(u16(-1) ^ M_SPAWN_OBJECT_ASPLAYER);
+		++g_stats.player_flag_cleared;
+	}
+	Msg("S05-T02 replica actor %u registered as %s", u32(object->ID),
+		object->ID == g_local_actor ? "the local player" : "a remote participant");
+}
+
+bool replica_refuse_create(LPCSTR section)
+{
+	if (!g_active || replica_permitted())
+		return false;
+	++g_stats.creates_refused;
+	note("create", section, 0);
+	return true;
+}
+
+bool replica_refuse_release(u16 id)
+{
+	if (!g_active || replica_permitted())
+		return false;
+	++g_stats.releases_refused;
+	note("release", "id", id);
+	return true;
+}
+
+bool replica_spawn_local(xrServer& server, const CSE_Abstract* entity)
+{
+	if (!g_active)
+		return true;
+	// The local actor and everything it carries stay local; the rest is
+	// presented from the server's state.
+	for (const CSE_Abstract* e = entity; e; e = e->ID_Parent == 0xffff ? nullptr : server.ID_to_entity(e->ID_Parent))
+		if (e->ID == g_local_actor)
+		{
+			++g_stats.spawns_local;
+			return true;
+		}
+	++g_stats.spawns_remote;
+	return false;
+}
+
+bool replica_refuse_message(u16 type, bool bridge)
+{
+	if (!g_active || replica_permitted() || !bridge)
+		return false;
+	switch (classify_message(type))
+	{
+	case MessageClass::StateImport:
+		if (type != M_SPAWN)
+			return false; // the local actor's own state into its local entity
+		break;
+	case MessageClass::WorldControl: break;
+	case MessageClass::Outcome:
+		if (type == M_EVENT || type == M_EVENT_PACK)
+			return false; // policed per event in Process_event
+		break;
+	default: return false;
+	}
+	++g_stats.messages_refused;
+	note("message", message_name(type), type);
+	return true;
+}
+
+bool replica_refuse_event(u16 type, bool bridge)
+{
+	if (!g_active || replica_permitted() || !bridge)
+		return false;
+	++g_stats.events_refused;
+	if (type < 64)
+		++g_stats.event_types_refused[type];
+	note("event", game_event_name(type), type);
+	return true;
+}
+
+bool replica_binder_update_allowed(const CGameObject* object)
+{
+	if (!g_active || !object || object->Local())
+		return true;
+	++g_stats.binder_updates_skipped;
+	return false;
+}
+
+const ReplicaStats& replica_stats() { return g_stats; }
+
+void report_replica(LPCSTR tag)
+{
+	const ReplicaStats& s = g_stats;
+	string512 events = "";
+	for (u32 i = 0; i < 64; ++i)
+		if (s.event_types_refused[i])
+		{
+			string64 one;
+			xr_sprintf(one, " %s=%u", game_event_name(u16(i)), s.event_types_refused[i]);
+			xr_strcat(events, one);
+		}
+	Msg("S05-T02 replica %s active=%d local_actor=%u online_set=%u scheduled_skipped=%I64u switched_online=%I64u "
+		"switched_offline=%I64u player_flag_set=%I64u player_flag_cleared=%I64u creates_refused=%I64u "
+		"releases_refused=%I64u spawns_local=%I64u spawns_remote=%I64u messages_refused=%I64u events_refused=%I64u "
+		"binder_updates_skipped=%I64u alife_shedule=%I64u alife_updates=%I64u switch_calls=%I64u events:%s",
+		tag, g_active ? 1 : 0, u32(g_local_actor), replica_online_count(), s.scheduled_skipped, s.switched_online,
+		s.switched_offline, s.player_flag_set, s.player_flag_cleared, s.creates_refused, s.releases_refused,
+		s.spawns_local, s.spawns_remote, s.messages_refused, s.events_refused, s.binder_updates_skipped,
+		s.alife_shedule_calls, s.alife_updates, s.switch_calls, events);
+}
+} // namespace campaign
diff --git a/src/xrGame/CoopReplica.h b/src/xrGame/CoopReplica.h
new file mode 100644
index 0000000..51c4e14
--- /dev/null
+++ b/src/xrGame/CoopReplica.h
@@ -0,0 +1,92 @@
+#pragma once
+
+// S05-T02: a co-op client's replica of the server's world.
+//
+// The client starts the level from the server's checkpoint (the initial
+// world snapshot), with its own in-process xrServer and ALife as storage
+// and presentation only. While the replica is active nothing in the client
+// advances shared state on its own:
+//
+// - ALife: no offline simulation (update_scheduled); online/offline follows
+//   the server's lifecycle stream (the replica online set), not distance.
+// - Entities: only replication creates or releases them (spawn_item, release
+//   and the client level's M_SPAWN are refused otherwise), so the client's
+//   engine ids stay the server's.
+// - Every object except the local participant's actor and what it carries is
+//   spawned non-local: the engine's Remote() path (no AI think, positions
+//   interpolated from network updates; CCustomMonster, CAI_Stalker,
+//   CBaseMonster, CActor).
+// - Game events (hits, deaths, ownership, ...) and world control from the
+//   client's own level are refused by its in-process server.
+// - Script binders: the single-player actor binder attaches to the local
+//   participant's actor only; remote objects' binders do not update.
+// - The local participant's actor carries M_SPAWN_OBJECT_ASPLAYER on this
+//   client (it is the ALife actor and the view), whichever slot it holds.
+//
+// Every refusal is counted and reported (report_replica).
+
+class CSE_Abstract;
+class CSE_ALifeDynamicObject;
+class CALifeSwitchManager;
+class CGameObject;
+class xrServer;
+
+namespace campaign
+{
+// The replica exists from the permitted level start to the level's end.
+bool replica_active();
+void replica_begin(u16 local_actor, const xr_vector<u16>& online);
+void replica_end();
+u16 replica_local_actor();
+
+// Replication applies a change: the hooks let it through.
+bool replica_permitted();
+struct ReplicaPermit
+{
+	ReplicaPermit();
+	~ReplicaPermit();
+};
+
+// The server's online set as the client knows it.
+bool replica_wants_online(u16 id);
+void replica_set_online(u16 id, bool online);
+u32 replica_online_count();
+// Switches the object (or the squad it belongs to) online or offline now, to
+// match the replica online set; the client's ALife update is not relied on.
+void replica_apply_switch(u16 id);
+
+// Hooks.
+bool replica_alife_scheduled_allowed(); // CALifeUpdateManager::update_scheduled
+bool replica_switch_object(CALifeSwitchManager& switches, CSE_ALifeDynamicObject* object); // true: handled
+void replica_on_register(CSE_ALifeDynamicObject* object); // the player flag, before graph registration
+bool replica_refuse_create(LPCSTR section); // spawn_item
+bool replica_refuse_release(u16 id); // CALifeSimulatorBase::release
+bool replica_spawn_local(xrServer& server, const CSE_Abstract* entity); // the in-process spawn writer
+bool replica_refuse_message(u16 type, bool bridge); // xrServer::OnMessage
+bool replica_refuse_event(u16 type, bool bridge); // xrServer::Process_event
+bool replica_binder_update_allowed(const CGameObject* object); // CScriptBinder::shedule_Update
+// Diagnostics of the replica's ALife driving: 0 shedule_Update, 1 update().
+void replica_note_alife(int what);
+
+struct ReplicaStats
+{
+	u64 scheduled_skipped;
+	u64 switched_online;
+	u64 switched_offline;
+	u64 player_flag_set;
+	u64 player_flag_cleared;
+	u64 creates_refused;
+	u64 releases_refused;
+	u64 spawns_remote;
+	u64 spawns_local;
+	u64 messages_refused;
+	u64 events_refused;
+	u64 binder_updates_skipped;
+	u64 alife_shedule_calls;
+	u64 alife_updates;
+	u64 switch_calls;
+	u32 event_types_refused[64]; // first 64 GE_* type ids
+};
+const ReplicaStats& replica_stats();
+void report_replica(LPCSTR tag);
+} // namespace campaign
