+
+static u16 find_trader_door(CObject* giver)
+{
+	u16 best = 0xffff;
+	float best_distance = 25.f;
+	for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+	{
+		CObject* o = Level().Objects.o_get_by_iterator(i);
+		CGameObject* go = o ? smart_cast<CGameObject*>(o) : nullptr;
+		// a door of the installed ph_door scheme (the engine registers doors::door for it)
+		if (!go || !smart_cast<CPhysicObject*>(o) || !go->lua_game_object() || !go->lua_game_object()->m_door)
+			continue;
+		const float d = o->Position().distance_to(giver->Position());
+		if (d < best_distance)
+		{
+			best_distance = d;
+			best = u16(o->ID());
+		}
+	}
+	return best;
+}
