+// S10-T03f (decision T01-3): a new game's second player starts with its own loadout, as the creation screen
+// gives it (ui_mm_faction_select.script on_game_load: each section once, a weapon's ammo by [ammo_type_per_wpn]
+// or its first ammo class, [ammo_count] or a box, two boxes under 30 rounds); no list: the faction's kit
+void give_new_game_loadout(PlayerLink& link, CActor* actor)
+{
+	if (!g_host->config.new_game_loadout_2[0])
+	{
+		give_faction_kit(link, actor);
+		return;
+	}
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	const CSE_ALifeDynamicObject* se = alife ? ai().alife().objects().object(u16(actor->ID()), true) : nullptr;
+	if (!se)
+		return;
+	string_path path;
+	FS.update_path(path, "$game_config$", "items\\settings\\new_game_loadouts.ltx");
+	CInifile loadouts(path, TRUE, TRUE, FALSE);
+	string1024 list;
+	xr_strcpy(list, g_host->config.new_game_loadout_2);
+	u32 items = 0, ammo_boxes = 0;
+	xr_vector<xr_string> sections;
+	for (LPCSTR name = strtok(list, ", \t"); name; name = strtok(nullptr, ", \t"))
+		sections.push_back(name);
+	for (const xr_string& s : sections)
+	{
+		LPCSTR name = s.c_str();
+		if (!pSettings->section_exist(name))
+			continue;
+		give_item(alife, name, actor, se);
+		++items;
+		if (!pSettings->line_exist(name, "ammo_class"))
+			continue;
+		const u32 slot = pSettings->line_exist(name, "slot") ? pSettings->r_u32(name, "slot") : 0xff;
+		const u32 anim = pSettings->line_exist(name, "animation_slot") ? pSettings->r_u32(name, "animation_slot") : 0;
+		if (!((slot == 0 && anim == 1) || slot == 1 || slot == 2))
+			continue;
+		string256 classes;
+		xr_strcpy(classes, pSettings->r_string(name, "ammo_class"));
+		string256 first;
+		_GetItem(classes, 0, first);
+		LPCSTR ammo = loadouts.line_exist("ammo_type_per_wpn", name) ? loadouts.r_string("ammo_type_per_wpn", name) : first;
+		if (!ammo || !pSettings->section_exist(ammo))
+			continue;
+		const u32 box = pSettings->line_exist(ammo, "box_size") ? pSettings->r_u32(ammo, "box_size") : 50;
+		u32 count = loadouts.line_exist("ammo_count", ammo) ? loadouts.r_u32("ammo_count", ammo) : 0;
+		if (!count)
+			count = box < 30 ? 2 * box : box;
+		const u32 boxes = (count + box - 1) / _max(1u, box);
+		for (u32 n = 0; n < boxes; ++n)
+			give_item(alife, ammo, actor, se);
+		ammo_boxes += boxes;
+	}
+	g_host->log.line("new-game-loadout slot=%u actor=%u items=%u ammo_boxes=%u list=[%s]", u32(link.ref.slot),
+		u32(actor->ID()), items, ammo_boxes, g_host->config.new_game_loadout_2);
+}
