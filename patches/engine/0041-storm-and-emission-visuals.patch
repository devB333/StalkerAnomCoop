+// Every second: the server's environment as the clients should show it.
+void log_weather()
+{
+	if (!g_host->weather_csv || !ai().get_alife() || !g_pGamePersistent)
+		return;
+	const u32 now = g_host->wall.GetElapsed_ms();
+	if (now - g_host->last_weather_log_ms < 1000)
+		return;
+	g_host->last_weather_log_ms = now;
+	CEnvironment& env = g_pGamePersistent->Environment();
+	FILETIME ft;
+	GetSystemTimeAsFileTime(&ft);
+	const u64 utc_ms = ((u64(ft.dwHighDateTime) << 32) | ft.dwLowDateTime) / 10000ull - 11644473600000ull;
+	const shared_str c0 = env.bWFX ? shared_str() : descriptor_cycle(env, env.Current[0]);
+	const shared_str c1 = env.bWFX ? shared_str() : descriptor_cycle(env, env.Current[1]);
+	fprintf(g_host->weather_csv, "%I64u,%I64u,%I64u,%.2f,%s,%s,%d,%.2f,%s,%.2f,%s,%.2f,%.4f,%.3f,%s,%u,%I64u\n", utc_ms,
+		g_host->tick, ai().alife().time_manager().game_time(), ai().alife().time_manager().time_factor(),
+		env.CurrentCycleName.size() ? *env.CurrentCycleName : "-", env.CurrentWeatherName.size() ? *env.CurrentWeatherName : "-",
+		env.bWFX ? 1 : 0, env.wfx_time, c0.size() ? *c0 : "-", env.Current[0] ? env.Current[0]->exec_time : -1.f,
+		c1.size() ? *c1 : "-", env.Current[1] ? env.Current[1]->exec_time : -1.f, env.CurrentEnv ? env.CurrentEnv->weight : -1.f,
+		env.CurrentEnv ? env.CurrentEnv->rain_density : -1.f,
+		env.CurrentEnv && env.CurrentEnv->tb_id.size() ? *env.CurrentEnv->tb_id : "-", g_host->thunder.bolts,
+		g_host->presentations_sent);
+}
