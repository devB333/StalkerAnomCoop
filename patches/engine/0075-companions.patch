+// ------------------------------------------------------------ S10-T02f
+// Runs a Lua chunk returning up to 4 numbers; in p's context when p is given,
+// in npc's evaluation scope when npc is given. Returns the count read.
+static int companion_lua(LPCSTR chunk, double* out, int count, CActor* p, CGameObject* npc, LPCSTR label)
+{
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return -1;
+	const int top = lua_gettop(L);
+	int read = -1;
+	if (luaL_loadstring(L, chunk) == 0)
+	{
+		int rc;
+		if (p)
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(p), label);
+			campaign::NpcEvaluationScope eval(npc);
+			rc = lua_pcall(L, 0, count, 0);
+		}
+		else
+		{
+			campaign::NpcEvaluationScope eval(npc);
+			rc = lua_pcall(L, 0, count, 0);
+		}
+		if (rc == 0)
+		{
+			for(int i = 0; i < count; ++i)
+				out[i] = lua_isnumber(L, top + 1 + i) ? lua_tonumber(L, top + 1 + i) : -9.0;
+			read = count;
+		}
+		else
+			g_host->log.line("fixture-companion lua-error label=%s error=%s", label, lua_tostring(L, -1) ? lua_tostring(L, -1) : "?");
+	}
+	else
+		g_host->log.line("fixture-companion lua-load-error label=%s error=%s", label, lua_tostring(L, -1) ? lua_tostring(L, -1) : "?");
+	lua_settop(L, top);
+	return read;
+}
