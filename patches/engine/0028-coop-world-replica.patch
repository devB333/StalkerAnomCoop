+bool read_file(LPCSTR path, xr_vector<u8>& out)
+{
+	FILE* file = fopen(path, "rb");
+	if (!file)
+		return false;
+	fseek(file, 0, SEEK_END);
+	const long size = ftell(file);
+	fseek(file, 0, SEEK_SET);
+	out.resize(size > 0 ? size_t(size) : 0);
+	const bool ok = size > 0 && fread(out.data(), 1, out.size(), file) == out.size();
+	fclose(file);
+	return ok;
+}
+
+template <typename T>
+void put(xr_vector<u8>& out, T value)
+{
+	const u8* p = reinterpret_cast<const u8*>(&value);
+	out.insert(out.end(), p, p + sizeof(T));
+}
+
+// The world a joining player starts from: a native checkpoint of the whole
+// campaign (scop + scoc, the S02-T06d save path) plus what the lifecycle
+// stream has said up to its watermark. Format (little-endian):
+//   u32 'CWLD', u32 1, u8 slot, u8 name_len, name, u8 actors, {u8 slot, u16 id},
+//   u32 online, {u16 id, u64 entity, u32 generation}, u32 scop, bytes, u32 scoc, bytes
+bool start_resync(PlayerLink& link)
+{
+	track_lifecycle(); // the watermark and the checkpoint describe the same world
+	const u64 watermark = g_host->commit;
+	string64 save;
+	xr_sprintf(save, "coop-join-%u", u32(++g_host->resyncs));
+	CTimer timer;
+	timer.Start();
+	NET_Packet packet;
+	packet.w_begin(M_SAVE_GAME);
+	packet.w_stringZ(save);
+	packet.w_u8(1);
+	Level().Send(packet, net_flags(TRUE));
+	const u32 save_ms = timer.GetElapsed_ms();
+	string_path scop_name, scoc_name, scop_path, scoc_path;
+	xr_sprintf(scop_name, "%s.scop", save);
+	xr_sprintf(scoc_name, "%s.scoc", save);
+	FS.update_path(scop_path, "$game_saves$", scop_name);
+	FS.update_path(scoc_path, "$game_saves$", scoc_name);
+	xr_vector<u8> scop, scoc;
+	if (!read_file(scop_path, scop) || !read_file(scoc_path, scoc))
+	{
+		g_host->log.line("resync-failed player=%s reason=checkpoint-missing save=%s", coop_uuid_hex(link.player).c_str(),
+			save);
+		return false;
+	}
+	xr_vector<u8>& blob = link.blob;
+	blob.clear();
+	put<u32>(blob, 0x444C5743); // "CWLD"
+	put<u32>(blob, 1);
+	put<u8>(blob, link.ref.slot);
+	put<u8>(blob, u8(xr_strlen(save)));
+	blob.insert(blob.end(), save, save + xr_strlen(save));
+	xr_vector<std::pair<u8, u16>> actors;
+	for (const PlayerLink& other : g_host->links)
+		if (other.bound)
+			if (CActor* actor = participant_actor(other.ref))
+				actors.push_back({other.ref.slot, u16(actor->ID())});
+	put<u8>(blob, u8(actors.size()));
+	for (const auto& a : actors)
+	{
+		put<u8>(blob, a.first);
+		put<u16>(blob, a.second);
+	}
+	put<u32>(blob, u32(g_host->published.size()));
+	for (const auto& p : g_host->published)
+	{
+		put<u16>(blob, p.first);
+		put<u64>(blob, p.second.ref.id);
+		put<u32>(blob, p.second.ref.generation);
+	}
+	put<u32>(blob, u32(scop.size()));
+	blob.insert(blob.end(), scop.begin(), scop.end());
+	put<u32>(blob, u32(scoc.size()));
+	blob.insert(blob.end(), scoc.begin(), scoc.end());
+
+	link.resync_id = g_host->resyncs;
+	link.watermark = watermark;
+	link.next_chunk = 0;
+	link.chunk_count = u32((blob.size() + kChunkBytes - 1) / kChunkBytes);
+	link.crc = 0;
+	link.outbox.clear(); // everything up to the watermark is in the checkpoint
+	coop::proto::ResyncBegin begin;
+	begin.resync_id = link.resync_id;
+	begin.checkpoint_id = link.resync_id;
+	begin.authority_epoch = 1; // a join does not change the epoch
+	begin.content_hash = coop::session::sha256(blob.data(), blob.size());
+	begin.event_watermark = watermark;
+	begin.total_bytes = blob.size();
+	begin.chunk_bytes = kChunkBytes;
+	begin.chunk_count = link.chunk_count;
+	if (!g_host->server->send(link.player, coop::proto::Message(begin)))
+	{
+		g_host->log.line("resync-failed player=%s reason=begin-not-sent", coop_uuid_hex(link.player).c_str());
+		return false;
+	}
+	link.world = WorldStreaming;
+	link.resync_started_ms = g_host->wall.GetElapsed_ms();
+	g_host->log.line("resync-begin player=%s resync=%I64u save=%s save_ms=%u scop=%u scoc=%u online=%u actors=%u "
+		"watermark=%I64u bytes=%u chunks=%u",
+		coop_uuid_hex(link.player).c_str(), link.resync_id, save, save_ms, u32(scop.size()), u32(scoc.size()),
+		u32(g_host->published.size()), u32(actors.size()), watermark, u32(blob.size()), link.chunk_count);
+	return true;
+}
+
+void stream_world(PlayerLink& link)
+{
+	while (link.next_chunk < link.chunk_count)
+	{
+		coop::net::ChannelBacklog backlog;
+		if (!g_host->server->backlog(link.player, coop::proto::kBulk, backlog))
+			return;
+		if (backlog.queued_bytes + backlog.unacked_bytes + kChunkBytes > kBulkBacklogLimit)
+			return;
+		coop::proto::ResyncChunk chunk;
+		chunk.resync_id = link.resync_id;
+		chunk.index = link.next_chunk;
+		const size_t from = size_t(link.next_chunk) * kChunkBytes;
+		const size_t to = std::min<size_t>(link.blob.size(), from + size_t(kChunkBytes));
+		chunk.data.assign(link.blob.begin() + from, link.blob.begin() + to);
+		if (!g_host->server->send(link.player, coop::proto::Message(chunk)))
+			return;
+		link.crc = coop::proto::crc32(chunk.data.data(), chunk.data.size(), link.crc);
+		++link.next_chunk;
+	}
+	coop::proto::ResyncEnd end;
+	end.resync_id = link.resync_id;
+	end.chunk_count = link.chunk_count;
+	end.total_crc32 = link.crc;
+	if (!g_host->server->send(link.player, coop::proto::Message(end)))
+		return;
+	link.world = WorldLive;
+	g_host->log.line("resync-end player=%s resync=%I64u chunks=%u ms=%u queued_events=%u",
+		coop_uuid_hex(link.player).c_str(), link.resync_id, link.chunk_count,
+		g_host->wall.GetElapsed_ms() - link.resync_started_ms, u32(link.outbox.size()));
+	link.blob.clear();
+	link.blob.shrink_to_fit();
+}
+
+// A server-controlled entity change every `churn` seconds (profile churn = N,
+// 0 off): a medkit appears beside participant 1's actor and is released half
+// a period later.
+void churn()
+{
+	if (!g_host->config.churn || !ai().get_alife())
+		return;
+	const u32 now = g_host->wall.GetElapsed_ms();
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	if (g_host->churn_id == 0xffff && now >= g_host->churn_next_ms)
+	{
+		const u32 period_ms = g_host->config.churn * 1000;
+		g_host->churn_next_ms = now + period_ms;
+		xr_vector<CActor*> actors;
+		participant_actors(actors);
+		const CSE_ALifeCreatureActor* se_actor = ai().alife().graph().actor();
+		u32 vertex = u32(-1);
+		Fvector position;
+		if (actors.empty() || !se_actor || !spawn_position(actors.front(), vertex, position))
+			return;
+		CSE_Abstract* item = alife->spawn_item("medkit", position, vertex, se_actor->m_tGraphID, u16(-1));
+		if (!item)
+			return;
+		g_host->churn_id = item->ID;
+		g_host->churn_release_ms = now + g_host->config.churn * 500;
+		++g_host->churn_spawned;
+		g_host->log.line("churn-spawn id=%u section=medkit pos=%.2f,%.2f,%.2f", u32(item->ID), VPUSH(position));
+	}
+	else if (g_host->churn_id != 0xffff && now >= g_host->churn_release_ms)
+	{
+		CSE_ALifeDynamicObject* object = ai().alife().objects().object(g_host->churn_id, true);
+		if (object)
+		{
+			if (object->m_bOnline)
+			{
+				// the way alife():release does it for an online object
+				NET_Packet packet;
+				packet.w_begin(M_EVENT);
+				packet.w_u32(Level().timeServer());
+				packet.w_u16(GE_DESTROY);
+				packet.w_u16(object->ID);
+				Level().Send(packet, net_flags(TRUE, TRUE));
+			}
+			else
+				alife->release(object, true);
+			++g_host->churn_released;
+		}
+		g_host->log.line("churn-release id=%u found=%d", u32(g_host->churn_id), object ? 1 : 0);
+		g_host->churn_id = 0xffff;
+	}
+}
