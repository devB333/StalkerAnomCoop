+++ b/src/Layers/xrRender/CpuOnlyResources.h
@@ -0,0 +1,28 @@
+#pragma once
+
+// The campaign server loads models with no graphics device (S02-T03). In this
+// mode shader, geometry and GPU buffer creation are skipped and counted; all
+// CPU model data (bones, motions, CPU vertex/index copies) is still loaded.
+struct CpuOnlyResources
+{
+	static bool& Enabled()
+	{
+		static bool enabled = false;
+		return enabled;
+	}
+	static u32& SkippedShaders()
+	{
+		static u32 count = 0;
+		return count;
+	}
+	static u32& SkippedGeometry()
+	{
+		static u32 count = 0;
+		return count;
+	}
+	static u32& SkippedBuffers()
+	{
+		static u32 count = 0;
+		return count;
+	}
+};
