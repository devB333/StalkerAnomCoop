+	"local function context_cover()\n"
+	"  if not (as_ok and type(ASM) == 'table' and type(ASM.scan_safe_zone_old) == 'function') then return false end\n"
+	"  local ok, c = pcall(ASM.scan_safe_zone_old)\n"
