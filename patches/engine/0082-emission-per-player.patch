+	// one-shot sounds a late joiner does not hear in a burst (second of the stage)
+	"    local ONCE = { beginning = 0, siren = 25, impact = 47, ['1stwavesnd'] = 108, ['2ndwavesnd'] = 156, endsnd = 220 }\n"
+	"    local WAVE_AT = { 120, 168 }\n"
+	"    local passes = {}\n"
+	// a luabind class raises on a missing static, so its methods are looked up once
+	"    local methods = {}\n"
+	"    local function method(k)\n"
+	"      local m = methods[k]\n"
+	"      if m == nil then\n"
+	"        local ok, v = pcall(function() return SMC[k] end)\n"
+	"        m = ok and type(v) == 'function' and v or false\n"
+	"        methods[k] = m\n"
+	"      end\n"
+	"      return m or nil\n"
+	"    end\n"
+	"    local level_name = nil\n"
+	"    local function diff_sec_of(mgr)\n"
+	"      return math.ceil(game.get_game_time():diffSec(mgr.inited_time) / level.get_time_factor())\n"
+	"    end\n"
+	"    local function new_pass(mgr, slot)\n"
+	"      local p = { stages = {}, blowout_waves = {}, body_tears = {}, hitFactor = mgr.hitFactor or 0,\n"
+	"                  effector_set = false, blowout_sound = false, wave_sound = false, second_message_given = false,\n"
+	"                  ui_disabled = false, first_update = true, task_given = true, serial = S.surge_serial,\n"
+	"                  u_prev_sec = -1, u_prev_game_sec = -1, u_currentPPEfactor = 0.001, indik = nil, slot = slot }\n"
+	"      local d = diff_sec_of(mgr)\n"
+	"      for k, t in pairs(ONCE) do if d > t + 3 then p.stages[k] = true end end\n"
+	// a wave is where it would be had it started on time
+	"      p.start_wave = function(self, num, t)\n"
+	"        local at = WAVE_AT[num]\n"
+	"        if at then t = math.floor(at * level.get_time_factor() / 2) end\n"
+	"        return orig_start_wave(self, num, t)\n"
+	"      end\n"
+	"      return setmetatable(p, { __index = function(t, k)\n"
+	"        if WORLD[k] then return noop end\n"
+	"        local m = method(k)\n"
+	"        if m then return m end\n"
+	"        return mgr[k]\n"
+	"      end })\n"
+	"    end\n"
+	"    local function swap_in(p)\n"
+	"      local saved = { indik = rawget(SMM, 'currentIndik') }\n"
+	"      for _, n in ipairs({ 'prev_sec', 'prev_game_sec', 'currentPPEfactor' }) do\n"
