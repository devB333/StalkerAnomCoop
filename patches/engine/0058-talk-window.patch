+// ------------------------------------------------------------ S10-T04a
+// The talk window on the server's dialogue (docs/validation/S10-T04a.md).
+// The USE key on an NPC sends the talk-start intent (14); the server's
+// CampaignEvent 14 drives the window: state 1 open (the window opens in its
+// remote mode), 3 an answer (a said phrase, the NPC's or ours), 4 a list of
+// topics or phrases (u8 part flags: bit 0 first part, bit 1 last; u8 topic
+// mode; the dialog id; u8 count; count x (id, text, u8 finalizer)), 2 closed
+// (the why). A click is the say intent (15) with the clicked id; closing the
+// window is the end intent (16). Texts are string-table ids or script
+// texts, translated here as the native window translates them.
+
+void talk_hud(LPCSTR text)
+{
+	pickup_message(text);
+	g_link->log.line("talk-hud text=\"%s\"", text);
+}
+
+CUITalkWnd* talk_window()
+{
+	CUIGameSP* ui = smart_cast<CUIGameSP*>(CurrentGameUI());
+	return ui ? ui->TalkMenu : nullptr;
+}
+
+u64 talk_send_say(LPCSTR id, u32 round, u32 step, bool player)
+{
+	Link::Talk& t = g_link->talk;
+	xr_vector<u8> params;
+	const u32 n = _min(u32(xr_strlen(id)), 64u);
+	params.push_back(u8(n));
+	params.insert(params.end(), id, id + n);
+	const u64 operation = request_ownership(coop::proto::kActionTalkSay, t.npc_ref, params, 0, round, 0, player,
+		player ? "player" : "driver");
+	if (step != 0xffffffff)
+		g_link->pickup_pending.back().step = step;
+	++t.says;
+	g_link->log.line("talk-say-sent id=%s round=%d step=%d operation=%I64x open=%d", id, int(round), int(step),
+		operation, t.open ? 1 : 0);
+	return operation;
+}
+
+// The step driver's path through the lists: the task dialog's ids are the
+// dialog manager's numbers (dm_init_dynamic_task_dialog: n%10 == 2 accept,
+// 4 thanks, 0 next task, 8 exit; the completed dialog: 2 thanks).
+void talk_driver_choose()
+{
+	Link::Talk& t = g_link->talk;
+	if (!t.path || !t.open)
+		return;
+	xr_string pick;
+	if (t.topic_mode)
+	{
+		if (t.path_says)
+		{
+			// back in topic mode: the path ended
+			g_link->log.line("talk-path-done path=%u round=%u step=%u says=%u", u32(t.path), t.path_round, t.path_step,
+				t.path_says);
+			t.path = 0;
+			return;
+		}
+		LPCSTR want = t.path == 1 ? "dm_ordered_task_dialog" : "dm_ordered_task_completed_dialog";
+		for (const xr_string& id : t.ids)
+			if (id == want || (t.path == 1 && id == "dm_ordered_task_dialog2" && pick.empty()))
+				pick = id;
+	}
+	else
+	{
+		// the accept path takes the party task (its offer names the patches) and asks
+		// for the next task otherwise, as a player reading the offer would
+		bool offered_party = true;
+		if (t.path == 1)
+		{
+			xr_string lower = t.last_npc_text;
+			std::transform(lower.begin(), lower.end(), lower.begin(), [](char c) { return char(tolower(u8(c))); });
+			offered_party = lower.find("patch") != xr_string::npos;
+		}
+		int best = -1;
+		for (const xr_string& id : t.ids)
+		{
+			const int n = atoi(id.c_str());
+			int rank = n % 10 == 2 ? 4 : n % 10 == 4 ? 3 : (n > 0 && n % 10 == 0) ? 2 : n % 10 == 8 ? 1 : 0;
+			if (rank == 4 && !offered_party && t.path_skips < 6)
+				rank = 0; // not the party task: skip it
+			if (rank == 2 && !offered_party && t.path_skips < 6)
+				rank = 5;
+			if (rank > best)
+			{
+				best = rank;
+				pick = id;
+			}
+		}
+	}
+	if (pick.empty() || t.path_says >= 12)
+	{
+		g_link->log.line("talk-path-stuck path=%u round=%u step=%u says=%u topic=%d ids=%u", u32(t.path), t.path_round,
+			t.path_step, t.path_says, t.topic_mode ? 1 : 0, u32(t.ids.size()));
+		t.path = 0;
+		return;
+	}
+	++t.path_says;
+	if (!t.topic_mode && atoi(pick.c_str()) > 0 && atoi(pick.c_str()) % 10 == 0)
+		++t.path_skips;
+	talk_send_say(pick.c_str(), t.path_round, t.path_step, false);
+	if (CUITalkWnd* w = talk_window())
+		w->RemoteQuestions(false, t.topic_mode); // as a click: nothing else until the next list
+}
+
+void talk_session_reset(LPCSTR why)
+{
+	Link::Talk& t = g_link->talk;
+	if (!t.open && !t.pending)
+		return;
+	++t.resets;
+	g_link->log.line("talk-reset why=%s open=%d pending=%d npc=%u", why, t.open ? 1 : 0, t.pending ? 1 : 0, u32(t.npc));
+	t.open = false;
+	t.pending = false;
+	t.path = 0;
+	t.ids.clear();
+	if (g_pGameLevel)
+		if (CUITalkWnd* w = talk_window())
+			w->RemoteClose();
+}
+
+void talk_result(const Link::PickupPending& p, const coop::proto::ActionResult& result)
+{
+	Link::Talk& t = g_link->talk;
+	const bool accepted = result.outcome == coop::proto::ActionOutcome::Accepted;
+	g_link->log.line("talk-result kind=%u round=%d step=%d operation=%I64x outcome=%u reason=%u", u32(p.action),
+		int(p.round), int(p.step), p.operation, u32(result.outcome), u32(result.reason));
+	if (!accepted && result.outcome == coop::proto::ActionOutcome::Rejected)
+		++t.refused;
+	if (p.action == coop::proto::kActionTalkStart)
+	{
+		if (!accepted)
+		{
+			t.pending = false;
+			if (result.reason == coop::proto::kReasonTalkBusy)
+			{
+				++t.busy;
+				CInventoryOwner* npc = smart_cast<CInventoryOwner*>(Level().Objects.net_Find(id_of(p.target)));
+				string256 text;
+				xr_sprintf(text, "%s is busy talking to the other player.", npc ? npc->Name() : "They");
+				if (p.player)
+					talk_hud(text);
+				else
+					g_link->log.line("talk-busy npc=%u", u32(id_of(p.target)));
+			}
+			else if (p.player)
+				talk_hud(result.reason == coop::proto::kReasonOutOfReach ? "Too far away." :
+					result.reason == coop::proto::kReasonNoTalk ? "They won't talk now." : "You can't talk now.");
+		}
+		return;
+	}
+	if (p.action == coop::proto::kActionTalkSay)
+	{
+		if (!accepted)
+		{
+			if (CUITalkWnd* w = talk_window())
+				w->RemoteQuestions(false, t.topic_mode); // the click is answered: another may go
+			if (t.path && p.step == t.path_step && p.round == t.path_round)
+				t.path = 0; // the driver's path ends on a refusal
+			if (result.reason == coop::proto::kReasonNotTalking && t.open)
+				talk_session_reset("not-talking");
+		}
+		return;
+	}
+}
+
+void on_talk(const coop::proto::CampaignEvent& event)
+{
+	const std::vector<u8>& b = event.payload;
+	if (b.size() < 14)
+		return;
+	coop::proto::EntityRef ref;
+	for (int i = 0; i < 8; ++i)
+		ref.id |= u64(b[i]) << (8 * i);
+	for (int i = 0; i < 4; ++i)
+		ref.generation |= u32(b[8 + i]) << (8 * i);
+	PayloadReader r(b);
+	r.at = 12;
+	const u8 state = r.get<u8>(); // the body after it is the state's own
+	Link::Talk& t = g_link->talk;
+	const u16 npc_id = id_of(ref);
+	if (state == 1)
+	{
+		const u8 flags = r.get<u8>();
+		t.pending = false;
+		CInventoryOwner* partner = npc_id != 0xffff ? smart_cast<CInventoryOwner*>(Level().Objects.net_Find(npc_id)) : nullptr;
+		CUIGameSP* ui = smart_cast<CUIGameSP*>(CurrentGameUI());
+		if (!partner || !ui || !g_actor)
+		{
+			g_link->log.line("talk-open-failed npc=%I64u/%u local=%u partner=%d ui=%d", ref.id, ref.generation, u32(npc_id),
+				partner ? 1 : 0, ui ? 1 : 0);
+			// the server holds a talk this client cannot show: end it
+			t.npc_ref = ref;
+			request_ownership(coop::proto::kActionTalkEnd, ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, false, "unshowable");
+			return;
+		}
+		if (t.open && t.npc_ref == ref)
+			return; // told twice
+		t.open = true;
+		t.npc = npc_id;
+		t.npc_ref = ref;
+		t.topic_mode = true;
+		t.ids.clear();
+		t.opened_ms = g_link->wall.GetElapsed_ms();
+		++t.opens;
+		if (ui->TopInputReceiver())
+			ui->TopInputReceiver()->HideDialog();
+		ui->TalkMenu->RemoteBegin(partner);
+		ui->StartTalk((flags & 1) != 0);
+		g_link->log.line("talk-open npc=%u name=%s no_break=%d shown=%d", u32(npc_id), partner->Name(), flags & 1,
+			ui->TalkMenu->IsShown() ? 1 : 0);
+		return;
+	}
+	if (!t.open || !(t.npc_ref == ref))
+	{
+		if (state != 2)
+			g_link->log.line("talk-event-stale state=%u npc=%u open=%d", u32(state), u32(npc_id), t.open ? 1 : 0);
+		return;
+	}
+	CUITalkWnd* w = talk_window();
+	if (state == 2)
+	{
+		string64 why;
+		r.str(why, sizeof(why));
+		t.open = false;
+		t.path = 0;
+		++t.closes;
+		if (w)
+			w->RemoteClose();
+		g_link->log.line("talk-closed npc=%u why=%s after_ms=%u", u32(npc_id), why, g_link->wall.GetElapsed_ms() - t.opened_ms);
+		return;
+	}
+	if (state == 3)
+	{
+		const u8 ours = r.get<u8>();
+		string1024 text;
+		r.str16(text, sizeof(text));
+		if (!r.ok)
+			return;
+		++t.answers;
+		if (!ours)
+			t.last_npc_text = text;
+		if (w)
+			w->RemoteAnswer(text, ours != 0);
+		g_link->log.line("talk-answer npc=%u ours=%u text=%s", u32(npc_id), u32(ours), text);
+		return;
+	}
+	if (state == 4)
