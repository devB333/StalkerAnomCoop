+// S02-T03c: evaluate the neutral stalker's bones over 50 server ticks. The
+// normal client runs the same capture with -s02-bone-capture.
+void AdvanceCampaignClockOneTick(void*)
+{
+    R_ASSERT2(g_campaign_clock->Advance(g_campaign_clock->NextTickWallMs()) == 1,
+        "Bone capture expects exactly one server tick per step");
+}
+
+bool RunCampaignBoneCapture()
+{
+    string_path out;
+    FS.update_path(out, "$logs$", "s02-t03c-bones.csv");
+    BoneCaptureSummary summary;
+    const bool ok = CaptureModelBones("actors\\stalker_neutral\\stalker_neutral_1", 50,
+        &AdvanceCampaignClockOneTick, nullptr, out, summary);
+    Msg("S02-T03c bones model=actors\\stalker_neutral\\stalker_neutral_1 motion=%s bones=%u steps=%u "
+        "max_translation=%.6f finite=%d out=%s",
+        summary.motion, summary.bones, summary.steps, summary.max_translation, summary.finite ? 1 : 0, out);
+    return ok;
+}
