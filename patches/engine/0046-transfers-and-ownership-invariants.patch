+		push_ref(params, from_ref);
+		push_ref(params, to_ref);
+		ownership_intent(coop::proto::kActionTransfer, item, item_ref, params);
+		return;
+	}
+	// GE_OWNERSHIP_REJECT
+	CObject* owner = Level().Objects.net_Find(destination);
+	if (!owner || smart_cast<CInventoryItem*>(owner))
+	{
+		++g_link->ownership_events_ignored; // a weapon's or a missile's own reject: not a drop
+		return;
+	}
+	if (!ref_of(item, item_ref))
+	{
+		++g_link->ownership_events_ignored;
+		g_link->log.line("drop-unknown item=%u owner=%u", u32(item), u32(destination));
+		return;
+	}
+	ownership_intent(coop::proto::kActionDrop, item, item_ref, xr_vector<u8>());
