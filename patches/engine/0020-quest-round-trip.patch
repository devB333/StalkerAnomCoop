@@ -0,0 +1,812 @@
+#include "pch_script.h"
+#include "CampaignQuestCapture.h"
+
+// S02-T06e: see CampaignQuestCapture.h. The fixture adds nothing to the task
+// system: it drives the installed dialogue functions with the real actor and
+// the real NPC, spawns the fetch item the way a script would, and reads the
+// native and Lua task state back.
+
+#include "Level.h"
+#include "Actor.h"
+#include "ai_space.h"
+#include "alife_simulator.h"
+#include "alife_object_registry.h"
