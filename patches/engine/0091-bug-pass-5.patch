+// S10-T07 (B23, part 5): the frame rate near the campfires. Once a second, if
+// a frame took more than 40 ms or a lit fire is within 30 m of the camera:
+// the frames, the slowest one and the number over 50 ms (wall clock, not the
+// engine's clamped delta), the nearest lit fire and whether its light and
+// shadow are on, the lit and shadowed fire lights and the console settings.
+void frame_trace()
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	const u32 ms = g_link->frame_prev_ms ? now - g_link->frame_prev_ms : 0;
+	g_link->frame_prev_ms = now;
+	if (g_link->world != WorldLive || !g_pGameLevel || !g_actor)
+	{
+		g_link->frame_window_ms = now;
+		return;
+	}
+	++g_link->frame_count;
+	g_link->frame_max_ms = _max(g_link->frame_max_ms, ms);
+	if (ms > 50)
+		++g_link->frame_slow;
+	if (now - g_link->frame_window_ms < 1000)
+		return;
+	float nearest = flt_max;
+	int nearest_light = 0, nearest_shadow = 0;
+	u32 lit = 0, shadowed = 0;
+	for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+	{
+		CZoneCampfire* fire = smart_cast<CZoneCampfire*>(Level().Objects.o_get_by_iterator(i));
+		if (!fire || !fire->is_on())
+			continue;
+		lit += fire->idle_light_lit() ? 1 : 0;
+		shadowed += fire->idle_light_shadowed() ? 1 : 0;
+		const float d = fire->Position().distance_to(Device.vCameraPosition);
+		if (d < nearest)
+		{
+			nearest = d;
+			nearest_light = fire->idle_light_lit() ? 1 : 0;
+			nearest_shadow = fire->idle_light_shadowed() ? 1 : 0;
+		}
+	}
+	if ((g_link->frame_max_ms > 40 || nearest < 30.f) && g_link->frame_traces < 2400)
+	{
+		++g_link->frame_traces;
+		g_link->log.line("frame-trace frames=%u max_ms=%u slow=%u fire_m=%.1f fire_light=%d fire_shadow=%d lit=%u "
+			"shadowed=%u set_light=%d set_shadow=%.1f", g_link->frame_count, g_link->frame_max_ms, g_link->frame_slow,
+			nearest < flt_max ? nearest : -1.f, nearest_light, nearest_shadow, lit, shadowed, g_coop_campfire_light,
+			g_coop_campfire_shadow);
+	}
+	g_link->frame_window_ms = now;
+	g_link->frame_count = g_link->frame_slow = g_link->frame_max_ms = 0;
+}
