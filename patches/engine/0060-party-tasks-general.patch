+// The general party-task fixture (profile task_party; a server kill and
+// restart between its two halves, -ServerKill / -ServerRestartAfter):
+//   accepted   (the first run) both placed at Sidorovich; p2 accepts the
+//              bounty esc_m_trader_task_2 through party_accept_task (the
+//              installed accept phrases pick the target: bounties_by_id);
+//              a checkpoint is requested
+//   recovered  (the restarted server) the task was rebuilt as the party's;
+//              the target is killed by p2 (KillEntity by p2's actor when it
+//              is online, alife kill_entity otherwise); once the installed
+//              status functor stages the task, p2 turns it in through
+//              party_turn_in_task: quest-completed, a quest-paid of the same
+//              sum for each player, a quest-goodwill for each
+//   item-probe an item reward (xr_effects.reward_item 'bandage' in p1's
+//              context under a probe turn-in) is given to both
+//   death-probe a stalker spawned beside p1 and killed by p2: the installed
+//              npc_on_death_callback saw AC_ID == who == p2 (T05b-3)
+const char* const kTaskFixtureId = "esc_m_trader_task_2";
