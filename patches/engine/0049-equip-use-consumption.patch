+// The adapter (absolute post-state, idempotent): the recorded item is in the
+// recorded place of the recorded actor's inventory.
+PickupApply apply_equip(const EquipRecord& r, LPCSTR phase, u64 revision)
+{
+	const u16 actor_id = engine_id_of_entity(r.actor_entity);
+	CActor* actor = actor_id != kNoEngineId ? smart_cast<CActor*>(Level().Objects.net_Find(actor_id)) : nullptr;
+	const u16 id = engine_id_of_entity(r.item_entity);
+	CObject* object = id != kNoEngineId ? Level().Objects.net_Find(id) : nullptr;
+	CInventoryItem* item = object ? smart_cast<CInventoryItem*>(object) : nullptr;
+	LPCSTR why = nullptr;
+	if (actor_id == kNoEngineId)
+		why = "actor-gone"; // respawned since: its old inventory is a corpse's
+	else if (id == kNoEngineId || g_host->consumed_entities.count(r.item_entity))
+		why = "item-gone"; // used up or released after the record
+	if (why)
+	{
+		g_host->log.line("equip-%s-noop revision=%I64u item_entity=%I64u reason=%s", phase, revision, r.item_entity, why);
+		inventory_csv("equip", "noop", revision, r.slot, r.operation, r.item_entity, id, r.actor_entity, r.place,
+			r.inv_slot, 0, 0, "-", 0);
+		return PickupApply::NoOp;
+	}
+	CSE_Abstract* se = Level().Server->ID_to_entity(id);
+	if (!actor || !item || !is_object_valid_on_svclient(actor_id) || !is_object_valid_on_svclient(id))
+		return PickupApply::Deferred;
+	if (!se || se->ID_Parent != actor_id)
+	{
+		g_host->log.line("equip-%s-noop revision=%I64u item_entity=%I64u reason=not-owned parent=%u", phase, revision,
+			r.item_entity, se ? u32(se->ID_Parent) : 0xffffu);
+		return PickupApply::NoOp; // moved out of the actor after the record (a later record says where)
+	}
+	if (object->H_Parent() != actor)
+		return PickupApply::Deferred; // the level not yet caught up with the server's parent
+	CInventory& inventory = actor->inventory();
+	if (item->CurrPlace() == r.place && (r.place != kPlaceSlot || item->CurrSlot() == r.inv_slot))
+	{
+		g_host->log.line("equip-%s-noop revision=%I64u item=%u item_entity=%I64u reason=already-there", phase, revision,
+			u32(id), r.item_entity);
+		expect_place(r, object->cNameSect().c_str());
+		return PickupApply::NoOp;
+	}
+	bool ok = false;
+	if (r.place == kPlaceSlot)
+	{
+		// at replay the slot may still hold the item a later record moves out:
+		// the record's own item wins, the other goes to the ruck
+		if (xr_strcmp(phase, "apply"))
+			if (PIItem occupant = inventory.ItemFromSlot(r.inv_slot))
+				if (occupant != item)
+					inventory.Ruck(occupant);
+		ok = inventory.Slot(r.inv_slot, item, (r.flags & 1) != 0);
+	}
+	else if (r.place == kPlaceBelt)
+		ok = inventory.Belt(item);
+	else
+		ok = inventory.Ruck(item);
+	ok = ok && item->CurrPlace() == r.place && (r.place != kPlaceSlot || item->CurrSlot() == r.inv_slot);
+	expect_place(r, object->cNameSect().c_str());
+	g_host->log.line("equip-%s revision=%I64u slot=%u operation=%I64u item=%u item_entity=%I64u place=%s inv_slot=%u "
+		"ok=%d", phase, revision, u32(r.slot), r.operation, u32(id), r.item_entity, place_name(r.place),
+		u32(r.inv_slot), ok ? 1 : 0);
+	inventory_csv("equip", ok ? phase : "apply-failed", revision, r.slot, r.operation, r.item_entity, id,
+		r.actor_entity, r.place, r.inv_slot, 0, 0, object->cNameSect().c_str(), ok ? 0 : 3);
+	return ok ? PickupApply::Applied : PickupApply::Failed;
+}
