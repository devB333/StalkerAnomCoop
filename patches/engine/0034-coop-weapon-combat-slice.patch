+// S06-T04 fixtures (profile arm, combat_heal) and the combat record.
+// An item for an online parent: the path of the script's alife():create with
+// a parent (alife_simulator_script.cpp, CALifeSimulator__spawn_item2). The
+// item goes through the server's spawn, which registers it with ALife and
+// with its parent once; spawn_item with registration on an online parent
+// would list it twice among the parent's children.
+void give_item(CALifeSimulator* alife, LPCSTR section, CActor* actor, const CSE_ALifeDynamicObject* se)
+{
+	NET_Packet packet;
+	packet.w_begin(M_SPAWN);
+	packet.w_stringZ(section);
+	CSE_Abstract* item = alife->spawn_item(section, se->o_Position, se->m_tNodeID, se->m_tGraphID, u16(actor->ID()), false);
+	if (!item)
+		return;
+	item->Spawn_Write(packet, FALSE);
+	alife->server().FreeID(item->ID, 0);
+	F_entity_Destroy(item);
+	ClientID client;
+	client.set(0xffff);
+	u16 dummy;
+	packet.r_begin(dummy);
+	alife->server().Process_spawn(packet, client);
+}
+
+void combat_fixtures()
+{
+	if (!ai().get_alife())
+		return;
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	for (PlayerLink& link : g_host->links)
+	{
+		CActor* actor = link.bound ? participant_actor(link.ref) : nullptr;
+		if (!actor || !actor->g_Alive())
+			continue;
+		if (g_host->config.arm && !link.armed)
+		{
+			const CSE_ALifeDynamicObject* se = ai().alife().objects().object(u16(actor->ID()), true);
+			if (!se || !se->m_bOnline)
+				continue;
+			link.armed = true;
+			const bool has = actor->inventory().ItemFromSlot(INV_SLOT_2) != nullptr;
+			if (!has)
+				give_item(alife, "wpn_pm", actor, se);
+			give_item(alife, "ammo_9x18_fmj", actor, se);
+			give_item(alife, "ammo_9x18_fmj", actor, se);
+			g_host->log.line("arm slot=%u actor=%u %s +2x ammo_9x18_fmj", u32(link.ref.slot), u32(actor->ID()),
+				has ? actor->inventory().ItemFromSlot(INV_SLOT_2)->object().cNameSect().c_str() : "wpn_pm");
+		}
+		// a pistol that arrived in the backpack goes to its slot
+		if (g_host->config.arm && !actor->inventory().ItemFromSlot(INV_SLOT_2))
+			for (PIItem item : actor->inventory().m_ruck)
+				if (item->BaseSlot() == INV_SLOT_2 && actor->inventory().CanPutInSlot(item, INV_SLOT_2))
+				{
+					actor->inventory().Slot(INV_SLOT_2, item, true); // not drawn
+					g_host->log.line("arm slot=%u actor=%u %s to slot 2", u32(link.ref.slot), u32(actor->ID()),
+						item->object().cNameSect().c_str());
+					break;
+				}
+		if (g_host->config.combat_heal && actor->GetfHealth() < 0.4f)
+		{
+			++g_host->heals;
+			g_host->log.line("heal slot=%u actor=%u health=%.3f -> 1.000 (fixture)", u32(link.ref.slot),
+				u32(actor->ID()), actor->GetfHealth());
+			actor->SetfHealth(1.f);
+		}
+	}
+}
