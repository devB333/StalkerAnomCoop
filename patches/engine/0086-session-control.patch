+// S10-T06 driver (config session_script): 1 the owner, 2 the partner
+void session_driver()
+{
+	Link::Session& s = g_link->session;
+	const u32 script = g_link->config.session_script;
+	if (!script || s.phase >= 99 || g_link->world != WorldLive || !g_actor)
+		return;
+	const u32 now = g_link->wall.GetElapsed_ms();
+	auto next = [&s, now](u32 phase, u32 wait_ms) {
+		s.phase = phase;
+		s.phase_ms = now + wait_ms;
+		g_link->log.line("session-driver phase=%u", phase);
+	};
+	if (s.phase == 0)
+	{
+		s.first = g_link->config.campaign_id;
+		s.first_hex = coop_uuid_hex(s.first).c_str();
+		next(1, script == 1 ? 60000 : 10000);
+		return;
+	}
+	if (now < s.phase_ms)
+		return;
+	if (script == 2)
+	{
+		if (s.phase == 1)
+		{
+			session_driver_create("bandit", "rookie_village", "Partner_Two", kSessionPartnerLoadout); // kept as its loadout
+			next(2, 6000);
+		}
+		else if (s.phase == 2)
+		{
+			campaign::coop_client_session_load(s.first_hex.c_str()); // refused: not the owner
+			next(99, 0);
+		}
+		return;
+	}
+	switch (s.phase)
+	{
+	case 1:
+		campaign::coop_client_session_list();
+		next(2, 5000);
+		break;
+	case 2:
+		// over the points and an item the faction is not offered: refused
+		session_driver_create("stalker", "skadovsk_shipwreck", "Owner_One",
+			"helm_resp,novice_outfit,wpn_svt40,wpn_svt40,wpn_ump45,wpn_gauss");
+		next(3, 8000);
+		break;
+	case 3:
+		session_driver_create("stalker", "skadovsk_shipwreck", "Owner_One", kSessionOwnerLoadout);
+		next(4, 0);
+		break;
+	case 4:
+		// on the new campaign once its world is live
+		if (g_link->config.campaign_id != s.first && s.live_count >= 2)
+			next(5, 45000);
+		break;
+	case 5:
+		campaign::coop_client_session_list();
+		next(6, 5000);
+		break;
+	case 6:
+		campaign::coop_client_session_load(s.first_hex.c_str());
+		next(7, 0);
+		break;
+	case 7:
+		if (g_link->config.campaign_id == s.first && s.live_count >= 3)
+			next(8, 20000);
+		break;
+	case 8:
+		campaign::coop_client_session_list();
+		g_link->log.line("session-driver done campaign=%s lives=%u switches=%u", s.first_hex.c_str(), s.live_count,
+			s.switches);
+		next(99, 0);
+		break;
+	default: break;
+	}
+}
