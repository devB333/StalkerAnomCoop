+// ------------------------------------------------------------ S09-T01
+// Party travel: the request and two-player consent as a client sees them
+// (docs/travel-contract.md). Touching a level changer prompts the player
+// (USE asks the partner, DROP stays); the server's proposal (CampaignEvent
+// 13) prompts the partner (USE goes, DROP refuses) and tells the requester
+// to wait (DROP cancels); the end of a proposal is shown. Requests and
+// answers are ActionIntents (kinds 11, 12) on the pending-request queue, so
+// an unanswered one is re-sent with the same id. The client never changes
+// level by itself: the native change-level path stays refused.
+
+const u32 kTravelPromptMs = 6000;    // the changer prompt stays this long (the engine re-touches every 5 s)
+const u32 kTravelDismissMs = 20000;  // a declined changer does not prompt again for this long
+
+void travel_hud(LPCSTR text, int seconds)
+{
+	luabind::functor<void> set_msg;
+	if (ai().script_engine().functor("actor_menu.set_msg", set_msg))
+		set_msg(1, text, seconds);
+	g_link->log.line("travel-hud text=\"%s\"", text);
+}
+
+u64 request_travel(const coop::proto::EntityRef& changer, u32 round, bool player, LPCSTR why)
+{
+	++g_link->travel.requests;
+	return request_ownership(coop::proto::kActionTravelRequest, changer, xr_vector<u8>(), 0, round, 0, player, why);
+}
+
+u64 answer_travel(u64 id, u8 answer, u32 round, bool player, LPCSTR why)
+{
+	xr_vector<u8> params;
+	for (int b = 0; b < 8; ++b)
+		params.push_back(u8(id >> (8 * b)));
+	params.push_back(answer);
+	++g_link->travel.answers;
+	g_link->log.line("travel-answer-sent id=%I64x answer=%u why=%s", id, u32(answer), why);
+	return request_ownership(coop::proto::kActionTravelAnswer, coop::proto::EntityRef(), params, 0, round, 0, player,
+		why);
+}
+
+// A new connection: a proposal held from the last one is void (the server
+// aborted it when the session ended; a rejoin starts over).
+void travel_session_reset()
+{
+	if (g_link->travel.live_id)
+	{
+		g_link->log.line("travel-session-reset live=%I64x", g_link->travel.live_id);
+		g_link->travel.prev_id = g_link->travel.live_id;
+		g_link->travel.live_id = 0;
+	}
+	g_link->travel.prompt_changer = 0xffff;
+}
+
+void on_travel(const coop::proto::CampaignEvent& event)
+{
+	const std::vector<u8>& b = event.payload;
+	if (b.size() < 21)
+		return;
+	u64 id = 0, changer = 0;
+	for (int i = 0; i < 8; ++i)
+		id |= u64(b[i]) << (8 * i);
+	const u8 state = b[8], requester = b[9], partner = b[10], abort = b[11];
+	for (int i = 0; i < 8; ++i)
+		changer |= u64(b[12 + i]) << (8 * i);
+	const u8 len = b[20];
+	if (len > 100 || b.size() != 21 + size_t(len) + 12 + 4)
+		return;
+	string128 level;
+	memcpy(level, b.data() + 21, len);
+	level[len] = 0;
+	u32 remaining = 0;
+	memcpy(&remaining, b.data() + 21 + len + 12, 4);
+	++g_link->travel.events;
+	g_link->log.line("travel-event id=%I64x state=%u requester=%u partner=%u abort=%u changer=%I64u level=%s "
+		"remaining_ms=%u me=%u",
+		id, u32(state), u32(requester), u32(partner), u32(abort), changer, level, remaining, u32(g_link->local_slot));
+	Link::Travel& t = g_link->travel;
+	string256 text;
+	if (state == 1)
+	{
+		if (t.live_id && t.live_id != id)
+			t.prev_id = t.live_id;
+		t.live_id = id;
+		t.requester = requester;
+		t.partner = partner;
+		t.level = level;
+		t.deadline_ms = g_link->wall.GetElapsed_ms() + remaining;
+		t.prompt_changer = 0xffff;
+		t.hud_ms = g_link->wall.GetElapsed_ms();
+		if (g_link->local_slot == requester)
+			xr_sprintf(text, "Waiting for Player %u to agree to travel to %s (%u s). DROP cancels.", u32(partner) + 1,
+				level, remaining / 1000);
+		else
+			xr_sprintf(text, "Player %u wants to travel to %s. USE to go along, DROP to refuse.", u32(requester) + 1,
+				level);
+		travel_hud(text, int(remaining / 1000) + 1);
+		return;
+	}
+	if (id == t.live_id)
+	{
+		t.prev_id = t.live_id;
+		t.live_id = 0;
+	}
+	t.last_end = state;
+	LPCSTR what = state == 2 ? "agreed" : state == 3 ? "refused" : state == 4 ? "expired" : state == 5 ? "cancelled" :
+		state == 6 ? "aborted" : "ended";
+	LPCSTR why = abort == 1 ? " (the requester left)" : abort == 2 ? " (the partner left)" :
+		abort == 3 ? " (the requester died)" : abort == 4 ? " (the partner died)" : abort == 5 ? " (combat)" :
+		abort == 6 ? " (the passage is gone)" : "";
+	if (state == 2)
+		xr_sprintf(text, "Travel to %s agreed by both players. (The level change itself is not in this build.)", level);
+	else
+		xr_sprintf(text, "Travel to %s %s%s.", level, what, why);
+	travel_hud(text, 6);
+}
+
+// A level changer touched by this client's own actor (CLevelChanger on a
+// co-op client): the prompt, unless a proposal is up or the player declined
+// this passage a moment ago.
+void travel_changer_touched(u16 changer, u16 actor, LPCSTR level, LPCSTR invite)
+{
+	if (g_link->world != WorldLive || !g_actor || actor != g_actor->ID() || !g_actor->g_Alive())
+		return;
+	Link::Travel& t = g_link->travel;
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (t.live_id)
+		return;
+	if (t.dismissed_changer == changer && now - t.dismissed_ms < kTravelDismissMs)
+		return;
+	if (t.prompt_changer == changer && now - t.prompt_ms < 4000)
+		return;
+	t.prompt_changer = changer;
+	t.prompt_ms = now;
+	t.prompt_level = level;
+	++t.prompts;
+	string256 text;
+	xr_sprintf(text, "Travel to %s? USE asks your partner to come along, DROP stays.", level);
+	travel_hud(text, int(kTravelPromptMs / 1000));
+	g_link->log.line("travel-prompt changer=%u level=%s invite=%s", u32(changer), level, invite);
+}
+
+bool travel_key_press(int key)
+{
+	if (!g_link || !g_link->active || g_link->world != WorldLive || !g_actor)
+		return false;
+	const EGameActions action = get_binded_action(key);
+	if (action != kUSE && action != kDROP)
+		return false;
+	Link::Travel& t = g_link->travel;
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (t.live_id)
+	{
+		if (g_link->local_slot == t.partner)
+		{
+			answer_travel(t.live_id, action == kUSE ? 1 : 2, 0xffffffff, true, action == kUSE ? "use-key" : "drop-key");
+			return true;
+		}
+		if (g_link->local_slot == t.requester && action == kDROP)
+		{
+			answer_travel(t.live_id, 3, 0xffffffff, true, "drop-key");
+			return true;
+		}
+		return false;
+	}
+	if (t.prompt_changer == 0xffff || now - t.prompt_ms > kTravelPromptMs)
+		return false;
+	const u16 changer = t.prompt_changer;
+	t.prompt_changer = 0xffff;
+	if (action == kDROP)
+	{
+		t.dismissed_changer = changer;
+		t.dismissed_ms = now;
+		g_link->log.line("travel-prompt-declined changer=%u", u32(changer));
+		travel_hud("You stay.", 3);
+		return true;
+	}
+	const auto ref = g_link->refs.find(changer);
+	if (ref == g_link->refs.end())
+	{
+		g_link->log.line("travel-prompt-unknown-changer id=%u", u32(changer));
+		return true;
+	}
+	request_travel(ref->second, 0xffffffff, true, "use-key");
+	travel_hud("Asking your partner...", 4);
+	return true;
+}
+
+void travel_frame()
+{
+	Link::Travel& t = g_link->travel;
+	if (!t.live_id)
+		return;
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (g_link->local_slot == t.requester && now - t.hud_ms >= 5000 && now < t.deadline_ms)
+	{
+		t.hud_ms = now;
+		string256 text;
+		xr_sprintf(text, "Waiting for Player %u to agree to travel to %s (%u s). DROP cancels.", u32(t.partner) + 1,
+			t.level.c_str(), (t.deadline_ms - now) / 1000);
+		travel_hud(text, 6);
+	}
+	if (now > t.deadline_ms + 10000)
+	{
+		// no end event within 10 s of the deadline (a lost session): void
+		g_link->log.line("travel-stale-proposal id=%I64x", t.live_id);
+		t.prev_id = t.live_id;
+		t.live_id = 0;
+	}
+}
+
+void travel_result(const Link::PickupPending& p, const coop::proto::ActionResult& result)
+{
+	const bool accepted = result.outcome == coop::proto::ActionOutcome::Accepted;
+	if (accepted)
+		++g_link->travel.accepted;
+	else if (result.outcome == coop::proto::ActionOutcome::Rejected)
+		++g_link->travel.refused;
+	g_link->log.line("travel-result kind=%u round=%d step=%d operation=%I64x outcome=%u reason=%u transition=%I64x",
+		u32(p.action), int(p.round), int(p.step), p.operation, u32(result.outcome), u32(result.reason), result.revision);
+	if (!p.player || accepted || result.outcome != coop::proto::ActionOutcome::Rejected)
+		return;
+	switch (result.reason)
+	{
+	case coop::proto::kReasonTravelBusy: travel_hud("A travel request is already up.", 4); break;
+	case coop::proto::kReasonNoChanger: travel_hud("That passage is closed.", 4); break;
+	case coop::proto::kReasonNotAtChanger: travel_hud("Stand in the passage to travel.", 4); break;
+	case coop::proto::kReasonPartnerUnavailable: travel_hud("Your partner is not here: you travel together.", 5); break;
+	case coop::proto::kReasonInCombat: travel_hud("Not while something is hunting you.", 4); break;
+	case coop::proto::kReasonNoTransition: travel_hud("That travel request is no longer open.", 4); break;
+	case coop::proto::kReasonWrongParty: travel_hud("That answer is not yours to give.", 4); break;
+	default: travel_hud("You can't travel now.", 4); break;
+	}
+}
