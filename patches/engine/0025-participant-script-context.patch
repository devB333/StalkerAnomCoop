+};
+
+enum Phase
+{
+	PhaseDeferred,
+	PhaseApproach,
+	PhaseObserve,
+	PhaseStage2,
+	PhaseComplete2,
+	PhaseStage1,
+	PhaseComplete1,
+	PhaseDone,
+};
+
+LPCSTR phase_name(int phase)
+{
+	switch (phase)
+	{
+	case PhaseDeferred: return "deferred";
+	case PhaseApproach: return "approach";
+	case PhaseObserve: return "observe";
+	case PhaseStage2: return "stage-2";
+	case PhaseComplete2: return "complete-2";
+	case PhaseStage1: return "stage-1";
+	case PhaseComplete1: return "complete-1";
+	case PhaseDone: return "done";
+	default: return "contract";
+	}
+}
+
+struct Fixture
+{
+	bool running = false;
+	bool ok = true;
+	FILE* out = nullptr;
+	u32 tick = 0;
+	u32 checks = 0;
+	u32 failures = 0;
+	int phase = -1;
+	u32 phase_tick = 0;
+	ParticipantRef p1, p2;
+	PartyId party1, party2;
+	u16 actor1 = no_id;
+	u16 actor2 = no_id;
+	u16 giver = no_id;
+	ActionContext ctx1, ctx2;
+	QuestRun quest[2]; // [0] participant 2, [1] participant 1
+};
+
+Fixture g_fixture;
+
+void row(LPCSTR format, ...)
+{
+	if (!g_fixture.out)
+		return;
+	va_list args;
+	va_start(args, format);
+	vfprintf(g_fixture.out, format, args);
+	va_end(args);
+	fputc('\n', g_fixture.out);
+	fflush(g_fixture.out);
+}
+
+bool check(bool condition, LPCSTR what)
+{
+	Fixture& f = g_fixture;
+	++f.checks;
+	if (!condition)
+	{
+		++f.failures;
+		f.ok = false;
+		Msg("! S03-T05 script-context check failed (%s): %s", phase_name(f.phase), what);
+	}
+	row("check,%s,%d,%s", phase_name(f.phase), condition ? 1 : 0, what);
+	return condition;
+}
+
+bool expect_refusal(Refusal observed, Refusal expected, LPCSTR what)
+{
+	row("refusal,%s,%s,%s", what, refusal_name(expected), refusal_name(observed));
+	return check(observed == expected, what);
+}
+
+CActor* actor_by_id(u16 id)
+{
+	if (id == no_id || !g_pGameLevel)
+		return nullptr;
+	CObject* object = Level().Objects.net_Find(id);
+	return object && !object->getDestroy() ? smart_cast<CActor*>(object) : nullptr;
+}
+
+CGameObject* giver_object()
+{
+	if (g_fixture.giver == no_id)
+		return nullptr;
+	CObject* object = Level().Objects.net_Find(g_fixture.giver);
+	return object && !object->getDestroy() ? smart_cast<CGameObject*>(object) : nullptr;
+}
+
+u32 money_of(u16 id)
+{
+	CActor* actor = actor_by_id(id);
+	return actor ? actor->get_money() : 0;
+}
+
+int goodwill_of(u16 id, LPCSTR community)
+{
+	CHARACTER_COMMUNITY c;
+	c.set(community);
+	return int(RELATION_REGISTRY().GetCommunityGoodwill(c.index(), id));
+}
+
+bool info_of(u16 id, LPCSTR info)
+{
+	CActor* actor = actor_by_id(id);
+	return actor && actor->HasInfo(info);
+}
+
+u32 items_of(u16 id, LPCSTR section)
+{
+	CActor* actor = actor_by_id(id);
+	if (!actor || !section || !section[0])
+		return 0;
+	u32 count = 0;
+	for (PIItem item : actor->inventory().m_all)
+		if (item && xr_strcmp(item->object().cNameSect_str(), section) == 0)
+			++count;
+	return count;
+}
+
+u32 outbox_size(u8 slot)
+{
+	xr_vector<PresentationRecord> records;
+	return presentation_outbox(slot, records);
+}
+
+u32 outbox_count(u8 slot, Presentation kind)
+{
+	xr_vector<PresentationRecord> records;
+	presentation_outbox(slot, records);
+	u32 count = 0;
+	for (const PresentationRecord& record : records)
+		if (record.kind == kind)
+			++count;
+	return count;
+}
