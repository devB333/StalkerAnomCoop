+			persistence->failure());
+		g_host->stop_requested = true;
+		return;
+	}
+	coop::store::failpoint("death:after-commit");
+	++g_host->deaths_committed;
+	death_csv("commit", revision, record, id);
+	g_host->log.line("death-committed revision=%I64u slot=%u id=%u entity=%I64u killer=%I64u section=%s", revision,
+		u32(record.slot), u32(id), ref.id, record.killer, victim->cNameSect().c_str());
