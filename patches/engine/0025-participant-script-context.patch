+// --- presentation -------------------------------------------------------------------
+
+LPCSTR presentation_name(Presentation kind)
+{
+	switch (kind)
+	{
+	case Presentation::DialogOpen: return "dialog-open";
+	case Presentation::DialogClose: return "dialog-close";
+	case Presentation::News: return "news";
+	case Presentation::TalkMessage: return "talk-message";
+	case Presentation::CameraEffector: return "camera-effector";
+	case Presentation::CameraEffectorRemove: return "camera-effector-remove";
+	case Presentation::PostProcess: return "post-process";
+	case Presentation::PostProcessRemove: return "post-process-remove";
+	case Presentation::GameOver: return "game-over";
+	default: return "?";
+	}
+}
+
+Refusal present(const ParticipantRef& to, Presentation kind, u16 object, LPCSTR detail)
+{
+	if (!server_role())
+		return Refusal::WrongRole;
+	const Participant* participant = nullptr;
+	const Refusal refusal = g_campaign_identity->participant(to, participant);
+	if (refusal != Refusal::None || to.slot >= kOutboxSlots)
+	{
+		++s_present_dropped;
+		return refusal != Refusal::None ? refusal : Refusal::UnknownParticipant;
+	}
+	xr_vector<PresentationRecord>& outbox = s_outbox[to.slot];
+	if (outbox.size() >= kOutboxCapacity)
+	{
+		outbox.erase(outbox.begin());
+		++s_present_dropped;
+	}
+	PresentationRecord record;
+	record.serial = ++s_present_serial;
+	record.participant = to;
+	record.kind = kind;
+	record.object = object;
+	record.frame = Device.dwFrame;
+	xr_strcpy(record.detail, detail ? detail : "");
+	outbox.push_back(record);
+	++s_stats.presented;
+	return Refusal::None;
+}
+
+Refusal present_to_context(Presentation kind, u16 object, LPCSTR detail)
+{
+	if (!server_role())
+		return Refusal::WrongRole;
+	ScriptContext context;
+	if (current_script_context(context) != Refusal::None)
+	{
+		++s_stats.present_no_context;
+		++s_present_dropped;
+		return Refusal::NoContext;
+	}
+	return present(context.action.actor, kind, object, detail);
+}
+
+Refusal present_to_actor(const CObject* actor, Presentation kind, u16 object, LPCSTR detail)
+{
+	if (!server_role())
+		return Refusal::WrongRole;
+	ParticipantRef ref;
+	const Refusal refusal = participant_of(actor, ref);
+	if (refusal != Refusal::None)
+	{
+		++s_present_dropped;
+		return refusal;
+	}
+	return present(ref, kind, object, detail);
+}
+
+u32 presentation_outbox(u8 slot, xr_vector<PresentationRecord>& out)
+{
+	out.clear();
+	if (slot < kOutboxSlots)
+		out = s_outbox[slot];
+	return u32(out.size());
+}
+
+u32 presentation_dropped()
+{
+	return s_present_dropped;
+}
