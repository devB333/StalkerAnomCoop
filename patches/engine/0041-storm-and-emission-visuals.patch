-			weather);
-		environment.SetWeather(weather, true);
+		g_link->log.line("environment cycle %s -> %s", env.CurrentCycleName.size() ? *env.CurrentCycleName : "-", cycle);
+		env.SetWeather(cycle, false);
 		++g_link->weather_changes;
 	}
+	CEnvDescriptor* d0 = find_descriptor(env, c0, exec0);
+	CEnvDescriptor* d1 = find_descriptor(env, c1, exec1);
+	if (d0 && d1)
+	{
+		if (env.Current[0] != d0 || env.Current[1] != d1)
+		{
+			env.Current[0] = d0;
+			env.Current[1] = d1;
+			if (++g_link->env_applied <= 40)
+				g_link->log.line("environment descriptors c0=%s@%.2f c1=%s@%.2f", c0, exec0, c1, exec1);
+		}
+	}
+	else if ((!env.Current[0] || !env.Current[1]) && cycle[0])
+		env.SetWeather(cycle, true);
+}
+
+void on_thunderbolt(const coop::proto::CampaignEvent& event)
+{
+	PayloadReader r(event.payload);
+	string256 id;
+	r.str(id, sizeof(id));
+	const u32 index = r.get<u32>();
+	const float life = r.get<float>();
+	const float lng = r.get<float>();
+	const float dist = r.get<float>();
+	Fvector dev;
+	dev.x = r.get<float>();
+	dev.y = r.get<float>();
+	dev.z = r.get<float>();
+	const bool second = r.get<u8>() != 0;
+	if (!r.ok || !id[0] || !_valid(life) || !_valid(lng) || !_valid(dist) || !_valid(dev) || life <= 0.f || life > 10.f ||
+		dist < 0.f || !g_pGamePersistent)
+		return;
+	CEffect_Thunderbolt* bolt = g_pGamePersistent->Environment().eff_Thunderbolt;
+	if (!bolt)
+		return;
+	bolt->remote_driven = true;
+	bolt->BoltRemote(id, index, life, lng, dist, dev, second);
+	++g_link->bolts;
+	g_link->log.line("bolt n=%I64u id=%s index=%u life=%.2f lng=%.2f dist=%.0f second=%d", g_link->bolts, id, index, life,
+		lng, dist, second ? 1 : 0);
+}
+
+static bool chatty_presentation(campaign::Presentation kind)
+{
+	return kind == campaign::Presentation::PostProcessFactor || kind == campaign::Presentation::SoundVolume ||
+		kind == campaign::Presentation::SoundPosition || kind == campaign::Presentation::ParticlesMove;
+}
+
+void on_presentation(const coop::proto::CampaignEvent& event)
+{
+	PayloadReader r(event.payload);
+	const u8 kind_byte = r.get<u8>();
+	const u16 object = r.get<u16>();
+	const u32 handle = r.get<u32>();
+	Fvector position;
+	position.x = r.get<float>();
+	position.y = r.get<float>();
+	position.z = r.get<float>();
+	const float value = r.get<float>();
+	const u32 flags = r.get<u32>();
+	const u32 serial = r.get<u32>();
+	string256 detail;
+	r.str(detail, sizeof(detail));
+	if (!r.ok || !_valid(position) || !_valid(value) || kind_byte >= u8(campaign::Presentation::Count))
+		return;
+	const campaign::Presentation kind = campaign::Presentation(kind_byte);
+	CActor* viewer = g_actor;
+	if (!viewer)
+		return;
+	++g_link->presentations;
+	const char* applied = "applied";
+	switch (kind)
+	{
+	case campaign::Presentation::CameraEffector:
+	{
+		CAnimatorCamEffectorScriptCB* e = xr_new<CAnimatorCamEffectorScriptCB>("");
+		if (position.x > 0.f)
+		{
+			e->m_bAbsolutePositioning = true;
+			e->m_fov = position.x;
+		}
+		if (value > 0.f)
+			e->SetPower(value);
+		if (position.y > 0.f)
+			e->SetSpeed(position.y);
+		e->SetHudAffect((flags & 2) != 0);
+		e->SetType((ECamEffectorType)object);
+		e->SetCyclic((flags & 1) != 0);
+		e->Start(detail);
+		viewer->Cameras().AddCamEffector(e);
+		break;
+	}
+	case campaign::Presentation::CameraEffectorRemove:
+		viewer->Cameras().RemoveCamEffector((ECamEffectorType)object);
+		break;
+	case campaign::Presentation::PostProcess:
+	{
+		CPostprocessAnimator* pp = xr_new<CPostprocessAnimator>(int(object), (flags & 1) != 0);
+		pp->Load(detail);
+		viewer->Cameras().AddPPEffector(pp);
+		break;
+	}
+	case campaign::Presentation::PostProcessRemove:
+	{
+		CPostprocessAnimator* pp = smart_cast<CPostprocessAnimator*>(viewer->Cameras().GetPPEffector((EEffectorPPType)object));
+		if (pp)
+			pp->Stop(1.0f);
+		else
+			applied = "absent";
+		break;
+	}
+	case campaign::Presentation::PostProcessFactor:
+	{
+		CPostprocessAnimator* pp = smart_cast<CPostprocessAnimator*>(viewer->Cameras().GetPPEffector((EEffectorPPType)object));
+		if (pp)
+			pp->SetDesiredFactor(value, position.x);
+		else
+			applied = "absent";
+		break;
+	}
+	case campaign::Presentation::Sound:
+	case campaign::Presentation::SoundAtPos:
+	{
+		ref_sound& sound = g_link->sounds[handle];
+		if (!sound._handle())
+		{
+			string_path path;
+			if (!detail[0] || !FS.exist(path, "$game_sounds$", detail, ".ogg"))
+			{
+				g_link->sounds.erase(handle);
+				++g_link->sounds_missing;
+				applied = "missing";
+				break;
+			}
+			sound.create(detail, st_Effect, SOUND_TYPE_NO_SOUND);
+		}
+		if (kind == campaign::Presentation::Sound)
+			sound.play(viewer, flags, value);
+		else
+			sound.play_at_pos(viewer, position, flags, value);
+		break;
+	}
+	case campaign::Presentation::SoundStop:
+	case campaign::Presentation::SoundStopDeferred:
+	case campaign::Presentation::SoundVolume:
+	case campaign::Presentation::SoundPosition:
+	{
+		auto it = g_link->sounds.find(handle);
+		if (it == g_link->sounds.end() || !it->second._handle())
+		{
+			applied = "absent";
+			break;
+		}
+		ref_sound& sound = it->second;
+		if (kind == campaign::Presentation::SoundStop)
+			sound.stop();
+		else if (kind == campaign::Presentation::SoundStopDeferred)
+			sound.stop_deffered();
+		else if (kind == campaign::Presentation::SoundVolume)
+			sound.set_volume(value);
+		else if (sound._feedback())
+			sound.set_position(position);
+		break;
+	}
+	case campaign::Presentation::Particles:
+	{
+		Link::Particles& entry = g_link->particles[handle];
+		if (!entry.object)
+		{
+			if (!detail[0])
+			{
+				g_link->particles.erase(handle);
+				applied = "missing";
+				break;
+			}
+			entry.object = xr_new<CScriptParticles>(detail);
+		}
+		entry.stopped = false;
+		entry.object->PlayAtPos(position);
+		break;
+	}
+	case campaign::Presentation::ParticlesMove:
+	case campaign::Presentation::ParticlesStop:
+	case campaign::Presentation::ParticlesStopDeferred:
+	{
+		auto it = g_link->particles.find(handle);
+		if (it == g_link->particles.end() || !it->second.object)
+		{
+			applied = "absent";
+			break;
+		}
+		if (kind == campaign::Presentation::ParticlesMove)
+		{
+			if (flags & 1)
+				it->second.object->XFORMMoveTo(position);
+			else
+				it->second.object->MoveTo(position, Fvector().set(0.f, 0.f, 0.f));
+		}
+		else
+		{
+			if (kind == campaign::Presentation::ParticlesStop)
+				it->second.object->Stop();
+			else
+				it->second.object->StopDeffered();
+			it->second.stopped = true;
+		}
+		break;
+	}
+	default:
+		++g_link->presentations_unknown;
+		applied = "unknown";
+		break;
+	}
+	if (!chatty_presentation(kind) || xr_strcmp(applied, "applied"))
+		g_link->log.line("present serial=%u kind=%s object=%u handle=%u detail=%s flags=%u value=%.3f pos=%.1f,%.1f,%.1f %s",
+			serial, campaign::presentation_name(kind), u32(object), handle, detail, flags, value, VPUSH(position), applied);
+}
+
+// Stopped particles are released once they have played out.
+static void sweep_particles()
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (now - g_link->last_particles_sweep_ms < 1000)
+		return;
+	g_link->last_particles_sweep_ms = now;
+	for (auto it = g_link->particles.begin(); it != g_link->particles.end();)
+	{
+		if (it->second.stopped && it->second.object && !it->second.object->IsPlaying())
+		{
+			xr_delete(it->second.object);
+			it = g_link->particles.erase(it);
+		}
+		else
+			++it;
+	}
+}
+
+void release_presentation()
+{
+	for (auto& entry : g_link->sounds)
+		if (entry.second._feedback())
+			entry.second.stop();
+	g_link->sounds.clear();
+	for (auto& entry : g_link->particles)
+		xr_delete(entry.second.object);
+	g_link->particles.clear();
+	if (g_pGamePersistent && g_pGamePersistent->Environment().eff_Thunderbolt)
+		g_pGamePersistent->Environment().eff_Thunderbolt->remote_driven = false;
+}
+
+// Every second: this client's environment, beside the server's coop-weather.csv.
+void log_weather_client()
+{
+	if (g_link->world != WorldLive || !g_pGamePersistent || !g_actor)
+		return;
+	sweep_particles();
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (now - g_link->last_weather_log_ms < 1000)
+		return;
+	g_link->last_weather_log_ms = now;
+	if (!g_link->weather_csv)
+	{
+		string_path path;
+		FS.update_path(path, "$logs$", "coop-weather-client.csv");
+		g_link->weather_csv = fopen(path, "w");
+		if (!g_link->weather_csv)
+			return;
+		fprintf(g_link->weather_csv, "utc_ms,game_ms,cycle,weather,wfx,wfx_time,c0,c0_exec,c1,c1_exec,weight,rain,tb_id,bolts,"
+		                             "presentations,cam2,pp1,sounds,particles,env_events\n");
+	}
+	CEnvironment& env = g_pGamePersistent->Environment();
+	const shared_str c0 = env.bWFX ? shared_str() : descriptor_cycle(env, env.Current[0]);
+	const shared_str c1 = env.bWFX ? shared_str() : descriptor_cycle(env, env.Current[1]);
+	CPostprocessAnimator* pp1 = smart_cast<CPostprocessAnimator*>(g_actor->Cameras().GetPPEffector((EEffectorPPType)1));
+	u32 playing = 0;
+	for (auto& entry : g_link->sounds)
+		if (entry.second._feedback())
+			++playing;
+	fprintf(g_link->weather_csv, "%I64u,%I64u,%s,%s,%d,%.2f,%s,%.2f,%s,%.2f,%.4f,%.3f,%s,%I64u,%I64u,%d,%.4f,%u,%u,%I64u\n",
+		utc_now_ms(), ai().alife().time_manager().game_time(), env.CurrentCycleName.size() ? *env.CurrentCycleName : "-",
+		env.CurrentWeatherName.size() ? *env.CurrentWeatherName : "-", env.bWFX ? 1 : 0, env.wfx_time,
+		c0.size() ? *c0 : "-", env.Current[0] ? env.Current[0]->exec_time : -1.f, c1.size() ? *c1 : "-",
+		env.Current[1] ? env.Current[1]->exec_time : -1.f, env.CurrentEnv ? env.CurrentEnv->weight : -1.f,
+		env.CurrentEnv ? env.CurrentEnv->rain_density : -1.f,
+		env.CurrentEnv && env.CurrentEnv->tb_id.size() ? *env.CurrentEnv->tb_id : "-", g_link->bolts, g_link->presentations,
+		g_actor->Cameras().GetCamEffector((ECamEffectorType)2) ? 1 : 0, pp1 ? pp1->GetCurrentFactor() : -1.f, playing,
+		u32(g_link->particles.size()), g_link->env_events);
+}
+
+// Profile script 5 (S06-T08): stand still and take screenshots through the
+// storm and the emission (every 40 s from 20 s after the other player is
+// there), for the report.
+void run_script5(u32 t)
+{
+	if (!g_link->program_t0)
+	{
+		if (!other_actor())
+		{
+			g_link->other_since = 0;
+			return;
+		}
+		if (!g_link->other_since)
+			g_link->other_since = t;
+		if (t < g_link->other_since + 3000)
+			return;
+		g_link->program_t0 = t;
+		g_link->log.line("script5-program-start slot=%u t=%u", u32(g_link->local_slot), t);
+		return;
+	}
+	const u32 p = t - g_link->program_t0;
+	if (g_link->script_phase < 8 && p >= 20000 + g_link->script_phase * 40000)
+	{
+		++g_link->script_phase;
+		string64 tag;
+		xr_sprintf(tag, "script5-shot-%u", g_link->script_phase);
+		screenshot(tag);
+	}
 }
 
