+// ---- stacks
+void queue_stack_merge(PlayerLink& link, u64 operation, u16 item, u16 container)
+{
+	if (container_kind(container) != 1 || !smart_cast<CSE_ALifeItemAmmo*>(Level().Server->ID_to_entity(item)))
+		return;
+	Host::PendingStack p;
+	p.item = item;
+	p.container = container;
+	p.slot = link.ref.slot;
+	p.player = link.player;
+	p.operation = operation;
+	p.since_ms = host_ms();
+	g_host->stacks_pending.push_back(p);
+}
+
+void broadcast_amounts(const xr_vector<std::pair<u64, u16>>& amounts)
+{
+	std::vector<u8> payload;
+	put_u8(payload, u8(amounts.size() < 80 ? amounts.size() : 80));
+	for (size_t i = 0; i < amounts.size() && i < 80; ++i)
+	{
+		for (int b = 0; b < 8; ++b)
+			payload.push_back(u8(amounts[i].first >> (8 * b)));
+		put_u16(payload, amounts[i].second);
+	}
+	broadcast_event(10, payload);
+}
+
+// The stacks of `section` in a box: item -> count (level objects).
+void box_stacks(u16 box, LPCSTR section, xr_map<u16, u16>& out)
+{
+	out.clear();
+	CSE_Abstract* se = Level().Server->ID_to_entity(box);
+	if (!se)
+		return;
+	for (u16 child : se->children)
+		if (CWeaponAmmo* ammo = smart_cast<CWeaponAmmo*>(Level().Objects.net_Find(child)))
+			if (!xr_strcmp(ammo->cNameSect().c_str(), section))
+				out[child] = ammo->m_boxCurr;
+}
+
+void finish_stack(Host::PendingStack& p)
+{
+	xr_map<u16, u16> after;
+	box_stacks(p.container, p.section.c_str(), after);
+	StackRecord record;
+	record.slot = p.slot;
+	record.player = p.player;
+	record.operation = p.operation;
+	record.container_entity = entity_of(p.container);
+	record.section = p.section.c_str();
+	xr_vector<std::pair<u64, u16>> amounts;
+	for (const auto& a : after)
+	{
+		record.counts.push_back({entity_of(a.first), a.second});
+		amounts.push_back({entity_of(a.first), a.second});
+		if (CSE_ALifeItemAmmo* se = smart_cast<CSE_ALifeItemAmmo*>(Level().Server->ID_to_entity(a.first)))
+			se->a_elapsed = a.second;
+	}
+	for (const auto& b : p.before)
+		if (!after.count(b.first))
+		{
+			const auto known = g_host->stack_entities.find(b.first);
+			if (known != g_host->stack_entities.end() && known->second)
+				record.released.push_back(known->second);
+		}
+	string256 counts = "";
+	for (const auto& c : record.counts)
+	{
+		string32 one;
+		xr_sprintf(one, "%s%I64u:%u", counts[0] ? "," : "", c.first, u32(c.second));
+		xr_strcat(counts, one);
+	}
+	if (record.released.empty() && p.before == after)
+	{
+		g_host->log.line("stack-merge-none container=%u section=%s stacks=%u counts=%s", u32(p.container),
+			p.section.c_str(), u32(p.before.size()), counts);
+		return;
+	}
+	u64 revision = 0;
+	if (!server_commit(coop::store::kRecordStack, encode_stack(record), revision, "stack"))
+		return;
+	++g_host->stacks_committed;
+	for (u64 e : record.released)
+	{
+		g_host->consumed_entities.insert(e);
+		g_host->pickup_expected.erase(e);
+		expect_container_item(0, e, false);
+	}
+	for (const auto& c : record.counts)
+		g_host->stack_expected[c.first] = c.second;
+	broadcast_amounts(amounts);
+	g_host->log.line("stack-committed revision=%I64u slot=%u container_entity=%I64u section=%s before=%u after=%u "
+		"released=%u counts=%s", revision, u32(p.slot), record.container_entity, p.section.c_str(),
+		u32(p.before.size()), u32(after.size()), u32(record.released.size()), counts);
+}
+
+void retry_stacks()
+{
+	const u32 now = host_ms();
+	for (size_t i = 0; i < g_host->stacks_pending.size();)
+	{
+		Host::PendingStack& p = g_host->stacks_pending[i];
+		if (p.ran)
+		{
+			// the installed merge sets counts and releases stacks through the
+			// engine's events, some a frame later: read the result 10 ticks on
+			if (g_host->tick < p.ran_tick + 10)
+			{
+				++i;
+				continue;
+			}
+			Host::PendingStack done = p;
+			g_host->stacks_pending.erase(g_host->stacks_pending.begin() + i);
+			finish_stack(done);
+			continue;
+		}
+		CObject* item = Level().Objects.net_Find(p.item);
+		CObject* box = Level().Objects.net_Find(p.container);
+		const bool held = item && box && item->H_Parent() == box;
+		if (!held && now - p.since_ms < 5000 && Level().Server->ID_to_entity(p.item))
+		{
+			++i;
+			continue;
+		}
+		if (!held)
+		{
+			g_host->stacks_pending.erase(g_host->stacks_pending.begin() + i);
+			continue;
+		}
+		p.section = item->cNameSect();
+		box_stacks(p.container, p.section.c_str(), p.before);
+		if (p.before.size() < 2)
+		{
+			g_host->stacks_pending.erase(g_host->stacks_pending.begin() + i);
+			continue; // nothing to merge with
+		}
+		for (const auto& b : p.before)
+			g_host->stack_entities[b.first] = entity_of(b.first); // to name a released stack later
+		// the installed scripts' merge (item_weapon.ammo_aggregation(obj, box)), in the mover's context
+		ActionContext context;
+		ParticipantRef ref;
+		for (PlayerLink& l : g_host->links)
+			if (l.bound && l.ref.slot == p.slot)
+				ref = l.ref;
+		bool ran = false;
+		if (participant_context(ref, context))
+		{
+			campaign::ScriptContextScope scope(context, Scope::Self, "stack-merge");
+			luabind::functor<bool> merge;
+			if (scope.entered() && ai().script_engine().functor("item_weapon.ammo_aggregation", merge))
+			{
+				merge(smart_cast<CGameObject*>(item)->lua_game_object(), smart_cast<CGameObject*>(box)->lua_game_object());
+				ran = true;
+			}
+		}
+		g_host->log.line("stack-merge-ran container=%u section=%s stacks=%u ran=%d", u32(p.container), p.section.c_str(),
+			u32(p.before.size()), ran ? 1 : 0);
+		if (!ran)
+		{
+			g_host->stacks_pending.erase(g_host->stacks_pending.begin() + i);
+			continue;
+		}
+		p.ran = true;
+		p.ran_tick = g_host->tick;
+		++i;
+	}
+}
+
+// The stack adapter: the released stacks released, the counts set. A
+// stack a deferred transfer re-creates is not there yet at replay: the
+// record waits for it (retried with the equip and use records).
+PickupApply apply_stack(const StackRecord& r, u64 revision, bool final)
+{
+	for (const auto& c : r.counts)
+	{
+		if (g_host->consumed_entities.count(c.first))
+			continue;
+		const u16 id = engine_id_of_entity(c.first);
+		if ((id == kNoEngineId || !Level().Objects.net_Find(id)) && !final)
+			return PickupApply::Deferred;
+	}
+	u32 set = 0, released = 0;
+	for (u64 e : r.released)
+	{
+		g_host->consumed_entities.insert(e);
+		g_host->pickup_expected.erase(e);
+		expect_container_item(0, e, false);
+		release_entity(e, "stack-merged", revision);
+		++released;
+	}
+	for (const auto& c : r.counts)
+	{
+		g_host->stack_expected[c.first] = c.second;
+		const u16 id = engine_id_of_entity(c.first);
+		if (id == kNoEngineId)
+			continue;
+		if (CSE_ALifeItemAmmo* se = smart_cast<CSE_ALifeItemAmmo*>(Level().Server->ID_to_entity(id)))
+			se->a_elapsed = c.second;
+		if (CWeaponAmmo* object = smart_cast<CWeaponAmmo*>(Level().Objects.net_Find(id)))
+			object->m_boxCurr = c.second;
+		++set;
+	}
+	g_host->log.line("stack-replay revision=%I64u container_entity=%I64u section=%s counts=%u set=%u released=%u",
+		revision, r.container_entity, r.section.c_str(), u32(r.counts.size()), set, released);
+	return PickupApply::Applied;
+}
+
+void apply_stack_or_defer(const StackRecord& r, u64 revision)
+{
+	if (apply_stack(r, revision, false) != PickupApply::Deferred)
+		return;
+	g_host->log.line("stack-replay-deferred revision=%I64u container_entity=%I64u", revision, r.container_entity);
+	Host::PendingInventory p;
+	p.kind = coop::store::kRecordStack;
+	p.stack = r;
+	p.revision = revision;
+	p.since_ms = host_ms();
+	p.phase = "replay";
+	g_host->inventory_pending.push_back(p);
+}
+
+// Every tracked container against what the records say: it exists, and each
+// item a record put in it is in it (never on the ground); each merged
+// stack's count.
+void log_container_state(LPCSTR tag)
+{
+	u32 ok_count = 0, bad = 0;
+	for (const auto& c : g_host->container_expected)
+	{
+		const u16 id = engine_id_of_entity(c.first);
+		CSE_Abstract* se = id != kNoEngineId ? Level().Server->ID_to_entity(id) : nullptr;
+		u32 held = 0, elsewhere = 0, missing = 0;
+		string512 wrong = "";
+		for (u64 item : c.second)
+		{
+			const u16 iid = engine_id_of_entity(item);
+			CSE_Abstract* ise = iid != kNoEngineId ? Level().Server->ID_to_entity(iid) : nullptr;
+			if (!ise)
+				++missing;
+			else if (se && ise->ID_Parent == id)
+				++held;
+			else
+			{
+				++elsewhere;
+				string32 one;
+				xr_sprintf(one, "%s%I64u@%u", wrong[0] ? "," : "", item, u32(ise->ID_Parent));
+				if (xr_strlen(wrong) + xr_strlen(one) < sizeof(wrong) - 1)
+					xr_strcat(wrong, one);
+			}
+		}
+		const bool ok = se && !elsewhere && !missing;
+		++(ok ? ok_count : bad);
+		g_host->log.line("container-state tag=%s entity=%I64u id=%u present=%d section=%s expected=%u held=%u "
+			"elsewhere=%u missing=%u ok=%d wrong=%s", tag, c.first, u32(id), se ? 1 : 0, se ? se->s_name.c_str() : "-",
+			u32(c.second.size()), held, elsewhere, missing, ok ? 1 : 0, wrong[0] ? wrong : "-");
+	}
+	u32 stacks_ok = 0, stacks_bad = 0;
+	for (const auto& s : g_host->stack_expected)
+	{
+		const u16 id = engine_id_of_entity(s.first);
+		CWeaponAmmo* object = id != kNoEngineId ? smart_cast<CWeaponAmmo*>(Level().Objects.net_Find(id)) : nullptr;
+		const bool ok = object && object->m_boxCurr == s.second;
+		++(ok ? stacks_ok : stacks_bad);
+		g_host->log.line("stack-state tag=%s entity=%I64u count=%d expected=%u ok=%d", tag, s.first,
+			object ? int(object->m_boxCurr) : -1, u32(s.second), ok ? 1 : 0);
+	}
+	g_host->log.line("container-state-summary tag=%s containers=%u ok=%u bad=%u stacks_ok=%u stacks_bad=%u "
+		"committed=%I64u recreated=%I64u observed=%I64u/%I64u/%I64u unrecorded=%I64u stacks=%I64u", tag,
+		u32(g_host->container_expected.size()), ok_count, bad, stacks_ok, stacks_bad, g_host->containers_committed,
+		g_host->containers_recreated, g_host->observed_taken, g_host->observed_moved, g_host->observed_released,
+		g_host->observed_unrecorded, g_host->stacks_committed);
+}
