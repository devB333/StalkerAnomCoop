 ENGINE_API bool g_dedicated_server = false;
+ENGINE_API bool g_campaign_server = false;
+
+#ifdef XR_CAMPAIGN_SERVER
+#if defined(NO_SINGLE) || defined(DEDICATED_SERVER_ONLY) || defined(DEDICATED_SERVER)
+#error Campaign server requires single-player campaign services and a distinct runtime role.
+#endif
+
+// This smoke path exercises core/settings, console commands and the native
+// game factory before level/render separation is implemented.
+static int RunCampaignServerSmoke(LPCSTR command_line)
+{
+    LPCSTR option = strstr(command_line, "-fsltx ");
+    if (!option || !strstr(command_line, "-campaign-smoke"))
+    {
+        fprintf(stderr, "S02-T02: -campaign-smoke and absolute -fsltx are required.\n");
+        return 2;
+    }
+
+    string_path filesystem_config = {};
+    if (sscanf_s(option + 7, "%259s", filesystem_config,
+            static_cast<unsigned>(_countof(filesystem_config))) != 1 ||
+        filesystem_config[1] != ':' ||
+        (filesystem_config[2] != '\\' && filesystem_config[2] != '/'))
+    {
+        fprintf(stderr, "S02-T02: invalid absolute filesystem configuration.\n");
+        return 2;
+    }
+
+    g_campaign_server = true;
+    printf("S02-T02 stage=core-start\n");
+    compute_build_id();
+    Core._initialize("xray-campaign-server", NULL, TRUE, filesystem_config);
+    printf("S02-T02 stage=core-ready\n");
+    InitSettings();
+    printf("S02-T02 stage=settings-ready\n");
+    Engine.Initialize();
+    printf("S02-T02 stage=scheduler-ready\n");
+    Console = xr_new<CConsole>();
+    Console->Initialize();
+    printf("S02-T02 stage=console-ready\n");
+    Engine.External.InitializeGameFactory();
+    printf("S02-T02 stage=game-factory-ready\n");
+    DLL_Pure* game = Engine.External.pCreate(CLSID_CL_GAME_SINGLE);
+    R_ASSERT2(game, "Campaign game_cl_Single factory is unavailable");
+    Engine.External.pDestroy(game);
+    printf("S02-T02 stage=campaign-client-state-ready\n");
+
+    // S02-T03/T05 will supply CPU models and a renderer-free level loader.
+    printf("S02-T02 next=level-context-requires-cpu-model-services\n");
+    Engine.Destroy();
+    Console->Destroy();
+    xr_delete(Console);
+    destroySettings();
+    Core._destroy();
+    g_campaign_server = false;
+    printf("S02-T02 stage=shutdown-complete\n");
+    return 0;
+}
+#endif
+
 
