+
+// Loads one real model through the CPU model pool and checks the data that
+// hits, collision and physics shells need. Missing files fail explicitly.
+bool CheckCampaignModel(LPCSTR name)
+{
+    string_path file, path;
+    xr_strcpy(file, name);
+    if (!strext(file))
+        xr_strcat(file, ".ogf");
+    if (!FS.exist(path, "$game_meshes$", file))
+    {
+        Msg("! S02-T03 model missing: %s", name);
+        return false;
+    }
+
+    const u32 registered_before = xrCampaignRegisteredModels();
+    IRenderVisual* visual = ::Render->model_Create(name);
+    IKinematics* kinematics = visual ? visual->dcast_PKinematics() : nullptr;
+    IKinematicsAnimated* animated = visual ? visual->dcast_PKinematicsAnimated() : nullptr;
+    bool ok = kinematics && animated;
+    u32 bones = 0, materials = 0, faces = 0, motion_slots = 0;
+    CountVertices vertices;
+    LPCSTR root_name = "-";
+    if (ok)
+    {
+        bones = kinematics->LL_BoneCount();
+        root_name = kinematics->LL_BoneName_dbg(kinematics->LL_GetBoneRoot());
+        for (u16 bone = 0; bone < bones; ++bone)
+        {
+            CBoneData& data = kinematics->LL_GetData(bone);
+            if (data.game_mtl_idx < GMLib.CountMaterial())
+                ++materials;
+            for (const auto& child : data.child_faces)
+                faces += u32(child.size());
+            kinematics->EnumBoneVertices(vertices, bone);
+        }
+        motion_slots = animated->LL_MotionsSlotCount();
+    }
+    const u32 registered = xrCampaignRegisteredModels() - registered_before;
+    Msg("S02-T03 model=%s bones=%u root=%s bone_materials=%u bone_faces=%u bone_vertices=%u "
+        "motion_slots=%u registered=%u",
+        name, bones, root_name, materials, faces, vertices.count, motion_slots, registered);
+    ok = ok && bones != 0 && materials == bones && faces != 0 && vertices.count != 0 &&
+        motion_slots != 0 && registered != 0;
+    if (visual)
+        ::Render->model_Delete(visual);
+    return ok;
+}
+
+// Real actor and NPC models plus the player HUD arms that CLevel loads.
+bool RunCampaignModelFixture(LPCSTR command_line)
+{
+    xr_vector<xr_string> names;
+    if (LPCSTR option = strstr(command_line, "-campaign-models "))
+    {
+        string1024 list = {};
+        sscanf_s(option + 17, "%1023s", list, static_cast<unsigned>(_countof(list)));
+        string_path item;
+        for (int i = 0, n = _GetItemCount(list); i < n; ++i)
+            names.push_back(_GetItem(list, i, item));
+    }
+    else
+    {
+        names.push_back(pSettings->r_string("actor_hud_05", "visual"));
+        names.push_back("actors\\stalker_neutral\\stalker_neutral_1");
+        names.push_back("actors\\stalker_bandit\\stalker_bandit_1");
+    }
+
+    bool ok = !names.empty();
+    for (const xr_string& name : names)
+        ok = CheckCampaignModel(name.c_str()) && ok;
+
+    // A missing model must be reported, not replaced.
+    string_path missing;
+    const bool missing_reported = !FS.exist(missing, "$game_meshes$", "actors\\s02_t03_missing_model.ogf");
+    Msg("S02-T03 missing-model reported=%d", missing_reported ? 1 : 0);
+
+    IRender_interface::CpuModelStats stats = {};
+    const bool cpu_mode = ::Render->cpu_models_stats(stats);
+    Msg("S02-T03 cpu-models device_absent=%d skipped_shaders=%u skipped_geometry=%u skipped_buffers=%u",
+        stats.device_absent ? 1 : 0, stats.skipped_shaders, stats.skipped_geometry, stats.skipped_buffers);
+    return ok && missing_reported && cpu_mode && stats.device_absent && stats.skipped_shaders != 0 &&
+        stats.skipped_geometry != 0 && stats.skipped_buffers != 0;
+}
