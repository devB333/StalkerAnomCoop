+extern "C" bool __cdecl xrCampaignLevel_ActivationBegin(LPCSTR out_path)
+{
+	Fixture& f = g_fixture;
+	f = Fixture();
+	f.ok = true;
+	f.actor1_id = f.actor2_id = f.monster1_id = f.monster2_id = no_id;
+	option_string("-s03-monster-section ", default_monster_section, f.monster_section);
+	if (!g_campaign_identity || g_campaign_identity->role() != Role::Server || !g_pGameLevel || !Level().Server ||
+		!ai().get_alife() || !ai().get_level_graph())
+	{
+		Msg("! S03-T04 activation: no server registry, level, ALife or level graph");
+		return false;
+	}
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	CActor* a1 = g_actor;
+	if (!a1 || !a1->g_Alive() || participant_of(a1, f.p1) != Refusal::None)
+	{
+		Msg("! S03-T04 activation: no alive saved actor held by a participant");
+		return false;
+	}
+	CActor* a2 = nullptr;
+	if (registry.find_player(player_id(2), f.p2) == Refusal::None)
+		a2 = participant_actor(f.p2);
+	if (!a2 || !a2->g_Alive() || a2 == a1)
+	{
+		Msg("! S03-T04 activation: participant 2 holds no alive actor (the two-actor fixture runs first)");
+		return false;
+	}
+	if (!pSettings->section_exist(f.monster_section))
+	{
+		Msg("! S03-T04 activation: no section %s", f.monster_section);
+		return false;
+	}
+	f.out = fopen(out_path, "w");
+	if (!f.out)
+	{
+		Msg("! S03-T04 activation: cannot write %s", out_path);
+		return false;
+	}
+	f.actor1_id = a1->ID();
+	f.actor2_id = a2->ID();
+	f.godmode_was = !!psActorFlags.test(AF_GODMODE);
+	f.godmode_rt_was = !!psActorFlags.test(AF_GODMODE_RT);
+	f.running = true;
+	CALifeSimulator& alife = sim();
+	fprintf(f.out, "meta,%u,%s,%u,%u,%s,%.2f,%.2f,%.2f\n", Device.dwFrame, *Level().name(), u32(f.actor1_id),
+		u32(f.actor2_id), f.monster_section, alife.switch_distance(), alife.online_distance(), alife.offline_distance());
+	Msg("S03-T04 activation begin: actors %u and %u, %.1f m apart; switch %.1f online %.1f offline %.1f",
+		u32(f.actor1_id), u32(f.actor2_id), a1->Position().distance_to(a2->Position()), alife.switch_distance(),
+		alife.online_distance(), alife.offline_distance());
+	// The first scan only records the states.
+	u32 on = 0, off = 0;
+	scan(on, off);
+	f.last_switch_tick = 0;
+	f.last_qpc = CPU::QPC();
+	begin_phase(1);
+	return true;
+}
+
+extern "C" void __cdecl xrCampaignLevel_ActivationTick()
+{
+	Fixture& f = g_fixture;
+	if (!f.running)
+		return;
+	const u64 now = CPU::QPC();
+	f.engine_cycles = now - f.last_qpc; // the engine's tick since the fixture's last one
+	++f.ticks;
+	u32 switched_on = 0, switched_off = 0;
+	scan(switched_on, switched_off);
+	CALifeSimulator& alife = sim();
+	const CStats* stats = Device.Statistic;
+	const u32 object_updates = stats ? stats->UpdateClient_updated : 0;
+	const u32 scheduler_updates = Engine.Sheduler.dwUpdated;
+	if (f.measuring)
+	{
+		++f.window.ticks;
+		f.window.engine_cycles += f.engine_cycles;
+		f.window.online += f.online_now;
+		f.window.object_updates += object_updates;
+		f.window.scheduler_updates += scheduler_updates;
+	}
+	if (f.out)
+		fprintf(f.out, "tick,%u,%u,%u,%.1f,%u,%u,%u,%u,%d,%u,%u\n", f.ticks, f.phase, f.step,
+			double(f.engine_cycles) * 1000000.0 / double(CPU::qpc_freq), f.online_now, switched_on, switched_off,
+			u32(alife.activation_anchors().size()), alife.activation_from_participants() ? 1 : 0, object_updates,
+			scheduler_updates);
+	CActor* a1 = actor_by_id(f.actor1_id);
+	CActor* a2 = actor_by_id(f.actor2_id);
+	if (!a1 || !a2)
+	{
+		check(false, "both actors exist");
+		finish(false);
+	}
+	else
+	{
+		switch (f.phase)
+		{
+		case 1: phase_baseline(a1, a2); break;
+		case 2: phase_separate(a1, a2); break;
+		case 3: phase_awareness(a1, a2); break;
+		case 4: phase_disconnect(a1, a2); break;
+		case 5: phase_return(a1, a2); break;
+		default: break;
+		}
+	}
+	f.last_qpc = CPU::QPC();
+}
+
+extern "C" bool __cdecl xrCampaignLevel_ActivationDone()
+{
+	return !g_fixture.running;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_ActivationEnd(u32 ticks, u32 sim_ms, u32 wall_ms)
+{
+	Fixture& f = g_fixture;
+	if (f.running)
+	{
+		check(false, "the fixture finished within its tick budget");
+		f.running = false;
+	}
+	// Leave nothing behind: the monsters, the session, the switch distance, god mode.
+	if (g_pGameLevel && Level().Server)
+	{
+		release_entity(f.monster1_id);
+		release_entity(f.monster2_id);
+	}
+	if (g_campaign_identity)
+	{
+		const Participant* v2 = nullptr;
+		if (g_campaign_identity->participant(f.p2, v2) == Refusal::None && v2 &&
+			v2->state == ParticipantState::Detached)
+			g_campaign_identity->attach_session(g_campaign_identity->authority(), f.p2, session2, Device.dwFrame);
+	}
+	if (f.switch_changed && ai().get_alife())
+		sim().set_switch_distance(f.switch_distance_was);
+	psActorFlags.set(AF_GODMODE, f.godmode_was ? TRUE : FALSE);
+	psActorFlags.set(AF_GODMODE_RT, f.godmode_rt_was ? TRUE : FALSE);
+	Msg("S03-T04 activation end ticks=%u sim_ms=%u wall_ms=%u checks=%u failures=%u phase=%u switch_restored=%d ok=%d",
+		ticks, sim_ms, wall_ms, f.checks, f.failures, f.phase, f.switch_changed ? 1 : 0, f.ok ? 1 : 0);
+	if (f.out)
+	{
+		fprintf(f.out, "end,%u,%u,%u,%u,%u,%u,%d\n", ticks, sim_ms, wall_ms, f.checks, f.failures, f.phase, f.ok ? 1 : 0);
+		fclose(f.out);
+		f.out = nullptr;
+	}
+	return f.ok && f.failures == 0;
+}
