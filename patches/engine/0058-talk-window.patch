+// ------------------------------------------------------------ S10-T04a
+// The talk window on the server's dialogue (decision T01-15: one speaker per
+// NPC). A talk is one player's open dialogue with one NPC: started by
+// ActionIntent 14 (campaign::dialogue_open in the player's script context,
+// then the NPC's start dialog as CUITalkWnd::InitOthersStartDialog runs it),
+// driven by 15 (a clicked topic or phrase, as CUITalkWnd::AskQuestion and
+// UpdateQuestions run it, the dummy auto-say included), ended by 16 or by
+// the world (the actor or the NPC stops talking or dies, the player leaves,
+// the NPC walks out of reach). Every change goes to that player as
+// CampaignEvent 14 (the NPC's entity ref, u8 state, u8 flags or the body):
+// 1 open (flags bit 0: no break), 2 closed (the why), 3 an answer (u8 ours,
+// the text), 4 a list (u8 part flags: bit 0 first, bit 1 last; u8 topic
+// mode; the dialog id; u8 count; count x (id, text, u8 finalizer)). The
+// dialogue's preconditions, actions and texts run in the talking player's
+// context (its info portions, its db.actor); the party quest's accept and
+// turn-in actions are taken over (campaign::coop_server_dialogue_action)
+// and run through the S08 party path in the anchor's context, so the task
+// is the party's and durable; the NPC's replies reach the player through
+// campaign::coop_server_dialogue_answer (the server has no talk window). A
+// talking actor takes no movement input (apply_inputs), as in single player.
+
+// A text on the wire has a u16 length (a script text is a paragraph: the
+// task offers run past 240 bytes); an answer may take the event, a list
+// entry leaves room for the list's header (ref + state 13, part, topic,
+// the dialog id <= 101, count) inside kMaxEventPayload (1024)
+const u32 kTalkTextMax = 1000;
+const u32 kTalkListTextMax = 800;
+const u32 kTalkEventMax = 1000; // body bytes per list event (the ref and the state come before it)
+static PlayerLink* s_talk_link = nullptr; // the link whose dialogue operation runs now (the hooks)
+
+static void put_text(std::vector<u8>& p, LPCSTR v, u32 max)
+{
+	const u32 n = v ? _min(u32(xr_strlen(v)), max) : 0u;
+	p.push_back(u8(n));
+	if (n)
+		p.insert(p.end(), v, v + n);
+}
+
+static void put_text16(std::vector<u8>& p, LPCSTR v, u32 max)
+{
+	const u32 n = v ? _min(u32(xr_strlen(v)), max) : 0u;
+	put_u16(p, u16(n));
+	if (n)
+		p.insert(p.end(), v, v + n);
+}
+
+static void talk_event(PlayerLink& link, u8 state, const std::vector<u8>& body)
+{
+	std::vector<u8> payload;
+	put_ref(payload, link.talk_npc);
+	put_u8(payload, state);
+	payload.insert(payload.end(), body.begin(), body.end());
+	queue_event(link, 14, payload);
+}
+
+static void talk_answer(PlayerLink& link, bool ours, LPCSTR text)
+{
+	if (!text || !text[0])
+		return; // as CUITalkWnd::AddAnswer: nothing for an empty phrase
+	std::vector<u8> p;
+	put_u8(p, ours ? 1 : 0);
+	put_text16(p, text, kTalkTextMax);
+	talk_event(link, 3, p);
+	++g_host->talk_answers;
+	string256 shown;
+	strncpy_s(shown, sizeof(shown), text, 120);
+	g_host->log.line("talk-answer slot=%u ours=%d text=%s", u32(link.ref.slot), ours ? 1 : 0, shown);
+}
+
+static CInventoryOwner* talk_partner(const PlayerLink& link, CGameObject** object = nullptr)
+{
+	CGameObject* npc = link.talk_npc != 0xffff ? smart_cast<CGameObject*>(Level().Objects.net_Find(link.talk_npc)) : nullptr;
+	if (object)
+		*object = npc;
+	return npc ? smart_cast<CInventoryOwner*>(npc) : nullptr;
+}
+
+// As CUITalkWnd::SayPhrase: our text, then the phrase said (its action, the
+// NPC's reply through CAI_PhraseDialogManager::AnswerPhrase and the hooks).
+static void talk_say_phrase(PlayerLink& link, CPhraseDialogManager* ours, const shared_str& id)
+{
+	talk_answer(link, true, link.talk_dialog->GetPhraseText(id));
+	PlayerLink* outer = s_talk_link;
+	s_talk_link = &link;
+	ours->SayPhrase(link.talk_dialog, id);
+	s_talk_link = outer;
+	if (link.talk_dialog && link.talk_dialog->IsFinished())
+		link.talk_dialog = DIALOG_SHARED_PTR((CPhraseDialog*)NULL);
+}
+
+// As CUITalkWnd::UpdateQuestions: the topics (topic mode) or the phrases the
+// player may say now, after the dummies said by themselves; to the player in
+// parts that fit an event.
+static void talk_send_list(PlayerLink& link, CPhraseDialogManager* ours, CPhraseDialogManager* theirs)
+{
+	struct Entry
+	{
+		shared_str id;
+		xr_string text;
+		bool finalizer;
+	};
+	xr_vector<Entry> entries;
+	bool topic = false;
+	for (int guard = 0; guard < 8; ++guard)
+	{
+		entries.clear();
+		if (!link.talk_dialog)
+		{
+			topic = true;
+			ours->UpdateAvailableDialogs(theirs);
+			for (const DIALOG_SHARED_PTR& d : ours->AvailableDialogs())
+			{
+				Entry e;
+				e.id = d->GetDialogID();
+				e.text = d->DialogCaption();
+				e.finalizer = d->GetPhrase("0")->IsFinalizer();
+				entries.push_back(e);
+			}
+			break;
+		}
+		if (!link.talk_dialog->IsWeSpeaking(ours))
+			break; // the NPC's turn: its reply is synchronous, so this does not come up
+		if (!link.talk_dialog->PhraseList().empty() && link.talk_dialog->allIsDummy())
+		{
+			// only dummies to say: said by itself, the player does nothing
+			CPhrase* phrase = link.talk_dialog->PhraseList()[Random.randI(link.talk_dialog->PhraseList().size())];
+			talk_say_phrase(link, ours, phrase->GetID());
+			if (link.talk_npc == 0xffff)
+				return; // closed meanwhile
+			continue;
+		}
+		for (CPhrase* phrase : link.talk_dialog->PhraseList())
+		{
+			Entry e;
+			e.id = phrase->GetID();
+			e.text = link.talk_dialog->GetPhraseText(phrase->GetID());
+			e.finalizer = phrase->IsFinalizer();
+			entries.push_back(e);
+		}
+		break;
+	}
+	const shared_str dialog = link.talk_dialog ? link.talk_dialog->GetDialogID() : shared_str("");
+	size_t at = 0;
+	bool first = true;
+	do
+	{
+		std::vector<u8> p;
+		put_u8(p, 0); // the part flags, set below
+		put_u8(p, topic ? 1 : 0);
+		put_text(p, dialog.c_str(), 100);
+		const size_t count_at = p.size();
+		put_u8(p, 0);
+		u32 count = 0;
+		while (at < entries.size() && count < 255)
+		{
+			std::vector<u8> one;
+			put_text(one, entries[at].id.c_str(), 64);
+			put_text16(one, entries[at].text.c_str(), kTalkListTextMax);
+			put_u8(one, entries[at].finalizer ? 1 : 0);
+			if (p.size() + one.size() > kTalkEventMax && count)
+				break;
+			p.insert(p.end(), one.begin(), one.end());
+			++count;
+			++at;
+		}
+		p[count_at] = u8(count);
+		p[0] = u8((first ? 1 : 0) | (at >= entries.size() ? 2 : 0));
+		talk_event(link, 4, p);
+		first = false;
+	} while (at < entries.size());
+	++link.talk_lists;
+	string512 ids = "";
+	for (const Entry& e : entries)
+		if (xr_strlen(ids) + e.id.size() < 400)
+		{
+			xr_strcat(ids, " ");
+			xr_strcat(ids, e.id.c_str());
+		}
+	g_host->log.line("talk-list slot=%u topic=%d dialog=%s count=%u ids=[%s ]", u32(link.ref.slot), topic ? 1 : 0,
+		dialog.c_str(), u32(entries.size()), ids);
+}
+
+void talk_close(PlayerLink& link, LPCSTR why, bool notify = true)
+{
+	if (link.talk_npc == 0xffff)
+		return;
+	CActor* actor = participant_actor(link.ref);
+	CGameObject* npc = nullptr;
+	CInventoryOwner* owner = talk_partner(link, &npc);
+	if (notify && link.session)
+	{
+		std::vector<u8> p;
+		put_text(p, why, 60);
+		talk_event(link, 2, p);
+	}
+	g_host->log.line("talk-close slot=%u npc=%u why=%s says=%I64u ticks=%I64u", u32(link.ref.slot), u32(link.talk_npc), why,
+		link.talk_says_now, g_host->tick - link.talk_since);
+	link.talk_npc = 0xffff;
+	link.talk_dialog = DIALOG_SHARED_PTR((CPhraseDialog*)NULL);
+	++g_host->talks_closed;
+	CInventoryOwner* me = actor ? smart_cast<CInventoryOwner*>(actor) : nullptr;
+	if (actor && owner && owner->IsTalking() && owner->GetTalkPartner() == me)
+		campaign::dialogue_close(actor, owner); // both stop talking, the menu mode, in the player's context
+	else if (actor && actor->IsTalking())
+		actor->StopTalk(); // the NPC already stopped (or talks to the other player now)
+}
+
+u16 take_talk_start(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (!intent.params.empty())
+		return coop::proto::kReasonMalformed;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	if (!actor || !actor->g_Alive())
+		return coop::proto::kReasonNoActor;
+	const u16 npc_id = engine_id_of(intent.target);
+	CGameObject* npc = npc_id != kNoEngineId ? smart_cast<CGameObject*>(Level().Objects.net_Find(npc_id)) : nullptr;
+	CEntityAlive* alive = npc ? smart_cast<CEntityAlive*>(npc) : nullptr;
+	CInventoryOwner* owner = npc ? smart_cast<CInventoryOwner*>(npc) : nullptr;
+	if (!npc || !alive || !alive->g_Alive() || !owner || smart_cast<CActor*>(npc) || !owner->IsTalkEnabled())
+	{
+		++g_host->talks_refused;
+		g_host->log.line("talk-refused slot=%u npc=%u why=no-talk present=%d alive=%d owner=%d", u32(link.ref.slot),
+			u32(npc_id), npc ? 1 : 0, alive && alive->g_Alive() ? 1 : 0, owner ? 1 : 0);
+		return coop::proto::kReasonNoTalk;
+	}
+	if (link.talk_npc == npc_id)
+		return 0; // told twice: the talk is open
+	if (link.talk_npc != 0xffff)
+		talk_close(link, "restarted"); // one talk per player: the old one ends
+	// one speaker per NPC (T01-15)
+	CInventoryOwner* me = smart_cast<CInventoryOwner*>(actor);
+	if (owner->IsTalking() && owner->GetTalkPartner() != me)
+	{
+		CGameObject* partner = owner->GetTalkPartner() ? smart_cast<CGameObject*>(owner->GetTalkPartner()) : nullptr;
+		++g_host->talks_busy;
+		g_host->log.line("talk-busy slot=%u npc=%u partner=%u", u32(link.ref.slot), u32(npc_id),
+			partner ? u32(partner->ID()) : 0xffffu);
+		return coop::proto::kReasonTalkBusy;
+	}
+	const float distance = pickup_distance(actor, npc);
+	if (distance > kGiverReach)
+	{
+		++g_host->talks_refused;
+		g_host->log.line("talk-refused slot=%u npc=%u why=out-of-reach distance=%.2f", u32(link.ref.slot), u32(npc_id), distance);
+		return coop::proto::kReasonOutOfReach;
+	}
+	const campaign::Refusal opened = campaign::dialogue_open(actor, owner, owner->bDisableBreakDialog);
+	if (opened != campaign::Refusal::None)
+	{
+		++g_host->talks_refused;
+		g_host->log.line("talk-refused slot=%u npc=%u why=dialogue-open:%s", u32(link.ref.slot), u32(npc_id),
+			campaign::refusal_name(opened));
+		return coop::proto::kReasonNoTalk;
+	}
+	link.talk_npc = npc_id;
+	link.talk_since = g_host->tick;
+	link.talk_says_now = 0;
+	link.talk_dialog = DIALOG_SHARED_PTR((CPhraseDialog*)NULL);
+	++link.talks;
+	++g_host->talks_started;
+	std::vector<u8> p;
+	put_u8(p, owner->bDisableBreakDialog ? 1 : 0);
+	talk_event(link, 1, p);
+	g_host->log.line("talk-start slot=%u actor=%u npc=%u section=%s name=%s distance=%.2f no_break=%d", u32(link.ref.slot),
+		u32(actor->ID()), u32(npc_id), *npc->cNameSect(), owner->Name(), distance, owner->bDisableBreakDialog ? 1 : 0);
+	{
+		// as CUITalkWnd::InitTalkDialog: the NPC's start dialog, then the lists
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "talk-open");
+		CPhraseDialogManager* ours = smart_cast<CPhraseDialogManager*>(actor);
+		CPhraseDialogManager* theirs = smart_cast<CPhraseDialogManager*>(npc);
+		theirs->UpdateAvailableDialogs(ours);
+		if (!theirs->AvailableDialogs().empty())
+		{
+			link.talk_dialog = theirs->AvailableDialogs().front();
+			theirs->InitDialog(ours, link.talk_dialog);
+			talk_answer(link, false, link.talk_dialog->GetPhraseText("0"));
+			PlayerLink* outer = s_talk_link;
+			s_talk_link = &link;
+			theirs->SayPhrase(link.talk_dialog, "0");
+			s_talk_link = outer;
+			if (!link.talk_dialog || link.talk_dialog->IsFinished())
+				link.talk_dialog = DIALOG_SHARED_PTR((CPhraseDialog*)NULL);
+		}
+		if (link.talk_npc != 0xffff)
+			talk_send_list(link, ours, theirs);
+	}
+	result.revision = g_host->commit;
+	return 0;
+}
+
+u16 take_talk_say(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (intent.params.size() < 2 || intent.params[0] == 0 || intent.params[0] > 64 ||
+		intent.params.size() != size_t(1 + intent.params[0]))
+		return coop::proto::kReasonMalformed;
+	string128 id;
+	memcpy(id, intent.params.data() + 1, intent.params[0]);
+	id[intent.params[0]] = 0;
+	if (link.talk_npc == 0xffff)
+	{
+		++g_host->talk_say_refused;
+		g_host->log.line("talk-say-refused slot=%u id=%s why=not-talking", u32(link.ref.slot), id);
+		return coop::proto::kReasonNotTalking;
+	}
+	CActor* actor = participant_actor(link.ref);
+	CGameObject* npc = nullptr;
+	CInventoryOwner* owner = talk_partner(link, &npc);
+	if (!actor || !actor->g_Alive() || !owner || !actor->IsTalking())
+	{
+		talk_close(link, "say-without-talk");
+		return coop::proto::kReasonNotTalking;
+	}
+	campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "talk-say");
+	CPhraseDialogManager* ours = smart_cast<CPhraseDialogManager*>(actor);
+	CPhraseDialogManager* theirs = smart_cast<CPhraseDialogManager*>(npc);
+	const shared_str said(id);
+	if (!link.talk_dialog)
+	{
+		// topic mode (CUITalkWnd::AskQuestion): the chosen dialog, its first phrase
+		if (!ours->HaveAvailableDialog(said))
+		{
+			++g_host->talk_say_refused;
+			g_host->log.line("talk-say-refused slot=%u id=%s why=no-such-topic", u32(link.ref.slot), id);
+			return coop::proto::kReasonWrongPhrase;
+		}
+		link.talk_dialog = ours->GetDialogByID(said);
+		ours->InitDialog(theirs, link.talk_dialog);
+		talk_say_phrase(link, ours, "0");
+	}
+	else
+	{
+		bool listed = false;
+		if (link.talk_dialog->IsWeSpeaking(ours))
+			for (CPhrase* phrase : link.talk_dialog->PhraseList())
+				listed = listed || phrase->GetID() == said;
+		if (!listed)
+		{
+			++g_host->talk_say_refused;
+			g_host->log.line("talk-say-refused slot=%u id=%s why=not-in-list dialog=%s", u32(link.ref.slot), id,
+				link.talk_dialog->GetDialogID().c_str());
+			return coop::proto::kReasonWrongPhrase;
+		}
+		talk_say_phrase(link, ours, said);
+	}
+	++link.talk_says;
+	++link.talk_says_now;
+	++g_host->talk_says;
+	g_host->log.line("talk-say slot=%u id=%s dialog=%s finished=%d", u32(link.ref.slot), id,
+		link.talk_dialog ? link.talk_dialog->GetDialogID().c_str() : "-", link.talk_dialog ? 0 : 1);
+	if (link.talk_npc == 0xffff)
+		return 0; // the dialogue closed the talk
+	if (!actor->IsTalking() || !owner->IsTalking())
+	{
+		talk_close(link, "dialogue-ended");
+		return 0;
+	}
+	talk_send_list(link, ours, theirs);
+	result.revision = g_host->commit;
+	return 0;
+}
+
+u16 take_talk_end(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (link.talk_npc == 0xffff)
+		return coop::proto::kReasonNotTalking;
+	talk_close(link, "player");
+	return 0;
+}
+
+// Every tick: a talk ends with its actor, its NPC or its reach.
+void talk_tick()
+{
+	for (PlayerLink& link : g_host->links)
+	{
+		if (link.talk_npc == 0xffff)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		CGameObject* npc = nullptr;
+		CInventoryOwner* owner = talk_partner(link, &npc);
+		CEntityAlive* alive = npc ? smart_cast<CEntityAlive*>(npc) : nullptr;
+		CInventoryOwner* me = actor ? smart_cast<CInventoryOwner*>(actor) : nullptr;
+		LPCSTR why = nullptr;
+		if (!actor || !actor->g_Alive())
+			why = "actor-dead";
+		else if (!npc || !alive || !alive->g_Alive() || !owner)
+			why = "npc-gone";
+		else if (!actor->IsTalking() || actor->GetTalkPartner() != owner)
+			why = "actor-stopped";
+		else if (!owner->IsTalking() || owner->GetTalkPartner() != me)
+			why = "npc-stopped";
+		else if (pickup_distance(actor, npc) > kGiverReach * 2.f)
+			why = "out-of-reach";
+		if (why)
+			talk_close(link, why);
+	}
+}
+
+void log_talk_summary()
+{
+	u32 open = 0;
+	u64 held = 0;
+	for (const PlayerLink& link : g_host->links)
+	{
+		open += link.talk_npc != 0xffff ? 1 : 0;
+		held += link.talk_inputs_held;
+	}
+	g_host->log.line("talk-summary started=%I64u busy=%I64u refused=%I64u says=%I64u say_refused=%I64u closed=%I64u "
+		"quest_routed=%I64u actions_blocked=%I64u answers=%I64u inputs_held=%I64u open=%u",
+		g_host->talks_started, g_host->talks_busy, g_host->talks_refused, g_host->talk_says, g_host->talk_say_refused,
+		g_host->talks_closed, g_host->talk_quest_routed, g_host->talk_actions_blocked, g_host->talk_answers, held, open);
+}
+
+// The task the installed dialog functions read for the NPC
+// (axr_task_manager.available_tasks / finished_tasks [npc][1]).
+static bool talk_npc_task(LPCSTR list_name, u16 npc_id, string128& out)
+{
+	lua_State* L = ai().script_engine().lua();
+	luabind::object axr = luabind::get_globals(L)["axr_task_manager"];
+	if (axr.type() != LUA_TTABLE)
+		return false;
+	luabind::object list = axr[list_name];
+	luabind::object mine = list.type() == LUA_TTABLE ? luabind::object(list[int(npc_id)]) : luabind::object(L);
+	luabind::object head = mine.type() == LUA_TTABLE ? luabind::object(mine[1]) : luabind::object(L);
+	if (head.type() != LUA_TSTRING)
+		return false;
+	xr_strcpy(out, sizeof(out), luabind::object_cast<LPCSTR>(head));
+	return true;
+}
+
+static CActor* party_anchor()
+{
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot == 0)
+			return participant_actor(l.ref);
+	return nullptr;
+}
+
+// The accept phrase's action (dialogs.npc_give_task) of a talk: the S08 party
+// accept in the anchor's context (take_quest op 1 without the intent).
+static u16 talk_quest_accept(PlayerLink& link, CGameObject* npc)
+{
+	string128 task;
+	if (!talk_npc_task("available_tasks", u16(npc->ID()), task))
+		return coop::proto::kReasonQuestNotOffered;
+	if (!party_task_supported(task) || !g_host->party_adapter)
+	{
+		++g_host->talk_actions_blocked;
+		g_host->log.line("talk-quest-blocked slot=%u op=accept task=%s why=not-a-party-task", u32(link.ref.slot), task);
+		return coop::proto::kReasonQuestUnsupported;
+	}
+	sync_party_actors();
+	if (party_task(task))
+		return coop::proto::kReasonQuestActive;
+	CActor* anchor = party_anchor();
+	if (!anchor || !anchor->g_Alive())
+		return coop::proto::kReasonNoActor;
+	bool ok = false;
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(anchor), "party-quest-accept-talk");
+		ok = scope.entered() && quest_accept_phrases(anchor, npc, task);
+	}
+	CGameTask* native = Level().GameTaskManager().HasGameTask(shared_str(task), true);
+	g_host->log.line("quest-accept slot=%u task=%s dialogue=talk ok=%d native=%d", u32(link.ref.slot), task, ok ? 1 : 0,
+		native ? 1 : 0);
+	if (!ok || !native)
+		return coop::proto::kReasonQuestNotOffered;
+	party_task_accepted(link, task, u16(npc->ID()), anchor, 0);
+	return 0;
+}
+
+// The finish phrase's action (dialogs.npc_set_finished_task_complete) of a
+// talk: the S08 party turn-in in the holder's context (take_quest op 2
+// without the intent); the completion is applied by quest_tick.
+static u16 talk_quest_turn_in(PlayerLink& link, CGameObject* npc)
+{
+	// the ordered dialog's finish (dm_init_dynamic_task_completed_dialog) names
+	// its task through axr_task_manager.get_first_finished_task(npc), computed
+	// on the fly in the holder's context (db.actor:get_task), not a table
+	CActor* holder = party_anchor();
+	if (!holder || !holder->g_Alive())
+	{
+		g_host->log.line("quest-turnin-anchor-dead slot=%u source=talk", u32(link.ref.slot));
+		return coop::proto::kReasonQuestNotActive;
+	}
+	string128 task = "";
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(holder), "party-quest-finished-talk");
+		luabind::functor<luabind::object> first;
+		if (scope.entered() && ai().script_engine().functor("axr_task_manager.get_first_finished_task", first))
+		{
+			luabind::object r = first(npc->lua_game_object());
+			if (r.type() == LUA_TSTRING)
+				xr_strcpy(task, sizeof(task), luabind::object_cast<LPCSTR>(r));
+		}
+	}
+	if (!task[0])
+	{
+		g_host->log.line("talk-quest-blocked slot=%u op=finish why=no-finished-task", u32(link.ref.slot));
+		return coop::proto::kReasonQuestNotActive;
+	}
+	sync_party_actors();
+	Host::PartyTask* t = party_task(task);
+	if (!t)
+	{
+		++g_host->talk_actions_blocked;
+		g_host->log.line("talk-quest-blocked slot=%u op=finish task=%s why=not-a-party-task", u32(link.ref.slot), task);
+		return coop::proto::kReasonQuestUnsupported;
+	}
+	coop::proto::ActionResult none;
+	none.operation_id = 0;
+	for (Host::PendingTurnIn& p : g_host->turn_ins)
+		if (p.task == task)
+		{
+			p.waiters.push_back({link.player, link.join_serial, none, link.ref.slot});
+			g_host->log.line("quest-turnin-joined slot=%u task=%s waiters=%u source=talk", u32(link.ref.slot), task,
+				u32(p.waiters.size()));
+			return 0;
+		}
+	s32 stage = -1;
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(holder), "party-quest-check");
+		lua_call_ok("campaign_party_check", stage, (LPCSTR)task);
+	}
+	if (stage != 1)
+	{
+		g_host->log.line("quest-not-finished slot=%u task=%s stage=%d count=%d need=%d source=talk", u32(link.ref.slot), task,
+			stage, t->count, t->need);
+		return coop::proto::kReasonQuestNotFinished;
+	}
+	luabind::functor<void> begin;
+	if (ai().script_engine().functor("campaign_party_begin_turnin", begin))
+		begin((LPCSTR)task);
+	bool ok = false;
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(holder), "party-quest-turnin-talk");
+		ok = scope.entered() && quest_turnin_phrases(holder, npc);
+	}
+	g_host->log.line("quest-turnin slot=%u task=%s holder=%u dialogue=talk ok=%d", u32(link.ref.slot), task,
+		u32(t->holder), ok ? 1 : 0);
+	if (!ok)
+	{
+		lua_call_void("campaign_party_end_turnin");
+		return coop::proto::kReasonQuestNotFinished;
+	}
+	Host::PendingTurnIn pending;
+	pending.waiters.push_back({link.player, link.join_serial, none, link.ref.slot});
+	pending.task = task;
+	pending.since_tick = g_host->tick;
+	pending.slot = link.ref.slot;
+	g_host->turn_ins.push_back(pending);
+	return 0;
+}
+
+// campaign::coop_server_dialogue_action for the talking player: true when the
+// action is the party quest's accept or turn-in (taken over); the player is
+// told a refusal as news.
+static bool talk_quest_action(PlayerLink& link, LPCSTR action, const CGameObject* speaker, const CGameObject* listener,
+	LPCSTR dialog_id, LPCSTR phrase_id)
+{
+	const bool accept = !xr_strcmp(action, "dialogs.npc_give_task");
+	const bool finish = !xr_strcmp(action, "dialogs.npc_set_finished_task_complete");
+	if (!accept && !finish)
+		return false;
+	const CGameObject* npc_const = smart_cast<const CActor*>(speaker) ? listener : speaker;
+	CGameObject* npc = const_cast<CGameObject*>(npc_const);
+	if (!npc || smart_cast<CActor*>(npc))
+		return false;
+	++g_host->talk_quest_routed;
+	const u16 reason = accept ? talk_quest_accept(link, npc) : talk_quest_turn_in(link, npc);
+	g_host->log.line("talk-quest slot=%u op=%s npc=%u dialog=%s phrase=%s reason=%u", u32(link.ref.slot),
+		accept ? "accept" : "finish", u32(npc->ID()), dialog_id, phrase_id, u32(reason));
+	if (reason)
+		if (CActor* actor = participant_actor(link.ref))
+			campaign::present_to_actor(actor, campaign::Presentation::News, 0,
+				reason == coop::proto::kReasonQuestActive ? "Co-op: the party already has this task" :
+				reason == coop::proto::kReasonQuestUnsupported ? "Co-op: this task is not supported yet" :
+				reason == coop::proto::kReasonQuestNotFinished ? "Co-op: the party's task is not finished yet" :
+				reason == coop::proto::kReasonQuestNotActive ? "Co-op: the party does not have this task" :
+				reason == coop::proto::kReasonNoActor ? "Co-op: Player 1 must be alive to take the task" :
+				"Co-op: the task was not given");
+	return true;
+}
+
+// The talk fixture (profile talk_party): once both players are in the world,
+// both actors are placed beside Sidorovich (as the quest fixture) and rounds
+// run through the step driver (CampaignEvent 7, client script 8; actions 14
+// start, 15 say-path (extra: 1 the task accept, 2 the turn-in, 3 an unknown
+// id; with no talk open one say as it is), 16 end; item = the giver):
+//   0  p1 starts, walks the accept path, ends          -> the party task accepted by talking
+//   1  p1 starts; p2 starts while p1 talks; p1 ends    -> p2 refused 33 (busy)
+//   2  p2 starts, walks the accept path, ends          -> the accept action refused 16 (the party has it), news
+//   3  the patches appear beside each actor; each picks up its half
+//   4  p1 starts, walks the turn-in path, ends         -> the party task completed by talking
+//      (talk_variant 1: p2, who did not accept, turns it in)
+//   5  p1 says with no talk open (34); p1 starts, says an unknown id (35);
+//      p2 starts (33); p1 ends; p2 ends with no talk (34)
+const u32 kTalkRounds = 6;
+
+void talk_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.talk_party || !ai().get_alife())
+		return;
+	Host::TalkFixture& f = g_host->talk_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.ref.slot < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				actors[link.ref.slot] = actor;
+				++attached;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-talk both-attached tick=%I64u", g_host->tick);
+	}
+	if (attached < 2)
+		return;
+	if (f.phase == 0)
+	{
+		if (g_host->tick < f.both_since + u64(config.talk_party) * 50)
+			return;
+		f.giver = find_giver();
+		CObject* giver = f.giver != 0xffff ? Level().Objects.net_Find(f.giver) : nullptr;
+		if (!giver)
+		{
+			if (g_host->tick - f.both_since > u64(config.talk_party) * 50 + 30 * 50)
+			{
+				g_host->log.line("fixture-talk giver-missing");
+				f.phase = 99;
+			}
+			return;
+		}
+		const Fvector g = giver->Position();
+		for (u32 k = 0; k < 2; ++k)
+		{
+			f.actors[k] = u16(actors[k]->ID());
+			Fvector at = g;
+			at.x += k ? -1.2f : 1.2f;
+			place_beside(actors[k], at);
+			g_host->log.line("fixture-talk placed slot=%u actor=%u giver=%u at=%.2f,%.2f,%.2f", k, u32(f.actors[k]),
+				u32(f.giver), VPUSH(at));
+		}
+		f.phase = 1;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		if (g_host->tick - f.phase_tick < 5 * 50)
+			return;
+		f.phase = 2;
+		f.round_tick = g_host->tick;
+		return;
+	}
+	if (f.phase != 2 || f.round >= kTalkRounds || g_host->tick < f.round_tick)
+		return;
+	const u16 G = f.giver;
+	xr_vector<TransferStep> steps;
+	if (f.round == 3)
+	{
+		const Host::PartyTask* t = party_task("esc_m_trader_task_3");
+		if (!f.spawned)
+		{
+			if (!t)
+			{
+				g_host->log.line("fixture-talk no-task-after-round-0");
+				f.round = kTalkRounds;
+				return;
+			}
+			CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+			const s32 need = t->need > 0 ? t->need : 6;
+			for (s32 i = 0; i < need; ++i)
+			{
+				const u32 k = u32(i) < u32(need + 1) / 2 ? 0 : 1;
+				Fvector at = actors[k]->Position();
+				at.x += 0.3f * float(i % 3) - 0.3f;
+				at.z += 0.4f;
+				at.y += 0.3f;
+				const CSE_ALifeDynamicObject* anchor = ai().alife().objects().object(f.actors[k], true);
+				CSE_Abstract* patch = anchor ? alife->spawn_item("bandit_patch", at, actors[k]->ai_location().level_vertex_id(),
+					anchor->m_tGraphID, u16(-1)) : nullptr;
+				if (patch)
+					f.patches[k].push_back(patch->ID);
+			}
+			f.spawned = true;
+			f.phase_tick = g_host->tick;
+			g_host->log.line("fixture-talk patches need=%d p0=%u p1=%u", need, u32(f.patches[0].size()), u32(f.patches[1].size()));
+			return;
+		}
+		bool all = true;
+		for (u32 k = 0; k < 2; ++k)
+			for (u16 id : f.patches[k])
+				all = all && delivered(id);
+		if (!all && g_host->tick - f.phase_tick < 15 * 50)
+			return;
+		u16 offset = 0;
+		for (u32 k = 0; k < 2; ++k)
+			for (u16 id : f.patches[k])
+			{
+				steps.push_back({u8(k), 5, offset, id, 0xffff, f.actors[k], 0, 0});
+				offset = u16(offset + 15);
+			}
+		f.round_tick = g_host->tick + 20 * 50 + u64(offset);
+	}
+	else
+		f.round_tick = g_host->tick + 12 * 50;
+	const u32 round = f.round++;
+	switch (round)
+	{
+	case 0:
+	case 4:
+	{
+		const u8 who = round == 4 && config.talk_variant == 1 ? 1 : 0;
+		steps.push_back({who, 14, 0, G, 0xffff, 0xffff, 0, 0});
+		steps.push_back({who, 15, 50, G, 0xffff, 0xffff, 0, u8(round == 0 ? 1 : 2)});
+		steps.push_back({who, 16, 400, G, 0xffff, 0xffff, 0, 0});
+		break;
+	}
+	case 1:
+		steps.push_back({0, 14, 0, G, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 14, 50, G, 0xffff, 0xffff, 0, 0});
+		steps.push_back({0, 16, 150, G, 0xffff, 0xffff, 0, 0});
+		break;
+	case 2:
+		steps.push_back({1, 14, 0, G, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 15, 50, G, 0xffff, 0xffff, 0, 1});
+		steps.push_back({1, 16, 400, G, 0xffff, 0xffff, 0, 0});
+		break;
+	case 3:
+		break; // the pickups above
+	default:
+		steps.push_back({0, 15, 0, G, 0xffff, 0xffff, 0, 3});
+		steps.push_back({0, 14, 50, G, 0xffff, 0xffff, 0, 0});
+		steps.push_back({0, 15, 100, G, 0xffff, 0xffff, 0, 3});
+		steps.push_back({1, 14, 150, G, 0xffff, 0xffff, 0, 0});
+		steps.push_back({0, 16, 200, G, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 16, 250, G, 0xffff, 0xffff, 0, 0});
+		break;
+	}
+	const u64 claim_tick = g_host->tick + 100;
+	std::vector<u8> payload;
+	put_u8(payload, u8(round));
+	put_u8(payload, u8(round));
+	for (int b = 0; b < 8; ++b)
+		payload.push_back(u8(claim_tick >> (8 * b)));
+	put_u8(payload, u8(steps.size()));
+	string512 detail = "";
+	for (const TransferStep& st : steps)
+	{
+		put_u8(payload, st.slot);
+		put_u8(payload, st.action);
+		put_u16(payload, st.offset);
+		put_ref(payload, st.item);
+		put_ref(payload, st.from);
+		put_ref(payload, st.to);
+		put_u8(payload, st.flags);
+		put_u8(payload, st.extra);
+		string64 one;
+		xr_sprintf(one, " %u:%u@%u:%u:x%u", u32(st.slot), u32(st.action), u32(st.offset), u32(st.item), u32(st.extra));
+		xr_strcat(detail, one);
+	}
+	broadcast_event(7, payload);
+	g_host->log.line("fixture-talk-round round=%u claim_tick=%I64u steps=%u%s", round, claim_tick, u32(steps.size()), detail);
+}
