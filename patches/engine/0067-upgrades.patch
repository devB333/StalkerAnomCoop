+// ------------------------------------------------------------ S10-T04f
+// The upgrade and repair fixture (profile upgrade_party, server-driven). Once
+// both players are in the world: both placed beside the nearest online
+// mechanic (an inventory owner whose character profile has mechanic_mode);
+// p1 gets 50000 RU and the mechanic's tier infos (party-shared, T04b).
+//   talk       p1 talks to the mechanic and opens the upgrade session (the table);
+//              p2's talk start must be refused busy (33)
+//   install    p1 installs the first upgrade the table marks installable on the
+//              first item that has one (take_upgrade op 1); the item has it after
+//   repair     p1's first weapon is worn to 0.5, then repaired (op 2): condition 1
+//   recovered  (the restarted server) the upgrade and repair records replayed
+//              (upgrade-replayed); the item still has the upgrade; p1's money
+// the nearest online mechanic who talks, one of the player's own community
+// first (upgrade-3: the nearest was the army checkpoint's, who refuses a loner)
+static u16 find_mechanic(const Fvector& origin, CHARACTER_COMMUNITY_INDEX community)
+{
+	u16 best = 0xffff;
+	float best_score = flt_max;
+	for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+	{
+		CObject* o = Level().Objects.o_get_by_iterator(i);
+		CInventoryOwner* owner = o ? smart_cast<CInventoryOwner*>(o) : nullptr;
+		CEntityAlive* alive = o ? smart_cast<CEntityAlive*>(o) : nullptr;
+		if (!owner || !alive || !alive->g_Alive() || smart_cast<CActor*>(o) || !is_mechanic(owner, smart_cast<CGameObject*>(o)) ||
+			!owner->IsTalkEnabled())
+			continue;
+		const float d = o->Position().distance_to(origin) +
+			(owner->CharacterInfo().Community().index() == community ? 0.f : 10000.f);
+		if (d < best_score)
+		{
+			best_score = d;
+			best = u16(o->ID());
+		}
+	}
+	return best;
+}
