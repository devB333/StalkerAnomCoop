diff --git a/src/xrGame/CampaignActorControl.cpp b/src/xrGame/CampaignActorControl.cpp
new file mode 100644
index 0000000..449cf68
--- /dev/null
+++ b/src/xrGame/CampaignActorControl.cpp
@@ -0,0 +1,126 @@
+#include "pch_script.h"
+#include "CampaignActorControl.h"
+
+// S03-T03: see CampaignActorControl.h.
+
+#include "CampaignActorAccess.h"
+#include "Actor.h"
+#include "Level.h"
+#include "ai_space.h"
+#include "alife_simulator.h"
+#include "alife_graph_registry.h"
+#include "xrServer_Objects_ALife_Monsters.h"
+
+using namespace campaign;
+
+namespace
+{
+ActorControlStats s_stats = {};
+
+bool server_role()
+{
+	return g_campaign_identity && g_campaign_identity->role() == Role::Server;
+}
+
+// The actor the context acts on, under Scope::Self; null and counted otherwise.
+CActor* input_actor(const ActionContext& context, Refusal& why)
+{
+	++s_stats.input_calls;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	if (!actor)
+	{
+		++s_stats.input_refused;
+		if (s_stats.input_refused <= 16)
+			Msg("! S03-T03 actor input refused: %s (origin %u session %u participant {%u,%u})", refusal_name(why),
+				u32(context.origin), context.session, u32(context.actor.slot), context.actor.generation);
+	}
+	return actor;
+}
+} // namespace
+
+namespace campaign
+{
+bool controls_actor(const CActor* actor)
+{
+	++s_stats.control_checks;
+	if (!actor || !g_pGameLevel)
+		return false;
+	if (!server_role())
+		return Level().CurrentControlEntity() == actor;
+	const bool held = is_participant_actor(actor);
+	if (held)
+		++s_stats.control_server_true;
+	return held;
+}
+
+bool script_binding_allowed(const CGameObject* object)
+{
+	if (!server_role() || !object)
+	{
+		++s_stats.binder_allowed;
+		return true;
+	}
+	const CActor* actor = smart_cast<const CActor*>(object);
+	if (!actor)
+	{
+		++s_stats.binder_allowed;
+		return true;
+	}
+	const CSE_ALifeCreatureActor* sp_actor = ai().get_alife() ? ai().alife().graph().actor() : nullptr;
+	if (sp_actor && sp_actor->ID == object->ID())
+	{
+		++s_stats.binder_allowed;
+		return true;
+	}
+	++s_stats.binder_refused_actor;
+	Msg("! S03-T03 actor %u gets no single-player Lua binder on the server: the script actor is %u (participant "
+		"script context is S03-T05)",
+		u32(object->ID()), sp_actor ? u32(sp_actor->ID) : u32(-1));
+	return false;
+}
+
+Refusal actor_input_hold(const ActionContext& context, int cmd)
+{
+	Refusal why = Refusal::None;
+	if (CActor* actor = input_actor(context, why))
+		actor->IR_OnKeyboardHold(cmd);
+	return why;
+}
+
+Refusal actor_input_press(const ActionContext& context, int cmd)
+{
+	Refusal why = Refusal::None;
+	if (CActor* actor = input_actor(context, why))
+		actor->IR_OnKeyboardPress(cmd);
+	return why;
+}
+
+Refusal actor_input_release(const ActionContext& context, int cmd)
+{
+	Refusal why = Refusal::None;
+	if (CActor* actor = input_actor(context, why))
+		actor->IR_OnKeyboardRelease(cmd);
+	return why;
+}
+
+Refusal actor_input_look(const ActionContext& context, int dx, int dy)
+{
+	Refusal why = Refusal::None;
+	if (CActor* actor = input_actor(context, why))
+		actor->IR_OnMouseMove(dx, dy);
+	return why;
+}
+
+const ActorControlStats& actor_control_stats()
+{
+	return s_stats;
+}
+
+void report_actor_control(LPCSTR tag)
+{
+	Msg("S03-T03 actor-control %s control_checks=%I64u control_server_true=%I64u input_calls=%I64u "
+		"input_refused=%I64u binder_allowed=%I64u binder_refused_actor=%I64u",
+		tag, s_stats.control_checks, s_stats.control_server_true, s_stats.input_calls, s_stats.input_refused,
+		s_stats.binder_allowed, s_stats.binder_refused_actor);
+}
+} // namespace campaign
diff --git a/src/xrGame/CampaignActorControl.h b/src/xrGame/CampaignActorControl.h
new file mode 100644
index 0000000..09219ca
--- /dev/null
+++ b/src/xrGame/CampaignActorControl.h
@@ -0,0 +1,66 @@
+#pragma once
+
+// S03-T03: per-participant actor control, split from the one local control
+// entity.
+//
+// The engine drives an actor's movement from its own input state
+// (mstate_wishful, set by the actor's IR_* handlers, and its camera yaw) in
+// CActor::shedule_Update, but only for the object the process controls
+// (Level().CurrentControlEntity(), IGame_Level.h); every other actor is
+// interpolated from network updates. The campaign server controls no entity
+// and simulates two actors, so "is this actor controlled here" must be
+// answered by the participant model, not by the process's one control entity:
+//
+//  - controls_actor(actor): client: the actor is the local control entity
+//    (unchanged); server: the actor is a participant's (every participant
+//    actor runs its own control path from its own input state).
+//  - ActorInput: the input context of one participant. The server feeds a
+//    participant's commands to that participant's actor through the actor's
+//    own IR_* handlers, under an authorized ActionContext (Scope::Self): a
+//    context that does not resolve to the participant's actor moves nobody and
+//    is counted. The harness is the source here; Stage 4 delivers the client's
+//    intents to the same functions.
+//  - script_binding_allowed(object): the installed single-player scripts bind
+//    `bind_stalker.actor_init` to the `actor` section and treat the bound
+//    object as the one player (db.actor, db.actor_binder, the weather, surge
+//    and psi-storm managers reset in net_spawn and finalized in net_destroy).
+//    On the server that binder attaches to the single-player script actor
+//    only: the ALife actor (CALifeGraphRegistry::actor(), the entity flagged
+//    M_SPAWN_OBJECT_ASPLAYER). Another participant's actor gets no Lua binder
+//    until S03-T05 defines the per-participant script context; the refusal is
+//    counted and logged, never silent.
+
+#include "CampaignIdentity.h"
+
+class CActor;
+class CGameObject;
+
+namespace campaign
+{
+// Whether this process runs the actor's control path (CActor::shedule_Update).
+bool controls_actor(const CActor* actor);
+
+// Whether the object's section-declared Lua binder may attach here.
+bool script_binding_allowed(const CGameObject* object);
+
+// The input context of one participant: each call resolves the context's
+// actor (Scope::Self) and forwards to that actor's own handler. The refusal
+// is returned (None on success) and counted.
+Refusal actor_input_hold(const ActionContext& context, int cmd);
+Refusal actor_input_press(const ActionContext& context, int cmd);
+Refusal actor_input_release(const ActionContext& context, int cmd);
+Refusal actor_input_look(const ActionContext& context, int dx, int dy);
+
+struct ActorControlStats
+{
+	u64 control_checks; // controls_actor() calls
+	u64 control_server_true; // ...answered true on the server
+	u64 input_calls; // actor_input_* calls
+	u64 input_refused; // ...refused (no actor for the context)
+	u64 binder_allowed; // script bindings attached
+	u64 binder_refused_actor; // actor binders refused on the server (not the SP script actor)
+};
+
+const ActorControlStats& actor_control_stats();
+void report_actor_control(LPCSTR tag);
+} // namespace campaign
