+// Fixtures: a forced storm, and the installed surge_manager / psi_storm_manager
+// started on demand, so many seconds after both players are in the world.
+void weather_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!(config.storm || config.surge || config.psi_storm) || !ai().get_alife() || !g_pGamePersistent)
+		return;
+	Host::WeatherFixture& w = g_host->weather;
+	if (!w.both_since)
+	{
+		u32 attached = 0;
+		for (PlayerLink& link : g_host->links)
+			if (link.bound && client_in_world(link) && participant_actor(link.ref))
+				++attached;
+		if (attached < 2)
+			return;
+		w.both_since = g_host->tick;
+		g_host->log.line("fixture-weather both-attached tick=%I64u", g_host->tick);
+	}
+	const u64 elapsed = (g_host->tick - w.both_since) / 50;
+	if (config.storm && !w.storm_done && elapsed >= config.storm)
+	{
+		w.storm_done = true;
+		g_pGamePersistent->Environment().SetWeather("w_storm1", true);
+		g_host->log.line("fixture-storm weather=w_storm1 forced=1 now=%s",
+			g_pGamePersistent->Environment().CurrentWeatherName.size() ? *g_pGamePersistent->Environment().CurrentWeatherName : "-");
+	}
+	if (config.surge && !w.surge_done && elapsed >= config.surge)
+	{
+		w.surge_done = true;
+		const bool ok = call_lua("surge_manager.start_surge");
+		g_host->log.line("fixture-surge called=%d", ok ? 1 : 0);
+	}
+	if (config.psi_storm && !w.psi_done && elapsed >= config.psi_storm)
+	{
+		w.psi_done = true;
+		const bool ok = call_lua("psi_storm_manager.start_psi_storm");
+		g_host->log.line("fixture-psi-storm called=%d", ok ? 1 : 0);
+	}
+}
