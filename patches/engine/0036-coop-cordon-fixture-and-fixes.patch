 //   u32 'CWLD', u32 1, u8 slot, u8 name_len, name, u8 actors, {u8 slot, u16 id},
 //   u32 online, {u16 id, u64 entity, u32 generation}, u32 scop, bytes, u32 scoc, bytes
+// S06-T06: the player's client has sent inside the session, so it has its
+// Welcome (session::PlayerView::confirmed). The world stream's chunks go on
+// the bulk channel, which is not ordered against the Welcome on the control
+// channel; at 10 % loss a chunk arrived before a resent Welcome and the client
+// closed (cenc-14, "message before the session started").
+bool player_confirmed(const PlayerLink& link)
+{
+	for (const coop::session::PlayerView& p : g_host->server->players())
+		if (p.player == link.player)
+			return p.connected && p.confirmed;
+	return false;
+}
