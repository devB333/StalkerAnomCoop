+void send_action(u16 kind, const xr_vector<u8>& params, LPCSTR what);
+
+// S06-T07: a player's own weapon switch and reload reach the server as the
+// actions the test programs send. Only the fire key did before: in a hands-on
+// session a player's reload refilled only the local magazine (the server's
+// stayed empty, so later shots hit nobody) and a pistol drawn locally stayed
+// holstered on the server (demo-4). The client's own inventory decides what
+// the player asked for (keys, wheel, menus): the slot its actor is switching
+// to, and a reload starting. A slot the server set (apply_actor_outcomes) is
+// not sent back. Not while the combat or encounter program (scripts 3, 4)
+// sends its own weapon actions.
+void forward_player_actions()
+{
+	if (g_link->config.script == 3 || g_link->config.script == 4 || !g_actor || !g_actor->g_Alive() ||
+		g_link->world != WorldLive)
+		return;
+	const u16 target = g_actor->inventory().GetNextActiveSlot();
+	if (g_link->own_slot_sent != 0xff && target != g_link->own_slot_sent && target <= BOLT_SLOT)
+	{
+		g_link->own_slot_sent = u8(target);
+		xr_vector<u8> slot;
+		slot.push_back(u8(target));
+		send_action(coop::proto::kActionActivateSlot, slot, "player-slot");
+		++g_link->player_slot_actions;
+	}
+	const CWeapon* weapon = smart_cast<const CWeapon*>(g_actor->inventory().ActiveItem());
+	const bool reloading = weapon && weapon->GetState() == CWeapon::eReload;
+	if (reloading && !g_link->own_reloading)
+	{
+		send_action(coop::proto::kActionReload, xr_vector<u8>(), "player-reload");
+		++g_link->player_reload_actions;
+	}
+	g_link->own_reloading = reloading;
+}
