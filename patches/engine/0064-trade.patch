+bool coop_client_trade_open(CInventoryOwner* partner)
+{
+	if (!g_link || !g_link->active)
+		return false;
+	Link::Trade& t = g_link->trade;
+	if (g_link->world != WorldLive || !g_actor)
+		return true; // nothing trades locally on a replica
+	CGameObject* go = smart_cast<CGameObject*>(partner);
+	coop::proto::EntityRef ref;
+	if (!go || !ref_of(u16(go->ID()), ref))
+	{
+		g_link->log.line("trade-open-unknown npc=%u", go ? u32(go->ID()) : 0xffffu);
+		return true;
+	}
+	if (t.open || t.pending_open)
+	{
+		g_link->log.line("trade-open-ignored npc=%u open=%d pending=%d", u32(go->ID()), t.open ? 1 : 0, t.pending_open ? 1 : 0);
+		return true;
+	}
+	t.pending_open = true;
+	t.npc = u16(go->ID());
+	t.npc_ref = ref;
+	request_ownership(coop::proto::kActionTradeOpen, ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, true, "player");
+	g_link->log.line("trade-open-sent npc=%u", u32(go->ID()));
+	return true;
+}
+
+bool coop_client_trade_active()
+{
+	return g_link && g_link->active && g_link->trade.open;
+}
+
+bool coop_client_trade_price(const CInventoryItem* item, bool trader_buying, u32& price)
+{
+	if (!g_link || !g_link->active || !g_link->trade.open || !item)
+		return false;
+	const Link::Trade& t = g_link->trade;
+	const xr_map<u16, u32>& table = trader_buying ? t.sell : t.buy;
+	const auto it = table.find(u16(item->object().ID()));
+	price = it != table.end() ? it->second : 0;
+	return true;
+}
+
+void coop_client_trade_perform(const xr_vector<u16>& bought, const xr_vector<u16>& sold)
+{
+	if (!coop_client_trade_active() || !g_actor)
+		return;
+	Link::Trade& t = g_link->trade;
+	if (t.pending_perform)
+	{
+		g_link->log.line("trade-perform-ignored why=pending");
+		return;
+	}
+	if (bought.empty() && sold.empty())
+		return;
+	xr_vector<u8> params;
+	params.push_back(u8(bought.size()));
+	params.push_back(u8(sold.size()));
+	u32 expected = 0;
+	for (int side = 0; side < 2; ++side)
+		for (u16 id : side ? sold : bought)
+		{
+			coop::proto::EntityRef ref;
+			if (!ref_of(id, ref))
+			{
+				g_link->log.line("trade-perform-unknown item=%u", u32(id));
+				return;
+			}
+			push_ref(params, ref);
+			const xr_map<u16, u32>& table = side ? t.sell : t.buy;
+			const auto it = table.find(id);
+			expected += it != table.end() ? it->second : 0;
+		}
+	for (int b = 0; b < 4; ++b)
+		params.push_back(u8(expected >> (8 * b)));
+	t.pending_perform = true;
+	++t.performs;
+	request_ownership(coop::proto::kActionTrade, t.npc_ref, params, 0, 0xffffffff, 0xffffffff, true, "player");
+	g_link->log.line("trade-sent npc=%u bought=%u sold=%u", u32(t.npc), u32(bought.size()), u32(sold.size()));
+}
+
+void coop_client_trade_closed()
+{
+	if (!g_link || !g_link->active)
+		return;
+	Link::Trade& t = g_link->trade;
+	if (!t.open && !t.pending_open)
+		return;
+	const bool was_open = t.open;
+	t.open = false;
+	t.pending_open = false;
+	t.pending_perform = false;
+	t.buy.clear();
+	t.sell.clear();
+	if (was_open)
+		request_ownership(coop::proto::kActionTradeClose, t.npc_ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, false, "player");
+	g_link->log.line("trade-closed npc=%u", u32(t.npc));
+}
