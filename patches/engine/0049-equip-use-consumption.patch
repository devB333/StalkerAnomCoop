+// S08-T07
+std::vector<u8> encode_equip(const EquipRecord& r)
+{
+	std::vector<u8> out;
+	put<u8>(out, r.slot);
+	put<u64>(out, r.player.hi);
+	put<u64>(out, r.player.lo);
+	put<u64>(out, r.operation);
+	put<u64>(out, r.actor_entity);
+	put<u64>(out, r.item_entity);
+	put<u8>(out, r.place);
+	put<u8>(out, r.inv_slot);
+	put<u8>(out, r.flags);
+	return out;
+}
+
+bool decode_equip(const std::vector<u8>& payload, EquipRecord& out)
+{
+	size_t at = 0;
+	return get(payload, at, out.slot) && get(payload, at, out.player.hi) && get(payload, at, out.player.lo) &&
+		get(payload, at, out.operation) && get(payload, at, out.actor_entity) && get(payload, at, out.item_entity) &&
+		get(payload, at, out.place) && get(payload, at, out.inv_slot) && get(payload, at, out.flags) &&
+		at == payload.size() && out.actor_entity && out.item_entity && out.place >= 1 && out.place <= 3;
+}
+
+namespace
+{
+void put_text(std::vector<u8>& out, const xr_string& text)
+{
+	const u8 length = u8(_min(text.size(), size_t(255)));
+	put<u8>(out, length);
+	out.insert(out.end(), text.begin(), text.begin() + length);
+}
+
+bool get_text(const std::vector<u8>& payload, size_t& at, xr_string& out)
+{
+	u8 length = 0;
+	if (!get(payload, at, length) || at + length > payload.size())
+		return false;
+	out.assign(reinterpret_cast<const char*>(payload.data() + at), length);
+	at += length;
+	return true;
+}
+} // namespace
+
+std::vector<u8> encode_use(const UseRecord& r)
+{
+	std::vector<u8> out;
+	put<u8>(out, r.slot);
+	put<u64>(out, r.player.hi);
+	put<u64>(out, r.player.lo);
+	put<u64>(out, r.operation);
+	put<u64>(out, r.actor_entity);
+	put<u64>(out, r.item_entity);
+	put_text(out, r.section);
+	put<u8>(out, r.uses_after);
+	put<u8>(out, r.consumed);
+	put<u64>(out, r.game_time);
+	put<float>(out, r.health);
+	put<float>(out, r.power);
+	put<float>(out, r.radiation);
+	put<float>(out, r.psy_health);
+	put<float>(out, r.satiety);
+	const u8 count = u8(_min(r.effects.size(), size_t(255)));
+	put<u8>(out, count);
+	for (u8 i = 0; i < count; ++i)
+	{
+		const UseEffect& e = r.effects[i];
+		put<u8>(out, e.op);
+		put<u64>(out, e.item_entity);
+		if (e.op == 2)
+			put<u8>(out, e.uses);
+		else if (e.op == 4)
+		{
+			put<u64>(out, e.owner_entity);
+			for (float f : e.position)
+				put<float>(out, f);
+		}
+		else if (e.op == 3)
+		{
+			put_text(out, e.section);
+			const size_t n = _min(e.state.size(), size_t(0xffff));
+			put<u16>(out, u16(n));
+			out.insert(out.end(), e.state.begin(), e.state.begin() + n);
+		}
+	}
+	return out;
+}
+
+bool decode_use(const std::vector<u8>& payload, UseRecord& out)
+{
+	size_t at = 0;
+	u8 count = 0;
+	if (!(get(payload, at, out.slot) && get(payload, at, out.player.hi) && get(payload, at, out.player.lo) &&
+			get(payload, at, out.operation) && get(payload, at, out.actor_entity) &&
+			get(payload, at, out.item_entity) && get_text(payload, at, out.section) &&
+			get(payload, at, out.uses_after) && get(payload, at, out.consumed) && get(payload, at, out.game_time) &&
+			get(payload, at, out.health) && get(payload, at, out.power) && get(payload, at, out.radiation) &&
+			get(payload, at, out.psy_health) && get(payload, at, out.satiety) && get(payload, at, count)) ||
+		!out.actor_entity || !out.item_entity || out.section.empty() || out.consumed > 1)
+		return false;
+	out.effects.clear();
+	for (u8 i = 0; i < count; ++i)
+	{
+		UseEffect e;
+		e.uses = 0;
+		if (!get(payload, at, e.op) || !get(payload, at, e.item_entity) || !e.item_entity)
+			return false;
+		if (e.op == 2)
+		{
+			if (!get(payload, at, e.uses))
+				return false;
+		}
+		else if (e.op == 4)
+		{
+			if (!get(payload, at, e.owner_entity) || !get(payload, at, e.position[0]) ||
+				!get(payload, at, e.position[1]) || !get(payload, at, e.position[2]))
+				return false;
+		}
+		else if (e.op == 3)
+		{
+			u16 n = 0;
+			if (!get_text(payload, at, e.section) || e.section.empty() || !get(payload, at, n) ||
+				at + n > payload.size())
+				return false;
+			e.state.assign(payload.begin() + at, payload.begin() + at + n);
+			at += n;
+		}
+		else if (e.op != 1)
+			return false;
+		out.effects.push_back(e);
+	}
+	return at == payload.size();
+}
