--- /dev/null
+++ b/src/Coop.props
@@ -0,0 +1,36 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  S05-T01: links the project-owned co-op libraries (workspace protocol/,
+  built by tools/Build-Protocol.ps1 with the same pinned compiler, /MD,
+  C++17) into xrGame and the executable. tools/Build-Stage2.ps1 passes:
+    CoopProtocolDir     <workspace>\protocol\        (headers)
+    CoopProtocolLibDir  <protocol build>\protocol\   (coop_*.lib)
+    CoopGnsDir          <GNS install>\               (lib\GameNetworkingSockets.lib)
+    CoopBuildId         64 hex digits (docs/session-authentication.md)
+  GameNetworkingSockets.dll is delay-loaded: single-player never touches it.
+-->
+<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
+  <PropertyGroup>
+    <CoopProject Condition="'$(MSBuildProjectName)' == 'xrGame' or '$(MSBuildProjectName)' == 'xrEngine'">true</CoopProject>
+  </PropertyGroup>
+  <ItemDefinitionGroup Condition="'$(CoopProject)' == 'true'">
+    <ClCompile>
+      <AdditionalIncludeDirectories>$(CoopProtocolDir)include;$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
+    </ClCompile>
+    <Link>
+      <AdditionalLibraryDirectories>$(CoopProtocolLibDir);$(CoopGnsDir)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
+      <DelayLoadDLLs>GameNetworkingSockets.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
+    </Link>
+  </ItemDefinitionGroup>
+  <Target Name="CoopCheckInputs" BeforeTargets="ClCompile" Condition="'$(CoopProject)' == 'true'">
+    <Error Condition="'$(CoopProtocolDir)' == '' or !Exists('$(CoopProtocolDir)include\coop\session\server.h')" Text="S05-T01: CoopProtocolDir must name the workspace protocol directory (tools/Build-Stage2.ps1 passes it)." />
+    <Error Condition="'$(CoopProtocolLibDir)' == '' or !Exists('$(CoopProtocolLibDir)coop_session.lib')" Text="S05-T01: CoopProtocolLibDir must name a protocol build's library directory." />
+    <Error Condition="'$(CoopGnsDir)' == '' or !Exists('$(CoopGnsDir)lib\GameNetworkingSockets.lib')" Text="S05-T01: CoopGnsDir must name the pinned GameNetworkingSockets install." />
+    <Error Condition="'$(CoopBuildId.Length)' != '64'" Text="S05-T01: CoopBuildId must be 64 hex digits." />
+  </Target>
+  <!-- Only CoopIdentity.cpp includes this header, so a new id recompiles one file. -->
+  <Target Name="CoopWriteBuildId" BeforeTargets="ClCompile" AfterTargets="CoopCheckInputs" Condition="'$(MSBuildProjectName)' == 'xrGame'">
+    <MakeDir Directories="$(IntDir)" />
+    <WriteLinesToFile File="$(IntDir)coop_build_id.h" Lines="// Generated by Coop.props (S05-T01). Do not edit.;#define COOP_BUILD_ID &quot;$(CoopBuildId)&quot;" Overwrite="true" WriteOnlyWhenDifferent="true" />
+  </Target>
+</Project>
