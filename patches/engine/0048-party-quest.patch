+	"end\n"
+	"local function amount(a, sec)\n"
+	"  local n = 0\n"
+	"  a:iterate_inventory(function(_, o) if o:section() == sec then n = n + 1 end end, nil)\n"
+	"  return n\n"
+	"end\n"
+	"local function pooled(id)\n"
+	"  local h = obj(P.tasks[id]) if not h then return nil end\n"
+	"  local sec = load_var(h, id .. '_fetch') if not sec then return nil end\n"
+	"  local need = load_var(h, id .. '_fetch_count') or 1\n"
+	"  local total = 0\n"
+	"  for _, aid in ipairs(P.actors) do local a = obj(aid) if a then total = total + amount(a, sec) end end\n"
+	"  P.counts[id] = total P.needs[id] = need\n"
+	"  return total, need, sec\n"
+	"end\n"
+	"function campaign_party_count(id) local t, n = pooled(id) return t or -1 end\n"
+	"function campaign_party_need(id) local t, n = pooled(id) return n or -1 end\n"
+	"function campaign_party_section(id) local t, n, s = pooled(id) return s or '' end\n"
+	"function campaign_party_check(id)\n"
