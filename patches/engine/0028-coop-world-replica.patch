+// ------------------------------------------------------------ S05-T02
+// Lifecycle: the clients' world is the set of the server's online ALife
+// objects. Each tick the host compares it with what it published and turns
+// the difference into Spawn (the object came online: its native spawn packet)
+// and Despawn (offline: OutOfRange; gone from ALife: Destroyed) messages, each
+// with the next commit id. A player whose world stream started gets every
+// message after its checkpoint's watermark, in commit order, paced below the
+// lifecycle channel's backlog bound.
+
+const u32 kChunkBytes = coop::proto::kMaxResyncChunk;
+const u32 kLifecycleBacklogLimit = 512 * 1024;
+const u32 kBulkBacklogLimit = 160 * 1024;
+
+bool entity_ref_of(u16 id, coop::proto::EntityRef& out)
+{
+	EngineEntityKey key;
+	EntityId entity;
+	if (!g_campaign_identity->current_key(id, key) || g_campaign_identity->resolve(key, entity) != Refusal::None)
+		return false;
+	out.id = entity.value;
+	out.generation = key.generation;
+	return out.id != 0 && out.generation != 0;
+}
+
+// The protocol's archetype alphabet is [a-z0-9_.-]; the native packet carries
+// the real section.
+std::string archetype_of(LPCSTR section)
+{
+	std::string out;
+	for (LPCSTR c = section; c && *c && out.size() < coop::proto::kMaxArchetype; ++c)
+	{
+		char ch = char(tolower(*c));
+		if (!((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '.' || ch == '-'))
+			ch = '_';
+		out += ch;
+	}
+	return out.empty() ? std::string("x") : out;
+}
+
+u32 depth_of(u16 id)
+{
+	u32 depth = 0;
+	for (CSE_Abstract* e = Level().Server->ID_to_entity(id); e && e->ID_Parent != 0xffff && depth < 16; ++depth)
+		e = Level().Server->ID_to_entity(e->ID_Parent);
+	return depth;
+}
+
+void lifecycle_csv(LPCSTR kind, u16 id, const coop::proto::EntityRef& ref, u32 reason, LPCSTR section,
+	const Fvector& position)
+{
+	if (g_host->lifecycle_csv)
+		fprintf(g_host->lifecycle_csv, "%I64u,%s,%u,%I64u,%u,%u,%s,%.3f,%.3f,%.3f\n", g_host->commit, kind, u32(id),
+			ref.id, ref.generation, reason, section, VPUSH(position));
+}
+
+void queue_event(const coop::proto::Message& m)
+{
+	for (PlayerLink& link : g_host->links)
+		if (link.world == WorldStreaming || link.world == WorldLive)
+		{
+			link.outbox.push_back(m);
+			link.outbox_peak = _max(link.outbox_peak, u64(link.outbox.size()));
+		}
+}
