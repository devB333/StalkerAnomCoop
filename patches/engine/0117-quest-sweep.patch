+// ------------------------------------------------------------ B57 quest sweep
+// The quest sweep fixture (profile quest_sweep; tools/make-quest-sweep-list.py
+// writes the list, compare-coop-quest-sweep.py reads the result lines). For
+// each listed task, one at a time, as players would:
+//   giver    a named giver on this level (found online, or the players are
+//            placed at its ALife position until it comes online), a random
+//            stalker of the task's faction spawned beside the players (its
+//            roll set to the task, made friendly), or none (story tasks)
+//   accept   one player (alternating) talks to the giver: the task dialogue
+//            topic, "next" until the task is offered, then accept; a task
+//            the talk does not give is given directly to the party
+//   goal     fetch: the items appear in both players' pockets (split);
+//            bounty: the target is killed by the other player; any other:
+//            forced (the check reports the giver's stage, or completes)
+//   turn-in  the other player talks to the giver (the completed-task topic);
+//            without a giver or that topic, the fixture's turn-in path
+//   verify   completed (the party's or the native task), both players' money,
+//            items taken and given, both actors and their ALife objects
+// One fixture-qsweep result line per task; failures never stop the sweep.
+namespace
+{
+LPCSTR const qsweep_source =
+	"local P = rawget(_G, '__campaign_party')\n"
+	"if type(P) ~= 'table' or P.qsweep then return end\n"
+	"P.qsweep = true\n"
+	"P.qs_force = {}\n"
+	"local cls = task_objects and task_objects.CGeneralTask\n"
+	"if cls and cls.check_task then\n"
+	"  local orig = cls.check_task\n"
+	"  cls.check_task = function(self, tm)\n"
+	"    local f = P.qs_force[self.id]\n"
+	"    if not f then return orig(self, tm) end\n"
+	"    if f == 'stage' then\n"
+	"      self.stage = task_manager.task_ini:r_float_ex(self.id, 'stage_complete') or 1\n"
+	"      self.last_check_task = nil\n"
+	"    else\n"
+	"      self.last_check_task = 'complete'\n"
+	"    end\n"
+	"  end\n"
+	"end\n"
+	"function campaign_qsweep_force(id, mode) P.qs_force[id] = mode end\n"
+	"function campaign_qsweep_unforce(id) P.qs_force[id] = nil end\n"
+	"function campaign_qsweep_offered(npc) local t = axr_task_manager.available_tasks[npc] return t and t[1] or '' end\n"
+	"function campaign_qsweep_status(id)\n"
+	"  local t = task_manager.get_task_manager().task_info[id]\n"
+	"  if not t then return 'none' end\n"
+	"  return tostring(t.status or 'active') .. ':' .. tostring(t.stage or -1)\n"
+	"end\n"
+	"function campaign_qsweep_stage_complete(id)\n"
+	"  return task_manager.task_ini:r_float_ex(id, 'stage_complete') or -1\n"
+	"end\n"
+	"function campaign_qsweep_prepare_giver(npc, id)\n"
+	"  local st = db.storage[npc]\n"
+	"  if st and id ~= '' then st.dyn_quest_rand = id end\n"
+	"  local n = level.object_by_id(npc)\n"
+	"  if n then\n"
+	"    for _, aid in ipairs(P.actors) do\n"
+	"      local a = level.object_by_id(aid)\n"
+	"      if a then n:force_set_goodwill(1000, a) end\n"
+	"    end\n"
+	"  end\n"
+	"  return st and 1 or 0\n"
+	"end\n"
+	"function campaign_qsweep_give(id, giver)\n"
+	"  task_manager.get_task_manager():give_task(id, giver >= 0 and giver or nil)\n"
+	"  return task_manager.get_task_manager().task_info[id] and 1 or 0\n"
+	"end\n"
+	"function campaign_qsweep_drop(id)\n"
+	"  P.qs_force[id] = nil\n"
+	"  local tm = task_manager.get_task_manager()\n"
+	"  local t = tm.task_info[id]\n"
+	"  if t and t.status ~= 'completed' and t.status ~= 'fail' then tm:set_task_cancelled(id) return 1 end\n"
+	"  return 0\n"
+	"end\n";
+
+bool qsweep_lua_string(CActor* actor, LPCSTR fn, LPCSTR arg, xr_string& out)
+{
+	luabind::functor<LPCSTR> f;
+	if (!ai().script_engine().functor(fn, f))
+		return false;
+	if (actor)
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "qsweep");
+		if (!scope.entered())
+			return false;
+		LPCSTR r = f(arg);
+		out = r ? r : "";
+	}
+	else
+	{
+		LPCSTR r = f(arg);
+		out = r ? r : "";
+	}
+	return true;
+}
+
+xr_string qsweep_offered(u16 npc)
+{
+	luabind::functor<LPCSTR> f;
+	if (!ai().script_engine().functor("campaign_qsweep_offered", f))
+		return "";
+	LPCSTR r = f(int(npc));
+	return r ? r : "";
+}
+
+u16 qsweep_talk_start(PlayerLink& link, u16 npc)
+{
+	coop::proto::ActionIntent intent;
+	intent.operation_id = ++g_host->quest_sweep.operation;
+	intent.kind = coop::proto::kActionTalkStart;
+	coop::proto::EntityRef ref;
+	if (!entity_ref_of(npc, ref))
+		return coop::proto::kReasonNoTalk;
+	intent.target = ref;
+	coop::proto::ActionResult result;
+	return take_talk_start(link, intent, result);
+}
+
+u16 qsweep_say(PlayerLink& link, LPCSTR id)
+{
+	coop::proto::ActionIntent intent;
+	intent.operation_id = ++g_host->quest_sweep.operation;
+	intent.kind = coop::proto::kActionTalkSay;
+	const u32 n = xr_strlen(id);
+	intent.params.push_back(u8(n));
+	for (u32 i = 0; i < n; ++i)
+		intent.params.push_back(u8(id[i]));
+	coop::proto::ActionResult result;
+	return take_talk_say(link, intent, result);
+}
+
+void qsweep_talk_end(PlayerLink& link)
+{
+	if (link.talk_npc == 0xffff)
+		return;
+	coop::proto::ActionIntent intent;
+	intent.operation_id = ++g_host->quest_sweep.operation;
+	intent.kind = coop::proto::kActionTalkEnd;
+	coop::proto::ActionResult result;
+	take_talk_end(link, intent, result);
+}
+
+// the topic (dialog id) of the open talk whose id contains want and not avoid
+bool qsweep_topic(CActor* actor, CGameObject* npc, LPCSTR want, LPCSTR avoid, xr_string& out, xr_string& all)
+{
+	CPhraseDialogManager* ours = smart_cast<CPhraseDialogManager*>(actor);
+	CPhraseDialogManager* theirs = smart_cast<CPhraseDialogManager*>(npc);
+	if (!ours || !theirs)
+		return false;
+	campaign::ScriptContextScope scope(static_cast<const CObject*>(actor), "qsweep-topics");
+	ours->UpdateAvailableDialogs(theirs);
+	bool found = false;
+	for (const DIALOG_SHARED_PTR& d : ours->AvailableDialogs())
+	{
+		LPCSTR id = *d->GetDialogID();
+		all += id;
+		all += ' ';
+		if (!found && strstr(id, want) && (!avoid || !strstr(id, avoid)))
+		{
+			out = id;
+			found = true;
+		}
+	}
+	return found;
+}
+
+void qsweep_forget(LPCSTR task)
+{
+	luabind::functor<void> set_task;
+	if (ai().script_engine().functor("campaign_party_set_task", set_task))
+		set_task(task, -1);
+	if (Host::PartyTask* t = party_task(task))
+		g_host->party_tasks.erase(g_host->party_tasks.begin() + (t - g_host->party_tasks.data()));
+}
+
+u16 qsweep_find_online(const xr_string& giver)
+{
+	// npc:<x>: an NPC whose section or object name is x (Sidorovich's is his name)
+	const xr_string want = giver.substr(giver.find(':') + 1);
+	for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+	{
+		CObject* o = Level().Objects.o_get_by_iterator(i);
+		CEntityAlive* alive = smart_cast<CEntityAlive*>(o);
+		if (!alive || !alive->g_Alive() || smart_cast<CActor*>(o) || !smart_cast<CInventoryOwner*>(o))
+			continue;
+		if (!xr_strcmp(*o->cName(), want.c_str()) || !xr_strcmp(*o->cNameSect(), want.c_str()))
+			return u16(o->ID());
+	}
+	return 0xffff;
+}
+
+// a named giver's ALife record on this level (offline: the players go there)
+const CSE_ALifeDynamicObject* qsweep_find_offline(const xr_string& giver)
+{
+	const xr_string want = giver.substr(giver.find(':') + 1);
+	const CALifeObjectRegistry::OBJECT_REGISTRY& objects = ai().alife().objects().objects();
+	for (CALifeObjectRegistry::OBJECT_REGISTRY::const_iterator it = objects.begin(); it != objects.end(); ++it)
+	{
+		const CSE_ALifeHumanAbstract* h = smart_cast<const CSE_ALifeHumanAbstract*>(it->second);
+		if (!h || !h->g_Alive() || smart_cast<const CSE_ALifeCreatureActor*>(it->second))
+			continue;
+		if (!ai().game_graph().valid_vertex_id(h->m_tGraphID) ||
+			ai().game_graph().vertex(h->m_tGraphID)->level_id() != ai().level_graph().level_id())
+			continue;
+		if (!xr_strcmp(h->name_replace(), want.c_str()) || !xr_strcmp(h->s_name.c_str(), want.c_str()))
+			return h;
+	}
+	return nullptr;
+}
+
+void qsweep_heal(CActor* a)
+{
+	if (a && a->g_Alive() && a->GetfHealth() < 0.6f)
+		a->SetfHealth(1.f);
+}
