+// S08-T09: CampaignEvent 12: this player's survival values as the server
+// holds them (f32 thirst, sleep, psy health; -1: that module is off). The
+// installed scripts' HUD indicators read their own variables: the client
+// sets them (and the psy bar) and runs no survival update of its own.
+void on_needs(const coop::proto::CampaignEvent& event)
+{
+	PayloadReader r(event.payload);
+	float v[3];
+	for (float& x : v)
+		x = r.get<float>();
+	lua_State* L = ai().script_engine().lua();
+	if (!r.ok || !L || !g_actor)
+		return;
+	const struct
+	{
+		LPCSTR module, name, field;
+	} target[3] = {{"actor_status_thirst", "last_drink", nullptr}, {"actor_status_sleep", "last_sleep", nullptr},
+		{"arszi_psy", "psy_table", "actor_psy_health"}};
+	u32 set = 0;
+	for (int i = 0; i < 3; ++i)
+	{
+		if (v[i] < 0.f || !_valid(v[i]))
+			continue;
+		const int top = lua_gettop(L);
+		const int at = campaign::script_module_upvalue(L, target[i].module, target[i].name);
+		if (at)
+		{
+			if (target[i].field)
+			{
+				lua_getupvalue(L, -1, at);
+				if (lua_istable(L, -1))
+				{
+					lua_pushnumber(L, v[i]);
+					lua_setfield(L, -2, target[i].field);
+					++set;
+				}
+			}
+			else
+			{
+				lua_pushnumber(L, v[i]);
+				lua_setupvalue(L, -2, at);
+				++set;
+			}
+		}
+		lua_settop(L, top);
+	}
+	if (v[2] >= 0.f)
+		g_actor->conditions().SetPsyBar(v[2]);
+	++g_link->needs_received;
+	g_link->log.line("needs-applied thirst=%.1f sleep=%.1f psy=%.4f set=%u", v[0], v[1], v[2], set);
+}
