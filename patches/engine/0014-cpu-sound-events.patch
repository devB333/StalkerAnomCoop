diff --git a/src/xrGame/CampaignHearingCapture.cpp b/src/xrGame/CampaignHearingCapture.cpp
new file mode 100644
index 0000000..e319d74
--- /dev/null
+++ b/src/xrGame/CampaignHearingCapture.cpp
@@ -0,0 +1,319 @@
+#include "pch_script.h"
+#include "CampaignHearingCapture.h"
+#include "CampaignActivityCapture.h"
+
+// S02-T05c: nothing here produces a sound. The emitters come from the
+// simulation (CStepManager footsteps, script sound objects, physics impacts),
+// the AI events from the sound core's emitter state machine
+// (CSoundRender_Emitter::Event_Propagade), the hearers from
+// IGame_Level::SoundEvent_Register and the receptions from
+// CSoundMemoryManager::feel_sound_new; the fixture reads their counters.
+
+#include "Level.h"
+#include "ai/stalker/ai_stalker.h"
+#include "memory_manager.h"
+#include "sound_memory_manager.h"
+#include "../xrServerEntities/ai_sounds.h"
+#include "../xrEngine/xr_object.h"
+#include "../xrCDB/ISpatial.h"
+#include "../xrEngine/device.h"
+#include "../xrEngine/xr_ioconsole.h"
+
+extern float g_step_sound_distance; // step_manager.cpp
+static const float impact_sound_distance = 70.f; // physics_game.cpp SOUND_EFFECT_DIST
+static const float hearer_query_radius = 50.f;
+static const u16 default_npc_id = 19409;
+
+namespace
+{
+struct Counters
+{
+	u32 started, events, events_2d_skipped, registered, delegates, dispatched, feel_calls;
+};
+
+struct Fixture
+{
+	FILE* out;
+	bool running;
+	u16 id;
+	u32 ticks;
+	Counters begin;
+	xr_vector<IGame_Level::SoundEventRecord> trace;
+	u32 npc_events;
+	u32 npc_walk_events;
+	u32 step_events;
+	bool finite;
+};
+
+Fixture g_fixture;
+
+u32 option_u32(LPCSTR name, u32 fallback)
+{
+	u32 value = fallback;
+	LPCSTR at = strstr(Core.Params, name);
+	if (at)
+		sscanf(at + xr_strlen(name), "%u", &value);
+	return value;
+}
+
+CAI_Stalker* npc_alive(u16 id)
+{
+	CObject* object = Level().Objects.net_Find(id);
+	CAI_Stalker* npc = object && !object->getDestroy() ? smart_cast<CAI_Stalker*>(object) : nullptr;
+	return npc && npc->g_Alive() ? npc : nullptr;
+}
+
+LPCSTR core_name()
+{
+	if (strstr(Core.Params, "-snd_cpu"))
+		return "cpu";
+	if (strstr(Core.Params, "-nosound"))
+		return "none";
+	return "openal";
+}
+
+Counters read_counters()
+{
+	Counters c = {};
+	CSound_stats stats = {};
+	if (::Sound)
+	{
+		::Sound->statistic(&stats, nullptr);
+		c.started = stats._started;
+		c.events = stats._events_total;
+		c.events_2d_skipped = stats._events_2d_skipped;
+	}
+	if (g_pGameLevel)
+	{
+		c.registered = g_pGameLevel->snd_Stats.registered;
+		c.delegates = g_pGameLevel->snd_Stats.delegates;
+		c.dispatched = g_pGameLevel->snd_Stats.dispatched;
+	}
+	c.feel_calls = CSoundMemoryManager::s_feel_calls;
+	return c;
+}
+
+u32 hearers_near(const Fvector& position)
+{
+	xr_vector<ISpatial*> found;
+	Fvector size = {hearer_query_radius, hearer_query_radius, hearer_query_radius};
+	g_SpatialSpace->q_box(found, 0, STYPE_REACTTOSOUND, position, size);
+	u32 count = 0;
+	for (ISpatial* spatial : found)
+	{
+		CObject* object = spatial->dcast_CObject();
+		if (object && !object->getDestroy())
+			++count;
+	}
+	return count;
+}
+
+void check(float value, bool& finite)
+{
+	if (!_valid(value))
+		finite = false;
+}
+
+void log_summary(LPCSTR prefix, const HearingFixtureSummary& s, bool ok, LPCSTR out)
+{
+	Msg("%s npc=%u ticks=%u sim_ms=%u wall_ms=%u started=%u events=%u events_2d_skipped=%u registered=%u "
+		"delegates=%u dispatched=%u feel_calls=%u npc_events=%u npc_walk_events=%u step_events=%u npc_feel=%u "
+		"finite=%d ok=%d out=%s",
+		prefix, u32(s.npc_id), s.ticks, s.sim_ms, s.wall_ms, s.started, s.events, s.events_2d_skipped, s.registered,
+		s.delegates, s.dispatched, s.feel_calls, s.npc_events, s.npc_walk_events, s.step_events, s.npc_feel,
+		s.finite ? 1 : 0, ok ? 1 : 0, out);
+	if (!ok)
+		Msg("! %s missing: %s", prefix, s.missing);
+}
+} // namespace
+
+bool HearingFixtureBegin(LPCSTR out_path, HearingFixtureSummary& summary)
+{
+	ZeroMemory(&summary, sizeof(summary));
+	summary.finite = true;
+	Fixture& f = g_fixture;
+	f = Fixture();
+	f.finite = true;
+	f.id = u16(option_u32("-s02-activity-npc ", default_npc_id));
+	summary.npc_id = f.id;
+
+	if (!g_pGameLevel || !g_pGameLevel->bReady || !g_SpatialSpace)
+	{
+		xr_strcpy(summary.missing, "no loaded level");
+		return false;
+	}
+	if (!::Sound || !::Sound->is_ready())
+	{
+		xr_strcpy(summary.missing, "no ready sound core (-nosound creates sounds without feedback)");
+		return false;
+	}
+	CAI_Stalker* npc = npc_alive(f.id);
+	if (!npc)
+	{
+		xr_sprintf(summary.missing, "fixture stalker %u is not an alive stalker on the level", u32(f.id));
+		return false;
+	}
+	FILE* out = fopen(out_path, "w");
+	if (!out)
+	{
+		xr_sprintf(summary.missing, "cannot write %s", out_path);
+		return false;
+	}
+	f.out = out;
+	f.begin = read_counters();
+	g_pGameLevel->snd_Trace = &f.trace;
+
+	string_path path;
+	const bool som = FS.exist(path, "$level$", "level.som") != nullptr;
+	const bool snd_env = FS.exist(path, "$level$", "level.snd_env") != nullptr;
+	const Fvector position = npc->Position();
+	fprintf(out, "meta,%u,%u,%s,%s,%d,%d,%u,%.1f,%.1f,%d,%d,%u,%s,%.6f,%.6f,%.6f,%u,%u,%u,%u,%u,%u,%u,%u\n",
+		Device.dwFrame, Device.dwTimeGlobal, *Level().name(), core_name(), ::Sound->has_listener() ? 1 : 0,
+		g_activity_policy.enabled ? 1 : 0, u32(g_activity_policy.anchors.size()), g_step_sound_distance,
+		impact_sound_distance, som ? 1 : 0, snd_env ? 1 : 0, u32(f.id), npc->cName().c_str(), VPUSH(position),
+		hearers_near(position), f.begin.started, f.begin.events, f.begin.events_2d_skipped, f.begin.registered,
+		f.begin.delegates, f.begin.dispatched, f.begin.feel_calls);
+	f.running = true;
+	return true;
+}
+
+void HearingFixtureTick()
+{
+	Fixture& f = g_fixture;
+	if (!f.running)
+		return;
+	++f.ticks;
+	const int phase = ActivityFixturePhase();
+	CAI_Stalker* npc = npc_alive(f.id);
+
+	for (const IGame_Level::SoundEventRecord& r : f.trace)
+	{
+		if (r.source_id == f.id)
+		{
+			++f.npc_events;
+			if (phase == 1)
+				++f.npc_walk_events;
+		}
+		if (r.game_type & SOUND_TYPE_STEP)
+			++f.step_events;
+		check(r.range, f.finite);
+		check(r.max_power, f.finite);
+		check(r.position.x, f.finite);
+		check(r.position.y, f.finite);
+		check(r.position.z, f.finite);
+		fprintf(f.out, "event,%u,%d,%u,%s,%d,%u,%s,%.6f,%.6f,%.6f,%.3f,%.3f,%.3f,%u,%.4f,%u,%.3f\n", f.ticks, phase,
+			r.frame, r.file.c_str(), r.game_type, u32(r.source_id), r.source_name.c_str(), VPUSH(r.position),
+			r.range, r.max_ai_distance, r.volume, r.hearers, r.max_power, u32(r.nearest_id),
+			r.hearers ? r.nearest_distance : -1.f);
+	}
+	f.trace.clear();
+
+	CSound_stats stats = {};
+	::Sound->statistic(&stats, nullptr);
+	const Counters c = read_counters();
+	fprintf(f.out, "tick,%u,%d,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u\n", f.ticks, phase, Device.dwFrame,
+		Device.dwTimeGlobal, stats._simulated, stats._rendered, c.started, c.events, c.events_2d_skipped,
+		c.registered, c.delegates, c.dispatched, c.feel_calls, npc ? npc->memory().sound().feel_count() : 0,
+		npc ? u32(npc->memory().sound().objects().size()) : 0);
+}
+
+bool HearingFixtureEnd(u32 frames, u32 sim_ms, u32 wall_ms, HearingFixtureSummary& summary)
+{
+	Fixture& f = g_fixture;
+	if (!f.out)
+	{
+		if (!summary.missing[0])
+			xr_strcpy(summary.missing, "fixture was not started");
+		return false;
+	}
+	f.running = false;
+	if (g_pGameLevel)
+		g_pGameLevel->snd_Trace = nullptr;
+	const Counters c = read_counters();
+	CAI_Stalker* npc = npc_alive(f.id);
+
+	summary.ticks = f.ticks;
+	summary.sim_ms = sim_ms;
+	summary.wall_ms = wall_ms;
+	summary.started = c.started - f.begin.started;
+	summary.events = c.events - f.begin.events;
+	summary.events_2d_skipped = c.events_2d_skipped - f.begin.events_2d_skipped;
+	summary.registered = c.registered - f.begin.registered;
+	summary.delegates = c.delegates - f.begin.delegates;
+	summary.dispatched = c.dispatched - f.begin.dispatched;
+	summary.feel_calls = c.feel_calls - f.begin.feel_calls;
+	summary.npc_events = f.npc_events;
+	summary.npc_walk_events = f.npc_walk_events;
+	summary.step_events = f.step_events;
+	summary.npc_feel = npc ? npc->memory().sound().feel_count() : 0;
+	summary.finite = f.finite;
+
+	if (!summary.started)
+		xr_strcpy(summary.missing, "no sound emitter started");
+	else if (!summary.registered)
+		xr_strcpy(summary.missing, "no AI sound event reached the level");
+	else if (!summary.delegates)
+		xr_strcpy(summary.missing, "no AI sound event reached a hearer");
+	else if (!summary.dispatched || !summary.feel_calls)
+		xr_strcpy(summary.missing, "no feel_sound_new call was made");
+	else if (!summary.npc_walk_events)
+		xr_sprintf(summary.missing, "stalker %u produced no AI sound event while walking", u32(f.id));
+	else if (!summary.finite)
+		xr_strcpy(summary.missing, "a sampled value is not finite");
+	const bool ok = !summary.missing[0];
+	fprintf(f.out, "end,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%d\n", f.ticks, sim_ms, wall_ms, summary.started,
+		summary.events, summary.events_2d_skipped, summary.registered, summary.delegates, summary.dispatched,
+		summary.feel_calls, summary.npc_events, summary.npc_walk_events, summary.step_events, summary.npc_feel,
+		ok ? 1 : 0);
+	fclose(f.out);
+	f.out = nullptr;
+	(void)frames;
+	return ok;
+}
+
+static HearingFixtureSummary g_server_summary;
+static string_path g_server_out;
+
+extern "C" bool __cdecl xrCampaignLevel_HearingFixtureBegin(LPCSTR out_path)
+{
+	xr_strcpy(g_server_out, out_path);
+	const bool ok = HearingFixtureBegin(out_path, g_server_summary);
+	if (!ok)
+		log_summary("S02-T05c hearing", g_server_summary, false, out_path);
+	return ok;
+}
+
+extern "C" void __cdecl xrCampaignLevel_HearingFixtureTick()
+{
+	HearingFixtureTick();
+}
+
+extern "C" bool __cdecl xrCampaignLevel_HearingFixtureEnd(u32 frames, u32 sim_ms, u32 wall_ms)
+{
+	const bool ok = HearingFixtureEnd(frames, sim_ms, wall_ms, g_server_summary);
+	log_summary("S02-T05c hearing", g_server_summary, ok, g_server_out);
+	return ok;
+}
+
+static HearingFixtureSummary g_client_summary;
+static string_path g_client_out;
+static bool g_client_begun = false;
+
+void ClientHearingCaptureBegin(LPCSTR out_path)
+{
+	xr_strcpy(g_client_out, out_path);
+	g_client_begun = HearingFixtureBegin(out_path, g_client_summary);
+	if (!g_client_begun)
+		log_summary("S02-T05c client hearing", g_client_summary, false, out_path);
+}
+
+void ClientHearingCaptureTick()
+{
+	HearingFixtureTick();
+}
+
+void ClientHearingCaptureEnd(u32 frames, u32 elapsed_ms)
+{
+	const bool ok = HearingFixtureEnd(frames, elapsed_ms, elapsed_ms, g_client_summary) && g_client_begun;
+	log_summary("S02-T05c client hearing", g_client_summary, ok, g_client_out);
+}
diff --git a/src/xrGame/CampaignHearingCapture.h b/src/xrGame/CampaignHearingCapture.h
new file mode 100644
index 0000000..067e6c5
--- /dev/null
+++ b/src/xrGame/CampaignHearingCapture.h
@@ -0,0 +1,77 @@
+#pragma once
+
+// S02-T05c: CPU sound events and AI hearing on the loaded level (B18). The
+// fixture runs alongside the activity fixture (S02-T04c): while that one
+// observes the level and walks a stalker, this one records the sound emitters
+// the simulation starts (footsteps from the material pairs, script voices,
+// impacts), the AI sound events the sound core propagates to the level, the
+// hearers each event reaches and the NPCs' feel_sound_new calls. The campaign
+// server (CPU sound core, no device, no listener) and the normal client
+// (OpenAL core) write the same CSV rows:
+//   meta,<frame>,<time_ms>,<level>,<core>,<listener>,<policy>,<anchors>,<step_gate_m>,<impact_gate_m>,
+//        <som>,<snd_env>,<npc>,<npc_name>,<px>,<py>,<pz>,<hearers_50m>,<started>,<events>,<events_2d_skipped>,
+//        <registered>,<delegates>,<dispatched>,<feel_calls>
+//        (core: cpu|openal|none; listener: the core has one; step/impact gates: the
+//         range checks around footstep and impact sounds; som/snd_env: the level
+//         has level.som / level.snd_env; hearers_50m: objects that react to sound
+//         within 50 m of the stalker; the counters are the cumulative values at the
+//         begin, so later rows are relative to them)
+//   tick,<n>,<phase>,<frame>,<time_ms>,<emitters>,<rendered>,<started>,<events>,<events_2d_skipped>,
+//        <registered>,<delegates>,<dispatched>,<feel_calls>,<npc_feel>,<npc_sounds>
+//        (phase from the activity fixture, 0 observe, 1 walk; emitters/rendered are
+//         the sound core's live counts; started..feel_calls are cumulative:
+//         emitters started, AI events handed to the level, 2D events the CPU
+//         core dropped, events that reached the spatial query, hearers queued,
+//         feel_sound_new calls made, feel_sound_new calls on any NPC; npc_feel and
+//         npc_sounds are the walked stalker's own calls and remembered sounds)
+//   event,<n>,<phase>,<frame>,<file>,<game_type>,<source_id>,<source_name>,<px>,<py>,<pz>,<range>,<max_ai>,
+//        <volume>,<hearers>,<max_power>,<nearest_id>,<nearest_distance>
+//        (one per registered AI sound event; source_id 65535 when the sound has no object)
+//   end,<ticks>,<sim_ms>,<wall_ms>,<started>,<events>,<events_2d_skipped>,<registered>,<delegates>,<dispatched>,
+//        <feel_calls>,<npc_events>,<npc_walk_events>,<step_events>,<npc_feel>,<ok>
+//        (deltas over the fixture; npc_events: events whose source is the walked
+//         stalker, npc_walk_events: those during the walk; step_events: events of a
+//         step sound type)
+struct HearingFixtureSummary
+{
+	u16 npc_id;
+	u32 ticks;
+	u32 sim_ms;
+	u32 wall_ms;
+	u32 started;
+	u32 events;
+	u32 events_2d_skipped;
+	u32 registered;
+	u32 delegates;
+	u32 dispatched;
+	u32 feel_calls;
+	u32 npc_events;
+	u32 npc_walk_events;
+	u32 step_events;
+	u32 npc_feel;
+	bool finite;
+	string256 missing; // first missing-data finding, empty when none
+};
+
+// Records the sound core, the gates and the begin counters, attaches the
+// level's event trace and opens the CSV. Returns false and names the reason
+// when there is no loaded level, no sound core or no stalker.
+bool HearingFixtureBegin(LPCSTR out_path, HearingFixtureSummary& summary);
+// Called once after every frame, after the activity fixture's tick: drains the
+// event trace and writes the rows.
+void HearingFixtureTick();
+// Detaches the trace, writes the end row, evaluates the fixture: a sound core
+// is present, emitters started, events reached hearers and feel_sound_new, and
+// the walked stalker produced at least one event while walking.
+bool HearingFixtureEnd(u32 frames, u32 sim_ms, u32 wall_ms, HearingFixtureSummary& summary);
+
+// Campaign server entries, used by the smoke around the activity fixture.
+extern "C" bool __cdecl xrCampaignLevel_HearingFixtureBegin(LPCSTR out_path);
+extern "C" void __cdecl xrCampaignLevel_HearingFixtureTick();
+extern "C" bool __cdecl xrCampaignLevel_HearingFixtureEnd(u32 frames, u32 sim_ms, u32 wall_ms);
+
+// Normal client entries, driven by ClientActivityCaptureOnFrame with
+// -s02-hearing-capture.
+void ClientHearingCaptureBegin(LPCSTR out_path);
+void ClientHearingCaptureTick();
+void ClientHearingCaptureEnd(u32 frames, u32 elapsed_ms);
