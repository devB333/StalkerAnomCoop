diff --git a/src/xrGame/script_binder.cpp b/src/xrGame/script_binder.cpp
index 3247759..800ceb9 100644
--- a/src/xrGame/script_binder.cpp
+++ b/src/xrGame/script_binder.cpp
@@ -19,6 +19,69 @@
 // comment next string when commiting
 //#define DBG_DISABLE_SCRIPTS
 
+// S02-T06: the binder's try/catch blocks used to delete the Lua binder
+// silently. xrGame builds without C++ exceptions, so catch (...) here catches
+// structured exceptions (an access violation in native code called from Lua),
+// while Lua errors go to the script engine's error callback and never reach
+// it. The scheduled update uses an SEH filter instead, which runs before the
+// stack unwinds and so can name the faulting native function and its callers.
+#include <DbgHelp.h>
+#pragma comment(lib, "dbghelp.lib")
+
+static void log_binder_symbol(LPCSTR prefix, void* address)
+{
+	static bool initialized = false;
+	HANDLE process = GetCurrentProcess();
+	if (!initialized)
+	{
+		SymSetOptions(SYMOPT_LOAD_LINES | SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS);
+		SymInitialize(process, NULL, TRUE);
+		initialized = true;
+	}
+	char buffer[sizeof(SYMBOL_INFO) + 512];
+	ZeroMemory(buffer, sizeof(buffer));
+	SYMBOL_INFO* symbol = (SYMBOL_INFO*)buffer;
+	symbol->SizeOfStruct = sizeof(SYMBOL_INFO);
+	symbol->MaxNameLen = 511;
+	DWORD64 displacement = 0;
+	IMAGEHLP_LINE64 line;
+	ZeroMemory(&line, sizeof(line));
+	line.SizeOfStruct = sizeof(line);
+	DWORD line_displacement = 0;
+	const bool have_symbol = SymFromAddr(process, (DWORD64)address, &displacement, symbol) != FALSE;
+	const bool have_line = SymGetLineFromAddr64(process, (DWORD64)address, &line_displacement, &line) != FALSE;
+	Msg("%s %p %s+0x%I64x %s(%u)", prefix, address, have_symbol ? symbol->Name : "?", displacement,
+		have_line ? line.FileName : "", have_line ? line.LineNumber : 0);
+}
+
+static void report_binder_exception(CScriptBinder* binder, LPCSTR phase)
+{
+	CGameObject* object = smart_cast<CGameObject*>(binder);
+	Msg("! CScriptBinder::%s: native exception in the script binder of %s, binder cleared", phase,
+		object ? *object->cName() : "?");
+}
+
+static LONG binder_exception_filter(CScriptBinder* binder, LPCSTR phase, _EXCEPTION_POINTERS* info)
+{
+	CGameObject* object = smart_cast<CGameObject*>(binder);
+	Msg("! CScriptBinder::%s: native exception 0x%08X in the script binder of %s, binder cleared", phase,
+		u32(info->ExceptionRecord->ExceptionCode), object ? *object->cName() : "?");
+	log_binder_symbol("!   fault at", info->ExceptionRecord->ExceptionAddress);
+	void* frames[40];
+	const USHORT count = CaptureStackBackTrace(0, 40, frames, NULL);
+	for (USHORT i = 0; i < count; ++i)
+		log_binder_symbol("!   frame", frames[i]);
+	ai().script_engine().print_stack();
+	return EXCEPTION_EXECUTE_HANDLER;
+}
+
+#define BINDER_CATCH(phase) \
+	catch (...) \
+	{ \
+		report_binder_exception(this, phase); \
+		clear(); \
+	}
+
 CScriptBinder::CScriptBinder()
 {
 	init();
@@ -60,10 +123,7 @@ void CScriptBinder::reinit()
 		{
 			m_object->reinit();
 		}
-		catch (...)
