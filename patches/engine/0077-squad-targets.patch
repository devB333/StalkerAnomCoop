+// S10-T03b: the engine id of the nearest alive participant actor to a point
+// (the same anchors), -1 when none
+int lua_nearest_participant_id(float x, float y, float z)
+{
+	if (!server_role())
+		return -1;
+	xr_vector<CSE_ALifeCreatureActor*> actors;
+	participant_actor_entities(actors);
+	const Fvector at = {x, y, z};
+	float best = -1.f;
+	int id = -1;
+	for (CSE_ALifeCreatureActor* actor : actors)
+	{
+		if (!actor->g_Alive())
+			continue;
+		const float d = actor->o_Position.distance_to(at);
+		if (best < 0.f || d < best)
+		{
+			best = d;
+			id = int(actor->ID);
+		}
+	}
+	return id;
+}
