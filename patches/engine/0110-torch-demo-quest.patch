+		const u32 k = u32(i) % 2;
+		const CSE_ALifeDynamicObject* se = ai().alife().objects().object(u16(actors[k]->ID()), true);
+		if (!se)
+			continue;
+		give_item(alife, "bandit_patch", actors[k], se);
+		++given[k];
+	}
+	g_host->log.line("demo-quest accepted task=%s giver=%u need=%d patches=%u,%u", task, u32(giver_id), need, given[0],
+		given[1]);
+	check_at = g_host->tick + 5 * 50;
