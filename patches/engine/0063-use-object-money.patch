+// S10-T04c: a USE on a script-usable world object (a door, a switch) is the
+// server's: the object's logic (ph_door's on_use) runs there in this
+// player's context and its physics follows on every client (JointDrive);
+// the client's own copy does nothing (true: handled). Items (pickup),
+// living things (talk) and level changers (travel) keep their own paths.
+bool coop_client_use_object(CGameObject* object, CGameObject* who)
+{
+	if (!g_link || !g_link->active || !object || !who)
+		return false;
+	if (smart_cast<CInventoryItem*>(object) || smart_cast<CEntityAlive*>(object) || smart_cast<CLevelChanger*>(object))
+		return false;
+	if (g_link->world != WorldLive || !g_actor || who != g_actor)
+		return true; // nothing uses locally on a replica
+	coop::proto::EntityRef ref;
+	if (!ref_of(u16(object->ID()), ref))
+	{
+		g_link->log.line("use-object-unknown object=%u section=%s", u32(object->ID()), *object->cNameSect());
+		return true;
+	}
+	++g_link->use_objects_requested;
+	request_ownership(coop::proto::kActionUseObject, ref, xr_vector<u8>(), 0, 0xffffffff, 0xffffffff, true, "player");
+	g_link->log.line("use-object-sent object=%u section=%s", u32(object->ID()), *object->cNameSect());
+	return true;
+}
