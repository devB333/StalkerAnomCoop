+// A hands-on aid (start-coop-demo.sh, profile place_giver = N): N seconds
+// after both players are in the world, both actors are placed in front of
+// Sidorovich, once, so the talk window can be tried by hand while a door's
+// USE has no co-op path yet (the bunker door stays shut; S10-T04c).
+void demo_place_tick()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.place_giver || g_host->demo_placed || !ai().get_alife())
+		return;
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.ref.slot < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				actors[link.ref.slot] = actor;
+				++attached;
+			}
+	if (attached < 2)
+	{
+		g_host->demo_place_since = 0;
+		return;
+	}
+	if (!g_host->demo_place_since)
+		g_host->demo_place_since = g_host->tick;
+	if (g_host->tick < g_host->demo_place_since + u64(config.place_giver) * 50)
+		return;
+	g_host->demo_placed = true;
+	const u16 giver_id = find_giver();
+	CObject* giver = giver_id != 0xffff ? Level().Objects.net_Find(giver_id) : nullptr;
+	if (!giver)
+	{
+		g_host->log.line("demo-place giver-missing");
+		return;
+	}
+	// the talk fixture's spots, 1.2 m to either side of him (demo-3/4: a spot
+	// 1.5 m in front of him is inside his desk; the physics ejected the actor
+	// when the partner brushed it and the contact damage killed it)
+	const Fvector g = giver->Position();
+	for (u32 k = 0; k < 2; ++k)
+	{
+		Fvector at = g;
+		at.x += k ? -1.2f : 1.2f;
+		place_beside(actors[k], at);
+		g_host->log.line("demo-place slot=%u actor=%u giver=%u at=%.2f,%.2f,%.2f", k, u32(actors[k]->ID()), u32(giver_id),
+			VPUSH(at));
+	}
+}
