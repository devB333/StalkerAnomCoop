+// ------------------------------------------------------------ S06-T08
+// Storm and emission visuals on both clients (docs/validation/S06-T08.md).
+// Three more CampaignEvent kinds to every live client:
+//   2 environment, every second and on change: the weather cycle and the
+//     two descriptors the engine blends (their cycle and exec_time), or the
+//     weather effect playing (fx_blowout_*, fx_psi_storm_*) and its time
+//     left, so each client's CEnvironment blends exactly what the server's
+//     does from the shared game time;
+//   3 thunderbolt: the server decides each bolt as CEffect_Thunderbolt::Bolt
+//     would (period and duration of the blended descriptor, random entry,
+//     life, direction, distance, tilt, "second" bolt) and clients play it;
+//   4 presentation: the installed scripts' camera and post-process effectors,
+//     sounds and particles from the participant and broadcast outboxes
+//     (CampaignScriptContext.h), each once.
+const u16 kEventEnvironment = 2;
+const u16 kEventThunderbolt = 3;
+const u16 kEventPresentation = 4;
+
+static void put_u8(std::vector<u8>& p, u8 v) { p.push_back(v); }
+static void put_u16(std::vector<u8>& p, u16 v)
+{
+	const u8* b = reinterpret_cast<const u8*>(&v);
+	p.insert(p.end(), b, b + sizeof(v));
+}
+static void put_u32(std::vector<u8>& p, u32 v)
+{
+	const u8* b = reinterpret_cast<const u8*>(&v);
+	p.insert(p.end(), b, b + sizeof(v));
+}
+static void put_f32(std::vector<u8>& p, float v)
+{
+	const u8* b = reinterpret_cast<const u8*>(&v);
+	p.insert(p.end(), b, b + sizeof(v));
+}
+static void put_str(std::vector<u8>& p, LPCSTR v)
+{
+	const u32 n = v ? _min(u32(xr_strlen(v)), 255u) : 0u;
+	p.push_back(u8(n));
+	if (n)
+		p.insert(p.end(), v, v + n);
+}
+
+static void queue_event(PlayerLink& link, u16 kind, const std::vector<u8>& payload)
+{
+	coop::proto::CampaignEvent event;
+	event.kind = kind;
+	event.revision = g_host->commit ? g_host->commit : 1;
+	event.payload = payload;
+	event.event_id = ++g_host->event_seq;
+	link.outbox.push_back(coop::proto::Message(event));
+}
+
+// A client in the world and sending input (one that is still loading its
+// level would get a backlog to replay: cweather-1).
+static bool client_in_world(const PlayerLink& link)
+{
+	return link.world == WorldLive && link.session && link.inputs.has_last();
+}
+
+static void broadcast_event(u16 kind, const std::vector<u8>& payload)
+{
+	for (PlayerLink& link : g_host->links)
+		if (client_in_world(link))
+			queue_event(link, kind, payload);
+}
+
+// The weather cycle a descriptor was loaded with; empty for a weather
+// effect's own copies (SetWeatherFX makes them) and for none.
+static shared_str descriptor_cycle(CEnvironment& env, const CEnvDescriptor* d)
+{
+	if (!d)
+		return shared_str();
+	for (auto it = env.WeatherCycles.begin(); it != env.WeatherCycles.end(); ++it)
+		for (auto e = it->second.begin(); e != it->second.end(); ++e)
+			if (*e == d)
+				return it->first;
+	return shared_str();
+}
+
+void send_environment()
+{
+	if (!ai().get_alife() || !g_pGamePersistent)
+		return;
+	CEnvironment& env = g_pGamePersistent->Environment();
+	const u32 now = g_host->wall.GetElapsed_ms();
+	const shared_str c0 = env.bWFX ? shared_str() : descriptor_cycle(env, env.Current[0]);
+	const shared_str c1 = env.bWFX ? shared_str() : descriptor_cycle(env, env.Current[1]);
+	const float exec0 = env.Current[0] ? env.Current[0]->exec_time : -1.f;
+	const float exec1 = env.Current[1] ? env.Current[1]->exec_time : -1.f;
+	string512 key;
+	xr_sprintf(key, "cycle=%s weather=%s wfx=%d c0=%s@%.2f c1=%s@%.2f", env.CurrentCycleName.size() ? *env.CurrentCycleName : "-",
+		env.CurrentWeatherName.size() ? *env.CurrentWeatherName : "-", env.bWFX ? 1 : 0, c0.size() ? *c0 : "-", exec0,
+		c1.size() ? *c1 : "-", exec1);
+	const bool changed = xr_strcmp(key, g_host->last_env_key) != 0;
+	if (now - g_host->last_env_ms < 1000 && !changed)
+		return;
+	if (changed)
+		g_host->log.line("environment %s wfx_time=%.2f", key, env.wfx_time);
+	g_host->last_env_ms = now;
+	xr_strcpy(g_host->last_env_key, key);
+	std::vector<u8> p;
+	put_u8(p, env.bWFX ? 1u : 0u);
+	put_f32(p, env.wfx_time);
+	put_str(p, env.CurrentCycleName.size() ? *env.CurrentCycleName : "");
+	put_str(p, env.CurrentWeatherName.size() ? *env.CurrentWeatherName : "");
+	put_str(p, c0.size() ? *c0 : "");
+	put_f32(p, exec0);
+	put_str(p, c1.size() ? *c1 : "");
+	put_f32(p, exec1);
+	broadcast_event(kEventEnvironment, p);
+}
+
+// The server's bolts, drawn as CEffect_Thunderbolt::Bolt draws them (the
+// effect itself never runs here: UpdateCPU has no thunderbolt frame).
+void server_thunderbolts()
+{
+	if (!ai().get_alife() || !g_pGamePersistent)
+		return;
+	CEnvironment& env = g_pGamePersistent->Environment();
+	if (!env.CurrentEnv || !env.Current[0] || !env.Current[1])
+		return;
+	const float weight = env.CurrentEnv->weight;
+	const shared_str id = (weight < 0.5f) ? env.Current[0]->tb_id : env.Current[1]->tb_id;
+	const float period = env.CurrentEnv->bolt_period;
+	const float duration = env.CurrentEnv->bolt_duration;
+	Host::Thunder& t = g_host->thunder;
+	const float now = float(g_host->wall.GetElapsed_ms()) * 0.001f;
+	const bool enabled = id.size() > 0;
+	if (enabled != t.enabled)
+	{
+		t.enabled = enabled;
+		t.next = now + period + Random.randF(-period * 0.5f, period * 0.5f);
+		g_host->log.line("thunder %s id=%s period=%.1f duration=%.2f", enabled ? "on" : "off", enabled ? *id : "-", period,
+			duration);
+		return;
+	}
+	if (!enabled || now <= t.next || now < t.working_until)
+		return;
+	const int count = env.m_thunderbolt_collections_config && env.m_thunderbolt_collections_config->section_exist(*id)
+		? int(env.m_thunderbolt_collections_config->line_count(*id)) : 0;
+	if (count <= 0)
+	{
+		t.next = now + period;
+		return;
+	}
+	const float life = duration + Random.randF(-duration * 0.5f, duration * 0.5f);
+	const u32 index = u32(Random.randI(count));
+	float sun_h, sun_p;
+	env.CurrentEnv->sun_dir.getHP(sun_h, sun_p);
+	const float lng = Random.randF(sun_h - env.p_var_long + PI, sun_h + env.p_var_long + PI);
+	const float far_plane = env.CurrentEnv->far_plane;
+	const float dist = Random.randF(far_plane * env.p_min_dist, far_plane * .95f);
+	Fvector dev;
+	dev.x = Random.randF(-env.p_tilt, env.p_tilt);
+	dev.y = Random.randF(0, PI_MUL_2);
+	dev.z = Random.randF(-env.p_tilt, env.p_tilt);
+	const bool second = Random.randF() < env.p_second_prop;
+	t.working_until = now + life;
+	t.next = second ? now + duration + EPS_L : now + period + Random.randF(-period * 0.3f, period * 0.3f);
+	++t.bolts;
+	std::vector<u8> p;
+	put_str(p, *id);
+	put_u32(p, index);
+	put_f32(p, life);
+	put_f32(p, lng);
+	put_f32(p, dist);
+	put_f32(p, dev.x);
+	put_f32(p, dev.y);
+	put_f32(p, dev.z);
+	put_u8(p, second ? 1u : 0u);
+	broadcast_event(kEventThunderbolt, p);
+	g_host->log.line("bolt n=%u id=%s index=%u life=%.2f lng=%.2f dist=%.0f second=%d", t.bolts, *id, index, life, lng,
+		dist, second ? 1 : 0);
+}
