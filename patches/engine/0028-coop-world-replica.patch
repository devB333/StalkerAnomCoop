+// ------------------------------------------------------------ S05-T02
+template <typename T>
+bool take(const xr_vector<u8>& in, size_t& at, T& out)
+{
+	if (at + sizeof(T) > in.size())
+		return false;
+	memcpy(&out, in.data() + at, sizeof(T));
+	at += sizeof(T);
+	return true;
+}
+
+void world_failed(LPCSTR why)
+{
+	g_link->world = WorldFailed;
+	g_link->log.line("world-failed %s", why);
+}
+
+// The checkpoint is complete: write it as this client's saved game, set the
+// replica up and start the level from it (the one start the role guard lets
+// through).
+void world_received()
+{
+	const coop::proto::GuardResult g = g_link->tracker.end(g_link->end);
+	if (g.verdict != coop::proto::Verdict::Accept)
+		return world_failed(g.why);
+	if (coop::session::sha256(g_link->blob.data(), g_link->blob.size()) != g_link->begin.content_hash)
+		return world_failed("content hash mismatch");
+	const xr_vector<u8>& b = g_link->blob;
+	size_t at = 0;
+	u32 magic = 0, format = 0;
+	u8 slot = 0, name_len = 0, actors = 0;
+	if (!take(b, at, magic) || magic != 0x444C5743 || !take(b, at, format) || format != 1 || !take(b, at, slot) ||
+		!take(b, at, name_len) || name_len == 0 || name_len >= sizeof(g_link->save_name) || at + name_len > b.size())
+		return world_failed("bad header");
+	memcpy(g_link->save_name, b.data() + at, name_len);
+	g_link->save_name[name_len] = 0;
+	at += name_len;
+	for (LPCSTR c = g_link->save_name; *c; ++c)
+		if (!isalnum(u8(*c)) && *c != '-' && *c != '_')
+			return world_failed("bad save name");
+	g_link->local_slot = slot;
+	g_link->local_actor = 0xffff;
+	if (!take(b, at, actors))
+		return world_failed("bad actors");
+	for (u8 i = 0; i < actors; ++i)
+	{
+		u8 actor_slot = 0;
+		u16 id = 0;
+		if (!take(b, at, actor_slot) || !take(b, at, id))
+			return world_failed("bad actor");
+		if (actor_slot == slot)
+			g_link->local_actor = id;
+	}
+	if (g_link->local_actor == 0xffff)
+		return world_failed("no actor for this player's slot");
+	u32 online = 0;
+	if (!take(b, at, online) || online > 65536)
+		return world_failed("bad online count");
+	xr_vector<u16> ids;
+	ids.reserve(online);
+	for (u32 i = 0; i < online; ++i)
+	{
+		u16 id = 0;
+		coop::proto::EntityRef ref;
+		if (!take(b, at, id) || !take(b, at, ref.id) || !take(b, at, ref.generation))
+			return world_failed("bad online entry");
+		ids.push_back(id);
+		g_link->refs[id] = ref;
+		g_link->by_entity[ref.id] = id;
+		g_link->table.spawn(ref);
+	}
+	for (LPCSTR extension : {".scop", ".scoc"})
+	{
+		u32 size = 0;
+		if (!take(b, at, size) || at + size > b.size())
+			return world_failed("bad checkpoint section");
+		string_path name, path;
+		xr_sprintf(name, "%s%s", g_link->save_name, extension);
+		FS.update_path(path, "$game_saves$", name);
+		FILE* file = fopen(path, "wb");
+		if (!file || fwrite(b.data() + at, 1, size, file) != size)
+		{
+			if (file)
+				fclose(file);
+			return world_failed("cannot write the checkpoint");
+		}
+		fclose(file);
+		at += size;
+	}
+	FS.rescan_path(FS.get_path("$game_saves$")->m_Path, FALSE);
+	g_link->watermark = g_link->begin.event_watermark;
+	g_link->applied = g_link->watermark;
+	g_link->log.line("world-received resync=%I64u bytes=%u ms=%u save=%s slot=%u local_actor=%u online=%u "
+		"watermark=%I64u buffered=%u",
+		g_link->begin.resync_id, u32(b.size()), g_link->wall.GetElapsed_ms() - g_link->world_started_ms,
+		g_link->save_name, u32(slot), u32(g_link->local_actor), online, g_link->watermark,
+		u32(g_link->buffered.size()));
+	g_link->blob.clear();
+	g_link->blob.shrink_to_fit();
+	campaign::replica_begin(g_link->local_actor, ids);
+	g_link->start_permitted = true;
+	g_link->world = WorldLoading;
+	g_link->load_started_ms = g_link->wall.GetElapsed_ms();
+	string512 command;
+	xr_sprintf(command, "start server(%s/single/alife/load) client(localhost)", g_link->save_name);
+	Console->Execute(command);
+}
+
+void on_chunk(const coop::proto::ResyncChunk& chunk)
+{
+	const coop::proto::GuardResult g = g_link->tracker.chunk(chunk);
+	if (g.verdict != coop::proto::Verdict::Accept)
+		return world_failed(g.why);
+	g_link->blob.insert(g_link->blob.end(), chunk.data.begin(), chunk.data.end());
+	if (g_link->have_end && g_link->blob.size() == g_link->begin.total_bytes)
+		world_received();
+}
+
+// The native spawn packet's id, parent and section (written by the server's
+// CSE_Abstract::Spawn_Write; read like CSE_Abstract::Spawn_Read).
+bool spawn_header(const coop::proto::Spawn& s, NET_Packet& packet, shared_str& section, u16& id, u16& parent,
+	Fvector& position, Fvector& angle)
+{
+	if (s.state.size() < 16 || s.state.size() > sizeof(packet.B.data))
+		return false;
+	packet.B.count = u32(s.state.size());
+	memcpy(packet.B.data, s.state.data(), s.state.size());
+	u16 type = 0;
+	packet.r_begin(type);
+	if (type != M_SPAWN)
+		return false;
+	string256 text;
+	packet.r_stringZ(text);
+	section = text;
+	packet.r_stringZ(text);
+	u8 b;
+	packet.r_u8(b);
+	packet.r_u8(b);
+	packet.r_vec3(position);
+	packet.r_vec3(angle);
+	u16 respawn;
+	packet.r_u16(respawn);
+	packet.r_u16(id);
+	packet.r_u16(parent);
+	return !packet.r_eof();
+}
+
+void apply_spawn(const coop::proto::Spawn& s)
+{
+	if (s.commit_id <= g_link->applied)
+		return;
+	g_link->applied = s.commit_id;
+	NET_Packet packet;
+	shared_str section;
+	u16 id = 0xffff, parent = 0xffff;
+	Fvector position, angle;
+	if (!spawn_header(s, packet, section, id, parent, position, angle))
+	{
+		++g_link->spawns_failed;
+		g_link->log.line("spawn-bad-packet entity=%I64u/%u", s.entity.id, s.entity.generation);
+		return;
+	}
+	const coop::proto::EntityTable::Apply table = g_link->table.spawn(s.entity);
+	if (table != coop::proto::EntityTable::Apply::Ok)
+	{
+		++g_link->events_stale;
+		g_link->log.line("spawn-refused entity=%I64u/%u id=%u table=%u", s.entity.id, s.entity.generation, u32(id),
+			u32(table));
+		return;
+	}
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	CSE_ALifeDynamicObject* known = ai().alife().objects().object(id, true);
+	if (known && known->s_name != section)
+	{
+		// the engine id now names another entity: the old one is gone
+		g_link->log.line("spawn-replaces id=%u old=%s new=%s", u32(id), *known->s_name, *section);
+		campaign::ReplicaPermit permit;
+		alife->release(known, true);
+		known = nullptr;
+	}
+	if (known)
+	{
+		if (!known->m_bOnline)
+		{
+			known->o_Position = position;
+			known->o_Angle = angle;
+		}
+		++g_link->spawns_known;
+	}
+	else
+	{
+		CSE_ALifeDynamicObject* parent_object = parent == 0xffff ? nullptr : ai().alife().objects().object(parent, true);
+		if (parent != 0xffff && !parent_object)
+		{
+			++g_link->spawns_failed;
+			g_link->log.line("spawn-no-parent id=%u parent=%u section=%s", u32(id), u32(parent), *section);
+			return;
+		}
+		campaign::ReplicaPermit permit;
+		if (!parent_object || parent_object->m_bOnline)
+		{
+			// online now, as on the server: the engine's own path for a new entity
+			u16 type = 0;
+			packet.r_begin(type);
+			CSE_Abstract* entity = Level().Server->Process_spawn(packet, ClientID(0xffff));
+			if (!entity || entity->ID != id)
+			{
+				++g_link->spawns_failed;
+				g_link->log.line("spawn-failed id=%u section=%s got=%u", u32(id), *section, entity ? u32(entity->ID) : 0xffffu);
+				return;
+			}
+			++g_link->spawns_created;
+		}
+		else
+		{
+			// inside an offline parent: registered offline; it comes online with it
+			CSE_Abstract* entity = F_entity_Create(*section);
+			CSE_ALifeDynamicObject* dynamic = entity ? smart_cast<CSE_ALifeDynamicObject*>(entity) : nullptr;
+			if (!dynamic)
+			{
+				if (entity)
+					F_entity_Destroy(entity);
+				++g_link->spawns_failed;
+				return;
+			}
+			entity->Spawn_Read(packet);
+			entity->ID = Level().Server->PerformIDgen(id, entity);
+			alife->register_object(dynamic, true);
+			++g_link->spawns_offline_created;
+		}
+	}
+	g_link->refs[id] = s.entity;
+	g_link->by_entity[s.entity.id] = id;
+	campaign::replica_set_online(id, true);
+	campaign::replica_apply_switch(id);
+}
+
+void apply_despawn(const coop::proto::Despawn& d)
+{
+	if (d.commit_id <= g_link->applied)
+		return;
+	g_link->applied = d.commit_id;
+	const auto it = g_link->by_entity.find(d.entity.id);
+	if (it == g_link->by_entity.end())
+	{
+		++g_link->events_unknown;
+		return;
+	}
+	const u16 id = it->second;
+	if (!(g_link->refs[id] == d.entity) || g_link->table.despawn(d.entity) != coop::proto::EntityTable::Apply::Ok)
+	{
+		++g_link->events_stale;
+		return;
+	}
+	campaign::replica_set_online(id, false);
+	if (d.reason == coop::proto::DespawnReason::OutOfRange)
+	{
+		++g_link->despawns_range;
+		campaign::replica_apply_switch(id);
+	}
+	else
+	{
+		++g_link->despawns_destroyed;
+		CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+		CSE_ALifeDynamicObject* object = ai().alife().objects().object(id, true);
+		campaign::ReplicaPermit permit;
+		if (object && object->m_bOnline)
+		{
+			NET_Packet packet;
+			packet.w_begin(M_EVENT);
+			packet.w_u32(Level().timeServer());
+			packet.w_u16(GE_DESTROY);
+			packet.w_u16(id);
+			Level().Send(packet, net_flags(TRUE, TRUE));
+		}
+		else if (object)
+			alife->release(object, true);
+		g_link->refs.erase(id);
+		g_link->by_entity.erase(it);
+	}
+}
+
+void apply_lifecycle(const coop::proto::Message& m)
+{
+	if (const auto* s = std::get_if<coop::proto::Spawn>(&m))
+		apply_spawn(*s);
+	else if (const auto* d = std::get_if<coop::proto::Despawn>(&m))
+		apply_despawn(*d);
+}
+
+// What the replica holds, for comparison with the server's lifecycle log.
+void write_world_summary(LPCSTR tag)
+{
+	string_path path;
+	string64 name;
+	xr_sprintf(name, "coop-world-%s.csv", tag);
+	FS.update_path(path, "$logs$", name);
+	FILE* file = fopen(path, "w");
+	if (!file)
+		return;
+	fprintf(file, "# applied_commit=%I64u watermark=%I64u\nid,entity,generation,section,in_set,online_object,alife_online\n",
+		g_link->applied, g_link->watermark);
+	u32 in_set = 0, objects = 0;
+	for (const auto& r : g_link->refs)
+	{
+		const bool wanted = campaign::replica_wants_online(r.first);
+		CSE_ALifeDynamicObject* object = ai().get_alife() ? ai().alife().objects().object(r.first, true) : nullptr;
+		const bool online_object = g_pGameLevel && Level().Objects.net_Find(r.first) != nullptr;
+		in_set += wanted ? 1 : 0;
+		objects += online_object && wanted ? 1 : 0;
+		fprintf(file, "%u,%I64u,%u,%s,%d,%d,%d\n", u32(r.first), r.second.id, r.second.generation,
+			object ? *object->s_name : "-", wanted ? 1 : 0, online_object ? 1 : 0, object && object->m_bOnline ? 1 : 0);
+	}
+	fclose(file);
+	g_link->log.line("world-summary tag=%s applied=%I64u set=%u present=%u level_objects=%u reconciled=%I64u "
+		"spawns_known=%I64u created=%I64u offline_created=%I64u failed=%I64u despawns=%I64u/%I64u stale=%I64u unknown=%I64u",
+		tag, g_link->applied, in_set, objects, g_pGameLevel ? Level().Objects.o_count() : 0u, g_link->reconciled,
+		g_link->spawns_known, g_link->spawns_created, g_link->spawns_offline_created, g_link->spawns_failed,
+		g_link->despawns_range, g_link->despawns_destroyed, g_link->events_stale, g_link->events_unknown);
+}
+
+void world_frame()
+{
+	// The level goes away on quit (or a disconnect): the replica ends with it.
+	if (g_link->world == WorldLive && (g_link->quitting || !g_pGameLevel || !ai().get_alife()))
+	{
+		g_link->world = WorldMenu;
+		campaign::replica_end();
+		g_link->log.line("world-ended quitting=%d level=%d", g_link->quitting ? 1 : 0, g_pGameLevel ? 1 : 0);
+		return;
+	}
+	if (g_link->world == WorldLoading && g_pGameLevel && g_pGameLevel->bReady && ai().get_alife() && g_actor)
+	{
+		g_link->world = WorldLive;
+		g_link->live_ms = g_link->wall.GetElapsed_ms();
+		const u32 buffered = u32(g_link->buffered.size());
+		for (const coop::proto::Message& m : g_link->buffered)
+			apply_lifecycle(m);
+		g_link->buffered.clear();
+		g_link->log.line("world-live load_ms=%u applied_buffered=%u applied=%I64u actor=%u",
+			g_link->live_ms - g_link->load_started_ms, buffered, g_link->applied, u32(g_actor->ID()));
+		campaign::report_replica("live");
+	}
+	// Anything whose switch did not take (a squad's member order, an object
+	// still loading) is switched again; counted.
+	if (g_link->world == WorldLive && g_link->wall.GetElapsed_ms() - g_link->last_reconcile_ms >= 2000)
+	{
+		g_link->last_reconcile_ms = g_link->wall.GetElapsed_ms();
+		for (const auto& r : g_link->refs)
+		{
+			const bool wanted = campaign::replica_wants_online(r.first);
+			CSE_ALifeDynamicObject* object = ai().alife().objects().object(r.first, true);
+			if (object && object->ID_Parent == 0xffff && wanted != !!object->m_bOnline)
+			{
+				campaign::replica_apply_switch(r.first);
+				++g_link->reconciled;
+			}
+		}
+	}
+	if (g_link->world == WorldLive && g_link->wall.GetElapsed_ms() - g_link->last_summary_ms >= 10000)
+	{
+		g_link->last_summary_ms = g_link->wall.GetElapsed_ms();
+		write_world_summary("latest");
+		campaign::report_replica("status");
+	}
+}
+
 void on_message(const coop::session::ClientEvent& e)
 {
+	// S05-T02: the world stream
+	if (const auto* begin = std::get_if<coop::proto::ResyncBegin>(&e.message.body))
+	{
+		if (g_link->world != WorldMenu)
+		{
+			g_link->log.line("resync-ignored world=%u", u32(g_link->world));
+			return;
+		}
+		const coop::proto::GuardResult g = g_link->tracker.begin(*begin);
+		if (g.verdict != coop::proto::Verdict::Accept)
+			return world_failed(g.why);
+		g_link->begin = *begin;
+		g_link->blob.reserve(size_t(begin->total_bytes));
+		g_link->world = WorldReceiving;
+		g_link->world_started_ms = g_link->wall.GetElapsed_ms();
+		g_link->log.line("resync-begin resync=%I64u bytes=%I64u chunks=%u watermark=%I64u", begin->resync_id,
+			begin->total_bytes, begin->chunk_count, begin->event_watermark);
+		while (!g_link->early_chunks.empty() && g_link->world == WorldReceiving)
+		{
+			on_chunk(g_link->early_chunks.front());
+			g_link->early_chunks.pop_front();
+		}
+		return;
+	}
+	if (const auto* chunk = std::get_if<coop::proto::ResyncChunk>(&e.message.body))
+	{
+		if (g_link->world == WorldMenu && g_link->early_chunks.size() < 64)
+			g_link->early_chunks.push_back(*chunk); // the bulk lane can overtake the control lane
+		else if (g_link->world == WorldReceiving)
+			on_chunk(*chunk);
+		return;
+	}
+	if (const auto* end = std::get_if<coop::proto::ResyncEnd>(&e.message.body))
+	{
+		if (g_link->world != WorldReceiving)
+			return;
+		g_link->end = *end;
+		g_link->have_end = true;
+		if (g_link->blob.size() == g_link->begin.total_bytes)
+			world_received();
+		return;
+	}
+	if (std::get_if<coop::proto::Spawn>(&e.message.body) || std::get_if<coop::proto::Despawn>(&e.message.body))
+	{
+		if (g_link->world == WorldLive && g_pGameLevel && ai().get_alife())
+			apply_lifecycle(e.message.body);
+		else if (g_link->world != WorldFailed && g_link->buffered.size() < 200000)
+			g_link->buffered.push_back(e.message.body);
+		return;
+	}
