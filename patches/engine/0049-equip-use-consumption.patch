+void expect_use(const UseRecord& r)
+{
+	Host::InventoryExpect& e = g_host->inventory_expected[r.item_entity];
+	e.owner = r.actor_entity;
+	e.section = r.section;
+	e.gone = r.consumed != 0;
+	e.uses = r.consumed ? -1 : int(r.uses_after);
+	for (const UseEffect& x : r.effects)
+	{
+		Host::InventoryExpect& o = g_host->inventory_expected[x.item_entity];
+		o.owner = x.op == 4 ? x.owner_entity : r.actor_entity;
+		o.gone = x.op == 1;
+		if (x.op == 4)
+			o.place = 0; // somewhere else now: its owner is what counts
+		if (x.op == 2)
+			o.uses = x.uses;
+		if (x.op == 3)
+			o.section = x.section;
+	}
