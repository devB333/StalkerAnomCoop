+// ------------------------------------------------------------ S10-T02c
+// The psy fixture (profile psy_party, server-driven): once both players are in
+// the world, p1 is moved about 120 m away from p2 (p1 only, L58) and a
+// controller is spawned 15 m in front of p2 (p2 is the anchor). The fixture
+// waits up to 90 s for the controller's psy attack to hit (psy-hit phase 3 or
+// a control hit, phase 7), then kills the controller and reports the hits on
+// each player: p2 (the controller's enemy) is hit, p1 is not; the attack's
+// presentation goes to p2's client only (psy-hit-applied on c2, none on c1);
+// each client shows the controller's aura by its own distance (aura-pp-add).
+void psy_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.psy_party || !ai().get_alife())
+		return;
+	Host::PsyFixture& f = g_host->psy_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u8 slots[2] = {0, 0};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				slots[attached] = link.ref.slot;
+				actors[attached++] = actor;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-psy both-attached tick=%I64u", g_host->tick);
+	}
+	if (attached < 2 || f.phase >= 9 || g_host->tick < f.both_since + u64(config.psy_party) * 50)
+		return;
+	if (slots[0] != 0)
+		std::swap(actors[0], actors[1]);
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	if (f.phase == 0)
+	{
+		LPCSTR section = pSettings->section_exist("m_controller_normal") ? "m_controller_normal" : "m_controller_e";
+		Fvector forward;
+		forward.setHP(actors[1]->XFORM().k.getH(), 0.f);
+		Fvector away;
+		away.sub(actors[0]->Position(), actors[1]->Position());
+		away.y = 0.f;
+		if (away.square_magnitude() < 0.01f)
+			away.set(-forward.x, 0.f, -forward.z);
+		away.normalize();
+		place_beside(actors[0], Fvector().mad(actors[1]->Position(), away, 120.f));
+		f.controller = spawn_at(alife, section, Fvector().mad(actors[1]->Position(), forward, 15.f), u16(actors[1]->ID()));
+		g_host->log.line("fixture-psy spawned controller=%u section=%s p1_distance=%.1f p1=%u p2=%u", u32(f.controller), section,
+			actors[0]->Position().distance_to(actors[1]->Position()), u32(actors[0]->ID()), u32(actors[1]->ID()));
+		if (f.controller == kNoEngineId)
+		{
+			++f.failures;
+			g_host->log.line("fixture-psy done phase=no-spawn failures=%u", f.failures);
+			f.phase = 9;
+			return;
+		}
+		f.phase = 1;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		const bool hit = g_host->psy_events[3] > 0 || g_host->psy_events[7] > 0;
+		if (!hit && g_host->tick - f.phase_tick < 90 * 50)
+			return;
+		f.phase = 2;
+		f.phase_tick = g_host->tick + 3 * 50; // let the stop phase reach the client
+		return;
+	}
+	if (f.phase == 2)
+	{
+		if (g_host->tick < f.phase_tick)
+			return;
+		CEntityAlive* controller = smart_cast<CEntityAlive*>(Level().Objects.net_Find(f.controller));
+		if (controller && controller->g_Alive())
+			controller->KillEntity(u16(actors[1]->ID()));
+		g_host->log.line("fixture-psy done phase=attacked failures=%u hits_p1=%I64u hits_p2=%I64u prepare=%I64u glide=%I64u "
+			"hit=%I64u stop=%I64u control=%I64u health_p1=%.3f health_p2=%.3f", f.failures, g_host->psy_hits_on[0],
+			g_host->psy_hits_on[1], g_host->psy_events[1], g_host->psy_events[2], g_host->psy_events[3], g_host->psy_events[4],
+			g_host->psy_events[7], actors[0]->GetfHealth(), actors[1]->GetfHealth());
+		f.phase = 9;
+	}
+}
+
