+bool fixture_engine_id()
+{
+	Fixture f("engine-id-fixture");
+	engine_generator_type* generator = xr_new<engine_generator_type>();
+	CampaignIdentityRegistry registry(Role::Server);
+	registry.on_server_incarnation();
+
+	// One release with free time 0, the time the script release path passes
+	// (alife_simulator_script.cpp): the generator hands the same id out again.
+	const u16 first = generator->tfGetID(u16(-1));
+	const EngineEntityKey key_first = registry.on_engine_id_assigned(first);
+	EntityId entity;
+	f.expect(registry.resolve(key_first, entity), Refusal::None, "a live key resolves");
+	f.check(entity.value == 1, "the first entity id is 1");
+	generator->vfFreeID(first, 0);
+	registry.on_engine_id_freed(first);
+	f.expect(registry.resolve(key_first, entity), Refusal::StaleReference, "a freed key is stale");
+	const u16 second = generator->tfGetID(u16(-1));
+	const EngineEntityKey key_second = registry.on_engine_id_assigned(second);
+	Msg("S03-T01 engine-id first=%u freed-at-0 then=%u generation %u -> %u", u32(first), u32(second),
+		key_first.generation, key_second.generation);
+	f.check(second == first, "the generator reused the id freed at time 0");
+	f.check(key_second != key_first, "the reassignment has a new generation");
+	f.expect(registry.resolve(key_first, entity), Refusal::StaleReference, "the old key does not resolve to the new object");
+	f.expect(registry.resolve(key_second, entity), Refusal::None, "the new key resolves");
+	f.check(entity.value == 2, "the reassignment has a new entity id");
+
+	// A release stamped with a later time: the generator prefers blocks freed
+	// earlier, so the id comes back later rather than at once (xrServer frees
+	// destroyed entities with Device.TimerAsync()).
+	generator->vfFreeID(second, 1000);
+	registry.on_engine_id_freed(second);
+	const u16 third = generator->tfGetID(u16(-1));
+	const EngineEntityKey key_third = registry.on_engine_id_assigned(third);
+	Msg("S03-T01 engine-id freed-at-1000 then=%u (same=%d)", u32(third), third == second ? 1 : 0);
+	f.expect(registry.resolve(key_second, entity), Refusal::StaleReference, "a key freed with a later time is stale too");
+	f.expect(registry.resolve(key_third, entity), Refusal::None, "the third key resolves");
+
+	// A thousand objects released and a thousand spawned: no new key equals an
+	// old one, every old key is stale, every new key resolves to a distinct id.
+	xr_vector<EngineEntityKey> round_one;
+	for (u32 i = 0; i < 1000; ++i)
+		round_one.push_back(registry.on_engine_id_assigned(generator->tfGetID(u16(-1))));
+	for (u32 i = 0; i < round_one.size(); ++i)
+	{
+		generator->vfFreeID(round_one[i].id, 0);
+		registry.on_engine_id_freed(round_one[i].id);
+	}
+	xr_vector<EngineEntityKey> round_two;
+	u32 reused_ids = 0, equal_keys = 0, stale_old = 0, live_new = 0;
+	xr_set<u64> entities;
+	for (u32 i = 0; i < 1000; ++i)
+	{
+		const u16 id = generator->tfGetID(u16(-1));
+		round_two.push_back(registry.on_engine_id_assigned(id));
+		for (u32 j = 0; j < round_one.size(); ++j)
+		{
+			if (round_one[j].id == id)
+				++reused_ids;
+			if (round_one[j] == round_two.back())
+				++equal_keys;
+		}
+	}
+	for (u32 i = 0; i < round_one.size(); ++i)
+		if (registry.resolve(round_one[i], entity) == Refusal::StaleReference)
+			++stale_old;
+	for (u32 i = 0; i < round_two.size(); ++i)
+		if (registry.resolve(round_two[i], entity) == Refusal::None)
+		{
+			++live_new;
+			entities.insert(entity.value);
+		}
+	Msg("S03-T01 engine-id released=1000 respawned=1000 reused_ids=%u equal_keys=%u stale_old=%u live_new=%u "
+		"distinct_entities=%u",
+		reused_ids, equal_keys, stale_old, live_new, u32(entities.size()));
+	f.check(reused_ids > 0, "the generator reused released ids");
+	f.check(equal_keys == 0, "no new key equals an old key");
+	f.check(stale_old == 1000, "every old key is stale");
+	f.check(live_new == 1000 && entities.size() == 1000, "every new key resolves to a distinct entity");
+
+	// The ALife switch pattern (alife_switch_manager.cpp:52-62, 91-95): the
+	// object frees its id and re-requests the same id at once. With the
+	// object's stored entity id the identity continues under a new
+	// generation; a different object taking a freed id gets a new identity.
+	u64 object_a = 0;
+	const u16 switched = generator->tfGetID(u16(-1));
+	const EngineEntityKey before_switch = registry.on_engine_id_assigned(switched, &object_a);
+	EntityId entity_before;
+	registry.resolve(before_switch, entity_before);
+	f.check(object_a == entity_before.value && object_a != 0, "the object stores the entity id it was given");
+	generator->vfFreeID(switched, 0);
+	registry.on_engine_id_freed(switched);
+	const u16 switched_again = generator->tfGetID(switched); // PerformIDgen(object_id)
+	const EngineEntityKey after_switch = registry.on_engine_id_assigned(switched_again, &object_a);
+	EntityId entity_after;
+	f.expect(registry.resolve(after_switch, entity_after), Refusal::None, "the re-requested id resolves");
+	f.check(switched_again == switched && entity_after == entity_before, "the same object keeps its entity id across the switch");
+	f.check(after_switch.generation == before_switch.generation + 1, "the switch still turns the generation");
+	EntityId stale_entity;
+	f.expect(registry.resolve(before_switch, stale_entity), Refusal::StaleReference, "a key from before the switch is stale");
+	generator->vfFreeID(switched, 0);
+	registry.on_engine_id_freed(switched);
+	u64 object_b = 0;
+	const u16 taken = generator->tfGetID(u16(-1));
+	const EngineEntityKey by_other = registry.on_engine_id_assigned(taken, &object_b);
+	EntityId entity_other;
+	registry.resolve(by_other, entity_other);
+	Msg("S03-T01 engine-id switch id=%u entity %I64u -> %I64u; other object id=%u entity %I64u", u32(switched),
+		entity_before.value, entity_after.value, u32(taken), entity_other.value);
+	f.check(taken == switched && object_b != object_a && entity_other != entity_before,
+		"a different object taking the freed id gets a different entity id");
+
+	// Invalid keys and a new server incarnation.
+	EngineEntityKey zero_generation = {third, 0};
+	f.expect(registry.resolve(zero_generation, entity), Refusal::InvalidIdentity, "generation 0 never resolves");
+	EngineEntityKey invalid_id = {kNoEngineId, 1};
+	f.expect(registry.resolve(invalid_id, entity), Refusal::InvalidIdentity, "the invalid engine id never resolves");
+	registry.on_server_incarnation();
+	f.expect(registry.resolve(key_third, entity), Refusal::StaleReference, "a new server incarnation stales every key");
+	const EngineEntityKey key_again = registry.on_engine_id_assigned(third);
+	f.check(key_again.generation == key_third.generation + 1, "generations continue across incarnations");
+
+	const CampaignIdentityRegistry::EngineIdStats& stats = registry.engine_id_stats();
+	Msg("S03-T01 engine-id stats assigned=%I64u freed=%I64u freed_unbound=%I64u reassigned_after_free=%I64u "
+		"continued=%I64u live=%I64u incarnations=%I64u max_generation=%u next_entity=%I64u",
+		stats.assigned, stats.freed, stats.freed_unbound, stats.reassigned_after_free, stats.continued, stats.live,
+		stats.incarnations, stats.max_generation, stats.next_entity);
+	f.check(stats.reassigned_after_free >= 1 + reused_ids, "every reuse of a freed id by another object was counted");
+	f.check(stats.continued == 1, "the one switch was counted as a continuation, not a reuse");
+	f.check(stats.incarnations == 2 && stats.live == 1, "two incarnations, one live binding at the end");
+	xr_delete(generator);
+	return f.done();
+}
