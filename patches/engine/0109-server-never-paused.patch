+// B47 (demo-16, 17, 19): after a travel the server sometimes ran no UpdateCL
+// for the players' actors (updcl_age grew with the session, every shot left
+// from 0,0,0) and the NPCs near them stood still. The engine updates only the
+// objects marked as crows this frame (CObjectList::Update); on the server an
+// object is marked by its own UpdateCL (within the activity anchors' crow
+// radius), its shedule_Update and its net_Spawn (xr_object.cpp). Once a
+// second: every alive actor or creature near a player with no UpdateCL for
+// 100 frames is logged with its crow state (crow flag, frames since it was
+// last marked: -1 none since its last update) and the device's pause. The
+// cause found (bugfix-38/39: paused=1, an installed script's pause) is refused
+// in CRenderDevice::Pause; this line stays to catch any other.
+void update_stall_tick()
+{
+	static u64 next_tick = 0;
+	static u32 last_count = 0;
+	static u64 last_logged = 0;
+	if (g_host->tick < next_tick || !g_pGameLevel || g_host->travel.exec)
+		return;
+	next_tick = g_host->tick + 50;
+	const u32 frame = Device.dwFrame;
+	u32 count = 0, actors = 0, flagged = 0, checked = 0;
+	string512 sample = "";
+	for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+	{
+		CObject* o = Level().Objects.o_get_by_iterator(i);
+		CEntityAlive* alive = o ? smart_cast<CEntityAlive*>(o) : nullptr;
+		if (!alive || !alive->g_Alive() || o->getDestroy() || !o->processing_enabled())
+			continue;
+		const bool actor = !!smart_cast<CActor*>(o);
+		if (!actor && !smart_cast<CCustomMonster*>(o))
+			continue;
+		if (!actor && g_activity_policy.distance_to(o->Position()) > g_activity_policy.crow_radius)
+			continue;
+		++checked;
+		const u32 age = frame - o->dwFrame_UpdateCL;
+		if (age < 100)
+			continue;
+		++count;
+		actors += actor ? 1 : 0;
+		flagged += o->AmICrow() ? 1 : 0;
+		if (count <= 4)
+		{
+			string128 one;
+			xr_sprintf(one, " %u:%s:age=%u:crow=%d:marked=%d", u32(o->ID()), *o->cNameSect(), age, o->AmICrow() ? 1 : 0,
+				o->dwFrame_AsCrow == u32(-1) ? -1 : int(frame - o->dwFrame_AsCrow));
+			xr_strcat(sample, one);
+		}
+	}
+	if (count != last_count || (count && g_host->tick - last_logged >= 500))
+	{
+		g_host->log.line("update-stall count=%u actors=%u crow_flagged=%u checked=%u paused=%d time_delta=%.4f frame=%u "
+			"anchors=%u radius=%.0f%s", count, actors, flagged, checked, Device.Paused() ? 1 : 0, Device.fTimeDelta, frame,
+			u32(g_activity_policy.anchors.size()), g_activity_policy.crow_radius, sample);
+		last_logged = g_host->tick;
+	}
+	last_count = count;
+}
