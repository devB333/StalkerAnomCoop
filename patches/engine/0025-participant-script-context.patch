+// --- the stack ------------------------------------------------------------------
+
+ScriptContextStack::ScriptContextStack(const CampaignIdentityRegistry* registry)
+	: m_registry(registry), m_next_token(0), m_next_handle(0)
+{
+	ZeroMemory(&m_stats, sizeof(m_stats));
+}
+
+Refusal ScriptContextStack::enter(const ActionContext& context, Scope scope, LPCSTR entry, u32& token)
+{
+	token = 0;
+	Refusal refusal = Refusal::None;
+	const Participant* participant = nullptr;
+	EngineEntityKey key = {kNoEngineId, 0};
+	if (!m_registry)
+		refusal = Refusal::WrongRole;
+	else if (scope == Scope::Identity || scope == Scope::World)
+		refusal = Refusal::NotAuthoritative; // not a participant script context
+	else if (m_stack.size() >= max_depth)
+		refusal = Refusal::NotAuthoritative;
+	else
+		refusal = m_registry->authorize(context, scope);
+	if (refusal == Refusal::None)
+		refusal = m_registry->participant(context.actor, participant);
+	if (refusal == Refusal::None)
+	{
+		const Refusal actor = m_registry->participant_actor_key(context.actor, key);
+		if (actor != Refusal::None)
+		{
+			key.id = kNoEngineId;
+			key.generation = 0;
+			if (scope == Scope::Self)
+				refusal = actor;
+		}
+	}
+	if (refusal != Refusal::None)
+	{
+		++m_stats.refused;
+		return refusal;
+	}
+	ScriptContext entered;
+	entered.action = context;
+	entered.scope = scope;
+	entered.party = participant->party;
+	entered.actor_key = key;
+	if (++m_next_token == 0)
+		++m_next_token;
+	entered.token = m_next_token;
+	entered.entry = entry ? entry : "?";
+	m_stack.push_back(entered);
+	++m_stats.entered;
+	if (m_stack.size() > m_stats.max_depth_seen)
+		m_stats.max_depth_seen = u32(m_stack.size());
+	token = entered.token;
+	return Refusal::None;
+}
+
+Refusal ScriptContextStack::leave(u32 token)
+{
+	if (m_stack.empty() || m_stack.back().token != token)
+	{
+		++m_stats.leave_mismatch;
+		return m_stack.empty() ? Refusal::NoContext : Refusal::ContextMismatch;
+	}
+	m_stack.pop_back();
+	++m_stats.left;
+	return Refusal::None;
+}
+
+Refusal ScriptContextStack::current(ScriptContext& out) const
+{
+	if (m_stack.empty())
+		return Refusal::NoContext;
+	out = m_stack.back();
+	return Refusal::None;
+}
+
+Refusal ScriptContextStack::capture(u32& handle)
+{
+	handle = 0;
+	if (m_stack.empty())
+		return Refusal::NoContext;
+	const ScriptContext& top = m_stack.back();
+	if (m_captured.size() >= max_captured)
+	{
+		m_captured.erase(m_captured.begin());
+		++m_stats.captured_evicted;
+	}
+	Captured captured;
+	if (++m_next_handle == 0)
+		++m_next_handle;
+	captured.handle = m_next_handle;
+	captured.participant = top.action.actor;
+	captured.party = top.party;
+	captured.scope = top.scope;
+	m_captured.push_back(captured);
+	++m_stats.captured;
+	handle = captured.handle;
+	return Refusal::None;
+}
+
+Refusal ScriptContextStack::enter_captured(u32 handle, LPCSTR entry, u32& token)
+{
+	token = 0;
+	for (const Captured& captured : m_captured)
+	{
+		if (captured.handle != handle)
+			continue;
+		ActionContext context;
+		context.origin = Origin::ServerInternal;
+		context.session = 0;
+		context.actor = captured.participant;
+		context.party = captured.party;
+		const Refusal refusal = enter(context, captured.scope, entry, token);
+		if (refusal == Refusal::None)
+			++m_stats.captured_entered;
+		else
+			++m_stats.captured_refused;
+		return refusal;
+	}
+	++m_stats.captured_refused;
+	return Refusal::NoContext;
+}
+
+ScriptContextStack* script_contexts()
+{
+	if (!server_role())
+		return nullptr;
+	if (s_stack_registry != g_campaign_identity)
+	{
+		xr_delete(s_stack);
+		s_stack = xr_new<ScriptContextStack>(g_campaign_identity);
+		s_stack_registry = g_campaign_identity;
+	}
+	return s_stack;
+}
+
+void release_script_contexts()
+{
+	xr_delete(s_stack);
+	s_stack_registry = nullptr;
+	for (u32 i = 0; i < kOutboxSlots; ++i)
+		s_outbox[i].clear();
+}
+
+// --- scopes ---------------------------------------------------------------------
+
+ScriptContextScope::ScriptContextScope(const ActionContext& context, Scope scope, LPCSTR entry)
+	: m_refusal(Refusal::WrongRole), m_token(0)
+{
+	if (ScriptContextStack* stack = script_contexts())
+	{
+		m_refusal = stack->enter(context, scope, entry, m_token);
+		if (m_refusal == Refusal::None)
+			sync_lua(true);
+		else
+			Msg("S03-T05 script context refused at %s: %s (origin %u session %u participant {%u,%u})",
+				entry ? entry : "?", refusal_name(m_refusal), u32(context.origin), context.session,
+				u32(context.actor.slot), context.actor.generation);
+	}
+}
+
+ScriptContextScope::ScriptContextScope(u32 captured_handle, LPCSTR entry) : m_refusal(Refusal::WrongRole), m_token(0)
+{
+	if (ScriptContextStack* stack = script_contexts())
+	{
+		m_refusal = stack->enter_captured(captured_handle, entry, m_token);
+		if (m_refusal == Refusal::None)
+			sync_lua(true);
+	}
+}
+
+ScriptContextScope::ScriptContextScope(const CGameTask* task, LPCSTR entry) : m_refusal(Refusal::WrongRole), m_token(0)
+{
+	ScriptContextStack* stack = script_contexts();
+	if (!stack || !task)
+		return;
+	if (!task->m_campaign_owned)
+	{
+		m_refusal = Refusal::NoContext;
+		++s_stats.task_unowned;
+		return;
+	}
+	ActionContext context;
+	if (!participant_context(task->m_campaign_owner, context))
+	{
+		m_refusal = Refusal::StaleReference;
+		Msg("S03-T05 task [%s] owner {%u,%u} is no longer current; its %s runs in no context", task->m_ID.c_str(),
+			u32(task->m_campaign_owner.slot), task->m_campaign_owner.generation, entry ? entry : "?");
+		return;
+	}
+	m_refusal = stack->enter(context, Scope::Self, entry, m_token);
+	if (m_refusal == Refusal::None)
+	{
+		++s_stats.task_scopes;
+		sync_lua(true);
+	}
+}
+
+ScriptContextScope::ScriptContextScope(const CObject* actor, LPCSTR entry) : m_refusal(Refusal::WrongRole), m_token(0)
+{
+	ScriptContextStack* stack = script_contexts();
+	if (!stack)
+		return;
+	ActionContext context;
+	if (!actor || !actor_context(actor, context))
+	{
+		m_refusal = Refusal::UnknownParticipant;
+		return;
+	}
+	m_refusal = stack->enter(context, Scope::Self, entry, m_token);
+	if (m_refusal == Refusal::None)
+		sync_lua(true);
+}
+
+ScriptContextScope::~ScriptContextScope()
+{
+	if (m_refusal != Refusal::None || !s_stack)
+		return;
+	const Refusal left = s_stack->leave(m_token);
+	if (left != Refusal::None)
+		Msg("! S03-T05 script context leave out of order: %s (token %u)", refusal_name(left), m_token);
+	sync_lua(false);
+}
+
+bool participant_context(const ParticipantRef& ref, ActionContext& out)
+{
+	if (!server_role())
+		return false;
+	const Participant* participant = nullptr;
+	if (g_campaign_identity->participant(ref, participant) != Refusal::None)
+		return false;
+	out.origin = Origin::ServerInternal;
+	out.session = 0;
+	out.actor = ref;
+	out.party = participant->party;
+	return true;
+}
+
+bool actor_context(const CObject* actor, ActionContext& out)
+{
+	ParticipantRef ref;
+	if (!server_role() || participant_of(actor, ref) != Refusal::None)
+		return false;
+	return participant_context(ref, out);
+}
+
+Refusal current_script_context(ScriptContext& out)
+{
+	if (!s_stack || !server_role())
+		return Refusal::NoContext;
+	return s_stack->current(out);
+}
+
+CActor* script_context_actor(Refusal* why)
+{
+	ScriptContext context;
+	Refusal refusal = current_script_context(context);
+	CActor* actor = nullptr;
+	if (refusal == Refusal::None)
+		actor = participant_actor(context.action.actor, &refusal);
+	if (why)
+		*why = refusal;
+	return actor;
+}
+
+CActor* gameplay_script_actor(LPCSTR purpose)
+{
+	ScriptContext context;
+	if (current_script_context(context) == Refusal::None)
+	{
+		++s_stats.gameplay_context;
+		return participant_actor(context.action.actor);
+	}
+	++s_stats.gameplay_compat;
+	return sole_participant_actor(purpose);
+}
