+// S10-T04c (K1 follow-up): see Actor.h. eFire and eFire2 are a knife's two
+// swings and a gun's firing (CMissile::eThrowStart and eReady share the values:
+// the animation switch below is per item class, and the server sampled the
+// same item this replica holds).
+static bool replica_attack_state(u32 state)
+{
+	return state == CWeapon::eFire || state == CWeapon::eFire2;
+}
+
+void CActor::replica_set_weapon_state(u32 server_state)
+{
+	if (r_wpn_anim.server == server_state)
+		return;
+	r_wpn_anim.server = server_state;
+	r_wpn_anim.changed_at_ms = Device.dwTimeGlobal;
+	if (replica_attack_state(server_state))
+		replica_present_attack(server_state);
+}
+
+void CActor::replica_present_attack(u32 attack_state)
+{
+	r_wpn_anim.held = attack_state;
+	r_wpn_anim.held_until_ms = _max(r_wpn_anim.held_until_ms, Device.dwTimeGlobal + u32(ReplicaWeaponAnim::kHoldMs));
+}
+
+u32 CActor::replica_anim_weapon_state(u32 item_state)
+{
+	if (r_wpn_anim.server == u32(-1))
+		return item_state; // not a presented actor: the item's own state
+	if (r_wpn_anim.held != u32(-1))
+	{
+		if (Device.dwTimeGlobal < r_wpn_anim.held_until_ms)
+			return r_wpn_anim.held;
+		r_wpn_anim.held = u32(-1);
+	}
+	return r_wpn_anim.server;
+}
