+struct Check
+{
+	LPCSTR name;
+	u32 checks;
+	u32 failures;
+
+	explicit Check(LPCSTR fixture_name) : name(fixture_name), checks(0), failures(0)
+	{
+	}
+
+	bool check(bool condition, LPCSTR what)
+	{
+		++checks;
+		if (!condition)
+		{
+			++failures;
+			Msg("! S03-T02 %s failed: %s", name, what);
+		}
+		return condition;
+	}
+
+	bool expect(Refusal observed, Refusal expected, LPCSTR what)
+	{
+		++checks;
+		if (observed != expected)
+		{
+			++failures;
+			Msg("! S03-T02 %s failed: %s: expected %s, observed %s", name, what, refusal_name(expected),
+				refusal_name(observed));
+		}
+		return observed == expected;
+	}
+
+	bool done()
+	{
+		Msg("S03-T02 %s checks=%u failures=%u", name, checks, failures);
+		return failures == 0;
+	}
+};
