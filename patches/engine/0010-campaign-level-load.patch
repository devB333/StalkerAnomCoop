+
+// S02-T05d: runs the client stages (net_start_client1..6, net_start5..6) until
+// no loading event remains. net_start_client6 re-queues itself until the
+// server's configuration arrives. Returns 0 when the level is ready, 1 on
+// deadline, 2 when it is not.
+extern "C" int __cdecl xrCampaignLevel_PumpClientStages(u32 deadline_ms)
+{
+	CTimer timer;
+	timer.Start();
+	while (!g_loading_events.empty())
+	{
+		if (timer.GetElapsed_ms() > deadline_ms)
+			return 1;
+		if (g_loading_events.front()())
+			g_loading_events.pop_front();
+	}
+	Msg("S02-T05d client stages finished in %u ms", timer.GetElapsed_ms());
+	CLevel& level = Level();
+	return (level.bReady && level.game && level.game_configured && physics_world()) ? 0 : 2;
+}
+
+// Logs what the client stages produced and checks the level context is real
+// and renderer-free: CFORM geometry, physics world, single-player client game
+// state, level script process; no HUD, no render level, no precache, and no
+// object yet (spawns wait in the event queue for the first tick).
+extern "C" bool __cdecl xrCampaignLevel_ReportLoaded()
+{
+	CLevel& level = Level();
+	CDB::MODEL* cform = level.ObjectSpace.GetStaticModel();
+	const u32 tris = cform ? u32(cform->get_tris_count()) : 0;
+	const u32 verts = cform ? u32(cform->get_verts_count()) : 0;
+	const Fbox& box = level.ObjectSpace.GetBoundingVolume();
+	const bool physics = physics_world() != nullptr;
+	const bool client_game = level.game && level.game->Type() == eGameIDSingle;
+	const bool level_script = ai().script_engine().script_process(ScriptEngine::eScriptProcessorLevel) != nullptr;
+	string_path som;
+	const bool som_file = FS.exist(som, "$level$", "level.som") != nullptr;
+	Msg("S02-T05d level ready=%d cform_tris=%u cform_verts=%u bbox=[%.1f,%.1f,%.1f]-[%.1f,%.1f,%.1f] "
+		"physics_world=%d client_game=%d game_configured=%d level_script=%d som_file=%d hud=%d render_device=%d "
+		"precache_frames=%u objects=%u",
+		level.bReady ? 1 : 0, tris, verts, VPUSH(box.min), VPUSH(box.max), physics ? 1 : 0, client_game ? 1 : 0,
+		level.game_configured ? 1 : 0, level_script ? 1 : 0, som_file ? 1 : 0, g_hud ? 1 : 0,
+		Device.m_pRender ? 1 : 0, Device.dwPrecacheFrame, level.Objects.o_count());
+	return level.bReady && tris != 0 && verts != 0 && physics && client_game && level.game_configured &&
+		level_script && !g_hud && !Device.m_pRender && Device.dwPrecacheFrame == 0 && level.Objects.o_count() == 0;
+}
+
+// Logs what the first server ticks produced: the client-side objects spawned
+// from the server entities, the saved actor among them, physics steps, and
+// that the process adopted no control or view entity.
+extern "C" bool __cdecl xrCampaignLevel_ReportTicks(u32 ticks)
+{
+	CLevel& level = Level();
+	u32 objects = level.Objects.o_count(), actors = 0, stalkers = 0, monsters = 0, zones = 0, items = 0;
+	for (u32 i = 0; i < objects; ++i)
+	{
+		CObject* object = level.Objects.o_get_by_iterator(i);
+		if (smart_cast<CActor*>(object))
+			++actors;
+		else if (smart_cast<CAI_Stalker*>(object))
+			++stalkers;
+		else if (smart_cast<CBaseMonster*>(object))
+			++monsters;
+		else if (smart_cast<CCustomZone*>(object))
+			++zones;
+		else if (smart_cast<CInventoryItem*>(object))
+			++items;
+	}
+	const CActor* actor = g_actor;
+	const CSE_ALifeCreatureActor* se_actor = ai().get_alife() ? ai().alife().graph().actor() : nullptr;
+	const u64 steps = physics_world() ? physics_world()->StepsNum() : 0;
+	const u32 entities = level.Server ? level.Server->GetEntitiesNum() : 0;
+	const bool no_view = !level.CurrentEntity() && !level.CurrentViewEntity() && !level.CurrentControlEntity();
+	Msg("S02-T05d ticks=%u frame=%u objects=%u actors=%u stalkers=%u monsters=%u zones=%u items=%u "
+		"server_entities=%u physics_steps=%I64u no_view_entity=%d",
+		ticks, Device.dwFrame, objects, actors, stalkers, monsters, zones, items, entities, steps, no_view ? 1 : 0);
+	if (actor)
+		Msg("S02-T05d actor object id=%u alive=%d pos=[%.2f,%.2f,%.2f] se_pos=[%.2f,%.2f,%.2f] enabled=%d local=%d",
+			actor->ID(), actor->g_Alive() ? 1 : 0, VPUSH(actor->Position()),
+			se_actor ? se_actor->o_Position.x : 0.f, se_actor ? se_actor->o_Position.y : 0.f,
+			se_actor ? se_actor->o_Position.z : 0.f, actor->getEnabled() ? 1 : 0, actor->Local() ? 1 : 0);
+	else
+		Msg("! S02-T05d no actor object");
+	return objects != 0 && actors == 1 && actor && actor->g_Alive() && steps != 0 && no_view;
+}
