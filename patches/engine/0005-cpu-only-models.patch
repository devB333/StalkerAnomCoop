+// Campaign server: a model pool with no device, render target or level.
+bool CRender::cpu_models_create(void (*registrar)(IRenderVisual*))
+{
+	R_ASSERT2(!HW.pDevice && !Models, "CPU-only models need a renderer with no device or model pool");
+	R_ASSERT2(registrar, "CPU-only models need a bone-material registrar");
+	CpuOnlyResources::Enabled() = true;
+	CpuOnlyResources::SkippedShaders() = 0;
+	CpuOnlyResources::SkippedGeometry() = 0;
+	CpuOnlyResources::SkippedBuffers() = 0;
+	Models = xr_new<CModelPool>();
+	Models->m_registrar = registrar;
+	return true;
+}
+
+void CRender::cpu_models_destroy()
+{
+	xr_delete(Models);
+	CpuOnlyResources::Enabled() = false;
+}
+
+bool CRender::cpu_models_stats(CpuModelStats& stats)
+{
+	stats.device_absent = !HW.pDevice;
+	stats.skipped_shaders = CpuOnlyResources::SkippedShaders();
+	stats.skipped_geometry = CpuOnlyResources::SkippedGeometry();
+	stats.skipped_buffers = CpuOnlyResources::SkippedBuffers();
+	return CpuOnlyResources::Enabled();
+}
