+	++s_stats.present_broadcast;
+	ParticipantRef nobody;
+	nobody.slot = kBroadcastSlot;
+	nobody.generation = 0;
+	record_presentation(kBroadcastSlot, nobody, kind, object, detail, args);
+	return Refusal::None;
+}
