+// The finish phrase's action (dialogs.npc_set_finished_task_complete) of a
+// talk: the S08 party turn-in in the holder's context (take_quest op 2
+// without the intent); the completion is applied by quest_tick.
+static u16 talk_quest_turn_in(PlayerLink& link, CGameObject* npc)
+{
+	// the ordered dialog's finish (dm_init_dynamic_task_completed_dialog) names
+	// its task through axr_task_manager.get_first_finished_task(npc), computed
+	// on the fly in the holder's context (db.actor:get_task), not a table
+	CActor* holder = party_anchor();
+	if (!holder || !holder->g_Alive())
+	{
+		g_host->log.line("quest-turnin-anchor-dead slot=%u source=talk", u32(link.ref.slot));
+		return coop::proto::kReasonQuestNotActive;
+	}
+	string128 task = "";
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(holder), "party-quest-finished-talk");
+		luabind::functor<luabind::object> first;
+		if (scope.entered() && ai().script_engine().functor("axr_task_manager.get_first_finished_task", first))
+		{
+			luabind::object r = first(npc->lua_game_object());
+			if (r.type() == LUA_TSTRING)
+				xr_strcpy(task, sizeof(task), luabind::object_cast<LPCSTR>(r));
+		}
+	}
+	if (!task[0])
+	{
+		g_host->log.line("talk-quest-blocked slot=%u op=finish why=no-finished-task", u32(link.ref.slot));
+		return coop::proto::kReasonQuestNotActive;
+	}
+	return party_turn_in_task(link, npc, task, "talk");
+}
