@@ -1435,6 +1436,28 @@ LPCSTR const compat_source =
 	"      S.host_reads[site] = (S.host_reads[site] or 0) + 1\n"
 	"      S.host_read_total = S.host_read_total + 1\n"
 	"    end\n"
