+// S03-T06: the campaign server never loads the render level (S02-T05d). The
+// lighting AI vision reads needs only CPU objects: the level's sun and static
+// lights (the same CLight_DB::Load/LoadHemi the client runs, from the level
+// stream IGame_Level::Load has open), registered in the spatial database of
+// this level, released before it goes.
+u32 CRender::cpu_lighting_load(IReader* level_fs)
+{
+	if (m_cpu_lighting || !level_fs)
+		return 0;
+	Lights.Load(level_fs);
+	Lights.LoadHemi();
+	m_cpu_lighting = true;
+	Msg("S03-T06 cpu lighting loaded: sun=%d hemi_lights=%u", Lights.sun_adapted ? 1 : 0, Lights.hemi_count());
+	return Lights.hemi_count();
+}
+
+void CRender::cpu_lighting_unload()
+{
+	if (!m_cpu_lighting)
+		return;
+	Lights.Unload();
+	m_cpu_lighting = false;
+}
+
+// The client's per-frame sun update (r2_R_calculate.cpp, CLight_DB::Update):
+// the adapted sun's direction and colour from the current environment.
+bool CRender::cpu_lighting_sun()
+{
+	if (!m_cpu_lighting)
+		return false;
+	Lights.Update();
+	return true;
+}
+
+// The client's light tracking of one object (r4_R_render.cpp: the view entity
+// and one renderable in the view every frame): sun ray, sky rays, static lights.
+bool CRender::cpu_lighting_track(IRenderable* object)
+{
+	if (!m_cpu_lighting || !object)
+		return false;
+	CROS_impl* ros = (CROS_impl*)object->renderable_ROS();
+	if (!ros)
+		return false;
+	ros->update(object);
+	return true;
+}
+
