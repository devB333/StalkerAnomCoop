+bool lua_leave(double token)
+{
+	if (!s_stack || !server_role())
+		return false;
+	const Refusal refusal = s_stack->leave(u32(token));
+	if (refusal != Refusal::None)
+		Msg("! S03-T05 Lua context leave refused: %s (token %u)", refusal_name(refusal), u32(token));
+	sync_lua(false);
+	return refusal == Refusal::None;
+}
