+// ------------------------------------------------------------ S09-T01
+// Party travel: the request and two-player consent (docs/travel-contract.md).
+// The consent state machine is coop::proto::TransitionCoordinator; this is
+// the engine side: a request (ActionIntent kind 11) names the level changer
+// the player's actor stands in, the server checks the changer, the actor's
+// place, the partner's presence and the party's combat state, proposes
+// (CampaignEvent 13 to both players, 30 s), and the partner's answer (kind
+// 12) agrees, refuses, or the requester cancels. A disconnect, a death, a
+// fight or the changer's loss aborts the proposal. Nothing of this loads a
+// level: an agreed transition ends here as "agreed" for the executor that
+// S09-T02 adds; no load begins from one player's intent.
+
+const u16 kTravelPartnerUnavailable = coop::proto::kReasonPartnerUnavailable;
+
+void travel_csv(LPCSTR phase, u8 slot, u64 operation, u64 transition, u16 reason, LPCSTR state, LPCSTR detail)
+{
+	if (g_host->travel.csv)
+	{
+		fprintf(g_host->travel.csv, "%I64u,%I64u,%u,%I64x,%I64x,%u,%s,%s,%s\n", coop::store::utc_now_ms(), g_host->tick,
+			u32(slot), operation, transition, u32(reason), phase, state, detail);
+		fflush(g_host->travel.csv);
+	}
+}
+
+CLevelChanger* travel_changer(u16 id)
+{
+	CObject* o = id != kNoEngineId ? Level().Objects.net_Find(id) : nullptr;
+	CLevelChanger* changer = o ? smart_cast<CLevelChanger*>(o) : nullptr;
+	return changer && changer->IsLevelChangerEnabled() ? changer : nullptr;
+}
+
+// The destination as the changer's server entity names it (the game vertex's
+// level in the game graph; the spawn's own level name as a fallback).
+void travel_destination(u16 changer_id, xr_string& level, Fvector& position)
+{
+	level = "?";
+	position.set(0.f, 0.f, 0.f);
+	const CSE_ALifeDynamicObject* se = ai().get_alife() ? ai().alife().objects().object(changer_id, true) : nullptr;
+	const CSE_ALifeLevelChanger* lc = se ? smart_cast<const CSE_ALifeLevelChanger*>(se) : nullptr;
+	if (!lc)
+		return;
+	position = lc->m_tNextPosition;
+	if (ai().get_game_graph() && ai().game_graph().valid_vertex_id(lc->m_tNextGraphID))
+		level = *ai().game_graph().header().level(ai().game_graph().vertex(lc->m_tNextGraphID)->level_id()).name();
+	else if (lc->m_caLevelToChange.size())
+		level = *lc->m_caLevelToChange;
+}
+
+// Inside the changer's shape (the engine's own touch test), or within 1 m of
+// its bounding sphere: the server's actor trails the client's by the input
+// delay, and the client touched it.
+bool actor_at_changer(CActor* actor, CLevelChanger* changer, float& distance)
+{
+	Fvector center;
+	changer->Center(center);
+	distance = center.distance_to(actor->Position());
+	if (((CCF_Shape*)changer->CFORM())->Contact(actor))
+		return true;
+	return distance <= changer->Radius() + 1.f;
+}
+
+// The party is in combat when an alive NPC or monster online has one of the
+// participants' actors as its chosen enemy: a stalker's CMemoryManager::enemy()
+// selection, a monster's CBaseMonster::EnemyMan (as CampaignCombatCapture reads them).
+bool party_in_combat(string256& who)
+{
+	who[0] = 0;
+	u16 actors[2] = {kNoEngineId, kNoEngineId};
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot < 2)
+			if (CActor* a = participant_actor(l.ref))
+				actors[l.ref.slot] = u16(a->ID());
+	for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+	{
+		CCustomMonster* m = smart_cast<CCustomMonster*>(Level().Objects.o_get_by_iterator(i));
+		if (!m || !m->g_Alive() || smart_cast<CActor*>(m))
+			continue;
+		CBaseMonster* monster = smart_cast<CBaseMonster*>(m);
+		const CEntityAlive* enemy = monster ? monster->EnemyMan.get_enemy() : m->memory().enemy().selected();
+		if (!enemy)
+			continue;
+		const u16 e = u16(enemy->ID());
+		if (e == actors[0] || e == actors[1])
+		{
+			xr_sprintf(who, "%u:%s->%u", u32(m->ID()), *m->cNameSect(), u32(e));
+			return true;
+		}
+	}
+	return false;
+}
+
+PlayerLink* travel_partner(u8 slot)
+{
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot < 2 && l.ref.slot != slot)
+			return &l;
+	return nullptr;
+}
+
+void travel_event_to(PlayerLink& link, const coop::proto::Transition& t, u32 remaining_ms)
+{
+	std::vector<u8> payload;
+	for (int b = 0; b < 8; ++b)
+		payload.push_back(u8(t.id >> (8 * b)));
+	put_u8(payload, u8(t.state));
+	put_u8(payload, t.requester);
+	put_u8(payload, t.partner);
+	put_u8(payload, u8(t.abort));
+	for (int b = 0; b < 8; ++b)
+		payload.push_back(u8(t.destination >> (8 * b)));
+	put_str(payload, g_host->travel.level.c_str());
+	put_f32(payload, g_host->travel.position.x);
+	put_f32(payload, g_host->travel.position.y);
+	put_f32(payload, g_host->travel.position.z);
+	put_u32(payload, remaining_ms);
+	queue_event(link, 13, payload);
+	link.travel_sent_id = t.state == coop::proto::TravelState::Proposed ? t.id : 0;
+}
+
+void travel_event(const coop::proto::Transition& t, u32 remaining_ms)
+{
+	for (PlayerLink& link : g_host->links)
+		if (client_in_world(link))
+			travel_event_to(link, t, remaining_ms);
+}
+
+// The live proposal ended: both players are told, the engine facts cleared.
+void end_travel(const coop::proto::Transition& t)
+{
+	const u64 now = g_host->wall.GetElapsed_ms();
+	g_host->log.line("travel-end id=%I64x state=%s abort=%s requester=%u partner=%u changer=%u level=%s after_ms=%I64u",
+		t.id, coop::proto::to_string(t.state), coop::proto::to_string(t.abort), u32(t.requester), u32(t.partner),
+		u32(g_host->travel.changer), g_host->travel.level.c_str(), now - t.proposed_ms);
+	travel_csv("end", t.requester, 0, t.id, 0, coop::proto::to_string(t.state), coop::proto::to_string(t.abort));
+	travel_event(t, 0);
+	if (t.state == coop::proto::TravelState::Agreed)
+		// S09-T02 takes it from here (the barrier, the native change_level for
+		// both identities, the destination load); nothing loads yet
+		g_host->log.line("travel-agreed id=%I64x executor=none level=%s pos=%.2f,%.2f,%.2f (S09-T02)", t.id,
+			g_host->travel.level.c_str(), VPUSH(g_host->travel.position));
+	g_host->travel.changer = kNoEngineId;
+	g_host->travel.level.clear();
+}
+
+bool travel_abort(coop::proto::TravelAbort why)
+{
+	coop::proto::Transition out;
+	if (!g_host->travel.coordinator || !g_host->travel.coordinator->abort(why, g_host->wall.GetElapsed_ms(), out))
+		return false;
+	end_travel(out);
+	return true;
+}
+
+// The stored outcome of a known operation (the operation index; in memory
+// for this incarnation: a restart has no live transition, so a replayed
+// request or answer meets NoTransition or starts afresh).
+bool travel_known(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result,
+	u16& reason)
+{
+	StoredOutcome stored;
+	if (!g_host->persistence || !g_host->persistence->lookup(link.player, intent.operation_id, stored))
+		return false;
+	result.outcome = coop::proto::ActionOutcome(stored.outcome);
+	result.reason = stored.reason;
+	result.commit_id = 0;
+	result.revision = stored.revision;
+	reason = stored.reason;
+	++g_host->travel.duplicates;
+	g_host->log.line("travel-duplicate slot=%u kind=%u operation=%I64x outcome=%u reason=%u transition=%I64x",
+		u32(link.ref.slot), u32(intent.kind), intent.operation_id, u32(stored.outcome), u32(stored.reason),
+		stored.revision);
+	return true;
+}
+
+void travel_remember(PlayerLink& link, u64 operation, u16 reason, u64 transition)
+{
+	// refusals are not stored (a later request may succeed); an accepted
+	// request or answer is, so its repeat gets the same answer
+	if (reason || !g_host->persistence)
+		return;
+	StoredOutcome stored;
+	stored.outcome = u8(coop::proto::ActionOutcome::Accepted);
+	stored.reason = 0;
+	stored.revision = transition;
+	g_host->persistence->remember(link.player, operation, stored);
+}
+
+u16 take_travel_request(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	u16 reason = 0;
+	if (travel_known(link, intent, result, reason))
+		return reason;
+	++g_host->travel.requests;
+	if (!link.session || !g_host->travel.coordinator)
+		return coop::proto::kReasonNoActor;
+	if (!intent.params.empty())
+		return coop::proto::kReasonMalformed;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	if (!actor || !actor->g_Alive())
+		return coop::proto::kReasonNoActor;
+	const u16 changer_id = engine_id_of(intent.target);
+	CLevelChanger* changer = travel_changer(changer_id);
+	if (!changer)
+	{
+		g_host->log.line("travel-no-changer slot=%u target=%I64u/%u id=%u", u32(link.ref.slot), intent.target.id,
+			intent.target.generation, u32(changer_id));
+		return coop::proto::kReasonNoChanger;
+	}
+	float distance = 0.f;
+	if (!actor_at_changer(actor, changer, distance))
+	{
+		g_host->log.line("travel-not-at-changer slot=%u changer=%u distance=%.2f radius=%.2f", u32(link.ref.slot),
+			u32(changer_id), distance, changer->Radius());
+		return coop::proto::kReasonNotAtChanger;
+	}
+	// the partner: in the world with a living actor. No partner, no travel
+	// (D5: both confirm; a one-player consent would need the user's approval)
+	PlayerLink* partner = travel_partner(link.ref.slot);
+	CActor* partner_actor = partner ? participant_actor(partner->ref) : nullptr;
+	if (!partner || !client_in_world(*partner) || !partner_actor || !partner_actor->g_Alive())
+	{
+		g_host->log.line("travel-partner-unavailable slot=%u partner=%d in_world=%d actor=%d alive=%d",
+			u32(link.ref.slot), partner ? int(partner->ref.slot) : -1, partner && client_in_world(*partner) ? 1 : 0,
+			partner_actor ? 1 : 0, partner_actor && partner_actor->g_Alive() ? 1 : 0);
+		return kTravelPartnerUnavailable;
+	}
+	string256 who;
+	if (party_in_combat(who))
+	{
+		g_host->log.line("travel-in-combat slot=%u enemy=%s", u32(link.ref.slot), who);
+		return coop::proto::kReasonInCombat;
+	}
+	coop::proto::Transition t;
+	const coop::proto::TravelVerdict verdict = g_host->travel.coordinator->propose(link.ref.slot, partner->ref.slot,
+		intent.target.id, g_host->wall.GetElapsed_ms(), t);
+	if (verdict == coop::proto::TravelVerdict::Busy)
+	{
+		g_host->log.line("travel-busy slot=%u live=%I64x", u32(link.ref.slot), t.id);
+		return coop::proto::kReasonTravelBusy;
+	}
+	if (verdict != coop::proto::TravelVerdict::Ok)
+		return coop::proto::kReasonWrongParty;
+	g_host->travel.changer = changer_id;
+	travel_destination(changer_id, g_host->travel.level, g_host->travel.position);
+	++g_host->travel.proposals;
+	g_host->log.line("travel-proposed id=%I64x requester=%u partner=%u changer=%u name=%s level=%s pos=%.2f,%.2f,%.2f "
+		"distance=%.2f deadline_ms=%I64u operation=%I64x",
+		t.id, u32(t.requester), u32(t.partner), u32(changer_id), changer->cName().c_str(), g_host->travel.level.c_str(),
+		VPUSH(g_host->travel.position), distance, t.deadline_ms - t.proposed_ms, intent.operation_id);
+	travel_csv("proposed", link.ref.slot, intent.operation_id, t.id, 0, "proposed", g_host->travel.level.c_str());
+	travel_event(t, u32(t.deadline_ms - t.proposed_ms));
+	travel_remember(link, intent.operation_id, 0, t.id);
+	result.commit_id = 0;
+	result.revision = t.id;
+	// S09-T01 harness: a crash right after the proposal went out (the clients
+	// hold a proposal the restarted server never continues)
+	coop::store::failpoint("travel:after-propose");
+	return 0;
+}
+
+u16 take_travel_answer(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	u16 reason = 0;
+	if (travel_known(link, intent, result, reason))
+		return reason;
+	++g_host->travel.answers;
+	if (!link.session || !g_host->travel.coordinator)
+		return coop::proto::kReasonNoActor;
+	if (intent.params.size() != 9)
+		return coop::proto::kReasonMalformed;
+	u64 id = 0;
+	for (int b = 0; b < 8; ++b)
+		id |= u64(intent.params[b]) << (8 * b);
+	const u8 answer = intent.params[8];
+	if (answer < 1 || answer > 3)
+		return coop::proto::kReasonMalformed;
+	coop::proto::TransitionCoordinator& c = *g_host->travel.coordinator;
+	const coop::proto::Transition* live = c.live();
+	if (!live || live->id != id)
+	{
+		// stale, replayed, unknown, or from before a restart: nothing it could
+		// approve; counted by the coordinator too
+		coop::proto::Transition out;
+		const coop::proto::TravelVerdict v = c.answer(link.ref.slot, id, coop::proto::TravelAnswer(answer),
+			g_host->wall.GetElapsed_ms(), out);
+		VERIFY(v == coop::proto::TravelVerdict::NoTransition);
+		(void)v;
+		g_host->log.line("travel-no-transition slot=%u id=%I64x answer=%u live=%I64x operation=%I64x", u32(link.ref.slot),
+			id, u32(answer), live ? live->id : 0ull, intent.operation_id);
+		travel_csv("answer", link.ref.slot, intent.operation_id, id, coop::proto::kReasonNoTransition, "no-transition",
+			"");
+		return coop::proto::kReasonNoTransition;
+	}
+	if (answer == 1)
+	{
+		// an accept is a consent given now: the partner's actor must be alive
+		// and the party out of combat at this moment
+		PartyId party;
+		party.hi = g_host->config.party_id.hi;
+		party.lo = g_host->config.party_id.lo;
+		ActionContext context;
+		context.origin = Origin::ClientIntent;
+		context.session = link.session;
+		context.actor = link.ref;
+		context.party = party;
+		Refusal why = Refusal::None;
+		CActor* actor = context_actor(context, Scope::Self, &why);
+		if (live->partner == link.ref.slot && (!actor || !actor->g_Alive()))
+			return coop::proto::kReasonNoActor;
+		string256 who;
+		if (live->partner == link.ref.slot && party_in_combat(who))
+		{
+			g_host->log.line("travel-in-combat slot=%u enemy=%s (accept refused; the proposal stands)",
+				u32(link.ref.slot), who);
+			return coop::proto::kReasonInCombat;
+		}
+	}
+	coop::proto::Transition out;
+	const coop::proto::TravelVerdict v =
+		c.answer(link.ref.slot, id, coop::proto::TravelAnswer(answer), g_host->wall.GetElapsed_ms(), out);
+	if (v == coop::proto::TravelVerdict::WrongParty)
+	{
+		g_host->log.line("travel-wrong-party slot=%u id=%I64x answer=%u requester=%u partner=%u", u32(link.ref.slot), id,
+			u32(answer), u32(live->requester), u32(live->partner));
+		travel_csv("answer", link.ref.slot, intent.operation_id, id, coop::proto::kReasonWrongParty, "wrong-party", "");
+		return coop::proto::kReasonWrongParty;
+	}
+	if (v != coop::proto::TravelVerdict::Ok)
+		return coop::proto::kReasonNoTransition;
+	g_host->log.line("travel-answer slot=%u id=%I64x answer=%s -> %s operation=%I64x", u32(link.ref.slot), id,
+		answer == 1 ? "accept" : answer == 2 ? "refuse" : "cancel", coop::proto::to_string(out.state),
+		intent.operation_id);
+	travel_csv("answer", link.ref.slot, intent.operation_id, id, 0,
+		answer == 1 ? "accept" : answer == 2 ? "refuse" : "cancel", coop::proto::to_string(out.state));
+	travel_remember(link, intent.operation_id, 0, id);
+	end_travel(out);
+	result.commit_id = 0;
+	result.revision = id;
+	return 0;
+}
+
+// Each tick: the deadline; every half second the world's conditions; a
+// client entering the world while a proposal is live gets it.
+void travel_tick()
+{
+	if (!g_host->travel.coordinator)
+		return;
+	coop::proto::TransitionCoordinator& c = *g_host->travel.coordinator;
+	const u64 now = g_host->wall.GetElapsed_ms();
+	coop::proto::Transition out;
+	if (c.expire(now, out))
+	{
+		end_travel(out);
+		return;
+	}
+	const coop::proto::Transition* live = c.live();
+	if (!live)
+		return;
+	if (g_host->tick - g_host->travel.last_check_tick >= 25)
+	{
+		g_host->travel.last_check_tick = g_host->tick;
+		if (!travel_changer(g_host->travel.changer))
+		{
+			travel_abort(coop::proto::TravelAbort::ChangerGone);
+			return;
+		}
+		for (PlayerLink& l : g_host->links)
+		{
+			if (!l.bound || (l.ref.slot != live->requester && l.ref.slot != live->partner))
+				continue;
+			const bool requester = l.ref.slot == live->requester;
+			CActor* a = participant_actor(l.ref);
+			if (!client_in_world(l))
+			{
+				travel_abort(requester ? coop::proto::TravelAbort::RequesterLeft : coop::proto::TravelAbort::PartnerLeft);
+				return;
+			}
+			if (!a || !a->g_Alive())
+			{
+				travel_abort(requester ? coop::proto::TravelAbort::RequesterDead : coop::proto::TravelAbort::PartnerDead);
+				return;
+			}
+		}
+		string256 who;
+		if (party_in_combat(who))
+		{
+			g_host->log.line("travel-combat-abort id=%I64x enemy=%s", live->id, who);
+			travel_abort(coop::proto::TravelAbort::Combat);
+			return;
+		}
+	}
+	for (PlayerLink& l : g_host->links)
+		if (client_in_world(l) && l.travel_sent_id != live->id)
+			travel_event_to(l, *live, u32(live->deadline_ms > now ? live->deadline_ms - now : 0));
+}
+
+// A player's connection ended: a proposal it is party to is aborted (its
+// consent, given or awaited, does not outlive its session: a rejoin starts
+// over; the other player's intent alone agrees nothing).
+void travel_on_left(const PlayerLink& link)
+{
+	if (!g_host->travel.coordinator)
+		return;
+	const coop::proto::Transition* live = g_host->travel.coordinator->live();
+	if (!live || !link.bound)
+		return;
+	if (link.ref.slot == live->requester)
+		travel_abort(coop::proto::TravelAbort::RequesterLeft);
+	else if (link.ref.slot == live->partner)
+		travel_abort(coop::proto::TravelAbort::PartnerLeft);
+}
+
+// The travel fixture (profile travel_party, travel_variant): once both
+// players are in the world, both actors are placed inside Cordon's first
+// enabled level changer and rounds run through the transfer driver's steps
+// (CampaignEvent 7, client script 8; action 11 = request: item = the changer;
+// action 12 = answer: extra = 1 accept, 2 refuse, 3 cancel, 0 none; flags
+// bit 3 = the previous transition's id (stale), bit 5 = an unknown id; bit 2
+// = drop the connection after the step):
+//   0  p1 requests, p2 accepts                              -> agreed
+//   1  p1 requests, p2 refuses                              -> refused
+//   2  p1 requests, nobody answers                          -> expired (30 s)
+//   3  p1 requests; p2 accepts the previous id (28), then the right one -> agreed
+//   4  p1 requests; p2 drops its connection -> aborted partner-left; p1 again while
+//      p2 is away (26); p2 back: accepts the aborted id (28); p1 requests, p2 accepts -> agreed
+//   5  p1 requests then cancels -> cancelled; p2's late accept (28)
+//   6  p1 placed 10 m away requests (25); put back
+//   7  p1 requests twice (23); p2 cancels (29); p1 accepts its own (29); p2 accepts -> agreed
+//   8  a boar beside p2: p1 requests (27 while it hunts; else accepted), p1 cancels
+//      (28; else cancelled); the boar killed; p1 requests, p2 accepts -> agreed
+// travel_variant 1 (the crash run): rounds 0 and 1 only; the server
+// terminates itself at travel:after-propose in round 0 (profile failpoint).
+const u32 kTravelRounds = 9;
+
+void travel_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.travel_party || !ai().get_alife())
+		return;
+	Host::Travel::Fixture& f = g_host->travel.fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.ref.slot < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				actors[link.ref.slot] = actor;
+				++attached;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-travel both-attached tick=%I64u", g_host->tick);
+	}
+	if (attached < 2)
+		return;
+	if (f.phase == 0)
+	{
+		if (g_host->tick < f.both_since + u64(config.travel_party) * 50)
+			return;
+		CLevelChanger* chosen = nullptr;
+		for (CLevelChanger* lc : g_lchangers)
+		{
+			xr_string level;
+			Fvector to;
+			travel_destination(u16(lc->ID()), level, to);
+			Fvector center;
+			lc->Center(center);
+			g_host->log.line("fixture-travel changer id=%u name=%s enabled=%d level=%s center=%.2f,%.2f,%.2f radius=%.2f",
+				u32(lc->ID()), lc->cName().c_str(), lc->IsLevelChangerEnabled() ? 1 : 0, level.c_str(), VPUSH(center),
+				lc->Radius());
+			if (!chosen && lc->IsLevelChangerEnabled() && level != "?")
+				chosen = lc;
+		}
+		if (!chosen)
+		{
+			g_host->log.line("fixture-travel no-changer");
+			f.phase = 99;
+			return;
+		}
+		f.changer = u16(chosen->ID());
+		Fvector center;
+		chosen->Center(center);
+		f.center = center;
+		for (u32 k = 0; k < 2; ++k)
+		{
+			f.actors[k] = u16(actors[k]->ID());
+			Fvector at = center;
+			at.x += k ? -0.6f : 0.6f;
+			place_beside(actors[k], at);
+			g_host->log.line("fixture-travel placed slot=%u actor=%u changer=%u at=%.2f,%.2f,%.2f", k, u32(f.actors[k]),
+				u32(f.changer), VPUSH(at));
+		}
+		f.phase = 1;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		if (g_host->tick - f.phase_tick < 5 * 50)
+			return;
+		for (u32 k = 0; k < 2; ++k)
+		{
+			float distance = 0.f;
+			CLevelChanger* lc = travel_changer(f.changer);
+			const bool at = lc && actor_at_changer(actors[k], lc, distance);
+			g_host->log.line("fixture-travel settled slot=%u at_changer=%d distance=%.2f pos=%.2f,%.2f,%.2f", k, at ? 1 : 0,
+				distance, VPUSH(actors[k]->Position()));
+		}
+		f.phase = 2;
+		f.round_tick = g_host->tick;
+		return;
+	}
+	const u32 rounds = config.travel_variant == 1 ? 2 : kTravelRounds;
+	if (f.phase != 2 || f.round >= rounds || g_host->tick < f.round_tick)
+		return;
+	const u16 C = f.changer;
+	if (f.round == 6 && !f.moved)
+	{
+		// p1 10 m from the changer for its request
+		f.moved = true;
+		Fvector away = f.center;
+		away.x += 10.f;
+		place_beside(actors[0], away);
+		g_host->log.line("fixture-travel moved-away slot=0 at=%.2f,%.2f,%.2f", VPUSH(away));
+		f.round_tick = g_host->tick + 2 * 50;
+		return;
+	}
+	if (f.round == 7 && f.moved)
+	{
+		f.moved = false;
+		Fvector back = f.center;
+		back.x += 0.6f;
+		place_beside(actors[0], back);
+		g_host->log.line("fixture-travel moved-back slot=0 at=%.2f,%.2f,%.2f", VPUSH(back));
+		f.round_tick = g_host->tick + 3 * 50;
+		return;
+	}
+	if (f.round == 8)
+	{
+		if (f.boar == kNoEngineId)
+		{
+			u32 vertex = u32(-1);
+			Fvector position;
+			CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+			const CSE_ALifeDynamicObject* se = ai().alife().objects().object(u16(actors[1]->ID()), true);
+			CSE_Abstract* entity = se && encounter_vertex(actors[1], actors[0], vertex, position)
+				? alife->spawn_item(kEncounterMonster, position, vertex, se->m_tGraphID, 0xffff) : nullptr;
+			f.boar = entity ? entity->ID : u16(0xfffe);
+			f.boar_tick = g_host->tick;
+			g_host->log.line("fixture-travel boar id=%u", u32(f.boar));
+			f.round_tick = g_host->tick + 6 * 50;
+			return;
+		}
+		// the boar hunts participant 2: its script enemy (the installed scripts'
+		// set_enemy path; at the Darkscape passage it noticed nobody by itself
+		// in 25 s, tv-3/tv-5), once it is online; then polled every second
+		string256 who;
+		const bool combat = party_in_combat(who);
+		if (!combat && g_host->tick - f.boar_tick < 25 * 50)
+		{
+			if (!f.boar_set && g_host->tick - f.boar_tick >= 3 * 50)
+				if (CBaseMonster* boar = f.boar < 0xfffe ? smart_cast<CBaseMonster*>(Level().Objects.net_Find(f.boar)) : nullptr)
+				{
+					boar->EnemyMan.script_enemy(*actors[1]);
+					f.boar_set = true;
+					g_host->log.line("fixture-travel boar-enemy id=%u actor=%u", u32(f.boar), u32(actors[1]->ID()));
+				}
+			f.round_tick = g_host->tick + 50;
+			return;
+		}
+		g_host->log.line("fixture-travel combat=%d enemy=%s waited_ticks=%I64u", combat ? 1 : 0, who,
+			g_host->tick - f.boar_tick);
+	}
+	const u32 round = f.round++;
+	f.round_tick = g_host->tick + 12 * 50;
+	xr_vector<TransferStep> steps;
+	switch (round)
+	{
+	case 0:
+		steps.push_back({0, 11, 0, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 12, 100, C, 0xffff, 0xffff, 0, 1});
+		break;
+	case 1:
+		steps.push_back({0, 11, 0, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 12, 100, C, 0xffff, 0xffff, 0, 2});
+		break;
+	case 2:
+		steps.push_back({0, 11, 0, C, 0xffff, 0xffff, 0, 0});
+		f.round_tick = g_host->tick + 40 * 50;
+		break;
+	case 3:
+		steps.push_back({0, 11, 0, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 12, 100, C, 0xffff, 0xffff, 8, 1}); // the previous transition's id
+		steps.push_back({1, 12, 200, C, 0xffff, 0xffff, 0, 1});
+		break;
+	case 4:
+		steps.push_back({0, 11, 0, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 12, 100, C, 0xffff, 0xffff, 4, 0}); // no answer: p2 drops its connection
+		steps.push_back({0, 11, 300, C, 0xffff, 0xffff, 0, 0}); // p2 away: 26
+		steps.push_back({1, 12, 2500, C, 0xffff, 0xffff, 8, 1}); // p2 back: the aborted id: 28
+		steps.push_back({0, 11, 2750, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 12, 2850, C, 0xffff, 0xffff, 0, 1});
+		f.round_tick = g_host->tick + 70 * 50;
+		break;
+	case 5:
+		steps.push_back({0, 11, 0, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({0, 12, 100, C, 0xffff, 0xffff, 0, 3});
+		steps.push_back({1, 12, 200, C, 0xffff, 0xffff, 0, 1});
+		break;
+	case 6: steps.push_back({0, 11, 0, C, 0xffff, 0xffff, 0, 0}); break;
+	case 7:
+		steps.push_back({0, 11, 0, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({0, 11, 50, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 12, 100, C, 0xffff, 0xffff, 0, 3});
+		steps.push_back({0, 12, 150, C, 0xffff, 0xffff, 0, 1});
+		steps.push_back({1, 12, 200, C, 0xffff, 0xffff, 0, 1});
+		break;
+	default:
+		// with the boar hunting: 27, then the cancel finds nothing (28); without
+		// (it noticed nobody in 25 s): accepted, then cancelled; either way the
+		// boar dies at +350 and the party agrees after it
+		steps.push_back({0, 11, 0, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({0, 12, 150, C, 0xffff, 0xffff, 0, 3});
+		steps.push_back({0, 11, 500, C, 0xffff, 0xffff, 0, 0});
+		steps.push_back({1, 12, 600, C, 0xffff, 0xffff, 0, 1});
+		f.round_tick = g_host->tick + 20 * 50;
+		break;
+	}
+	const u64 claim_tick = g_host->tick + 100;
+	std::vector<u8> payload;
+	put_u8(payload, u8(round));
+	put_u8(payload, u8(round));
+	for (int b = 0; b < 8; ++b)
+		payload.push_back(u8(claim_tick >> (8 * b)));
+	put_u8(payload, u8(steps.size()));
+	string512 detail = "";
+	for (const TransferStep& st : steps)
+	{
+		put_u8(payload, st.slot);
+		put_u8(payload, st.action);
+		put_u16(payload, st.offset);
+		put_ref(payload, st.item);
+		put_ref(payload, st.from);
+		put_ref(payload, st.to);
+		put_u8(payload, st.flags);
+		put_u8(payload, st.extra);
+		string64 one;
+		xr_sprintf(one, " %u:%u@%u:%u:a%u:f%u", u32(st.slot), u32(st.action), u32(st.offset), u32(st.item), u32(st.extra),
+			u32(st.flags));
+		xr_strcat(detail, one);
+	}
+	broadcast_event(7, payload);
+	g_host->log.line("fixture-travel-round round=%u claim_tick=%I64u steps=%u%s", round, claim_tick, u32(steps.size()),
+		detail);
+	if (round == 8)
+		f.boar_kill_tick = claim_tick + 350; // the boar dies between the two requests
+}
+
+// Round 8's boar is killed natively between the two requests.
+void travel_fixture_boar()
+{
+	Host::Travel::Fixture& f = g_host->travel.fixture;
+	if (!f.boar_kill_tick || g_host->tick < f.boar_kill_tick)
+		return;
+	f.boar_kill_tick = 0;
+	CEntityAlive* boar = f.boar < 0xfffe ? smart_cast<CEntityAlive*>(Level().Objects.net_Find(f.boar)) : nullptr;
+	if (boar && boar->g_Alive())
+		boar->KillEntity(boar->ID(), TRUE);
+	g_host->log.line("fixture-travel boar-killed id=%u dead=%d", u32(f.boar), boar && !boar->g_Alive() ? 1 : 0);
+}
