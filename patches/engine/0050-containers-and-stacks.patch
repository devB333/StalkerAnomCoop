+// ------------------------------------------------------------ S08-T08
+// The container and stack fixture (profile stack_race, client script 8: the
+// transfer driver's steps). Once both players are in the world: an inventory
+// box between them and a stalker beside it, killed at once (both created
+// after the last checkpoint); 5 rounds of 9x18 in the box, 6 in participant
+// 1's inventory, 4 in participant 2's (box size 16); bread, kolbasa, the
+// deployable backpack (itm_actor_backpack) and a backpack in slot 13 for
+// participant 1; vodka and a second backpack in the ruck for participant 2;
+// an army medkit in the body.
+//   0 put          p1 bread -> box; p2 vodka -> body              (the containers' records first)
+//   1 take         p1 the medkit from the body; p2 the bread from the box
+//   2 merge        p1 its 6 rounds -> box (merged with the box's 5: one stack of 11)
+//   3 merge        p2 its 4 rounds -> box (one stack of 15)
+//   4 backpack     p2 its backpack -> box
+//   5 stash        p1 uses the deployable backpack: the installed script puts the ruck into a new
+//                  stash box (server-made moves, observed and journaled) and releases the backpack
+//   6 from stash   p2 takes one item from the stash
+const u32 kStackRounds = 7;
+
+void stack_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.stack_race || !ai().get_alife())
+		return;
+	Host::StackFixture& f = g_host->stack_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u8 slots[2] = {0, 0};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				slots[attached] = link.ref.slot;
+				actors[attached++] = actor;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-stack both-attached tick=%I64u", g_host->tick);
+	}
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	if (f.phase == 0)
+	{
+		if (attached < 2 || g_host->tick < f.both_since + u64(config.stack_race) * 50)
+			return;
+		const u32 a0 = slots[0] == 0 ? 0 : 1;
+		f.actors[0] = u16(actors[a0]->ID());
+		f.actors[1] = u16(actors[1 - a0]->ID());
+		f.slots[0] = slots[a0];
+		f.slots[1] = slots[1 - a0];
+		Fvector mid;
+		mid.add(actors[0]->Position(), actors[1]->Position()).mul(0.5f);
