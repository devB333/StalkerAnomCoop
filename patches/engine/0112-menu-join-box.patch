+// B50: the join box (the installed message_box_direct_ip) on top of the main menu: its captions, its two
+// fields (address, code) and its OK button, in the order CUIMessageBox::InitMessageBox attaches them
+struct JoinBox
+{
+	xr_vector<CUITextWnd*> captions;
+	xr_vector<CUIEditBox*> edits;
+	CUIButton* yes = nullptr;
+};
+
+static bool menu_join_box(JoinBox& jb)
+{
+	CUIMessageBoxEx* box = MainMenu() ? smart_cast<CUIMessageBoxEx*>(MainMenu()->TopInputReceiver()) : nullptr;
+	if (!box || box->GetChildWndList().empty())
+		return false;
+	for (CUIWindow* w : box->GetChildWndList().front()->GetChildWndList())
+	{
+		if (CUIEditBox* e = smart_cast<CUIEditBox*>(w))
+			jb.edits.push_back(e);
+		else if (CUIButton* b = smart_cast<CUIButton*>(w))
+		{
+			if (!jb.yes)
+				jb.yes = b;
+		}
+		else if (CUITextWnd* t = smart_cast<CUITextWnd*>(w))
+			jb.captions.push_back(t);
+	}
+	return jb.edits.size() == 2 && jb.captions.size() == 2 && jb.yes;
+}
+
+// The template's captions are multiplayer strings Anomaly no longer has (they would show as their ids); the
+// code is shown as typed (the template hides it as a password)
+bool coop_menu_join_box_ready()
+{
+	JoinBox jb;
+	if (!menu_join_box(jb))
+	{
+		Msg("! B50 co-op menu: the join box is not on top");
+		return false;
+	}
+	jb.captions[0]->SetText("Host address");
+	jb.captions[1]->SetText("Join code");
+	jb.edits[1]->SetPasswordMode(false);
+	return true;
+}
