+extern "C" bool __cdecl xrCampaignIdentity_Start()
+{
+	R_ASSERT2(!g_campaign_identity, "The identity registry already exists");
+	g_campaign_identity = xr_new<CampaignIdentityRegistry>(Role::Server, 2);
+	Msg("S03-T01 identity registry role=server active_slots=%u engine_ids=%u", u32(g_campaign_identity->active_slots()),
+		kEngineIdCount);
+	return true;
+}
+
+extern "C" void __cdecl xrCampaignIdentity_Stop()
+{
+	if (!g_campaign_identity)
+		return;
+	const CampaignIdentityRegistry::EngineIdStats& stats = g_campaign_identity->engine_id_stats();
+	Msg("S03-T01 identity stop engine ids assigned=%I64u freed=%I64u freed_unbound=%I64u reassigned_after_free=%I64u "
+		"continued=%I64u live=%I64u incarnations=%I64u max_generation=%u next_entity=%I64u participants=%u",
+		stats.assigned, stats.freed, stats.freed_unbound, stats.reassigned_after_free, stats.continued, stats.live,
+		stats.incarnations, stats.max_generation, stats.next_entity, u32(g_campaign_identity->bound_count()));
+	xr_delete(g_campaign_identity);
+}
+
+extern "C" bool __cdecl xrCampaignIdentity_Fixture(LPCSTR name)
+{
+	if (!xr_strcmp(name, "engine-id"))
+		return fixture_engine_id();
+	if (!xr_strcmp(name, "slot-reuse"))
+		return fixture_slot_reuse();
+	if (!xr_strcmp(name, "disconnect-retention"))
+		return fixture_disconnect_retention();
+	if (!xr_strcmp(name, "role-context"))
+		return fixture_role_context();
+	Msg("! S03-T01 unknown fixture %s", name);
+	return false;
+}
+
+// The in-process direct client (xrServer::create_direct_client) is the
+// private state bridge, never a participant.
+extern "C" bool __cdecl xrCampaignIdentity_BindBridge()
+{
+	if (!g_campaign_identity || !g_pGameLevel || !Level().Server)
+		return false;
+	IClient* bridge = Level().Server->GetServerClient();
+	if (!bridge)
+	{
+		Msg("! S03-T01 the server has no bridge client");
+		return false;
+	}
+	const Refusal refusal = g_campaign_identity->set_bridge_session(g_campaign_identity->authority(), bridge->ID.value());
+	Msg("S03-T01 bridge session=%u local=%d refusal=%s", bridge->ID.value(), bridge->flags.bLocal ? 1 : 0,
+		refusal_name(refusal));
+	return refusal == Refusal::None;
+}
+
+// Audits the live bindings against the level: every online object and every
+// ALife object holds a current binding, and no live binding is without an
+// object. Then binds the saved actor to a fixture participant as the first
+// real engine object held by a participant reference.
+extern "C" bool __cdecl xrCampaignLevel_IdentityCheck()
+{
+	if (!g_campaign_identity || !g_pGameLevel || !Level().Server || !ai().get_alife())
+		return false;
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	CLevel& level = Level();
+	const CALifeObjectRegistry::OBJECT_REGISTRY& alife_objects = ai().get_alife()->objects().objects();
+
+	u32 objects = 0, missing_online = 0, missing_entity = 0, missing_alife = 0, orphans = 0;
+	EngineEntityKey key;
+	for (u32 i = 0; i < level.Objects.o_count(); ++i)
+	{
+		CObject* object = level.Objects.o_get_by_iterator(i);
+		++objects;
+		if (!registry.current_key(object->ID(), key))
+		{
+			++missing_online;
+			if (missing_online <= 5)
+				Msg("! S03-T01 online object %u (%s) has no live binding", u32(object->ID()), object->cName().c_str());
+		}
+		if (!level.Server->ID_to_entity(object->ID()))
+			++missing_entity;
+	}
+	u32 mismatched = 0;
+	EntityId entity;
+	for (CALifeObjectRegistry::OBJECT_REGISTRY::const_iterator it = alife_objects.begin(); it != alife_objects.end(); ++it)
+	{
+		if (!registry.current_key(it->first, key))
+		{
+			++missing_alife;
+			if (missing_alife <= 5)
+				Msg("! S03-T01 ALife object %u (%s) has no live binding", u32(it->first), it->second->name_replace());
+			continue;
+		}
+		registry.resolve(key, entity);
+		if (entity.value != it->second->m_campaign_entity)
+		{
+			++mismatched;
+			if (mismatched <= 5)
+				Msg("! S03-T01 ALife object %u (%s) stores entity %I64u, binding says %I64u", u32(it->first),
+					it->second->name_replace(), it->second->m_campaign_entity, entity.value);
+		}
+	}
+	for (u32 id = 0; id < kEngineIdCount; ++id)
+	{
+		if (!registry.current_key(u16(id), key))
+			continue;
+		if (level.Server->ID_to_entity(u16(id)) || alife_objects.find(u16(id)) != alife_objects.end())
+			continue;
+		++orphans;
+		if (orphans <= 5)
+			Msg("! S03-T01 live binding %u generation %u has no server entity and no ALife object", id, key.generation);
+	}
+	const CampaignIdentityRegistry::EngineIdStats& stats = registry.engine_id_stats();
+	Msg("S03-T01 identity-check online_objects=%u alife_objects=%u server_entities=%u live=%I64u missing_online=%u "
+		"missing_entity=%u missing_alife=%u mismatched=%u orphans=%u assigned=%I64u freed=%I64u freed_unbound=%I64u "
+		"reassigned_after_free=%I64u continued=%I64u incarnations=%I64u max_generation=%u next_entity=%I64u",
+		objects, u32(alife_objects.size()), level.Server->GetEntitiesNum(), stats.live, missing_online, missing_entity,
+		missing_alife, mismatched, orphans, stats.assigned, stats.freed, stats.freed_unbound, stats.reassigned_after_free,
+		stats.continued, stats.incarnations, stats.max_generation, stats.next_entity);
+
+	// The saved actor under a participant reference (fixture identities; the
+	// authenticated binding is S04-T04, the second actor S03-T03).
+	bool actor_bound = false;
+	if (g_actor)
+	{
+		const ServerAuthority* authority = registry.authority();
+		ParticipantRef ref;
+		Refusal refusal = registry.find_player(player_id(1), ref);
+		if (refusal != Refusal::None)
+			refusal = registry.bind_participant(authority, player_id(1), party_id(1), Device.dwFrame, ref);
+		EngineEntityKey actor_key;
+		if (refusal == Refusal::None && registry.current_key(g_actor->ID(), actor_key))
+			refusal = registry.bind_actor(authority, ref, actor_key);
+		const Participant* view = nullptr;
+		if (refusal == Refusal::None)
+			refusal = registry.participant(ref, view);
+		actor_bound = refusal == Refusal::None && view && view->actor_key.id == g_actor->ID();
+		CSE_Abstract* se_actor = level.Server->ID_to_entity(g_actor->ID());
+		Msg("S03-T01 actor id=%u key={%u,%u} entity=%I64u stored=%I64u participant={%u,%u} state=%s refusal=%s",
+			u32(g_actor->ID()), u32(actor_key.id), actor_key.generation, view ? view->actor.value : 0ull,
+			se_actor ? se_actor->m_campaign_entity : 0ull, u32(ref.slot), ref.generation,
+			view ? participant_state_name(view->state) : "-", refusal_name(refusal));
+	}
+	else
+		Msg("! S03-T01 no actor to bind");
+	return missing_online == 0 && missing_entity == 0 && missing_alife == 0 && mismatched == 0 && orphans == 0 &&
+		actor_bound;
+}
diff --git a/src/xrGame/CampaignIdentityFixture.h b/src/xrGame/CampaignIdentityFixture.h
new file mode 100644
index 0000000..3bee77c
--- /dev/null
+++ b/src/xrGame/CampaignIdentityFixture.h
@@ -0,0 +1,28 @@
+#pragma once
+
+// S03-T01: the campaign server's identity service and its unit fixtures.
+//
+// The service owns the process registry (g_campaign_identity, Role::Server,
+// two active slots). The fixtures each build their own registry, so the
+// process registry only ever sees the engine's real id traffic:
+//  - engine-id: the server's own id generator type recycles a freed u16 at
+//    once; the registry's generations keep the old reference from resolving
+//    to the new object, in a single step and across a thousand releases.
+//  - slot-reuse: two slots as policy; a third player is refused; a released
+//    slot changes hands under a new generation, so the old reference is
+//    stale rather than the new owner.
+//  - disconnect-retention: a detached participant keeps its slot, player,
+//    party and actor; a new session re-attaches to the same participant;
+//    the bridge client is never a participant; one session, one participant.
+//  - role-context: client intents act only as their session's participant
+//    and never in identity or world scope; wrong-party and stale contexts
+//    are refused; a client-role registry authorizes nothing and mints no
+//    token.
+// With a level loaded, xrCampaignLevel_IdentityCheck audits the live
+// bindings against the online objects and the ALife registry.
+
+extern "C" bool __cdecl xrCampaignIdentity_Start();
+extern "C" void __cdecl xrCampaignIdentity_Stop();
+extern "C" bool __cdecl xrCampaignIdentity_Fixture(LPCSTR name);
+extern "C" bool __cdecl xrCampaignIdentity_BindBridge();
+extern "C" bool __cdecl xrCampaignLevel_IdentityCheck();
