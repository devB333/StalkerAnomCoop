diff --git a/src/xrGame/CoopClientLink.cpp b/src/xrGame/CoopClientLink.cpp
new file mode 100644
index 0000000..df711cc
--- /dev/null
+++ b/src/xrGame/CoopClientLink.cpp
@@ -0,0 +1,347 @@
+#include "pch_script.h"
+#include "CoopClientLink.h"
+
+// S05-T01: see CoopClientLink.h.
+
+#include "CoopConfig.h"
+#include "CoopIdentity.h"
+#include "../xrEngine/xr_ioconsole.h"
+#include "../xrEngine/IGame_Level.h"
+
+#include "coop/net/transport.h"
+#include "coop/session/client.h"
+#include "coop/session/crypto.h"
+
+#include <memory>
+
+using namespace campaign;
+
+namespace
+{
+// The S05-T01 refusal test (profile inject=1): a co-op client tries a local
+// game start, an action the server does not define, and a server-only
+// message. Each must be refused without changing the server's world.
+enum class Inject : u8
+{
+	Off,
+	AwaitWelcome,
+	LocalStart, // ask for a local single-player game
+	CheckLocalStart, // the start was refused and no level exists
+	AwaitIntentResult, // a forged action intent
+	AwaitClose, // a server-only Spawn: the server must close the connection
+	Rejoin, // connect again: the player is still welcome
+	Done,
+};
+
+struct Link
+{
+	CoopConfig config;
+	bool active = false;
+	coop::proto::LocalBuild build;
+	coop::proto::Uuid128 player;
+	std::unique_ptr<coop::net::Transport> transport;
+	std::unique_ptr<coop::session::Client> client;
+	std::vector<coop::session::ClientEvent> events;
+	CoopEventLog log;
+	CTimer wall;
+	u32 last_status_ms = 0;
+	u32 last_stop_check_ms = 0;
+	u32 connects = 0;
+	u32 welcomes = 0;
+	bool quitting = false;
+	// role guard
+	u32 local_starts_refused = 0;
+	u32 local_starts_allowed = 0;
+	// refusal test
+	Inject inject = Inject::Off;
+	u32 inject_at_ms = 0;
+	u64 inject_operation = 0;
+	u32 inject_ok = 0;
+	u32 inject_failed = 0;
+};
+
+Link* g_link = nullptr;
+
+bool make_client()
+{
+	coop::session::PrivateKey key;
+	coop::session::PublicKey pub;
+	coop::proto::Uuid128 player;
+	std::string error;
+	if (!coop::session::load_key_file(g_link->config.key_path, player, key, pub, &error))
+	{
+		g_link->log.line("key-file-failed %s", error.c_str());
+		return false;
+	}
+	g_link->player = player;
+	coop::session::ClientConfig config;
+	config.build = g_link->build;
+	config.player_id = player;
+	config.display_name = g_link->config.display_name;
+	config.expected_campaign = g_link->config.campaign_id;
+	g_link->client = std::make_unique<coop::session::Client>(*g_link->transport, config, std::move(key));
+	return true;
+}
+
+bool connect()
+{
+	if (!make_client())
+		return false;
+	++g_link->connects;
+	const bool ok = g_link->client->connect(g_link->config.server_address);
+	g_link->log.line("connect server=%s player=%s attempt=%u: %s", g_link->config.server_address,
+		coop_uuid_hex(g_link->player).c_str(), g_link->connects, ok ? "started" : "failed");
+	return ok;
+}
+
+void inject_result(LPCSTR step, bool ok, LPCSTR detail)
+{
+	if (ok)
+		++g_link->inject_ok;
+	else
+		++g_link->inject_failed;
+	g_link->log.line("inject-%s %s %s", step, ok ? "refused-as-expected" : "NOT-REFUSED", detail);
+}
+
+void inject_step()
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	switch (g_link->inject)
+	{
+	case Inject::LocalStart:
+		if (now < g_link->inject_at_ms)
+			return;
+		g_link->log.line("inject-local-start requesting start server(player - autosave/single/alife/load)");
+		Console->Execute("start server(player - autosave/single/alife/load) client(localhost)");
+		g_link->inject = Inject::CheckLocalStart;
+		g_link->inject_at_ms = now + 2000;
+		return;
+	case Inject::CheckLocalStart:
+	{
+		if (now < g_link->inject_at_ms)
+			return;
+		string128 detail;
+		xr_sprintf(detail, "refused=%u level=%d", g_link->local_starts_refused, g_pGameLevel ? 1 : 0);
+		inject_result("local-start", g_link->local_starts_refused > 0 && !g_pGameLevel, detail);
+		// An action the server does not define, aimed at entity 1: a client
+		// asking for an outcome. It must come back Rejected.
+		coop::proto::ActionIntent intent;
+		intent.operation_id = g_link->inject_operation = 0x5051;
+		intent.kind = 7; // no kind is defined in protocol v1 yet
+		intent.target.id = 1;
+		intent.target.generation = 1;
+		const char forged[] = "health=0";
+		intent.params.assign(forged, forged + sizeof(forged) - 1);
+		const bool sent = g_link->client->send(coop::proto::Message(intent));
+		g_link->log.line("inject-intent sent=%d operation=%I64u kind=7", sent ? 1 : 0, intent.operation_id);
+		g_link->inject = Inject::AwaitIntentResult;
+		g_link->inject_at_ms = now + 5000;
+		return;
+	}
+	case Inject::AwaitIntentResult:
+		if (now >= g_link->inject_at_ms)
+		{
+			inject_result("intent", false, "no result within 5 s");
+			g_link->inject = Inject::Done;
+		}
+		return;
+	case Inject::AwaitClose:
+		if (now >= g_link->inject_at_ms)
+		{
+			inject_result("server-only-message", false, "the connection stayed open for 5 s");
+			g_link->inject = Inject::Done;
+		}
+		return;
+	case Inject::Rejoin:
+		if (now < g_link->inject_at_ms)
+			return;
+		connect();
+		g_link->inject = Inject::Done;
+		return;
+	default: return;
+	}
+}
+
+void on_message(const coop::session::ClientEvent& e)
+{
+	if (const auto* result = std::get_if<coop::proto::ActionResult>(&e.message.body))
+	{
+		g_link->log.line("action-result operation=%I64u outcome=%u reason=%u", result->operation_id,
+			u32(result->outcome), u32(result->reason));
+		if (g_link->inject == Inject::AwaitIntentResult && result->operation_id == g_link->inject_operation)
+		{
+			string128 detail;
+			xr_sprintf(detail, "outcome=%u reason=%u", u32(result->outcome), u32(result->reason));
+			inject_result("intent", result->outcome == coop::proto::ActionOutcome::Rejected, detail);
+			// A message only the server may send. The server's decoder refuses
+			// it and closes the connection as a protocol violation.
+			coop::proto::Spawn spawn;
+			spawn.entity.id = 1;
+			spawn.entity.generation = 1;
+			spawn.archetype = "actor";
+			spawn.commit_id = 1;
+			const bool sent = g_link->client->send(coop::proto::Message(spawn));
+			g_link->log.line("inject-spawn sent=%d", sent ? 1 : 0);
+			g_link->inject = Inject::AwaitClose;
+			g_link->inject_at_ms = g_link->wall.GetElapsed_ms() + 5000;
+		}
+		return;
+	}
+	g_link->log.line("message type=%s channel=%u", coop::proto::to_string(coop::proto::type_of(e.message.body)),
+		u32(e.channel));
+}
+
+void on_event(const coop::session::ClientEvent& e)
+{
+	switch (e.type)
+	{
+	case coop::session::ClientEventType::Welcomed:
+	{
+		const coop::proto::Welcome& w = e.welcome;
+		++g_link->welcomes;
+		g_link->log.line("welcomed slot=%u slot_generation=%u epoch=%I64u server_tick=%I64u tick_hz=%u snapshot_hz=%u "
+			"session=%s player=%s resumed=%d",
+			u32(w.slot), w.slot_generation, w.authority_epoch, w.server_tick, u32(w.tick_rate_hz),
+			u32(w.snapshot_rate_hz), coop_uuid_hex(w.session_id).c_str(), coop_uuid_hex(w.player_id).c_str(),
+			e.resumed ? 1 : 0);
+		if (g_link->inject == Inject::AwaitWelcome)
+		{
+			g_link->inject = Inject::LocalStart;
+			g_link->inject_at_ms = g_link->wall.GetElapsed_ms() + 1000;
+		}
+		if (g_link->inject == Inject::Done && g_link->welcomes > 1)
+			g_link->log.line("inject-rejoin welcomed-again welcomes=%u", g_link->welcomes);
+		break;
+	}
+	case coop::session::ClientEventType::Rejected:
+		g_link->log.line("rejected reason=%u detail=%s", u32(e.reject.reason), e.reject.detail.c_str());
+		break;
+	case coop::session::ClientEventType::Ended:
+		g_link->log.line("ended reason=%s code=%d detail=%s", coop::net::to_string(e.reason), e.code,
+			e.detail.c_str());
+		if (g_link->inject == Inject::AwaitClose)
+		{
+			string128 detail;
+			xr_sprintf(detail, "code=%d", e.code);
+			inject_result("server-only-message", e.code == coop::net::close_code::kProtocolViolation, detail);
+			g_link->inject = Inject::Rejoin;
+			g_link->inject_at_ms = g_link->wall.GetElapsed_ms() + 2000;
+		}
+		break;
+	case coop::session::ClientEventType::Message: on_message(e); break;
+	case coop::session::ClientEventType::Suspect: g_link->log.line("server-suspect"); break;
+	case coop::session::ClientEventType::Recovered: g_link->log.line("server-recovered"); break;
+	}
+}
+
+void log_status(LPCSTR tag)
+{
+	const std::vector<double>& rtts = g_link->client ? g_link->client->rtts() : std::vector<double>();
+	g_link->log.line("%s state=%u welcomes=%u connects=%u level=%d local_starts_refused=%u rtt_samples=%u "
+		"last_rtt_ms=%.2f inject_ok=%u inject_failed=%u",
+		tag, g_link->client ? u32(g_link->client->state()) : 0u, g_link->welcomes, g_link->connects,
+		g_pGameLevel ? 1 : 0, g_link->local_starts_refused, u32(rtts.size()), rtts.empty() ? -1.0 : rtts.back(),
+		g_link->inject_ok, g_link->inject_failed);
+}
+} // namespace
+
+namespace campaign
+{
+bool coop_client_active() { return g_link && g_link->active; }
+
+void coop_client_app_start()
+{
+	string_path path;
+	if (g_link || !coop_config_path(Core.Params, path))
+		return;
+	g_link = xr_new<Link>();
+	if (!coop_config_load(path, g_link->config) || g_link->config.server)
+	{
+		Msg("! S05-T01 -coop-config needs a [coop] role=client profile; the client runs without co-op");
+		xr_delete(g_link);
+		return;
+	}
+	// The role guard holds from here on, even if the connection fails.
+	g_link->active = true;
+	g_link->log.open(g_link->config.log_path);
+	g_link->wall.Start();
+	if (!coop_local_build(g_link->build))
+	{
+		g_link->log.line("local-build-failed");
+		return;
+	}
+	g_link->log.line("client-start campaign=%s build=%s content=%s protocol=%u.%u",
+		coop_uuid_hex(g_link->config.campaign_id).c_str(), coop_hex(g_link->build.build_id).c_str(),
+		coop_hex(g_link->build.content_digest).c_str(), u32(g_link->build.major), u32(g_link->build.minor));
+	std::string error;
+	g_link->transport =
+		coop::net::create_gns_transport(coop::session::transport_config(coop::session::LivenessConfig()), &error);
+	if (!g_link->transport)
+	{
+		g_link->log.line("transport-failed %s", error.c_str());
+		return;
+	}
+	if (g_link->config.inject)
+		g_link->inject = Inject::AwaitWelcome;
+	connect();
+}
+
+void coop_client_frame()
+{
+	if (!g_link || !g_link->active)
+		return;
+	if (g_link->client)
+	{
+		g_link->events.clear();
+		g_link->client->update(g_link->events);
+		for (const coop::session::ClientEvent& e : g_link->events)
+			on_event(e);
+	}
+	inject_step();
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (now - g_link->last_status_ms >= 5000)
+	{
+		g_link->last_status_ms = now;
+		log_status("status");
+	}
+	if (!g_link->quitting && now - g_link->last_stop_check_ms >= 500)
+	{
+		g_link->last_stop_check_ms = now;
+		const bool stop_file = coop_file_exists(g_link->config.stop_file);
+		const bool time_up = g_link->config.exit_after_seconds && now >= g_link->config.exit_after_seconds * 1000;
+		if (stop_file || time_up)
+		{
+			g_link->quitting = true;
+			g_link->log.line("client-exit reason=%s", stop_file ? "stop-file" : "time");
+			log_status("final");
+			Console->Execute("quit");
+		}
+	}
+}
+
+void coop_client_app_end()
+{
+	if (!g_link)
+		return;
+	if (g_link->client)
+		g_link->client->close(coop::net::close_code::kNormal, "client exit");
+	if (g_link->transport)
+		g_link->transport->shutdown(500);
+	g_link->client.reset();
+	g_link->transport.reset();
+	g_link->log.line("client-stopped");
+	g_link->log.close();
+	xr_delete(g_link);
+}
+} // namespace campaign
+
+extern "C" bool __cdecl xrCoopClient_AllowLocalStart(LPCSTR op_server)
+{
+	if (!coop_client_active())
+		return true;
+	// S05-T02 adds the one start a co-op client may make: the replica level
+	// the link requests itself.
+	++g_link->local_starts_refused;
+	g_link->log.line("role-guard refused-local-start server_options=%s", op_server ? op_server : "");
+	return false;
+}
diff --git a/src/xrGame/CoopClientLink.h b/src/xrGame/CoopClientLink.h
new file mode 100644
index 0000000..c0f6685
--- /dev/null
+++ b/src/xrGame/CoopClientLink.h
@@ -0,0 +1,26 @@
+#pragma once
+
+// S05-T01: a rendering client's link to the campaign server. Started by
+// -coop-config <profile> with role=client: the process connects, proves its
+// player's key (coop::session::Client, S04-T04) and then only presents what
+// the server sends and sends intents. It never simulates the shared world:
+//
+// - Role guard: while the link is active, a local game start (main menu new
+//   game or load, console start/load) is refused; the only level a co-op
+//   client may start is the replica the link itself requests from the
+//   server's world (S05-T02). Refusals are counted and logged.
+// - The link is polled once per frame on the main thread
+//   (CGamePersistent::OnFrame); network input reaches the process nowhere else.
+
+namespace campaign
+{
+// Called from CGamePersistent::OnAppStart / OnFrame / OnAppEnd on the client.
+void coop_client_app_start();
+void coop_client_frame();
+void coop_client_app_end();
+// This process is a co-op client.
+bool coop_client_active();
+} // namespace campaign
+
+// From CApplication::OnEvent(eStart) in xrEngine: false refuses the start.
+extern "C" bool __cdecl xrCoopClient_AllowLocalStart(LPCSTR op_server);
diff --git a/src/xrGame/CoopConfig.cpp b/src/xrGame/CoopConfig.cpp
new file mode 100644
index 0000000..f3c2be7
--- /dev/null
+++ b/src/xrGame/CoopConfig.cpp
@@ -0,0 +1,189 @@
+#include "pch_script.h"
+#include "CoopConfig.h"
+
+// S05-T01: see CoopConfig.h.
+
+#include "coop/session/crypto.h"
+
+namespace campaign
+{
+bool coop_config_path(LPCSTR command_line, string_path& out)
+{
+	LPCSTR option = command_line ? strstr(command_line, "-coop-config ") : nullptr;
+	if (!option)
+		return false;
+	if (sscanf_s(option + 13, "%259s", out, static_cast<unsigned>(sizeof(out))) != 1)
+		return false;
+	return out[1] == ':' && (out[2] == '\\' || out[2] == '/');
+}
+
+bool coop_uuid_parse(LPCSTR text, coop::proto::Uuid128& out)
+{
+	if (!text)
+		return false;
+	coop::proto::Uuid128 id;
+	if (!coop::session::uuid_from_hex(text, id) || (id.hi | id.lo) == 0)
+		return false;
+	out = id;
+	return true;
+}
+
+xr_string coop_uuid_hex(const coop::proto::Uuid128& id)
+{
+	return xr_string(coop::session::uuid_hex(id).c_str());
+}
+
+bool coop_file_exists(LPCSTR path)
+{
+	const DWORD attributes = GetFileAttributesA(path);
+	return attributes != INVALID_FILE_ATTRIBUTES && !(attributes & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+namespace
+{
+bool read_string(CInifile& ini, LPCSTR key, LPSTR out, u32 size, bool required)
+{
+	out[0] = 0;
+	if (!ini.line_exist("coop", key))
+	{
+		if (required)
+			Msg("! S05-T01 coop config: [coop] %s is missing", key);
+		return !required;
+	}
+	LPCSTR value = ini.r_string("coop", key);
+	if (!value || !value[0])
+	{
+		if (required)
+			Msg("! S05-T01 coop config: [coop] %s is empty", key);
+		return !required;
+	}
+	if (xr_strlen(value) >= size)
+	{
+		Msg("! S05-T01 coop config: [coop] %s is too long", key);
+		return false;
+	}
+	xr_strcpy(out, size, value);
+	return true;
+}
+
+bool absolute(LPCSTR path) { return path[0] && path[1] == ':' && (path[2] == '\\' || path[2] == '/'); }
+} // namespace
+
+bool coop_config_load(LPCSTR path, CoopConfig& out)
+{
+	ZeroMemory(&out, sizeof(out));
+	// The profile lives outside the virtual file system: read it directly.
+	FILE* file = fopen(path, "rb");
+	if (!file)
+	{
+		Msg("! S05-T01 coop config not found: %s", path);
+		return false;
+	}
+	xr_vector<char> text(64 * 1024);
+	const size_t size = fread(text.data(), 1, text.size() - 1, file);
+	fclose(file);
+	if (size == 0 || size >= text.size() - 1)
+	{
+		Msg("! S05-T01 coop config empty or larger than 64 KiB: %s", path);
+		return false;
+	}
+	IReader reader(text.data(), int(size));
+	CInifile ini(&reader, path);
+	if (!ini.section_exist("coop"))
+	{
+		Msg("! S05-T01 coop config has no [coop] section: %s", path);
+		return false;
+	}
+	string64 role;
+	bool ok = read_string(ini, "role", role, sizeof(role), true);
+	out.server = !xr_strcmp(role, "server");
+	if (ok && !out.server && xr_strcmp(role, "client"))
+	{
+		Msg("! S05-T01 coop config: role must be server or client");
+		ok = false;
+	}
+	string128 hex;
+	ok = read_string(ini, "campaign_id", hex, sizeof(hex), true) && ok;
+	if (ok && !coop_uuid_parse(hex, out.campaign_id))
+	{
+		Msg("! S05-T01 coop config: campaign_id must be 32 hex digits");
+		ok = false;
+	}
+	ok = read_string(ini, "log", out.log_path, sizeof(out.log_path), true) && ok;
+	ok = read_string(ini, "stop_file", out.stop_file, sizeof(out.stop_file), true) && ok;
+	if (out.server)
+	{
+		ok = read_string(ini, "listen", out.listen, sizeof(out.listen), true) && ok;
+		ok = read_string(ini, "roster", out.roster_path, sizeof(out.roster_path), true) && ok;
+		ok = read_string(ini, "save", out.save_name, sizeof(out.save_name), true) && ok;
+		ok = read_string(ini, "party_id", hex, sizeof(hex), true) && ok;
+		if (ok && !coop_uuid_parse(hex, out.party_id))
+		{
+			Msg("! S05-T01 coop config: party_id must be 32 hex digits");
+			ok = false;
+		}
+		out.serve_seconds = ini.line_exist("coop", "serve_seconds") ? ini.r_u32("coop", "serve_seconds") : 0;
+		if (ok && !absolute(out.roster_path))
+		{
+			Msg("! S05-T01 coop config: roster must be an absolute path");
+			ok = false;
+		}
+	}
+	else
+	{
+		ok = read_string(ini, "server", out.server_address, sizeof(out.server_address), true) && ok;
+		ok = read_string(ini, "key", out.key_path, sizeof(out.key_path), true) && ok;
+		ok = read_string(ini, "name", out.display_name, sizeof(out.display_name), true) && ok;
+		out.exit_after_seconds =
+			ini.line_exist("coop", "exit_after_seconds") ? ini.r_u32("coop", "exit_after_seconds") : 0;
+		out.inject = ini.line_exist("coop", "inject") ? ini.r_u32("coop", "inject") : 0;
+		if (ok && !absolute(out.key_path))
+		{
+			Msg("! S05-T01 coop config: key must be an absolute path");
+			ok = false;
+		}
+	}
+	if (ok && (!absolute(out.log_path) || !absolute(out.stop_file)))
+	{
+		Msg("! S05-T01 coop config: log and stop_file must be absolute paths");
+		ok = false;
+	}
+	out.loaded = ok;
+	Msg("S05-T01 coop config %s role=%s campaign=%s: %s", path, out.server ? "server" : "client",
+		ok ? coop_uuid_hex(out.campaign_id).c_str() : "-", ok ? "ok" : "refused");
+	return ok;
+}
+
+bool CoopEventLog::open(LPCSTR path)
+{
+	close();
+	m_file = fopen(path, "a");
+	return m_file != nullptr;
+}
+
+void CoopEventLog::close()
+{
+	if (m_file)
+		fclose(m_file);
+	m_file = nullptr;
+}
+
+void CoopEventLog::line(LPCSTR format, ...)
+{
+	string2048 text;
+	va_list args;
+	va_start(args, format);
+	vsnprintf_s(text, sizeof(text), _TRUNCATE, format, args);
+	va_end(args);
+	if (m_file)
+	{
+		// UTC milliseconds, so the server's and the clients' logs line up.
+		FILETIME now;
+		GetSystemTimeAsFileTime(&now);
+		const u64 utc_ms = ((u64(now.dwHighDateTime) << 32) | now.dwLowDateTime) / 10000ull - 11644473600000ull;
+		fprintf(m_file, "%I64u %s\n", utc_ms, text);
+		fflush(m_file);
+	}
+	Msg("coop %s", text);
+}
+} // namespace campaign
diff --git a/src/xrGame/CoopConfig.h b/src/xrGame/CoopConfig.h
new file mode 100644
index 0000000..98b2c79
--- /dev/null
+++ b/src/xrGame/CoopConfig.h
@@ -0,0 +1,69 @@
+#pragma once
+
+// S05-T01: a process's co-op launch profile, read from the file named by
+// -coop-config <absolute path> (tools/prepare-coop-session.py writes one per
+// process). Section [coop]:
+//
+//   role          server | client
+//   campaign_id   32 hex digits (both; a client refuses to prove itself to another campaign)
+//   log           absolute path of this process's co-op event log
+//   stop_file     absolute path; when it exists the process ends cleanly
+//   server only:  listen (ip:port), roster (absolute path), party_id (32 hex),
+//                 save (saved game to serve), serve_seconds (0: until stop_file)
+//   client only:  server (ip:port), key (absolute DPAPI key file), name,
+//                 exit_after_seconds (0: never), inject (0/1: S05-T01 refusal test)
+//
+// Nothing in it is secret: the key file is DPAPI-protected and only its path
+// is here; the roster holds public keys.
+
+#include "coop/proto/wire.h"
+
+namespace campaign
+{
+struct CoopConfig
+{
+	bool loaded;
+	bool server;
+	coop::proto::Uuid128 campaign_id;
+	coop::proto::Uuid128 party_id;
+	string_path log_path;
+	string_path stop_file;
+	// server
+	string64 listen;
+	string_path roster_path;
+	string64 save_name;
+	u32 serve_seconds;
+	// client
+	string64 server_address;
+	string_path key_path;
+	string64 display_name;
+	u32 exit_after_seconds;
+	u32 inject;
+};
+
+// Finds -coop-config in the command line. False when absent.
+bool coop_config_path(LPCSTR command_line, string_path& out);
+// Reads and checks the profile; logs and returns false on any error.
+bool coop_config_load(LPCSTR path, CoopConfig& out);
+bool coop_uuid_parse(LPCSTR text, coop::proto::Uuid128& out);
+// An absolute path outside the engine's virtual file system (FS.exist only
+// knows registered files).
+bool coop_file_exists(LPCSTR path);
+xr_string coop_uuid_hex(const coop::proto::Uuid128& id);
+
+// A small append-only event log (one line per event, flushed) beside the
+// engine log, so a test can read a process's co-op story without parsing
+// the engine log. Never given keys, nonces or tokens.
+class CoopEventLog
+{
+public:
+	CoopEventLog() : m_file(nullptr) {}
+	~CoopEventLog() { close(); }
+	bool open(LPCSTR path);
+	void close();
+	void line(LPCSTR format, ...);
+
+private:
+	FILE* m_file;
+};
+} // namespace campaign
diff --git a/src/xrGame/CoopIdentity.cpp b/src/xrGame/CoopIdentity.cpp
new file mode 100644
index 0000000..8c9c5e5
--- /dev/null
+++ b/src/xrGame/CoopIdentity.cpp
@@ -0,0 +1,183 @@
+#include "pch_script.h"
+#include "CoopIdentity.h"
+
+// S05-T01: see CoopIdentity.h.
+
+#include "coop/session/crypto.h"
+#include "coop_build_id.h" // generated by Coop.props from tools/Build-Stage2.ps1
+
+// The co-op libraries (Coop.props puts their directories on the link path).
+// GameNetworkingSockets.dll is delay-loaded: only a co-op process loads it.
+#pragma comment(lib, "coop_session.lib")
+#pragma comment(lib, "coop_protocol.lib")
+#pragma comment(lib, "coop_net_gns.lib")
+#pragma comment(lib, "coop_net.lib")
+#pragma comment(lib, "GameNetworkingSockets.lib")
+#pragma comment(lib, "bcrypt.lib")
+#pragma comment(lib, "crypt32.lib")
+#pragma comment(lib, "delayimp.lib")
+
+namespace campaign
+{
+namespace
+{
+bool g_content_ready = false;
+coop::proto::Digest g_content{};
+CoopContentStats g_content_stats{};
+
+struct ContentEntry
+{
+	xr_string name; // full lowercase name, as registered
+	xr_string line; // archive entries: final; loose files: filled after the walk
+	bool loose;
+};
+
+struct ContentWalk
+{
+	xr_string prefix; // lowercase $game_data$ with its trailing separator
+	xr_vector<ContentEntry> entries; // registry order (sorted by name)
+	CoopContentStats stats;
+};
+
+// Collects only: reading a file can make the locator rescan, so nothing is
+// opened while its registry is being walked.
+void visit_file(const CLocatorAPI::file& entry, void* context)
+{
+	ContentWalk& walk = *static_cast<ContentWalk*>(context);
+	const size_t prefix = walk.prefix.size();
+	const size_t length = xr_strlen(entry.name);
+	if (length <= prefix || strncmp(entry.name, walk.prefix.c_str(), prefix) != 0)
+		return;
+	if (entry.name[length - 1] == '\\' || entry.name[length - 1] == '/')
+		return; // a folder
+	// Player settings the installed scripts rewrite at run time (the MCM
+	// options file bumps its own version stamp): not content.
+	static LPCSTR const settings[] = {"configs\\axr_options.ltx"};
+	for (LPCSTR excluded : settings)
+		if (!xr_strcmp(entry.name + prefix, excluded))
+		{
+			++walk.stats.excluded_files;
+			return;
+		}
+	// Editor metadata in dot-folders (scripts\.vscode): the locator registers
+	// it at start and drops it on a later rescan; the game never loads it.
+	if (entry.name[prefix] == '.' || strstr(entry.name + prefix, "\\."))
+	{
+		++walk.stats.excluded_files;
+		return;
+	}
+	ContentEntry item;
+	item.name = entry.name;
+	item.loose = entry.vfs == 0xffffffff;
+	if (!item.loose)
+	{
+		string512 line;
+		xr_sprintf(line, "a|%s|%u|%u|%08x\n", entry.name + prefix, entry.size_real, entry.size_compressed, entry.crc);
+		item.line = line;
+		++walk.stats.archive_files;
+	}
+	walk.entries.push_back(item);
+}
+
+// Loose files by content: name, size and SHA-256 of the bytes.
+bool hash_loose(ContentWalk& walk, ContentEntry& item)
+{
+	IReader* reader = FS.r_open(item.name.c_str());
+	if (!reader)
+	{
+		Msg("! S05-T01 content digest: cannot read %s", item.name.c_str());
+		return false;
+	}
+	const coop::proto::Digest digest = coop::session::sha256(reader->pointer(), size_t(reader->length()));
+	string512 line;
+	xr_sprintf(line, "f|%s|%u|%s\n", item.name.c_str() + walk.prefix.size(), u32(reader->length()),
+		coop_hex(digest).c_str());
+	item.line = line;
+	walk.stats.loose_bytes += u64(reader->length());
+	++walk.stats.loose_files;
+	FS.r_close(reader);
+	return true;
+}
+} // namespace
+
+xr_string coop_hex(const coop::proto::Digest& digest)
+{
+	return xr_string(coop::session::to_hex(digest.data(), digest.size()).c_str());
+}
+
+const coop::proto::Digest& coop_build_id()
+{
+	static coop::proto::Digest id{};
+	static bool parsed = false;
+	if (!parsed)
+	{
+		const bool ok = coop::session::from_hex(COOP_BUILD_ID, id.data(), id.size());
+		R_ASSERT2(ok, "S05-T01: COOP_BUILD_ID is not 64 hex digits");
+		parsed = true;
+	}
+	return id;
+}
+
+bool coop_content_digest(coop::proto::Digest& out, CoopContentStats* stats)
+{
+	if (!g_content_ready)
+	{
+		if (!FS.path_exist("$game_data$"))
+		{
+			Msg("! S05-T01 content digest: no $game_data$ path");
+			return false;
+		}
+		CTimer timer;
+		timer.Start();
+		ContentWalk walk;
+		string_path root;
+		xr_strcpy(root, FS.get_path("$game_data$")->m_Path);
+		xr_strlwr(root);
+		walk.prefix = root;
+		walk.stats = CoopContentStats{};
+		FS.for_each_file(&visit_file, &walk);
+		bool ok = walk.stats.archive_files != 0;
+		xr_string text;
+		text.reserve(walk.entries.size() * 96);
+		for (ContentEntry& item : walk.entries)
+		{
+			if (item.loose && !hash_loose(walk, item))
+				ok = false;
+			text += item.line;
+		}
+		if (!ok)
+		{
+			Msg("! S05-T01 content digest failed: archive_files=%u loose_files=%u", walk.stats.archive_files,
+				walk.stats.loose_files);
+			return false;
+		}
+		g_content = coop::session::sha256(text.data(), text.size());
+		// The hashed listing, for comparing two processes' content.
+		string_path listing;
+		FS.update_path(listing, "$logs$", "coop-content-listing.txt");
+		if (FILE* file = fopen(listing, "wb"))
+		{
+			fwrite(text.data(), 1, text.size(), file);
+			fclose(file);
+		}
+		walk.stats.elapsed_ms = timer.GetElapsed_ms();
+		g_content_stats = walk.stats;
+		g_content_ready = true;
+		Msg("S05-T01 content digest %s archive_files=%u loose_files=%u excluded=%u loose_bytes=%I64u listing_bytes=%u ms=%u",
+			coop_hex(g_content).c_str(), walk.stats.archive_files, walk.stats.loose_files, walk.stats.excluded_files,
+			walk.stats.loose_bytes,
+			u32(text.size()), walk.stats.elapsed_ms);
+	}
+	out = g_content;
+	if (stats)
+		*stats = g_content_stats;
+	return true;
+}
+
+bool coop_local_build(coop::proto::LocalBuild& out)
+{
+	out = coop::proto::LocalBuild{};
+	out.build_id = coop_build_id();
+	return coop_content_digest(out.content_digest);
+}
+} // namespace campaign
diff --git a/src/xrGame/CoopIdentity.h b/src/xrGame/CoopIdentity.h
new file mode 100644
index 0000000..6b1e4ec
--- /dev/null
+++ b/src/xrGame/CoopIdentity.h
@@ -0,0 +1,39 @@
+#pragma once
+
+// S05-T01: the build and content identity a co-op Hello carries
+// (docs/session-authentication.md, "Build and content identity").
+//
+// build_id       SHA-256 computed by tools/Build-Stage2.ps1 over the engine
+//                source pin, every engine-work file that differs from it, the
+//                protocol sources and the protocol major; compiled in through
+//                Coop.props (coop_build_id.h). Both products built from one
+//                tree carry the same id.
+// content_digest SHA-256 over every file this process mounted under
+//                $game_data$, in name order: archive entries by name, size and
+//                the archive's own CRC-32, loose files by name, size and
+//                SHA-256 of their bytes (the MCM options file, a player
+//                setting the scripts rewrite, is left out). Computed from what the process
+//                actually loaded, not from a configuration value.
+
+#include "coop/proto/messages.h"
+
+namespace campaign
+{
+struct CoopContentStats
+{
+	u32 archive_files;
+	u32 loose_files;
+	u32 excluded_files; // player settings files (see CoopIdentity.cpp)
+	u64 loose_bytes;
+	u32 elapsed_ms;
+};
+
+const coop::proto::Digest& coop_build_id();
+// Computes once per process (after the file system is up) and caches.
+bool coop_content_digest(coop::proto::Digest& out, CoopContentStats* stats = nullptr);
+// Both, with the protocol version: what this process puts in its Hello and
+// what a server checks a Hello against.
+bool coop_local_build(coop::proto::LocalBuild& out);
+// Lowercase hex of a digest.
+xr_string coop_hex(const coop::proto::Digest& digest);
+} // namespace campaign
diff --git a/src/xrGame/CoopServerHost.cpp b/src/xrGame/CoopServerHost.cpp
new file mode 100644
index 0000000..b1cd698
--- /dev/null
+++ b/src/xrGame/CoopServerHost.cpp
@@ -0,0 +1,585 @@
+#include "pch_script.h"
+#include "CoopServerHost.h"
+
+// S05-T01: see CoopServerHost.h.
+
+#include "CoopConfig.h"
+#include "CoopIdentity.h"
+#include "CampaignIdentity.h"
+#include "CampaignActorAccess.h"
+#include "Level.h"
+#include "Actor.h"
+#include "ai_space.h"
+#include "alife_simulator.h"
+#include "alife_object_registry.h"
+#include "alife_graph_registry.h"
+#include "alife_time_manager.h"
+#include "level_graph.h"
+#include "script_engine.h"
+#include "ai_object_location.h"
+#include "../xrServerEntities/xrServer_Objects_ALife_Monsters.h"
+#include "../xrEngine/xr_object_list.h"
+
+#include "coop/net/transport.h"
+#include "coop/session/server.h"
+
+#include <memory>
+#include <mmsystem.h>
+
+using namespace campaign;
+
+namespace
+{
+const char* kActorSection = "actor";
+// Registry session numbers for network sessions: never 0 and far from the
+// in-process bridge client's ClientID.
+const u32 kFirstSession = 0x00C00001;
+
+struct PlayerLink
+{
+	coop::proto::Uuid128 player;
+	xr_string name;
+	ParticipantRef ref;
+	bool bound;
+	u32 session; // registry session while attached, else 0
+	u64 join_serial;
+	u32 joins;
+	u32 leaves;
+	u16 pending_actor; // spawned for this participant, not online yet (0xffff: none)
+};
+
+struct Host
+{
+	CoopConfig config;
+	coop::session::Roster roster;
+	bool prepared = false;
+	bool started = false;
+	std::unique_ptr<coop::net::Transport> transport;
+	std::unique_ptr<coop::session::Server> server;
+	CoopEventLog log;
+	std::vector<coop::session::SessionEvent> events;
+	xr_vector<PlayerLink> links; // roster order
+	u32 next_session = kFirstSession;
+	size_t session_log_seen = 0;
+	CTimer wall;
+	u32 last_status_ms = 0;
+	u32 last_stop_check_ms = 0;
+	u64 tick = 0;
+	bool stop_requested = false;
+	// what clients sent
+	u64 intents_refused = 0;
+	u64 inputs_ignored = 0;
+	u64 acks = 0;
+	u64 other_messages = 0;
+	u64 actors_spawned = 0;
+};
+
+Host* g_host = nullptr;
+
+PlayerId player_of(const coop::proto::Uuid128& id)
+{
+	PlayerId p;
+	p.hi = id.hi;
+	p.lo = id.lo;
+	return p;
+}
+
+PlayerLink* link_of(const coop::proto::Uuid128& player)
+{
+	for (PlayerLink& link : g_host->links)
+		if (link.player == player)
+			return &link;
+	return nullptr;
+}
+
+// A level vertex a couple of metres beside the anchor, walkable.
+bool spawn_position(CActor* anchor, u32& vertex, Fvector& position)
+{
+	const CLevelGraph& graph = ai().level_graph();
+	Fvector side;
+	side.setHP(anchor->XFORM().k.getH() + PI_DIV_2, 0.f);
+	for (int attempt = 0; attempt < 4; ++attempt)
+	{
+		Fvector target;
+		target.mad(anchor->Position(), side, 2.f);
+		if (graph.valid_vertex_position(target))
+		{
+			const u32 at = graph.vertex_id(target);
+			if (graph.valid_vertex_id(at) && graph.is_accessible(at))
+			{
+				vertex = at;
+				position = graph.vertex_position(at);
+				return true;
+			}
+		}
+		side.set(-side.z, 0.f, side.x);
+	}
+	vertex = anchor->ai_location().level_vertex_id();
+	if (!graph.valid_vertex_id(vertex))
+		return false;
+	position = graph.vertex_position(vertex);
+	position.x += 1.5f;
+	return true;
+}
+
+// A genuine campaign actor entity from the actor section, created the way
+// CALifeSimulatorBase::spawn_item does, with one difference: the installed
+// se_actor:on_register populates the whole map with the new-game squads
+// (SIMBOARD:fill_start_position) unless the entity's Lua field
+// start_position_filled is set. The saved actor carries it in its state; a
+// participant's new actor joins a running campaign, so it is set before the
+// registration (without it, ~2,700 objects were spawned a second time, coop-8).
+CSE_Abstract* create_participant_actor(const Fvector& position, u32 vertex, GameGraph::_GRAPH_ID graph, bool& marked)
+{
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	CSE_Abstract* abstract = F_entity_Create(kActorSection);
+	if (!abstract)
+		return nullptr;
+	abstract->s_name = kActorSection;
+	abstract->s_RP = 0xff;
+	abstract->ID = alife->server().PerformIDgen(0xffff, abstract);
+	abstract->ID_Parent = 0xffff;
+	abstract->ID_Phantom = 0xffff;
+	abstract->o_Position = position;
+	abstract->m_wVersion = SPAWN_VERSION;
+	string256 name_replace;
+	xr_sprintf(name_replace, "%s%04u", kActorSection, u32(abstract->ID));
+	abstract->set_name_replace(name_replace);
+	CSE_ALifeDynamicObject* dynamic = smart_cast<CSE_ALifeDynamicObject*>(abstract);
+	R_ASSERT(dynamic);
+	dynamic->m_tNodeID = vertex;
+	dynamic->m_tGraphID = graph;
+	dynamic->m_tSpawnID = u16(-1);
+
+	marked = false;
+	if (luabind::wrap_base* wrapper = dynamic_cast<luabind::wrap_base*>(abstract))
+	{
+		lua_State* L = ai().script_engine().lua();
+		const int top = lua_gettop(L);
+		luabind::detail::wrap_access::ref(*wrapper).get(L);
+		if (lua_isuserdata(L, -1) || lua_istable(L, -1))
+		{
+			lua_pushboolean(L, 1);
+			lua_setfield(L, -2, "start_position_filled");
+			lua_getfield(L, -1, "start_position_filled");
+			marked = lua_toboolean(L, -1) != 0;
+		}
+		lua_settop(L, top);
+	}
+
+	alife->register_object(dynamic, true);
+	dynamic->spawn_supplies();
+	dynamic->on_spawn();
+	return abstract;
+}
+
+// A participant who joins with no actor gets a genuine campaign actor from
+// the actor section (the S03-T03 path), assigned to it before it exists.
+void give_actor(PlayerLink& link)
+{
+	Refusal why = Refusal::None;
+	if (CActor* actor = participant_actor(link.ref, &why))
+	{
+		if (link.pending_actor != kNoEngineId)
+		{
+			g_host->log.line("actor-online slot=%u id=%u", u32(link.ref.slot), u32(actor->ID()));
+			link.pending_actor = kNoEngineId;
+		}
+		return;
+	}
+	const ParticipantRef& ref = link.ref;
+	// The ALife switch brings a new actor online a few hundred ms after the
+	// spawn; until then it is pending, not missing.
+	if (link.pending_actor != kNoEngineId)
+	{
+		if (ai().get_alife() && ai().alife().objects().object(link.pending_actor, true))
+			return;
+		g_host->log.line("actor-pending-lost slot=%u id=%u", u32(ref.slot), u32(link.pending_actor));
+		link.pending_actor = kNoEngineId;
+	}
+	xr_vector<CActor*> actors;
+	participant_actors(actors);
+	const CSE_ALifeCreatureActor* se_actor = ai().get_alife() ? ai().alife().graph().actor() : nullptr;
+	if (actors.empty() || !se_actor)
+	{
+		g_host->log.line("actor-spawn-deferred slot=%u reason=no-anchor", u32(ref.slot));
+		return;
+	}
+	u32 vertex = u32(-1);
+	Fvector position;
+	if (!spawn_position(actors.front(), vertex, position))
+	{
+		g_host->log.line("actor-spawn-failed slot=%u reason=no-vertex", u32(ref.slot));
+		return;
+	}
+	const u32 objects_before = u32(ai().alife().objects().objects().size());
+	bool marked = false;
+	CSE_Abstract* entity = create_participant_actor(position, vertex, se_actor->m_tGraphID, marked);
+	if (!entity || !smart_cast<CSE_ALifeCreatureActor*>(entity))
+	{
+		g_host->log.line("actor-spawn-failed slot=%u reason=spawn", u32(ref.slot));
+		return;
+	}
+	const Refusal assigned = assign_participant_actor(ref, entity->ID);
+	link.pending_actor = entity->ID;
+	++g_host->actors_spawned;
+	g_host->log.line("actor-spawned slot=%u generation=%u id=%u pos=%.2f,%.2f,%.2f assign=%s start_position_filled=%d "
+		"alife_objects_added=%d",
+		u32(ref.slot), ref.generation, u32(entity->ID), VPUSH(position), refusal_name(assigned), marked ? 1 : 0,
+		int(ai().alife().objects().objects().size()) - int(objects_before));
+}
+
+void on_joined(const coop::session::SessionEvent& e)
+{
+	PlayerLink* link = link_of(e.player);
+	if (!link || !link->bound)
+	{
+		// The session layer only admits roster players, and every roster
+		// player was bound before the level; anything else is a defect.
+		g_host->log.line("joined-unbound player=%s", coop_uuid_hex(e.player).c_str());
+		return;
+	}
+	const ServerAuthority* authority = g_campaign_identity->authority();
+	if (link->session)
+	{
+		// A replacing connection (S04-T05): the old session ends first.
+		g_campaign_identity->detach_session(authority, link->session, Device.dwFrame);
+		link->session = 0;
+	}
+	const u32 session = g_host->next_session++;
+	const Refusal attached = g_campaign_identity->attach_session(authority, link->ref, session, Device.dwFrame);
+	if (attached == Refusal::None)
+		link->session = session;
+	link->join_serial = e.join_serial;
+	++link->joins;
+	g_host->log.line("joined player=%s name=%s session_slot=%u participant=%u/%u registry_session=%08x resumed=%d "
+		"attach=%s",
+		coop_uuid_hex(e.player).c_str(), link->name.c_str(), u32(e.slot), u32(link->ref.slot), link->ref.generation,
+		session, e.resumed ? 1 : 0, refusal_name(attached));
+	give_actor(*link);
+}
+
+void on_left(const coop::session::SessionEvent& e)
+{
+	PlayerLink* link = link_of(e.player);
+	if (!link)
+		return;
+	++link->leaves;
+	Refusal detached = Refusal::NotAttached;
+	if (link->session)
+		detached = g_campaign_identity->detach_session(g_campaign_identity->authority(), link->session, Device.dwFrame);
+	link->session = 0;
+	// Detached-actor policy: the actor stays, vulnerable, and moves only by
+	// input, which arrives only on an attached session.
+	CActor* actor = participant_actor(link->ref);
+	g_host->log.line("left player=%s participant=%u/%u reason=%u detail=%s detach=%s actor=%u actor_alive=%d",
+		coop_uuid_hex(e.player).c_str(), u32(link->ref.slot), link->ref.generation, u32(e.reason), e.detail.c_str(),
+		refusal_name(detached), actor ? u32(actor->ID()) : 0xffffu, actor && actor->g_Alive() ? 1 : 0);
+}
+
+void on_released(const coop::session::SessionEvent& e)
+{
+	PlayerLink* link = link_of(e.player);
+	if (!link)
+		return;
+	const Refusal released =
+		g_campaign_identity->release_participant(g_campaign_identity->authority(), link->ref, Device.dwFrame);
+	link->bound = false;
+	g_host->log.line("released player=%s participant=%u/%u release=%s", coop_uuid_hex(e.player).c_str(),
+		u32(link->ref.slot), link->ref.generation, refusal_name(released));
+}
+
+void on_message(const coop::session::SessionEvent& e)
+{
+	PlayerLink* link = link_of(e.player);
+	if (!link || e.join_serial != link->join_serial)
+	{
+		++g_host->other_messages;
+		return; // from a replaced connection
+	}
+	if (const auto* intent = std::get_if<coop::proto::ActionIntent>(&e.message.body))
+	{
+		// No action kind is defined yet (S06/S08 add them); every intent is
+		// refused, and nothing in the world changes.
+		coop::proto::ActionResult result;
+		result.operation_id = intent->operation_id;
+		result.outcome = coop::proto::ActionOutcome::Rejected;
+		result.reason = 1; // unsupported kind
+		result.server_tick = g_host->tick;
+		g_host->server->send(e.player, coop::proto::Message(result));
+		++g_host->intents_refused;
+		g_host->log.line("intent-refused player=%s operation=%I64u kind=%u target=%I64u/%u reason=unsupported",
+			coop_uuid_hex(e.player).c_str(), intent->operation_id, u32(intent->kind), intent->target.id,
+			intent->target.generation);
+		return;
+	}
+	if (std::get_if<coop::proto::InputBatch>(&e.message.body))
+	{
+		++g_host->inputs_ignored; // S05-T03 applies them
+		return;
+	}
+	if (std::get_if<coop::proto::SnapshotAck>(&e.message.body))
+	{
+		++g_host->acks;
+		return;
+	}
+	++g_host->other_messages;
+}
+
+void drain_session_log()
+{
+	const std::vector<std::string>& lines = g_host->server->log();
+	for (; g_host->session_log_seen < lines.size(); ++g_host->session_log_seen)
+		g_host->log.line("session %s", lines[g_host->session_log_seen].c_str());
+}
+
+// What the server simulates, every few seconds: the evidence that it
+// advances the world with or without clients.
+void log_status(LPCSTR tag)
+{
+	u64 game_ms = 0;
+	u32 alife_objects = 0;
+	if (ai().get_alife())
+	{
+		game_ms = ai().alife().time_manager().game_time();
+		alife_objects = u32(ai().alife().objects().objects().size());
+	}
+	string1024 participants = "";
+	for (const PlayerLink& link : g_host->links)
+	{
+		const Participant* p = nullptr;
+		LPCSTR state = "unbound";
+		if (link.bound && g_campaign_identity->participant(link.ref, p) == Refusal::None)
+			state = participant_state_name(p->state);
+		CActor* actor = link.bound ? participant_actor(link.ref) : nullptr;
+		string256 one;
+		if (actor)
+			xr_sprintf(one, " p%u=%s,actor=%u,pos=%.2f/%.2f/%.2f,health=%.3f", u32(link.ref.slot), state,
+				u32(actor->ID()), VPUSH(actor->Position()), actor->GetfHealth());
+		else
+			xr_sprintf(one, " p%u=%s,actor=none", u32(link.ref.slot), state);
+		xr_strcat(participants, one);
+	}
+	const coop::session::ServerCounters& c = g_host->server->counters();
+	g_host->log.line("%s tick=%I64u frame=%u game_ms=%I64u alife_objects=%u online_objects=%u%s joins=%I64u "
+		"violations=%I64u rejected_auth=%I64u rejected_build=%I64u rejected_content=%I64u intents_refused=%I64u "
+		"inputs=%I64u acks=%I64u",
+		tag, g_host->tick, Device.dwFrame, game_ms, alife_objects, u32(Level().Objects.o_count()), participants,
+		c.joins, c.violations, c.rejected_auth, c.rejected_build, c.rejected_content, g_host->intents_refused,
+		g_host->inputs_ignored, g_host->acks);
+}
+
+// S04-T01 finding 5: Windows power throttling stretches Sleep-paced loops
+// of a background process. The server opts out and asks for 1 ms timers.
+void disable_power_throttling()
+{
+	struct ThrottlingState
+	{
+		ULONG Version;
+		ULONG ControlMask;
+		ULONG StateMask;
+	};
+	typedef BOOL(WINAPI * SetProcessInformationFn)(HANDLE, int, LPVOID, DWORD);
+	const int kProcessPowerThrottling = 4; // PROCESS_INFORMATION_CLASS ProcessPowerThrottling
+	ThrottlingState state = {1, 0x1 /* EXECUTION_SPEED */, 0 /* off */};
+	SetProcessInformationFn set = reinterpret_cast<SetProcessInformationFn>(
+		GetProcAddress(GetModuleHandleA("kernel32.dll"), "SetProcessInformation"));
+	const BOOL throttling_off = set ? set(GetCurrentProcess(), kProcessPowerThrottling, &state, sizeof(state)) : FALSE;
+	const MMRESULT period = timeBeginPeriod(1);
+	g_host->log.line("power-throttling-off=%d timer-period-1ms=%d", throttling_off ? 1 : 0,
+		period == TIMERR_NOERROR ? 1 : 0);
+}
+} // namespace
+
+namespace campaign
+{
+bool coop_server_prepare(LPCSTR command_line)
+{
+	R_ASSERT(!g_host);
+	string_path path;
+	if (!coop_config_path(command_line, path))
+	{
+		Msg("! S05-T01 -campaign-serve needs -coop-config <absolute path>");
+		return false;
+	}
+	g_host = xr_new<Host>();
+	if (!coop_config_load(path, g_host->config) || !g_host->config.server)
+	{
+		Msg("! S05-T01 the server needs a [coop] role=server profile");
+		return false;
+	}
+	std::string error;
+	if (!g_host->roster.load(g_host->config.roster_path, &error) || g_host->roster.size() == 0)
+	{
+		Msg("! S05-T01 roster %s: %s", g_host->config.roster_path, error.empty() ? "empty" : error.c_str());
+		return false;
+	}
+	if (!g_host->log.open(g_host->config.log_path))
+	{
+		Msg("! S05-T01 cannot open the co-op log %s", g_host->config.log_path);
+		return false;
+	}
+	for (const coop::session::RosterEntry& entry : g_host->roster.entries())
+	{
+		PlayerLink link = {};
+		link.pending_actor = kNoEngineId;
+		link.player = entry.player_id;
+		link.name = entry.display_name.c_str();
+		g_host->links.push_back(link);
+	}
+	// Before any script runs: scripts rewrite files under gamedata.
+	coop::proto::Digest content;
+	if (!coop_content_digest(content))
+		return false;
+	g_host->log.line("server-prepared campaign=%s party=%s roster_players=%u listen=%s save=%s",
+		coop_uuid_hex(g_host->config.campaign_id).c_str(), coop_uuid_hex(g_host->config.party_id).c_str(),
+		u32(g_host->links.size()), g_host->config.listen, g_host->config.save_name);
+	g_host->prepared = true;
+	return true;
+}
+
+bool coop_server_prepared() { return g_host && g_host->prepared; }
+
+bool coop_server_bind_roster(CampaignIdentityRegistry& registry)
+{
+	if (!coop_server_prepared())
+		return false;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	bool ok = true;
+	for (PlayerLink& link : g_host->links)
+	{
+		if (u32(&link - &g_host->links.front()) >= registry.active_slots())
+		{
+			g_host->log.line("bind-skipped player=%s reason=more-roster-players-than-slots",
+				coop_uuid_hex(link.player).c_str());
+			continue;
+		}
+		const Refusal bound = registry.bind_participant(registry.authority(), player_of(link.player), party, 0, link.ref);
+		link.bound = bound == Refusal::None;
+		ok = ok && link.bound;
+		g_host->log.line("bound player=%s name=%s participant=%u/%u bind=%s", coop_uuid_hex(link.player).c_str(),
+			link.name.c_str(), u32(link.ref.slot), link.ref.generation, refusal_name(bound));
+	}
+	return ok;
+}
+} // namespace campaign
+
+extern "C" bool __cdecl xrCoopServer_Prepare(LPCSTR command_line) { return coop_server_prepare(command_line); }
+
+extern "C" LPCSTR __cdecl xrCoopServer_SaveName() { return coop_server_prepared() ? g_host->config.save_name : ""; }
+
+extern "C" bool __cdecl xrCoopServer_Start()
+{
+	if (!coop_server_prepared() || g_host->started)
+		return false;
+	coop::session::ServerConfig config;
+	if (!coop_local_build(config.build))
+		return false;
+	config.campaign_id = g_host->config.campaign_id;
+	config.party_id = g_host->config.party_id;
+	config.max_players = 2;
+	config.authority_epoch = 1;
+	config.tick_rate_hz = u16(_max(1u, 1000u / _max(1u, Device.dwTimeDelta ? Device.dwTimeDelta : 20u)));
+	config.snapshot_rate_hz = u16(_min<u32>(20u, config.tick_rate_hz));
+	std::string error;
+	g_host->transport = coop::net::create_gns_transport(coop::session::transport_config(config.liveness), &error);
+	if (!g_host->transport)
+	{
+		g_host->log.line("transport-failed %s", error.c_str());
+		return false;
+	}
+	if (!g_host->transport->listen(g_host->config.listen, &error))
+	{
+		g_host->log.line("listen-failed %s %s", g_host->config.listen, error.c_str());
+		g_host->transport.reset();
+		return false;
+	}
+	g_host->server = std::make_unique<coop::session::Server>(*g_host->transport, config, g_host->roster);
+	disable_power_throttling();
+	g_host->wall.Start();
+	g_host->started = true;
+	g_host->log.line("server-listening address=%s build=%s content=%s protocol=%u.%u tick_hz=%u snapshot_hz=%u",
+		g_host->config.listen, coop_hex(config.build.build_id).c_str(), coop_hex(config.build.content_digest).c_str(),
+		u32(config.build.major), u32(config.build.minor), u32(config.tick_rate_hz), u32(config.snapshot_rate_hz));
+	log_status("status");
+	return true;
+}
+
+// Once per tick, before the tick's simulation: network input reaches the
+// world here and nowhere else.
+extern "C" void __cdecl xrCoopServer_Tick(u64 tick)
+{
+	if (!g_host || !g_host->started)
+		return;
+	g_host->tick = tick;
+	g_host->events.clear();
+	g_host->server->update(g_host->events);
+	for (const coop::session::SessionEvent& e : g_host->events)
+	{
+		switch (e.type)
+		{
+		case coop::session::SessionEventType::Joined: on_joined(e); break;
+		case coop::session::SessionEventType::Left: on_left(e); break;
+		case coop::session::SessionEventType::Released: on_released(e); break;
+		case coop::session::SessionEventType::Message: on_message(e); break;
+		case coop::session::SessionEventType::Suspect:
+			g_host->log.line("suspect player=%s", coop_uuid_hex(e.player).c_str());
+			break;
+		case coop::session::SessionEventType::Recovered:
+			g_host->log.line("recovered player=%s", coop_uuid_hex(e.player).c_str());
+			break;
+		}
+	}
+	drain_session_log();
+	// a participant whose actor could not be spawned at its join gets one
+	// as soon as there is an anchor
+	for (PlayerLink& link : g_host->links)
+		if (link.session && (link.pending_actor != kNoEngineId || !participant_actor(link.ref)))
+			give_actor(link);
+	const u32 now = g_host->wall.GetElapsed_ms();
+	if (now - g_host->last_status_ms >= 5000)
+	{
+		g_host->last_status_ms = now;
+		log_status("status");
+	}
+	if (now - g_host->last_stop_check_ms >= 500)
+	{
+		g_host->last_stop_check_ms = now;
+		if (coop_file_exists(g_host->config.stop_file))
+		{
+			g_host->stop_requested = true;
+			g_host->log.line("stop-file-seen");
+		}
+		if (g_host->config.serve_seconds && now >= g_host->config.serve_seconds * 1000)
+		{
+			g_host->stop_requested = true;
+			g_host->log.line("serve-time-elapsed seconds=%u", g_host->config.serve_seconds);
+		}
+	}
+}
+
+extern "C" bool __cdecl xrCoopServer_ShouldStop() { return !g_host || !g_host->started || g_host->stop_requested; }
+
+extern "C" void __cdecl xrCoopServer_Stop()
+{
+	if (!g_host)
+		return;
+	if (g_host->started)
+	{
+		log_status("final");
+		g_host->events.clear();
+		g_host->server->shutdown(1000, g_host->events);
+		for (const coop::session::SessionEvent& e : g_host->events)
+			if (e.type == coop::session::SessionEventType::Left)
+				on_left(e);
+		drain_session_log();
+		g_host->server.reset();
+		g_host->transport.reset();
+		timeEndPeriod(1);
+		g_host->log.line("server-stopped");
+	}
+	g_host->log.close();
+	xr_delete(g_host);
+}
diff --git a/src/xrGame/CoopServerHost.h b/src/xrGame/CoopServerHost.h
new file mode 100644
index 0000000..e62d2ff
--- /dev/null
+++ b/src/xrGame/CoopServerHost.h
@@ -0,0 +1,33 @@
+#pragma once
+
+// S05-T01: the campaign server's network host. It owns the co-op transport
+// (GameNetworkingSockets behind coop::net) and the session server
+// (coop::session::Server, S04-T04/T05) on the simulation thread, and turns
+// session events into participant changes in the identity registry:
+//
+//   Joined   -> attach_session (the roster bound every player to a slot
+//               before the level loaded); a participant with no actor gets
+//               one, spawned beside another participant's actor
+//   Left     -> detach_session; the actor stays in the world, vulnerable,
+//               with no input (the detached-actor policy)
+//   Released -> release_participant (only with release_after_ms)
+//   Message  -> client intents only. No client message is an outcome: the
+//               decoder refuses server-only types before they get here, and
+//               every action kind is refused until a later task defines it.
+//
+// Network input reaches the world only from coop_server_tick(), which the
+// serve loop calls once before each simulation tick (D6, S04-T02).
+
+namespace campaign
+{
+class CampaignIdentityRegistry;
+
+// Before the services start: reads the profile and the roster. False when
+// the command line asks for -campaign-serve without a usable profile.
+bool coop_server_prepare(LPCSTR command_line);
+bool coop_server_prepared();
+// Called by the identity service in place of the fixture binding: binds the
+// roster's players to participant slots in roster order, so the saved actor
+// is adopted by the first roster player at its spawn.
+bool coop_server_bind_roster(CampaignIdentityRegistry& registry);
+} // namespace campaign
