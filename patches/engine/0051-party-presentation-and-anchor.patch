+	payload.push_back(0);
+	u64 hash = 14695981039346656037ull;
+	for (const Host::PartyTask& t : g_host->party_tasks)
+	{
+		CGameTask* gt = Level().GameTaskManager().HasGameTask(shared_str(t.id.c_str()), false);
+		const u8 state = gt && gt->GetTaskState() == eTaskStateCompleted ? 2 :
+			gt && gt->GetTaskState() == eTaskStateFail ? 0 : 1;
+		put_party_task(payload, t.id.c_str(), state, t.count, t.need);
+		++n;
+		hash = fnv1a(fnv1a(fnv1a(hash, t.instance), u64(state) | (u64(u32(t.count)) << 8)), u64(u32(t.need)));
+		if (gt)
+			for (const char* c = gt->m_Title.c_str(); c && *c; ++c)
+				hash = fnv1a(hash, u64(u8(*c)));
+	}
+	for (const Host::PartyFinished& f : g_host->party_finished)
+	{
+		put_party_task(payload, f.id.c_str(), f.state, f.count, f.need);
+		++n;
+		hash = fnv1a(fnv1a(hash, f.instance), 0x100 | f.state);
+	}
+	payload[0] = n;
+	const bool changed = hash != g_host->party_hash;
+	if (changed && n)
+	{
+		g_host->party_hash = hash;
+		broadcast_event(11, payload);
+		g_host->log.line("party-tasks-sent tasks=%u finished=%u hash=%016I64x", u32(n),
+			u32(g_host->party_finished.size()), hash);
+	}
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!client_in_world(link))
+		{
+			link.party_sent = false;
+			continue;
+		}
+		if (link.party_sent)
+			continue;
+		link.party_sent = true;
+		if (n && !changed) // (a change was just broadcast to it)
+		{
+			queue_event(link, 11, payload);
+			g_host->log.line("party-tasks-joined to=%u tasks=%u", u32(link.ref.slot), u32(n));
+		}
+		// the scripts' current map spots (a spot added while this client loaded
+		// its world is not in its checkpoint)
+		xr_vector<campaign::MapSpotState> spots;
+		campaign::map_spots(spots);
+		for (const campaign::MapSpotState& m : spots)
+		{
+			std::vector<u8> p;
+			put_u8(p, u8(campaign::Presentation::MapSpotAdd));
+			put_u16(p, m.object);
+			put_u32(p, 0);
+			put_f32(p, 0.f);
+			put_f32(p, 0.f);
+			put_f32(p, 0.f);
+			put_f32(p, 0.f);
+			put_u32(p, m.flags);
+			put_u32(p, 0);
+			put_str(p, m.detail.c_str());
+			queue_event(link, kEventPresentation, p);
+		}
+		if (!spots.empty())
+			g_host->log.line("map-spots-joined to=%u spots=%u", u32(link.ref.slot), u32(spots.size()));
+	}
+}
