+// ------------------------------------------------------------ S06-T03
+// The view's side of a correction: the actor's collision state takes the
+// correction at once; the camera keeps minus it and glides over (Smoother).
+const ECamEffectorType kCoopViewEffector = ECamEffectorType(cefNext + 40);
+
+class CoopViewEffector : public CEffectorCam
+{
+public:
+	CoopViewEffector() : CEffectorCam(kCoopViewEffector, 1000000.f) {}
+	BOOL ProcessCam(SCamEffectorInfo& info) override
+	{
+		if (!g_link || !g_link->predicting)
+			return TRUE;
+		const coop::proto::Vec3 o = g_link->smoother.step(Device.fTimeDelta * 1000.f);
+		if (o.x != 0.f || o.y != 0.f || o.z != 0.f)
+		{
+			info.p.x += o.x;
+			info.p.y += o.y;
+			info.p.z += o.z;
+			++g_link->correction_frames;
+		}
+		return TRUE;
+	}
+};
+
+void prediction_begin()
+{
+	g_link->reconciler.reset();
+	g_link->smoother.clear();
+	g_link->reconciled_snapshot = 0;
+	g_link->predicting = g_link->config.predict != 0 && g_actor;
+	campaign::replica_set_predicting(g_link->predicting);
+	if (g_link->predicting && !g_actor->Cameras().GetCamEffector(kCoopViewEffector))
+		g_actor->Cameras().AddCamEffector(xr_new<CoopViewEffector>());
+	if (g_link->predicting && !g_link->prediction_csv)
+	{
+		string_path path;
+		FS.update_path(path, "$logs$", "coop-prediction.csv");
+		g_link->prediction_csv = fopen(path, "w");
+		if (g_link->prediction_csv)
+			fprintf(g_link->prediction_csv, "utc_ms,snapshot,last_input,kind,error,ox,oy,oz,x,y,z,sx,sy,sz\n");
+	}
+	g_link->log.line("prediction %s", g_link->predicting ? "on" : "off");
+}
+
+// After a complete snapshot: the server's position for the own actor (in the
+// snapshot's frame, changed or not) against where the actor was when it
+// sampled the last input the server consumed.
+void reconcile_own_actor(u64 snapshot_id, u64 last_input)
+{
+	if (!g_link->predicting || !g_actor || !last_input || snapshot_id <= g_link->reconciled_snapshot)
+		return;
+	g_link->reconciled_snapshot = snapshot_id;
+	const coop::proto::SnapshotFrame* frame = g_link->receiver.frame(snapshot_id);
+	const auto ref = g_link->refs.find(u16(g_actor->ID()));
+	if (!frame || ref == g_link->refs.end())
+		return;
+	const auto it = frame->find(ref->second.id);
+	if (it == frame->end() || !(it->second.entity == ref->second))
+		return;
+	const coop::proto::Vec3 server{it->second.transform.x, it->second.transform.y, it->second.transform.z};
+	const coop::proto::Correction c = g_link->reconciler.reconcile(last_input, server);
+	if (c.kind == coop::proto::CorrectionKind::Smooth || c.kind == coop::proto::CorrectionKind::Snap)
+	{
+		Fvector p = g_actor->Position();
+		p.x += c.offset.x;
+		p.y += c.offset.y;
+		p.z += c.offset.z;
+		if (g_actor->character_physics_support()->movement()->CharacterExist())
+			g_actor->character_physics_support()->movement()->SetPosition(p);
+		g_actor->Position().set(p);
+		if (c.kind == coop::proto::CorrectionKind::Smooth)
+			g_link->smoother.add(c.offset);
+		else
+			g_link->smoother.clear();
+	}
+	if (g_link->prediction_csv && c.kind != coop::proto::CorrectionKind::Unknown)
+		fprintf(g_link->prediction_csv, "%I64u,%I64u,%I64u,%u,%.4f,%.4f,%.4f,%.4f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f\n",
+			utc_now_ms(), snapshot_id, last_input, u32(c.kind), c.error, c.offset.x, c.offset.y, c.offset.z,
+			VPUSH(g_actor->Position()), server.x, server.y, server.z);
+}
