+u16 take_trade_close(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	trade_close(link, "client");
+	result.revision = g_host->commit;
+	return 0;
+}
