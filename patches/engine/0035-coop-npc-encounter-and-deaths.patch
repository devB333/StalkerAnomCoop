+// S06-T05 fixtures (profile encounter, lethal) and the encounter record.
+// encounter: seconds after both participants' clients send input, a boar (the S02-T06c
+// monster) is spawned 8-12 m from participant 2's actor, away from Fanat (the
+// companion at the base) and participant 1, the way a script spawns one; the
+// native AI picks its enemy. lethal: seconds after the boar died, participant 2's actor
+// takes a lethal wound hit from the boar through the host's event loop (the
+// S03-T03 hit), unless it is dead already; 60 s after the spawn if the boar
+// still lives.
+const u16 kFanat = 19409;
+
+// A reachable node 8-12 m from `actor` in one of 8 directions, the one
+// farthest (on the ground plane) from Fanat and from `other`. A point straight
+// away from Fanat can be off the level graph: in enc-12 participant 2 stood at
+// the level's edge and the fallback put the boar between it and Fanat, who
+// killed it.
+bool encounter_vertex(CActor* actor, CActor* other, u32& vertex, Fvector& position)
+{
+	const CLevelGraph& graph = ai().level_graph();
+	const CObject* fanat = Level().Objects.net_Find(kFanat);
+	float best = -1.f;
+	for (int dir = 0; dir < 8; ++dir)
+	{
+		const float angle = PI_MUL_2 * float(dir) / 8.f;
+		Fvector step;
+		step.set(_cos(angle), 0.f, _sin(angle));
+		for (float distance = 12.f; distance >= 8.f; distance -= 2.f)
+		{
+			Fvector target;
+			target.mad(actor->Position(), step, distance);
+			if (!graph.valid_vertex_position(target))
+				continue;
+			const u32 at = graph.vertex_id(target);
+			if (!graph.valid_vertex_id(at) || !graph.is_accessible(at))
+				continue;
+			const Fvector at_pos = graph.vertex_position(at);
+			float score = flt_max;
+			if (fanat)
+				score = _min(score, at_pos.distance_to_xz(fanat->Position()));
+			if (other)
+				score = _min(score, at_pos.distance_to_xz(other->Position()));
+			if (score > best)
+			{
+				best = score;
+				vertex = at;
+				position = at_pos;
+			}
+			break;
+		}
+	}
+	if (best >= 0.f)
+		return true;
+	return ActivityFixtureChooseVertex(actor->ai_location().level_vertex_id(), 12.f, vertex, position);
+}
