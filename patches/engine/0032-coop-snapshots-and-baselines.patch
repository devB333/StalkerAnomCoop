+void CCustomMonster::replica_present(const Fvector& position, float yaw, const Fvector& velocity)
+{
+	if (!_valid(position) || !_valid(yaw))
+		return;
+	net_update N;
+	N.dwTimeStamp = Level().timeServer();
+	N.o_model = yaw;
+	N.o_torso.yaw = yaw;
+	N.o_torso.pitch = 0.f;
+	N.p_pos = position;
+	N.fHealth = GetfHealth();
+	// One update: UpdateCL takes it as the newest (no interpolation of its
+	// own; the co-op link interpolates by server time) and places the body.
+	NET.clear();
+	NET.push_back(N);
+	NET_Last = N;
+	if (character_physics_support() && character_physics_support()->movement()->CharacterExist())
+	{
+		character_physics_support()->movement()->SetPosition(position);
+		character_physics_support()->movement()->SetVelocity(velocity);
+	}
+	// UpdateCL runs only for objects drawn recently (the object list's
+	// "crows"): one parked off-screen would never move into view. The body
+	// is placed here as UpdateCL would place it, and the spatial index
+	// follows, so it is drawn where the server has it.
+	if (g_Alive())
+	{
+		Fmatrix xform;
+		xform.rotateY(yaw);
+		xform.c.set(position);
+		XFORM().set(xform);
+		spatial_move();
+	}
+}
