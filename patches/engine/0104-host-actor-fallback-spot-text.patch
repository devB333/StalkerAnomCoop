diff --git a/src/xrGame/level_script.cpp b/src/xrGame/level_script.cpp
index 802658f..4a7d3f7 100644
--- a/src/xrGame/level_script.cpp
+++ b/src/xrGame/level_script.cpp
@@ -450,20 +450,31 @@ static void present_map_spot(campaign::Presentation kind, u16 id, LPCSTR spot_ty
 {
 	if (campaign::process_role() != campaign::Role::Server)
 		return;
+	// B42: a long hint (a stash's) is cut, not fatal (xr_sprintf asserts on
+	// overflow); the place suffix below is kept whole within the record's 128
 	string128 detail;
-	xr_sprintf(detail, "%s|%s", spot_type ? spot_type : "", text ? text : "");
+	_snprintf_s(detail, sizeof(detail), _TRUNCATE, "%s|%s", spot_type ? spot_type : "", text ? text : "");
 	campaign::PresentationArgs args;
 	args.flags = flags;
 	// S10-T07 (B2): the object's place, for a client that does not hold it
 	// ("<spot>|<hint>\t<level>\t<graph>"); the stored state keeps "<spot>|<hint>"
-	string256 sent;
-	xr_strcpy(sent, detail);
+	string128 sent;
+	strncpy_s(sent, sizeof(sent), detail, _TRUNCATE);
 	if (kind == campaign::Presentation::MapSpotAdd)
 	{
 		xr_string level;
 		u16 graph;
 		if (campaign::object_map_place(id, args.position, level, graph))
-			xr_sprintf(sent, "%s\t%s\t%u", detail, level.c_str(), u32(graph));
+		{
+			string64 suffix;
+			_snprintf_s(suffix, sizeof(suffix), _TRUNCATE, "\t%s\t%u", level.c_str(), u32(graph));
+			const size_t room = sizeof(sent) - 1 - xr_strlen(suffix);
+			string128 head;
+			strncpy_s(head, sizeof(head), detail, _TRUNCATE);
+			if (xr_strlen(head) > room)
+				head[room] = 0;
+			_snprintf_s(sent, sizeof(sent), _TRUNCATE, "%s%s", head, suffix);
+		}
 	}
 	campaign::present_broadcast(kind, id, sent, args);
 	campaign::note_map_spot(kind, id, spot_type ? spot_type : "", detail, flags);
