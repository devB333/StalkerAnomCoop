+// S10-T07 (B1, part 4): the installed Lua trade window (ui_inventory.script)
+// showed no portrait or name for Sidorovich. Its Reset shows the partner panel
+// for a stalker or a trader named esc_m_trader (the client's checkpoint has
+// that name for id 15398), and UpdateCharacter fills it on its next info
+// update, where an error would end the update without a log line. Right after
+// the window opens this shows the panel for a trading partner if it is
+// hidden, fills it under pcall, and reports what it found (the trade-open
+// line's panel=), so a still-empty panel names its cause.
+xr_string trade_panel_probe()
+{
+	LPCSTR chunk =
+		"local ok, r = pcall(function()\n"
+		"  local g = ui_inventory and ui_inventory.GUI\n"
+		"  if not (g and g:IsShown()) then return 'gui=0' end\n"
+		"  local o = g:GetPartner()\n"
+		"  if not o then return 'gui=1 partner=0' end\n"
+		"  local shown = g.npc_name:IsShown()\n"
+		"  local fixed = 0\n"
+		"  if g.mode == 'trade' and not shown and not g.npc_is_box then\n"
+		"    g.npc_name:Show(true) g.npc_community:Show(true) g.npc_icon:Show(true) fixed = 1\n"
+		"  end\n"
+		"  local uok, uerr = pcall(function() g:UpdateCharacter() end)\n"
+		"  return string.format('gui=1 mode=%s obj=%s clsid=%s stalker=%s not_npc=%s shown=%s fixed=%d update=%s "
+		"icon=%s cname=%s', tostring(g.mode), tostring(o:name()), tostring(o:clsid()), tostring(IsStalker(o)), "
+		"tostring(g.npc_is_not_npc), tostring(shown), fixed, uok and 'ok' or tostring(uerr), "
+		"tostring(o:character_icon()), tostring(o:character_name()))\n"
+		"end)\n"
+		"return ok and r or ('error ' .. tostring(r))";
+	xr_string result = "lua=0";
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return result;
+	if (luaL_loadbuffer(L, chunk, xr_strlen(chunk), "coop_trade_panel") != 0)
+	{
+		result = "load-failed";
+		lua_pop(L, 1);
+		return result;
+	}
+	if (lua_pcall(L, 0, 1, 0) != 0)
+		result = "call-failed";
+	else if (LPCSTR text = lua_tostring(L, -1))
+		result = text;
+	lua_pop(L, 1);
+	return result;
+}
