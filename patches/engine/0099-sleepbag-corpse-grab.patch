diff --git a/src/xrPhysics/PHCaptureInit.cpp b/src/xrPhysics/PHCaptureInit.cpp
index 9f321b8..7360362 100644
--- a/src/xrPhysics/PHCaptureInit.cpp
+++ b/src/xrPhysics/PHCaptureInit.cpp
@@ -183,6 +183,23 @@ CPHCapture::CPHCapture(CPHCharacter* a_character, IPhysicsShellHolder* a_taget_o
 	VERIFY(tag_bone.callback_param( ));
 
 	m_taget_element = (CPhysicsElement*)tag_bone.callback_param();
+	// co-op (B33): a dead player's body (an actor: never grabbable in single
+	// player) keeps the actor's own bone callbacks on its spine, shoulder and
+	// head (Actor_Network.cpp SetCallbacks: the parameter is the actor), so
+	// the parameter is taken only when it is one of the shell's elements
+	CPhysicsShell* shell = m_taget_object->ObjectPPhysicsShell();
+	bool element_of_shell = false;
+	if (shell)
+		for (u16 i = 0, n = shell->get_ElementsNumber(); i < n && !element_of_shell; ++i)
+			element_of_shell = shell->get_ElementByStoreOrder(i) == m_taget_element;
+	if (!element_of_shell)
+	{
+		m_taget_element = shell ? shell->get_Element(a_taget_element) : 0;
+		if (!m_taget_element && shell)
+			m_taget_element = shell->NearestToPoint(m_capture_bone->mTransform.c);
+		if (!m_taget_element)
+			return;
+	}
 	VERIFY(m_taget_element);
 
 	Init();
