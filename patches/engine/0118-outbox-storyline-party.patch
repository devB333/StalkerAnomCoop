+// B61: the DoctorX storyline's own dialogue actions (dialogs.drx_sl_*,
+// xr_effects.drx_sl_*: its give, the meet tasks, the task count) run in the
+// party anchor's context (the storyline's variables live with the host
+// actor, T05c-1), with the talking player's arguments order; what they give
+// becomes the party's
+static bool story_action(LPCSTR action)
+{
+	return strstr(action, "dialogs.drx_sl_") == action || strstr(action, "xr_effects.drx_sl_") == action;
+}
+
+static bool story_finish_action(LPCSTR action, bool& cf)
+{
+	cf = !xr_strcmp(action, "dialogs.drx_sl_set_finished_cf_task_complete");
+	return cf || !xr_strcmp(action, "dialogs.drx_sl_set_finished_task_complete") ||
+		!xr_strcmp(action, "dialogs.drx_sl_set_finished_task_complete_endgame");
+}
+
+// B61: the storyline's finish (drx_sl_task_completed_dialog) completes its
+// task natively, which B62 turns into the party's completion (both paid) if
+// the task is the party's: a finished storyline task given before (an older
+// save, or outside the party) is taken into the party first. Found as its
+// dialogue does, in the anchor's context.
+static void adopt_story_finished(PlayerLink& link, CGameObject* npc, CActor* anchor, bool cf)
+{
+	string128 task = "";
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(anchor), "party-story-finished");
+		luabind::functor<luabind::object> find;
+		if (scope.entered() && ai().script_engine().functor(cf ? "axr_task_manager.drx_sl_get_finished_cf_task" :
+				"axr_task_manager.drx_sl_get_finished_task", find))
+		{
+			const luabind::object r = luabind::object(find(npc->lua_game_object()));
+			if (r.type() == LUA_TSTRING)
+				xr_strcpy(task, sizeof(task), luabind::object_cast<LPCSTR>(r));
+		}
+	}
+	if (!task[0])
+		g_host->log.line("quest-story-finish-none slot=%u", u32(link.ref.slot));
+	else if (!party_task(task) && party_task_supported(task) &&
+		Level().GameTaskManager().HasGameTask(shared_str(task), true))
+	{
+		party_task_accepted(link, task, u16(npc->ID()), anchor, 0);
+		g_host->log.line("quest-story-adopted slot=%u task=%s source=finish", u32(link.ref.slot), task);
+	}
+}
