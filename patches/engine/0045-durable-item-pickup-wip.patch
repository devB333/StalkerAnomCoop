+// The lifecycle's owner change, through the engine's own ownership events on
+// this client's in-process server (permitted for replication): the previous
+// owner gives the item up (GE_OWNERSHIP_REJECT) and the new one takes it
+// (GE_OWNERSHIP_TAKE); the level then shows it as the server does (in the
+// inventory, or on the ground where snapshots place it).
+void apply_reparent(const coop::proto::Reparent& r)
+{
+	if (r.commit_id <= g_link->applied)
+		return;
+	g_link->applied = r.commit_id;
+	const auto it = g_link->by_entity.find(r.entity.id);
+	if (it == g_link->by_entity.end() || !(g_link->refs[it->second] == r.entity))
+	{
+		++g_link->reparents_unknown;
+		g_link->log.line("reparent-unknown entity=%I64u/%u", r.entity.id, r.entity.generation);
+		return;
+	}
+	const u16 id = it->second;
+	u16 parent = 0xffff;
+	if (!r.parent.none())
+	{
+		const auto p = g_link->by_entity.find(r.parent.id);
+		if (p == g_link->by_entity.end())
+		{
+			++g_link->reparents_failed;
+			g_link->log.line("reparent-no-parent id=%u parent_entity=%I64u", u32(id), r.parent.id);
+			return;
+		}
+		parent = p->second;
+	}
+	CSE_ALifeDynamicObject* object = ai().alife().objects().object(id, true);
+	if (!object)
+	{
+		++g_link->reparents_failed;
+		return;
+	}
+	const u16 from = object->ID_Parent;
+	if (from == parent)
+	{
+		++g_link->reparents_noop;
+		return;
+	}
+	if (!Level().Objects.net_Find(id) || (parent != 0xffff && !Level().Objects.net_Find(parent)) ||
+		(from != 0xffff && !Level().Objects.net_Find(from)))
+	{
+		++g_link->reparents_failed;
+		g_link->log.line("reparent-offline id=%u from=%u parent=%u", u32(id), u32(from), u32(parent));
+		return;
+	}
+	campaign::ReplicaPermit permit;
+	auto send = [](u16 type, u16 destination, u16 item) {
+		NET_Packet packet;
+		packet.w_begin(M_EVENT);
+		packet.w_u32(Level().timeServer());
+		packet.w_u16(type);
+		packet.w_u16(destination);
+		packet.w_u16(item);
+		Level().Send(packet, net_flags(TRUE, TRUE));
+	};
+	if (from != 0xffff)
+		send(GE_OWNERSHIP_REJECT, from, id);
+	if (parent != 0xffff)
+		send(GE_OWNERSHIP_TAKE, parent, id);
+	else
+		object->o_Position.set(r.transform.x, r.transform.y, r.transform.z);
+	const bool ok = object->ID_Parent == parent;
+	if (ok)
+		++g_link->reparents_applied;
+	else
+		++g_link->reparents_failed;
+	g_link->log.line("reparent-applied id=%u entity=%I64u from=%u parent=%u parent_entity=%I64u own=%d ok=%d", u32(id),
+		r.entity.id, u32(from), u32(parent), r.parent.id, g_actor && parent == g_actor->ID() ? 1 : 0, ok ? 1 : 0);
+}
