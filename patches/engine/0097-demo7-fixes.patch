+// B29: a body falls by itself on each machine (its ragdoll, S06-T05), so it
+// came to rest up to 4 m from the server's body, whose position the server
+// measures a loot's reach against (every take refused, demo-7). Once the body
+// has lain kCorpseSettleMs here, a difference over kCorpseTolerance moves its
+// shell (pose kept) to where the server has it; a body the server moves later
+// follows the same way.
+const u32 kCorpseSettleMs = 8000;
+const u32 kCorpseRepeatMs = 2000;
+const float kCorpseTolerance = 0.5f;
+
+void converge_corpse(CEntityAlive* body, Link::Track& track)
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (!track.dead_seen_ms)
+	{
+		track.dead_seen_ms = now;
+		return;
+	}
+	if (now - track.dead_seen_ms < kCorpseSettleMs || (track.corpse_moved_ms && now - track.corpse_moved_ms < kCorpseRepeatMs))
+		return;
+	const coop::proto::EntityState* newest = track.buffer.newest();
+	if (!newest || !(newest->components & coop::proto::kTransform))
+		return;
+	Fvector delta;
+	delta.set(newest->transform.x, newest->transform.y, newest->transform.z);
+	delta.sub(body->Position());
+	if (!_valid(delta) || delta.magnitude() < kCorpseTolerance)
+		return;
+	CPhysicsShell* shell = body->PPhysicsShell();
+	if (!shell || !shell->isActive())
+		return;
+	const float offset = delta.magnitude();
+	Fmatrix trans;
+	trans.identity();
+	trans.c.set(delta);
+	shell->TransformPosition(trans, mh_clear);
+	shell->set_LinearVel(Fvector().set(0, 0, 0));
+	shell->set_AngularVel(Fvector().set(0, 0, 0));
+	shell->GetGlobalTransformDynamic(&body->XFORM());
+	body->spatial_move();
+	track.corpse_moved_ms = now;
+	++g_link->corpses_moved;
+	g_link->log.line("corpse-moved id=%u section=%s offset=%.2f to=%.2f,%.2f,%.2f", u32(body->ID()), *body->cNameSect(), offset,
+		newest->transform.x, newest->transform.y, newest->transform.z);
+}
