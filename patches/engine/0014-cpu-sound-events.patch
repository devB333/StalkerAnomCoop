diff --git a/src/xrSound/SoundRender_CoreCPU.cpp b/src/xrSound/SoundRender_CoreCPU.cpp
new file mode 100644
index 0000000..f96ca92
--- /dev/null
+++ b/src/xrSound/SoundRender_CoreCPU.cpp
@@ -0,0 +1,67 @@
+#include "stdafx.h"
+#pragma hdrstop
+
+#include "SoundRender_CoreCPU.h"
+#include "SoundRender_Emitter.h"
+#include "NotificationClient.h"
+
+CSoundRender_CoreCPU* SoundRenderCPU = nullptr;
+
+// The stream cache only serves rendering targets; a small one keeps the
+// per-source category tables valid without the client's 256 MB.
+static const u32 cpu_cache_kb = 1024;
+
+CSoundRender_CoreCPU::CSoundRender_CoreCPU() : CSoundRender_Core()
+{
+	no_listener.set(0.f, 0.f, 0.f);
+	// No device: the audio endpoint notifications are not wanted.
+	xr_delete(pSysNotification);
+}
+
+CSoundRender_CoreCPU::~CSoundRender_CoreCPU() {}
+
+void CSoundRender_CoreCPU::_initialize(int stage)
+{
+	// Stage 0 enumerates devices in the OpenAL core; there are none here.
+	if (stage == 0)
+		return;
+	Timer.Start();
+	env_load();
+	bPresent = TRUE;
+	cache_bytes_per_line = (sdef_target_block / 8) * 276400 / 1000;
+	cache.initialize(cpu_cache_kb, cache_bytes_per_line);
+	bReady = TRUE;
+	Msg("* sound : CPU core, no device, no listener (-snd_cpu)");
+}
+
+void CSoundRender_CoreCPU::_clear()
+{
+	inherited::_clear();
+}
+
+void CSoundRender_CoreCPU::_restart()
+{
+	cache.destroy();
+	cache.initialize(cpu_cache_kb, cache_bytes_per_line);
+	env_apply();
+}
+
+void CSoundRender_CoreCPU::update_events()
+{
+	PROF_EVENT("CSoundRender_CoreCPU::update_events");
+	for (u32 it = 0; it < s_events.size(); it++)
+	{
+		event& E = s_events[it];
+		if (E.first->feedback && E.first->feedback->is_2D())
+		{
+			// A 2D sound has no world position; the OpenAL core places it at
+			// the listener, which this core does not have.
+			++s_events_2d_skipped;
+			continue;
+		}
+		++s_events_total;
+		if (Handler)
+			Handler(E.first, E.second);
+	}
+	s_events.clear_not_free();
+}
diff --git a/src/xrSound/SoundRender_CoreCPU.h b/src/xrSound/SoundRender_CoreCPU.h
new file mode 100644
index 0000000..37aa84f
--- /dev/null
+++ b/src/xrSound/SoundRender_CoreCPU.h
@@ -0,0 +1,39 @@
+#pragma once
+#include "SoundRender_Core.h"
+
+// S02-T05c: the CPU sound core, selected with -snd_cpu. It is the engine's
+// own sound core with no audio device: sources load their headers (length,
+// game type, volume, AI range from the ogg comment), emitters run the native
+// state machine and propagate AI sound events to the level's handler, and
+// nothing is mixed because there are no targets. It has no listener: 3D
+// events keep their world position, 2D events (UI, music, intro) are dropped
+// instead of being placed at a fabricated listener, and the listener-distance
+// start delay and listener occlusion do not apply. The OpenAL core
+// (CSoundRender_CoreA) is unchanged for the client.
+class CSoundRender_CoreCPU : public CSoundRender_Core
+{
+	typedef CSoundRender_Core inherited;
+	Fvector no_listener; // zero; returned where the interface needs a reference
+
+public:
+	CSoundRender_CoreCPU();
+	virtual ~CSoundRender_CoreCPU();
+
+	virtual void _initialize(int stage);
+	virtual void _clear();
+	virtual void _restart();
+	virtual void set_master_volume(float f) {}
+	virtual void update_listener(const Fvector& P, const Fvector& D, const Fvector& N, float dt) {}
+	virtual void set_listener(const CSoundRender_Environment& env) {}
+	virtual void get_listener(CSoundRender_Environment& env) {}
+	virtual void commit() {}
+	virtual void default_device_changed() {}
+	virtual const Fvector& listener_position() { return no_listener; }
+	virtual bool has_listener() { return false; }
+	// Playback occlusion is measured from the listener; without one there is
+	// none. Hearing occlusion (get_occlusion_to) is hearer-to-source and stays native.
+	virtual float get_occlusion(Fvector& P, float R, Fvector* occ) { return 1.f; }
+	virtual void update_events();
+};
+
+extern CSoundRender_CoreCPU* SoundRenderCPU;
