+	}
+	if (attached < 2 || f.phase >= 999 || g_host->tick < f.both_since + u64(config.companion_party) * 50)
+		return;
+	if (slots[0] != 0)
+	{
+		std::swap(actors[0], actors[1]);
+		std::swap(slots[0], slots[1]);
+	}
