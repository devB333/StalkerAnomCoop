+// ------------------------------------------------------------ S05-T03
+const u32 kServerTickMs = 20; // the campaign server's tick (Welcome tick_rate_hz = 50)
+const u32 kRenderDelayMs = 100; // two snapshot intervals at 20 Hz
+
+void on_snapshot(const coop::proto::Snapshot& snapshot)
+{
+	++g_link->snapshots;
+	g_link->last_snapshot_tick = snapshot.server_tick;
+	g_link->last_input_acked = snapshot.last_input;
+	const double now = double(g_link->wall.GetElapsed_ms());
+	const double server_ms = double(snapshot.server_tick) * double(kServerTickMs);
+	const double offset = now - server_ms;
+	if (!g_link->have_offset || offset < g_link->clock_offset)
+	{
+		g_link->clock_offset = offset;
+		g_link->have_offset = true;
+	}
+	for (const coop::proto::SnapshotEntity& e : snapshot.entities)
+	{
+		const auto it = g_link->by_entity.find(e.entity.id);
+		if (it == g_link->by_entity.end() || !(g_link->refs[it->second] == e.entity))
+		{
+			++g_link->snapshot_unknown;
+			continue;
+		}
+		Link::Track& t = g_link->tracks[it->second];
+		if (!t.samples.empty() && t.samples.back().server_ms >= server_ms)
+			continue; // an older or repeated snapshot (transient channel)
+		Link::Sample sample;
+		sample.server_ms = server_ms;
+		sample.position.set(e.transform.x, e.transform.y, e.transform.z);
+		sample.velocity.set(e.vx, e.vy, e.vz);
+		sample.yaw = e.transform.yaw;
+		sample.state = e.state_bits;
+		sample.health = e.health;
+		t.samples.push_back(sample);
+		while (t.samples.size() > 16)
+			t.samples.pop_front();
+		t.last = sample.position;
+		t.state = e.state_bits;
+		t.server_tick = snapshot.server_tick;
+	}
+}
+
+// Every participant actor where the server had it kRenderDelayMs ago, by
+// server time: interpolated between the two snapshots around that moment, so
+// uneven arrival does not jolt the motion (no prediction: S06-T03; the
+// interpolation, baselines and rates are S06-T02's to tune).
+void present_actors()
+{
+	if (!g_link->have_offset)
+		return;
+	const double render_ms = double(g_link->wall.GetElapsed_ms()) - g_link->clock_offset - double(kRenderDelayMs);
+	for (auto& entry : g_link->tracks)
+	{
+		CActor* actor = smart_cast<CActor*>(Level().Objects.net_Find(entry.first));
+		const Link::Track& t = entry.second;
+		if (!actor || t.samples.empty())
+			continue;
+		const Link::Sample* a = &t.samples.front();
+		const Link::Sample* b = a;
+		for (size_t i = 0; i + 1 < t.samples.size(); ++i)
+			if (t.samples[i].server_ms <= render_ms)
+			{
+				a = &t.samples[i];
+				b = &t.samples[i + 1];
+			}
+		if (render_ms >= t.samples.back().server_ms)
+			a = b = &t.samples.back(); // behind on snapshots: hold the newest
+		const double span = b->server_ms - a->server_ms;
+		const float k = span > 0 ? clampr(float((render_ms - a->server_ms) / span), 0.f, 1.f) : 1.f;
+		Fvector position;
+		position.lerp(a->position, b->position, k);
+		const float yaw = angle_lerp(a->yaw, b->yaw, k);
+		Fvector velocity;
+		velocity.lerp(a->velocity, b->velocity, k);
+		actor->replica_present(position, yaw, k < 0.5f ? a->state : b->state, velocity, actor == g_actor);
+	}
+}
+
+void face_other_actor(bool check)
+{
+	CActor* other = nullptr;
+	for (const auto& entry : g_link->tracks)
+		if (!g_actor || entry.first != g_actor->ID())
+			other = smart_cast<CActor*>(Level().Objects.net_Find(entry.first));
+	if (!other || !g_actor)
+	{
+		g_link->log.line("script-face no-other-actor");
+		return;
+	}
+	Fvector to;
+	to.sub(other->Position(), g_actor->Position());
+	to.y = 0;
+	const float distance = to.magnitude();
+	to.normalize_safe();
+	CCameraBase* camera = g_actor->cam_Active();
+	if (!check)
+	{
+		float h, p;
+		to.getHP(h, p);
+		camera->yaw = -h;
+		camera->pitch = 0.f;
+		g_link->log.line("script-face other=%u distance=%.2f yaw=%.3f", u32(other->ID()), distance, camera->yaw);
+		return;
+	}
+	Fvector view = Device.vCameraDirection;
+	view.y = 0;
+	view.normalize_safe();
+	// The camera's yaw is minus the heading (view-5: dot 1.000 twice); a
+	// paused game does not update the view, so this only reports.
+	const float dot = view.dotproduct(to);
+	g_link->log.line("script-face-check dot=%.3f paused=%d", dot, Device.Paused() ? 1 : 0);
+}
