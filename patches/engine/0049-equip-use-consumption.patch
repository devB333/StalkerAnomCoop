+// CampaignEvent 9: one participant actor's inventory layout, as the server
+// holds it. Payload: u64 actor entity, u32 serial, u8 part, u8 parts, u8
+// count, then count x (u64 item entity, u8 place, u8 slot, u8 uses; 0xff: not
+// an eatable item). The items sorted by entity; at most 80 per part.
+struct LayoutEntry
+{
+	u64 entity;
+	u8 place, slot, uses;
+	bool operator<(const LayoutEntry& o) const { return entity < o.entity; }
+};
+
+void actor_layout(CActor* actor, xr_vector<LayoutEntry>& out)
+{
+	out.clear();
+	for (PIItem item : actor->inventory().m_all)
+	{
+		if (!item)
+			continue;
+		const u16 id = u16(item->object().ID());
+		const auto p = g_host->published.find(id);
+		if (p == g_host->published.end() || !p->second.sent || g_host->use_consumed.count(id) || item->GetDropManual())
+			continue; // a client does not know it yet, or it is being released
+		LayoutEntry e;
+		e.entity = p->second.ref.id;
+		e.place = u8(item->CurrPlace());
+		e.slot = item->CurrPlace() == kPlaceSlot ? u8(item->CurrSlot()) : 0;
+		const CEatableItem* eatable = smart_cast<const CEatableItem*>(item);
+		e.uses = eatable ? eatable->GetRemainingUses() : 0xff;
+		out.push_back(e);
+	}
+	std::sort(out.begin(), out.end());
+}
+
+u64 layout_hash(const xr_vector<LayoutEntry>& entries, u64 h = 14695981039346656037ull)
+{
+	for (const LayoutEntry& e : entries)
+		h = fnv1a(fnv1a(h, e.entity), (u64(e.place) << 16) | (u64(e.slot) << 8) | e.uses);
+	return h;
+}
+
+void send_layout(CActor* actor, const xr_vector<LayoutEntry>& entries, u32 serial, PlayerLink* only)
+{
+	coop::proto::EntityRef ref;
+	if (!entity_ref_of(actor->ID(), ref))
+		return;
+	const u32 per = 80;
+	const u32 parts = _max(1u, u32((entries.size() + per - 1) / per));
+	for (u32 part = 0; part < parts; ++part)
+	{
+		std::vector<u8> payload;
+		for (int b = 0; b < 8; ++b)
+			payload.push_back(u8(ref.id >> (8 * b)));
+		put_u32(payload, serial);
+		put_u8(payload, u8(part));
+		put_u8(payload, u8(parts));
+		const u32 first = part * per, last = _min(u32(entries.size()), first + per);
+		put_u8(payload, u8(last - first));
+		for (u32 i = first; i < last; ++i)
+		{
+			for (int b = 0; b < 8; ++b)
+				payload.push_back(u8(entries[i].entity >> (8 * b)));
+			put_u8(payload, entries[i].place);
+			put_u8(payload, entries[i].slot);
+			put_u8(payload, entries[i].uses);
+		}
+		if (only)
+			queue_event(*only, 9, payload);
+		else
+			broadcast_event(9, payload);
+	}
+	++g_host->layouts_sent;
+}
+
+// Every tick: a participant actor's changed layout goes to every client in
+// the world (at most every 5 ticks per actor, or at once when `now`); a
+// client that has just entered the world gets every actor's layout.
+void send_layouts(bool now)
+{
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		if (!actor)
+			continue;
+		xr_vector<LayoutEntry> entries;
+		actor_layout(actor, entries);
+		const u64 hash = layout_hash(entries);
+		Host::Layout& l = g_host->layouts[u16(actor->ID())];
+		if (hash != l.hash && (now || g_host->tick >= l.sent_tick + 5))
+		{
+			l.hash = hash;
+			l.sent_tick = g_host->tick;
+			++l.serial;
+			send_layout(actor, entries, l.serial, nullptr);
+			g_host->log.line("layout-sent actor=%u slot=%u serial=%u items=%u hash=%016I64x", u32(actor->ID()),
+				u32(link.ref.slot), l.serial, u32(entries.size()), hash);
+		}
+	}
+	for (PlayerLink& link : g_host->links)
+	{
+		const bool in_world = client_in_world(link);
+		if (!in_world)
+		{
+			link.layouts_sent = false;
+			continue;
+		}
+		if (link.layouts_sent)
+			continue;
+		link.layouts_sent = true;
+		for (PlayerLink& other : g_host->links)
+			if (other.bound)
+				if (CActor* actor = participant_actor(other.ref))
+				{
+					xr_vector<LayoutEntry> entries;
+					actor_layout(actor, entries);
+					Host::Layout& l = g_host->layouts[u16(actor->ID())];
+					send_layout(actor, entries, l.serial, &link);
+					g_host->log.line("layout-joined to=%u actor=%u serial=%u items=%u", u32(link.ref.slot),
+						u32(actor->ID()), l.serial, u32(entries.size()));
+				}
+	}
+}
+
+// The participant actors' layouts hashed together for the item-graph point
+// (in slot order; the client hashes its replica the same way).
+u64 participants_layout_hash(u32& items)
+{
+	u64 h = 14695981039346656037ull;
+	items = 0;
+	for (u8 slot = 0; slot < 2; ++slot)
+		for (PlayerLink& link : g_host->links)
+			if (link.bound && link.ref.slot == slot)
+				if (CActor* actor = participant_actor(link.ref))
+				{
+					xr_vector<LayoutEntry> entries;
+					actor_layout(actor, entries);
+					items += u32(entries.size());
+					coop::proto::EntityRef ref;
+					entity_ref_of(actor->ID(), ref);
+					h = layout_hash(entries, fnv1a(h, ref.id));
+				}
+	return h;
+}
+
+// Server-side Lua for item use (installed once, like the party adapter):
+//  - actor_effects.play_item_fx (the use's first-person animation, sounds,
+//    camera effect and the weapon lowered for its duration) is presentation
+//    of the player who used the item: it runs on that player's client when
+//    the use is accepted, not on the server, whose timeline would run from
+//    participant 1's actor update (and lower participant 1's weapon);
+//  - itms_manager's booster memory (the "a stronger booster is still active"
+//    refusal, a local table of the script) is kept per actor instead of one
+//    for the whole server: before each use the script's upvalue is pointed
+//    at the user's own table (select_booster_memory; the Lua C API, since
+//    the release engine does not open Lua's debug library).
+LPCSTR const item_source =
+	"local P = rawget(_G, '__campaign_items')\n"
+	"if type(P) == 'table' and P.installed then return end\n"
+	"P = { installed = true, fx = 0, fx_wrapped = 0, booster_wrapped = 0 }\n"
+	"rawset(_G, '__campaign_items', P)\n"
+	"if actor_effects and actor_effects.play_item_fx then\n"
+	"  actor_effects.play_item_fx = function(name) P.fx = P.fx + 1 end\n"
+	"  P.fx_wrapped = 1\n"
+	"end\n"
+	"P.boosters = {}\n"
+	;
+
+// The index of itms_manager.actor_on_item_before_use's upvalue `old_booster`
+// (0: not found); the function is left on the stack top when found. The
+// installed script fixes (aaaa_script_fixes_mp.script) wrap that function and
+// keep the original as aaaa_script_fixes_mp.itms_manager_actor_on_item_before_use.
+int booster_function(lua_State* L)
+{
+	const char* places[][2] = {{"itms_manager", "actor_on_item_before_use"},
+		{"aaaa_script_fixes_mp", "itms_manager_actor_on_item_before_use"}};
+	for (const auto& place : places)
+	{
+		lua_getglobal(L, place[0]);
+		if (!lua_istable(L, -1))
+		{
+			lua_pop(L, 1);
+			continue;
+		}
+		lua_getfield(L, -1, place[1]);
+		lua_remove(L, -2);
+		if (!lua_isfunction(L, -1))
+		{
+			lua_pop(L, 1);
+			continue;
+		}
+		for (int n = 1; n < 64; ++n)
+		{
+			const char* name = lua_getupvalue(L, -1, n);
+			if (!name)
+				break;
+			lua_pop(L, 1);
+			if (!xr_strcmp(name, "old_booster"))
+				return n;
+		}
+		lua_pop(L, 1);
+	}
+	return 0;
+}
+
+// What the booster lookup sees (diagnostics).
+void booster_diag(LPCSTR tag)
+{
+	lua_State* L = ai().script_engine().lua();
+	if (!L)
+		return;
+	const int top = lua_gettop(L);
+	string512 names = "";
+	lua_getglobal(L, "itms_manager");
+	const int module_type = lua_type(L, -1);
+	int field_type = -1;
+	if (lua_istable(L, -1))
+	{
+		lua_getfield(L, -1, "actor_on_item_before_use");
+		field_type = lua_type(L, -1);
+		if (lua_isfunction(L, -1))
+			for (int n = 1; n < 32; ++n)
+			{
+				const char* name = lua_getupvalue(L, -1, n);
+				if (!name)
+					break;
+				lua_pop(L, 1);
+				string64 one;
+				xr_sprintf(one, "%s%d:%s", names[0] ? "," : "", n, name[0] ? name : "?");
+				xr_strcat(names, one);
+			}
+	}
+	lua_settop(L, top);
+	g_host->log.line("booster-diag tag=%s module=%s field=%s upvalues=%s", tag, lua_typename(L, module_type),
+		field_type >= 0 ? lua_typename(L, field_type) : "-", names[0] ? names : "-");
+}
+
+int booster_upvalue(lua_State* L)
+{
+	const int n = booster_function(L);
+	if (n)
+		lua_pop(L, 1);
+	return n;
+}
+
+// Points the script's booster memory at this actor's own table.
+bool select_booster_memory(u16 actor)
+{
+	lua_State* L = ai().script_engine().lua();
+	if (!L || !g_host->item_adapter)
+		return false;
+	const int n = booster_function(L);
+	if (!n)
+		return false;
+	lua_getglobal(L, "__campaign_items");
+	if (!lua_istable(L, -1))
+	{
+		lua_pop(L, 2);
+		return false;
+	}
+	lua_getfield(L, -1, "boosters");
+	lua_remove(L, -2);
+	if (!lua_istable(L, -1))
+	{
+		lua_pop(L, 2);
+		return false;
+	}
+	lua_rawgeti(L, -1, actor);
+	if (!lua_istable(L, -1))
+	{
+		lua_pop(L, 1);
+		lua_newtable(L);
+		lua_pushvalue(L, -1);
+		lua_rawseti(L, -3, actor);
+	}
+	lua_remove(L, -2); // the boosters table: [function, actor's table]
+	const bool ok = lua_setupvalue(L, -2, n) != nullptr; // pops the table
+	lua_pop(L, 1);
+	return ok;
+}
