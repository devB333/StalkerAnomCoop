+//   Committed  phase 2 committed; both clients are told (CampaignEvent 13
+//              state 8) and rejoin; the serve loop reloads the level in
+//              process from that generation (xrCoopServer_ReloadRequested)
+// A failed take or publication rolls back (phase 3; the entities were
+// restored; the players are told). A crash before the publication recovers
+// the source generation; after it, the destination one (contract §7).
+
+void log_status(LPCSTR tag);
+
+const char* travel_exec_name(u8 s)
+{
+	switch (s)
+	{
+	case 0: return "none";
+	case 1: return "draining";
+	case 2: return "taking";
+	case 3: return "publishing";
+	case 4: return "committed";
+	case 5: return "reloading";
+	}
+	return "?";
+}
+
+bool travel_executing() { return g_host && g_host->travel.exec != 0; }
+
+void travel_record(u8 phase, u64 revision)
+{
+	Host::Travel& tv = g_host->travel;
+	TransitionRecord r;
+	r.id = tv.exec_id;
+	r.phase = phase;
+	r.source_generation = tv.source_generation;
+	r.destination_generation = tv.destination_generation;
+	r.level = tv.level;
+	r.graph_vertex = tv.graph_vertex;
+	r.level_vertex = tv.level_vertex;
+	for (int i = 0; i < 3; ++i)
+	{
+		r.position[i] = (&tv.position.x)[i];
+		r.angles[i] = (&tv.angles.x)[i];
+	}
+	const bool ok = g_host->persistence && g_host->persistence->commit(coop::store::kRecordTransition, g_host->tick,
+		revision, encode_transition(r));
+	g_host->log.line("travel-record id=%I64x phase=%u source=%u destination=%u level=%s revision=%I64u ok=%d", r.id,
+		u32(phase), r.source_generation, r.destination_generation, r.level.c_str(), revision, ok ? 1 : 0);
+	travel_csv(phase == 1 ? "prepared" : phase == 2 ? "committed" : "rolled-back", 0, 0, r.id, 0,
+		travel_exec_name(tv.exec), tv.level.c_str());
+	if (!ok)
+		g_host->log.line("travel-record-failed phase=%u reason=%s", u32(phase), g_host->persistence ? g_host->persistence->failure() : "no-store");
+}
+
+void travel_exec_fail(LPCSTR why)
+{
+	Host::Travel& tv = g_host->travel;
+	g_host->log.line("travel-exec-failed id=%I64x state=%s why=%s", tv.exec_id, travel_exec_name(tv.exec), why);
+	if (tv.exec >= 2 && g_host->persistence && !g_host->persistence->failed())
+		travel_record(3, ++g_host->commit);
+	coop::proto::Transition t = g_host->travel.coordinator->last_ended();
+	t.state = coop::proto::TravelState::Aborted;
+	t.abort = coop::proto::TravelAbort::ExecutionFailed;
+	tv.level = tv.exec_level;
+	travel_event(t, 0);
+	tv.exec = 0;
+	tv.exec_id = 0;
+	++tv.exec_failed;
+}
+
+// Agreed: the executor starts (called from end_travel).
+void travel_begin_execution(const coop::proto::Transition& t)
+{
+	Host::Travel& tv = g_host->travel;
+	tv.exec = 1;
+	tv.exec_id = t.id;
+	tv.exec_since = g_host->tick;
+	tv.exec_level = tv.level;
+	tv.source_generation = g_host->persistence ? g_host->persistence->current_generation() : 0;
+	tv.destination_generation = 0;
+	++tv.executions;
+	g_host->log.line("travel-exec id=%I64x state=draining level=%s gvid=%u lvid=%u pos=%.2f,%.2f,%.2f source=%u in_flight=%d "
+		"pickups=%u inventory=%u stacks=%u turn_ins=%u quest_answers=%u",
+		t.id, tv.exec_level.c_str(), u32(tv.graph_vertex), tv.level_vertex, VPUSH(tv.position), tv.source_generation,
+		g_host->persistence && g_host->persistence->in_flight() ? 1 : 0, u32(g_host->pickups_pending.size()),
+		u32(g_host->inventory_pending.size()), u32(g_host->stacks_pending.size()), u32(g_host->turn_ins.size()),
+		u32(g_host->quest_answers.size()));
+}
+
+// The take: both actors' entities moved as the native change_level moves the
+// one actor's, the generation taken, the entities restored (the level keeps
+// running until the publication is done).
+bool travel_take()
+{
+	Host::Travel& tv = g_host->travel;
+	CoopPersistence* persistence = g_host->persistence;
+	if (!persistence || persistence->failed() || persistence->in_flight())
+		return false;
+	struct Moved
+	{
+		CSE_ALifeCreatureActor* se;
+		PlayerLink* link;
+		GameGraph::_GRAPH_ID graph;
+		u32 node;
+		Fvector position, angles;
+		SRotation torso;
+		Fvector entry;
+		u32 entry_vertex;
+		bool have_entry;
+	};
+	xr_vector<Moved> moved;
+	Level().ClientSend(); // the live state into the entities first (as change_level)
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		if (!actor)
+			continue;
+		CSE_ALifeDynamicObject* o = ai().alife().objects().object(u16(actor->ID()), true);
+		CSE_ALifeCreatureActor* se = o ? smart_cast<CSE_ALifeCreatureActor*>(o) : nullptr;
+		if (!se)
+		{
+			g_host->log.line("travel-take-no-entity slot=%u actor=%u", u32(link.ref.slot), u32(actor->ID()));
+			return false;
+		}
+		if (se->m_holderID != 0xffff)
+			g_host->log.line("travel-take-holder slot=%u holder=%u (vehicles are not carried over)", u32(link.ref.slot),
+				u32(se->m_holderID));
+		Moved m = {se, &link, se->m_tGraphID, se->m_tNodeID, se->o_Position, se->o_Angle, se->o_torso, link.entry,
+			link.entry_vertex, link.have_entry};
+		moved.push_back(m);
+		Fvector at = tv.position;
+		at.x += link.ref.slot ? 0.8f : 0.f; // the two actors side by side at the arrival point
+		se->m_tGraphID = tv.graph_vertex;
+		se->m_tNodeID = tv.level_vertex;
+		se->o_Position = at;
+		se->o_Angle = tv.angles;
+		se->o_torso.yaw = tv.angles.y;
+		se->o_torso.pitch = tv.angles.x;
+		se->o_torso.roll = 0.f;
+		// G07 decision 2: the arrival is the respawn point on the new level
+		link.entry = at;
+		link.entry_vertex = tv.level_vertex;
+		link.have_entry = true;
+		g_host->log.line("travel-take-moved slot=%u actor=%u entity=%I64u from=%.2f,%.2f,%.2f gvid=%u to=%.2f,%.2f,%.2f gvid=%u lvid=%u",
+			u32(link.ref.slot), u32(actor->ID()), entity_of(u16(actor->ID())), VPUSH(m.position), u32(m.graph), VPUSH(at),
+			u32(tv.graph_vertex), tv.level_vertex);
+	}
+	if (moved.empty())
+		return false;
+	Level().ClientSave();
+	tv.destination_generation = persistence->next_generation();
+	const bool taken = request_publication("travel", true);
+	for (Moved& m : moved)
+	{
+		m.se->m_tGraphID = m.graph;
+		m.se->m_tNodeID = m.node;
+		m.se->o_Position = m.position;
+		m.se->o_Angle = m.angles;
+		m.se->o_torso = m.torso;
+		if (!taken)
+		{
+			m.link->entry = m.entry;
+			m.link->entry_vertex = m.entry_vertex;
+			m.link->have_entry = m.have_entry;
+		}
+	}
+	g_host->log.line("travel-take id=%I64x generation=%u taken=%d actors=%u", tv.exec_id, tv.destination_generation,
+		taken ? 1 : 0, u32(moved.size()));
+	return taken;
+}
+
+void travel_execute_tick()
+{
+	Host::Travel& tv = g_host->travel;
+	if (!tv.exec || tv.exec >= 4)
+		return;
+	CoopPersistence* persistence = g_host->persistence;
+	if (!persistence || persistence->failed())
+	{
+		travel_exec_fail("store-failed");
+		return;
+	}
+	// the party must still be whole: a disconnect or a death during the
+	// barrier rolls the travel back (nothing durable has changed yet)
+	for (PlayerLink& l : g_host->links)
+	{
+		if (!l.bound || l.ref.slot > 1)
+			continue;
+		CActor* a = participant_actor(l.ref);
+		if (!client_in_world(l) || !a || !a->g_Alive())
+		{
+			if (tv.exec < 3)
+			{
+				travel_exec_fail(!client_in_world(l) ? "party-member-left" : "party-member-dead");
+				return;
+			}
+		}
+	}
+	if (tv.exec == 1)
+	{
+		const bool drained = !persistence->in_flight() && g_host->pickups_pending.empty() &&
+			g_host->pickup_confirm.empty() && g_host->inventory_pending.empty() && g_host->stacks_pending.empty() &&
+			g_host->turn_ins.empty() && g_host->quest_answers.empty();
+		if (!drained && g_host->tick - tv.exec_since < 10 * 50)
+			return;
+		if (!drained)
+			g_host->log.line("travel-drain-timeout id=%I64x in_flight=%d pickups=%u confirm=%u inventory=%u stacks=%u "
+				"turn_ins=%u quest_answers=%u", tv.exec_id, persistence->in_flight() ? 1 : 0,
+				u32(g_host->pickups_pending.size()), u32(g_host->pickup_confirm.size()),
+				u32(g_host->inventory_pending.size()), u32(g_host->stacks_pending.size()), u32(g_host->turn_ins.size()),
+				u32(g_host->quest_answers.size()));
+		if (persistence->in_flight())
+			return; // a publication must finish before the take (one worker job at a time)
+		tv.exec = 2;
+		g_host->log.line("travel-exec id=%I64x state=taking drained=%d after_ticks=%I64u", tv.exec_id, drained ? 1 : 0,
+			g_host->tick - tv.exec_since);
+		tv.destination_generation = persistence->next_generation();
+		travel_record(1, ++g_host->commit);
+		if (persistence->failed())
+		{
+			travel_exec_fail("prepare-record");
+			return;
+		}
+		// S09-T02 harness: a crash after the prepared record, before the take
+		coop::store::failpoint("travel:before-take");
+		if (!travel_take())
+		{
+			travel_exec_fail("take");
+			return;
+		}
+		tv.exec = 3;
+		g_host->log.line("travel-exec id=%I64x state=publishing generation=%u", tv.exec_id, tv.destination_generation);
+		return;
+	}
+	// exec 3: poll_publications completes it
+}
+
+// Called by poll_publications for every published generation.
+void travel_on_published(u32 generation, bool ok)
+{
+	Host::Travel& tv = g_host->travel;
+	if (tv.exec != 3 || generation != tv.destination_generation)
+		return;
+	if (!ok)
+	{
+		travel_exec_fail("publication");
+		return;
+	}
+	tv.exec = 4;
+	travel_record(2, ++g_host->commit);
+	++tv.committed;
+	g_host->log.line("travel-committed id=%I64x generation=%u level=%s", tv.exec_id, generation, tv.exec_level.c_str());
+	// both clients leave their world and rejoin once the server is on the new level
+	coop::proto::Transition t = tv.coordinator->last_ended();
+	t.state = coop::proto::TravelState(8); // committed: reload
+	tv.level = tv.exec_level;
+	travel_event(t, 0);
+	for (PlayerLink& link : g_host->links)
+		if (link.world == WorldStreaming || link.world == WorldLive)
+			flush_outbox(link);
+	// S09-T02 harness: a crash after the commit, before the reload
+	coop::store::failpoint("travel:after-commit");
+	tv.exec = 5;
+	tv.reload_requested = true;
+}
+
+// The serve loop's reload (x_ray.cpp): the sessions are detached from the
+// level that goes away; the transport and the session server stay.
+void travel_before_reload()
+{
+	Host::Travel& tv = g_host->travel;
+	poll_publications(true);
+	g_host->events.clear();
+	for (PlayerLink& link : g_host->links)
+	{
+		if (link.session)
+			g_campaign_identity->detach_session(g_campaign_identity->authority(), link.session, Device.dwFrame);
+		link.session = 0;
+		link.world = WorldNone;
+		link.outbox.clear();
+		link.blob.clear();
+		link.inputs.reset();
+		link.snapshots.reset();
+		link.settled.clear();
+		link.sent_commit = 0;
+		link.fire_down = false;
+		link.pending_actor = kNoEngineId;
+		link.layouts_sent = false;
+		link.party_sent = false;
+		link.travel_sent_id = 0;
+		link.presentation_started = false;
+		link.kit_pending = false;
+	}
+	xr_string save, reason;
+	if (!g_host->persistence->load_generation(tv.destination_generation, save, reason))
+	{
+		g_host->log.line("travel-reload-refused id=%I64x generation=%u reason=%s", tv.exec_id, tv.destination_generation,
+			reason.c_str());
+		g_host->stop_requested = true; // the committed generation is on disk: a restart recovers it
+		return;
+	}
+	g_host->recovered_save = save;
+	// the generation's files were written by the store, not through FS: the
+	// saves folder is re-indexed so the level start finds them (as the client
+	// does for a received checkpoint)
+	FS.rescan_path(FS.get_path("$game_saves$")->m_Path, FALSE);
+	// the online set and everything keyed by the level's objects goes with the level
+	g_host->published.clear();
+	g_host->motion.clear();
+	g_host->gait.clear();
+	g_host->guns.clear();
+	g_host->layouts.clear();
+	g_host->observed_children.clear();
+	g_host->observed_entities.clear();
+	g_host->observed_sections.clear();
+	g_host->observer_ready = false;
+	g_host->pickup_expected.clear();
+	g_host->inventory_expected.clear();
+	g_host->container_expected.clear();
+	g_host->containers_recorded.clear();
+	g_host->stack_expected.clear();
+	g_host->stack_entities.clear();
+	g_host->use_consumed.clear();
+	g_host->use_followups.clear();
+	g_host->party_tasks.clear();
+	g_host->party_actor_ids[0] = g_host->party_actor_ids[1] = 0xffff;
+	g_host->party_hash = 0;
+	g_host->dropped.clear();
+	g_host->dropped_release_ms.clear();
+	g_host->dropped_tossed.clear();
+	g_host->encounter = Host::Encounter();
+	g_host->thunder = Host::Thunder();
+	g_host->last_env_key[0] = 0;
+	g_host->last_weather = shared_str();
+	g_host->party_adapter = false;
+	g_host->item_adapter = false;
+	g_host->needs_adapter = false;
+	g_host->needs_current = 0;
+	g_host->pickup_recovery_logged = false;
+	tv.changer = kNoEngineId;
+	tv.fixture.phase = 99; // the fixture ran on the source level; it does not run again
+	g_host->log.line("travel-reload id=%I64x generation=%u save=%s from=%s to=%s", tv.exec_id, tv.destination_generation,
+		save.c_str(), Level().name().c_str(), tv.exec_level.c_str());
+}
+
+// After the new level loaded and ticked (the identity service re-bound the
+// roster from the destination generation's record, the actors were
+// assigned by xrCoopServer_AfterServerReady): the per-level host state.
+bool travel_after_reload()
+{
+	Host::Travel& tv = g_host->travel;
+	g_host->last_published.clear();
+	for (const coop::store::SupplementalParticipant& sp : g_host->persistence->recovered_state().supplemental.participants)
+	{
+		PersistParticipant p;
+		p.slot = sp.slot;
+		p.slot_generation = sp.slot_generation;
+		p.player = sp.player;
+		p.actor_id = sp.actor_id;
+		p.actor_entity = sp.actor_entity;
+		p.alive = sp.alive;
+		p.position.set(sp.position[0], sp.position[1], sp.position[2]);
+		p.entry.set(sp.entry[0], sp.entry[1], sp.entry[2]);
+		p.entry_vertex = sp.entry_vertex;
+		p.name = sp.name.c_str();
+		g_host->last_published.push_back(p);
+	}
+	g_campaign_identity->set_entity_reserver(reserve_entity_block);
+	install_party_adapter(); // S08-T04
+	install_item_adapter(); // S08-T07
+	install_needs_adapter(); // S08-T09
+	rebuild_party_tasks(); // S08-T06
+	bool ok = true;
+	u32 arrived = 0;
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		if (!actor)
+		{
+			g_host->log.line("travel-arrival slot=%u actor=none", u32(link.ref.slot));
+			ok = false;
+			continue;
+		}
+		const float distance = actor->Position().distance_to(tv.position);
+		g_host->log.line("travel-arrival slot=%u actor=%u entity=%I64u level=%s pos=%.2f,%.2f,%.2f distance=%.2f alive=%d "
+			"entry=%.2f,%.2f,%.2f",
+			u32(link.ref.slot), u32(actor->ID()), entity_of(u16(actor->ID())), Level().name().c_str(),
+			VPUSH(actor->Position()), distance, actor->g_Alive() ? 1 : 0, VPUSH(link.entry));
+		++arrived;
+	}
+	g_host->log.line("travel-reloaded id=%I64x generation=%u level=%s arrived=%u ok=%d", tv.exec_id,
+		tv.destination_generation, Level().name().c_str(), arrived, ok ? 1 : 0);
+	travel_csv("reloaded", 0, 0, tv.exec_id, 0, Level().name().c_str(), "");
+	++tv.reloads;
+	tv.exec = 0;
+	tv.exec_id = 0;
+	tv.reload_requested = false;
+	log_status("reloaded");
+	return ok;
+}
