+// co-op client evaluates no task, S08-T09).
+void put_party_task(std::vector<u8>& p, LPCSTR id, u8 state, s32 count, s32 need)
+{
+	CGameTask* t = Level().GameTaskManager().HasGameTask(shared_str(id), false);
+	put_str(p, id);
+	put_u8(p, state);
+	put_u16(p, u16(s16(_max(-1, _min(count, 30000)))));
+	put_u16(p, u16(s16(_max(-1, _min(need, 30000)))));
+	put_str(p, t ? t->m_Title.c_str() : "");
+	put_str(p, t ? t->m_Description.c_str() : "");
+	put_str(p, t ? t->GetIconName_script() : "");
+	put_str(p, t ? t->GetMapLocation_script() : "");
+	put_u16(p, t ? t->GetMapObjectID_script() : u16(0xffff));
+	put_u32(p, t ? t->m_priority : 0);
