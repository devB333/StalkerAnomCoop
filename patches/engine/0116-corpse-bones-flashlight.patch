+		light->coop_motion_state(motion, end_tm, running);
+	attachable_hud_item* h0 = g_player_hud ? g_player_hud->attached_item(0) : nullptr;
+	attachable_hud_item* h1 = g_player_hud ? g_player_hud->attached_item(1) : nullptr;
+	PIItem active = actor ? actor->inventory().ActiveItem() : nullptr;
+	g_link->log.line("flashlight-test press=%u who=%s actor=%u slot9=%s state=%u working=%d hud=%d visible=%d pending=%d "
+		"motion=%s running=%d end_in_ms=%d processing=%d active=%s hands=%s,%s paused=%d time_global=%u continual=%u "
+		"frame=%u factor=%.3f remote_on=%d", press, who,
+		actor ? u32(actor->ID()) : 0xffffu, item ? item->object().cNameSect().c_str() : "none",
+		light ? light->GetState() : 0xffu, light && light->torch_active() ? 1 : 0,
+		light && light->HudItemData() ? 1 : 0, item && item->object().getVisible() ? 1 : 0,
+		light && light->IsPending() ? 1 : 0, motion, running ? 1 : 0, int(end_tm) - int(Device.dwTimeGlobal),
+		item && item->object().processing_enabled() ? 1 : 0, active ? active->object().cNameSect().c_str() : "none",
+		h0 && h0->m_parent_hud_item ? h0->m_parent_hud_item->object().cNameSect().c_str() : "-",
+		h1 && h1->m_parent_hud_item ? h1->m_parent_hud_item->object().cNameSect().c_str() : "-",
+		Device.Paused() ? 1 : 0, Device.dwTimeGlobal, Device.dwTimeContinual, Device.dwFrame, Device.time_factor(),
+		light && light->coop_remote_on() ? 1 : 0);
+}
+
+// B55 driver: the detector key (kDETECTOR, as installed: CCustomDevice::ToggleDevice shows the detector slot's
+// device) at N s and again 12 s later; the own and the partner's flashlight logged each second for 5 s after
+void flashlight_test_frame()
+{
+	static u32 presses = 0;
+	static u64 last_line_ms = 0;
+	if (!g_link->config.flashlight_test || g_link->world != WorldLive || !g_actor)
+		return;
+	const u64 now = g_link->wall.GetElapsed_ms();
+	const u64 start = g_link->live_ms + u64(g_link->config.flashlight_test) * 1000;
+	if (presses < 2 && now >= start + presses * 12000)
+	{
+		++presses;
+		g_actor->IR_OnKeyboardPress(kDETECTOR);
+		g_actor->IR_OnKeyboardRelease(kDETECTOR);
+		g_link->log.line("flashlight-test press=%u sent=kDETECTOR", presses);
+		last_line_ms = now;
+		return;
+	}
+	if (!presses || now - last_line_ms < 1000 || now > start + (presses - 1) * 12000 + 5000)
+		return;
+	last_line_ms = now;
+	flashlight_line("own", g_actor, presses);
+	for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+		if (CActor* other = smart_cast<CActor*>(Level().Objects.o_get_by_iterator(i)))
+			if (other != g_actor && other->g_Alive())
+				flashlight_line("other", other, presses);
+}
