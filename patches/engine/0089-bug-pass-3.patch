+// correction's hop, so CanJump/PhysicsCanJump refused the held key): take the
+// same jump now, instead of being hoisted by every correction and slammed
+// back by the ground force until the server lands
+void CActor::replica_follow_jump(const Fvector& velocity)
+{
+	mstate_real |= mcJump;
+	m_bJumpKeyPressed = TRUE;
+	m_fJumpTime = s_fJumpTime;
+	character_physics_support()->movement()->JumpForced(velocity);
