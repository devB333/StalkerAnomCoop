@@ -0,0 +1,337 @@
+#include "pch_script.h"
+#include "CampaignIdentityFixture.h"
+#include "CampaignIdentity.h"
+#include "CampaignActorAccess.h"
+#include "CampaignServerLighting.h"
+
+// S03-T06: the server light model fixtures.
+//
+//  - Snapshot (server, 500 ticks after the second checkpoint restore; client,
+//    from the same checkpoint ten seconds after its actor spawned): one row per actor
+//    with the environment (game time, weather, sun direction and colour,
+//    ambient, sky colour, far plane), the actor's position and eye, and the
+//    luminosity and sky term AI vision reads. tools/compare-lighting-capture.py
+//    compares the server row with the client's.
+//  - Level fixture (GameState, after the script-context fixture): over 200
+//    ticks both participant actors are tracked every tick, one object in each
+//    view in turn; both luminosities are lit (above the 0.001 darkness floor,
+//    at least the environment's ambient, at most 1); the environment blend
+//    never failed; and an online stalker's visual memory now reads each actor
+//    brighter than darkness (CVisualMemoryManager::object_luminocity).
+//
+// CSV rows (s03-t06-lighting.csv, s03-t06-lighting-snapshot.csv):
+//   light,<label>,<frame>,<game_time_s>,<weather>,<sun_dir xyz>,<sun_color xyz>,<ambient xyz>,<hemi_color xyz>,
+//         <far_plane>,<actor>,<pos xyz>,<eye xyz>,<luminocity>,<hemi>
+//   ai,<label>,<observer>,<actor>,<luminocity>,<object_luminocity>,<darkness_floor>,<ratio>
+//   stats,<name>,<value>
+//   check,<ok>,<what>
+//   end,<ticks>,<sim_ms>,<wall_ms>,<checks>,<failures>,<ok>
+
+#include "Level.h"
+#include "Actor.h"
+#include "ai_space.h"
+#include "CustomMonster.h"
+#include "memory_manager.h"
+#include "visual_memory_manager.h"
+#include "../xrEngine/CameraBase.h"
+#include "../Include/xrRender/RenderVisual.h"
+#include "../xrEngine/IGame_Persistent.h"
+#include "../xrEngine/Environment.h"
+#include "../xrEngine/device.h"
+#include "../xrEngine/xr_ioconsole.h"
+
+using namespace campaign;
+
+namespace
+{
+const u32 fixture_ticks = 200;
+
+FILE* open_csv(LPCSTR path, LPCSTR mode)
+{
+	return path && path[0] ? fopen(path, mode) : nullptr;
+}
+
+void light_row(FILE* out, LPCSTR label, CActor* actor)
+{
+	if (!out || !actor || !g_pGamePersistent)
+		return;
+	CEnvironment& env = g_pGamePersistent->Environment();
+	const CEnvDescriptorMixer* e = env.CurrentEnv;
+	const CCameraBase* camera = actor->cam_Active();
+	const Fvector eye = camera ? camera->vPosition : actor->Position();
+	const Fvector pos = actor->Position();
+	// The point CROS_impl::update samples from: the visual's bounding-sphere
+	// centre in world space, raised by 0.3 of its radius (LightTrack.cpp:192-196).
+	Fvector sample = pos;
+	float radius = 0.f;
+	if (IRenderVisual* visual = actor->Visual())
+	{
+		const vis_data& vis = visual->getVisData();
+		actor->XFORM().transform_tiny(sample, vis.sphere.P);
+		radius = vis.sphere.R;
+		sample.y += .3f * radius;
+	}
+	fprintf(out,
+		"light,%s,%u,%.1f,%s,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.1f,%u,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.4f,%.4f,%.3f,%.3f,%.3f,%.3f\n",
+		label, Device.dwFrame, env.GetGameTime(), env.GetWeather().c_str() ? env.GetWeather().c_str() : "-",
+		e ? e->sun_dir.x : 0.f, e ? e->sun_dir.y : 0.f, e ? e->sun_dir.z : 0.f, e ? e->sun_color.x : 0.f,
+		e ? e->sun_color.y : 0.f, e ? e->sun_color.z : 0.f, e ? e->ambient.x : 0.f, e ? e->ambient.y : 0.f,
+		e ? e->ambient.z : 0.f, e ? e->hemi_color.x : 0.f, e ? e->hemi_color.y : 0.f, e ? e->hemi_color.z : 0.f,
+		e ? e->far_plane : 0.f, u32(actor->ID()), VPUSH(pos), VPUSH(eye), actor_luminocity(actor),
+		actor_luminocity_hemi(actor), VPUSH(sample), radius);
+	fflush(out);
+	Msg("S03-T06 %s actor %u luminocity=%.4f hemi=%.4f game_time=%.0f weather=%s sun_dir=[%.3f,%.3f,%.3f] "
+		"ambient=[%.3f,%.3f,%.3f]",
+		label, u32(actor->ID()), actor_luminocity(actor), actor_luminocity_hemi(actor), env.GetGameTime(),
+		env.GetWeather().c_str() ? env.GetWeather().c_str() : "-", e ? e->sun_dir.x : 0.f, e ? e->sun_dir.y : 0.f,
+		e ? e->sun_dir.z : 0.f, e ? e->ambient.x : 0.f, e ? e->ambient.y : 0.f, e ? e->ambient.z : 0.f);
+}
+
+const char* light_header =
+	"kind,label,frame,game_time_s,weather,sun_dir_x,sun_dir_y,sun_dir_z,sun_r,sun_g,sun_b,ambient_r,ambient_g,"
+	"ambient_b,hemi_r,hemi_g,hemi_b,far_plane,actor,x,y,z,eye_x,eye_y,eye_z,luminocity,hemi,sample_x,sample_y,sample_z,"
+	"sphere_r\n";
+
+struct Fixture
+{
+	bool running = false;
+	bool ok = true;
+	FILE* out = nullptr;
+	u32 tick = 0;
+	u32 checks = 0;
+	u32 failures = 0;
+	ServerLightingStats before = {};
+	u16 actors[2] = {u16(-1), u16(-1)};
+	float min_lum[2] = {2.f, 2.f};
+	float max_lum[2] = {-1.f, -1.f};
+};
+
+Fixture g_fixture;
+
+bool check(bool condition, LPCSTR what)
+{
+	Fixture& f = g_fixture;
+	++f.checks;
+	if (!condition)
+	{
+		++f.failures;
+		f.ok = false;
+		Msg("! S03-T06 lighting check failed: %s", what);
+	}
+	if (f.out)
+	{
+		fprintf(f.out, "check,%d,%s\n", condition ? 1 : 0, what);
+		fflush(f.out);
+	}
+	return condition;
+}
+
+CActor* actor_by_id(u16 id)
+{
+	if (id == u16(-1) || !g_pGameLevel)
+		return nullptr;
+	CObject* object = Level().Objects.net_Find(id);
+	return object && !object->getDestroy() ? smart_cast<CActor*>(object) : nullptr;
+}
+
+// The nearest alive online stalker or monster to the actor: its visual
+// memory's reading of the actor.
+CCustomMonster* nearest_observer(CActor* actor)
+{
+	CCustomMonster* best = nullptr;
+	float best_d = flt_max;
+	for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+	{
+		CCustomMonster* m = smart_cast<CCustomMonster*>(Level().Objects.o_get_by_iterator(i));
+		if (!m || m->getDestroy() || !m->g_Alive())
+			continue;
+		const float d = m->Position().distance_to(actor->Position());
+		if (d < best_d)
+		{
+			best_d = d;
+			best = m;
+		}
+	}
+	return best;
+}
+
+void ai_row(CActor* actor)
+{
+	Fixture& f = g_fixture;
+	CCustomMonster* observer = nearest_observer(actor);
+	if (!observer)
+	{
+		check(false, "an online stalker or monster observes the actor");
+		return;
+	}
+	const float lum = actor_luminocity(actor);
+	const float seen = observer->memory().visual().object_luminocity(actor);
+	// object_luminocity = exp(log(max(lum, .001)) * factor): recover the
+	// observer's factor and the value it would read in darkness.
+	const float clamped = lum > .001f ? lum : .001f;
+	const float factor = (clamped < .999f) ? log(seen) / log(clamped) : 0.f;
+	const float floor = exp(log(.001f) * factor);
+	const float ratio = floor > 0.f ? seen / floor : 0.f;
+	if (f.out)
+		fprintf(f.out, "ai,%s,%u,%u,%.4f,%.4f,%.4f,%.2f\n", *observer->cName(), u32(observer->ID()), u32(actor->ID()),
+			lum, seen, floor, ratio);
+	Msg("S03-T06 observer %s (%u) reads actor %u: luminocity %.4f -> visibility scale %.4f (darkness %.4f, x%.1f)",
+		*observer->cName(), u32(observer->ID()), u32(actor->ID()), lum, seen, floor, ratio);
+	string128 what;
+	xr_sprintf(what, "the nearest observer reads actor %u brighter than darkness", u32(actor->ID()));
+	check(seen > floor * 1.5f, what);
+}
+
+void stat_rows(LPCSTR tag)
+{
+	Fixture& f = g_fixture;
+	const ServerLightingStats& s = server_lighting_stats();
+	if (!f.out)
+		return;
+	fprintf(f.out, "stats,%s_frames,%I64u\nstats,%s_env_updates,%I64u\nstats,%s_env_failures,%I64u\n"
+		"stats,%s_actor_tracks,%I64u\nstats,%s_view_picks,%I64u\nstats,%s_view_tracks,%I64u\n"
+		"stats,%s_view_skipped,%I64u\nstats,%s_view_empty,%I64u\n"
+		"stats,%s_qpc_total,%I64u\nstats,%s_view_count_0,%u\nstats,%s_view_count_1,%u\n",
+		tag, s.frames, tag, s.env_updates, tag, s.env_failures, tag, s.actor_tracks, tag, s.view_picks, tag,
+		s.view_tracks, tag, s.view_skipped, tag, s.view_empty, tag, s.qpc_total, tag, s.last_view_count[0], tag,
+		s.last_view_count[1]);
+	fflush(f.out);
+}
+} // namespace
+
+// Server: one row per participant actor (the restored checkpoint).
+extern "C" bool __cdecl xrCampaignLevel_LightingSnapshot(LPCSTR out_path, LPCSTR label)
+{
+	FILE* out = open_csv(out_path, "w");
+	if (!out)
+		return false;
+	fputs(light_header, out);
+	xr_vector<CActor*> actors;
+	participant_actors(actors);
+	for (CActor* actor : actors)
+		light_row(out, label, actor);
+	fclose(out);
+	report_server_lighting(label);
+	return !actors.empty() && actor_luminocity(actors.front()) > .001f;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_LightingBegin(LPCSTR out_path)
+{
+	Fixture& f = g_fixture;
+	f = Fixture();
+	f.out = open_csv(out_path, "w");
+	if (f.out)
+		fputs(light_header, f.out);
+	f.running = true;
+	f.before = server_lighting_stats();
+	xr_vector<CActor*> actors;
+	participant_actors(actors);
+	check(actors.size() == 2, "two participant actors are live");
+	for (u32 i = 0; i < actors.size() && i < 2; ++i)
+		f.actors[i] = actors[i]->ID();
+	check(f.before.frames > 0 && f.before.actor_tracks > 0, "the light model has run since the level loaded");
+	for (CActor* actor : actors)
+		light_row(f.out, "begin", actor);
+	return f.ok;
+}
+
+extern "C" void __cdecl xrCampaignLevel_LightingTick()
+{
+	Fixture& f = g_fixture;
+	if (!f.running)
+		return;
+	++f.tick;
+	for (u32 i = 0; i < 2; ++i)
+		if (CActor* actor = actor_by_id(f.actors[i]))
+		{
+			const float lum = actor_luminocity(actor);
+			f.min_lum[i] = _min(f.min_lum[i], lum);
+			f.max_lum[i] = _max(f.max_lum[i], lum);
+		}
+	if (f.tick >= fixture_ticks)
+		f.running = false;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_LightingDone()
+{
+	return !g_fixture.running;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_LightingEnd(u32 ticks, u32 sim_ms, u32 wall_ms)
+{
+	Fixture& f = g_fixture;
+	const ServerLightingStats& s = server_lighting_stats();
+	const u64 frames = s.frames - f.before.frames;
+	check(frames >= ticks, "the light model ran every tick");
+	check(s.actor_tracks - f.before.actor_tracks >= 2 * frames, "both participant actors were tracked every tick");
+	check(s.view_picks - f.before.view_picks == s.actor_tracks - f.before.actor_tracks,
+		"one pick in each participant's view every tick it was tracked");
+	check(s.view_tracks > f.before.view_tracks, "objects in the participants' views were updated");
+	check(s.env_failures == f.before.env_failures, "the environment blend never failed");
+	const CEnvDescriptorMixer* e = g_pGamePersistent->Environment().CurrentEnv;
+	const float ambient = e ? _max(e->ambient.x, _max(e->ambient.y, e->ambient.z)) : 0.f;
+	check(e && e->sun_dir.y < 0.f, "the sun direction is valid (pointing down)");
+	for (u32 i = 0; i < 2; ++i)
+	{
+		CActor* actor = actor_by_id(f.actors[i]);
+		if (!actor)
+		{
+			check(false, "the participant actor is still live");
+			continue;
+		}
+		light_row(f.out, "end", actor);
+		const float lum = actor_luminocity(actor);
+		string128 what;
+		xr_sprintf(what, "actor %u is lit: luminocity above the darkness floor and at most 1 over the run",
+			u32(actor->ID()));
+		check(f.min_lum[i] > .001f && f.max_lum[i] <= 1.f, what);
+		xr_sprintf(what, "actor %u's luminocity is at least the environment's ambient", u32(actor->ID()));
+		check(lum + 1e-3f >= _min(ambient, 1.f), what);
+		ai_row(actor);
+	}
+	stat_rows("run");
+	const double us = frames ? double(s.qpc_total - f.before.qpc_total) * 1e6 / double(CPU::qpc_freq) / double(frames) : 0.0;
+	if (f.out)
+		fprintf(f.out, "stats,per_tick_us,%.2f\nend,%u,%u,%u,%u,%u,%d\n", us, ticks, sim_ms, wall_ms, f.checks,
+			f.failures, f.ok ? 1 : 0);
+	Msg("S03-T06 lighting ticks=%u per_tick_us=%.2f checks=%u failures=%u", ticks, us, f.checks, f.failures);
+	report_server_lighting("lighting-fixture");
+	if (f.out)
+	{
+		fclose(f.out);
+		f.out = nullptr;
+	}
+	return f.ok;
+}
+
+// Normal client, -s03-lighting-capture: ten seconds after the actor is in the
+// loaded level (the smoothed terms have settled), the same row for the view
+// actor, then quit.
+void ClientLightingCaptureOnFrame()
+{
+	static const bool run = strstr(Core.Params, "-s03-lighting-capture") != nullptr;
+	static u32 since = 0;
+	static bool done = false;
+	if (!run || done || !g_pGameLevel || !g_pGameLevel->bReady || !g_actor || Device.dwPrecacheFrame)
+		return;
+	if (!since)
+	{
+		since = Device.dwTimeGlobal;
+		return;
+	}
+	if (Device.dwTimeGlobal - since < 10000) // steady state, as the server's 500 ticks
+		return;
+	string_path path;
+	FS.update_path(path, "$logs$", "s03-t06-lighting-snapshot.csv");
+	FILE* out = open_csv(path, "w");
+	if (out)
+	{
+		fputs(light_header, out);
+		light_row(out, "client-restored", g_actor);
+		fclose(out);
+	}
+	done = true;
+	Msg("S03-T06 client lighting capture written to %s", path);
+	FlushLog();
+	Console->Execute("quit");
+}
