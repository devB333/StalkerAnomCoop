+// S10-T03d: see "Guides, fast travel and the backpack"
+bool coop_server_relocate(u8 slot, const Fvector& position, u32 level_vertex, u16 game_vertex)
+{
+	if (!g_host || !g_host->started)
+		return false;
+	for (PlayerLink& l : g_host->links)
+	{
+		if (!l.bound || l.ref.slot != slot)
+			continue;
+		const u32 minutes = l.pending_skip_tick == g_host->tick ? l.pending_skip_minutes : 0;
+		const s32 fee = l.pending_fee_tick == g_host->tick ? l.pending_fee : 0;
+		l.pending_skip_minutes = 0;
+		l.pending_fee = 0;
+		u64 id = 0;
+		const u16 reason = relocate_propose(l, position, level_vertex, game_vertex, minutes, fee, 4, 0, id);
+		if (reason)
+		{
+			// refused: nothing moves, no time passes, the fee goes back
+			if (fee > 0)
+				if (CActor* a = participant_actor(l.ref))
+				{
+					string128 chunk;
+					xr_sprintf(chunk, "if db.actor then db.actor:give_money(%d) end", fee);
+					sleep_lua(a, chunk, "relocate-refund");
+				}
+			g_host->log.line("relocate-refused slot=%u reason=%u gvid=%u lvid=%u source=4 fee_refunded=%d", u32(slot),
+				u32(reason), u32(game_vertex), level_vertex, fee);
+			return false;
+		}
+		return true;
+	}
+	return false;
+}
+
+void coop_server_defer_skip(u8 slot, u32 minutes)
+{
+	if (!g_host)
+		return;
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot == slot)
+		{
+			l.pending_skip_minutes += minutes;
+			l.pending_skip_tick = g_host->tick;
+			g_host->log.line("time-skip-held slot=%u minutes=%u", u32(slot), minutes);
+			return;
+		}
+	// no such player: as the script asked
+	apply_game_time_minutes(minutes, false);
+}
+
+void coop_server_note_fee(u8 slot, s32 amount)
+{
+	if (!g_host)
+		return;
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot == slot)
+		{
+			l.pending_fee = l.pending_fee_tick == g_host->tick ? l.pending_fee + amount : amount;
+			l.pending_fee_tick = g_host->tick;
+			return;
