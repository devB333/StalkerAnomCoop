+// --- dialogue ---------------------------------------------------------------------
+
+Refusal dialogue_open(CActor* actor, CInventoryOwner* partner, bool disable_break)
+{
+	if (!server_role())
+		return Refusal::WrongRole;
+	if (!actor || !partner)
+		return Refusal::InvalidIdentity;
+	ScriptContextScope scope(static_cast<const CObject*>(actor), "dialogue-open");
+	if (!scope.entered())
+		return scope.refusal();
+	if (!partner->OfferTalk(actor))
+		return Refusal::NotAttached; // the partner does not talk now
+	actor->StartTalk(partner);
+	luabind::functor<void> menu_mode;
+	if (ai().script_engine().functor("pda.actor_menu_mode", menu_mode))
+		menu_mode(10);
+	CGameObject* partner_object = object_of(partner);
+	present_to_actor(actor, Presentation::DialogOpen, partner_object ? partner_object->ID() : 0,
+		disable_break ? "no-break" : "");
+	return Refusal::None;
+}
+
+Refusal dialogue_close(CActor* actor, CInventoryOwner* partner)
+{
+	if (!server_role())
+		return Refusal::WrongRole;
+	if (!actor || !partner)
+		return Refusal::InvalidIdentity;
+	ScriptContextScope scope(static_cast<const CObject*>(actor), "dialogue-close");
+	if (!scope.entered())
+		return scope.refusal();
+	luabind::functor<void> menu_mode;
+	if (ai().script_engine().functor("pda.actor_menu_mode", menu_mode))
+		menu_mode(11);
+	actor->StopTalk();
+	partner->StopTalk();
+	CGameObject* partner_object = object_of(partner);
+	present_to_actor(actor, Presentation::DialogClose, partner_object ? partner_object->ID() : 0, "");
+	return Refusal::None;
+}
