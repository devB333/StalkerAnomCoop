+		"  local S = rawget(_G, '__campaign_ctx')\n"
+		"  if not S then return nil end\n"
+		"  return { installed = S.installed == true, depth = S.depth, audit = S.audit == true, wrapped = S.wrapped,\n"
+		"    storage_created = S.storage_created, deferred_captured = S.deferred_captured,\n"
+		"    deferred_refused = S.deferred_refused, host_read_total = S.host_read_total }\n"
+		"end\n";
+	if (luaL_loadbuffer(L, source, xr_strlen(source), "s03_t05") != 0 || lua_pcall(L, 0, 0, 0) != 0)
+	{
+		Msg("! S03-T05 fixture Lua failed: %s", lua_tostring(L, -1));
+		lua_pop(L, 1);
+		return false;
+	}
+	return true;
+}
+
+luabind::object call(LPCSTR function, LPCSTR arg)
+{
+	luabind::functor<luabind::object> f;
+	if (!ensure_lua() || !ai().script_engine().functor(function, f))
+		return lua_nil();
+	return f(arg);
+}
+
+luabind::object call2(LPCSTR function, LPCSTR arg, int arg2)
+{
+	luabind::functor<luabind::object> f;
+	if (!ensure_lua() || !ai().script_engine().functor(function, f))
+		return lua_nil();
+	return f(arg, arg2);
+}
+
+int field_int(const luabind::object& t, LPCSTR key, int fallback = -1)
+{
+	if (t.type() != LUA_TTABLE)
+		return fallback;
+	luabind::object v = t[key];
+	if (v.type() == LUA_TNUMBER)
+		return int(luabind::object_cast<float>(v));
+	return fallback;
+}
+
+bool field_bool(const luabind::object& t, LPCSTR key)
+{
+	if (t.type() != LUA_TTABLE)
+		return false;
+	luabind::object v = t[key];
+	return v.type() == LUA_TBOOLEAN && luabind::object_cast<bool>(v);
+}
+
+void field_str(const luabind::object& t, LPCSTR key, string128& out)
+{
+	out[0] = 0;
+	if (t.type() != LUA_TTABLE)
+		return;
+	luabind::object v = t[key];
+	if (v.type() == LUA_TSTRING)
+		xr_strcpy(out, luabind::object_cast<LPCSTR>(v));
+}
+
+struct Probe
+{
+	bool in_context;
+	int slot;
+	int generation;
+	string128 origin;
+	string128 entry;
+	string128 party;
+	int actor;
+	int db_actor;
+	int ac_id;
+	string128 marker;
+	bool presented;
+	float effector;
+};
+
+Probe probe(LPCSTR label)
+{
+	Probe p;
+	luabind::object r = call("s03_t05.probe", label);
+	p.in_context = field_bool(r, "in_context");
+	p.slot = field_int(r, "slot");
+	p.generation = field_int(r, "generation");
+	field_str(r, "origin", p.origin);
+	field_str(r, "entry", p.entry);
+	field_str(r, "party", p.party);
+	p.actor = field_int(r, "actor");
+	p.db_actor = field_int(r, "db_actor");
+	p.ac_id = field_int(r, "ac_id");
+	field_str(r, "marker", p.marker);
+	p.presented = field_bool(r, "presented");
+	p.effector = 0.f;
+	if (r.type() == LUA_TTABLE)
+	{
+		luabind::object e = r["effector"];
+		if (e.type() == LUA_TNUMBER)
+			p.effector = luabind::object_cast<float>(e);
+	}
+	const Fixture& f = g_fixture;
+	row("probe,%s,%d,%d,%d,%s,%s,%d,%d,%d,%s,%d,%.3f,%u,%u,%u,%u", label, p.in_context ? 1 : 0, p.slot, p.generation,
+		p.origin, p.entry, p.actor, p.db_actor, p.ac_id, p.marker[0] ? p.marker : "-", p.presented ? 1 : 0, p.effector,
+		money_of(f.actor1), money_of(f.actor2), outbox_size(f.p1.slot), outbox_size(f.p2.slot));
+	return p;
+}
+
+void uuid_text(const Uuid128& id, string128& out)
+{
+	xr_sprintf(out, "%016I64x%016I64x", id.hi, id.lo);
+}
+
+// --- phase 1: contract ---------------------------------------------------------------
+void phase_contract()
+{
+	Fixture& f = g_fixture;
+	string128 party1_text;
+	uuid_text(f.party1, party1_text);
+	check(script_compat_installed(), "the compatibility layer is installed on the server");
+	luabind::object compat = call("s03_t05.compat", "");
+	check(field_int(compat, "wrapped", 0) == 3, "it wrapped AC_ID, CreateTimeEvent and CGeneralTask.check_task");
+	check(field_bool(compat, "audit"), "the db.actor audit is on while two participant actors live");
+
+	const u32 m1 = money_of(f.actor1), m2 = money_of(f.actor2);
+	const u32 o1 = outbox_size(f.p1.slot), o2 = outbox_size(f.p2.slot);
+	const ScriptContextStats before = script_context_stats();
+
+	// No context: strict lookups return nothing; db.actor is the host's (compat).
+	Probe none = probe("none");
+	check(!none.in_context && none.slot == -1 && none.actor == -1, "outside a context campaign.* names nobody");
+	check(none.db_actor == int(f.actor1), "outside a context db.actor is the single-player script actor (counted)");
+	check(none.ac_id == 0, "outside a context AC_ID is the single-player value 0");
+	check(script_context_stats().lua_no_context > before.lua_no_context, "...and the strict lookups counted no context");
+	check(money_of(f.actor1) == m1 && money_of(f.actor2) == m2, "the probe changed no money without a context");
+	check(outbox_size(f.p1.slot) == o1 && outbox_size(f.p2.slot) == o2, "and presented nothing");
+
+	// Participant 1, server-internal.
+	{
+		ScriptContextScope scope(f.ctx1, Scope::Self, "s03-t05-probe-1");
+		check(scope.entered(), "participant 1's server-internal context enters");
+		Probe p = probe("p1");
+		check(p.in_context && p.slot == int(f.p1.slot) && p.generation == int(f.p1.generation),
+			"participant 1's context names participant 1");
+		check(p.actor == int(f.actor1) && p.db_actor == int(f.actor1) && p.ac_id == int(f.actor1),
+			"...its actor is actor 1, and so are db.actor and AC_ID");
+		check(!xr_strcmp(p.origin, "server-internal") && !xr_strcmp(p.entry, "s03-t05-probe-1"), "...server-internal");
+		check(!xr_strcmp(p.party, party1_text), "...in participant 1's party");
+		check(!xr_strcmp(p.marker, "p1") && p.presented && p.effector > 0.f, "the action ran on actor 1");
+	}
+	check(money_of(f.actor1) == m1 + 1 && money_of(f.actor2) == m2, "1 RU went to actor 1 only");
+	check(outbox_size(f.p1.slot) == o1 + 3 && outbox_size(f.p2.slot) == o2,
+		"participant 1 got the news, the talk message and the camera effector; participant 2 nothing");
+
+	// Participant 2, a client intent on its session.
+	{
+		ScriptContextScope scope(f.ctx2, Scope::Self, "s03-t05-probe-2");
+		check(scope.entered(), "participant 2's client intent enters its context");
+		Probe p = probe("p2");
+		check(p.in_context && p.slot == int(f.p2.slot) && p.generation == int(f.p2.generation),
+			"participant 2's context names participant 2");
+		check(p.actor == int(f.actor2) && p.db_actor == int(f.actor2) && p.ac_id == int(f.actor2),
+			"...its actor is actor 2, and so are db.actor and AC_ID");
+		check(!xr_strcmp(p.origin, "client-intent"), "...a client intent");
+		check(!xr_strcmp(p.marker, "p2") && p.presented && p.effector > 0.f, "the action ran on actor 2");
+	}
+	check(money_of(f.actor1) == m1 + 1 && money_of(f.actor2) == m2 + 1, "1 RU went to actor 2 only");
+	check(outbox_size(f.p1.slot) == o1 + 3 && outbox_size(f.p2.slot) == o2 + 3, "participant 2 got its three");
+
+	// Nested: both contexts coexist; the inner one is current, the outer returns.
+	{
+		ScriptContextScope outer(f.ctx1, Scope::Self, "s03-t05-outer");
+		{
+			ScriptContextScope inner(f.ctx2, Scope::Self, "s03-t05-inner");
+			Probe p = probe("inner");
+			check(inner.entered() && p.actor == int(f.actor2) && p.db_actor == int(f.actor2),
+				"inside participant 1's context, participant 2's inner context is current");
+		}
+		Probe p = probe("outer");
+		check(outer.entered() && p.actor == int(f.actor1) && p.db_actor == int(f.actor1),
+			"after the inner context left, participant 1's is current and db.actor is actor 1 again");
+	}
+
+	// Refusals: nothing is entered, so nothing runs as anybody.
+	const u32 depth_before = script_contexts() ? script_contexts()->depth() : 0;
+	{
+		ScriptContextScope s(make_context(Origin::ClientIntent, session2, f.p1, f.party1), Scope::Self, "s03-t05-forged");
+		expect_refusal(s.refusal(), Refusal::NotAuthoritative, "participant 2's session naming participant 1");
+	}
+	{
+		ScriptContextScope s(make_context(Origin::ClientIntent, 0x5303dead, f.p2, f.party2), Scope::Self, "s03-t05-unknown");
+		expect_refusal(s.refusal(), Refusal::UnknownSession, "an unknown session");
+	}
+	if (IClient* bridge = Level().Server ? Level().Server->GetServerClient() : nullptr)
+	{
+		ScriptContextScope s(make_context(Origin::ClientIntent, bridge->ID.value(), f.p1, f.party1), Scope::Self,
+			"s03-t05-bridge");
+		expect_refusal(s.refusal(), Refusal::BridgeNotParticipant, "the bridge session");
+	}
+	else
+		check(false, "the server has a bridge client to test");
+	{
+		ParticipantRef stale = f.p2;
+		++stale.generation;
+		ScriptContextScope s(make_context(Origin::ServerInternal, 0, stale, f.party2), Scope::Self, "s03-t05-stale");
+		expect_refusal(s.refusal(), Refusal::StaleReference, "a stale participant reference");
+	}
+	{
+		ScriptContextScope s(make_context(Origin::ServerInternal, 0, f.p1, party_id(2)), Scope::Party, "s03-t05-party");
+		expect_refusal(s.refusal(), Refusal::WrongParty, "a party context naming another party");
+	}
+	{
+		ScriptContextScope s(f.ctx1, Scope::World, "s03-t05-world");
+		expect_refusal(s.refusal(), Refusal::NotAuthoritative, "world scope as a script context");
+	}
+	{
+		ScriptContextScope s(make_context(Origin::ClientIntent, session2, f.p2, f.party2), Scope::World, "s03-t05-intent-world");
+		expect_refusal(s.refusal(), Refusal::NotAuthoritative, "a client intent in world scope");
+	}
+	check(script_contexts() && script_contexts()->depth() == depth_before && depth_before == 0,
+		"no refused context was entered");
+	check(field_int(call("s03_t05.compat", ""), "depth", -1) == 0, "the Lua layer saw no context left behind");
+	{
+		luabind::functor<luabind::object> marker;
+		ai().script_engine().functor("s03_t05.marker", marker);
+		luabind::object m1 = marker(int(f.actor1));
+		luabind::object m2 = marker(int(f.actor2));
+		row("markers,%s,%s", m1.type() == LUA_TSTRING ? luabind::object_cast<LPCSTR>(m1) : "-",
+			m2.type() == LUA_TSTRING ? luabind::object_cast<LPCSTR>(m2) : "-");
+		check(m1.type() == LUA_TSTRING && !xr_strcmp(luabind::object_cast<LPCSTR>(m1), "outer"),
+			"actor 1's portable store holds the last marker written in participant 1's context");
+		check(m2.type() == LUA_TSTRING && !xr_strcmp(luabind::object_cast<LPCSTR>(m2), "inner"),
+			"actor 2's holds the last one written in participant 2's");
+	}
+	luabind::functor<luabind::object> db_actor_id;
+	ai().script_engine().functor("s03_t05.db_actor_id", db_actor_id);
+	luabind::object host = db_actor_id();
+	check(host.type() == LUA_TNUMBER && int(luabind::object_cast<float>(host)) == int(f.actor1),
+		"outside any context db.actor is the single-player script actor again");
+
+	// Deferred work: one event in each context, one outside any.
+	{
+		ScriptContextScope scope(f.ctx1, Scope::Self, "s03-t05-defer-1");
+		call("s03_t05.defer", "p1");
+	}
+	{
+		ScriptContextScope scope(f.ctx2, Scope::Self, "s03-t05-defer-2");
+		call("s03_t05.defer", "p2");
+	}
+	call("s03_t05.defer", "none");
+}
+
