+// B45: a player's pending weapon change is completed by its inventory's
+// update (CInventory::Update, from CActor::UpdateCL). demo-17: after a
+// travel both actors kept the change pending (active 0, next 2/3) for good
+// while the server accepted every later slot intent. A participant actor
+// whose own update has not run for 10 frames with a change pending gets its
+// inventory updated here (counted, logged once per actor and frame gap)
+void kick_stalled_inventories()
+{
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		if (!actor || !actor->g_Alive())
+			continue;
+		CInventory& inv = actor->inventory();
+		if (inv.GetActiveSlot() == inv.GetNextActiveSlot())
+			continue;
+		const u32 age = Device.dwFrame - actor->dwFrame_UpdateCL;
+		if (age < 10)
+			continue;
+		if (!link.inventory_kicked)
+			log_actor_weapons("kick", u8(link.ref.slot), actor);
+		link.inventory_kicked = true;
+		++g_host->inventory_kicks;
+		inv.Update();
+	}
 }
 
