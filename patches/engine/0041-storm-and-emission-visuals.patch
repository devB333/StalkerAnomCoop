+// The server's environment (kind 2), thunderbolts (kind 3) and the installed
+// scripts' presentation (kind 4); see CoopServerHost.cpp and
+// docs/validation/S06-T08.md.
+struct PayloadReader
+{
+	const std::vector<u8>& p;
+	size_t at = 0;
+	bool ok = true;
+	explicit PayloadReader(const std::vector<u8>& payload) : p(payload) {}
+	template <typename T> T get()
+	{
+		T v;
+		memset(&v, 0, sizeof(v));
+		if (at + sizeof(v) > p.size())
+		{
+			ok = false;
+			at = p.size();
+			return v;
+		}
+		memcpy(&v, p.data() + at, sizeof(v));
+		at += sizeof(v);
+		return v;
+	}
+	void str(char* out, size_t capacity)
+	{
+		out[0] = 0;
+		const u8 n = get<u8>();
+		if (!ok || at + n > p.size() || n + 1 > capacity)
+		{
+			ok = false;
+			return;
+		}
+		memcpy(out, p.data() + at, n);
+		out[n] = 0;
+		at += n;
+	}
+};
+
+static shared_str descriptor_cycle(CEnvironment& env, const CEnvDescriptor* d)
+{
+	if (!d)
+		return shared_str();
+	for (auto it = env.WeatherCycles.begin(); it != env.WeatherCycles.end(); ++it)
+		for (auto e = it->second.begin(); e != it->second.end(); ++e)
+			if (*e == d)
+				return it->first;
+	return shared_str();
+}
+
+static CEnvDescriptor* find_descriptor(CEnvironment& env, LPCSTR cycle, float exec)
+{
+	if (!cycle || !cycle[0] || exec < 0.f)
+		return nullptr;
+	auto it = env.WeatherCycles.find(shared_str(cycle));
+	if (it == env.WeatherCycles.end())
+		return nullptr;
+	for (CEnvDescriptor* d : it->second)
+		if (fsimilar(d->exec_time, exec, 0.01f))
+			return d;
+	return nullptr;
+}
+
+void on_environment(const coop::proto::CampaignEvent& event)
+{
+	PayloadReader r(event.payload);
+	const u8 flags = r.get<u8>();
+	const float wfx_time = r.get<float>();
+	string256 cycle, weather, c0, c1;
+	r.str(cycle, sizeof(cycle));
+	r.str(weather, sizeof(weather));
+	r.str(c0, sizeof(c0));
+	const float exec0 = r.get<float>();
+	r.str(c1, sizeof(c1));
+	const float exec1 = r.get<float>();
+	if (!r.ok || !_valid(wfx_time) || !_valid(exec0) || !_valid(exec1) || !g_pGamePersistent)
+		return;
+	++g_link->env_events;
+	CEnvironment& env = g_pGamePersistent->Environment();
+	const bool wfx = (flags & 1) != 0;
+	if (wfx)
+	{
+		if (!env.bWFX || xr_strcmp(env.CurrentWeatherName.size() ? *env.CurrentWeatherName : "", weather))
+		{
+			if (env.bWFX && env.CurrentCycleName.size())
+				env.StopWFX();
+			if (cycle[0] && xr_strcmp(env.CurrentCycleName.size() ? *env.CurrentCycleName : "", cycle))
+				env.SetWeather(cycle, false);
+			if ((!env.Current[0] || !env.Current[1]) && cycle[0])
+				env.SetWeather(cycle, true);
+			if (env.WeatherFXs.find(shared_str(weather)) == env.WeatherFXs.end() || !env.Current[0] || !env.Current[1])
+			{
+				g_link->log.line("environment wfx-unknown name=%s", weather);
+				return;
+			}
+			env.StartWeatherFXFromTime(weather, wfx_time);
+			++g_link->wfx_starts;
+			g_link->log.line("environment wfx-start name=%s wfx_time=%.2f cycle=%s", weather, wfx_time, cycle);
+		}
+		else if (_abs(env.wfx_time - wfx_time) > 4.0f && env.CurrentWeather) // above the 3 s clock-step tolerance
+		{
+			// re-aligned: every descriptor of the effect moves by the difference
+			const float delta = wfx_time - env.wfx_time;
+			for (CEnvDescriptor* d : *env.CurrentWeather)
+			{
+				float moved = d->exec_time + delta; // as CEnvironment::NormalizeTime (private)
+				while (moved >= DAY_LENGTH)
+					moved -= DAY_LENGTH;
+				while (moved < 0.f)
+					moved += DAY_LENGTH;
+				d->exec_time = moved;
+			}
+			env.wfx_time = wfx_time;
+			if (++g_link->wfx_shifts <= 20)
+				g_link->log.line("environment wfx-shift delta=%.2f", delta);
+		}
+		return;
+	}
+	if (env.bWFX && env.CurrentCycleName.size())
+	{
+		env.StopWFX();
+		g_link->log.line("environment wfx-stop weather=%s", env.CurrentWeatherName.size() ? *env.CurrentWeatherName : "-");
 	}
-	CEnvironment& environment = g_pGamePersistent->Environment();
-	if (length && xr_strcmp(*environment.CurrentWeatherName, weather))
+	if (cycle[0] && xr_strcmp(env.CurrentCycleName.size() ? *env.CurrentCycleName : "", cycle))
 	{
