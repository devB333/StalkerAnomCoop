+CGameTask* completed_task_of(const QuestRun& q)
+{
+	for (const SGameTaskKey& key : Level().GameTaskManager().GetGameTasks())
+	{
+		CGameTask* t = key.game_task;
+		if (t && t->m_ID == q.task_id && t->GetTaskState() == eTaskStateCompleted && t->m_campaign_owned &&
+			t->m_campaign_owner.slot == q.slot)
+			return t;
+	}
