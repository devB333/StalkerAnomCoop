+// S02-T03c: with -s02-bone-capture the normal client evaluates the same model
+// as the campaign server, in 20 ms steps of its own device time, then quits.
+static void AdvanceClientCaptureTime(void*)
+{
+	Device.dwFrame++;
+	Device.dwTimeDelta = 20;
+	Device.dwTimeGlobal += 20;
+	Device.fTimeDelta = 0.02f;
+	Device.fTimeGlobal = float(Device.dwTimeGlobal) / 1000.f;
+}
+
+static void RunClientBoneCapture()
+{
+	const u32 frame = Device.dwFrame, time = Device.dwTimeGlobal, delta = Device.dwTimeDelta;
+	const float ftime = Device.fTimeGlobal, fdelta = Device.fTimeDelta;
+	string_path out;
+	FS.update_path(out, "$logs$", "s02-t03c-bones.csv");
+	BoneCaptureSummary summary;
+	const bool ok = CaptureModelBones("actors\\stalker_neutral\\stalker_neutral_1", 50,
+		&AdvanceClientCaptureTime, nullptr, out, summary);
+	Msg("S02-T03c client bones motion=%s bones=%u steps=%u max_translation=%.6f finite=%d ok=%d out=%s",
+		summary.motion, summary.bones, summary.steps, summary.max_translation, summary.finite ? 1 : 0,
+		ok ? 1 : 0, out);
+	FlushLog();
+	Device.dwFrame = frame;
+	Device.dwTimeGlobal = time;
+	Device.dwTimeDelta = delta;
+	Device.fTimeGlobal = ftime;
+	Device.fTimeDelta = fdelta;
+	Console->Execute("quit");
+}
