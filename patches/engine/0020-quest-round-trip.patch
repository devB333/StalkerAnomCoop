+bool rule(bool ok, LPCSTR what)
+{
+	Msg("S02-T06e rule %s: %s", ok ? "ok  " : "FAIL", what);
+	return ok;
+}
+
+// The dialogue frame: what using the NPC and opening the talk window does
+// before any phrase (CUsableScriptObject::use -> the stalker binder's
+// use_callback; CActor::RunTalkDialog's OfferTalk/StartTalk; the PDA
+// script's actor_menu_mode(10) on the window showing), and what closing it
+// does (actor_menu_mode(11), StopTalk). The window itself is not shown.
+bool dialog_open(CGameObject* npc)
+{
+	CInventoryOwner* owner = smart_cast<CInventoryOwner*>(npc);
+	if (!owner || !g_actor)
+		return false;
+	const bool used = npc->use(g_actor);
+	const bool offered = owner->OfferTalk(g_actor);
+	if (offered)
+		g_actor->StartTalk(owner);
+	luabind::functor<void> menu_mode;
+	const bool have_menu = ai().script_engine().functor("pda.actor_menu_mode", menu_mode);
+	if (have_menu)
+		menu_mode(10);
+	Msg("S02-T06e dialog open: used=%d offered=%d actor_talking=%d npc_talking=%d menu_mode=%d", used ? 1 : 0,
+		offered ? 1 : 0, g_actor->IsTalking() ? 1 : 0, owner->IsTalking() ? 1 : 0, have_menu ? 1 : 0);
+	return used && offered && have_menu;
+}
+
+void dialog_close(CGameObject* npc)
+{
+	luabind::functor<void> menu_mode;
+	if (ai().script_engine().functor("pda.actor_menu_mode", menu_mode))
+		menu_mode(11);
+	if (g_actor)
+		g_actor->StopTalk();
+	if (CInventoryOwner* owner = smart_cast<CInventoryOwner*>(npc))
+		owner->StopTalk();
+}
+
+// The "any work for me?" phrases: generate the NPC's available tasks, skip
+// until the wanted one is offered (the dialog lets the player skip offers),
+// show the job text (runs on_job_descr and the fetch_func) and accept.
+bool dialog_accept_task(CGameObject* npc)
+{
+	CScriptGameObject* actor_go = g_actor->lua_game_object();
+	CScriptGameObject* npc_go = npc->lua_game_object();
+	luabind::functor<void> generate, skip, give;
+	luabind::functor<bool> has_task;
+	luabind::functor<luabind::object> text;
+	if (!ai().script_engine().functor("dialogs.generate_available_tasks", generate) ||
+		!ai().script_engine().functor("dialogs.npc_has_task", has_task) ||
+		!ai().script_engine().functor("dialogs.npc_skip_task", skip) ||
+		!ai().script_engine().functor("dialogs.text_npc_has_task", text) ||
+		!ai().script_engine().functor("dialogs.npc_give_task", give))
+	{
+		Msg("! S02-T06e dialogs task functions missing");
+		return false;
+	}
+	generate(actor_go, npc_go);
+	g_available_count = 0;
+	{
+		luabind::object list = lua_available_tasks(npc->ID());
+		if (list.type() == LUA_TTABLE)
+			for (int i = 1;; ++i)
+			{
+				luabind::object entry = list[i];
+				if (entry.type() == LUA_TNIL)
+					break;
+				++g_available_count;
+			}
+	}
+	Msg("S02-T06e giver %u offers %u task(s)", npc->ID(), g_available_count);
+	u32 skipped = 0;
+	for (; skipped <= g_available_count; ++skipped)
+	{
+		if (!has_task(actor_go, npc_go))
+			break;
+		luabind::object list = lua_available_tasks(npc->ID());
+		luabind::object first = list.type() == LUA_TTABLE ? luabind::object(list[1]) : lua_nil();
+		if (first.type() == LUA_TSTRING && xr_strcmp(luabind::object_cast<LPCSTR>(first), g_task_id) == 0)
+		{
+			luabind::object job = text(actor_go, npc_go);
+			Msg("S02-T06e offered %s after %u skip(s): \"%s\"", g_task_id, skipped,
+				job.type() == LUA_TSTRING ? luabind::object_cast<LPCSTR>(job) : "-");
+			give(actor_go, npc_go);
+			return true;
+		}
+		Msg("S02-T06e skipping offered task %s", first.type() == LUA_TSTRING ? luabind::object_cast<LPCSTR>(first) : "-");
+		skip(actor_go, npc_go);
+	}
+	Msg("! S02-T06e giver %u never offered %s", npc->ID(), g_task_id);
+	return false;
+}
+
+// The turn-in phrases: the finished-task list and "job done".
+bool dialog_turn_in(CGameObject* npc)
+{
+	CScriptGameObject* actor_go = g_actor->lua_game_object();
+	CScriptGameObject* npc_go = npc->lua_game_object();
+	luabind::functor<bool> finished;
+	luabind::functor<luabind::object> text;
+	luabind::functor<void> complete;
+	if (!ai().script_engine().functor("dialogs.actor_has_finished_task", finished) ||
+		!ai().script_engine().functor("dialogs.text_npc_task_finish", text) ||
+		!ai().script_engine().functor("dialogs.npc_set_finished_task_complete", complete))
+	{
+		Msg("! S02-T06e dialogs turn-in functions missing");
+		return false;
+	}
+	const bool has_finished = finished(actor_go, npc_go);
+	Msg("S02-T06e turn-in: actor_has_finished_task=%d", has_finished ? 1 : 0);
+	if (!has_finished)
+		return false;
+	luabind::object t = text(actor_go, npc_go);
+	Msg("S02-T06e turn-in text: \"%s\"", t.type() == LUA_TSTRING ? luabind::object_cast<LPCSTR>(t) : "-");
+	complete(actor_go, npc_go);
+	return true;
+}
+
+bool give_task()
+{
+	CGameObject* npc = giver_object();
+	if (!npc)
+	{
+		Msg("! S02-T06e giver %s (%u) is not a live object", g_giver_profile, u32(g_giver_id));
+		return false;
+	}
+	bool ok = dialog_open(npc);
+	ok = dialog_accept_task(npc) && ok;
+	dialog_close(npc);
+	return ok;
+}
+
+// Spawn the fetch items into the actor's inventory the way a script's
+// alife_create_item(section, db.actor) does: alife():create with the actor
+// as parent (CALifeSimulator__spawn_item2, the Lua binding).
+bool spawn_fetch_items(LPCSTR section, u32 count)
+{
+	if (!g_actor || !section || section[0] == '-' || !ai().get_alife())
+		return false;
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	const CSE_ALifeCreatureActor* se_actor = alife->graph().actor();
+	if (!se_actor)
+		return false;
+	for (u32 i = 0; i < count; ++i)
+	{
+		CSE_Abstract* entity = CALifeSimulator__spawn_item2(alife, section, g_actor->Position(),
+			g_actor->ai_location().level_vertex_id(), se_actor->m_tGraphID, g_actor->ID());
+		if (!entity)
+		{
+			Msg("! S02-T06e %s did not spawn", section);
+			return false;
+		}
+		++g_spawned_items;
+		Msg("S02-T06e spawned %s id=%u into the actor's inventory", section, entity->ID);
+	}
+	return true;
+}
