+void log_actors()
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (now - g_link->last_actor_log_ms < 250)
+		return;
+	g_link->last_actor_log_ms = now;
+	if (!g_link->actors_csv)
+	{
+		string_path path;
+		FS.update_path(path, "$logs$", "coop-actors-client.csv");
+		g_link->actors_csv = fopen(path, "w");
+		if (!g_link->actors_csv)
+			return;
+		fprintf(g_link->actors_csv, "utc_ms,id,local,x,y,z,last_tick,snapshot_x,snapshot_y,snapshot_z,state\n");
+	}
+	FILETIME ft;
+	GetSystemTimeAsFileTime(&ft);
+	const u64 utc_ms = ((u64(ft.dwHighDateTime) << 32) | ft.dwLowDateTime) / 10000ull - 11644473600000ull;
+	for (const auto& entry : g_link->tracks)
+		if (CActor* actor = smart_cast<CActor*>(Level().Objects.net_Find(entry.first)))
+			fprintf(g_link->actors_csv, "%I64u,%u,%d,%.3f,%.3f,%.3f,%I64u,%.3f,%.3f,%.3f,%u\n", utc_ms, u32(entry.first),
+				actor == g_actor ? 1 : 0, VPUSH(actor->Position()), entry.second.server_tick, VPUSH(entry.second.last),
+				u32(entry.second.state));
+	fflush(g_link->actors_csv);
+}
