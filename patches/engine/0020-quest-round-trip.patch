+extern "C" bool __cdecl xrCampaignLevel_QuestApproachBegin()
+{
+	read_options();
+	if (!g_pGameLevel || !ai().get_alife() || !g_actor || !g_actor->g_Alive())
+	{
+		Msg("! S02-T06e quest: no level, ALife or alive actor");
+		return false;
+	}
+	CSE_ALifeHumanStalker* giver = find_giver();
+	if (!giver)
+	{
+		Msg("! S02-T06e quest: no ALife stalker with profile %s", g_giver_profile);
+		return false;
+	}
+	g_giver_id = giver->ID;
+	const float distance = giver->o_Position.distance_to(g_actor->Position());
+	if (giver_object())
+	{
+		Msg("S02-T06e approach: giver %s (%u) is online %.1f m away", g_giver_profile, u32(g_giver_id), distance);
+		return true;
+	}
+	// 2 m beside the giver, as the script API's SetActorPosition would put the actor
+	Fvector target = giver->o_Position;
+	target.x += 2.f;
+	const Fvector from = g_actor->Position();
+	Fmatrix F = g_actor->XFORM();
+	F.c = target;
+	g_actor->XFORM().set(F);
+	if (g_actor->character_physics_support()->movement()->CharacterExist())
+	{
+		g_actor->character_physics_support()->movement()->SetPosition(F.c);
+		g_actor->character_physics_support()->movement()->SetVelocity(0.f, 0.f, 0.f);
+	}
+	Msg("S02-T06e approach: giver %s (%u) offline %.1f m away at [%.2f,%.2f,%.2f]; actor moved from [%.2f,%.2f,%.2f] "
+		"to [%.2f,%.2f,%.2f]",
+		g_giver_profile, u32(g_giver_id), distance, VPUSH(giver->o_Position), VPUSH(from), VPUSH(target));
+	return true;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_QuestApproachTick()
+{
+	CGameObject* npc = giver_object();
+	if (!npc)
+		return false;
+	Msg("S02-T06e approach: giver %u online, %.1f m from the actor", u32(g_giver_id),
+		g_actor ? npc->Position().distance_to(g_actor->Position()) : -1.f);
+	return true;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_QuestGive(LPCSTR out_path)
+{
+	xr_strcpy(g_out_path, out_path);
+	read_options();
+	g_have_given = g_have_completed = false;
+	g_available_count = g_spawned_items = 0;
+	if (!g_pGameLevel || !ai().get_alife() || !g_actor || !g_actor->g_Alive())
+	{
+		Msg("! S02-T06e quest: no level, ALife or alive actor");
+		return false;
+	}
+	CSE_ALifeHumanStalker* giver = find_giver();
+	g_giver_id = giver ? giver->ID : no_id;
+	QuestSnapshot before;
+	take(before, "before-give");
+	write_snapshot(before, true);
+
+	bool ok = true;
+	ok = rule(before.giver_se && before.giver_alive, "the task giver exists in ALife and is alive") && ok;
+	ok = rule(before.giver_online && before.giver_live, "the task giver is online near the actor") && ok;
+	ok = rule(!before.native_task && !before.lua_task, "the task is not yet given") && ok;
+	ok = rule(!before.info_tier1, "the task's completion info portion is not yet set") && ok;
+	if (!ok)
+		return false;
+
+	const u32 state_updates_before = g_s02_task_state_updates;
+	ok = give_task() && ok;
+	take(g_given, "given");
+	g_have_given = true;
+	write_snapshot(g_given, false);
+	ok = rule(g_given.native_task && g_given.native_state == int(eTaskStateInProgress),
+			 "the native task exists and is in progress") && ok;
+	ok = rule(g_given.receive_time == Level().GetGameTime(), "the native task's receive time is the current game time") && ok;
+	ok = rule(g_given.active_is_task, "the new task is the active task") && ok;
+	ok = rule(g_given.lua_task && xr_strcmp(g_given.lua_status, "selected") == 0 && g_given.lua_stage == 0,
+			 "the Lua task is selected at stage 0") && ok;
+	ok = rule(g_given.lua_giver_id == int(g_giver_id), "the Lua task records the giver") && ok;
+	ok = rule(g_given.fetch_section[0] != '-' && g_given.fetch_count >= 1,
+			 "the fetch item and count are in the actor's portable store") && ok;
+	ok = rule(g_given.items_in_inventory == 0, "the actor does not have the fetch item yet") && ok;
+	ok = rule(!g_given.actor_talking && !g_given.npc_talking && !g_given.used_npc_event,
+			 "the dialogue is closed again") && ok;
+	ok = rule(g_given.money == before.money && !g_given.info_tier1, "no reward before completion") && ok;
+	(void)state_updates_before;
+	return ok;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_QuestObserved(u32 ticks)
+{
+	if (!g_have_given)
+		return false;
+	QuestSnapshot s;
+	take(s, "ticked");
+	write_snapshot(s, false);
+	bool ok = true;
+	ok = rule(s.native_task && s.native_state == int(eTaskStateInProgress), "the native task is still in progress") && ok;
+	ok = rule(s.tm_updates - g_given.tm_updates >= ticks / 2,
+			 "the native task manager updated on the level frames") && ok;
+	ok = rule(s.state_updates > g_given.state_updates, "the native task evaluated its state") && ok;
+	ok = rule(s.lua_task && s.lua_has_t && s.lua_checked, "the Lua task found its native task and ran check_task") && ok;
+	ok = rule(s.lua_stage == 0 && xr_strcmp(s.lua_status, "selected") == 0, "the Lua task stays at stage 0 without the item") && ok;
+	return ok;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_QuestRestored()
+{
+	if (!g_have_given)
+		return false;
+	// a new process state after the reload: the giver id is looked up again
+	CSE_ALifeHumanStalker* giver = find_giver();
+	g_giver_id = giver ? giver->ID : no_id;
+	QuestSnapshot s;
+	take(s, "restored");
+	write_snapshot(s, false);
+	bool ok = true;
+	ok = rule(s.giver_se && s.giver_alive && s.giver_id == g_given.giver_id, "the task giver is back with the same id") && ok;
+	ok = rule(s.native_task && s.native_state == int(eTaskStateInProgress), "the native task came back in progress") && ok;
+	ok = rule(s.receive_time == g_given.receive_time, "the native task kept its receive time") && ok;
+	ok = rule(s.active_is_task, "the task is the active task again") && ok;
+	ok = rule(s.lua_task && s.lua_loaded && xr_strcmp(s.lua_status, "selected") == 0 && s.lua_stage == 0,
+			 "the Lua task was loaded from the marshal, selected at stage 0") && ok;
+	ok = rule(s.lua_giver_id == g_given.lua_giver_id, "the Lua task kept its giver") && ok;
+	ok = rule(xr_strcmp(s.fetch_section, g_given.fetch_section) == 0 && s.fetch_count == g_given.fetch_count,
+			 "the fetch item came back through the portable store") && ok;
+	ok = rule(s.lua_has_t && s.lua_checked, "the Lua task re-found its native task and ran check_task") && ok;
+	ok = rule(s.money == g_given.money && s.goodwill_csky == g_given.goodwill_csky && !s.info_tier1,
+			 "no reward crossed the checkpoint") && ok;
+	ok = rule(s.items_in_inventory == 0, "the actor still has no fetch item") && ok;
+	return ok;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_QuestCompleteBegin()
+{
+	if (!g_have_given)
+		return false;
+	QuestSnapshot s;
+	take(s, "before-complete");
+	g_complete_phase = 0;
+	g_complete_ticks = g_turnin_tick = g_completed_tick = 0;
+	g_turnin_ok = false;
+	return spawn_fetch_items(s.fetch_section, u32(_max(1, s.fetch_count)));
+}
+
+extern "C" bool __cdecl xrCampaignLevel_QuestCompleteTick()
+{
+	++g_complete_ticks;
+	if (g_complete_phase == 2)
+		return true;
+	QuestSnapshot s;
+	take(s, "tick");
+	if (g_complete_phase == 0)
+	{
+		// the item is online in the inventory and the status functor saw it
+		if (s.items_in_inventory >= u32(_max(1, s.fetch_count)) && s.lua_stage == 1)
+		{
+			g_turnin_tick = g_complete_ticks;
+			CGameObject* npc = giver_object();
+			g_turnin_ok = npc && dialog_open(npc);
+			g_turnin_ok = npc && dialog_turn_in(npc) && g_turnin_ok;
+			if (npc)
+				dialog_close(npc);
+			g_complete_phase = g_turnin_ok ? 1 : 2;
+		}
+		return g_complete_phase == 2;
+	}
+	// phase 1: the completion lands through UpdateTasks and the callbacks
+	// (the money comes one second later through a time event)
+	if (s.native_state == int(eTaskStateCompleted) && s.info_tier1 && s.money > g_given.money &&
+		s.items_in_inventory == 0)
+	{
+		g_completed_tick = g_complete_ticks;
+		g_complete_phase = 2;
+		return true;
+	}
+	return false;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_QuestCompleteEnd(u32 ticks)
+{
+	if (!g_have_given)
+		return false;
+	take(g_completed, "completed");
+	g_have_completed = true;
+	write_snapshot(g_completed, false);
+	Msg("S02-T06e completion: %u ticks, turn-in at tick %u (ok=%d), completed at tick %u, spawned %u", ticks,
+		g_turnin_tick, g_turnin_ok ? 1 : 0, g_completed_tick, g_spawned_items);
+	const QuestSnapshot& s = g_completed;
+	bool ok = true;
+	ok = rule(g_spawned_items >= 1, "the fetch item was spawned into the inventory") && ok;
+	ok = rule(g_turnin_tick != 0, "the status functor saw the item (Lua stage 1)") && ok;
+	ok = rule(g_turnin_ok, "the giver listed the task as finished and accepted the turn-in") && ok;
+	ok = rule(s.native_task && s.native_state == int(eTaskStateCompleted), "the native task is completed") && ok;
+	ok = rule(s.native_completed > g_given.native_completed && s.native_inprogress + 1 == g_given.native_inprogress,
+			 "the native task counts moved from in progress to completed") && ok;
+	ok = rule(!s.lua_task, "the Lua task entry was retired (no repeat)") && ok;
+	ok = rule(s.info_tier1, "on_complete set the info portion") && ok;
+	ok = rule(s.money > g_given.money, "on_complete paid the reward") && ok;
+	ok = rule(s.goodwill_csky > g_given.goodwill_csky, "on_complete raised the faction goodwill") && ok;
+	ok = rule(s.items_in_inventory == 0, "on_complete removed the fetch item") && ok;
+	ok = rule(!s.actor_talking && !s.npc_talking && !s.used_npc_event, "the dialogue is closed again") && ok;
+	return ok;
+}
+
+extern "C" bool __cdecl xrCampaignLevel_QuestPersisted()
+{
+	if (!g_have_completed)
+		return false;
+	CSE_ALifeHumanStalker* giver = find_giver();
+	g_giver_id = giver ? giver->ID : no_id;
+	QuestSnapshot s;
+	take(s, "persisted");
+	write_snapshot(s, false);
+	bool ok = true;
+	ok = rule(s.native_task && s.native_state == int(eTaskStateCompleted), "the native task came back completed") && ok;
+	ok = rule(s.receive_time == g_given.receive_time, "the native task kept its receive time") && ok;
+	ok = rule(s.native_completed == g_completed.native_completed && s.native_inprogress == g_completed.native_inprogress,
+			 "the native task counts came back") && ok;
+	ok = rule(!s.lua_task, "the Lua task entry stays retired") && ok;
+	ok = rule(s.info_tier1, "the info portion persisted") && ok;
+	ok = rule(s.money == g_completed.money, "the reward money persisted") && ok;
+	ok = rule(s.goodwill_csky == g_completed.goodwill_csky, "the goodwill persisted") && ok;
+	ok = rule(s.items_in_inventory == 0, "the fetch item stays removed") && ok;
+	return ok;
+}
+
+void ClientQuestCaptureOnFrame()
+{
+	static const bool restored_run = strstr(Core.Params, "-s02-quest-capture") != nullptr;
+	static const bool persisted_run = strstr(Core.Params, "-s02-quest-persisted") != nullptr;
+	static u32 since = 0;
+	static u32 phase = 0; // 0 waiting, 1 approaching the giver, 2 completing, 3 done
+	static u32 complete_since = 0;
+	if ((!restored_run && !persisted_run) || phase == 3 || !g_pGameLevel || !g_pGameLevel->bReady || !g_actor ||
+		Device.dwPrecacheFrame)
+		return;
+	if (!since)
+	{
+		since = Device.dwTimeGlobal;
+		return;
+	}
+	if (Device.dwTimeGlobal - since < 1000)
+		return;
+	if (phase == 0)
+	{
+		// the giver must be online for the dialogue (and for the client's
+		// row to describe him); the server's checkpoint left the actor beside
+		// him, so this is normally a no-op
+		if (!xrCampaignLevel_QuestApproachBegin())
+		{
+			Msg("! S02-T06e client: no giver");
+			phase = 3;
+			Console->Execute("quit");
+			return;
+		}
+		complete_since = Device.dwTimeGlobal;
+		phase = 1;
+		return;
+	}
+	if (phase == 1)
+	{
+		if (!xrCampaignLevel_QuestApproachTick())
+		{
+			if (Device.dwTimeGlobal - complete_since < 20000)
+				return;
+			Msg("! S02-T06e client: giver did not come online");
+		}
+		FS.update_path(g_out_path, "$logs$", "s02-t06e-quest.csv");
+		QuestSnapshot s;
+		take(s, persisted_run ? "client-persisted" : "client-restored");
+		write_snapshot(s, true);
+		if (persisted_run)
+		{
+			phase = 3;
+			Msg("S02-T06e client quest capture written to %s", g_out_path);
+			FlushLog();
+			Console->Execute("quit");
+			return;
+		}
+		// the compare tool checks the row against the server's; here only
+		// what the completion needs
+		g_given = s;
+		g_have_given = true;
+		xrCampaignLevel_QuestCompleteBegin();
+		complete_since = Device.dwTimeGlobal;
+		phase = 2;
+		return;
+	}
+	// phase 2: one step per frame, 30 s of device time at most
+	const bool done = xrCampaignLevel_QuestCompleteTick();
+	if (!done && Device.dwTimeGlobal - complete_since < 30000)
+		return;
+	if (!done)
+		Msg("! S02-T06e client completion timed out in phase %u", g_complete_phase);
+	xrCampaignLevel_QuestCompleteEnd(0);
+	phase = 3;
+	Msg("S02-T06e client quest capture written to %s", g_out_path);
+	FlushLog();
+	Console->Execute("quit");
+}
