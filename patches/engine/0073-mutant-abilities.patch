+// ------------------------------------------------------------ S10-T02d
+// The mutant fixture (profile mutant_party, server-driven): once both players
+// are in the world, p1 is moved about 120 m away (p1 only, L58) and three
+// stages run in turn near p2 (the anchor), each up to 60 s and ended early by
+// its ability's first event; p2's health is held at 1 throughout:
+//   bloodsucker  a bloodsucker_normal 5 m in front; its vampire wish forced
+//                (coop_force_vampire): the grab on p2 (vampire-grab/-release)
+//   burer        a burer_normal 10 m in front, p2's pistol drawn; its anti-aim
+//                forced each tick (set_force_anti_aim): the camera kick and the
+//                stamina hit on p2 (anti-aim, stamina)
+//   poltergeist  an m_poltergeist_normal_tele 8 m in front; its detection held
+//                full (coop_force_detection): objects thrown at p2 (tele)
+// Each monster is killed when its stage ends. The counters per player and the
+// clients' presentations (monster-effect-applied, the anti-aim's camera
+// effector) are checked by compare-coop-mutant.py.
+void mutant_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.mutant_party || !ai().get_alife())
+		return;
+	Host::MutantFixture& f = g_host->mutant_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u8 slots[2] = {0, 0};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				slots[attached] = link.ref.slot;
+				actors[attached++] = actor;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-mutant both-attached tick=%I64u", g_host->tick);
+	}
+	if (attached < 2 || f.phase >= 99 || g_host->tick < f.both_since + u64(config.mutant_party) * 50)
+		return;
+	if (slots[0] != 0)
+		std::swap(actors[0], actors[1]);
+	CActor* p2 = actors[1];
+	if (p2->g_Alive() && p2->GetfHealth() < 1.f)
+		p2->SetfHealth(1.f); // the stages test targeting, not survival
+	CALifeSimulator* alife = const_cast<CALifeSimulator*>(ai().get_alife());
+	struct Stage
+	{
+		LPCSTR section, ability;
+		float distance;
+	};
+	static const Stage stages[3] = {{"bloodsucker_normal", "vampire-grab", 5.f}, {"burer_normal", "anti-aim", 10.f},
+		{"m_poltergeist_normal_tele", "tele", 8.f}};
+	if (f.phase == 0)
+	{
+		Fvector away;
+		away.sub(actors[0]->Position(), p2->Position());
+		away.y = 0.f;
+		if (away.square_magnitude() < 0.01f)
+			away.set(1.f, 0.f, 0.f);
+		away.normalize();
+		place_beside(actors[0], Fvector().mad(p2->Position(), away, 120.f));
+		g_host->log.line("fixture-mutant p1-away distance=%.1f", actors[0]->Position().distance_to(p2->Position()));
+		f.phase = 1;
+		return;
+	}
+	const u32 stage = (f.phase - 1) / 3; // phases 1-3: stage 0, 4-6: stage 1, 7-9: stage 2
+	const u32 step = (f.phase - 1) % 3;
+	if (stage >= 3)
+	{
+		g_host->log.line("fixture-mutant done phase=abilities failures=%u", f.failures);
+		f.phase = 99;
+		return;
+	}
+	const Stage& st = stages[stage];
+	if (step == 0)
+	{
+		Fvector forward;
+		forward.setHP(p2->XFORM().k.getH(), 0.f);
+		f.monster = spawn_at(alife, st.section, Fvector().mad(p2->Position(), forward, st.distance), u16(p2->ID()));
+		g_host->log.line("fixture-mutant spawned stage=%u section=%s monster=%u", stage, st.section, u32(f.monster));
+		if (f.monster == kNoEngineId)
+		{
+			++f.failures;
+			f.phase += 3;
+			return;
+		}
+		if (stage == 1)
+		{
+			// the anti-aim watches an armed player: a pistol in slot 2, drawn
+			if (!p2->inventory().ItemFromSlot(INV_SLOT_2))
+				give_to(alife, "wpn_pm", u16(p2->ID()));
+			p2->inventory().Activate(INV_SLOT_2);
+		}
+		if (stage == 2)
+		{
+			// the telekinesis throws loose physics objects that can reach p2: three fresh ones
+			LPCSTR loose[] = {"conserva", "vodka", "bread"};
+			for (u32 k = 0; k < 3; ++k)
+				spawn_at(alife, loose[k], Fvector().mad(Fvector().mad(p2->Position(), forward, 3.f), Fvector().set(forward.z, 0.f, -forward.x),
+					float(k) - 1.f), u16(p2->ID()));
+		}
+		f.phase_tick = g_host->tick;
+		++f.phase;
+		return;
+	}
+	CEntityAlive* monster = f.monster != 0xffff ? smart_cast<CEntityAlive*>(Level().Objects.net_Find(f.monster)) : nullptr;
+	if (step == 1)
+	{
+		if (monster && monster->g_Alive())
+		{
+			if (stage == 0)
+				if (CAI_Bloodsucker* b = smart_cast<CAI_Bloodsucker*>(monster))
+					b->coop_force_vampire();
+			if (stage == 1)
+				if (CBaseMonster* m = smart_cast<CBaseMonster*>(monster))
+				{
+					if (!p2->inventory().ActiveItem() && p2->inventory().ItemFromSlot(INV_SLOT_2))
+						p2->inventory().Activate(INV_SLOT_2);
+					m->set_force_anti_aim(true);
+					if (m->get_anti_aim() && (g_host->tick - f.phase_tick) % (5 * 50) == 0)
+					{
+						string512 why;
+						m->get_anti_aim()->coop_debug(why, sizeof(why));
+						g_host->log.line("fixture-mutant anti-aim-state %s", why);
+					}
+				}
+			if (stage == 2)
+				if (CPoltergeist* p = smart_cast<CPoltergeist*>(monster))
+				{
+					p->coop_force_detection(15.f); // the maximum: the detection decays between this tick and the telekinesis
+					if ((g_host->tick - f.phase_tick) % (5 * 50) == 0)
+					{
+						CActor* t = p->detection_actor();
+						g_host->log.line("fixture-mutant tele-state level=%.2f target=%u distance=%.1f", p->coop_detection_level(),
+							t ? u32(t->ID()) : 0xffffu, t ? t->Position().distance_to(p->Position()) : -1.f);
+					}
+				}
+		}
+		const std::pair<u64, u64>& count = g_host->monster_abilities[st.ability];
+		const bool seen = count.first + count.second > 0;
+		if (!seen && g_host->tick - f.phase_tick < 60 * 50)
+			return;
+		f.phase_tick = g_host->tick + 3 * 50; // let the release and removals reach the client
+		++f.phase;
+		return;
+	}
+	if (g_host->tick < f.phase_tick)
+		return;
+	if (monster && monster->g_Alive())
+		monster->KillEntity(u16(p2->ID()));
+	const std::pair<u64, u64>& count = g_host->monster_abilities[st.ability];
+	g_host->log.line("fixture-mutant stage-done stage=%u section=%s ability=%s on_p1=%I64u on_p2=%I64u", stage, st.section, st.ability,
+		count.first, count.second);
+	if (count.second == 0 || count.first != 0)
+		++f.failures;
+	++f.phase;
+}
