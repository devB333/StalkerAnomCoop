+std::vector<u8> encode_pickup(const PickupRecord& r)
+{
+	std::vector<u8> out;
+	put<u8>(out, r.slot);
+	put<u64>(out, r.player.hi);
+	put<u64>(out, r.player.lo);
+	put<u64>(out, r.operation);
+	put<u64>(out, r.owner_entity);
+	put<u64>(out, r.item_entity);
+	put<u16>(out, r.item_id);
+	const u8 length = u8(_min(r.section.size(), size_t(255)));
+	put<u8>(out, length);
+	out.insert(out.end(), r.section.begin(), r.section.begin() + length);
+	for (float f : r.position)
+		put<float>(out, f);
+	put<u16>(out, u16(_min(r.state.size(), size_t(0xffff))));
+	out.insert(out.end(), r.state.begin(), r.state.begin() + _min(r.state.size(), size_t(0xffff)));
+	return out;
+}
+
+bool decode_pickup(const std::vector<u8>& payload, PickupRecord& out)
+{
+	size_t at = 0;
+	u8 length = 0;
+	if (!(get(payload, at, out.slot) && get(payload, at, out.player.hi) && get(payload, at, out.player.lo) &&
+			get(payload, at, out.operation) && get(payload, at, out.owner_entity) &&
+			get(payload, at, out.item_entity) && get(payload, at, out.item_id) && get(payload, at, length)) ||
+		at + length > payload.size() || length == 0)
+		return false;
+	out.section.assign(reinterpret_cast<const char*>(payload.data() + at), length);
+	at += length;
+	u16 state = 0;
+	if (!(get(payload, at, out.position[0]) && get(payload, at, out.position[1]) &&
+			get(payload, at, out.position[2]) && get(payload, at, state)) ||
+		at + state != payload.size() || !out.owner_entity || !out.item_entity)
+		return false;
+	out.state.assign(payload.begin() + at, payload.end());
+	return true;
+}
