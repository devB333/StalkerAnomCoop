+	"        end\n"
+	"        if S.host_live and S.host_live_id ~= S.host_live:id() then\n"
+	"          S.host_live_id = S.host_live:id()\n"
+	"          printf('coop host-actor-fallback dead=%s live=%s', tostring(host:id()), tostring(S.host_live_id))\n"
+	"        end\n"
+	"      end\n"
+	"      if S.host_live then return S.host_live end\n"
+	"    end\n"
 	"    return host\n"
