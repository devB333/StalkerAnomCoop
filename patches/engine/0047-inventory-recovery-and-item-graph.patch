+// S08-T03: the canonical item graph. Every 10 s the server hashes the
+// owner of every published item (item EntityId -> owner EntityId, 0 on the
+// ground), sorted, FNV-1a 64, and sends the hash to every client as a
+// lifecycle event (CampaignEvent 8): lifecycle messages reach a client in
+// order on one channel, so the client compares its own replica at exactly
+// the point of the stream the server hashed. The items go to
+// coop-item-graph.csv for a mismatch's diagnosis.
+u64 fnv1a(u64 h, u64 v)
+{
+	for (int b = 0; b < 8; ++b)
+	{
+		h ^= (v >> (8 * b)) & 0xff;
+		h *= 1099511628211ull;
+	}
+	return h;
+}
+
+void item_graph_point(LPCSTR tag)
+{
+	if (!g_pGameLevel || !ai().get_alife())
+		return;
+	xr_vector<std::pair<u64, u64>> items;
+	for (const auto& p : g_host->published)
+	{
+		if (!p.second.sent)
+			continue;
+		CSE_Abstract* se = Level().Server->ID_to_entity(p.first);
+		if (!se || !smart_cast<CSE_ALifeInventoryItem*>(se))
+			continue;
+		items.push_back({p.second.ref.id, se->ID_Parent != 0xffff ? entity_of(se->ID_Parent) : 0});
+	}
+	std::sort(items.begin(), items.end());
+	u64 hash = 14695981039346656037ull;
+	for (const auto& i : items)
+		hash = fnv1a(fnv1a(hash, i.first), i.second);
+	const u64 seq = ++g_host->item_graph_seq;
+	if (g_host->item_graph_csv)
+	{
+		for (const auto& i : items)
+			fprintf(g_host->item_graph_csv, "%I64u,%I64u,%I64u\n", seq, i.first, i.second);
+		fflush(g_host->item_graph_csv);
+	}
+	std::vector<u8> payload;
+	for (int b = 0; b < 8; ++b)
+		payload.push_back(u8(seq >> (8 * b)));
+	for (int b = 0; b < 8; ++b)
+		payload.push_back(u8(hash >> (8 * b)));
+	for (int b = 0; b < 4; ++b)
+		payload.push_back(u8(u32(items.size()) >> (8 * b)));
+	broadcast_event(8, payload);
+	g_host->log.line("item-graph tag=%s seq=%I64u items=%u hash=%016I64x tick=%I64u", tag, seq, u32(items.size()), hash,
+		g_host->tick);
+}
+
+void item_graph_points()
+{
+	u32 in_world = 0;
+	for (PlayerLink& link : g_host->links)
+		in_world += client_in_world(link) ? 1 : 0;
+	if (!in_world || g_host->tick < g_host->item_graph_last_tick + 10 * 50)
+		return;
+	g_host->item_graph_last_tick = g_host->tick;
+	item_graph_point("periodic");
+}
