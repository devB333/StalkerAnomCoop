+// Completed publications (the worker's results) and the joins waiting on them.
+void poll_publications(bool final_stop)
+{
+	CoopPersistence* persistence = g_host->persistence;
+	if (!persistence)
+		return;
+	std::vector<CoopPersistence::PublishResult> results;
+	if (final_stop)
+		persistence->wait_idle(results);
+	else
+		persistence->poll(results);
+	for (CoopPersistence::PublishResult& r : results)
+	{
+		if (r.ok)
+		{
+			++g_host->checkpoints;
+			g_host->last_published = r.participants; // S07-T07: the respawn fallback point
+		}
+		else
+			++g_host->checkpoint_failures;
+		g_host->publish_ms_total += u64(r.total_ms);
+		const coop::store::CheckpointStore::Timing& t = r.timing;
+		g_host->log.line("checkpoint-%s generation=%u revision=%I64u reason=%s worker_ms=%.1f compress=%.1f write=%.1f "
+			"publish=%.1f verify=%.1f flush=%.1f rename=%.1f manifest=%.1f rotate=%.1f pointer=%.1f retention=%.1f "
+			"participants=%u detail=%s",
+			r.ok ? "published" : "failed", r.generation, r.revision, r.reason.c_str(), r.total_ms, r.compress_ms,
+			r.write_ms, r.publish_ms, t.verify_ms, t.flush_ms, t.rename_ms, t.manifest_ms, t.rotate_ms, t.pointer_ms,
+			t.retention_ms, u32(r.participants.size()), r.detail.c_str());
+		checkpoint_csv(r.generation, r.revision, r.reason.c_str(), u32(g_host->take_ms_max), r.total_ms, r.ok, r.detail.c_str());
+		if (!r.ok && persistence->failed())
+		{
+			g_host->log.line("store-failed-stop reason=%s", persistence->failure());
+			g_host->stop_requested = true;
+		}
+		// the joins that waited for this generation
+		for (PlayerLink& link : g_host->links)
+			if (link.world == WorldPublishing && link.waiting_generation == r.generation)
+			{
+				if (r.ok)
+					stream_checkpoint(link, persistence->generation_path(r.generation, "scop"),
+						persistence->generation_path(r.generation, "scoc"), r.revision, r.generation, 0);
+				else
+					legacy_world_stream(link);
+			}
+	}
