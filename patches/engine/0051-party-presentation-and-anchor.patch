+// S08-T09: CampaignEvent 11: the party's tasks. Payload: u8 count, then per
+// task: id, u8 state (0 failed, 1 in progress, 2 completed), s16 count, s16
+// need, title, description, icon, map location (strings: u8 length + bytes),
+// u16 map object, u32 priority. The client keeps a presentation copy in its
+// own task manager (it evaluates no task): the PDA lists it with the pooled
+// count, its map location and its final state.
+void on_party_tasks(const coop::proto::CampaignEvent& event)
+{
+	PayloadReader r(event.payload);
+	const u8 n = r.get<u8>();
+	for (u8 i = 0; i < n && r.ok; ++i)
+	{
+		string256 id, title, description, icon, location;
+		r.str(id, sizeof(id));
+		const u8 state = r.get<u8>();
+		const s16 count = r.get<s16>();
+		const s16 need = r.get<s16>();
+		r.str(title, sizeof(title));
+		r.str(description, sizeof(description));
+		r.str(icon, sizeof(icon));
+		r.str(location, sizeof(location));
+		const u16 object = r.get<u16>();
+		const u32 priority = r.get<u32>();
+		if (!r.ok || !id[0])
+			break;
+		CGameTaskManager& tasks = Level().GameTaskManager();
+		string512 shown;
+		if (need > 0)
+			xr_sprintf(shown, "%s (%d/%d)", *CStringTable().translate(title), _max<int>(count, 0), int(need));
+		else
+			xr_strcpy(shown, *CStringTable().translate(title));
+		CGameTask* t = tasks.HasGameTask(shared_str(id), false);
+		const char* what = "updated";
+		if (!t)
+		{
+			if (state != 1)
+				continue; // finished before this client knew it: its checkpoint holds it
+			t = xr_new<CGameTask>();
+			t->m_ID = id;
+			t->m_Title = shown;
+			t->m_Description = description;
+			t->SetIconName_script(icon);
+			t->SetMapLocation_script(location);
+			t->SetMapObjectID_script(object);
+			t->m_priority = priority;
+			if (!tasks.GiveGameTaskToActor(t, 0, false, 0))
+			{
+				xr_delete(t);
+				continue;
+			}
+			what = "given";
+		}
+		else
+		{
+			t->m_Title = shown;
+			if (description[0])
+				t->m_Description = description;
+			const ETaskState want = state == 2 ? eTaskStateCompleted : state == 0 ? eTaskStateFail : eTaskStateInProgress;
+			if (t->GetTaskState() != want && want != eTaskStateInProgress)
+			{
+				tasks.SetTaskState(t, want);
+				what = "finished";
+			}
+		}
+		if (CurrentGameUI())
+			CurrentGameUI()->UpdatePda();
+		++g_link->party_tasks_presented;
+		g_link->log.line("party-task %s id=%s state=%u count=%d need=%d title=\"%s\" local_state=%d", what, id, u32(state),
+			int(count), int(need), shown, int(t->GetTaskState()));
+	}
+}
