+// S05-T03: see Actor.h. The server's movement state drives the leg and torso
+// animations the native control path would choose; the character controller
+// is placed where the server has the actor.
+void CActor::replica_present(const Fvector& position, float model_yaw, u32 mstate, const Fvector& velocity,
+	bool local_view)
+{
+	if (!g_Alive() || !_valid(position))
+		return;
+	if (!local_view)
+	{
+		// as the network import does for a remote actor (net_Import_Base_proceed)
+		setVisible(TRUE);
+		setEnabled(TRUE);
+	}
+	r_model_yaw = r_model_yaw_dest = model_yaw;
+	r_model_yaw_delta = 0.f;
+	if (local_view)
+	{
+		r_torso.yaw = cam_Active()->GetWorldYaw();
+		r_torso.pitch = cam_Active()->GetWorldPitch();
+	}
+	else
+	{
+		r_torso.yaw = model_yaw;
+		r_torso.pitch = 0.f;
+	}
+	unaffected_r_torso = r_torso;
+	if (character_physics_support()->movement()->CharacterExist())
+	{
+		character_physics_support()->movement()->SetPosition(position);
+		character_physics_support()->movement()->SetVelocity(velocity);
+	}
+	Fmatrix xform;
+	xform.rotateY(-model_yaw);
+	xform.c.set(position);
+	XFORM().set(xform);
+	mstate_real = mstate;
+	g_SetAnimation(mstate_real);
+}
