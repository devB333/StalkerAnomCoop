+// ------------------------------------------------------------ S10-T02a
+// The NPC logic fixture (profile npc_party, server-driven): once both players
+// are in the world, the stalker nearest to p2 is the subject; p1 is moved away
+// along the line from the NPC when it is the nearer player (p1 only, L58). A
+// Lua chunk evaluates, inside the NPC's evaluation scope and outside it:
+// db.actor's id, AC_ID and a condlist "{=dist_to_actor_le(D)} near, far" with
+// D a little more than the NPC's distance to p2: inside the scope the player
+// in front of the NPC (p2) answers, outside it the host's actor (p1).
+void npc_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.npc_party || !ai().get_alife())
+		return;
+	Host::NpcFixture& f = g_host->npc_fixture;
+	CActor* actors[2] = {nullptr, nullptr};
+	u8 slots[2] = {0, 0};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				slots[attached] = link.ref.slot;
+				actors[attached++] = actor;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		g_host->log.line("fixture-npc both-attached tick=%I64u", g_host->tick);
+	}
+	if (attached < 2 || f.phase >= 9 || g_host->tick < f.both_since + u64(config.npc_party) * 50)
+		return;
+	if (slots[0] != 0)
+		std::swap(actors[0], actors[1]);
+	if (f.phase == 0)
+	{
+		// the subject: the alive stalker nearest to p2
+		CGameObject* npc = nullptr;
+		float best = flt_max;
+		for (u32 i = 0; i < Level().Objects.o_count(); ++i)
+		{
+			CObject* o = Level().Objects.o_get_by_iterator(i);
+			CEntityAlive* alive = o ? smart_cast<CEntityAlive*>(o) : nullptr;
+			if (!alive || !alive->g_Alive() || smart_cast<CActor*>(o) || !smart_cast<CInventoryOwner*>(o))
+				continue;
+			const float d = o->Position().distance_to(actors[1]->Position());
+			if (d < best)
+			{
+				best = d;
+				npc = smart_cast<CGameObject*>(o);
+			}
+		}
+		if (!npc)
+		{
+			g_host->log.line("fixture-npc subject-missing");
+			++f.failures;
+			g_host->log.line("fixture-npc done phase=no-subject failures=%u", f.failures);
+			f.phase = 9;
+			return;
+		}
+		float d1 = npc->Position().distance_to(actors[0]->Position());
+		if (d1 <= best + 5.f)
+		{
+			// p1 is the nearer (or about as near): move p1 away from the NPC (p1 only)
+			Fvector away;
+			away.sub(actors[0]->Position(), npc->Position());
+			away.y = 0.f;
+			if (away.square_magnitude() < 0.01f)
+				away.set(1.f, 0.f, 0.f);
+			away.normalize();
+			Fvector at = actors[0]->Position();
+			at.mad(away, best + 15.f - d1 > 0.f ? best + 15.f - d1 : 0.f);
+			place_beside(actors[0], at);
+			d1 = npc->Position().distance_to(actors[0]->Position());
+		}
+		const float threshold = best + 2.f;
+		string1024 chunk;
+		xr_sprintf(chunk,
+			"local npc = level.object_by_id(%u)\n"
+			"local cl = xr_logic.parse_condlist(nil, nil, nil, \"{=dist_to_actor_le(%.1f)} near, far\")\n"
+			"local a = db.actor\n"
+			"return a and a:id() or -1, AC_ID, npc and xr_logic.pick_section_from_condlist(a, npc, cl) or 'none'",
+			u32(npc->ID()), threshold);
+		int in_actor = -2, in_ac = -2, out_actor = -2, out_ac = -2;
+		string64 in_pick = "", out_pick = "";
+		lua_State* L = ai().script_engine().lua();
+		for (int pass = 0; pass < 2; ++pass)
+		{
+			const int top = lua_gettop(L);
+			if (luaL_loadstring(L, chunk) == 0)
+			{
+				int rc;
+				{
+					// pass 0: inside the NPC's evaluation scope; pass 1: outside it
+					campaign::NpcEvaluationScope scope(pass == 0 ? npc : nullptr);
+					rc = lua_pcall(L, 0, 3, 0);
+				}
+				if (rc == 0 && lua_gettop(L) >= top + 3)
+				{
+					(pass == 0 ? in_actor : out_actor) = int(lua_tonumber(L, top + 1));
+					(pass == 0 ? in_ac : out_ac) = int(lua_tonumber(L, top + 2));
+					xr_strcpy(pass == 0 ? in_pick : out_pick, lua_tostring(L, top + 3) ? lua_tostring(L, top + 3) : "");
+				}
+				else
+					g_host->log.line("fixture-npc lua-error pass=%d error=%s", pass, lua_tostring(L, -1) ? lua_tostring(L, -1) : "?");
+			}
+			else
+				g_host->log.line("fixture-npc lua-load-error error=%s", lua_tostring(L, -1) ? lua_tostring(L, -1) : "?");
+			lua_settop(L, top);
+		}
+		const int p1 = int(actors[0]->ID()), p2 = int(actors[1]->ID());
+		g_host->log.line("fixture-npc eval npc=%u section=%s d_p1=%.1f d_p2=%.1f threshold=%.1f p1=%d p2=%d in_actor=%d in_ac_id=%d "
+			"in_pick=%s out_actor=%d out_ac_id=%d out_pick=%s", u32(npc->ID()), *npc->cNameSect(), d1, best, threshold, p1, p2, in_actor,
+			in_ac, in_pick, out_actor, out_ac, out_pick);
+		if (in_actor != p2 || in_ac != p2 || xr_strcmp(in_pick, "near"))
+			++f.failures;
+		if (out_actor != p1 || out_ac != p1 || (d1 > threshold && xr_strcmp(out_pick, "far")))
+			++f.failures;
+		const campaign::ScriptContextStats& st = campaign::script_context_stats();
+		g_host->log.line("fixture-npc done phase=evaluated failures=%u npc_scope_enters=%I64u npc_scope_reads=%I64u", f.failures,
+			st.npc_scope_enters, st.npc_scope_reads);
+		f.phase = 9;
+	}
+}
