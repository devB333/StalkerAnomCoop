+	g_link->log.line("script-leg name=%s start_utc=%I64u end_utc=%I64u ms=%u mode=%u pos=%.2f,%.2f,%.2f",
+		g_link->leg_name, g_link->leg_start_utc, utc_now_ms(), now - g_link->leg_start_ms, u32(g_link->send_mode),
+		VPUSH(g_actor->Position()));
+	g_link->leg_name[0] = 0;
+	g_link->drive_until = 0;
+	g_link->send_mode = Link::SendNormal;
+	g_link->record_batches = false;
+	g_link->drive_force_stance = false;
+}
