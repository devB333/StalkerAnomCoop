+// B38: an NPC's weapon as the server has it. The stalker's own object handler
+// runs on a replica too (its goal otherwise stays "no items": every weapon put
+// away), so the server's item is given to it as the goal, idle or on the strap,
+// never fire; the item moves from the backpack to its slot first when the
+// replica holds it there. A rise of the server's shot counter shows the
+// weapon's flash and sound (at most three per sample, as for a player).
+void apply_npc_weapon(CAI_Stalker* stalker, const coop::proto::EntityState& s)
+{
+	if (!(s.components & coop::proto::kWeapon) || !stalker->g_Alive())
+		return;
+	Link::Outcome& o = g_link->outcomes[u16(stalker->ID())];
+	const u8 slot = s.weapon_slot;
+	const bool strapped = (s.weapon_state & 0x80) != 0;
+	PIItem item = slot != NO_ACTIVE_SLOT ? stalker->inventory().ItemFromSlot(slot) : nullptr;
+	if (slot != NO_ACTIVE_SLOT && !item)
+		for (PIItem ruck : stalker->inventory().m_ruck)
+			if (ruck->BaseSlot() == slot && smart_cast<CWeapon*>(ruck) && stalker->inventory().CanPutInSlot(ruck, slot))
+			{
+				stalker->inventory().Slot(slot, ruck, true);
+				item = ruck;
+				break;
+			}
+	if (slot != o.slot || s.weapon_state != o.weapon_state)
+	{
+		g_link->log.line("npc-weapon id=%u slot=%u item=%s strapped=%d state=%u active=%s", u32(stalker->ID()), u32(slot),
+			item ? *item->object().cNameSect() : "-", strapped ? 1 : 0, u32(s.weapon_state & 0x7f),
+			stalker->inventory().ActiveItem() ? *stalker->inventory().ActiveItem()->object().cNameSect() : "-");
+		o.slot = slot;
+		o.weapon_state = s.weapon_state;
+		++g_link->npc_weapons_presented;
+	}
+	if (item)
+		stalker->CObjectHandler::set_goal(strapped ? MonsterSpace::eObjectActionStrapped : MonsterSpace::eObjectActionIdle,
+			&item->object());
+	else
+		stalker->CObjectHandler::set_goal(MonsterSpace::eObjectActionIdle);
+	CWeapon* weapon = smart_cast<CWeapon*>(stalker->inventory().ActiveItem());
+	if (s.ammo != o.ammo)
+	{
+		o.ammo = s.ammo;
+		if (weapon && weapon->GetAmmoElapsed() != int(s.ammo))
+			weapon->SetAmmoElapsed(int(s.ammo));
+	}
+	if (s.shots != o.shots)
+	{
+		const u16 fresh = o.shots == 0xffff ? 0 : u16(s.shots - o.shots);
+		o.shots = s.shots;
+		if (weapon)
+			for (u16 i = 0; i < _min<u16>(fresh, 3); ++i)
+			{
+				weapon->replica_present_shot();
+				++g_link->npc_shots_presented;
+			}
+	}
+}
