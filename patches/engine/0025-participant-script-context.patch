+lua_State* script_state()
+{
+	return g_pGameLevel ? ai().script_engine().lua() : nullptr;
+}
+
+// The compatibility layer keeps its state in _G.__campaign_ctx (a plain table).
+bool push_compat_table(lua_State* L)
+{
+	lua_pushstring(L, "__campaign_ctx");
+	lua_rawget(L, LUA_GLOBALSINDEX);
+	if (lua_istable(L, -1))
+	{
+		lua_pushstring(L, "installed");
+		lua_rawget(L, -2);
+		const bool installed = lua_toboolean(L, -1) != 0;
+		lua_pop(L, 1);
+		if (installed)
+			return true;
+	}
+	lua_pop(L, 1);
+	return false;
+}
+
+// After every push and pop: the layer reads the depth to decide what db.actor
+// is, and gives a participant actor without a Lua binder its db.storage entry.
+void sync_lua(bool entered)
+{
+	if (!server_role() || !s_stack)
+		return;
+	lua_State* L = script_state();
+	if (!L || !push_compat_table(L))
+		return;
+	lua_pushstring(L, "depth");
+	lua_pushnumber(L, lua_Number(s_stack->depth()));
+	lua_rawset(L, -3);
+	if (entered)
+	{
+		ScriptContext context;
+		if (s_stack->current(context) == Refusal::None && context.actor_key.id != kNoEngineId)
+		{
+			lua_pushstring(L, "on_enter");
+			lua_rawget(L, -2);
+			if (lua_isfunction(L, -1))
+			{
+				lua_pushnumber(L, lua_Number(context.actor_key.id));
+				if (lua_pcall(L, 1, 0, 0) != 0)
+				{
+					Msg("! S03-T05 compat on_enter failed: %s", lua_tostring(L, -1));
+					lua_pop(L, 1);
+				}
+			}
+			else
+				lua_pop(L, 1);
+		}
+	}
+	lua_pop(L, 1);
+}
+
+void format_uuid(const Uuid128& id, string64& out)
+{
+	xr_sprintf(out, "%016I64x%016I64x", id.hi, id.lo);
+}
+
+CGameObject* object_of(CInventoryOwner* owner)
+{
+	return smart_cast<CGameObject*>(owner);
+}
