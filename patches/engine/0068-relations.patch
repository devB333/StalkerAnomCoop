+// ------------------------------------------------------------ S10-T04d
+// Relations to the clients (CampaignEvent 18; decision T01-6). The engine's
+// relation registry keeps community goodwill per character, so two actors
+// already have their own on the server (the scripts' AC_ID is remapped in a
+// participant context; a literal 0 is mapped in the Lua exports). A client's
+// own registry is fed from here: kind 1 its actor's goodwill with every
+// community (u8 count x (u8 community index, s32 goodwill)), sent when a
+// value changed (RELATION_REGISTRY::SetCommunityGoodwill) and when the client
+// enters the world; kind 2 faction-vs-faction relations (u8 count x (u8 from,
+// u8 to, s32 value)), the whole table on entering in parts of 150 pairs and
+// the changed pairs to every client afterwards; kind 3 its actor's reputation
+// (s32), on change and on entering.
+// The faction-vs-faction table is not part of the engine's saved game (the
+// installed game_relations.script keeps its own changes in db.actor's pstor
+// and re-applies them on load, which inside a participant context would be
+// one player's pstor): the server keeps every pair it is told about in the
+// storage manager's state (m_data.coop_relations, saved with the
+// checkpoint) and applies the table once after a start (relations-1: a
+// relation set through the registry reverted after the restart).
+// true with the table in `out` (a default-constructed luabind::object has no
+// Lua state: never call type() on one, relations-2 crashed there)
+static bool relations_state_table(bool create, luabind::object& out)
+{
+	luabind::functor<luabind::object> get_state;
+	if (!ai().script_engine().functor("alife_storage_manager.get_state", get_state))
+		return false;
+	luabind::object state = get_state();
+	if (state.type() != LUA_TTABLE)
+		return false;
+	luabind::object table = state["coop_relations"];
+	if (table.type() != LUA_TTABLE && create)
+	{
+		table = luabind::newtable(ai().script_engine().lua());
+		state["coop_relations"] = table;
+	}
+	if (table.type() != LUA_TTABLE)
+		return false;
+	out = table;
+	return true;
+}
+
+static void relations_store(u8 from, u8 to, s32 value)
+{
+	luabind::object table;
+	if (relations_state_table(true, table))
+		table[int(from) * 256 + int(to)] = value;
+}
+
+static void relations_restore_once()
+{
+	if (g_host->relations_restored)
+		return;
+	g_host->relations_restored = true;
+	luabind::object table;
+	if (!relations_state_table(false, table))
+	{
+		g_host->log.line("relations-restore none");
+		return;
+	}
+	const u32 communities = u32(CHARACTER_COMMUNITY::GetMaxIndex()) + 1;
+	u32 applied = 0, differed = 0;
+	for (u32 from = 0; from < communities; ++from)
+		for (u32 to = 0; to < communities; ++to)
+		{
+			luabind::object entry = table[int(from) * 256 + int(to)];
+			if (entry.type() != LUA_TNUMBER)
+				continue;
+			const s32 value = luabind::object_cast<int>(entry);
+			if (RELATION_REGISTRY().GetCommunityRelation(u8(from), u8(to)) != value)
+				++differed;
+			RELATION_REGISTRY().SetCommunityRelation(u8(from), u8(to), value);
+			++applied;
+		}
+	g_host->relation_changes.clear(); // the joining clients get the whole table
+	g_host->log.line("relations-restore pairs=%u differed=%u", applied, differed);
+}
+
+void send_relations()
+{
+	relations_restore_once();
+	const u32 communities = u32(CHARACTER_COMMUNITY::GetMaxIndex()) + 1;
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!client_in_world(link))
+		{
+			link.relations_joined = false;
+			continue;
+		}
+		CActor* actor = participant_actor(link.ref);
+		CInventoryOwner* owner = actor ? smart_cast<CInventoryOwner*>(actor) : nullptr;
+		if (!owner)
+			continue;
+		if (!link.relations_joined)
+		{
+			link.relations_joined = true;
+			link.relations_dirty = true;
+			link.reputation_dirty = true;
+			std::vector<u8> p;
+			u32 count = 0, parts = 0;
+			for (u32 i = 0; i < communities; ++i)
+				for (u32 j = 0; j < communities; ++j)
+				{
+					if (p.empty())
+					{
+						put_u8(p, 2);
+						put_u8(p, 0);
+					}
+					put_u8(p, u8(i));
+					put_u8(p, u8(j));
+					put_u32(p, u32(RELATION_REGISTRY().GetCommunityRelation(u8(i), u8(j))));
+					if (++count == 150)
+					{
+						p[1] = u8(count);
+						queue_event(link, 18, p);
+						p.clear();
+						count = 0;
+						++parts;
+					}
+				}
+			if (count)
+			{
+				p[1] = u8(count);
+				queue_event(link, 18, p);
+				++parts;
+			}
+			g_host->log.line("relations-joined slot=%u communities=%u parts=%u", u32(link.ref.slot), communities, parts);
+		}
+		if (link.relations_dirty)
+		{
+			link.relations_dirty = false;
+			std::vector<u8> p;
+			put_u8(p, 1);
+			put_u8(p, u8(communities));
+			string1024 nonzero = "";
+			for (u32 i = 0; i < communities; ++i)
+			{
+				const s32 gw = RELATION_REGISTRY().GetCommunityGoodwill(u8(i), u16(actor->ID()));
+				put_u8(p, u8(i));
+				put_u32(p, u32(gw));
+				if (gw && xr_strlen(nonzero) < 900)
+				{
+					string128 one;
+					xr_sprintf(one, "%s%s=%d", nonzero[0] ? "," : "", *CHARACTER_COMMUNITY::IndexToId(u8(i)), gw);
+					xr_strcat(nonzero, one);
+				}
+			}
+			queue_event(link, 18, p);
+			++g_host->relations_sent;
+			g_host->log.line("relations-goodwill slot=%u actor=%u communities=%u nonzero=[%s]", u32(link.ref.slot), u32(actor->ID()),
+				communities, nonzero);
+		}
+		if (link.reputation_dirty)
+		{
+			link.reputation_dirty = false;
+			std::vector<u8> p;
+			put_u8(p, 3);
+			put_u32(p, u32(owner->Reputation()));
+			queue_event(link, 18, p);
+			++g_host->relations_sent;
+			g_host->log.line("relations-reputation slot=%u actor=%u reputation=%d", u32(link.ref.slot), u32(actor->ID()),
+				int(owner->Reputation()));
+		}
+	}
+	if (!g_host->relation_changes.empty())
+	{
+		const u32 n = _min<u32>(u32(g_host->relation_changes.size()), 150u);
+		std::vector<u8> p;
+		put_u8(p, 2);
+		put_u8(p, u8(n));
+		string512 pairs = "";
+		for (u32 k = 0; k < n; ++k)
+		{
+			const std::pair<u8, u8>& pr = g_host->relation_changes[k];
+			const s32 value = RELATION_REGISTRY().GetCommunityRelation(pr.first, pr.second);
+			put_u8(p, pr.first);
+			put_u8(p, pr.second);
+			put_u32(p, u32(value));
+			if (xr_strlen(pairs) < 400)
+			{
+				string128 one;
+				xr_sprintf(one, "%s%s/%s=%d", pairs[0] ? "," : "", *CHARACTER_COMMUNITY::IndexToId(pr.first),
+					*CHARACTER_COMMUNITY::IndexToId(pr.second), value);
+				xr_strcat(pairs, one);
+			}
+		}
+		g_host->relation_changes.erase(g_host->relation_changes.begin(), g_host->relation_changes.begin() + n);
+		broadcast_event(18, p);
+		++g_host->relations_sent;
+		g_host->log.line("relations-world pairs=%u [%s]", n, pairs);
+	}
+}
