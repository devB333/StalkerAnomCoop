+void upgrade_fixtures()
+{
+	const CoopConfig& config = g_host->config;
+	if (!config.upgrade_party || !ai().get_alife())
+		return;
+	Host::UpgradeFixture& f = g_host->upgrade_fixture;
+	PlayerLink* links[2] = {nullptr, nullptr};
+	CActor* actors[2] = {nullptr, nullptr};
+	u32 attached = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && attached < 2)
+			if (CActor* actor = participant_actor(link.ref))
+			{
+				links[attached] = &link;
+				actors[attached++] = actor;
+			}
+	if (!f.both_since)
+	{
+		if (attached < 2)
+			return;
+		f.both_since = g_host->tick;
+		f.recovered = g_host->persistence && g_host->persistence->recovered();
+		g_host->log.line("fixture-upgrade both-attached tick=%I64u recovered=%d", g_host->tick, f.recovered ? 1 : 0);
+	}
+	if (attached < 2 || f.phase >= 9 || g_host->tick < f.both_since + u64(config.upgrade_party) * 50)
+		return;
+	if (links[0]->ref.slot != 0)
+	{
+		std::swap(links[0], links[1]);
+		std::swap(actors[0], actors[1]);
+	}
+	PlayerLink& p1 = *links[0];
+	PlayerLink& p2 = *links[1];
+	if (f.recovered)
+	{
+		// what the restart kept: the first item of p1 with any upgrade, its condition
+		LPCSTR section = "-";
+		string2048 upgrades = "";
+		float condition = -1.f;
+		for (PIItem item : actors[0]->inventory().m_all)
+			if (item && item->has_any_upgrades())
+			{
+				section = *item->object().cNameSect();
+				item->get_upgrades_str(upgrades);
+				condition = item->GetCondition();
+				break;
+			}
+		g_host->log.line("fixture-upgrade recovered money_p1=%u upgrades_replayed=%I64u item=%s upgrades=[%s] condition=%.2f",
+			actors[0]->get_money(), g_host->upgrades_replayed, section, upgrades, condition);
+		g_host->log.line("fixture-upgrade done phase=recovered failures=%u", f.failures);
+		f.phase = 9;
+		return;
+	}
+	coop::proto::ActionIntent intent;
+	coop::proto::ActionResult result;
+	if (f.phase == 0)
+	{
+		if (g_host->tick < f.phase_tick)
+			return;
+		const CHARACTER_COMMUNITY_INDEX community = smart_cast<CInventoryOwner*>(actors[0])->CharacterInfo().Community().index();
+		f.mechanic = find_mechanic(actors[0]->Position(), community);
+		CGameObject* mech = f.mechanic != 0xffff ? smart_cast<CGameObject*>(Level().Objects.net_Find(f.mechanic)) : nullptr;
+		if (!mech && f.moves < 3)
+		{
+			// no mechanic online: the nearest offline one of this level (its character
+			// profile's mechanic_mode); both players moved beside it, which brings it
+			// online within the switch distance; tried again a few seconds later
+			const CSE_ALifeHumanStalker* best = nullptr;
+			float best_distance = flt_max;
+			for (const auto& o : ai().alife().objects().objects())
+			{
+				const CSE_ALifeHumanStalker* st = smart_cast<const CSE_ALifeHumanStalker*>(o.second);
+				if (!st || !st->g_Alive() || ai().game_graph().vertex(st->m_tGraphID)->level_id() != ai().level_graph().level_id())
+					continue;
+				CSpecificCharacter spec;
+				spec.Load(const_cast<CSE_ALifeHumanStalker*>(st)->specific_character());
+				if (!spec.upgrade_mechanic() && !is_mechanic_section(st->name_replace()))
+					continue;
+				const float d = st->o_Position.distance_to(actors[0]->Position()) + (st->m_community_index == community ? 0.f : 10000.f);
+				if (d < best_distance)
+				{
+					best_distance = d;
+					best = st;
+				}
+			}
+			++f.moves;
+			if (best)
+			{
+				place_beside(actors[0], Fvector().set(best->o_Position.x + 0.6f, best->o_Position.y, best->o_Position.z + 1.5f));
+				g_host->log.line("fixture-upgrade mechanic-offline id=%u name=%s distance=%.1f moved=%u", u32(best->ID),
+					const_cast<CSE_ALifeHumanStalker*>(best)->name_replace(), best_distance, f.moves);
+				f.phase_tick = g_host->tick + 6 * 50;
