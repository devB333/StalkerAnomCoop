+// ------------------------------------------------------------ S05-T03
+// Input: a player's latest input is held and applied to that player's actor
+// every tick through the control path's own state (the movement bits and the
+// camera the control path reads), only while the session is attached and the
+// input is fresh (250 ms); otherwise the actor gets no input. The actor is the
+// one the session's context resolves to (Scope::Self): a client cannot name
+// another. Snapshots: both participant actors' transform, velocity, health and
+// movement state at the snapshot rate.
+
+const u32 kInputHoldMs = 250;
+const u32 kManagedBits = mcFwd | mcBack | mcLStrafe | mcRStrafe | mcCrouch | mcAccel | mcSprint;
+
+void take_input(PlayerLink& link, const coop::proto::Decoded& message)
+{
+	const coop::proto::InputBatch& batch = std::get<coop::proto::InputBatch>(message.body);
+	const auto fresh = coop::proto::FreshInputs(batch, message.header.sequence, link.input_last);
+	if (fresh.empty())
+	{
+		++link.inputs_stale;
+		return;
+	}
+	link.held = fresh.back().second;
+	link.input_last = fresh.back().first;
+	link.has_held = true;
+	link.held_ms = g_host->wall.GetElapsed_ms();
+	link.inputs_taken += fresh.size();
+}
+
+void apply_inputs()
+{
+	const u32 now = g_host->wall.GetElapsed_ms();
+	// What the previous tick did with the input it was given.
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && link.has_held && now - link.last_input_log_ms < 20)
+			if (CActor* actor = participant_actor(link.ref))
+				g_host->log.line("input-after-tick slot=%u wishful=%x real=%x pos=%.2f,%.2f,%.2f", u32(link.ref.slot),
+					actor->replica_wishful(), actor->MovingState(), VPUSH(actor->Position()));
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	for (PlayerLink& link : g_host->links)
+	{
+		if (!link.bound)
+			continue;
+		CActor* actor = participant_actor(link.ref);
+		if (!actor || !actor->g_Alive())
+			continue;
+		actor->replica_set_wishful(actor->replica_wishful() & ~kManagedBits);
+		if (!link.session || !link.has_held || now - link.held_ms > kInputHoldMs)
+			continue; // detached or silent: no input
+		ActionContext context;
+		context.origin = Origin::ClientIntent;
+		context.session = link.session;
+		context.actor = link.ref;
+		context.party = party;
+		Refusal why = Refusal::None;
+		if (context_actor(context, Scope::Self, &why) != actor)
+		{
+			++link.input_refused;
+			continue;
+		}
+		const coop::proto::Input& in = link.held;
+		u32 bits = 0;
+		if (in.move_y > 0.5f)
+			bits |= mcFwd;
+		else if (in.move_y < -0.5f)
+			bits |= mcBack;
+		if (in.move_x > 0.5f)
+			bits |= mcRStrafe;
+		else if (in.move_x < -0.5f)
+			bits |= mcLStrafe;
+		if (in.stance == coop::proto::Stance::Crouch)
+			bits |= mcCrouch;
+		else if (in.stance == coop::proto::Stance::Sprint)
+			bits |= mcSprint;
+		if (in.buttons & 1)
+			bits |= mcAccel;
+		actor->replica_set_wishful(actor->replica_wishful() | bits);
+		actor->cam_Active()->yaw = in.yaw;
+		actor->cam_Active()->pitch = in.pitch;
+		if (bits & (mcFwd | mcBack | mcLStrafe | mcRStrafe))
+		{
+			++link.input_ticks;
+			if (now - link.last_input_log_ms >= 500)
+			{
+				link.last_input_log_ms = now;
+				g_host->log.line("input-apply slot=%u actor=%u move=%.1f,%.1f stance=%u yaw=%.3f wishful=%x real=%x "
+					"pos=%.2f,%.2f,%.2f enabled=%d processing=%d environment=%d character=%d can_move=%d "
+					"cant_walk=%d cant_walk_weight=%d talking=%d",
+					u32(link.ref.slot), u32(actor->ID()), in.move_x, in.move_y, u32(in.stance), in.yaw,
+					actor->replica_wishful(), actor->MovingState(), VPUSH(actor->Position()),
+					actor->getEnabled() ? 1 : 0, actor->processing_enabled() ? 1 : 0,
+					int(actor->character_physics_support()->movement()->Environment()),
+					actor->character_physics_support()->movement()->CharacterExist() ?
+						(actor->character_physics_support()->movement()->IsCharacterEnabled() ? 2 : 1) : 0,
+					actor->CanMove() ? 1 : 0, actor->conditions().IsCantWalk() ? 1 : 0,
+					actor->conditions().IsCantWalkWeight() ? 1 : 0, actor->IsTalking() ? 1 : 0);
+			}
+		}
+	}
+}
+
+bool snapshot_entity(CActor* actor, coop::proto::SnapshotEntity& out)
+{
+	if (!entity_ref_of(u16(actor->ID()), out.entity))
+		return false;
+	const Fvector& p = actor->Position();
+	if (!_valid(p) || _abs(p.x) > coop::proto::kMaxCoord || _abs(p.y) > coop::proto::kMaxCoord ||
+		_abs(p.z) > coop::proto::kMaxCoord)
+		return false;
+	out.components = coop::proto::kTransform | coop::proto::kVelocity | coop::proto::kHealth | coop::proto::kStateBits;
+	out.transform.x = p.x;
+	out.transform.y = p.y;
+	out.transform.z = p.z;
+	out.transform.yaw = angle_normalize_signed(actor->replica_model_yaw());
+	Fvector v;
+	v.set(0, 0, 0);
+	if (actor->character_physics_support()->movement()->CharacterExist())
+		actor->character_physics_support()->movement()->GetCharacterVelocity(v);
+	clamp(v.x, -coop::proto::kMaxSpeed, coop::proto::kMaxSpeed);
+	clamp(v.y, -coop::proto::kMaxSpeed, coop::proto::kMaxSpeed);
+	clamp(v.z, -coop::proto::kMaxSpeed, coop::proto::kMaxSpeed);
+	out.vx = v.x;
+	out.vy = v.y;
+	out.vz = v.z;
+	out.health = u16(iFloor(clampr(actor->GetfHealth(), 0.f, 1.f) * 10000.f + 0.5f));
+	out.state_bits = u16(actor->MovingState() & 0xffff);
+	return true;
+}
