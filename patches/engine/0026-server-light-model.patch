diff --git a/src/xrGame/CampaignServerLighting.cpp b/src/xrGame/CampaignServerLighting.cpp
new file mode 100644
index 0000000..b6b01ff
--- /dev/null
+++ b/src/xrGame/CampaignServerLighting.cpp
@@ -0,0 +1,139 @@
+#include "pch_script.h"
+#include "CampaignServerLighting.h"
+
+// S03-T06: see CampaignServerLighting.h.
+
+#include "CampaignActorAccess.h"
+#include "Actor.h"
+#include "Level.h"
+#include "../xrEngine/CameraBase.h"
+#include "../xrEngine/IGame_Persistent.h"
+#include "../xrEngine/Environment.h"
+#include "../xrEngine/device.h"
+#include "../xrEngine/Render.h"
+#include "../xrCDB/ISpatial.h"
+#include "../xrCDB/Frustum.h"
+
+namespace campaign
+{
+namespace
+{
+ServerLightingStats s_stats = {};
+u32 s_view_turn[2] = {0, 0}; // the client's uLastLTRACK, per participant slot
+xr_vector<ISpatial*> s_view_list;
+
+// The view's aspect: the camera's own times the window's height/width
+// (CCameraManager::Update). The server has no window; 16:9 is assumed.
+const float server_window_aspect = 9.f / 16.f;
+
+Fvector s_sort_from;
+bool by_distance(ISpatial* a, ISpatial* b)
+{
+	return a->spatial.sphere.P.distance_to_sqr(s_sort_from) < b->spatial.sphere.P.distance_to_sqr(s_sort_from);
+}
+
+// One renderable in the actor's view frustum, front to back, in turn: what the
+// client's render pass picks for its light tracking (r4_R_render.cpp:30-63).
+IRenderable* view_object(u8 slot, const CCameraBase* camera, float far_plane, bool& empty)
+{
+	empty = false;
+	Fmatrix view, project, full;
+	view.build_camera_dir(camera->vPosition, camera->vDirection, camera->vNormal);
+	const float aspect = (camera->f_aspect > 0.f ? camera->f_aspect : 1.f) * server_window_aspect;
+	project.build_projection(deg2rad(camera->f_fov), aspect, VIEWPORT_NEAR, far_plane);
+	full.mul(project, view);
+	CFrustum frustum;
+	frustum.CreateFromMatrix(full, FRUSTUM_P_LRTB + FRUSTUM_P_FAR);
+	s_view_list.clear();
+	g_SpatialSpace->q_frustum(s_view_list, ISpatial_DB::O_ORDERED, STYPE_RENDERABLE + STYPE_LIGHTSOURCE, frustum);
+	if (slot < 2)
+		s_stats.last_view_count[slot] = u32(s_view_list.size());
+	if (s_view_list.empty())
+	{
+		empty = true;
+		return nullptr;
+	}
+	s_sort_from = camera->vPosition;
+	std::sort(s_view_list.begin(), s_view_list.end(), by_distance);
+	const u32 turn = slot < 2 ? ++s_view_turn[slot] : 0;
+	return s_view_list[turn % s_view_list.size()]->dcast_Renderable();
+}
+} // namespace
+
+void server_lighting_frame()
+{
+	if (process_role() != Role::Server || !g_pGameLevel || !g_pGamePersistent)
+		return;
+	xr_vector<CActor*> actors;
+	if (!participant_actors(actors))
+		return;
+	const u64 qpc = CPU::QPC();
+	const Fvector camera_before = Device.vCameraPosition;
+	CEnvironment& environment = g_pGamePersistent->Environment();
+	for (CActor* actor : actors)
+	{
+		if (!actor || actor->getDestroy())
+			continue;
+		ParticipantRef ref;
+		const u8 slot = participant_of(actor, ref) == Refusal::None ? ref.slot : u8(-1);
+		const CCameraBase* camera = actor->cam_Active();
+		if (!camera)
+			continue;
+		// 1-3: the environment and the sun as this participant's client sees them.
+		Device.vCameraPosition = camera->vPosition;
+		if (environment.UpdateCPU())
+			++s_stats.env_updates;
+		else
+			++s_stats.env_failures;
+		Render->cpu_lighting_sun();
+		// 4: the participant's own actor, every tick.
+		if (Render->cpu_lighting_track(actor))
+			++s_stats.actor_tracks;
+		// 5: one object in its view, in turn.
+		const float far_plane = environment.CurrentEnv ? environment.CurrentEnv->far_plane : 300.f;
+		++s_stats.view_picks;
+		bool empty = false;
+		IRenderable* object = view_object(slot, camera, far_plane, empty);
+		if (empty)
+			++s_stats.view_empty;
+		else if (object && Render->cpu_lighting_track(object))
+		{
+			++s_stats.view_tracks;
+			CObject* as_object = dynamic_cast<CObject*>(object);
+			if (slot < 2)
+				s_stats.last_view_object[slot] = as_object ? as_object->ID() : u16(-1);
+		}
+		else
+			++s_stats.view_skipped;
+	}
+	Device.vCameraPosition = camera_before;
+	++s_stats.frames;
+	s_stats.qpc_total += CPU::QPC() - qpc;
+}
+
+const ServerLightingStats& server_lighting_stats()
+{
+	return s_stats;
+}
+
+float actor_luminocity(const CActor* actor)
+{
+	IRender_ObjectSpecific* ros = actor ? const_cast<CActor*>(actor)->renderable_ROS() : nullptr;
+	return ros ? ros->get_luminocity() : -1.f;
+}
+
+float actor_luminocity_hemi(const CActor* actor)
+{
+	IRender_ObjectSpecific* ros = actor ? const_cast<CActor*>(actor)->renderable_ROS() : nullptr;
+	return ros ? ros->get_luminocity_hemi() : -1.f;
+}
+
+void report_server_lighting(LPCSTR tag)
+{
+	const double ms = s_stats.frames ? double(s_stats.qpc_total) * 1000.0 / double(CPU::qpc_freq) : 0.0;
+	Msg("S03-T06 server-lighting %s frames=%I64u env_updates=%I64u env_failures=%I64u actor_tracks=%I64u "
+		"view_picks=%I64u view_tracks=%I64u view_skipped=%I64u view_empty=%I64u total_ms=%.3f per_frame_us=%.2f",
+		tag, s_stats.frames, s_stats.env_updates, s_stats.env_failures, s_stats.actor_tracks, s_stats.view_picks,
+		s_stats.view_tracks, s_stats.view_skipped, s_stats.view_empty, ms, s_stats.frames ? ms * 1000.0 / double(s_stats.frames) : 0.0);
+}
+} // namespace campaign
diff --git a/src/xrGame/CampaignServerLighting.h b/src/xrGame/CampaignServerLighting.h
new file mode 100644
index 0000000..2fe2506
--- /dev/null
+++ b/src/xrGame/CampaignServerLighting.h
@@ -0,0 +1,57 @@
+#pragma once
+
+// S03-T06: the campaign server's light model for AI vision.
+//
+// AI vision scales a target's visibility by the target's luminosity
+// (CVisualMemoryManager::object_luminocity, visual_memory_manager.cpp), read
+// from the object's render-specific data (CROS_impl, LightTrack.cpp). On a
+// client the renderer fills it every frame for two objects: the view entity
+// and one renderable in the camera frustum, in turn (r4_R_render.cpp), from a
+// ray toward the sun, rays toward the sky, the level's static lights in range
+// (each with an occlusion ray), and the environment's ambient, sky and sun
+// colours at the camera. The server never renders, so every luminosity
+// stayed 0 and AI saw everyone as in darkness.
+//
+// Every server tick, for each participant actor, this does what a client does
+// for its own view (user decision 2026-10-19: no other NPC is refreshed):
+//  1. the camera position is the actor's eye (its active camera);
+//  2. the environment blends weather and time of day with the level's
+//     modifiers at that eye (CEnvironment::UpdateCPU);
+//  3. the sun is aimed from that environment (CLight_DB::Update);
+//  4. the actor's light tracking runs (CROS_impl::update, the client's code);
+//  5. one object in the actor's view frustum, front to back and in turn,
+//     gets the same update.
+// The level's sun and static hemi lights are loaded as CPU objects with the
+// level (IGame_Level::Load, CRender::cpu_lighting_load). Dynamic lights
+// (flashlights, campfires, lamps) do not count, as on the DX11 client.
+
+class CActor;
+
+namespace campaign
+{
+struct ServerLightingStats
+{
+	u64 frames; // server_lighting_frame calls with work done
+	u64 env_updates; // per-participant environment blends
+	u64 env_failures; // ...refused (no level or weather)
+	u64 actor_tracks; // participant actors updated
+	u64 view_picks; // one pick per participant per frame
+	u64 view_tracks; // ...that updated an object
+	u64 view_skipped; // ...that fell on a light or an object with no light tracking (the client skips these too)
+	u64 view_empty; // ...in an empty frustum
+	u64 qpc_total; // time spent, QPC ticks
+	u32 last_view_count[2]; // frustum list size per slot, last frame
+	u16 last_view_object[2]; // the object updated in that view, last frame
+};
+
+// The campaign server, every level frame (Level.cpp).
+void server_lighting_frame();
+const ServerLightingStats& server_lighting_stats();
+// The actor's luminosity and sky term as AI vision reads them.
+float actor_luminocity(const CActor* actor);
+float actor_luminocity_hemi(const CActor* actor);
+void report_server_lighting(LPCSTR tag);
+} // namespace campaign
+
+// Normal client, -s03-lighting-capture (CampaignLightingFixture.cpp).
+void ClientLightingCaptureOnFrame();
