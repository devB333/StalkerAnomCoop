+luabind::object lua_available(u16 npc_id)
+{
+	luabind::object manager = luabind::get_globals(ai().script_engine().lua())["axr_task_manager"];
+	if (manager.type() != LUA_TTABLE)
+		return lua_nil();
+	luabind::object available = manager["available_tasks"];
