+u16 take_respawn(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	CoopPersistence* persistence = g_host->persistence;
+	// 1. Receive: a known operation returns its stored outcome.
+	StoredOutcome stored;
+	if (persistence && persistence->lookup(link.player, intent.operation_id, stored))
+	{
+		result.outcome = coop::proto::ActionOutcome(stored.outcome);
+		result.reason = stored.reason;
+		result.commit_id = stored.revision;
+		result.revision = stored.revision;
+		g_host->log.line("respawn-duplicate player=%s operation=%I64u revision=%I64u", coop_uuid_hex(link.player).c_str(),
+			intent.operation_id, stored.revision);
+		return stored.reason;
+	}
+	// 2. Prepare / validate.
+	if (!link.session)
+		return 3;
+	if (!intent.params.empty())
+		return 2;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	if (!actor)
+		return 3;
+	if (actor->g_Alive())
+	{
+		++link.respawn_refused;
+		return 6; // alive: nothing to respawn from (an early or forged request)
+	}
+	coop::proto::EntityRef old_ref;
+	if (!entity_ref_of(actor->ID(), old_ref))
+		return 3;
+	if (!persistence || persistence->failed())
+	{
+		++g_host->ledger_store_failed;
+		return kActionReasonStoreFailed;
+	}
+	// 3. Resolve: the point and the new identity.
+	RespawnRecord record;
+	record.slot = link.ref.slot;
+	record.player = link.player;
+	record.operation = intent.operation_id;
+	record.old_entity = old_ref.id;
+	Fvector position;
+	u32 vertex = u32(-1);
+	u16 graph = 0;
+	LPCSTR source = "";
+	if (!respawn_point(link, u16(actor->ID()), position, vertex, graph, source))
+		return 7; // no respawn point (no checkpoint holds this actor and it was never seen alive here)
+	record.new_entity = g_campaign_identity->reserve_entity().value;
+	record.position[0] = position.x;
+	record.position[1] = position.y;
+	record.position[2] = position.z;
+	record.vertex = vertex;
+	record.graph = graph;
+	const u64 revision = ++g_host->commit;
+	// 4. Durable commit.
+	if (!coop::store::failpoint("respawn:before-append"))
+		persistence->fail_closed("failpoint respawn:before-append");
+	if (!persistence->commit(coop::store::kRecordRespawn, g_host->tick, revision, encode_respawn(record)))
+	{
+		++g_host->ledger_store_failed;
+		g_host->log.line("respawn-store-failed revision=%I64u operation=%I64u reason=%s", revision, intent.operation_id,
+			persistence->failure());
+		g_host->stop_requested = true;
+		return kActionReasonStoreFailed;
+	}
+	coop::store::failpoint("respawn:after-commit");
+	++g_host->respawns_committed;
+	g_host->log.line("respawn-committed revision=%I64u slot=%u operation=%I64u old_entity=%I64u new_entity=%I64u "
+		"point=%s pos=%.2f,%.2f,%.2f vertex=%u",
+		revision, u32(record.slot), intent.operation_id, record.old_entity, record.new_entity, source, VPUSH(position),
+		vertex);
+	// 5. Apply.
+	apply_respawn(record, "apply", revision);
+	coop::store::failpoint("respawn:after-apply");
+	++link.respawns;
+	stored.outcome = u8(coop::proto::ActionOutcome::Accepted);
+	stored.reason = 0;
+	stored.revision = revision;
+	persistence->remember(link.player, intent.operation_id, stored);
+	result.outcome = coop::proto::ActionOutcome::Accepted;
+	result.commit_id = revision;
+	result.revision = revision;
+	return 0;
+}
