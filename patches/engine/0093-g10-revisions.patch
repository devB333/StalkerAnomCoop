+	const u16 part = p[12] == 1 ? engine_id_of(part_ref) : 0xffff;
+	auto owned = [actor](u16 id) {
+		CObject* o = id != kNoEngineId ? Level().Objects.net_Find(id) : nullptr;
+		CSE_Abstract* se = id != kNoEngineId ? Level().Server->ID_to_entity(id) : nullptr;
+		return o && se && !o->getDestroy() && o->H_Parent() == actor && se->ID_Parent == actor->ID() &&
+			!g_host->use_consumed.count(id);
+	};
