diff --git a/src/xrEngine/CampaignBoneCapture.cpp b/src/xrEngine/CampaignBoneCapture.cpp
new file mode 100644
index 0000000..7ad819f
--- /dev/null
+++ b/src/xrEngine/CampaignBoneCapture.cpp
@@ -0,0 +1,90 @@
+#include "stdafx.h"
+#include "CampaignBoneCapture.h"
+
+#include "Render.h"
+#include "SkeletonMotions.h"
+#include "../Include/xrRender/Kinematics.h"
+#include "../Include/xrRender/KinematicsAnimated.h"
+#include "../Include/xrRender/RenderVisual.h"
+
+bool CaptureModelBones(LPCSTR model, u32 steps, void (*advance)(void* context), void* context,
+	LPCSTR out_path, BoneCaptureSummary& summary)
+{
+	ZeroMemory(&summary, sizeof(summary));
+	IRenderVisual* visual = ::Render->model_Create(model);
+	IKinematics* kinematics = visual ? visual->dcast_PKinematics() : nullptr;
+	IKinematicsAnimated* animated = visual ? visual->dcast_PKinematicsAnimated() : nullptr;
+	FILE* out = nullptr;
+	bool ok = kinematics && animated && animated->LL_MotionsSlotCount() != 0;
+
+	// The first cycle, by slot then name, that is not an editor placeholder
+	// such as "$editor".
+	MotionID motion;
+	if (ok)
+	{
+		for (u16 slot = 0; slot < animated->LL_MotionsSlotCount() && !motion.valid(); ++slot)
+		{
+			accel_map* cycles = const_cast<shared_motions&>(animated->LL_MotionsSlot(slot)).cycle();
+			if (!cycles)
+				continue;
+			for (const auto& cycle : *cycles)
+			{
+				LPCSTR name = cycle.first.c_str();
+				if (name && name[0] && name[0] != '$')
+				{
+					xr_strcpy(summary.motion, *cycle.first);
+					motion = animated->ID_Cycle_Safe(summary.motion);
+					break;
+				}
+			}
+		}
+		ok = motion.valid();
+	}
+	if (ok)
+	{
+		out = fopen(out_path, "w");
+		ok = out != nullptr;
+	}
+
+	if (ok)
+	{
+		animated->PlayCycle(motion, FALSE);
+		const u16 bones = kinematics->LL_BoneCount();
+		xr_vector<Fvector> first;
+		first.resize(bones);
+		summary.finite = true;
+		fprintf(out, "step,bone,name,ix,iy,iz,jx,jy,jz,kx,ky,kz,cx,cy,cz\n");
+		for (u32 step = 1; step <= steps; ++step)
+		{
+			advance(context);
+			kinematics->CalculateBones(TRUE);
+			for (u16 bone = 0; bone < bones; ++bone)
+			{
+				const Fmatrix& m = kinematics->LL_GetTransform(bone);
+				const float values[12] = {m.i.x, m.i.y, m.i.z, m.j.x, m.j.y, m.j.z,
+					m.k.x, m.k.y, m.k.z, m.c.x, m.c.y, m.c.z};
+				fprintf(out, "%u,%u,%s", step, bone, kinematics->LL_BoneName_dbg(bone));
+				for (float value : values)
+				{
+					fprintf(out, ",%.9g", value);
+					if (!_valid(value))
+						summary.finite = false;
+				}
+				fprintf(out, "\n");
+				if (step == 1)
+					first[bone] = m.c;
+				else
+					summary.max_translation = _max(summary.max_translation, first[bone].distance_to(m.c));
+			}
+		}
+		summary.bones = bones;
+		summary.steps = steps;
+	}
+
+	if (out)
+		fclose(out);
+	if (visual)
+		::Render->model_Delete(visual);
+	// A capture must be finite and actually animated.
+	return ok && summary.finite && summary.max_translation > 1e-3f;
+}
diff --git a/src/xrEngine/CampaignBoneCapture.h b/src/xrEngine/CampaignBoneCapture.h
new file mode 100644
index 0000000..60d65db
--- /dev/null
+++ b/src/xrEngine/CampaignBoneCapture.h
@@ -0,0 +1,21 @@
+#pragma once
+
+// S02-T03c: evaluates one model's bones while it plays one cycle, so the
+// campaign server's CPU-only models can be compared with the normal client.
+// Both processes call this with the same model, the same motion rule (the
+// first non-placeholder cycle by slot, then name) and the same step count; only
+// the time source differs. Each step advances time through `advance`, then
+// calculates bones
+// exactly. Rows are "step,bone,name" plus the 12 values of the bone's model
+// transform (rotation rows i, j, k and translation c).
+struct ENGINE_API BoneCaptureSummary
+{
+	u32 bones;
+	u32 steps;
+	string128 motion;
+	float max_translation; // largest bone translation change from step 1
+	bool finite;
+};
+
+ENGINE_API bool CaptureModelBones(LPCSTR model, u32 steps, void (*advance)(void* context), void* context,
+	LPCSTR out_path, BoneCaptureSummary& summary);
