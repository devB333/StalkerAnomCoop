+// ------------------------------------------------------------ B51
+// The smoothness walk (profile script = 9): both players move at once, plainly (no forged stream), so each
+// client's motion log (coop-motion-client.csv) holds its own actor and the other's in every kind of movement:
+// run and return, back and walk, strafes, sprint and return, a running circle, three rounds. Each leg is logged
+// (script-leg-start / script-leg) for tools/compare-coop-smoothness.py.
+void run_script9(u32 t)
+{
+	if (!g_link->program_t0)
+	{
+		if (!other_actor())
+		{
+			g_link->other_since = 0;
+			return;
+		}
+		if (!g_link->other_since)
+			g_link->other_since = t;
+		if (t < g_link->other_since + 3000)
+			return;
+		g_link->program_t0 = t;
+		face_away_from_other();
+		g_link->log.line("script9-program-start slot=%u t=%u", u32(g_link->local_slot), t);
+	}
+	using coop::proto::Stance;
+	// Out and back: each leg is undone by a later one, so a round ends about where it began (open ground: a
+	// one-way walk ran into the world, and contact is where the two simulations differ most)
+	struct Leg
+	{
+		LPCSTR name;
+		u32 bits;
+		Stance stance;
+		bool force_stance;
+		u32 ms;
+		float turn; // rad/s
+		bool reverse; // turned 180 degrees first
+	};
+	static const Leg legs[] = {
+		{"run", mcFwd, Stance::Stand, false, 3000, 0.f, false},
+		{"stand", 0, Stance::Stand, false, 800, 0.f, false},
+		{"return", mcFwd, Stance::Stand, false, 3000, 0.f, true},
+		{"stand", 0, Stance::Stand, false, 800, 0.f, false},
+		{"back", mcBack, Stance::Stand, false, 2000, 0.f, false},
+		{"walk", mcFwd | mcAccel, Stance::Stand, false, 2600, 0.f, false},
+		{"strafe-left", mcLStrafe, Stance::Stand, false, 2000, 0.f, false},
+		{"strafe-right", mcRStrafe, Stance::Stand, false, 2000, 0.f, false},
+		{"sprint", mcFwd | mcSprint, Stance::Sprint, true, 1500, 0.f, false},
+		{"stand", 0, Stance::Stand, false, 800, 0.f, false},
+		{"sprint-return", mcFwd | mcSprint, Stance::Sprint, true, 1500, 0.f, true},
+		{"stand", 0, Stance::Stand, false, 800, 0.f, false},
+		{"circle", mcFwd, Stance::Stand, false, 5236, 1.2f, false}, // one full turn at 1.2 rad/s
+		{"stand", 0, Stance::Stand, false, 1000, 0.f, false},
+	};
+	const u32 per_round = u32(sizeof(legs) / sizeof(legs[0]));
+	const u32 rounds = 3;
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (g_link->leg_name[0] && g_link->drive_turn != 0.f)
+	{
+		CCameraBase* camera = g_actor->cam_Active();
+		camera->yaw = angle_normalize_signed(camera->yaw + g_link->drive_turn * Device.fTimeDelta);
+	}
+	if (g_link->leg_name[0] || g_link->drive_until)
+		return; // the current leg runs (leg_end_check ends it)
+	if (!g_link->smooth_separated)
+	{
+		// first apart (about 11 m each): the rounds never meet, and contact between the players (where the
+		// two simulations differ most: bugfix-48) is left to its own test
+		g_link->smooth_separated = true;
+		g_link->drive_turn = 0.f;
+		face_away_from_other();
+		leg_begin("separate-0", mcFwd, Stance::Stand, false, 4000, Link::SendNormal);
+		return;
+	}
+	if (g_link->script_phase >= per_round * rounds)
+	{
+		if (g_link->script_phase == per_round * rounds)
+		{
+			++g_link->script_phase;
+			g_link->log.line("script9-program-end rounds=%u", rounds);
+		}
+		return;
+	}
+	const u32 round = g_link->script_phase / per_round;
+	const Leg& leg = legs[g_link->script_phase % per_round];
+	if (leg.reverse)
+		g_actor->cam_Active()->yaw = angle_normalize_signed(g_actor->cam_Active()->yaw + PI);
+	string64 name;
+	xr_sprintf(name, "%s-%u", leg.name, round + 1);
+	g_link->drive_turn = leg.turn;
+	leg_begin(name, leg.bits, leg.stance, leg.force_stance, leg.ms, Link::SendNormal);
+	++g_link->script_phase;
+	(void)now;
+}
