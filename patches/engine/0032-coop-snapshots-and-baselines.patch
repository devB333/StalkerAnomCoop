+// A state reaches the track of the engine object it names, if this client
+// has that incarnation; otherwise it is counted (a Spawn not applied yet: the
+// track is seeded from the newest snapshot when it is).
+void push_state(double server_ms, u64 tick, const coop::proto::EntityState& s)
+{
+	const auto it = g_link->by_entity.find(s.entity.id);
+	const auto ref = it == g_link->by_entity.end() ? g_link->refs.end() : g_link->refs.find(it->second);
+	if (ref == g_link->refs.end() || !(ref->second == s.entity))
+	{
+		++g_link->snapshot_unknown;
+		return;
+	}
+	Link::Track& t = g_link->tracks[it->second];
+	if (!t.buffer.push(server_ms, s, kSnapshotIntervalMs))
+		return;
+	t.last.set(s.transform.x, s.transform.y, s.transform.z);
+	t.state = s.state_bits;
+	t.server_tick = tick;
+	++g_link->snapshot_states;
+}
+
+// An entity this client learned about after its states went by: its state in
+// the newest complete snapshot.
+void seed_track(u16 id)
+{
+	const auto ref = g_link->refs.find(id);
+	if (ref == g_link->refs.end() || g_link->tracks.count(id))
+		return;
+	u64 tick = 0;
+	const coop::proto::SnapshotFrame* frame = g_link->receiver.newest_frame(&tick);
+	if (!frame)
+		return;
+	const auto it = frame->find(ref->second.id);
+	if (it == frame->end() || !(it->second.entity == ref->second))
+		return;
+	Link::Track& t = g_link->tracks[id];
+	t.buffer.push(double(tick) * double(kServerTickMs), it->second, 0);
+	t.last.set(it->second.transform.x, it->second.transform.y, it->second.transform.z);
+	t.state = it->second.state_bits;
+	t.server_tick = tick;
+	++g_link->seeded;
+}
