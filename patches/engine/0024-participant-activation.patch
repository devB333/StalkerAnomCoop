 {
 }
 
+// S03-T04: the switch rules (CSE_ALifeDynamicObject::try_switch_online /
+// try_switch_offline, the online-offline groups, the monster groups) compared
+// an object's distance to the one ALife actor (CALifeGraphRegistry::actor())
+// with the online/offline distances. On the campaign server the comparison is
+// against the nearest alive participant actor instead, so an object near
+// either player stays online and an object far from both goes offline. The
+// positions are the participant actors' server entities, the same state the
+// engine measured for the ALife actor (updated from each actor's net_Export).
+// With no alive participant actor the ALife actor's position is used, the
+// engine's own rule, so the world never loses its anchor. A client never
+// changes: it still reads the ALife actor live.
+void CALifeSwitchManager::refresh_activation_anchors()
+{
+	m_activation_anchors.clear();
+	m_activation_from_participants = false;
+	if (campaign::process_role() != campaign::Role::Server)
+		return;
+	xr_vector<CSE_ALifeCreatureActor*> actors;
+	campaign::participant_actor_entities(actors);
+	for (u32 i = 0; i < actors.size(); ++i)
+	{
+		if (!actors[i]->g_Alive())
+			continue;
+		m_activation_anchors.push_back(actors[i]->o_Position);
+	}
+	m_activation_from_participants = !m_activation_anchors.empty();
+}
+
+float CALifeSwitchManager::activation_distance(const Fvector& position) const
+{
+	if (!m_activation_from_participants)
+		return graph().actor()->o_Position.distance_to(position);
+	float best = flt_max;
+	for (u32 i = 0; i < m_activation_anchors.size(); ++i)
+	{
+		const float distance = m_activation_anchors[i].distance_to(position);
+		if (distance < best)
+			best = distance;
+	}
+	return best;
+}
+
 void CALifeSwitchManager::add_online(CSE_ALifeDynamicObject* object, bool update_registries)
 {
 	START_PROFILE("ALife/switch/add_online")
