+u32 participant_actor_entities(xr_vector<CSE_ALifeCreatureActor*>& out)
+{
+	out.clear();
+	if (!server_role() || !g_pGameLevel || !Level().Server)
+		return 0;
+	const CampaignIdentityRegistry& registry = *g_campaign_identity;
+	for (u8 slot = 0; slot < registry.active_slots(); ++slot)
+	{
+		ParticipantRef ref;
+		EngineEntityKey key;
+		if (registry.current_participant(slot, ref) != Refusal::None ||
+			registry.participant_actor_key(ref, key) != Refusal::None)
+			continue;
+		CSE_ALifeCreatureActor* entity = smart_cast<CSE_ALifeCreatureActor*>(Level().Server->ID_to_entity(key.id));
+		if (entity)
+			out.push_back(entity);
+	}
+	return u32(out.size());
+}
