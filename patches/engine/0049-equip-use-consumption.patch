+// S08-T07 (the equip and use section above)
+void coop_client_inventory_event(u16 type, u16 destination, NET_Packet& P)
+{
+	if (!g_link || !g_link->active || g_link->world != WorldLive || !g_actor || P.r_elapsed() < 2)
+		return;
+	if (destination != g_actor->ID())
+	{
+		++g_link->inventory_events_ignored; // not this player's own actor
+		return;
+	}
+	const u16 item = P.r_u16();
+	coop::proto::EntityRef item_ref;
+	if (!ref_of(item, item_ref))
+	{
+		++g_link->inventory_events_ignored;
+		g_link->log.line("inventory-event-unknown type=%u item=%u", u32(type), u32(item));
+		return;
+	}
+	if (type == GEG_PLAYER_ITEM_EAT)
+	{
+		inventory_intent(coop::proto::kActionUse, item, item_ref, xr_vector<u8>());
+		return;
+	}
+	xr_vector<u8> params;
+	u8 slot = 0, flags = 0;
+	if (type == GEG_PLAYER_ITEM2SLOT)
+	{
+		if (P.r_elapsed() >= 2)
+			slot = u8(P.r_u16());
+		if (P.r_elapsed() >= 1)
+			flags = P.r_u8() == 1 ? 1 : 0;
+	}
+	params.push_back(type == GEG_PLAYER_ITEM2SLOT ? 1 : type == GEG_PLAYER_ITEM2BELT ? 2 : 3);
+	params.push_back(slot);
+	params.push_back(flags);
+	inventory_intent(coop::proto::kActionEquip, item, item_ref, params);
+}
+
+bool coop_client_eat(CInventoryOwner* owner, CInventoryItem* item)
+{
+	if (!g_link || !g_link->active || !campaign::replica_active() || campaign::replica_permitted())
+		return false;
+	++g_link->local_eats_blocked;
+	coop::proto::EntityRef item_ref;
+	if (g_link->world == WorldLive && g_actor && item && owner == smart_cast<CInventoryOwner*>(g_actor) &&
+		ref_of(u16(item->object().ID()), item_ref))
+		inventory_intent(coop::proto::kActionUse, u16(item->object().ID()), item_ref, xr_vector<u8>());
+	return true; // nothing is used locally on a replica
+}
