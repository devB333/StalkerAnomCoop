+Refusal CampaignIdentityRegistry::restore_participant(const ServerAuthority* authority, u8 slot, u32 generation,
+	const PlayerId& player, const PartyId& party, u64 now, ParticipantRef& out)
+{
+	if (!authorized(authority))
+		return Refusal::NotAuthoritative;
+	if (!player.valid() || !party.valid() || generation == 0)
+		return Refusal::InvalidIdentity;
+	if (slot >= m_slots.size())
+		return Refusal::UnknownParticipant;
+	ParticipantRef existing;
+	if (find_player(player, existing) == Refusal::None)
+		return Refusal::AlreadyBound;
+	Participant& p = m_slots[slot];
+	if (p.state != ParticipantState::Free)
+		return Refusal::AlreadyBound;
+	clear_identity(p);
+	p.state = ParticipantState::Bound;
+	p.generation = generation;
+	p.player = player;
+	p.party = party;
+	p.bound_at = now;
+	out.slot = slot;
+	out.generation = generation;
+	return Refusal::None;
+}
