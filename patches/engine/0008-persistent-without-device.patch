+// S02-T05a: the real game persistent object. LALib comes first, as in the
+// native Startup; the persistent object's own frame is presentation work and
+// is never registered, because the frame driver owns its slot. Its app start
+// keeps the environment data and skips the UI and menu (campaign branch in
+// CGamePersistent::OnAppStart).
+bool StartCampaignPersistent()
+{
+    LALib.OnCreate();
+    g_pGamePersistent = (IGame_Persistent*)NEW_INSTANCE(CLSID_GAME_PERSISTANT);
+    if (!g_pGamePersistent)
+    {
+        LALib.OnDestroy();
+        return false;
+    }
+    Device.seqFrame.Remove(g_pGamePersistent);
+    g_pGamePersistent->OnAppStart();
+    return true;
+}
+
+void StopCampaignPersistent()
+{
+    g_pGamePersistent->OnAppEnd();
+    DEL_INSTANCE(g_pGamePersistent);
+    LALib.OnDestroy();
+}
+
+// The environment data loaded by app start, and the game parameters the
+// client's load command would set for the fixture save.
+bool RunCampaignPersistentFixture()
+{
+    CEnvironment& env = g_pGamePersistent->Environment();
+    u32 descriptors = 0;
+    for (const auto& cycle : env.WeatherCycles)
+        descriptors += u32(cycle.second.size());
+    for (const auto& effect : env.WeatherFXs)
+        descriptors += u32(effect.second.size());
+    u32 sun_hours = 0;
+    for (const Fvector2& hp : env.sun_hp)
+        if (hp.x != 0.f || hp.y != 0.f)
+            ++sun_hours;
+
+    LPCSTR options = "player - autosave/single/alife/load";
+    g_pGamePersistent->PreStart(options);
+    g_pGamePersistent->Start(options);
+    const IGame_Persistent::params& p = g_pGamePersistent->m_game_params;
+    const bool params_ok = !xr_strcmp(p.m_game_or_spawn, "player - autosave") &&
+        !xr_strcmp(p.m_game_type, "single") && !xr_strcmp(p.m_alife, "alife") &&
+        !xr_strcmp(p.m_new_or_load, "load") && g_pGamePersistent->GameType() == (u32(1) << 0); // eGameIDSingle
+    Msg("S02-T05a persistent params save=%s type=%s alife=%s mode=%s game_type=%u",
+        p.m_game_or_spawn, p.m_game_type, p.m_alife, p.m_new_or_load, g_pGamePersistent->GameType());
+    g_pGamePersistent->Disconnect();
+    const bool disconnected = g_pGamePersistent->GameType() == 0;
+
+    IRender_interface::CpuModelStats stats = {};
+    ::Render->cpu_models_stats(stats);
+    Msg("S02-T05a environment weather_cycles=%u weather_effects=%u descriptors=%u ambients=%u sun_hours=%u "
+        "main_menu=%d skipped_textures=%u skipped_shaders=%u skipped_environment_sounds=%u device_absent=%d",
+        u32(env.WeatherCycles.size()), u32(env.WeatherFXs.size()), descriptors, u32(env.Ambients.size()),
+        sun_hours, g_pGamePersistent->m_pMainMenu ? 1 : 0, stats.skipped_textures, stats.skipped_shaders,
+        g_skipped_environment_sounds, stats.device_absent ? 1 : 0);
+    return !env.WeatherCycles.empty() && descriptors != 0 && sun_hours != 0 && params_ok && disconnected &&
+        stats.device_absent && stats.skipped_textures != 0 && !g_pGamePersistent->m_pMainMenu;
+}
+
