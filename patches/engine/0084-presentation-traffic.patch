+// S10-T05d1: a routed play (at a position, or 2D when at is null). The muted world run of the surge
+// plays nothing for the players, and the sound is then not routed (its volumes and stops are not
+// sent). Only a play every player hears is a live loop, played again to a player entering the world.
+// slot/generation: who got it (kBroadcastSlot for every player).
+static bool coop_route_play(u32 handle, LPCSTR name, const Fvector* at, float delay, u32 flags, u8& slot,
+                            u32& generation)
+{
+	campaign::ParticipantRef player = {campaign::kBroadcastSlot, 0};
+	const campaign::ScriptAudience audience = campaign::script_audience(&player);
+	slot = campaign::kBroadcastSlot;
+	generation = 0;
+	if (audience == campaign::ScriptAudience::Nobody)
+	{
+		coop_script_sound_gone(handle);
+		return false;
+	}
+	coop_script_sound_present(at ? 1 : 0, handle, name, at, delay, flags);
+	if (audience == campaign::ScriptAudience::Everyone)
+		coop_script_sound_live(handle, name, flags, at);
+	else
+	{
+		slot = player.slot;
+		generation = player.generation;
+		coop_script_sound_gone(handle);
+	}
+	return true;
+}
+
+bool coop_script_sound_follow(u8 kind, u32 handle, u8 slot, u32 generation, const Fvector* position, float value)
+{
+	if (campaign::process_role() != campaign::Role::Server)
+		return false;
+	if (slot == campaign::kBroadcastSlot)
+	{
+		coop_script_sound_present(kind, handle, "", position, value, 0);
+		return true;
+	}
+	campaign::ParticipantRef now = {campaign::kBroadcastSlot, 0};
+	const campaign::ScriptAudience audience = campaign::script_audience(&now);
+	// another player's context (two players' passes share a sound theme's object), or muted
+	if (audience == campaign::ScriptAudience::Nobody ||
+		(audience == campaign::ScriptAudience::Player && (now.slot != slot || now.generation != generation)))
+	{
+		++g_coop_follow_dropped;
+		return false;
+	}
+	if (audience == campaign::ScriptAudience::Player)
+	{
+		coop_script_sound_present(kind, handle, "", position, value, 0);
+		return true;
+	}
+	// outside any context: to the player who got the play
+	campaign::PresentationArgs args;
+	args.handle = handle;
+	if (position)
+		args.position = *position;
+	args.value = value;
+	campaign::ParticipantRef to = {slot, generation};
+	return campaign::present(to, s_sound_kinds[kind], 0, "", args) == campaign::Refusal::None;
+}
