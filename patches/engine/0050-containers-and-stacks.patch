+// S08-T08: CampaignEvent 10: items' amounts (an ammunition box's rounds)
+// the server changed outside an actor's layout (a merge in a box). Payload:
+// u8 count, count x (u64 entity, u16 amount).
+void on_amounts(const coop::proto::CampaignEvent& event)
+{
+	const std::vector<u8>& b = event.payload;
+	if (b.empty() || b.size() != 1 + size_t(b[0]) * 10)
+		return;
+	++g_link->amounts_received;
+	for (u32 k = 0; k < b[0]; ++k)
+	{
+		const u8* e = b.data() + 1 + k * 10;
+		u64 entity = 0;
+		for (int i = 0; i < 8; ++i)
+			entity |= u64(e[i]) << (8 * i);
+		const u16 amount = u16(e[8] | (e[9] << 8));
+		g_link->amounts_pending[entity] = {amount, g_link->wall.GetElapsed_ms()};
+	}
+	amounts_frame();
+}
+
+// Pending amounts and Reparents whose objects reach this level later.
+void amounts_frame()
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	for (auto it = g_link->amounts_pending.begin(); it != g_link->amounts_pending.end();)
+	{
+		const auto id = g_link->by_entity.find(it->first);
+		CWeaponAmmo* ammo = id != g_link->by_entity.end() ? smart_cast<CWeaponAmmo*>(Level().Objects.net_Find(id->second))
+														: nullptr;
+		if (ammo)
+		{
+			ammo->m_boxCurr = it->second.amount;
+			++g_link->amounts_applied;
+			g_link->log.line("amount-applied entity=%I64u id=%u amount=%u waited_ms=%u", it->first, u32(id->second),
+				u32(it->second.amount), now - it->second.since_ms);
+			it = g_link->amounts_pending.erase(it);
+		}
+		else if (now - it->second.since_ms > 10000)
+		{
+			++g_link->amounts_unknown;
+			g_link->log.line("amount-unknown entity=%I64u", it->first);
+			it = g_link->amounts_pending.erase(it);
+		}
+		else
+			++it;
+	}
+	if (g_link->graph_deferred &&
+		(g_link->reparent_retry.empty() || now - g_link->graph_deferred_ms > 5000))
+	{
+		const coop::proto::CampaignEvent point = g_link->graph_point;
+		const u32 waited = now - g_link->graph_deferred_ms;
+		g_link->graph_deferred = false;
+		g_link->log.line("item-graph-deferred waited_ms=%u pending=%u", waited, u32(g_link->reparent_retry.size()));
+		on_item_graph(point);
+	}
+	for (size_t i = 0; i < g_link->reparent_retry.size();)
+	{
+		const Link::ReparentRetry rr = g_link->reparent_retry[i];
+		const auto item = g_link->by_entity.find(rr.r.entity.id);
+		const auto parent = rr.r.parent.none() ? g_link->by_entity.end() : g_link->by_entity.find(rr.r.parent.id);
+		const bool ready = item != g_link->by_entity.end() && Level().Objects.net_Find(item->second) &&
+			(rr.r.parent.none() || (parent != g_link->by_entity.end() && Level().Objects.net_Find(parent->second)));
+		if (ready)
+		{
+			g_link->reparent_retry.erase(g_link->reparent_retry.begin() + i);
+			++g_link->reparents_retried;
+			apply_reparent(rr.r, true);
+			continue;
+		}
+		if (now - rr.since_ms > 10000)
+		{
+			++g_link->reparents_failed;
+			g_link->log.line("reparent-gave-up entity=%I64u parent_entity=%I64u", rr.r.entity.id, rr.r.parent.id);
+			g_link->reparent_retry.erase(g_link->reparent_retry.begin() + i);
+			continue;
+		}
+		++i;
+	}
+}
