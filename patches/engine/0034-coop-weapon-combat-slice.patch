+		s.entity.id, u32(s.health), u32(s.weapon_slot), u32(s.weapon_state), u32(s.ammo), u32(s.shots),
+		u32(actor->conditions().GetWhoHitLastTimeID()), VPUSH(actor->Position()));
+}
