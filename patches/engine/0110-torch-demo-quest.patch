+// S10-T07 (B48): the L key's torch switch (item_device.toggle_torch, wrapped
+// in the session chunk) asks the server; the light comes back as TorchState
+bool coop_client_torch(int torch, bool on)
+{
+	if (!g_link || !g_link->active || g_link->world != WorldLive || torch < 0 || torch >= 0xffff)
+		return false;
+	coop::proto::EntityRef ref;
+	if (!ref_of(u16(torch), ref))
+	{
+		g_link->log.line("torch-unknown torch=%d", torch);
+		return false;
+	}
+	xr_vector<u8> params;
+	params.push_back(on ? 1 : 0);
+	request_ownership(coop::proto::kActionTorch, ref, params, 0, 0xffffffff, 0xffffffff, true, "player");
+	g_link->log.line("torch-sent torch=%d on=%d", torch, on ? 1 : 0);
+	return true;
+}
