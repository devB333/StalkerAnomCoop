+// The ownership graph's invariants over every ALife object (S08-T02): each
+// parent exists and lists the child exactly once, each listed child names
+// its parent, no EntityId is held by two objects, and every online object's
+// level parent equals its server parent. Logged at recovery, at every
+// checkpoint and at the end; a failure is counted, never repaired.
+void check_ownership(LPCSTR tag)
+{
+	if (!ai().get_alife())
+		return;
+	++g_host->invariant_checks;
+	u32 objects = 0, parented = 0, missing_parent = 0, not_listed = 0, listed_twice = 0, wrong_child = 0,
+		level_mismatch = 0, duplicate_entity = 0, dangling_child = 0, two_parents = 0;
+	xr_map<u64, u16> by_entity;
+	xr_map<u16, u16> listed_by; // child -> the first parent that lists it
+	for (const auto& o : ai().alife().objects().objects())
+	{
+		const CSE_ALifeDynamicObject* e = o.second;
+		++objects;
+		EngineEntityKey key;
+		EntityId entity;
+		if (g_campaign_identity->current_key(o.first, key) &&
+			g_campaign_identity->resolve(key, entity) == Refusal::None && entity.value)
+		{
+			const auto seen = by_entity.find(entity.value);
+			if (seen != by_entity.end())
+			{
+				++duplicate_entity;
+				g_host->log.line("ownership-bad tag=%s what=duplicate-entity entity=%I64u ids=%u,%u", tag,
+					entity.value, u32(seen->second), u32(o.first));
+			}
+			else
+				by_entity[entity.value] = o.first;
+		}
+		for (u16 child : e->children)
+		{
+			// ALife holds every campaign object; the server's table only the online ones
+			const CSE_Abstract* c = ai().alife().objects().object(child, true);
+			if (!c)
+				c = Level().Server->ID_to_entity(child);
+			if (!c)
+			{
+				// an id with no entity: in the loaded save as it was (counted,
+				// not an ownership violation: nothing can be held by it)
+				++dangling_child;
+				continue;
+			}
+			const auto first = listed_by.find(child);
+			if (first != listed_by.end() && first->second != o.first)
+			{
+				++two_parents;
+				g_host->log.line("ownership-bad tag=%s what=two-parents child=%u parents=%u,%u", tag, u32(child),
+					u32(first->second), u32(o.first));
+			}
+			else
+				listed_by[child] = o.first;
+			if (c->ID_Parent != o.first)
+			{
+				++wrong_child;
+				g_host->log.line("ownership-bad tag=%s what=wrong-child parent=%u child=%u child_parent=%u", tag,
+					u32(o.first), u32(child), u32(c->ID_Parent));
+			}
+		}
+		if (e->ID_Parent == 0xffff)
+			continue;
+		++parented;
+		const CSE_Abstract* parent = ai().alife().objects().object(e->ID_Parent, true);
+		if (!parent)
+			parent = Level().Server->ID_to_entity(e->ID_Parent);
+		if (!parent)
+		{
+			++missing_parent;
+			g_host->log.line("ownership-bad tag=%s what=missing-parent id=%u parent=%u", tag, u32(o.first),
+				u32(e->ID_Parent));
+			continue;
+		}
+		const u32 listed = u32(std::count(parent->children.begin(), parent->children.end(), o.first));
+		if (listed == 0)
+			++not_listed;
+		if (listed > 1)
+			++listed_twice;
+		if (listed != 1)
+			g_host->log.line("ownership-bad tag=%s what=listed id=%u parent=%u times=%u", tag, u32(o.first),
+				u32(e->ID_Parent), listed);
+		if (e->m_bOnline)
+			if (CObject* object = Level().Objects.net_Find(o.first))
+			{
+				const u16 level_parent = object->H_Parent() ? u16(object->H_Parent()->ID()) : 0xffff;
+				// a change applied this tick reaches the level when it processes the event
+				bool in_flight = false;
+				for (const Host::PickupConfirm& c : g_host->pickup_confirm)
+					in_flight = in_flight || c.item == o.first;
+				if (level_parent != e->ID_Parent && !in_flight)
+				{
+					++level_mismatch;
+					g_host->log.line("ownership-bad tag=%s what=level-parent id=%u parent=%u level_parent=%u", tag,
+						u32(o.first), u32(e->ID_Parent), u32(level_parent));
+				}
+			}
+	}
+	const u32 bad =
+		missing_parent + not_listed + listed_twice + wrong_child + level_mismatch + duplicate_entity + two_parents;
+	if (bad)
+		++g_host->invariant_failures;
+	g_host->log.line("ownership-invariants tag=%s ok=%d objects=%u parented=%u missing_parent=%u not_listed=%u "
+		"listed_twice=%u wrong_child=%u two_parents=%u level_mismatch=%u duplicate_entity=%u dangling_child=%u", tag,
+		bad ? 0 : 1, objects, parented, missing_parent, not_listed, listed_twice, wrong_child, two_parents,
+		level_mismatch, duplicate_entity, dangling_child);
+}
