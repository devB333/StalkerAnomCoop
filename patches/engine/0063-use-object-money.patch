+// ------------------------------------------------------------ S10-T04c
+// A USE on a script-usable world object (a door, a switch; not an item, a
+// living thing or a level changer, which have their own kinds): the object's
+// use callback runs on the server in the player's context
+// (CUsableScriptObject::use enters it), so the installed logic (ph_door's
+// on_use condlist) decides, and its physics follows on every client through
+// the JointDrive presentation. Not journaled: a door's pose is world state
+// the checkpoint holds (the physics shell's state in its server object).
+const float kUseObjectReach = 3.5f; // the engine's use pick is 2 m from the eye; a door's handle may be farther
+
+u16 take_use_object(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (!intent.params.empty())
+		return coop::proto::kReasonMalformed;
+	PartyId party;
+	party.hi = g_host->config.party_id.hi;
+	party.lo = g_host->config.party_id.lo;
+	ActionContext context;
+	context.origin = Origin::ClientIntent;
+	context.session = link.session;
+	context.actor = link.ref;
+	context.party = party;
+	Refusal why = Refusal::None;
+	CActor* actor = context_actor(context, Scope::Self, &why);
+	if (!actor || !actor->g_Alive())
+		return coop::proto::kReasonNoActor;
+	const u16 id = engine_id_of(intent.target);
+	CGameObject* object = id != kNoEngineId ? smart_cast<CGameObject*>(Level().Objects.net_Find(id)) : nullptr;
+	if (!object || object->getDestroy())
+		return coop::proto::kReasonItemGone;
+	CUsableScriptObject* usable = smart_cast<CUsableScriptObject*>(object);
+	if (!usable || usable->nonscript_usable() || smart_cast<CInventoryItem*>(object) || smart_cast<CEntityAlive*>(object) ||
+		smart_cast<CLevelChanger*>(object))
+	{
+		++g_host->uses_object_refused;
+		g_host->log.line("use-object-refused slot=%u object=%u section=%s why=not-usable", u32(link.ref.slot), u32(id),
+			*object->cNameSect());
+		return coop::proto::kReasonNotUsable;
+	}
+	const float distance = pickup_distance(actor, object);
+	if (distance > kUseObjectReach)
+	{
+		++g_host->uses_object_refused;
+		g_host->log.line("use-object-refused slot=%u object=%u section=%s why=out-of-reach distance=%.2f",
+			u32(link.ref.slot), u32(id), *object->cNameSect(), distance);
+		return coop::proto::kReasonOutOfReach;
+	}
+	const bool ok = usable->use(actor);
+	++g_host->uses_object;
+	g_host->log.line("use-object slot=%u actor=%u object=%u section=%s distance=%.2f ok=%d", u32(link.ref.slot),
+		u32(actor->ID()), u32(id), *object->cNameSect(), distance, ok ? 1 : 0);
+	result.revision = g_host->commit;
+	return ok ? 0 : coop::proto::kReasonNotUsable;
+}
