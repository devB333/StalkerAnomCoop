+// ------------------------------------------------------------ S06-T04
+// The server's outcomes for an actor: health, the active slot and the rounds
+// in its magazine (applied when the server's value changes, so the shooter's
+// own local firing is corrected, not fought), and the other player's shots
+// shown from its counter (presentation only: no bullet, no ammo change).
+void apply_actor_outcomes(CActor* actor, const coop::proto::EntityState& s)
+{
+	if (s.components & coop::proto::kHealth)
+	{
+		// a death is S06-T05's: the client keeps the actor alive
+		const float health = _max(float(s.health) / 10000.f, 0.001f);
+		if (!fsimilar(actor->GetfHealth(), health, 0.0001f))
+		{
+			actor->SetfHealth(health);
+			++g_link->health_applied;
+		}
+	}
+	if (!(s.components & coop::proto::kWeapon))
+		return;
+	Link::Outcome& o = g_link->outcomes[u16(actor->ID())];
+	if (s.weapon_slot != o.slot)
+	{
+		o.slot = s.weapon_slot;
+		// the server put an item in that slot (CInventory::Slot sends no
+		// event): the same kind of item moves from the backpack here too
+		if (s.weapon_slot != NO_ACTIVE_SLOT && !actor->inventory().ItemFromSlot(s.weapon_slot))
+			for (PIItem item : actor->inventory().m_ruck)
+				if (item->BaseSlot() == s.weapon_slot && actor->inventory().CanPutInSlot(item, s.weapon_slot))
+				{
+					actor->inventory().Slot(s.weapon_slot, item, true);
+					break;
+				}
+		if (actor->inventory().GetActiveSlot() != s.weapon_slot &&
+			(s.weapon_slot == NO_ACTIVE_SLOT || actor->inventory().ItemFromSlot(s.weapon_slot)))
+		{
+			actor->inventory().Activate(s.weapon_slot);
+			++g_link->slots_applied;
+		}
+	}
+	CWeapon* weapon = smart_cast<CWeapon*>(actor->inventory().ActiveItem());
+	if (s.ammo != o.ammo)
+	{
+		o.ammo = s.ammo;
+		if (weapon && weapon->GetAmmoElapsed() != int(s.ammo))
+		{
+			weapon->SetAmmoElapsed(int(s.ammo));
+			++g_link->ammo_applied;
+		}
+	}
+	if (s.shots != o.shots)
+	{
+		const u16 fresh = o.shots == 0xffff ? 0 : u16(s.shots - o.shots);
+		o.shots = s.shots;
+		if (actor != g_actor && weapon)
+			for (u16 i = 0; i < _min<u16>(fresh, 3); ++i)
+			{
+				weapon->replica_present_shot();
+				++g_link->shots_presented;
+			}
+	}
+}
