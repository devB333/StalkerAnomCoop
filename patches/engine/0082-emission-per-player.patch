+	"    SMC.start = function(self, ...)\n"
+	"      local r = pack(orig_start(self, ...))\n"
+	"      if self.started then S.surge_serial = S.surge_serial + 1 end\n"
+	"      return unpack(r, 1, r.n)\n"
+	"    end\n"
+	// the world's methods do not run in a player's pass
+	"    local WORLD = { start = true, end_surge = true, skip_surge = true, initialize = true, new_surge_time = true,\n"
