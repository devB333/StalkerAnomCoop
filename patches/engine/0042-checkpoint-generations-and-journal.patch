+template <typename T>
+void put(std::vector<u8>& out, T value)
+{
+	const u8* p = reinterpret_cast<const u8*>(&value);
+	out.insert(out.end(), p, p + sizeof(T));
+}
+
+template <typename T>
+bool get(const std::vector<u8>& in, size_t& at, T& value)
+{
+	if (at + sizeof(T) > in.size())
+		return false;
+	memcpy(&value, in.data() + at, sizeof(T));
+	at += sizeof(T);
+	return true;
+}
+} // namespace
+
+// slot u8, player 16 B, operation u64, actor entity u64, delta s32, money after u32
+std::vector<u8> encode_ledger(const LedgerRecord& r)
+{
+	std::vector<u8> out;
+	put<u8>(out, r.slot);
+	put<u64>(out, r.player.hi);
+	put<u64>(out, r.player.lo);
+	put<u64>(out, r.operation);
+	put<u64>(out, r.actor_entity);
+	put<s32>(out, r.delta);
+	put<u32>(out, r.money_after);
+	return out;
+}
+
+bool decode_ledger(const std::vector<u8>& payload, LedgerRecord& out)
+{
+	size_t at = 0;
+	return get(payload, at, out.slot) && get(payload, at, out.player.hi) && get(payload, at, out.player.lo) &&
+		get(payload, at, out.operation) && get(payload, at, out.actor_entity) && get(payload, at, out.delta) &&
+		get(payload, at, out.money_after) && at == payload.size();
+}
+
+std::vector<u8> encode_death(const DeathRecord& r)
+{
+	std::vector<u8> out;
+	put<u8>(out, r.slot);
+	put<u64>(out, r.entity);
+	put<u64>(out, r.killer);
+	for (float f : r.position)
+		put<float>(out, f);
+	return out;
+}
+
+bool decode_death(const std::vector<u8>& payload, DeathRecord& out)
+{
+	size_t at = 0;
+	return get(payload, at, out.slot) && get(payload, at, out.entity) && get(payload, at, out.killer) &&
+		get(payload, at, out.position[0]) && get(payload, at, out.position[1]) && get(payload, at, out.position[2]) &&
+		at == payload.size();
+}
+
+std::vector<u8> encode_respawn(const RespawnRecord& r)
+{
+	std::vector<u8> out;
+	put<u8>(out, r.slot);
+	put<u64>(out, r.player.hi);
+	put<u64>(out, r.player.lo);
+	put<u64>(out, r.operation);
+	put<u64>(out, r.old_entity);
+	put<u64>(out, r.new_entity);
+	for (float f : r.position)
+		put<float>(out, f);
+	put<u32>(out, r.vertex);
+	put<u16>(out, r.graph);
+	return out;
+}
+
+bool decode_respawn(const std::vector<u8>& payload, RespawnRecord& out)
+{
+	size_t at = 0;
+	return get(payload, at, out.slot) && get(payload, at, out.player.hi) && get(payload, at, out.player.lo) &&
+		get(payload, at, out.operation) && get(payload, at, out.old_entity) && get(payload, at, out.new_entity) &&
+		get(payload, at, out.position[0]) && get(payload, at, out.position[1]) && get(payload, at, out.position[2]) &&
+		get(payload, at, out.vertex) && get(payload, at, out.graph) && at == payload.size();
+}
