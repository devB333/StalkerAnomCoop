+
+void run_script()
+{
+	if (!g_link->config.script || !g_actor)
+		return;
+	// The loading screen stays up for a while after the level is ready
+	// (precache): the script runs from when it is gone.
+	if (!g_link->script_t0)
+	{
+		if (load_screen_renderer.b_registered)
+			return;
+		g_link->script_t0 = g_link->wall.GetElapsed_ms();
+		g_link->log.line("script-start loading_screen_gone_after_live_ms=%u", g_link->script_t0 - g_link->live_ms);
+	}
+	const u32 t = g_link->wall.GetElapsed_ms() - g_link->script_t0;
+	if (Device.Paused())
+	{
+		g_link->log.line("script-unpause");
+		Device.Pause(FALSE, TRUE, TRUE, "coop-script");
+	}
+	const u32 walk_at = 7000 + u32(g_link->local_slot) * 6000;
+	switch (g_link->script_phase)
+	{
+	case 0: if (t >= 1000) { face_other_actor(false); ++g_link->script_phase; } break;
+	case 1: if (t >= 2000) { face_other_actor(true); ++g_link->script_phase; } break;
+	case 2: if (t >= 3500) { screenshot("facing"); ++g_link->script_phase; } break;
+	case 3:
+		if (t >= walk_at)
+		{
+			g_link->walk_until = g_link->wall.GetElapsed_ms() + 1500;
+			g_link->log.line("script-walk back 1500 ms");
+			++g_link->script_phase;
+		}
+		break;
+	case 4: if (t >= 21000) { face_other_actor(false); ++g_link->script_phase; } break;
+	case 5: if (t >= 22000) { face_other_actor(true); ++g_link->script_phase; } break;
+	case 6: if (t >= 23500) { screenshot("after-walks"); ++g_link->script_phase; } break;
+	default: break;
+	}
+}
+
+// The player's input: what the native control path would read this frame
+// (movement keys, stance, walk, the camera's angles), sent to the server; the
+// keys are cleared as that path would clear them.
+void sample_input()
+{
+	if (!g_actor || !g_link->client || g_link->client->state() != coop::session::ClientState::Active)
+		return;
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (now - g_link->last_input_ms < 16)
+		return;
+	g_link->last_input_ms = now;
+	CActor* actor = g_actor;
+	u32 wishful = actor->replica_wishful();
+	if (now < g_link->walk_until)
+		wishful |= mcBack; // away from the other player it faces (forward would walk into it)
+	coop::proto::Input in;
+	in.tick = ++g_link->input_tick;
+	in.move_y = (wishful & mcFwd) ? 1.f : (wishful & mcBack) ? -1.f : 0.f;
+	in.move_x = (wishful & mcRStrafe) ? 1.f : (wishful & mcLStrafe) ? -1.f : 0.f;
+	in.yaw = angle_normalize_signed(actor->cam_Active()->yaw);
+	in.pitch = clampr(actor->cam_Active()->pitch, -1.5f, 1.5f);
+	in.stance = (wishful & mcCrouch) ? coop::proto::Stance::Crouch :
+		(wishful & mcSprint) ? coop::proto::Stance::Sprint : coop::proto::Stance::Stand;
+	in.buttons = (wishful & mcAccel) ? 1u : 0u;
+	u32 cleared = mcFwd | mcBack | mcLStrafe | mcRStrafe;
+	if (!psActorFlags.test(AF_CROUCH_TOGGLE))
+		cleared |= mcCrouch;
+	if (!psActorFlags.test(AF_WALK_TOGGLE))
+		cleared |= mcAccel;
+	if (!psActorFlags.test(AF_SPRINT_TOGGLE))
+		cleared |= mcSprint;
+	actor->replica_set_wishful(actor->replica_wishful() & ~cleared);
+	g_link->inputs.push_front(in);
+	while (g_link->inputs.size() > coop::proto::kMaxInputsPerBatch)
+		g_link->inputs.pop_back();
+	coop::proto::InputBatch batch;
+	batch.inputs.assign(g_link->inputs.begin(), g_link->inputs.end());
+	if (g_link->client->send(coop::proto::Message(batch)))
+		++g_link->inputs_sent;
+}
+
+// The server's world clock (CampaignEvent kind 1): the client's ALife clock
+// follows the server's (a step only when more than 3 s of game time apart;
+// the time of day cannot visibly change in that) and its sky is the server's
+// weather.
+void on_world_clock(const coop::proto::CampaignEvent& event)
+{
+	if (event.kind != 1 || event.payload.size() < 13)
+		return;
+	u64 game_ms = 0;
+	float factor = 0;
+	memcpy(&game_ms, event.payload.data(), sizeof(game_ms));
+	memcpy(&factor, event.payload.data() + 8, sizeof(factor));
+	const u8 length = event.payload[12];
+	if (event.payload.size() != size_t(13 + length) || !_valid(factor) || factor < 0.f || factor > 1000.f)
+		return;
+	string256 weather = "";
+	memcpy(weather, event.payload.data() + 13, length);
+	weather[length] = 0;
+	++g_link->clock_events;
+	CALifeTimeManager& clock = const_cast<CALifeSimulator*>(ai().get_alife())->time_manager();
+	const s64 apart = s64(game_ms) - s64(clock.game_time());
+	if (!fsimilar(clock.time_factor(), factor) || _abs(apart) > 3000)
+	{
+		clock.set_time_factor(factor);
+		clock.set_game_time(game_ms);
+		if (++g_link->clock_steps <= 8)
+			g_link->log.line("clock-step apart_ms=%I64d factor=%.2f", apart, factor);
+	}
+	CEnvironment& environment = g_pGamePersistent->Environment();
+	if (length && xr_strcmp(*environment.CurrentWeatherName, weather))
+	{
+		g_link->log.line("weather %s -> %s", environment.CurrentWeatherName.size() ? *environment.CurrentWeatherName : "-",
+			weather);
+		environment.SetWeather(weather, true);
+		++g_link->weather_changes;
+	}
+}
