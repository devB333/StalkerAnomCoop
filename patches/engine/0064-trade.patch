+static void fixture_intent(coop::proto::ActionIntent& intent, u16 kind, u16 target_id, u64 op)
+{
+	intent.operation_id = op;
+	intent.kind = kind;
+	intent.params.clear();
+	intent.expected_revision = 0;
+	if (target_id == 0xffff || !entity_ref_of(target_id, intent.target))
+		intent.target = coop::proto::EntityRef();
