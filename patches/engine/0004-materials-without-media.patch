+// Loads materials and pairs without pair sounds or wallmarks. Pairs must keep
+// their media names, and no sound or wallmark may have been created.
+bool StartCampaignMaterials()
+{
+    GMLib.SetPresentationMedia(false);
+    GMLib.Load();
+    u32 pairs = 0, named_media = 0, created_media = 0;
+    for (GameMtlPairIt it = GMLib.FirstMaterialPair(); it != GMLib.LastMaterialPair(); ++it)
+    {
+        SGameMtlPair* pair = *it;
+        ++pairs;
+        if (!pair->CollideSoundsStr.empty() || !pair->StepSoundsStr.empty() ||
+            !pair->BreakingSoundsStr.empty() || !pair->CollideMarksStr.empty())
+            ++named_media;
+        created_media += u32(pair->CollideSounds.size() + pair->StepSounds.size() +
+            pair->BreakingSounds.size()) + (pair->m_pCollideMarks->empty() ? 0 : 1);
+    }
+    Msg("S02-T03 materials count=%u pairs=%u pairs_with_media_names=%u created_media=%u",
+        GMLib.CountMaterial(), pairs, named_media, created_media);
+    return GMLib.CountMaterial() != 0 && pairs != 0 && named_media != 0 && created_media == 0;
+}
+
+void StopCampaignMaterials()
+{
+    GMLib.Unload();
+    GMLib.SetPresentationMedia(true);
+}
+
+// A failed check after loading still owns the loaded library.
+bool StartCampaignMaterialsOrUnload()
+{
+    if (StartCampaignMaterials())
+        return true;
+    StopCampaignMaterials();
+    return false;
+}
 }
 
