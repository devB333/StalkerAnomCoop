+// ------------------------------------------------------------ S06-T05
+// The encounter program (profile script = 4; prepare-coop-session.py
+// --encounter). Both players take out the pistol, then wait for the boar the
+// server spawns. While it lives and is within 30 m each aims at it every frame
+// and presses fire every 300 ms, reloading when the magazine is empty. After
+// its own actor died (the lethal fixture kills participant 2's) a player tries
+// to walk and fire for 2 s (D-dead-walk) and sends a forged "revive" intent
+// (kind 8, refused); nothing of it may reach the world.
+CBaseMonster* encounter_monster()
+{
+	if (g_link->monster_id != 0xffff)
+		return smart_cast<CBaseMonster*>(Level().Objects.net_Find(g_link->monster_id));
+	for (const auto& entry : g_link->tracks)
+		if (CBaseMonster* m = smart_cast<CBaseMonster*>(Level().Objects.net_Find(entry.first)))
+			if (m->g_Alive() && g_actor && m->Position().distance_to(g_actor->Position()) < 40.f)
+			{
+				g_link->monster_id = u16(m->ID());
+				g_link->log.line("script4-monster id=%u section=%s distance=%.2f", u32(m->ID()), m->cNameSect().c_str(),
+					m->Position().distance_to(g_actor->Position()));
+				return m;
+			}
+	return nullptr;
+}
+
+void aim_at(const CObject* target, float height)
+{
+	if (!target || !g_actor)
+		return;
+	const Fvector eye = g_actor->Cameras().Position();
+	Fvector to = Fvector().set(target->Position()).add(Fvector().set(0.f, height, 0.f)).sub(eye);
+	if (to.magnitude() < EPS_L)
+		return;
+	to.normalize();
+	float h, p;
+	to.getHP(h, p);
+	g_actor->cam_Active()->yaw = -h;
+	g_actor->cam_Active()->pitch = -p;
+}
+
+void run_script4(u32 t)
+{
+	if (!g_link->program_t0)
+	{
+		if (!other_actor())
+		{
+			g_link->other_since = 0;
+			return;
+		}
+		if (!g_link->other_since)
+			g_link->other_since = t;
+		if (t < g_link->other_since + 3000)
+			return;
+		g_link->program_t0 = t;
+		g_link->log.line("script4-program-start slot=%u t=%u", u32(g_link->local_slot), t);
+		// away from Fanat (the companion at the base, who otherwise fights
+		// the boar for them): sprint 4 s facing away from him
+		if (CObject* fanat = Level().Objects.net_Find(19409))
+		{
+			Fvector away = Fvector().set(g_actor->Position()).sub(fanat->Position());
+			away.y = 0.f;
+			if (away.magnitude() > 0.1f)
+			{
+				away.normalize();
+				float h, pitch;
+				away.getHP(h, pitch);
+				g_actor->cam_Active()->yaw = -h;
+				g_actor->cam_Active()->pitch = 0.f;
+			}
+		}
+		leg_begin("E-move-away", mcFwd | mcSprint, coop::proto::Stance::Sprint, true, 4000, Link::SendNormal);
+		return;
+	}
+	const u32 p = t - g_link->program_t0;
+	if (g_link->script_phase == 0 && p >= 4500)
+	{
+		++g_link->script_phase;
+		xr_vector<u8> slot;
+		slot.push_back(u8(INV_SLOT_2));
+		send_action(coop::proto::kActionActivateSlot, slot, "equip-slot-2");
+	}
+	if (g_link->script_phase == 1 && p >= 6000)
+	{
+		++g_link->script_phase;
+		send_action(coop::proto::kActionReload, xr_vector<u8>(), "reload");
+	}
+	if (!g_actor)
+		return;
+	if (!g_actor->g_Alive())
+	{
+		// dead: nothing it sends may move or fire anything
+		if (!g_link->dead_since)
+		{
+			g_link->dead_since = t;
+			g_link->drive_fire = false;
+			g_link->aim_track = false;
+			g_link->log.line("script4-own-death t=%u", t);
+		}
+		// its body falls for a few seconds first (its ragdoll: up to 3 s in enc-6)
+		if (g_link->dead_phase == 0 && t >= g_link->dead_since + 5000)
+		{
+			++g_link->dead_phase;
+			combat_leg("D-dead-walk", mcFwd, 2000, Link::SendNormal, 15);
+		}
+		else if (g_link->dead_phase == 1 && t >= g_link->dead_since + 8000)
+		{
+			++g_link->dead_phase;
+			const char forged[] = "revive health=1";
+			xr_vector<u8> params;
+			params.assign(forged, forged + sizeof(forged) - 1);
+			send_action(8, params, "forged-revive");
+		}
+		else if (g_link->dead_phase == 2 && t >= g_link->dead_since + 10000)
+		{
+			++g_link->dead_phase;
+			g_link->log.line("script4-program-end dead=1");
+		}
+		return;
+	}
+	CBaseMonster* monster = encounter_monster();
+	if (!monster)
+		return;
+	if (!monster->g_Alive())
+	{
+		if (!g_link->monster_dead_logged)
+		{
+			g_link->monster_dead_logged = true;
+			g_link->drive_fire = false;
+			g_link->drive_until = 0;
+			g_link->log.line("script4-monster-dead id=%u t=%u", u32(monster->ID()), t);
+		}
+		return;
+	}
+	const float distance = monster->Position().distance_to(g_actor->Position());
+	if (distance > 30.f)
+		return;
+	aim_at(monster, 0.6f);
+	// the players hold their fire until the boar has hurt one of them (or
+	// 12 s passed), so the encounter has the NPC's damage as well as theirs
+	CActor* other = other_actor();
+	if (!g_link->monster_seen_t)
+	{
+		g_link->monster_seen_t = t;
+		g_link->seen_health[0] = g_actor->GetfHealth();
+		g_link->seen_health[1] = other ? other->GetfHealth() : 1.f;
+	}
+	if (!g_link->engaged)
+	{
+		const bool hurt = g_actor->GetfHealth() < g_link->seen_health[0] - 0.01f ||
+			(other && (!other->g_Alive() || other->GetfHealth() < g_link->seen_health[1] - 0.01f));
+		if (!hurt && t < g_link->monster_seen_t + 12000)
+			return;
+		g_link->engaged = true;
+		g_link->log.line("script4-open-fire reason=%s after_ms=%u own=%.3f other=%.3f", hurt ? "hurt" : "timeout",
+			t - g_link->monster_seen_t, g_actor->GetfHealth(), other ? other->GetfHealth() : -1.f);
+	}
+	// fire every 300 ms while it lives; an empty magazine is reloaded
+	if (!g_link->drive_fire || t >= g_link->drive_until)
+	{
+		combat_leg("E-engage", 0, 60000, Link::SendNormal, 15);
+		g_link->log.line("script4-engage id=%u distance=%.2f", u32(monster->ID()), distance);
+	}
+	const CWeapon* weapon = smart_cast<CWeapon*>(g_actor->inventory().ActiveItem());
+	if (weapon && weapon->GetAmmoElapsed() == 0 && t >= g_link->last_reload_t + 4000)
+	{
+		g_link->last_reload_t = t;
+		send_action(coop::proto::kActionReload, xr_vector<u8>(), "reload");
+	}
+}
+
+// What this client shows of the actors and the boar, 10 times a second.
+void log_encounter()
+{
+	if (g_link->config.script != 4)
+		return;
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (now - g_link->last_encounter_log_ms < 100)
+		return;
+	g_link->last_encounter_log_ms = now;
+	if (!g_link->encounter_csv)
+	{
+		string_path path;
+		FS.update_path(path, "$logs$", "coop-encounter-client.csv");
+		g_link->encounter_csv = fopen(path, "w");
+		if (!g_link->encounter_csv)
+			return;
+		fprintf(g_link->encounter_csv, "utc_ms,id,entity,kind,local,health,alive,x,y,z\n");
+	}
+	const u64 utc_ms = utc_now_ms();
+	for (const auto& entry : g_link->tracks)
+	{
+		CEntityAlive* e = smart_cast<CEntityAlive*>(Level().Objects.net_Find(entry.first));
+		const auto ref = g_link->refs.find(entry.first);
+		if (!e || ref == g_link->refs.end())
+			continue;
+		const bool actor = smart_cast<CActor*>(e) != nullptr;
+		if (!actor && entry.first != g_link->monster_id)
+			continue;
+		fprintf(g_link->encounter_csv, "%I64u,%u,%I64u,%s,%d,%u,%d,%.3f,%.3f,%.3f\n", utc_ms, u32(entry.first),
+			ref->second.id, actor ? "actor" : "monster", e == g_actor ? 1 : 0,
+			e->g_Alive() ? u32(_max(1, iFloor(e->GetfHealth() * 10000.f + 0.5f))) : 0u, e->g_Alive() ? 1 : 0,
+			VPUSH(e->Position()));
+	}
+}
