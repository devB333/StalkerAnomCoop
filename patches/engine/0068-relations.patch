+// S10-T04d: CampaignEvent 18: this client's own actor's community goodwill
+// (kind 1), faction-vs-faction relations (kind 2) and its actor's reputation
+// (kind 3), into this client's own relation registry, which the PDA's
+// relations tab and the HUD's attitude colours read (decision T01-6).
+void on_relations(const coop::proto::CampaignEvent& event)
+{
+	PayloadReader r(event.payload);
+	const u8 kind = r.get<u8>();
+	if (!r.ok || !g_actor)
+		return;
+	const u32 communities = u32(CHARACTER_COMMUNITY::GetMaxIndex()) + 1;
+	if (kind == 1)
+	{
+		const u8 n = r.get<u8>();
+		u32 applied = 0;
+		string1024 nonzero = "";
+		for (u8 i = 0; i < n && r.ok; ++i)
+		{
+			const u8 idx = r.get<u8>();
+			const s32 gw = s32(r.get<u32>());
+			if (!r.ok || idx >= communities)
+				continue;
+			RELATION_REGISTRY().SetCommunityGoodwill(idx, u16(g_actor->ID()), gw);
+			++applied;
+			if (gw && xr_strlen(nonzero) < 900)
+			{
+				string128 one;
+				xr_sprintf(one, "%s%s=%d", nonzero[0] ? "," : "", *CHARACTER_COMMUNITY::IndexToId(idx), gw);
+				xr_strcat(nonzero, one);
+			}
+		}
+		g_link->log.line("relations-applied kind=1 actor=%u n=%u applied=%u nonzero=[%s]", u32(g_actor->ID()), u32(n), applied, nonzero);
+	}
+	else if (kind == 2)
+	{
+		const u8 n = r.get<u8>();
+		u32 applied = 0;
+		for (u8 k = 0; k < n && r.ok; ++k)
+		{
+			const u8 i = r.get<u8>(), j = r.get<u8>();
+			const s32 value = s32(r.get<u32>());
+			if (!r.ok || i >= communities || j >= communities)
+				continue;
+			RELATION_REGISTRY().SetCommunityRelation(i, j, value);
+			++applied;
+			if (n <= 8)
+				g_link->log.line("relations-applied kind=2 from=%s to=%s value=%d", *CHARACTER_COMMUNITY::IndexToId(i),
+					*CHARACTER_COMMUNITY::IndexToId(j), value);
+		}
+		if (n > 8)
+			g_link->log.line("relations-applied kind=2 pairs=%u applied=%u", u32(n), applied);
+	}
+	else if (kind == 3)
+	{
+		const s32 reputation = s32(r.get<u32>());
+		CInventoryOwner* me = smart_cast<CInventoryOwner*>(g_actor);
+		if (!r.ok || !me)
+			return;
+		const s32 before = me->Reputation();
+		me->SetReputation(reputation);
+		g_link->log.line("relations-applied kind=3 reputation=%d->%d applied=%d", before, reputation,
+			me->Reputation() == reputation ? 1 : 0);
+	}
+}
