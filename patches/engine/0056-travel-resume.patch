+// ------------------------------------------------------------ S09-T03
+// The coordinated resume (docs/travel-contract.md §10): after the reload the
+// destination world is held (inputs consumed and discarded, every action
+// refused 30) until every bound player's client has sent a ready (kind 13)
+// naming the pending transition and the level its world is live on; the
+// server also requires that client's world to be live on its own side. A
+// ready for another id or level is refused (31); one from a client whose
+// world is not live yet is refused (32) and re-sent by the client. The hold
+// ends when all are ready, or at its deadline (kTravelResumeMs, 60 s): the
+// present players resume and an absent one rejoins later as a detached
+// player would (decision T03-2).
+
+void travel_resume(LPCSTR why)
+{
+	Host::Travel& tv = g_host->travel;
+	const u64 now = g_host->wall.GetElapsed_ms();
+	g_host->log.line("travel-resumed id=%I64x level=%s why=%s after_ms=%I64u ready=%d/%d inputs_ignored=%I64u", tv.hold_id,
+		tv.hold_level.c_str(), why, now - tv.hold_since_ms, tv.ready[0] ? 1 : 0, tv.ready[1] ? 1 : 0,
+		tv.inputs_ignored);
+	travel_csv("resumed", 0, 0, tv.hold_id, 0, tv.hold_level.c_str(), why);
+	coop::proto::Transition t = tv.coordinator->last_ended();
+	t.id = tv.hold_id;
+	t.state = coop::proto::TravelState(9); // resumed
+	t.abort = coop::proto::TravelAbort(!xr_strcmp(why, "timeout") ? 9 : 0);
+	tv.level = tv.hold_level;
+	travel_event(t, 0);
+	tv.hold_id = 0;
+	tv.hold_level.clear();
+}
+
+u16 take_travel_ready(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	Host::Travel& tv = g_host->travel;
+	u16 reason = 0;
+	if (travel_known(link, intent, result, reason))
+		return reason;
+	++tv.readies;
+	if (!link.session)
+		return coop::proto::kReasonNoActor;
+	if (intent.params.size() < 9 || intent.params.size() != size_t(9 + intent.params[8]) || intent.params[8] > 64)
+		return coop::proto::kReasonMalformed;
+	u64 id = 0;
+	for (int b = 0; b < 8; ++b)
+		id |= u64(intent.params[b]) << (8 * b);
+	string128 level;
+	memcpy(level, intent.params.data() + 9, intent.params[8]);
+	level[intent.params[8]] = 0;
+	if (!tv.hold_id || id != tv.hold_id || xr_strcmp(level, tv.hold_level.c_str()))
+	{
+		++tv.readies_refused;
+		g_host->log.line("travel-ready-wrong slot=%u id=%I64x level=%s hold=%I64x hold_level=%s", u32(link.ref.slot), id,
+			level, tv.hold_id, tv.hold_level.c_str());
+		return coop::proto::kReasonWrongDestination;
+	}
+	if (link.world != WorldLive)
+	{
+		++tv.readies_refused;
+		g_host->log.line("travel-ready-not-loaded slot=%u world=%u", u32(link.ref.slot), u32(link.world));
+		return coop::proto::kReasonNotLoaded;
+	}
+	if (link.ref.slot < 2)
+		tv.ready[link.ref.slot] = true;
+	g_host->log.line("travel-ready slot=%u id=%I64x level=%s after_ms=%I64u operation=%I64x", u32(link.ref.slot), id, level,
+		g_host->wall.GetElapsed_ms() - tv.hold_since_ms, intent.operation_id);
+	travel_csv("ready", link.ref.slot, intent.operation_id, id, 0, level, "");
+	travel_remember(link, intent.operation_id, 0, id);
+	result.commit_id = 0;
+	result.revision = id;
+	return 0;
+}
+
+void travel_hold_tick()
+{
+	Host::Travel& tv = g_host->travel;
+	if (!tv.hold_id)
+		return;
+	bool all = true;
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot < 2 && !tv.ready[l.ref.slot])
+			all = false;
+	if (all)
+	{
+		travel_resume("all-ready");
+		return;
+	}
+	if (g_host->wall.GetElapsed_ms() >= tv.hold_deadline_ms)
+	{
+		++tv.resumes_timeout;
+		travel_resume("timeout");
+	}
+}
