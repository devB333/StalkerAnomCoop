+LPCSTR const needs_source =
+	"local P = rawget(_G, '__campaign_needs')\n"
+	"if type(P) == 'table' and P.installed then return end\n"
+	"P = { installed = true, slots = {}, current = 0 }\n"
+	"rawset(_G, '__campaign_needs', P)\n"
+	"local defaults = {\n"
+	"  actor_status_thirst = function() return { last_drink = 0 } end,\n"
+	"  actor_status_sleep = function() return { last_sleep = 0 } end,\n"
+	"  arszi_psy = function() return { psy_table = { actor_psy_health = 1 } } end,\n"
+	"}\n"
+	"function P.module_table(slot, module)\n"
+	"  P.slots[slot] = P.slots[slot] or {}\n"
+	"  local s = P.slots[slot]\n"
+	"  if not s[module] then s[module] = defaults[module] and defaults[module]() or {} end\n"
+	"  return s[module]\n"
+	"end\n"
+	"local transient = { pwr_chk = true, arszi_previous_time = true, arszi_wait_seconds_ingame = true }\n"
