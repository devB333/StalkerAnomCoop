+
+// --- the switch rule ---------------------------------------------------------
+
+float nearest_anchor(const xr_vector<Fvector>& anchors, const Fvector& p)
+{
+	float best = flt_max;
+	for (u32 i = 0; i < anchors.size(); ++i)
+		best = _min(best, anchors[i].distance_to(p));
+	return best;
+}
+
+// The distance the switch rule measures for an object from one set of points:
+// a squad's nearest member (CSE_ALifeOnlineOfflineGroup::try_switch_*), any
+// other object's own position (CSE_ALifeDynamicObject::try_switch_*). False
+// for what the fixture does not model: parented objects, the old monster
+// groups (CSE_ALifeGroupAbstract), squads without members (never switched).
+bool rule_distance(CSE_ALifeDynamicObject* o, const xr_vector<Fvector>& points, float& d)
+{
+	if (o->ID_Parent != no_id || smart_cast<CSE_ALifeGroupAbstract*>(o))
+		return false;
+	if (CSE_ALifeOnlineOfflineGroup* group = smart_cast<CSE_ALifeOnlineOfflineGroup*>(o))
+	{
+		if (group->squad_members().empty())
+			return false;
+		d = flt_max;
+		for (const auto& member : group->squad_members())
+			d = _min(d, nearest_anchor(points, member.second->o_Position));
+		return true;
+	}
+	d = nearest_anchor(points, o->o_Position);
+	return true;
+}
+
+float distance_to(CSE_ALifeDynamicObject* o, const Fvector& point)
+{
+	xr_vector<Fvector> one;
+	one.push_back(point);
+	float d = flt_max;
+	if (!rule_distance(o, one, d))
+		return flt_max;
+	return d;
+}
+
+// Every modelled object on the level against the engine's rule with the
+// switch manager's current anchors: an offline object that may switch online
+// and is within the online distance (or may never go offline) is a
+// violation; so is an online object that may go offline and is beyond the
+// offline distance (or may never be online). Squads: a member within the
+// online distance brings the squad online; all members beyond the offline
+// distance take it offline; the nearest member decides both.
+u32 rule_check(LPCSTR label)
+{
+	Fixture& f = g_fixture;
+	CALifeSimulator& alife = sim();
+	const xr_vector<Fvector>& anchors = alife.activation_anchors();
+	const float on = alife.online_distance();
+	const float off = alife.offline_distance();
+	u32 modelled = 0, unmodelled = 0, online = 0, violations = 0;
+	for (const auto& entry : alife.graph().level().objects())
+	{
+		CSE_ALifeDynamicObject* o = entry.second;
+		float d = flt_max;
+		if (!rule_distance(o, anchors, d))
+		{
+			++unmodelled;
+			continue;
+		}
+		++modelled;
+		const bool can_on = o->can_switch_online();
+		const bool can_off = o->can_switch_offline();
+		bool violation = false;
+		if (o->m_bOnline)
+		{
+			++online;
+			violation = can_off && (!can_on || d > off + boundary_tolerance);
+		}
+		else
+			violation = can_on && (!can_off || d <= on - boundary_tolerance);
+		if (!violation)
+			continue;
+		++violations;
+		Msg("! S03-T04 %s rule: %s [%u] online=%d can_on=%d can_off=%d distance=%.1f", label, o->name_replace(),
+			u32(o->ID), o->m_bOnline ? 1 : 0, can_on ? 1 : 0, can_off ? 1 : 0, d);
+		if (f.out)
+			fprintf(f.out, "violation,%u,%u,%s,%d,%d,%d,%.2f\n", f.phase, u32(o->ID), o->name_replace(),
+				o->m_bOnline ? 1 : 0, can_on ? 1 : 0, can_off ? 1 : 0, d);
+	}
+	Msg("S03-T04 %s rule: modelled=%u unmodelled=%u online=%u violations=%u anchors=%u on=%.1f off=%.1f", label,
+		modelled, unmodelled, online, violations, u32(anchors.size()), on, off);
+	if (f.out)
+		fprintf(f.out, "rule,%u,%u,%u,%u,%u\n", f.phase, modelled, unmodelled, online, violations);
+	string128 what;
+	xr_sprintf(what, "%s: every modelled object satisfies the switch rule", label);
+	check(modelled != 0 && violations == 0, what);
+	return violations;
+}
+
+// The anchors are the two alive actors' server entities, and those follow the actors.
+void anchor_check(LPCSTR label)
+{
+	Fixture& f = g_fixture;
+	CALifeSimulator& alife = sim();
+	const xr_vector<Fvector>& anchors = alife.activation_anchors();
+	CActor* a1 = actor_by_id(f.actor1_id);
+	CActor* a2 = actor_by_id(f.actor2_id);
+	string128 what;
+	xr_sprintf(what, "%s: the activation set is the participant actors", label);
+	check(alife.activation_from_participants() && anchors.size() == 2, what);
+	xr_sprintf(what, "%s: an anchor follows each actor", label);
+	check(a1 && a2 && nearest_anchor(anchors, a1->Position()) <= follow_tolerance &&
+			nearest_anchor(anchors, a2->Position()) <= follow_tolerance,
+		what);
+	if (a1 && a2)
+		Msg("S03-T04 %s anchors=%u from_participants=%d a1=[%.1f,%.1f,%.1f] a2=[%.1f,%.1f,%.1f] gap1=%.2f gap2=%.2f",
+			label, u32(anchors.size()), alife.activation_from_participants() ? 1 : 0, VPUSH(a1->Position()),
+			VPUSH(a2->Position()), nearest_anchor(anchors, a1->Position()), nearest_anchor(anchors, a2->Position()));
+}
+
+// --- per-tick observation ----------------------------------------------------
+
+void scan(u32& switched_on, u32& switched_off)
+{
+	Fixture& f = g_fixture;
+	CALifeSimulator& alife = sim();
+	const Fvector p1 = entity_position(f.actor1_id);
+	const Fvector p2 = entity_position(f.actor2_id);
+	u32 online = 0;
+	switched_on = switched_off = 0;
+	for (const auto& entry : alife.graph().level().objects())
+	{
+		CSE_ALifeDynamicObject* o = entry.second;
+		if (o->m_bOnline)
+			++online;
+		auto previous = f.online.find(entry.first);
+		if (previous != f.online.end() && previous->second != o->m_bOnline)
+		{
+			if (o->m_bOnline)
+				++switched_on;
+			else
+				++switched_off;
+			if (f.out)
+				fprintf(f.out, "switch,%u,%u,%u,%s,%s,%.1f,%.1f\n", f.ticks, f.phase, u32(o->ID), o->name_replace(),
+					o->m_bOnline ? "online" : "offline", distance_to(o, p1), distance_to(o, p2));
+		}
+		f.online[entry.first] = o->m_bOnline;
+	}
+	f.online_now = online;
+	if (switched_on || switched_off)
+		f.last_switch_tick = f.ticks;
+}
+
+// True once the level has not switched anything for quiet_ticks, or at the cap.
+bool settled(u32 cap, LPCSTR label)
+{
+	Fixture& f = g_fixture;
+	if (ticks_in_step() < quiet_ticks)
+		return false;
+	if (f.ticks - f.last_switch_tick >= quiet_ticks)
+	{
+		Msg("S03-T04 %s settled after %u ticks, online=%u", label, ticks_in_step(), f.online_now);
+		return true;
+	}
+	if (ticks_in_step() < cap)
+		return false;
+	Msg("S03-T04 %s did not settle in %u ticks (last switch at tick %u), online=%u", label, cap, f.last_switch_tick,
+		f.online_now);
+	return true;
+}
+
+void window_begin()
+{
+	Fixture& f = g_fixture;
+	f.window = Window();
+	f.window.timing0 = g_level_frame_timing;
+	f.measuring = true;
+}
+
+Window window_end(LPCSTR name)
+{
+	Fixture& f = g_fixture;
+	f.measuring = false;
+	Window w = f.window;
+	const SLevelFrameTiming& t = g_level_frame_timing;
+	w.timing.game_events = t.game_events - w.timing0.game_events;
+	w.timing.objects_update = t.objects_update - w.timing0.objects_update;
+	w.timing.script_process = t.script_process - w.timing0.script_process;
+	const double to_ms = 1000.0 / double(CPU::qpc_freq);
+	const double n = w.ticks ? double(w.ticks) : 1.0;
+	const double engine_us = double(w.engine_cycles) * 1000000.0 / double(CPU::qpc_freq) / n;
+	Msg("S03-T04 window %s: ticks=%u engine_us/tick=%.1f online_mean=%.1f object_updates=%I64u scheduler_updates=%I64u "
+		"objects_update_ms/tick=%.3f game_events_ms/tick=%.3f script_ms/tick=%.3f",
+		name, w.ticks, engine_us, double(w.online) / n, w.object_updates, w.scheduler_updates,
+		double(w.timing.objects_update) * to_ms / n, double(w.timing.game_events) * to_ms / n,
+		double(w.timing.script_process) * to_ms / n);
+	if (f.out)
+		fprintf(f.out, "window,%s,%u,%.1f,%.1f,%I64u,%I64u,%.4f,%.4f,%.4f\n", name, w.ticks, engine_us,
+			double(w.online) / n, w.object_updates, w.scheduler_updates, double(w.timing.objects_update) * to_ms / n,
+			double(w.timing.game_events) * to_ms / n, double(w.timing.script_process) * to_ms / n);
+	return w;
+}
+
+// The rule's own cost over the level registry: the engine's expression (the
+// ALife actor's distance) against activation_distance, and the per-update
+// refresh of the anchors.
+void benchmark()
+{
+	Fixture& f = g_fixture;
+	CALifeSimulator& alife = sim();
+	xr_vector<Fvector> points;
+	for (const auto& entry : alife.graph().level().objects())
+		points.push_back(entry.second->o_Position);
+	const Fvector actor = alife.graph().actor()->o_Position;
+	volatile float sink = 0.f;
+	const u64 t0 = CPU::QPC();
+	for (u32 r = 0; r < bench_reps; ++r)
+		for (u32 i = 0; i < points.size(); ++i)
+			sink = sink + actor.distance_to(points[i]);
+	const u64 t1 = CPU::QPC();
+	for (u32 r = 0; r < bench_reps; ++r)
+		for (u32 i = 0; i < points.size(); ++i)
+			sink = sink + alife.activation_distance(points[i]);
+	const u64 t2 = CPU::QPC();
+	for (u32 r = 0; r < bench_reps; ++r)
+		alife.refresh_activation_anchors();
+	const u64 t3 = CPU::QPC();
+	const double ns = 1000000000.0 / double(CPU::qpc_freq);
+	const double per = double(bench_reps) * double(points.size() ? points.size() : 1);
+	const double actor_ns = double(t1 - t0) * ns / per;
+	const double activation_ns = double(t2 - t1) * ns / per;
+	const double refresh_ns = double(t3 - t2) * ns / double(bench_reps);
+	Msg("S03-T04 bench objects=%u reps=%u alife_actor_ns=%.2f activation_ns=%.2f refresh_ns=%.0f (sink %.0f)",
+		u32(points.size()), bench_reps, actor_ns, activation_ns, refresh_ns, float(sink));
+	if (f.out)
+		fprintf(f.out, "bench,%u,%u,%.3f,%.3f,%.1f\n", u32(points.size()), bench_reps, actor_ns, activation_ns,
+			refresh_ns);
+}
+
+// --- movement and spawning -----------------------------------------------------
+
+// As CScriptGameObject::SetActorPosition with collision correction skipped.
+void teleport(CActor* actor, const Fvector& position)
+{
+	Fmatrix F = actor->XFORM();
+	F.c = position;
+	actor->XFORM().set(F);
+	if (actor->character_physics_support()->movement()->CharacterExist())
+	{
+		actor->character_physics_support()->movement()->SetPosition(F.c);
+		actor->character_physics_support()->movement()->SetVelocity(0.f, 0.f, 0.f);
+	}
+}
+
+// Breadth-first over the level graph from `start`: the accessible vertex
+// farthest (straight line) from it, so reachable by construction.
+bool farthest_vertex(u32 start, u32& best, Fvector& position, float& distance)
+{
+	const CLevelGraph& graph = ai().level_graph();
+	if (!graph.valid_vertex_id(start))
+		return false;
+	const u32 count = graph.header().vertex_count();
+	const Fvector origin = graph.vertex_position(start);
+	xr_vector<u8> seen(count, 0);
+	xr_vector<u32> queue;
+	queue.reserve(count / 4);
+	queue.push_back(start);
+	seen[start] = 1;
+	best = start;
+	position = origin;
+	distance = 0.f;
+	for (u32 head = 0; head < queue.size(); ++head)
+	{
+		const u32 vertex = queue[head];
+		CLevelGraph::const_iterator i, e;
+		graph.begin(vertex, i, e);
+		for (; i != e; ++i)
+		{
+			const u32 next = graph.value(vertex, i);
+			if (!graph.valid_vertex_id(next) || seen[next])
+				continue;
+			seen[next] = 1;
+			if (!graph.is_accessible(next))
+				continue;
+			const Fvector p = graph.vertex_position(next);
+			const float d = p.distance_to(origin);
+			if (d > distance)
+			{
+				distance = d;
+				best = next;
+				position = p;
+			}
+			queue.push_back(next);
+		}
+	}
+	Msg("S03-T04 farthest vertex from %u: %u at %.1f m (%u vertices reached of %u)", start, best, distance,
+		u32(queue.size()), count);
+	return distance > 0.f;
+}
+
+// An accessible level vertex in front of the actor's camera (the actor's
+// vision looks along it, CActorMemory::camera): the nearest of 4..12 m and
+// 0, +-15, +-30 degrees off the camera direction, `distance` m preferred;
+// else one of the four sides at `distance`.
+bool vertex_at(const Fvector& target, u32& vertex, Fvector& position)
+{
+	const CLevelGraph& graph = ai().level_graph();
+	if (!graph.valid_vertex_position(target))
+		return false;
+	const u32 at = graph.vertex_id(target);
+	if (!graph.valid_vertex_id(at) || !graph.is_accessible(at))
+		return false;
+	vertex = at;
+	position = graph.vertex_position(at);
+	return true;
+}
+
+bool vertex_near(CActor* actor, float distance, u32& vertex, Fvector& position)
+{
+	Fvector cam_p, forward, cam_n;
+	actor->cam_Active()->Get(cam_p, forward, cam_n);
+	forward.y = 0.f;
+	if (forward.square_magnitude() < EPS_S)
+		forward.set(1.f, 0.f, 0.f);
+	forward.normalize();
+	const float distances[] = {distance, distance - 2.f, distance + 2.f, 4.f, 10.f, 12.f};
+	const float angles[] = {0.f, 15.f, -15.f, 30.f, -30.f};
+	for (float d : distances)
+		for (float a : angles)
+		{
+			Fvector dir;
+			const float r = deg2rad(a);
+			dir.set(forward.x * _cos(r) - forward.z * _sin(r), 0.f, forward.x * _sin(r) + forward.z * _cos(r));
+			Fvector target;
+			target.mad(actor->Position(), dir, d);
+			if (vertex_at(target, vertex, position))
+			{
+				Msg("S03-T04 vertex in front of actor %u: %.0f m at %.0f degrees", u32(actor->ID()), d, a);
+				return true;
+			}
+		}
+	Fvector side = forward;
+	for (u32 attempt = 0; attempt < 4; ++attempt)
+	{
+		Fvector target;
+		target.mad(actor->Position(), side, distance);
+		if (vertex_at(target, vertex, position))
+		{
+			Msg("S03-T04 no vertex in front of actor %u; side %u", u32(actor->ID()), attempt);
+			return true;
+		}
+		side.set(-side.z, 0.f, side.x);
+	}
+	return false;
+}
+
+u16 spawn_monster(CActor* actor, LPCSTR label)
+{
+	Fixture& f = g_fixture;
+	u32 vertex = u32(-1);
+	Fvector position;
+	if (!vertex_near(actor, monster_distance, vertex, position))
+	{
+		string128 what;
+		xr_sprintf(what, "an accessible vertex %.0f m from %s", monster_distance, label);
+		check(false, what);
+		return no_id;
+	}
+	const GameGraph::_GRAPH_ID game_vertex = ai().cross_table().vertex(vertex).game_vertex_id();
+	CSE_Abstract* entity = sim().spawn_item(f.monster_section, position, vertex, game_vertex, no_id);
+	if (!entity)
+	{
+		check(false, "the monster section spawned");
+		return no_id;
+	}
+	// Face the actor to the monster, as CScriptGameObject::SetActorDirection
+	// does (the first-person camera's heading is -yaw): the actor's vision
+	// looks along its camera, and "the player watches me" needs it.
+	Fvector to;
+	to.sub(position, actor->Position());
+	actor->cam_Active()->Set(-to.getH(), 0.f, 0.f);
+	Msg("S03-T04 awareness: spawned %s id=%u beside %s at [%.1f,%.1f,%.1f] (%.1f m) vertex %u game vertex %u",
+		f.monster_section, u32(entity->ID), label, VPUSH(position), actor->Position().distance_to(position), vertex,
+		u32(game_vertex));
+	return entity->ID;
+}
+
+// Why a monster has or has not taken an actor as its enemy: the gates of
+// CEnemyManager::useful in order (alive, visible for AI, relation, a valid
+// level vertex; the scripted enemy callback is what remains when all pass
+// and useful is still false), the monster's visual memory of the actor,
+// its enemy list, its chosen enemy, the precache frame the installed
+// xr_combat_ignore.is_enemy refuses on, and the AI ignore-actor flag.
+void awareness_report(CBaseMonster* m, CActor* a, LPCSTR label)
+{
+	Fixture& f = g_fixture;
+	if (!m || !a)
+		return;
+	const float distance = m->Position().distance_to(a->Position());
+	if (!m->g_Alive())
+	{
+		Msg("S03-T04 aware %s: monster %u is dead (d=%.1f to actor %u)", label, u32(m->ID()), distance, u32(a->ID()));
+		if (f.out)
+			fprintf(f.out, "aware,%s,%u,%u,%u,%.2f,dead\n", label, f.ticks, u32(m->ID()), u32(a->ID()), distance);
+		return;
+	}
+	const bool alive = !!a->g_Alive();
+	const bool visible_for_ai = (a->spatial.type & STYPE_VISIBLEFORAI) == STYPE_VISIBLEFORAI;
+	const bool relation = m->is_relation_enemy(a);
+	const int relation_type = int(m->tfGetRelationType(a));
+	const u32 vertex = a->ai_location().level_vertex_id();
+	const bool vertex_ok = ai().level_graph().valid_vertex_id(vertex);
+	const bool useful = m->memory().enemy().is_useful(a);
+	const CVisualMemoryManager& visual = m->memory().visual();
+	// The stages of the monster's vision, in order: the frustum query and ray
+	// traces (Feel::Vision, CCustomMonster::eye_pp_s1/s2), the raw objects the
+	// visual memory takes from them, the not-yet-visible value that must reach
+	// the visibility threshold (luminocity and distance scale it), the seen list.
+	int traced = 0;
+	float fuzzy = -2.f;
+	for (u32 i = 0; i < m->feel_visible.size(); ++i)
+		if (m->feel_visible[i].O == a)
+		{
+			traced = 1;
+			fuzzy = m->feel_visible[i].fuzzy;
+		}
+	int raw = 0;
+	for (u32 i = 0; i < visual.raw_objects().size(); ++i)
+		if (visual.raw_objects()[i] == a)
+			raw = 1;
+	float value = -1.f;
+	for (u32 i = 0; i < visual.not_yet_visible_objects().size(); ++i)
+		if (visual.not_yet_visible_objects()[i].m_object == a)
+			value = visual.not_yet_visible_objects()[i].m_value;
+	bool in_visual = false;
+	for (const auto& v : visual.objects())
+		if (v.m_object == a)
+			in_visual = true;
+	const bool seen_now = visual.visible_now(a);
+	bool in_enemies = false;
+	const auto& enemies = m->memory().enemy().objects();
+	for (u32 i = 0; i < enemies.size(); ++i)
+		if (enemies[i] == a)
+			in_enemies = true;
+	const CEntityAlive* enemy = m->EnemyMan.get_enemy();
+	const float luminocity = a->ROS() ? a->ROS()->get_luminocity() : -1.f;
+	int ignore_actor = -1;
+#ifndef MASTER_GOLD
+	ignore_actor = psAI_Flags.test(aiIgnoreActor) ? 1 : 0;
+#endif
+	const CVisualMemoryManager& actor_visual = a->memory().visual();
+	Fvector cam_p, cam_d, cam_n;
+	a->cam_Active()->Get(cam_p, cam_d, cam_n);
+	Msg("S03-T04 aware %s: actor %u vision: seen_now=%d visual=%u raw=%u nyv=%u camera=[%.1f,%.1f,%.1f] dir=[%.2f,%.2f,%.2f] "
+		"(%.1f m from the actor)",
+		label, u32(a->ID()), actor_visual.visible_now(m) ? 1 : 0, u32(actor_visual.objects().size()),
+		u32(actor_visual.raw_objects().size()), u32(actor_visual.not_yet_visible_objects().size()), VPUSH(cam_p),
+		VPUSH(cam_d), cam_p.distance_to(a->Position()));
+	// The monster's view frustum: CCustomMonster::update_range_fov scales the
+	// range by the environment's far plane and fog density.
+	{
+		Fvector to;
+		to.sub(a->Position(), m->Position());
+		to.normalize_safe();
+		const Fvector facing = m->Direction();
+		const float angle = rad2deg(acosf(_max(-1.f, _min(1.f, facing.dotproduct(to)))));
+		const CEnvDescriptor* env = g_pGamePersistent->Environment().CurrentEnv;
+		Msg("S03-T04 aware %s: frustum fov=%.1f range=%.1f angle_to_actor=%.1f far_plane=%.1f fog_density=%.4f", label,
+			m->ffGetFov(), m->ffGetRange(), angle, env ? env->far_plane : -1.f, env ? env->fog_density : -1.f);
+	}
+	// CBaseMonster::feel_vision_isRelevant's own gates for this actor.
+	Msg("S03-T04 aware %s: relevance monster_team=%d actor_team=%d sleep=%d is_enemy=%d relevant=%d spatial_node=%d "
+		"spatial_r=%.2f",
+		label, m->g_Team(), a->g_Team(), m->m_bSleep ? 1 : 0, m->EnemyMan.is_enemy(a) ? 1 : 0,
+		m->feel_vision_isRelevant(a) ? 1 : 0, a->spatial.node_ptr ? 1 : 0, a->spatial.sphere.R);
+	Msg("S03-T04 aware %s: monster %u actor %u d=%.1f feel=%.1f alive=%d visible_for_ai=%d relation_enemy=%d (%d) "
+		"vertex_ok=%d useful=%d vision=%d traced=%u/%d fuzzy=%.2f raw=%u/%d value=%.3f threshold=%.3f "
+		"always_visible=%.1f luminocity=%.3f nyv=%u visual=%u in_visual=%d seen_now=%d enemies=%u in_enemies=%d "
+		"enemy=%u precache=%u ignore_actor=%d",
+		label, u32(m->ID()), u32(a->ID()), distance, m->get_feel_enemy_max_distance(), alive, visible_for_ai, relation,
+		relation_type, vertex_ok, useful, visual.enabled() ? 1 : 0, u32(m->feel_visible.size()), traced, fuzzy,
+		u32(visual.raw_objects().size()), raw, value, visual.current_state().m_visibility_threshold,
+		visual.current_state().m_always_visible_distance, luminocity, u32(visual.not_yet_visible_objects().size()),
+		u32(visual.objects().size()), in_visual, seen_now, u32(enemies.size()), in_enemies,
+		enemy ? u32(enemy->ID()) : u32(no_id), Device.dwPrecacheFrame, ignore_actor);
+	if (f.out)
+		fprintf(f.out, "aware,%s,%u,%u,%u,%.2f,%.2f,%d,%d,%d,%d,%d,%u,%d,%d,%u,%d,%.3f,%u,%d,%.4f,%.4f,%.2f,%.4f,%u,%u,%d,%d,%u,%d,%u,%u,%d\n",
+			label, f.ticks, u32(m->ID()), u32(a->ID()), distance, m->get_feel_enemy_max_distance(), alive, visible_for_ai,
+			relation, relation_type, vertex_ok, vertex, useful, visual.enabled() ? 1 : 0, u32(m->feel_visible.size()),
+			traced, fuzzy, u32(visual.raw_objects().size()), raw, value, visual.current_state().m_visibility_threshold,
+			visual.current_state().m_always_visible_distance, luminocity, u32(visual.not_yet_visible_objects().size()),
+			u32(visual.objects().size()), in_visual ? 1 : 0, seen_now ? 1 : 0, u32(enemies.size()), in_enemies ? 1 : 0,
+			enemy ? u32(enemy->ID()) : u32(no_id), Device.dwPrecacheFrame, ignore_actor);
+}
+
+void release_entity(u16 id)
+{
+	CSE_Abstract* entity = id != no_id && Level().Server ? Level().Server->ID_to_entity(id) : nullptr;
+	if (entity)
+		CALifeSimulator__release(&sim(), entity, true);
+}
+
+// --- phases ------------------------------------------------------------------
+
+// 1 baseline: settle, the rule, the anchors, the measurement window.
+void phase_baseline(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	if (f.step == 0)
+	{
+		if (!settled(settle_cap_baseline, "baseline"))
+			return;
+		anchor_check("baseline");
+		rule_check("baseline");
+		f.baseline_online = f.online;
+		benchmark();
+		window_begin();
+		next_step();
+		return;
+	}
+	if (ticks_in_step() < measure_ticks)
+		return;
+	f.baseline = window_end("baseline");
+
+	// The separation target.
+	CALifeSimulator& alife = sim();
+	u32 vertex = u32(-1);
+	Fvector target;
+	float distance = 0.f;
+	if (!check(farthest_vertex(a1->ai_location().level_vertex_id(), vertex, target, distance),
+			"a far accessible vertex from actor 1"))
+	{
+		finish(false);
+		return;
+	}
+	float wanted = option_float("-s03-switch-distance ", 0.f);
+	const float on = alife.online_distance();
+	const float off = alife.offline_distance();
+	const float factor = (off - on) / (off + on);
+	if (wanted <= 0.f && distance < off + separation_margin)
+		wanted = (distance * 0.5f) / (1.f + factor); // offline distance = half the separation
+	if (wanted > 0.f)
+	{
+		f.switch_distance_was = alife.switch_distance();
+		f.switch_changed = true;
+		alife.set_switch_distance(wanted);
+		Msg("S03-T04 separation %.1f m: switch distance %.1f -> %.1f for the fixture", distance, f.switch_distance_was,
+			wanted);
+	}
+	check(distance > alife.offline_distance(), "the separation exceeds the offline distance");
+	if (f.out)
+		fprintf(f.out, "separation,%.2f,%u,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f\n", distance, vertex, VPUSH(target),
+			alife.switch_distance(), alife.online_distance(), alife.offline_distance());
+	f.home2 = a2->Position();
+	f.target2 = target;
+	teleport(a2, target);
+	Msg("S03-T04 separate: actor 2 from [%.1f,%.1f,%.1f] to [%.1f,%.1f,%.1f], %.1f m from actor 1", VPUSH(f.home2),
+		VPUSH(target), a1->Position().distance_to(target));
+	begin_phase(2);
+}
+
+// Waits for actor 2's anchor to follow a teleport. False while waiting.
+bool followed(CActor* a2, const Fvector& to, LPCSTR label)
+{
+	Fixture& f = g_fixture;
+	const xr_vector<Fvector>& anchors = sim().activation_anchors();
+	const bool there = a2->Position().distance_to(to) <= 5.f && nearest_anchor(anchors, a2->Position()) <= follow_tolerance &&
+		entity_position(f.actor2_id).distance_to(a2->Position()) <= follow_tolerance;
+	if (!there && ticks_in_step() < follow_budget_ticks)
+		return false;
+	string128 what;
+	xr_sprintf(what, "%s: actor 2 stayed where it was put and its anchor followed", label);
+	check(there, what);
+	Msg("S03-T04 %s: actor 2 at [%.1f,%.1f,%.1f] (%.2f m from target), entity gap %.2f, after %u ticks", label,
+		VPUSH(a2->Position()), a2->Position().distance_to(to), entity_position(f.actor2_id).distance_to(a2->Position()),
+		ticks_in_step());
+	return true;
+}
+
+// 2 separate: the union keeps both areas online.
+void phase_separate(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	CALifeSimulator& alife = sim();
+	if (f.step == 0)
+	{
+		if (followed(a2, f.target2, "separate"))
+			next_step();
+		return;
+	}
+	if (f.step == 1)
+	{
+		if (!settled(settle_cap_move, "separate"))
+			return;
+		anchor_check("separate");
+		rule_check("separate");
+		const float on = alife.online_distance();
+		const float off = alife.offline_distance();
+		const Fvector p1 = entity_position(f.actor1_id);
+		const Fvector p2 = entity_position(f.actor2_id);
+		u32 far_total = 0, far_online = 0, near1_was = 0, near1_dropped = 0;
+		f.far_ids.clear();
+		for (const auto& entry : alife.graph().level().objects())
+		{
+			CSE_ALifeDynamicObject* o = entry.second;
+			const float d1 = distance_to(o, p1);
+			const float d2 = distance_to(o, p2);
+			if (d1 == flt_max)
+				continue; // not modelled
+			// Near actor 2 and outside actor 1's reach, and free to switch either way.
+			if (d2 <= on - boundary_tolerance && d1 > off + boundary_tolerance && o->can_switch_online() &&
+				o->can_switch_offline())
+			{
+				++far_total;
+				if (o->m_bOnline)
+				{
+					++far_online;
+					auto was = f.baseline_online.find(entry.first);
+					if (was != f.baseline_online.end() && !was->second)
+						f.far_ids.push_back(entry.first);
+				}
+				else
+					Msg("! S03-T04 separate: %s [%u] %.1f m from actor 2 is offline", o->name_replace(), u32(o->ID), d2);
+			}
+			// Online at the baseline and still within the online distance of actor 1.
+			auto was = f.baseline_online.find(entry.first);
+			if (was != f.baseline_online.end() && was->second && d1 <= on - boundary_tolerance)
+			{
+				++near1_was;
+				if (!o->m_bOnline)
+				{
+					++near1_dropped;
+					Msg("! S03-T04 separate: %s [%u] %.1f m from actor 1 went offline", o->name_replace(), u32(o->ID), d1);
+				}
+			}
+		}
+		Msg("S03-T04 separate: near actor 2 only %u (online %u, came online %u); near actor 1 %u (dropped %u)", far_total,
+			far_online, u32(f.far_ids.size()), near1_was, near1_dropped);
+		check(far_total != 0 && far_online == far_total, "every switchable object near actor 2 alone is online");
+		check(!f.far_ids.empty(), "objects offline at the baseline came online for actor 2 alone");
+		check(near1_was != 0 && near1_dropped == 0, "nothing near actor 1 went offline");
+		window_begin();
+		next_step();
+		return;
+	}
+	if (ticks_in_step() < measure_ticks)
+		return;
+	f.separated = window_end("separated");
+	const double b = f.baseline.ticks ? double(f.baseline.engine_cycles) / f.baseline.ticks : 0.0;
+	const double s = f.separated.ticks ? double(f.separated.engine_cycles) / f.separated.ticks : 0.0;
+	Msg("S03-T04 cost: separated/baseline engine time per tick %.2f, online %.1f -> %.1f", b > 0.0 ? s / b : 0.0,
+		f.baseline.ticks ? double(f.baseline.online) / f.baseline.ticks : 0.0,
+		f.separated.ticks ? double(f.separated.online) / f.separated.ticks : 0.0);
+
+	// Awareness: god mode for both actors, a monster beside each.
+	psActorFlags.set(AF_GODMODE, TRUE);
+	psActorFlags.set(AF_GODMODE_RT, TRUE);
+	f.monster1_id = spawn_monster(a1, "actor 1");
+	f.monster2_id = spawn_monster(a2, "actor 2");
+	f.monster1_tick = f.monster2_tick = 0;
+	f.monster1_enemy = f.monster2_enemy = no_id;
+	begin_phase(3);
+}
+
+// 3 awareness: each monster takes its own actor as its enemy.
+void phase_awareness(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	if (f.step == 0)
+	{
+		CBaseMonster* m1 = monster_by_id(f.monster1_id);
+		CBaseMonster* m2 = monster_by_id(f.monster2_id);
+		const CEntityAlive* e1 = m1 ? m1->EnemyMan.get_enemy() : nullptr;
+		const CEntityAlive* e2 = m2 ? m2->EnemyMan.get_enemy() : nullptr;
+		if (e1)
+			f.monster1_enemy = e1->ID();
+		if (e2)
+			f.monster2_enemy = e2->ID();
+		if (!f.monster1_tick && e1 == a1)
+			f.monster1_tick = ticks_in_step();
+		if (!f.monster2_tick && e2 == a2)
+			f.monster2_tick = ticks_in_step();
+		if (ticks_in_step() % 150 == 75)
+		{
+			awareness_report(m1, a1, "monster1");
+			awareness_report(m2, a2, "monster2");
+		}
+		if ((!f.monster1_tick || !f.monster2_tick) && ticks_in_step() < awareness_budget_ticks)
+			return;
+		awareness_report(m1, a1, "monster1-end");
+		awareness_report(m2, a2, "monster2-end");
+		Msg("S03-T04 awareness after %u ticks: monster %u online=%d enemy=%u (actor 1 at tick %u); monster %u online=%d "
+			"enemy=%u (actor 2 at tick %u); actor health %.3f %.3f",
+			ticks_in_step(), u32(f.monster1_id), m1 ? 1 : 0, u32(f.monster1_enemy), f.monster1_tick, u32(f.monster2_id),
+			m2 ? 1 : 0, u32(f.monster2_enemy), f.monster2_tick, a1->GetfHealth(), a2->GetfHealth());
+		check(m1 != nullptr && m2 != nullptr, "both monsters came online");
+		CSE_ALifeDynamicObject* se2 = f.monster2_id != no_id ?
+			smart_cast<CSE_ALifeDynamicObject*>(Level().Server->ID_to_entity(f.monster2_id)) :
+			nullptr;
+		check(se2 && distance_to(se2, entity_position(f.actor1_id)) > sim().offline_distance(),
+			"the monster beside actor 2 is beyond actor 1's offline distance");
+		check(f.monster1_tick != 0, "the monster beside actor 1 took actor 1 as its enemy");
+		check(f.monster2_tick != 0, "the monster beside actor 2 took actor 2 as its enemy");
+		check(a1->g_Alive() && a2->g_Alive(), "both actors are alive (god mode)");
+		release_entity(f.monster1_id);
+		release_entity(f.monster2_id);
+		next_step();
+		return;
+	}
+	const bool gone = !Level().Server->ID_to_entity(f.monster1_id) && !Level().Server->ID_to_entity(f.monster2_id);
+	if (!gone && ticks_in_step() < release_budget_ticks)
+		return;
+	check(gone, "both monsters were released");
+
+	// Disconnect participant 2 while it is far from actor 1.
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	check(registry.detach_session(registry.authority(), session2, Device.dwFrame) == Refusal::None,
+		"participant 2's session detaches");
+	const Participant* v2 = nullptr;
+	registry.participant(f.p2, v2);
+	check(v2 && v2->state == ParticipantState::Detached, "participant 2 is detached");
+	check(participant_actor(f.p2) == a2, "participant 2 still holds its actor");
+	f.far_online_at_detach = 0;
+	for (u32 i = 0; i < f.far_ids.size(); ++i)
+	{
+		CSE_ALifeDynamicObject* o = ai().alife().objects().object(f.far_ids[i], true);
+		if (o && o->m_bOnline)
+			++f.far_online_at_detach;
+	}
+	f.frame0 = Device.dwFrame;
+	f.game_time0 = ai().alife().time_manager().game_time();
+	begin_phase(4);
+}
+
+// 4 disconnect: the retained actor still anchors its area.
+void phase_disconnect(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	if (ticks_in_step() < detached_ticks)
+		return;
+	anchor_check("detached");
+	u32 still = 0;
+	for (u32 i = 0; i < f.far_ids.size(); ++i)
+	{
+		CSE_ALifeDynamicObject* o = ai().alife().objects().object(f.far_ids[i], true);
+		if (o && o->m_bOnline)
+			++still;
+	}
+	Msg("S03-T04 detached %u ticks: far objects online %u of %u (at detach %u)", ticks_in_step(), still,
+		u32(f.far_ids.size()), f.far_online_at_detach);
+	check(f.far_online_at_detach != 0 && still == f.far_online_at_detach,
+		"the detached participant's area stays online");
+	check(g_pGameLevel && Level().Server && ai().get_alife(), "the level, the server and ALife exist");
+	check(ai().alife().time_manager().game_time() > f.game_time0 && Device.dwFrame > f.frame0,
+		"the ALife clock and the frame driver advanced");
+	check(a1->g_Alive() && participant_actor(f.p1) == a1, "participant 1 still holds its alive actor");
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	check(registry.attach_session(registry.authority(), f.p2, session2, Device.dwFrame) == Refusal::None,
+		"participant 2's session re-attaches");
+	const Participant* v2 = nullptr;
+	registry.participant(f.p2, v2);
+	check(v2 && v2->state == ParticipantState::Attached && participant_actor(f.p2) == a2,
+		"participant 2 is attached to the same actor");
+	teleport(a2, f.home2);
+	Msg("S03-T04 return: actor 2 back to [%.1f,%.1f,%.1f], %.1f m from actor 1", VPUSH(f.home2),
+		a1->Position().distance_to(f.home2));
+	begin_phase(5);
+}
+
+// 5 return: the far area goes offline again.
+void phase_return(CActor* a1, CActor* a2)
+{
+	Fixture& f = g_fixture;
+	if (f.step == 0)
+	{
+		if (followed(a2, f.home2, "return"))
+			next_step();
+		return;
+	}
+	if (!settled(settle_cap_move, "return"))
+		return;
+	anchor_check("return");
+	rule_check("return");
+	CALifeSimulator& alife = sim();
+	const float off = alife.offline_distance();
+	const Fvector p1 = entity_position(f.actor1_id);
+	const Fvector p2 = entity_position(f.actor2_id);
+	u32 beyond = 0, offline = 0;
+	for (u32 i = 0; i < f.far_ids.size(); ++i)
+	{
+		CSE_ALifeDynamicObject* o = ai().alife().objects().object(f.far_ids[i], true);
+		if (!o || !o->can_switch_offline() || !o->can_switch_online())
+			continue;
+		if (distance_to(o, p1) <= off + boundary_tolerance || distance_to(o, p2) <= off + boundary_tolerance)
+			continue; // moved into reach since
+		++beyond;
+		if (!o->m_bOnline)
+			++offline;
+	}
+	Msg("S03-T04 return: far objects beyond both actors %u, offline %u (of %u that came online)", beyond, offline,
+		u32(f.far_ids.size()));
+	check(beyond != 0 && offline == beyond, "the objects that came online for actor 2 alone went offline again");
+	check(a1->g_Alive() && a2->g_Alive(), "both actors are alive at the end");
+	finish(true);
+}
