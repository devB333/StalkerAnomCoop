+// The campaign frame driver (S02-T04a): 20 ms ticks and at most 5 catch-up
+// ticks per wall frame unless -campaign-tick-ms overrides the tick.
+CCampaignServerClock* g_campaign_clock = nullptr;
+u32 g_campaign_tick_ms = 20;
+CTimer g_campaign_wall;
+
+bool StartCampaignFrameDriver()
+{
+    g_campaign_clock = xr_new<CCampaignServerClock>(g_campaign_tick_ms, 5);
+    g_campaign_wall.Start();
+    g_campaign_clock->Start(g_campaign_wall.GetElapsed_ms());
+    // Loading is not simulation time: the clock stays paused until the
+    // simulation begins.
+    g_campaign_clock->Pause(g_campaign_wall.GetElapsed_ms());
+    return true;
+}
+
+void StopCampaignFrameDriver()
+{
+    g_campaign_clock->Stop();
+    xr_delete(g_campaign_clock);
+}
+
+// Test probes for the frame driver fixture. Ids record the callback order:
+// 1 app slot (HIGH+1000), 2 scheduled probe, 3 NORMAL, 4 LOW, 5 parallel job,
+// 6 seqFrameMT. Each tick must log 1 [2] 3 4 5 6.
+struct FrameDriverProbe
+{
+    struct Frame : pureFrame
+    {
+        FrameDriverProbe* owner;
+        u32 id;
+        virtual void _BCL OnFrame() { owner->OnProbe(id); }
+    };
+    struct Scheduled : ISheduled
+    {
+        FrameDriverProbe* owner;
+        u32 calls = 0;
+        u64 dt_sum = 0;
+        float shedule_Scale() override { return 0.f; }
+        bool shedule_Needed() override { return true; }
+        shared_str shedule_Name() const override { return shared_str("s02_t04_frame_probe"); }
+        void shedule_Update(u32 dt) override
+        {
+            ISheduled::shedule_Update(dt);
+            ++calls;
+            dt_sum += dt;
+            owner->order.push_back(2);
+        }
+    };
+
+    Frame app, normal, low, mt;
+    Scheduled scheduled;
+    xr_vector<u32> order;
+    u32 last_frame = 0, clock_violations = 0, order_violations = 0;
+
+    void OnProbe(u32 id)
+    {
+        order.push_back(id);
+        if (id == 1)
+        {
+            // Clocks advance by exactly one tick and stay consistent.
+            const u32 tick = g_campaign_clock->TickMs();
+            if (Device.dwFrame != last_frame + 1 || Device.dwTimeDelta != tick ||
+                Device.dwTimeGlobal != Device.dwFrame * tick ||
+                Device.fTimeDelta != float(tick) / 1000.f ||
+                Device.fTimeGlobal != float(Device.dwTimeGlobal) / 1000.f)
+                ++clock_violations;
+            last_frame = Device.dwFrame;
+        }
+        if (id == 3)
+            Device.seqParallel.push_back(fastdelegate::FastDelegate0<>(this, &FrameDriverProbe::Job));
+    }
+    void Job() { order.push_back(5); }
+
+    void Register()
+    {
+        app.owner = normal.owner = low.owner = mt.owner = this;
+        scheduled.owner = this;
+        app.id = 1; normal.id = 3; low.id = 4; mt.id = 6;
+        last_frame = Device.dwFrame;
+        Device.seqFrame.Add(&app, REG_PRIORITY_HIGH + 1000);
+        Device.seqFrame.Add(&normal, REG_PRIORITY_NORMAL);
+        Device.seqFrame.Add(&low, REG_PRIORITY_LOW);
+        Device.seqFrameMT.Add(&mt, REG_PRIORITY_NORMAL);
+        scheduled.shedule.t_min = 20;
+        scheduled.shedule.t_max = 100;
+        scheduled.shedule_register();
+    }
+    void Unregister()
+    {
+        scheduled.shedule_unregister();
+        Device.seqFrameMT.Remove(&mt);
+        Device.seqFrame.Remove(&low);
+        Device.seqFrame.Remove(&normal);
+        Device.seqFrame.Remove(&app);
+    }
+    void CheckOrder()
+    {
+        // Split at each 1 and compare each tick's sequence.
+        for (size_t i = 0; i < order.size();)
+        {
+            size_t j = i + 1;
+            while (j < order.size() && order[j] != 1)
+                ++j;
+            static const u32 plain[] = {1, 3, 4, 5, 6};
+            static const u32 probed[] = {1, 2, 3, 4, 5, 6};
+            const size_t size = j - i;
+            const bool with_probe = size == 6 && order[i + 1] == 2;
+            const u32* expect = with_probe ? probed : plain;
+            const size_t n = with_probe ? 6 : 5;
+            if (size != n || !std::equal(order.begin() + i, order.begin() + j, expect))
+                ++order_violations;
+            i = j;
+        }
+    }
+};
+
+// Wall-paced ticks until the clock reaches target, sleeping between due ticks.
+void RunCampaignTicksTo(u64 target)
+{
+    while (g_campaign_clock->Stats().ticks < target)
+    {
+        const u32 now = g_campaign_wall.GetElapsed_ms();
+        const u32 next = g_campaign_clock->NextTickWallMs();
+        if (now < next)
+            Sleep(next - now);
+        g_campaign_clock->Advance(g_campaign_wall.GetElapsed_ms());
+    }
+}
+
+// 300 ticks with an injected 500 ms stall at tick 100 and a 300 ms pause at
+// tick 200 (H10: long frame, bounded catch-up, explicit pause).
+bool RunCampaignFrameDriverFixture()
+{
+    FrameDriverProbe probe;
+    probe.Register();
+    g_campaign_clock->Resume(g_campaign_wall.GetElapsed_ms());
+    const u32 wall_start = g_campaign_wall.GetElapsed_ms();
+
+    RunCampaignTicksTo(100);
+    Sleep(500);
+    const u64 dropped_before = g_campaign_clock->Stats().dropped_ms;
+    const u32 stall_ran = g_campaign_clock->Advance(g_campaign_wall.GetElapsed_ms());
+    const u64 stall_dropped = g_campaign_clock->Stats().dropped_ms - dropped_before;
+
+    RunCampaignTicksTo(200);
+    const u32 calls_before_pause = probe.scheduled.calls;
+    const u64 ticks_before_pause = g_campaign_clock->Stats().ticks;
+    g_campaign_clock->Pause(g_campaign_wall.GetElapsed_ms());
+    Sleep(300);
+    const u32 paused_ran = g_campaign_clock->Advance(g_campaign_wall.GetElapsed_ms());
+    g_campaign_clock->Resume(g_campaign_wall.GetElapsed_ms());
+    const u32 resume_ran = g_campaign_clock->Advance(g_campaign_wall.GetElapsed_ms());
+    const bool pause_still = g_campaign_clock->Stats().ticks - ticks_before_pause == resume_ran &&
+        probe.scheduled.calls - calls_before_pause <= resume_ran;
+
+    RunCampaignTicksTo(300);
+    probe.Unregister();
+    probe.CheckOrder();
+
+    const CCampaignServerClock::Counters& c = g_campaign_clock->Stats();
+    const u32 sim_ms = Device.dwTimeGlobal;
+    const u32 wall_ms = g_campaign_wall.GetElapsed_ms() - wall_start;
+    Msg("S02-T04 clock tick_ms=%u ticks=%u sim_ms=%u wall_ms=%u catchup_ticks=%u dropped_ms=%u paused_ms=%u "
+        "max_debt_ms=%u scheduler_updates=%u parallel_jobs=%u",
+        g_campaign_clock->TickMs(), u32(c.ticks), sim_ms, wall_ms, u32(c.catchup_ticks), u32(c.dropped_ms),
+        u32(c.paused_ms), c.max_debt_ms, c.scheduler_updates, u32(c.parallel_jobs));
+    Msg("S02-T04 probe order_violations=%u clock_violations=%u scheduled_calls=%u scheduled_dt_ms=%u "
+        "stall_ran=%u stall_dropped_ms=%u paused_ran=%u resume_ran=%u",
+        probe.order_violations, probe.clock_violations, probe.scheduled.calls, u32(probe.scheduled.dt_sum),
+        stall_ran, u32(stall_dropped), paused_ran, resume_ran);
+
+    // The scheduled probe's elapsed time is bounded by simulation time.
+    const bool scheduled_ok = probe.scheduled.calls != 0 && probe.scheduled.dt_sum <= sim_ms &&
+        probe.scheduled.dt_sum + 100 >= sim_ms - 2 * g_campaign_clock->TickMs();
+    return c.ticks >= 300 && sim_ms == u32(c.ticks) * g_campaign_clock->TickMs() &&
+        c.scheduler_updates == c.ticks && c.parallel_jobs == c.ticks && probe.order_violations == 0 &&
+        probe.clock_violations == 0 && scheduled_ok && stall_ran == 6 && stall_dropped != 0 &&
+        paused_ran == 0 && resume_ran <= 1 && pause_still && c.paused_ms >= 300 &&
+        c.dropped_ms == stall_dropped;
+}
