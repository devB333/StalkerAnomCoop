+// --- S10-T06: session control from the co-op menu (decisions T01-17…T01-19) ------------------------------------
+// The owner is the first key this server accepted (app data coop-owner.txt; T01-18). The campaign library is the
+// app data folder campaigns\<id>\campaign.ltx, one per campaign this server served or created. A create or a load
+// is carried out as a clean stop and a relaunch: the server writes the chosen campaign's launch files into
+// coop-relaunch.ltx, tells every client the new campaign id (CampaignEvent 20), stops (the clean stop publishes
+// a checkpoint) and ends with kRelaunchExitCode; its launcher (tools/Run-CoopSession.ps1,
+// tools/Start-CoopServer.ps1) starts it again on them. A process serves one campaign from start to end, so no
+// state of one campaign can leak into the next.
+const int kRelaunchExitCode = 75;
+const u16 kEventSession = 20;
+
+struct CampaignEntry
+{
+	coop::proto::Uuid128 id;
+	xr_string label, level, profile, fsgame;
+	u32 created = 0, updated = 0;
+};
+
+static u32 session_now() { return u32(_time64(nullptr)); }
+
+static xr_string session_num(int v)
+{
+	string32 n;
+	xr_sprintf(n, "%d", v);
+	return n;
+}
+
+static xr_string session_path(LPCSTR name)
+{
+	string_path root;
+	FS.update_path(root, "$app_data_root$", "");
+	xr_string p = root;
+	if (!p.empty() && p.back() != '\\')
+		p += '\\';
+	return p + name;
+}
+
+static bool session_read(const xr_string& path, xr_string& out)
+{
+	FILE* f = fopen(path.c_str(), "rb");
+	if (!f)
+		return false;
+	out.clear();
+	char buffer[4096];
+	size_t n;
+	while ((n = fread(buffer, 1, sizeof(buffer), f)) > 0)
+		out.append(buffer, n);
+	fclose(f);
+	return true;
+}
+
+// written whole or not at all (a temporary file renamed over the old one)
+static bool session_write(const xr_string& path, const xr_string& text)
+{
+	const xr_string temp = path + ".tmp";
+	FILE* f = fopen(temp.c_str(), "wb");
+	if (!f)
+		return false;
+	const bool ok = fwrite(text.data(), 1, text.size(), f) == text.size();
+	fclose(f);
+	return ok && MoveFileExA(temp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+}
+
+static xr_string session_trim(const xr_string& s)
+{
+	size_t a = 0, b = s.size();
+	while (a < b && (s[a] == ' ' || s[a] == '\t' || s[a] == '\r' || s[a] == '\n'))
+		++a;
+	while (b > a && (s[b - 1] == ' ' || s[b - 1] == '\t' || s[b - 1] == '\r' || s[b - 1] == '\n'))
+		--b;
+	return s.substr(a, b - a);
+}
+
+// "key = value" lines (one section or none) into a map
+static void session_parse(const xr_string& text, xr_map<xr_string, xr_string>& out)
+{
+	size_t at = 0;
+	while (at < text.size())
+	{
+		size_t end = text.find('\n', at);
+		if (end == xr_string::npos)
+			end = text.size();
+		const xr_string line = text.substr(at, end - at);
+		at = end + 1;
+		const size_t eq = line.find('=');
+		if (eq == xr_string::npos)
+			continue;
+		const xr_string key = session_trim(line.substr(0, eq));
+		if (!key.empty() && key[0] != ';' && key[0] != '[')
+			out[key] = session_trim(line.substr(eq + 1));
+	}
+}
+
+static xr_string campaign_dir(const coop::proto::Uuid128& id)
+{
+	return session_path("campaigns\\") + coop_uuid_hex(id).c_str();
+}
+
+static bool campaign_write(const CampaignEntry& e)
+{
+	CreateDirectoryA(session_path("campaigns").c_str(), nullptr);
+	const xr_string dir = campaign_dir(e.id);
+	CreateDirectoryA(dir.c_str(), nullptr);
+	string4096 text;
+	xr_sprintf(text, "[campaign]\nid = %s\nlabel = %s\nlevel = %s\nprofile = %s\nfsgame = %s\ncreated = %u\nupdated = %u\n",
+		coop_uuid_hex(e.id).c_str(), e.label.c_str(), e.level.c_str(), e.profile.c_str(), e.fsgame.c_str(), e.created,
+		e.updated);
+	return session_write(dir + "\\campaign.ltx", text);
+}
+
+static bool campaign_read(const xr_string& file, CampaignEntry& e)
+{
+	xr_string text;
+	if (!session_read(file, text))
+		return false;
+	xr_map<xr_string, xr_string> kv;
+	session_parse(text, kv);
+	if (!coop::session::uuid_from_hex(kv["id"].c_str(), e.id) || e.id.zero())
+		return false;
+	e.label = kv["label"];
+	e.level = kv["level"];
+	e.profile = kv["profile"];
+	e.fsgame = kv["fsgame"];
+	e.created = u32(atoi(kv["created"].c_str()));
+	e.updated = u32(atoi(kv["updated"].c_str()));
+	return true;
+}
+
+// newest first
+static void campaign_list(xr_vector<CampaignEntry>& out)
+{
+	out.clear();
+	WIN32_FIND_DATAA found;
+	const xr_string pattern = session_path("campaigns\\*");
+	HANDLE h = FindFirstFileA(pattern.c_str(), &found);
+	if (h == INVALID_HANDLE_VALUE)
+		return;
+	do
+	{
+		if (!(found.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || found.cFileName[0] == '.')
+			continue;
+		CampaignEntry e;
+		if (campaign_read(session_path("campaigns\\") + found.cFileName + "\\campaign.ltx", e))
+			out.push_back(e);
+	} while (FindNextFileA(h, &found));
+	FindClose(h);
+	std::sort(out.begin(), out.end(), [](const CampaignEntry& a, const CampaignEntry& b) { return a.updated > b.updated; });
+}
+
+// a path after -<key> on the command line (quoted or not)
+static void session_arg(LPCSTR key, LPSTR out, size_t size)
+{
+	LPCSTR at = strstr(GetCommandLineA(), key);
+	if (!at)
+		return;
+	at += xr_strlen(key);
+	while (*at == ' ')
+		++at;
+	const bool quoted = *at == '"';
+	if (quoted)
+		++at;
+	size_t n = 0;
+	while (at[n] && (quoted ? at[n] != '"' : at[n] != ' ') && n + 1 < size)
+		++n;
+	strncpy_s(out, size, at, n);
+}
+
+static bool session_is_owner(const PlayerLink& link)
+{
+	return g_host->session.owner_known && g_host->session.owner == link.player;
+}
+
+// The served campaign joins the library (or is updated there); the owner is read.
+void session_start()
+{
+	Host::Session& s = g_host->session;
+	session_arg("-coop-config ", s.profile, sizeof(s.profile));
+	session_arg("-fsltx ", s.fsgame, sizeof(s.fsgame));
+	xr_string text;
+	if (session_read(session_path("coop-owner.txt"), text) &&
+		coop::session::uuid_from_hex(session_trim(text).c_str(), s.owner) && !s.owner.zero())
+		s.owner_known = true;
+	CampaignEntry e;
+	if (!campaign_read(campaign_dir(g_host->config.campaign_id) + "\\campaign.ltx", e))
+	{
+		e.id = g_host->config.campaign_id;
+		string256 label;
+		if (g_host->config.new_game)
+			xr_sprintf(label, "New game (%s)", g_host->config.new_game_faction);
+		else
+			xr_sprintf(label, "Saved game %s", g_host->config.save_name);
+		e.label = label;
+		e.created = session_now();
+	}
+	e.profile = s.profile;
+	e.fsgame = s.fsgame;
+	e.level = g_pGameLevel ? Level().name().c_str() : "";
+	e.updated = session_now();
+	const bool written = campaign_write(e);
+	g_host->log.line("session-campaign id=%s label=\"%s\" level=%s written=%d owner=%s", coop_uuid_hex(e.id).c_str(),
+		e.label.c_str(), e.level.c_str(), written ? 1 : 0,
+		s.owner_known ? coop_uuid_hex(s.owner).c_str() : "none");
+}
+
+// the level and time of the served campaign, at its stop
+void session_stop()
+{
+	CampaignEntry e;
+	if (!campaign_read(campaign_dir(g_host->config.campaign_id) + "\\campaign.ltx", e))
+		return;
+	if (g_pGameLevel)
+		e.level = Level().name().c_str();
+	e.updated = session_now();
+	campaign_write(e);
+}
+
+// T01-18: the first key a fresh server accepts owns the session, for every campaign it serves
+void session_owner_join(const PlayerLink& link)
+{
+	Host::Session& s = g_host->session;
+	if (s.owner_known)
+		return;
+	s.owner = link.player;
+	s.owner_known = true;
+	const bool written = session_write(session_path("coop-owner.txt"), coop_uuid_hex(link.player).c_str());
+	g_host->log.line("session-owner player=%s slot=%u first=1 written=%d", coop_uuid_hex(link.player).c_str(),
+		u32(link.ref.slot), written ? 1 : 0);
+}
+
+static bool session_ident(const xr_string& v, size_t max, bool upper)
+{
+	if (v.empty() || v.size() > max)
+		return false;
+	for (char c : v)
+		if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || (upper && c >= 'A' && c <= 'Z')))
+			return false;
+	return true;
+}
+
+// A loadout as the creation screen allows it (ui_mm_faction_select.script LoadLoadout, 1206-1290): every item from
+// the faction's [<faction>_loadout] list in items\settings\new_game_loadouts.ltx, at most its count, the always-given
+// ones ("false") free and the picked ones ("true") within [points] total_points_eco_<economy>.
+static bool session_check_loadout(LPCSTR faction, int economy, const xr_string& list, xr_string& why)
+{
+	string_path path;
+	FS.update_path(path, "$game_config$", "items\\settings\\new_game_loadouts.ltx");
+	CInifile itm(path, TRUE, TRUE, FALSE);
+	string128 section;
+	xr_sprintf(section, "%s_loadout", faction);
+	if (!itm.section_exist(section))
+	{
+		why = "no loadout list for the faction";
+		return false;
+	}
+	xr_map<xr_string, int> kit, pick;
+	xr_map<xr_string, float> points;
+	const u32 lines = itm.line_count(section);
+	for (u32 i = 0; i < lines; ++i)
+	{
+		LPCSTR name = nullptr, value = nullptr;
+		if (!itm.r_line(section, int(i), &name, &value) || !name || !value || !pSettings->section_exist(name))
+			continue;
+		string256 v;
+		xr_strcpy(v, value);
+		string64 flag = "", count = "", pts = "", eco = "";
+		_GetItem(v, 0, flag);
+		_GetItem(v, 1, count);
+		_GetItem(v, 2, pts);
+		_GetItem(v, 3, eco);
+		if (eco[0] && economy > atoi(eco))
+			continue;
+		if (!xr_strcmp(flag, "false"))
+			kit[name] += atoi(count);
+		else if (!xr_strcmp(flag, "true"))
+		{
+			pick[name] += atoi(count);
+			points[name] = float(atof(pts));
+		}
+	}
+	string64 budget_key;
+	xr_sprintf(budget_key, "total_points_eco_%d", economy);
+	const float budget = itm.line_exist("points", budget_key) ? itm.r_float("points", budget_key) : 1000.f;
+	float used = 0.f;
+	u32 items = 0;
+	string4096 copy;
+	xr_strcpy(copy, list.c_str());
+	for (LPSTR name = strtok(copy, ", \t"); name; name = strtok(nullptr, ", \t"))
+	{
+		if (++items > 64)
+		{
+			why = "more than 64 items";
+			return false;
+		}
+		if (kit[name] > 0)
+			--kit[name];
+		else if (pick[name] > 0)
+		{
+			--pick[name];
+			used += points[name];
+		}
+		else
+		{
+			why = xr_string("not offered to the faction: ") + name;
+			return false;
+		}
+	}
+	if (used > budget + 0.01f)
+	{
+		string128 b;
+		xr_sprintf(b, "over the points: %.0f of %.0f", used, budget);
+		why = b;
+		return false;
+	}
+	return true;
+}
+
+// The creation screen's choices (OnStartGame, 1683-1764), checked by its rules; the creator's money is the
+// faction's ([<faction>_money] money), whatever the client sent.
+static bool session_check_creation(const xr_map<xr_string, xr_string>& kv, xr_vector<std::pair<xr_string, xr_string>>& clean,
+	xr_string& faction, xr_string& map, int& money, xr_string& why)
+{
+	auto get = [&kv](LPCSTR k) {
+		auto it = kv.find(k);
+		return it == kv.end() ? xr_string() : it->second;
+	};
+	faction = get("new_game_faction");
+	map = get("new_game_map");
+	const xr_string name = get("new_game_character_name");
+	if (!session_ident(faction, 64, false) || !session_ident(map, 64, false))
+	{
+		why = "no faction or start";
+		return false;
+	}
+	if (!session_ident(name, 32, true))
+	{
+		why = "the name is not 1-32 letters, digits or _";
+		return false;
+	}
+	string_path path;
+	FS.update_path(path, "$game_config$", "plugins\\new_game_start_locations.ltx");
+	CInifile starts(path, TRUE, TRUE, FALSE);
+	string128 section;
+	xr_sprintf(section, "%s_start_locations", faction.c_str());
+	if (!starts.section_exist(section) || !starts.line_exist(section, map.c_str()))
+	{
+		why = "the start is not one of the faction's";
+		return false;
+	}
+	const int economy = _max(1, _min(9, atoi(get("new_game_economy").c_str())));
+	const int difficulty = _max(1, _min(9, atoi(get("new_game_difficulty").c_str())));
+	if (!session_check_loadout(faction.c_str(), economy, get("new_game_loadout"), why))
+		return false;
+	FS.update_path(path, "$game_config$", "items\\settings\\new_game_loadouts.ltx");
+	CInifile itm(path, TRUE, TRUE, FALSE);
+	xr_sprintf(section, "%s_money", faction.c_str());
+	money = itm.line_exist(section, "money") ? iFloor(itm.r_float(section, "money")) : 2000;
+	clean.clear();
+	clean.emplace_back("new_game_difficulty", session_num(difficulty));
+	clean.emplace_back("new_game_economy", session_num(economy));
+	clean.emplace_back("new_game_economy_treasure", session_num(economy));
+	for (LPCSTR flag : {"new_game_hardcore_mode", "new_game_story_mode", "new_game_azazel_mode", "new_game_survival_mode",
+			 "new_game_campfire_mode", "new_game_conditions_mode", "new_game_opened_routes", "new_game_warfare"})
+	{
+		const xr_string v = get(flag);
+		if (v == "true" || v == "1")
+			clean.emplace_back(flag, "true");
+	}
+	for (LPCSTR number : {"new_game_hardcore_mode_lives", "new_game_hardcore_mode_regenerate", "new_game_timer_mode"})
+	{
+		const xr_string v = get(number);
+		if (!v.empty())
+			clean.emplace_back(number, session_num(_max(0, _min(100000, atoi(v.c_str())))));
+	}
+	clean.emplace_back("new_game_character_name", name);
+	clean.emplace_back("new_game_faction", faction);
+	const xr_string icon = get("new_game_icon");
+	if (session_ident(icon, 64, true))
+		clean.emplace_back("new_game_icon", icon);
+	clean.emplace_back("new_game_loadout", get("new_game_loadout"));
+	clean.emplace_back("new_game_map", map);
+	clean.emplace_back("new_game_money", session_num(money));
+	return true;
+}
+
+// the server's own axr_options.ltx (axr_main.config: $game_config$, S10-T03f) gets the creator's choices
+static bool session_write_creation(const xr_vector<std::pair<xr_string, xr_string>>& clean)
+{
+	string_path path;
+	FS.update_path(path, "$game_config$", "axr_options.ltx");
+	xr_string text, out;
+	session_read(path, text);
+	bool skipping = false;
+	size_t at = 0;
+	while (at < text.size())
+	{
+		size_t end = text.find('\n', at);
+		if (end == xr_string::npos)
+			end = text.size();
+		const xr_string line = text.substr(at, end - at);
+		at = end + 1;
+		const xr_string t = session_trim(line);
+		if (!t.empty() && t[0] == '[')
+			skipping = t.compare(0, 20, "[character_creation]") == 0;
+		if (!skipping)
+			out += line + "\n";
+	}
+	out += "[character_creation]\n";
+	for (const auto& kv : clean)
+		out += kv.first + " = " + kv.second + "\n";
+	return session_write(path, out);
+}
+
+// a launch file of the served campaign with some keys replaced (a profile) or one line (fsgame's $game_saves$)
+static xr_string session_rewrite(const xr_string& text, const xr_vector<std::pair<xr_string, xr_string>>& keys,
+	LPCSTR after_section)
+{
+	xr_string out;
+	size_t at = 0;
+	bool inserted = !after_section;
+	while (at < text.size())
+	{
+		size_t end = text.find('\n', at);
+		if (end == xr_string::npos)
+			end = text.size();
+		const xr_string line = text.substr(at, end - at);
+		at = end + 1;
+		const size_t eq = line.find('=');
+		const xr_string key = eq == xr_string::npos ? xr_string() : session_trim(line.substr(0, eq));
+		bool replaced = false;
+		for (const auto& kv : keys)
+			if (key == kv.first)
+				replaced = true;
+		if (!replaced)
+			out += line + "\n";
+		if (!inserted && session_trim(line) == after_section)
+		{
+			for (const auto& kv : keys)
+				out += kv.first + " = " + kv.second + "\n";
+			inserted = true;
+		}
+	}
+	if (!inserted || !after_section)
+		for (const auto& kv : keys)
+			out += kv.first + " = " + kv.second + "\n";
+	return out;
+}
+
+static std::vector<u8> session_id_bytes(const coop::proto::Uuid128& id)
+{
+	std::vector<u8> p;
+	for (int b = 0; b < 8; ++b)
+		p.push_back(u8(id.hi >> (8 * b)));
+	for (int b = 0; b < 8; ++b)
+		p.push_back(u8(id.lo >> (8 * b)));
+	return p;
+}
+
+// Every client is told the next campaign, then the server stops and is relaunched on it.
+static void session_announce(const CampaignEntry& next, u8 why)
+{
+	Host::Session& s = g_host->session;
+	string4096 relaunch;
+	xr_sprintf(relaunch, "[relaunch]\ncampaign = %s\nprofile = %s\nfsgame = %s\nwhy = %s\n", coop_uuid_hex(next.id).c_str(),
+		next.profile.c_str(), next.fsgame.c_str(), why == 1 ? "create" : "load");
+	const bool written = session_write(session_path("coop-relaunch.ltx"), relaunch);
+	std::vector<u8> p;
+	put_u8(p, 2);
+	const std::vector<u8> id = session_id_bytes(next.id);
+	p.insert(p.end(), id.begin(), id.end());
+	put_u8(p, why);
+	put_str(p, next.label.c_str());
+	u32 told = 0;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && link.session)
+		{
+			queue_event(link, kEventSession, p);
+			++told;
+		}
+	s.next = next.id;
+	s.relaunch_at_ms = g_host->wall.GetElapsed_ms() + 2000; // the notice goes out first
+	g_host->log.line("session-switch why=%s from=%s to=%s label=\"%s\" told=%u relaunch_file=%d",
+		why == 1 ? "create" : "load", coop_uuid_hex(g_host->config.campaign_id).c_str(), coop_uuid_hex(next.id).c_str(),
+		next.label.c_str(), told, written ? 1 : 0);
+}
+
+static bool session_busy()
+{
+	return g_host->session.relaunch_at_ms || g_host->travel.exec ||
+		(g_host->sleep.coordinator && g_host->sleep.coordinator->live());
+}
+
+static void session_send_list(PlayerLink& link)
+{
+	xr_vector<CampaignEntry> entries;
+	campaign_list(entries);
+	std::vector<u8> p;
+	put_u8(p, 1);
+	put_u8(p, session_is_owner(link) ? 1 : 0);
+	const u32 n = _min(u32(entries.size()), 8u);
+	put_u8(p, u8(n));
+	for (u32 i = 0; i < n; ++i)
+	{
+		const CampaignEntry& e = entries[i];
+		const std::vector<u8> id = session_id_bytes(e.id);
+		p.insert(p.end(), id.begin(), id.end());
+		put_u8(p, e.id == g_host->config.campaign_id ? 1 : 0);
+		put_str(p, e.label.substr(0, 60).c_str());
+		put_str(p, e.level.substr(0, 32).c_str());
+		put_u32(p, e.updated);
+	}
+	queue_event(link, kEventSession, p);
+	++g_host->session.lists;
+	g_host->log.line("session-list slot=%u owner=%d campaigns=%u", u32(link.ref.slot), session_is_owner(link) ? 1 : 0, n);
+}
+
+// the partner's loadout for the next new game (T01-19), checked against that game's faction when it is created
+static xr_string session_loadout_file(u8 slot)
+{
+	string32 name;
+	xr_sprintf(name, "coop-loadout-%u.txt", u32(slot));
+	return session_path(name);
+}
+
+static u16 session_create(PlayerLink& link, const xr_string& text, coop::proto::ActionResult& result)
+{
+	xr_map<xr_string, xr_string> kv;
+	session_parse(text, kv);
+	xr_vector<std::pair<xr_string, xr_string>> clean;
+	xr_string faction, map, why;
+	int money = 0;
+	if (!session_check_creation(kv, clean, faction, map, money, why))
+	{
+		g_host->log.line("session-create-refused slot=%u why=\"%s\"", u32(link.ref.slot), why.c_str());
+		return coop::proto::kReasonBadChoices;
+	}
+	Host::Session& s = g_host->session;
+	xr_string profile_text, fsgame_text;
+	if (!session_read(s.profile, profile_text) || !session_read(s.fsgame, fsgame_text))
+	{
+		g_host->log.line("session-create-refused slot=%u why=\"launch files unreadable\"", u32(link.ref.slot));
+		return coop::proto::kReasonStoreFailed;
+	}
+	CampaignEntry next;
+	next.id = coop::session::random_uuid();
+	const xr_string dir = campaign_dir(next.id);
+	CreateDirectoryA(session_path("campaigns").c_str(), nullptr);
+	CreateDirectoryA(dir.c_str(), nullptr);
+	CreateDirectoryA((dir + "\\savedgames").c_str(), nullptr);
+	// the partner's own loadout, if it chose one for the faction (else the faction's kit, S10-T03f)
+	xr_string loadout2;
+	for (const PlayerLink& other : g_host->links)
+		if (other.ref.slot != link.ref.slot && other.ref.slot < 2)
+		{
+			xr_string saved, why2;
+			xr_map<xr_string, xr_string> kv2;
+			if (session_read(session_loadout_file(other.ref.slot), saved))
+				session_parse(saved, kv2);
+			const xr_string list = kv2["new_game_loadout"];
+			const int economy = _max(1, _min(9, atoi(kv["new_game_economy"].c_str())));
+			if (!list.empty() && session_check_loadout(faction.c_str(), economy, list, why2))
+				loadout2 = list;
+			g_host->log.line("session-partner-loadout slot=%u chosen=%d kept=%d why=\"%s\"", u32(other.ref.slot),
+				list.empty() ? 0 : 1, loadout2.empty() ? 0 : 1, why2.c_str());
+		}
+	xr_vector<std::pair<xr_string, xr_string>> keys;
+	keys.emplace_back("campaign_id", coop_uuid_hex(next.id).c_str());
+	keys.emplace_back("save", "coop-campaign");
+	keys.emplace_back("new_game", "1");
+	keys.emplace_back("new_game_faction", faction);
+	keys.emplace_back("new_game_loadout_2", loadout2);
+	keys.emplace_back("new_game_money_2", session_num(money));
+	next.profile = dir + "\\coop.ltx";
+	next.fsgame = dir + "\\fsgame.ltx";
+	xr_vector<std::pair<xr_string, xr_string>> saves;
+	saves.emplace_back("$game_saves$",
+		xr_string("true | false | $app_data_root$| campaigns\\") + coop_uuid_hex(next.id).c_str() + "\\savedgames\\ | *.scop;*.scoc");
+	const xr_string name = kv["new_game_character_name"];
+	next.label = name + ": " + faction + ", " + map;
+	next.level = "";
+	next.created = next.updated = session_now();
+	if (!session_write(next.profile, session_rewrite(profile_text, keys, "[coop]")) ||
+		!session_write(next.fsgame, session_rewrite(fsgame_text, saves, nullptr)) || !campaign_write(next) ||
+		!session_write_creation(clean))
+	{
+		g_host->log.line("session-create-refused slot=%u why=\"launch files not written\"", u32(link.ref.slot));
+		return coop::proto::kReasonStoreFailed;
+	}
+	++s.creates;
+	result.revision = 1;
+	g_host->log.line("session-create slot=%u id=%s faction=%s map=%s name=%s money=%d loadout=[%s] loadout2=[%s]",
+		u32(link.ref.slot), coop_uuid_hex(next.id).c_str(), faction.c_str(), map.c_str(), name.c_str(), money,
+		kv["new_game_loadout"].c_str(), loadout2.c_str());
+	session_announce(next, 1);
+	return 0;
+}
+
+u16 take_session(PlayerLink& link, const coop::proto::ActionIntent& intent, coop::proto::ActionResult& result)
+{
+	Host::Session& s = g_host->session;
+	const std::vector<u8>& p = intent.params;
+	if (!link.session || p.empty())
+		return coop::proto::kReasonMalformed;
+	const u8 op = p[0];
+	if (op == 1)
+	{
+		if (p.size() != 1)
+			return coop::proto::kReasonMalformed;
+		session_send_list(link);
+		return 0;
+	}
+	if (op == 3)
+	{
+		if (p.size() != 17)
+			return coop::proto::kReasonMalformed;
+		coop::proto::Uuid128 id;
+		for (int b = 0; b < 8; ++b)
+			id.hi |= u64(p[1 + b]) << (8 * b);
+		for (int b = 0; b < 8; ++b)
+			id.lo |= u64(p[9 + b]) << (8 * b);
+		u16 reason = 0;
+		CampaignEntry chosen;
+		bool found = false;
+		if (!session_is_owner(link))
+			reason = coop::proto::kReasonNotOwner;
+		else if (session_busy())
+			reason = coop::proto::kReasonSessionBusy;
+		else
+		{
+			xr_vector<CampaignEntry> entries;
+			campaign_list(entries);
+			for (const CampaignEntry& e : entries)
+				if (e.id == id && e.id != g_host->config.campaign_id && !e.profile.empty() && !e.fsgame.empty())
+				{
+					chosen = e;
+					found = true;
+				}
+			if (!found)
+				reason = coop::proto::kReasonUnknownCampaign;
+		}
+		if (reason)
+		{
+			++s.refused;
+			g_host->log.line("session-load-refused slot=%u id=%s reason=%u", u32(link.ref.slot), coop_uuid_hex(id).c_str(),
+				u32(reason));
+			return reason;
+		}
+		++s.loads;
+		result.revision = 1;
+		session_announce(chosen, 2);
+		return 0;
+	}
+	if (op != 2 && op != 4)
+		return coop::proto::kReasonMalformed;
+	// a create or a loadout in parts: u8 part, u8 parts, u8 length, the text
+	if (p.size() < 4 || p[2] < 1 || p[2] > 8 || p[1] >= p[2] || p.size() != size_t(4 + p[3]) || link.ref.slot >= 2)
+		return coop::proto::kReasonMalformed;
+	Host::Session::Parts& parts = s.parts[link.ref.slot];
+	if (parts.op != op || parts.count != p[2] || p[1] == 0)
+	{
+		if (p[1] == 0)
+		{
+			parts.op = op;
+			parts.count = p[2];
+			parts.got = 0;
+		}
+		else if (parts.op != op || parts.count != p[2])
+			return coop::proto::kReasonMalformed; // a part without its first
+	}
+	parts.text[p[1]].assign(reinterpret_cast<const char*>(p.data() + 4), p[3]);
+	parts.got |= 1u << p[1];
+	if (parts.got != (1u << parts.count) - 1)
+		return 0; // more parts to come
+	xr_string text;
+	for (u32 i = 0; i < parts.count; ++i)
+		text += parts.text[i];
+	parts = Host::Session::Parts();
+	if (op == 2 && session_is_owner(link))
+	{
+		if (session_busy())
+		{
+			++s.refused;
+			return coop::proto::kReasonSessionBusy;
+		}
+		const u16 reason = session_create(link, text, result);
+		if (reason)
+			++s.refused;
+		return reason;
+	}
+	// T01-19: the partner's creation screen keeps only its loadout, for the owner's next new game
+	xr_map<xr_string, xr_string> kv;
+	session_parse(text, kv);
+	string1024 saved;
+	xr_sprintf(saved, "new_game_loadout = %s\n", kv["new_game_loadout"].substr(0, 900).c_str());
+	const bool written = session_write(session_loadout_file(link.ref.slot), saved);
+	++s.loadouts;
+	result.revision = 2;
+	g_host->log.line("session-loadout slot=%u op=%u written=%d loadout=[%s]", u32(link.ref.slot), u32(op), written ? 1 : 0,
+		kv["new_game_loadout"].c_str());
+	return written ? 0 : coop::proto::kReasonStoreFailed;
+}
+
+// the announced switch: the stop follows once the notice is out
+void session_tick()
+{
+	Host::Session& s = g_host->session;
+	if (!s.relaunch_at_ms || g_host->wall.GetElapsed_ms() < s.relaunch_at_ms || s_coop_relaunch)
+		return;
+	s_coop_relaunch = true;
+	g_host->stop_requested = true;
+	g_host->log.line("session-relaunch to=%s exit_code=%d", coop_uuid_hex(s.next).c_str(), kRelaunchExitCode);
+}
