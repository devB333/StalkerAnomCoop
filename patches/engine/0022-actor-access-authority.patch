+
+// --- S03-T02: actor lookups ---------------------------------------------
+
+Refusal CampaignIdentityRegistry::current_participant(u8 slot, ParticipantRef& out) const
+{
+	if (slot >= m_slots.size())
+		return Refusal::UnknownParticipant;
+	const Participant& p = m_slots[slot];
+	if (p.state == ParticipantState::Free)
+		return Refusal::UnknownParticipant;
+	out.slot = slot;
+	out.generation = p.generation;
+	return Refusal::None;
+}
+
+Refusal CampaignIdentityRegistry::participant_actor_key(const ParticipantRef& ref, EngineEntityKey& out) const
+{
+	const Participant* p = nullptr;
+	const Refusal refusal = participant(ref, p);
+	if (refusal != Refusal::None)
+		return refusal;
+	EntityId entity;
+	if (!p->actor.valid() || resolve(p->actor_key, entity) != Refusal::None)
+		return Refusal::NoActor;
+	out = p->actor_key;
+	return Refusal::None;
+}
+
+Refusal CampaignIdentityRegistry::participant_of_engine_id(u16 id, ParticipantRef& out) const
+{
+	EngineEntityKey key;
+	if (!current_key(id, key))
+		return Refusal::StaleReference;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		const Participant& p = m_slots[i];
+		if (p.state == ParticipantState::Free || !p.actor.valid() || p.actor_key != key)
+			continue;
+		out.slot = u8(i);
+		out.generation = p.generation;
+		return Refusal::None;
+	}
+	return Refusal::UnknownParticipant;
+}
+
+u8 CampaignIdentityRegistry::live_actor_count() const
+{
+	u8 count = 0;
+	EntityId entity;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		const Participant& p = m_slots[i];
+		if (p.state != ParticipantState::Free && p.actor.valid() && resolve(p.actor_key, entity) == Refusal::None)
+			++count;
+	}
+	return count;
+}
+
+Refusal CampaignIdentityRegistry::sole_actor_key(EngineEntityKey& out, ParticipantRef* who) const
+{
+	u8 count = 0;
+	EntityId entity;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		const Participant& p = m_slots[i];
+		if (p.state == ParticipantState::Free || !p.actor.valid() || resolve(p.actor_key, entity) != Refusal::None)
+			continue;
+		if (++count == 1)
+		{
+			out = p.actor_key;
+			if (who)
+			{
+				who->slot = u8(i);
+				who->generation = p.generation;
+			}
+		}
+	}
+	if (count == 0)
+		return Refusal::NoActor;
+	return count == 1 ? Refusal::None : Refusal::Ambiguous;
+}
+
+Refusal CampaignIdentityRegistry::context_actor_key(const ActionContext& context, Scope scope,
+	EngineEntityKey& out) const
+{
+	const Refusal refusal = authorize(context, scope);
+	if (refusal != Refusal::None)
+		return refusal;
+	return participant_actor_key(context.actor, out);
+}
+
+Refusal CampaignIdentityRegistry::adopt_spawned_actor(const ServerAuthority* authority, u16 id, ParticipantRef& out)
+{
+	if (!authorized(authority))
+		return Refusal::NotAuthoritative;
+	EngineEntityKey key;
+	if (!current_key(id, key))
+		return Refusal::StaleReference;
+	// Already held (a re-spawn of the same object keeps its participant).
+	if (participant_of_engine_id(id, out) == Refusal::None)
+		return Refusal::None;
+	EntityId entity;
+	for (u32 i = 0; i < m_slots.size(); ++i)
+	{
+		const Participant& p = m_slots[i];
+		if (p.state == ParticipantState::Free)
+			continue;
+		if (p.actor.valid() && resolve(p.actor_key, entity) == Refusal::None)
+			continue; // holds a live actor
+		out.slot = u8(i);
+		out.generation = p.generation;
+		return bind_actor(authority, out, key);
+	}
+	return Refusal::UnknownParticipant;
+}
 } // namespace campaign
