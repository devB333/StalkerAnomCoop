+// The player's input: what the native control path would read (movement
+// keys, stance, walk, the camera's angles), sampled once per server tick of
+// wall time (S06-T01: the server consumes one input per tick), numbered by
+// tick, sent with the previous inputs for loss; the keys are cleared as the
+// native path would clear them. The test driver adds its movement here and
+// can forge the stream (duplicates, a shifted counter, a jump, a replay).
+u64 utc_now_ms()
+{
+	FILETIME ft;
+	GetSystemTimeAsFileTime(&ft);
+	return ((u64(ft.dwHighDateTime) << 32) | ft.dwLowDateTime) / 10000ull - 11644473600000ull;
+}
+
