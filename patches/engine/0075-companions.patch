+		companion_lua(chunk, v, 1, p2, nullptr, "companion-recruit");
+		g_host->log.line("fixture-companion recruited npc=%u section=%s d_p2=%.1f d_p1=%.1f slot=%d", u32(f.npc), *npc->cNameSect(),
+			npc->Position().distance_to(p2->Position()), npc->Position().distance_to(p1->Position()), int(v[0]));
+		f.phase = 1;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	CGameObject* npc = smart_cast<CGameObject*>(Level().Objects.net_Find(f.npc));
+	CEntityAlive* alive = smart_cast<CEntityAlive*>(npc);
+	if (!npc || !alive || !alive->g_Alive())
+	{
+		++f.failures;
+		g_host->log.line("fixture-companion done phase=subject-lost restored=%d failures=%u", f.restored ? 1 : 0, f.failures);
+		f.phase = 999;
+		return;
+	}
+	if (f.phase == 1)
+	{
+		if (g_host->tick - f.phase_tick < 2 * 50)
+			return;
+		f.phase = 2;
+	}
+	if (f.phase == 2)
+	{
+		// p1 beside the companion: it must still answer for p2
+		Fvector side;
+		side.sub(p1->Position(), npc->Position());
+		side.y = 0.f;
+		if (side.square_magnitude() < 0.01f)
+			side.set(1.f, 0.f, 0.f);
+		side.normalize();
+		place_beside(p1, Fvector().mad(npc->Position(), side, 4.f));
+		string512 chunk;
+		xr_sprintf(chunk, "return campaign.companion_slot(%u)", u32(f.npc));
+		companion_lua(chunk, v, 1, nullptr, nullptr, "slot");
+		const int slot = int(v[0]);
+		companion_lua("return db.actor and db.actor:id() or -1", v, 1, nullptr, npc, "evaluation");
+		const int eval = int(v[0]);
+		xr_sprintf(chunk, "local n = level.object_by_id(%u)\n"
+			"return n and dialogs_axr_companion.is_actor_companion(db.actor, n) and 1 or 0", u32(f.npc));
+		companion_lua(chunk, v, 1, p1, nullptr, "dialog-p1");
+		const int dialog_p1 = int(v[0]);
+		companion_lua(chunk, v, 1, p2, nullptr, "dialog-p2");
+		const int dialog_p2 = int(v[0]);
+		xr_sprintf(chunk, "local n = level.object_by_id(%u)\n"
+			"local sq = n and get_object_squad(n)\n"
+			"return sq and sq:get_script_target() or -2", u32(f.npc));
+		companion_lua(chunk, v, 1, nullptr, nullptr, "target");
+		const int target = int(v[0]);
+		const int p2id = int(p2->ID());
+		u32 bad = 0;
+		bad += slot != int(slots[1]);
+		bad += eval != p2id;
+		bad += dialog_p1 != 0;
+		bad += dialog_p2 != 1;
+		bad += target != p2id;
+		f.failures += bad;
+		f.d0 = npc->Position().distance_to(p2->Position());
+		g_host->log.line("fixture-companion checks restored=%d npc=%u slot=%d p2_slot=%u eval=%d p1=%u p2=%d dialog_p1=%d dialog_p2=%d "
+			"target=%d d_p1=%.1f d_p2=%.1f bad=%u", f.restored ? 1 : 0, u32(f.npc), slot, u32(slots[1]), eval, u32(p1->ID()), p2id,
+			dialog_p1, dialog_p2, target, npc->Position().distance_to(p1->Position()), f.d0, bad);
+		f.phase = 3;
+		f.phase_tick = g_host->tick;
+		return;
+	}
+	if (f.phase == 3)
+	{
+		const float d2 = npc->Position().distance_to(p2->Position());
+		const bool reached = d2 < 8.f;
+		if (!reached && g_host->tick - f.phase_tick < 120 * 50)
+		{
+			if ((g_host->tick - f.phase_tick) % (10 * 50) == 0)
+			{
+				// what its companion logic sees, inside its evaluation scope
+				string1024 chunk;
+				xr_sprintf(chunk, "local id = %u\n"
+					"local n = level.object_by_id(id)\n"
+					"local st = db.storage[id]\n"
+					"local b = st and st.beh\n"
+					"local so = get_story_object('actor')\n"
+					"local sq = n and get_object_squad(n)\n"
+					"local dt = b and b.desired_target\n"
+					"return n and n:has_info('npcx_beh_wait') and 1 or 0, st and st.active_scheme == 'beh' and 1 or 0,\n"
+					"  dt and dt.object and dt.object:id() or -1, so and so:id() or -1, sq and sq:commander_id() or -1,\n"
+					"  dt and dt.position and dt.position:distance_to(n:position()) or -1", u32(f.npc));
+				companion_lua(chunk, v, 6, nullptr, npc, "follow-state");
+				g_host->log.line("fixture-companion follow-state d_p2=%.1f d_p1=%.1f wait=%d beh=%d target=%d story_actor=%d commander=%d "
+					"target_distance=%.1f", d2, npc->Position().distance_to(p1->Position()), int(v[0]), int(v[1]), int(v[2]), int(v[3]),
+					int(v[4]), v[5]);
+			}
+			return;
+		}
+		if (!reached)
+			++f.failures;
+		const campaign::ScriptContextStats& st = campaign::script_context_stats();
+		g_host->log.line("fixture-companion follow restored=%d d0=%.1f d_p2=%.1f d_p1=%.1f reached=%d seconds=%.1f companion_reads=%I64u",
+			f.restored ? 1 : 0, f.d0, d2, npc->Position().distance_to(p1->Position()), reached ? 1 : 0,
+			float(g_host->tick - f.phase_tick) / 50.f, st.companion_reads);
+		g_host->log.line("fixture-companion done phase=followed restored=%d failures=%u changes=%u", f.restored ? 1 : 0, f.failures,
+			g_host->companion_changes);
+		f.phase = 999;
+	}
+}
