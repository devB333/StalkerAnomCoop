+++ b/src/xrGame/Actor_Movement.cpp
@@ -497,6 +497,31 @@ void CActor::replica_present(const Fvector& position, float model_yaw, u32 mstat
 	XFORM().set(xform);
 	mstate_real = mstate;
 	g_SetAnimation(mstate_real);
+	if (!local_view)
+	{
+		// S07 play test: a remote actor's lean. The engine computes the torso
+		// roll only for the controlled actor (g_cl_Orientate's target with
+		// inertia, cam_Lookout's wall check) and the bone callbacks tilt the
+		// spine, shoulders and head from r_torso.roll; a remote body got the
+		// lean bits but no roll, so it never tilted. The same target and
+		// inertia from the server's state, without the wall check (the
+		// server's actor already moved as its walls allowed).
+		float tgt_roll = 0.f;
+		if (mstate_real & mcLookout)
+		{
+			tgt_roll = (mstate_real & mcLLookout) ? -ACTOR_LLOOKOUT_ANGLE : ACTOR_RLOOKOUT_ANGLE;
+			tgt_roll *= m_fLookoutFactor;
+			if ((mstate_real & mcLLookout) && (mstate_real & mcRLookout))
+				tgt_roll = 0.f;
+		}
+		if (!fsimilar(tgt_roll, r_torso_tgt_roll, EPS))
+		{
+			r_torso_tgt_roll = angle_inertion_var(r_torso_tgt_roll, tgt_roll, 0.f, CameraHeight() * PI_MUL_2, PI_DIV_2,
+				Device.fTimeDelta);
+			r_torso_tgt_roll = angle_normalize_signed(r_torso_tgt_roll);
+		}
+		r_torso.roll = r_torso_tgt_roll;
+	}
 }
 
