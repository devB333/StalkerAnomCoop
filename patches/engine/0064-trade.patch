+std::vector<u8> encode_trade(const TradeRecord& r)
+{
+	std::vector<u8> out;
+	put<u8>(out, r.slot);
+	put<u64>(out, r.player.hi);
+	put<u64>(out, r.player.lo);
+	put<u64>(out, r.operation);
+	put<u64>(out, r.npc_entity);
+	put<u64>(out, r.actor_entity);
+	put<u32>(out, r.actor_money_after);
+	put<u32>(out, r.npc_money_after);
+	put<u32>(out, r.paid);
+	put<u32>(out, r.received);
+	put<u16>(out, u16(r.items.size()));
+	for (const PickupRecord& item : r.items)
+	{
+		const std::vector<u8> one = encode_transfer(item);
+		put<u16>(out, u16(one.size()));
+		out.insert(out.end(), one.begin(), one.end());
+	}
+	return out;
+}
+
+bool decode_trade(const std::vector<u8>& payload, TradeRecord& out)
+{
+	size_t at = 0;
+	u16 count = 0;
+	if (!(get(payload, at, out.slot) && get(payload, at, out.player.hi) && get(payload, at, out.player.lo) &&
+			get(payload, at, out.operation) && get(payload, at, out.npc_entity) && get(payload, at, out.actor_entity) &&
+			get(payload, at, out.actor_money_after) && get(payload, at, out.npc_money_after) &&
+			get(payload, at, out.paid) && get(payload, at, out.received) && get(payload, at, count)) ||
+		!out.npc_entity || !out.actor_entity || count > 64)
+		return false;
+	out.items.clear();
+	for (u16 i = 0; i < count; ++i)
+	{
+		u16 length = 0;
+		if (!get(payload, at, length) || length == 0 || at + length > payload.size())
+			return false;
+		PickupRecord item;
+		if (!decode_transfer(std::vector<u8>(payload.begin() + at, payload.begin() + at + length), item))
+			return false;
+		out.items.push_back(item);
+		at += length;
+	}
+	return at == payload.size();
+}
