+Refusal assign_participant_actor(const ParticipantRef& ref, u16 engine_id)
+{
+	if (!server_role())
+		return Refusal::WrongRole;
+	CampaignIdentityRegistry& registry = *g_campaign_identity;
+	EngineEntityKey key;
+	if (!registry.current_key(engine_id, key))
+		return Refusal::StaleReference;
+	EngineEntityKey held;
+	if (registry.participant_actor_key(ref, held) == Refusal::None)
+		return held == key ? Refusal::None : Refusal::AlreadyBound;
+	const Refusal refusal = registry.bind_actor(registry.authority(), ref, key);
+	Msg("%sS03-T03 actor entity %u (generation %u) assigned to participant {%u,%u}: %s", refusal == Refusal::None ? "" : "! ",
+		u32(engine_id), key.generation, u32(ref.slot), ref.generation, refusal_name(refusal));
+	return refusal;
+}
 } // namespace campaign
