+// ------------------------------------------------------------ S08-T02
+// The transfer fixture (profile transfer_race): once both players are in
+// the world, an inventory box appears between them with four items, a second
+// box 8 m away with one, a stalker NPC beside the box that is killed at once
+// (its body is the corpse container) with an extra item, and two items (and
+// a pistol for participant 2) in each actor's inventory. Then one round every
+// 8 s; each names steps the clients run at the server tick it gives
+// (CampaignEvent 7): the transfers and drops go through the engine's own
+// inventory events on the client (GE_TRADE_SELL + GE_TRADE_BUY, as the
+// inventory UI's move_item_from_to; GE_OWNERSHIP_REJECT, as its drop), which
+// the client turns into the intents.
+//   0 box race      both take the same box item
+//   1 put           each puts an item of its own into the box
+//   2 cross         each takes the item the other put
+//   3 stale         p1 takes a box item and puts it back; p2 claims it 1.5 s later
+//                   with the lifecycle cursor it had at the announcement (Stale)
+//   4 drop race     p1 drops an item; 2 s later both pick it up
+//   5 equip         p2 activates slot 2 and moves its slot-2 item to the box at once
+//   6 refusals      far box (10), to the other actor (13), drop of a box item (14),
+//                   wrong source (9)
+//   7 corpse race   both take the same item from the corpse
+//   8 disconnect    p2 takes a box item and drops its connection right after
+const u32 kTransferRounds = 9;
+struct TransferStep
+{
+	u8 slot, action;
+	u16 offset; // ticks after the claim tick
+	u16 item, from, to;
+	u8 flags; // 1: the cursor at the announcement; 2: the item in slot `extra`; 4: disconnect after sending
+	u8 extra;
+};
+
+u16 give_to(CALifeSimulator* alife, LPCSTR section, u16 parent)
+{
+	const CSE_ALifeDynamicObject* se = ai().alife().objects().object(parent, true);
+	if (!se)
+		return kNoEngineId;
+	NET_Packet packet;
+	packet.w_begin(M_SPAWN);
+	packet.w_stringZ(section);
+	CSE_Abstract* item = alife->spawn_item(section, se->o_Position, se->m_tNodeID, se->m_tGraphID, parent, false);
+	if (!item)
+		return kNoEngineId;
+	item->Spawn_Write(packet, FALSE);
+	alife->server().FreeID(item->ID, 0);
+	F_entity_Destroy(item);
+	ClientID client;
+	client.set(0xffff);
+	u16 dummy;
+	packet.r_begin(dummy);
+	CSE_Abstract* created = alife->server().Process_spawn(packet, client);
+	return created ? created->ID : kNoEngineId;
+}
+
+u16 spawn_at(CALifeSimulator* alife, LPCSTR section, Fvector at, u16 anchor)
+{
+	const CLevelGraph& graph = ai().level_graph();
+	u32 vertex = graph.valid_vertex_position(at) ? graph.vertex_id(at) : u32(-1);
+	const CSE_ALifeDynamicObject* a = ai().alife().objects().object(anchor, true);
+	if (!a)
+		return kNoEngineId;
+	if (!graph.valid_vertex_id(vertex))
+		vertex = a->m_tNodeID;
+	at.y = graph.vertex_position(vertex).y + 0.1f;
+	CSE_Abstract* e = alife->spawn_item(section, at, vertex, a->m_tGraphID, u16(-1));
+	return e ? e->ID : kNoEngineId;
+}
+
+bool delivered(u16 id)
+{
+	const auto p = g_host->published.find(id);
+	if (p == g_host->published.end() || !p->second.sent)
+		return false;
+	for (PlayerLink& link : g_host->links)
+		if (link.bound && client_in_world(link) && link.sent_commit < _max(p->second.commit, p->second.owner_commit))
+			return false;
+	return true;
+}
+
+void put_ref(std::vector<u8>& out, u16 id)
+{
+	coop::proto::EntityRef ref;
+	const auto p = id != kNoEngineId && id != 0xffff ? g_host->published.find(id) : g_host->published.end();
+	if (p != g_host->published.end())
+		ref = p->second.ref;
+	for (int b = 0; b < 8; ++b)
+		out.push_back(u8(ref.id >> (8 * b)));
+	for (int b = 0; b < 4; ++b)
+		out.push_back(u8(ref.generation >> (8 * b)));
+}
