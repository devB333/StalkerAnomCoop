+	persistence->remember(link.player, intent.operation_id, outcome);
+	result.outcome = coop::proto::ActionOutcome::Accepted;
+	result.reason = 0;
+	result.commit_id = revision;
+	result.revision = revision;
+	trade_send_prices(link, "traded");
+	return 0;
