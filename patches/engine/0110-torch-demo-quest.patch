+// them (the turn-in takes from both, S08-T04): the task is ready to turn in.
+void demo_quest_tick()
+{
+	const CoopConfig& config = g_host->config;
+	static u64 check_at = 0;
+	if (check_at && g_host->tick >= check_at)
+	{
+		// what a turn-in checks first (take_quest op 2): stage 1 is finished
+		check_at = 0;
+		CActor* holder = nullptr;
+		for (PlayerLink& l : g_host->links)
+			if (l.bound && l.ref.slot == 0)
+				holder = participant_actor(l.ref);
+		s32 stage = -1;
+		if (holder)
+		{
+			campaign::ScriptContextScope scope(static_cast<const CObject*>(holder), "demo-quest-check");
+			lua_call_ok("campaign_party_check", stage, (LPCSTR)"esc_m_trader_task_3");
+		}
+		const Host::PartyTask* t = party_task("esc_m_trader_task_3");
+		g_host->log.line("demo-quest ready stage=%d count=%d need=%d", stage, t ? t->count : -1, t ? t->need : -1);
+	}
+	if (!config.demo_quest || !g_host->demo_placed || g_host->demo_quest_done || !ai().get_alife())
+		return;
+	if (!g_host->demo_quest_at)
+		g_host->demo_quest_at = g_host->tick + 5 * 50;
+	if (g_host->tick < g_host->demo_quest_at)
+		return;
+	g_host->demo_quest_done = true;
+	LPCSTR task = "esc_m_trader_task_3";
+	PlayerLink* first = nullptr;
+	CActor* actors[2] = {nullptr, nullptr};
+	for (PlayerLink& l : g_host->links)
+		if (l.bound && l.ref.slot < 2)
+		{
+			actors[l.ref.slot] = participant_actor(l.ref);
+			if (l.ref.slot == 0)
+				first = &l;
+		}
+	const u16 giver_id = find_giver();
+	CGameObject* npc = giver_id != 0xffff ? smart_cast<CGameObject*>(Level().Objects.net_Find(giver_id)) : nullptr;
+	CInventoryOwner* owner = npc ? smart_cast<CInventoryOwner*>(npc) : nullptr;
+	if (!first || !actors[0] || !actors[1] || !owner || party_task(task))
+	{
+		g_host->log.line("demo-quest skipped first=%d actors=%d,%d giver=%d active=%d", first ? 1 : 0, actors[0] ? 1 : 0,
+			actors[1] ? 1 : 0, owner ? 1 : 0, party_task(task) ? 1 : 0);
+		return;
+	}
+	sync_party_actors();
+	bool ok = false;
+	const campaign::Refusal opened = campaign::dialogue_open(actors[0], owner, false);
+	{
+		campaign::ScriptContextScope scope(static_cast<const CObject*>(actors[0]), "demo-quest-accept");
+		ok = opened == campaign::Refusal::None && quest_accept_phrases(actors[0], npc, task);
+	}
+	campaign::dialogue_close(actors[0], owner);
+	CGameTask* native = Level().GameTaskManager().HasGameTask(shared_str(task), true);
+	if (!ok || !native)
+	{
+		g_host->log.line("demo-quest not-offered dialogue=%s ok=%d native=%d", campaign::refusal_name(opened), ok ? 1 : 0,
+			native ? 1 : 0);
+		return;
+	}
+	party_task_accepted(*first, task, giver_id, actors[0], 0);
+	// the number the task asks for (the party task's own count is filled later)
+	s32 need = -1;
+	lua_call_ok("campaign_party_need", need, task);
+	if (need <= 0)
