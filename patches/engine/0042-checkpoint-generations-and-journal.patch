+// ------------------------------------------------------------ S07-T07
+// Respawn (docs/persistence-contract.md §9). While the own actor is dead the
+// HUD shows the prompt; the use key (or, for the unattended driver, profile
+// auto_respawn seconds) sends the respawn intent, re-sent every 3 s until a
+// result arrives. An accepted respawn is followed by the server's rejoin
+// event: this client leaves its world and reconnects (the S07-T05 path) so
+// its player entity is the new actor. The driver also sends one request
+// while alive, which the server must refuse.
+const char* kRespawnPrompt = "You died. Press the USE key to respawn at your last checkpoint.";
+
+bool send_respawn(LPCSTR why)
+{
+	if (!g_link->respawn_operation)
+		g_link->respawn_operation = 0x7e5f000000000000ull | (utc_now_ms() & 0xffffffffffffull); // tag 0x7e5f, UTC ms
+	coop::proto::ActionIntent intent;
+	intent.operation_id = g_link->respawn_operation;
+	intent.kind = coop::proto::kActionRespawn;
+	const bool sent = g_link->client && g_link->client->send(coop::proto::Message(intent));
+	g_link->respawn_sent_ms = g_link->wall.GetElapsed_ms();
+	g_link->log.line("respawn-request why=%s operation=%I64x sent=%d dead_ms=%u", why, intent.operation_id, sent ? 1 : 0,
+		g_link->dead_since_ms ? g_link->wall.GetElapsed_ms() - g_link->dead_since_ms : 0);
+	return sent;
+}
+
+void respawn_frame()
+{
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (!g_link->live_since_ms)
+		g_link->live_since_ms = now;
+	if (!g_actor)
+		return;
+	if (g_actor->g_Alive())
+	{
+		g_link->dead_since_ms = 0;
+		g_link->respawn_prompted = false;
+		// the driver's early request, 20 s into the world while alive (refused: reason 6)
+		if (g_link->config.auto_respawn && !g_link->early_respawn_sent && now - g_link->live_since_ms >= 20000)
+		{
+			g_link->early_respawn_sent = true;
+			g_link->respawn_operation = 0;
+			send_respawn("early-while-alive");
+		}
+		return;
+	}
+	if (!g_link->dead_since_ms)
+	{
+		g_link->dead_since_ms = now;
+		g_link->respawn_operation = 0;
+	}
+	if (!g_link->respawn_prompted && now - g_link->dead_since_ms >= 3000)
+	{
+		g_link->respawn_prompted = true;
+		// the installed scripts' HUD message (actor_menu.set_msg, as the Azazel
+		// mode shows its death count); the engine's message log has no game
+		// log in single-player and faulted (death-1)
+		luabind::functor<void> set_msg;
+		const bool shown = ai().script_engine().functor("actor_menu.set_msg", set_msg);
+		if (shown)
+			set_msg(1, kRespawnPrompt, 10);
+		g_link->log.line("respawn-prompt dead_ms=%u shown=%d", now - g_link->dead_since_ms, shown ? 1 : 0);
+	}
+	if (g_link->respawn_operation)
+	{
+		if (now - g_link->respawn_sent_ms >= 3000)
+			send_respawn("retry");
+		return;
+	}
+	if (g_link->config.auto_respawn && g_link->respawn_prompted &&
+		now - g_link->dead_since_ms >= g_link->config.auto_respawn * 1000)
+		send_respawn("auto");
+}
+
+void respawn_result(const coop::proto::ActionResult& result)
+{
+	++g_link->respawn_results;
+	const bool accepted = result.outcome == coop::proto::ActionOutcome::Accepted;
+	if (!accepted)
+		++g_link->respawn_refusals;
+	g_link->log.line("respawn-result operation=%I64x outcome=%u reason=%u commit=%I64u alive=%d %s", result.operation_id,
+		u32(result.outcome), u32(result.reason), result.commit_id, g_actor && g_actor->g_Alive() ? 1 : 0,
+		accepted ? "accepted" : (g_actor && g_actor->g_Alive() ? "refused-as-expected" : "refused"));
+	if (result.operation_id == g_link->respawn_operation)
+		g_link->respawn_operation = 0; // accepted or refused: no more retries of this one
+}
+
+void on_rejoin(const coop::proto::CampaignEvent& event)
+{
+	if (event.payload.size() < 3 || g_link->quitting)
+		return;
+	++g_link->rejoins;
+	g_link->log.line("rejoin-requested slot=%u new_actor=%u revision=%I64u", u32(event.payload[0]),
+		u32(event.payload[1] | (event.payload[2] << 8)), event.revision);
+	// leave the world and come back: the join streams a world in which the
+	// participant's actor is the new one
+	if (g_link->world == WorldLive || g_link->world == WorldLoading)
+	{
+		g_link->leaving = true;
+		++g_link->worlds_left;
+		Console->Execute("disconnect");
+	}
+	if (g_link->client)
+		g_link->client->close(coop::net::close_code::kNormal, "rejoin after respawn");
+	g_link->reconnect_backoff_ms = 1000;
+	g_link->reconnect_at_ms = g_link->wall.GetElapsed_ms() + 500;
+}
+
+bool respawn_key_press(int key)
+{
+	if (!g_link || !g_link->active || g_link->world != WorldLive || !g_actor || g_actor->g_Alive() ||
+		!g_link->respawn_prompted || g_link->respawn_operation)
+		return false;
+	if (get_binded_action(key) != kUSE)
+		return false;
+	send_respawn("use-key");
+	return true;
+}
+
+// ------------------------------------------------------------ S07-T03
+// Profile script 6: the ledger program (docs/persistence-contract.md §10).
+// Every 2 s a ledger intent with the next delta of a fixed sequence and a
+// fresh operation id; an unacknowledged one is re-sent every 3 s with the
+// same id, across connection ends and reconnects, until its result arrives.
+// Every send and result goes to coop-ledger-client.csv.
+void ledger_csv_line(LPCSTR event, u64 operation, s32 delta, u32 outcome, u32 reason, u64 commit)
+{
+	if (!g_link->ledger_csv)
+	{
+		string_path path;
+		FS.update_path(path, "$logs$", "coop-ledger-client.csv");
+		g_link->ledger_csv = fopen(path, "w");
+		if (!g_link->ledger_csv)
+			return;
+		fprintf(g_link->ledger_csv, "utc_ms,event,operation,delta,outcome,reason,commit,sum_acked,pending\n");
+	}
+	fprintf(g_link->ledger_csv, "%I64u,%s,%I64u,%d,%u,%u,%I64u,%I64d,%u\n", utc_now_ms(), event, operation, delta, outcome,
+		reason, commit, g_link->ledger_sum_acked, u32(g_link->ledger_pending.size()));
+	fflush(g_link->ledger_csv);
+}
+
+bool ledger_send(const Link::LedgerPending& p, LPCSTR event)
+{
+	coop::proto::ActionIntent intent;
+	intent.operation_id = p.operation;
+	intent.kind = coop::proto::kActionLedger;
+	intent.params.resize(4);
+	memcpy(intent.params.data(), &p.delta, 4);
+	const bool sent = g_link->client && g_link->client->send(coop::proto::Message(intent));
+	ledger_csv_line(sent ? event : "unsent", p.operation, p.delta, 0, 0, 0);
+	return sent;
+}
+
+void run_script6(u32 t)
+{
+	static const s32 deltas[] = {10, -3, 7, 25, -12, 1, 40, -8, 15, -20};
+	const u32 now = g_link->wall.GetElapsed_ms();
+	if (!g_link->ledger_next_operation)
+	{
+		g_link->ledger_next_operation = (utc_now_ms() << 16) | 1;
+		g_link->ledger_next_send_ms = now + 2000;
+		g_link->log.line("script6-program-start slot=%u t=%u first_operation=%I64x", u32(g_link->local_slot), t,
+			g_link->ledger_next_operation);
+	}
+	if (now >= g_link->ledger_next_send_ms)
+	{
+		g_link->ledger_next_send_ms = now + 2000;
+		Link::LedgerPending p;
+		p.operation = g_link->ledger_next_operation++;
+		p.delta = deltas[g_link->ledger_index++ % (sizeof(deltas) / sizeof(deltas[0]))];
+		p.sent_ms = now;
+		p.retries = 0;
+		g_link->ledger_pending.push_back(p);
+		++g_link->ledger_sent;
+		ledger_send(p, "sent");
+	}
+	for (Link::LedgerPending& p : g_link->ledger_pending)
+		if (now - p.sent_ms >= 3000)
+		{
+			p.sent_ms = now;
+			++p.retries;
+			++g_link->ledger_retries;
+			ledger_send(p, "retry");
+		}
+}
+
+void ledger_result(const coop::proto::ActionResult& result)
+{
+	// Only ledger operations (seeded from the UTC clock, far above the
+	// weapon actions' counters) are the program's.
+	if (!g_link->ledger_next_operation || result.operation_id < (g_link->ledger_next_operation & ~0xffffull))
+		return;
+	for (auto it = g_link->ledger_pending.begin(); it != g_link->ledger_pending.end(); ++it)
+		if (it->operation == result.operation_id)
+		{
+			if (result.outcome == coop::proto::ActionOutcome::Accepted)
+			{
+				++g_link->ledger_acked;
+				g_link->ledger_sum_acked += it->delta;
+			}
+			else
+				++g_link->ledger_rejected;
+			ledger_csv_line("result", it->operation, it->delta, u32(result.outcome), result.reason, result.commit_id);
+			g_link->ledger_pending.erase(it);
+			return;
+		}
+	// Other programs' operations (small ids: the weapon actions) are not the
+	// ledger's; a ledger id carries the UTC clock in its high bits.
+	if (result.operation_id < (u64(1) << 32) || (result.operation_id >> 48) == 0x7e5f)
+		return;
+	// A result for an operation no longer pending: a duplicate answer.
+	++g_link->ledger_late;
+	ledger_csv_line("late", result.operation_id, 0, u32(result.outcome), result.reason, result.commit_id);
+}
