+std::vector<u8> encode_transition(const TransitionRecord& r)
+{
+	std::vector<u8> out;
+	put<u64>(out, r.id);
+	put<u8>(out, r.phase);
+	put<u32>(out, r.source_generation);
+	put<u32>(out, r.destination_generation);
+	put<u8>(out, u8(_min<size_t>(r.level.size(), 64)));
+	out.insert(out.end(), r.level.c_str(), r.level.c_str() + _min<size_t>(r.level.size(), 64));
+	put<u16>(out, r.graph_vertex);
+	put<u32>(out, r.level_vertex);
+	for (int i = 0; i < 3; ++i)
+		put<float>(out, r.position[i]);
+	for (int i = 0; i < 3; ++i)
+		put<float>(out, r.angles[i]);
+	return out;
+}
+
+bool decode_transition(const std::vector<u8>& payload, TransitionRecord& out)
+{
+	size_t at = 0;
+	u8 len = 0;
+	if (!get(payload, at, out.id) || !get(payload, at, out.phase) || !get(payload, at, out.source_generation) ||
+		!get(payload, at, out.destination_generation) || !get(payload, at, len) || at + len > payload.size())
+		return false;
+	out.level.assign(reinterpret_cast<const char*>(payload.data() + at), len);
+	at += len;
+	if (!get(payload, at, out.graph_vertex) || !get(payload, at, out.level_vertex))
+		return false;
+	for (int i = 0; i < 3; ++i)
+		if (!get(payload, at, out.position[i]))
+			return false;
+	for (int i = 0; i < 3; ++i)
+		if (!get(payload, at, out.angles[i]))
+			return false;
+	return at == payload.size() && out.phase >= 1 && out.phase <= 3;
+}
+
+bool CoopPersistence::load_generation(u32 generation, xr_string& save_name, xr_string& reason)
+{
+	save_name = "";
+	reason = "";
+	Recovered r;
+	std::string detail;
+	if (!m_store.verify_generation(generation, r.manifest, r.supplemental, detail))
+	{
+		reason = "travel-generation-invalid";
+		m_log->line("travel-load-refused generation=%u detail=%s", generation, detail.c_str());
+		return false;
+	}
+	r.generation = generation;
+	r.highest_epoch = m_epoch;
+	r.highest_revision = _max<u64>(m_recovered_state.highest_revision, r.manifest.revision);
+	m_recovered_state = r; // no replay: nothing after the take is applied by a reload (the committed record logs)
+	m_recovered = true;
+	m_generation = generation;
+	save_name = StoreNames::save_name(generation).c_str();
+	m_log->line("travel-load generation=%u revision=%I64u participants=%u entities=%u save=%s", generation,
+		r.manifest.revision, u32(r.supplemental.participants.size()), u32(r.supplemental.entities.size()),
+		save_name.c_str());
+	return true;
+}
